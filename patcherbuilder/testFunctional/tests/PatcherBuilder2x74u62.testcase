definition {

	property testray.main.component.name = "Patcher Builder";

	setUp {
		LocalFile.Jenkins.openJenkinsURL();
	}

	@priority = 5
	test Runfixpackbuilderhotfix7xjob {
		LocalFile.Jenkins.startFixPackBuilderHotfix7xJob(table = '''| fix.pack.baseCommittish          | 7.4.13-u62                               |
      | fix.pack.built.for               | STVINTRA                                 |
      | fix.pack.customer.ticket         | 12345                                    |
      | fix.pack.fixed.issues            | LRPU-4353                                |
      | fix.pack.hotfixed.issues         | LRPU-4353                                |
      | fix.pack.id                      | 2155                                     |
      | git.revision                     | 363ffb1d3ecd17b640fde1b89686577f125c5807 |
      | patcher.build.id                 | 238790816                                |
      | patcher.combined.branch          | true                                     |
      | patcher.fix.delivery.method      | Fix Pack 3.0                             |
      | patcher.request.key              | 34469febe903c15b8e01efd812b73900587a0f85 |
      | patcher.security.patch           | false                                    |
      | patcher.user.id                  | 10196                                    |''');

		LocalFile.Jenkins.pause(timeInSeconds = 5);

		LocalFile.Jenkins.openJenkinsURL();

		LocalFile.Jenkins.getCurrentJobBuildNumber(jobName = "fixpack-builder-hotfix-7x(2x-uat)");

		LocalFile.Jenkins.checkForJobCompletion(
			jobBuildNumber = ${staticJobBuildNumber},
			jobName = "fixpack-builder-hotfix-7x(2x-uat)");

		LocalFile.Jenkins.openJenkinsURL();

		LocalFile.Jenkins.viewJobStatusSuccess(
			jobBuildNumber = ${staticJobBuildNumber},
			jobName = "fixpack-builder-hotfix-7x(2x-uat)");

		LocalFile.Jenkins.patchingToolInstallAndRevert(table = '''| bundle                   | /mnt/mfs-hdd1-172.16.168/ee/portal/7.4.13-u62/liferay-dxp-tomcat-7.4.13.u62-20230201110539226.tar.gz |
      | hotfix                   | /mnt/mfs-hdd1-172.16.168/ee/hotfix/liferay-hotfix-2155-7413.zip                                      |
      | patchingTool             | /mnt/mfs-hdd1-172.16.168/ee/fix-packs/patching-tool/patching-tool-LATEST-internal.zip                |
      | patchingToolMajorVersion | 3                                                                                                    |''');
	}

}