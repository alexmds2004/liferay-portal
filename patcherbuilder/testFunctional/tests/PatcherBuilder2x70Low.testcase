definition {

	property testray.main.component.name = "Patcher Builder";

	setUp {
		Jenkins.openJenkinsURL();
	}

	@priority = 2
	test Runfixpackbuilderhotfix7xjob {
		Jenkins.startFixPackBuilderHotfix7xJob(table = '''| fix.pack.baseCommittish          | fix-pack-de-16-7010                      |
      | fix.pack.built.for               | INTUITIVE                                |
      | fix.pack.customer.ticket         | 12345                                    |
      | fix.pack.fixed.issues            | LPE-0                                    |
      | fix.pack.hotfixed.issues         | LPS-72839                                |
      | fix.pack.id                      | 7860                                     |
      | git.revision                     | 6722ed9b6691bce6e5808f41dd25b9f1a2cd5de5 |
      | patcher.build.id                 | 208027760                                |
      | patcher.combined.branch          | true                                     |
      | patcher.fix.delivery.method      | Fix Pack 3.0                             |
      | patcher.request.key              | aeb1324a345d658292dce00801ffed8d7abad655 |
      | patcher.security.patch           | false                                    |
      | patcher.user.id                  | 10196                                    |''');

		Jenkins.pause(timeInSeconds = 5);

		Jenkins.openJenkinsURL();

		Jenkins.getCurrentJobBuildNumber(jobName = "fixpack-builder-hotfix-7x(2x-uat)");

		Jenkins.checkForJobCompletion(
			jobBuildNumber = ${staticJobBuildNumber},
			jobName = "fixpack-builder-hotfix-7x(2x-uat)");

		Jenkins.openJenkinsURL();

		Jenkins.viewJobStatusSuccess(
			jobBuildNumber = ${staticJobBuildNumber},
			jobName = "fixpack-builder-hotfix-7x(2x-uat)");

		Jenkins.patchingToolInstallAndRevert(table = '''| bundle       | /mnt/mfs-hdd1-172.16.168/ee/portal/7.0.10/liferay-dxp-digital-enterprise-tomcat-7.0-ga1-20160617092557801.zip |
      | fixPack      | /mnt/mfs-hdd1-172.16.168/ee/fix-packs/7.0.10/de/liferay-fix-pack-de-16-7010.zip                               |
      | hotfix       | /mnt/mfs-hdd1-172.16.168/ee/hotfix/liferay-hotfix-7860-7010.zip                                               |
      | patchingTool | /mnt/mfs-hdd1-172.16.168/ee/fix-packs/patching-tool/patching-tool-2.0.6-internal.zip                          |''');
	}

}