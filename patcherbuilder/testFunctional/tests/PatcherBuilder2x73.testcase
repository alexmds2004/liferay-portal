definition {

	property testray.main.component.name = "Patcher Builder";

	setUp {
		Jenkins.openJenkinsURL();
	}

	@priority = 5
	test Runfixpackbuilderhotfix7xjob {
		Jenkins.startFixPackBuilderHotfix7xJob(table = '''| fix.pack.baseCommittish          | fix-pack-base-7310                                                     |
      | fix.pack.built.for               | PATCHERTEST                                                            |
      | fix.pack.customer.ticket         | 12345                                                                  |
      | fix.pack.fixed.issues            | LPS-94011,LPSQA-121824,LRP-1123,LRP-1615,RELEASEQA-3097,RELEASEQA-3128 |
      | fix.pack.hotfixed.issues         | LPS-94011,LPSQA-121824,LRP-1123,LRP-1615,RELEASEQA-3097,RELEASEQA-3128 |
      | fix.pack.id                      | 3301                                                                   |
      | git.revision                     | 5dc541e312f50f7ceba3eddb330d442185468a62                               |
      | patcher.build.id                 | 226761194                                                              |
      | patcher.combined.branch          | true                                                                   |
      | patcher.fix.delivery.method      | Fix Pack 3.0                                                           |
      | patcher.request.key              | 67f8798c3847f78ff07021ebf5b7c53457b4545f                               |
      | patcher.security.patch           | false                                                                  |
      | patcher.user.id                  | 10196                                                                  |''');

		Jenkins.pause(timeInSeconds = 5);

		Jenkins.openJenkinsURL();

		Jenkins.getCurrentJobBuildNumber(jobName = "fixpack-builder-hotfix-7x(2x-uat)");

		Jenkins.checkForJobCompletion(
			jobBuildNumber = ${staticJobBuildNumber},
			jobName = "fixpack-builder-hotfix-7x(2x-uat)");

		Jenkins.openJenkinsURL();

		Jenkins.viewJobStatusSuccess(
			jobBuildNumber = ${staticJobBuildNumber},
			jobName = "fixpack-builder-hotfix-7x(2x-uat)");

		Jenkins.patchingToolInstallAndRevert(table = '''| bundle                   | /mnt/mfs-hdd1-172.16.168/ee/portal/7.3.10/liferay-dxp-tomcat-7.3.10-ga1-20200930160533946.tar.gz |
      | hotfix                   | /mnt/mfs-hdd1-172.16.168/ee/hotfix/liferay-hotfix-3301-7310.zip                                  |
      | patchingTool             | /mnt/mfs-hdd1-172.16.168/ee/fix-packs/patching-tool/patching-tool-LATEST-internal.zip            |
      | patchingToolMajorVersion | 3                                                                                                |''');
	}

}