definition {

	property testray.main.component.name = "Patcher Builder";

	setUp {
		LocalFile.Jenkins.openJenkinsURL();
	}

	@priority = 4
	test Runfixpackbuilderhotfix7xjob {
		LocalFile.Jenkins.startFixPackBuilderHotfix7xJob(table = '''| fix.pack.baseCommittish          | fix-pack-dxp-8-7210                        |
      | fix.pack.built.for               | STVINTRA                                   |
      | fix.pack.customer.ticket         | 12345                                      |
      | fix.pack.fixed.issues            | LPP-42860,LPS-132598,LPS-134572,LPS-142141 |
      | fix.pack.hotfixed.issues         | LPP-42860,LPS-132598,LPS-134572,LPS-142141 |
      | fix.pack.id                      | 1584                                       |
      | git.revision                     | 60d4ddca3a578e200407825d9a5080cb237531ff   |
      | patcher.build.id                 | 240083857                                  |
      | patcher.combined.branch          | true                                       |
      | patcher.fix.delivery.method      | Fix Pack 3.0                               |
      | patcher.request.key              | 0032494eff6df9b4ca0bd322cfc320733ee00e88   |
      | patcher.security.patch           | false                                      |
      | patcher.user.id                  | 10196                                      |''');

		LocalFile.Jenkins.pause(timeInSeconds = 5);

		LocalFile.Jenkins.openJenkinsURL();

		LocalFile.Jenkins.getCurrentJobBuildNumber(jobName = "fixpack-builder-hotfix-7x(2x-uat)");

		LocalFile.Jenkins.checkForJobCompletion(
			jobBuildNumber = ${staticJobBuildNumber},
			jobName = "fixpack-builder-hotfix-7x(2x-uat)");

		LocalFile.Jenkins.openJenkinsURL();

		LocalFile.Jenkins.viewJobStatusSuccess(
			jobBuildNumber = ${staticJobBuildNumber},
			jobName = "fixpack-builder-hotfix-7x(2x-uat)");

		LocalFile.Jenkins.patchingToolInstallAndRevert(table = '''| bundle                   | /mnt/mfs-hdd1-172.16.168/ee/portal/7.2.10/liferay-dxp-tomcat-7.2.10-ga1-20190531140450482.tar.gz |
      | fixPack                  | /mnt/mfs-hdd1-172.16.168/ee/fix-packs/7.2.10/dxp/liferay-fix-pack-dxp-8-7210.zip                 |
      | hotfix                   | /mnt/mfs-hdd1-172.16.168/ee/hotfix/liferay-hotfix-1584-7210.zip                                  |
      | patchingTool             | /mnt/mfs-hdd1-172.16.168/ee/fix-packs/patching-tool/patching-tool-LATEST-internal.zip            |
      | patchingToolMajorVersion | 2                                                                                                |''');
	}

}