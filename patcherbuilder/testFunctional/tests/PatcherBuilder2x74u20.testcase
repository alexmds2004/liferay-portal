definition {

	property testray.main.component.name = "Patcher Builder";

	setUp {
		Jenkins.openJenkinsURL();
	}

	@ignore = "true"
	test Runfixpackbuilderhotfix7xjob {
		Jenkins.startFixPackBuilderHotfix7xJob(table = '''| fix.pack.baseCommittish          | 7.4.13-u20                               |
      | fix.pack.built.for               | INTUITIVE                                |
      | fix.pack.customer.ticket         | 12345                                    |
      | fix.pack.fixed.issues            | LRPM20-1698                              |
      | fix.pack.hotfixed.issues         | LRPM20-1698                              |
      | fix.pack.id                      | 1804                                     |
      | git.revision                     | 4a0014a11820f8b388f2322affa1533cdecca7ba |
      | patcher.build.id                 | 236196633                                |
      | patcher.combined.branch          | true                                     |
      | patcher.fix.delivery.method      | Fix Pack 3.0                             |
      | patcher.request.key              | c47daea672a22eb18d5402a4bca021dbcde7328e |
      | patcher.security.patch           | false                                    |
      | patcher.user.id                  | 10196                                    |''');

		Jenkins.pause(timeInSeconds = 5);

		Jenkins.openJenkinsURL();

		Jenkins.getCurrentJobBuildNumber(jobName = "fixpack-builder-hotfix-7x(2x-uat)");

		Jenkins.checkForJobCompletion(
			jobBuildNumber = ${staticJobBuildNumber},
			jobName = "fixpack-builder-hotfix-7x(2x-uat)");

		Jenkins.openJenkinsURL();

		Jenkins.viewJobStatusSuccess(
			jobBuildNumber = ${staticJobBuildNumber},
			jobName = "fixpack-builder-hotfix-7x(2x-uat)");

		Jenkins.patchingToolInstallAndRevert(table = '''| bundle                   | /mnt/mfs-hdd1-172.16.168/ee/portal/7.4.13-u20/liferay-dxp-tomcat-7.4.13.u20-20220408150343170.tar.gz |
      | hotfix                   | /mnt/mfs-hdd1-172.16.168/ee/hotfix/liferay-hotfix-1804-7413.zip                                      |
      | patchingTool             | /mnt/mfs-hdd1-172.16.168/ee/fix-packs/patching-tool/patching-tool-LATEST-internal.zip                |
      | patchingToolMajorVersion | 3                                                                                                    |''');
	}

}