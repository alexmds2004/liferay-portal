definition {

	property testray.main.component.name = "Patcher Builder";

	setUp {
		Jenkins.openJenkinsURL();
	}

	@priority = 5
	test Runtestsmoketest {
		Jenkins.startTestFixPackBuilderMainSmokeJob(table = '''| git.branch      | 2.x     |
      | github.username | liferay |''');

		Jenkins.pause(timeInSeconds = 5);

		Jenkins.openJenkinsURL();

		Jenkins.getCurrentJobBuildNumberForShortJob(jobName = "test-fixpack-builder-main-smoke(2x-uat)");

		Jenkins.checkForJobCompletion(
			jobBuildNumber = ${staticJobBuildNumber},
			jobName = "test-fixpack-builder-main-smoke(2x-uat)");

		Jenkins.openJenkinsURL();

		Jenkins.viewJobStatusSuccess(
			jobBuildNumber = ${staticJobBuildNumber},
			jobName = "test-fixpack-builder-main-smoke(2x-uat)");
	}

}