definition {

	property testray.main.component.name = "Patcher Builder";

	setUp {
		Jenkins.openJenkinsURL();
	}

	@priority = 3
	test Runfixpackbuilderfixpack7xjob {
		Jenkins.startFixpackBuilderFixpack7xJob(table = '''| fix.pack.fixed.issues   | LPE-13221,LPE-13913,LPE-15143,LPE-15173,LPE-15305,LPE-15309,LPE-15316,LPE-15333,LPE-15342,LPE-15350,LPE-15354 |
      | fix.pack.id             | 102                                                                                                           |
      | git.revision            | 8d592fef7b8b43865e2e4cc416643a0ea626a7dd                                                                      |
      | checkStaleArtifactsSkip | true                                                                                                          |''');

		Jenkins.pause(timeInSeconds = 5);

		Jenkins.openJenkinsURL();

		Jenkins.getCurrentJobBuildNumber(jobName = "fixpack-builder-fixpack-7x-uat");

		Jenkins.checkForJobCompletion(
			jobBuildNumber = ${staticJobBuildNumber},
			jobName = "fixpack-builder-fixpack-7x-uat");

		Jenkins.openJenkinsURL();

		Jenkins.viewJobStatusSuccess(
			jobBuildNumber = ${staticJobBuildNumber},
			jobName = "fixpack-builder-fixpack-7x-uat");
	}

}