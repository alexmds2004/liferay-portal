definition {

	property testray.main.component.name = "Patcher Builder";

	setUp {
		Jenkins.openJenkinsURL();
	}

	@priority = 4
	test Runfixpackbuilderhotfix7xjob {
		Jenkins.startFixPackBuilderHotfix7xJob(table = '''| fix.pack.baseCommittish          | fix-pack-dxp-20-7210                     |
      | fix.pack.built.for               | HITACHIGP                                |
      | fix.pack.customer.ticket         | 12345                                    |
      | fix.pack.fixed.issues            | LPS-136413                               |
      | fix.pack.hotfixed.issues         | LPS-136413                               |
      | fix.pack.id                      | 2474                                     |
      | git.revision                     | 4b1282db23d8b7a312f761968b1e549c031a5f98 |
      | patcher.build.id                 | 233889081                                |
      | patcher.combined.branch          | true                                     |
      | patcher.fix.delivery.method      | Fix Pack 3.0                             |
      | patcher.request.key              | d8cf77687317ca78eba51ff3aabc555a90d61eff |
      | patcher.security.patch           | false                                    |
      | patcher.user.id                  | 10196                                    |''');

		Jenkins.pause(timeInSeconds = 5);

		Jenkins.openJenkinsURL();

		Jenkins.getCurrentJobBuildNumber(jobName = "fixpack-builder-hotfix-7x(2x-uat)");

		Jenkins.checkForJobCompletion(
			jobBuildNumber = ${staticJobBuildNumber},
			jobName = "fixpack-builder-hotfix-7x(2x-uat)");

		Jenkins.openJenkinsURL();

		Jenkins.viewJobStatusSuccess(
			jobBuildNumber = ${staticJobBuildNumber},
			jobName = "fixpack-builder-hotfix-7x(2x-uat)");

		Jenkins.patchingToolInstallAndRevert(table = '''| bundle                   | /mnt/mfs-hdd1-172.16.168/ee/portal/7.2.10/liferay-dxp-tomcat-7.2.10-ga1-20190531140450482.tar.gz |
      | fixPack                  | /mnt/mfs-hdd1-172.16.168/ee/fix-packs/7.2.10/dxp/liferay-fix-pack-dxp-20-7210.zip                |
      | hotfix                   | /mnt/mfs-hdd1-172.16.168/ee/hotfix/liferay-hotfix-2474-7210.zip                                  |
      | patchingTool             | /mnt/mfs-hdd1-172.16.168/ee/fix-packs/patching-tool/patching-tool-LATEST-internal.zip            |
      | patchingToolMajorVersion | 2                                                                                                |''');
	}

}