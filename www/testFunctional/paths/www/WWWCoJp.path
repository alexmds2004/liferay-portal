<html>
<head>
<title>WWWCoJp</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">WWWCoJp</td></tr>
</thead>

<tbody>
<tr>
	<td>BAD_REQUEST_MESSAGE</td>
	<td>//h1[contains(.,'Bad Request')]</td>
	<td></td>
</tr>
<tr>
	<td>DROPDOWN_LINK</td>
	<td>xpath=(//ul[contains(@class,'dropdown-menu')]/li/a[contains(@class,'dropdown-item')])[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>ERROR_BLOCK</td>
	<td>//div[contains(@class,'block error')]</td>
	<td></td>
</tr>
<tr>
	<td>ERROR_MESSAGE_1</td>
	<td>//*[contains(@class,'alert-danger')]</td>
	<td></td>
</tr>
<tr>
	<td>ERROR_MESSAGE_2</td>
	<td>//*[contains(@class,'portlet-msg-error')]</td>
	<td></td>
</tr>
<tr>
	<td>PAGE_DOES_NOT_EXIST_MESSAGE_1</td>
	<td>//h1[contains(.,'Sorry, this page does not exist')]</td>
	<td></td>
</tr>
<tr>
	<td>PAGE_DOES_NOT_EXIST_MESSAGE_2</td>
	<td>//h2[contains(.,'This page doesn') and contains(.,'t exist')]</td>
	<td></td>
</tr>
<tr>
	<td>PAGE_NOT_FOUND_MESSAGE_1</td>
	<td>//h1[contains(.,'Page not found')]</td>
	<td></td>
</tr>
<tr>
	<td>PAGE_NOT_FOUND_MESSAGE_2</td>
	<td>//h1[contains(.,'Page Not Found')]</td>
	<td></td>
</tr>
<tr>
	<td>PAGE_LINK</td>
	<td>xpath=(//div[contains(@class,'layout-content')]//a)[${key_positionValue}]</td>
	<td></td>
</tr>

<!--FOOTER-->

<tr>
	<td>FOOTER_LINK</td>
	<td>xpath=(//div[contains(@class,'site-footer')]//li[contains(@class,'lfr-nav-item open')]/a)[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>