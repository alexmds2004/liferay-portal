definition {

	property testray.main.component.name = "Support QA";

	test Requestademoviarequestademofooterlink {
		WWWHomepage.gotoHomePage();

		WWWHomepage.clickFooterCategoryLink(
			categoryName = "Platform",
			linkName = "Request a Demo");

		WWWRequestADemo.viewRequestADemoPageAndForm();

		WWWRequestADemo.createRequestADemo(table = '''| Work Email                         | usr.requestdemo1@lrcustomer.com.broken |
	| Country                            | United States                          |
	| State/Territory                    | California                             |
	| Whats your challenge?              | Increasing B2B online revenue          |
	| First Name                         | USR                                    |
	| Last Name                          | RequestDemo1                           |
	| Company                            | Redemo                                 |
	| Phone                              | 555-555-5678                           |
	| Industry                           | Technology                             |''');

		WWWHomepage.pause(timeInSeconds = 5);

		WWWRequestADemo.viewMessageAfterRequestADemoViaForm();

		WWWHomepage.viewURLContent(urlText = "request-a-demo/thank-you");
	}

	test Requestademoviarequestalivedemobutton {
		WWWHomepage.gotoHomePage();

		WWWHomepage.clickRequestALiveDemoButton();

		WWWRequestADemo.viewRequestADemoPageAndForm();

		WWWRequestADemo.createRequestADemo(table = '''| Work Email                         | usr.requestdemo1@lrcustomer.com.broken |
	| Country                            | United States                          |
	| State/Territory                    | California                             |
	| Whats your challenge?              | Increasing B2B online revenue          |
	| First Name                         | USR                                    |
	| Last Name                          | RequestDemo1                           |
	| Company                            | Redemo                                 |
	| Phone                              | 555-555-5678                           |
	| Industry                           | Technology                             |''');

		WWWHomepage.pause(timeInSeconds = 5);

		WWWRequestADemo.viewMessageAfterRequestADemoViaForm();

		WWWHomepage.viewURLContent(urlText = "request-a-demo/thank-you");
	}

	test ViewRequestADemoPage {
		WWWHomepage.gotoRelativeURL(url = "request-a-demo");

		WWWRequestADemo.viewRequestADemoPageAndForm();

		WWWHomepage.gotoHomePage();

		WWWHomepage.clickRequestALiveDemoButton();

		WWWRequestADemo.viewRequestADemoPageAndForm();

		WWWHomepage.gotoHomePage();

		WWWHomepage.clickFooterCategoryLink(
			categoryName = "Platform",
			linkName = "Request a Demo");

		WWWRequestADemo.viewRequestADemoPageAndForm();
	}

}