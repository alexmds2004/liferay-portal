definition {

	property testray.main.component.name = "Support QA";

	tearDown {
		LocalFile.Downloads.teardownDownloadedTableFiles(table = '''| liferay-dxp-osgi-7.4.13.u15-20220308132215444.zip |''');
	}

	test DownloadliferayDXP30daysfreetrial {
		LocalFile.WWWHomepage.gotoRelativeURL(url = "products/dxp/30-day-trial");

		LocalFile.WWWProducts.view30DayFreeTrialPageAndForm();

		LocalFile.WWWProducts.create30DayFreeTrialDownloadRequest(table = '''| Work Email      | usr.liferaydxp1@lrcustomer.com.broken |
	| Country         | United States                         |  
	| State/Territory | California                            |
	| Download Type   | OSGI Dependencies                     |
	| First Name      | USR                                   |
	| Last Name       | LiferayDXP1                           |
	| Company         | Usrdxp                                |
	| Phone           | 555-555-5678                          |''');

		LocalFile.WWWHomepage.pauseInMinutes(timeInMinutes = 4);

		LocalFile.Downloads.viewDownloadedFile(fileName = "liferay-dxp-osgi-7.4.13.u62-20230201110539226.zip");

		LocalFile.WWWHomepage.viewURLContent(urlText = "products/dxp/30-day-trial/thank-you");
	}

	test DownloadliferayDXP30daysfreetrialvia30daytrialfooterlink {
		LocalFile.WWWHomepage.clickFooterCategoryLink(
			categoryName = "Platform",
			linkName = "30 Day Trial");

		LocalFile.WWWProducts.view30DayFreeTrialPageAndForm();

		LocalFile.WWWProducts.create30DayFreeTrialDownloadRequest(table = '''| Work Email      | usr.liferaydxp1@lrcustomer.com.broken |
	| Country         | United States                         |  
	| State/Territory | California                            |
	| Download Type   | OSGI Dependencies                     |
	| First Name      | USR                                   |
	| Last Name       | LiferayDXP1                           |
	| Company         | Usrdxp                                |
	| Phone           | 555-555-5678                          |''');

		LocalFile.WWWHomepage.pauseInMinutes(timeInMinutes = 4);

		LocalFile.Downloads.viewDownloadedFile(fileName = "liferay-dxp-osgi-7.4.13.u62-20230201110539226.zip");

		LocalFile.WWWHomepage.viewURLContent(urlText = "products/dxp/30-day-trial/thank-you");
	}

	test ViewDXPsectionvideo {
		LocalFile.WWWHomepage.gotoRelativeURL(url = "products/dxp");

		LocalFile.WWWProducts.viewSectionVideo();
	}

	test ViewDXPtopnavigationlinks {
		LocalFile.WWWHomepage.gotoRelativeURL(url = "products/dxp");

		LocalFile.WWWProducts.clickDXPPageTopNavigationLinks(linkName = "What's New");

		LocalFile.WWWHomepage.viewNoErrors();

		LocalFile.WWWHomepage.viewURLContent(urlText = "www-uat.liferay.com/products/dxp/new");

		LocalFile.WWWHomepage.gotoRelativeURL(url = "products/dxp");

		LocalFile.WWWProducts.clickDXPPageTopNavigationLinks(linkName = "Manage");

		LocalFile.WWWHomepage.viewNoErrors();

		LocalFile.WWWHomepage.viewURLContent(urlText = "www-uat.liferay.com/products/dxp/manage");

		LocalFile.WWWHomepage.gotoRelativeURL(url = "products/dxp");

		LocalFile.WWWProducts.clickDXPPageTopNavigationLinks(linkName = "Experience");

		LocalFile.WWWHomepage.viewNoErrors();

		LocalFile.WWWHomepage.viewURLContent(urlText = "www-uat.liferay.com/products/dxp");

		LocalFile.WWWHomepage.gotoRelativeURL(url = "products/dxp");

		LocalFile.WWWProducts.clickDXPPageTopNavigationLinks(linkName = "Commerce");

		LocalFile.WWWHomepage.viewNoErrors();

		LocalFile.WWWHomepage.viewURLContent(urlText = "www-uat.liferay.com/products/dxp/commerce");

		LocalFile.WWWHomepage.gotoRelativeURL(url = "products/dxp");

		LocalFile.WWWProducts.clickDXPPageTopNavigationLinks(linkName = "Architecture");

		LocalFile.WWWHomepage.viewNoErrors();

		LocalFile.WWWHomepage.viewURLContent(urlText = "www-uat.liferay.com/products/dxp/architecture");
	}

	test Viewrenewtrialpageandrequestasalesconsultation {
		LocalFile.WWWHomepage.gotoRelativeURL(url = "products/dxp/30-day-trial");

		LocalFile.WWWProducts.clickRenewYourTrialLicenseHereLink();

		LocalFile.WWWHomepage.viewNoErrors();

		LocalFile.WWWHomepage.viewURLContent(urlText = "www.liferay.com/extend-your-trial");

		LocalFile.WWWHomepage.gotoRelativeURL(url = "products/dxp/30-day-trial/next-steps");

		LocalFile.WWWHomepage.acceptAllCookies();

		LocalFile.WWWProducts.viewRequestASalesConsultationForm();

		LocalFile.WWWProducts.createSalesConsultationRequest(table = '''| Work Email            | usr.liferaydxp1@lrcustomer.com.broken |
	| Country               | United States                         |  
	| State/Territory       | California                            |
	| Whats your challenge? | Increasing B2B online revenue         |
	| First Name            | USR                                   |
	| Last Name             | LiferayDXP1                           |
	| Company               | Usrdxp                                |
	| Phone                 | 555-555-5678                          |
	| Industry              | Technology                            |''');

		LocalFile.WWWHomepage.pauseInMinutes(timeInMinutes = 1);

		LocalFile.WWWProducts.viewMessageAfterSubmitSalesConsultationForm();
	}

}