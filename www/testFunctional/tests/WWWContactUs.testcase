definition {

	property testray.main.component.name = "Support QA";

	test SubmitContactUsForm {
		WWWHomepage.gotoHomePage();

		WWWHomepage.clickFooterLink(linkName = "Contact Us");

		WWWContactUs.viewContactUsPageAndForm();

		WWWContactUs.createContactRequest(table = '''| Work Email                         | usr.contact1@lrcustomer.com.broken |
	| Country                            | United States                      |
	| State/Territory                    | California                         |
	| What would you like to talk about? | Test request contact               |
	| First Name                         | USR                                |
	| Last Name                          | Contact1                           |
	| Company                            | Usrcont                            |
	| Phone                              | 555-555-5678                       |
	| Industry                           | Technology                         |''');

		WWWHomepage.pause(timeInSeconds = 5);

		WWWContactUs.viewMessageAfterSubmitContactForm();

		WWWHomepage.viewURLContent(urlText = "contact-us/thank-you");
	}

}