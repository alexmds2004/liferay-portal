definition {

	property testray.main.component.name = "Support QA";

	setUp {
		Passwords.getPasswords();
	}

	tearDown {
		WWWHomepage.pause(timeInSeconds = 10);

		WWWSignIn.signOutAndSignIn(
			emailAddress = ${staticWWWAdminEmailAddress},
			password = ${staticWWWAdminPassword});

		WWWHomepage.pause(timeInSeconds = 5);

		WWWHomepage.gotoRelativeURL(url = "web/l");

		Page.tearDownCP(table = '''| Test Event1 Page |
	| Test Event2 Page |''');
	}

	test AddLandingPageWithRemovedSection {
		WWWHomepage.gotoHomePage();

		WWWHomepage.clickFooterSignInCreateAccountLink();

		WWWSignIn.signIn(
			emailAddress = ${staticWWWAdminEmailAddress},
			password = ${staticWWWAdminPassword});

		WWWHomepage.pause(timeInSeconds = 5);

		WWWHomepage.gotoRelativeURL(url = "web/l");

		ProductMenu.gotoPortlet(
			category = "Site Builder",
			panel = "Site Administration",
			portlet = "Pages");

		Page.clickAddPublicPageButton();

		Page.clickPageTemplate(pageTemplate = "Event - Thank You");

		Page.addPublicPage(pageName = "Test Event1 Page");

		Page.gotoEditorSidebarCategory(sidebarCategory = "browser");

		Page.removeSection(positionValue = 2);

		Page.clickPublishButton();

		Page.viewPublicPage(pageName = "Test Event1 Page");
	}

}