definition {

	property testray.main.component.name = "Support QA";

	setUp {
		Passwords.getPasswords();
	}

	tearDown {
		WWWHomepage.pause(timeInSeconds = 10);

		WWWSignIn.signOutAndSignIn(
			emailAddress = ${staticWWWAdminEmailAddress},
			password = ${staticWWWAdminPassword});

		DocumentsAndMedia.tearDownCP(table = '''| Document_1 |''');
	}

	test AddWhitepaper {
		WWWHomepage.gotoHomePage();

		WWWHomepage.clickFooterSignInCreateAccountLink();

		WWWSignIn.signIn(
			emailAddress = ${staticWWWAdminEmailAddress},
			password = ${staticWWWAdminPassword});

		ProductMenu.gotoPortlet(
			category = "Content & Data",
			panel = "Site Administration",
			portlet = "Documents and Media");

		ProductMenuHelper.closeProductMenu();

		DocumentsAndMedia.gotoFolder(folderName = "RESOURCES");

		DocumentsAndMedia.gotoFolder(folderName = "whitepapers");

		DocumentsAndMedia.gotoMarketingAssetDocumentForm();

		DocumentsAndMedia.expandBottomPanelHeader(bottomPanelCategory = "Custom Fields");

		DocumentsAndMedia.expandBottomPanelHeader(bottomPanelCategory = "Categorization");

		DocumentsAndMedia.createDocument(table = '''| File Upload          | File Upload        | Document_1.pdf       |
	| Primary Buyer Stage  | Select             | Evaluation           |
	| Seo Description      | Bottom Panel Input | Test Seo Description |
	| Seo Title            | Bottom Panel Input | Test Seo Title       |
	| Category List Filter | Category Select    | Resources            |
	| Language             | Category Select    | English              |
	| Resource Type        | Category Select    | Whitepapers          |
	| Topic                | Category Select    | Customer Experience  |''');

		DocumentsAndMedia.clickPublish();

		WWWSignIn.signOut();

		WWWHomepage.gotoRelativeURL(url = "resources");

		WWWResourceLibrary.filterResources(table = '''| Resource Types | Whitepapers |''');

		WWWResourceLibrary.viewResource(resourceTitle = "Document_1");
	}

}