definition {

	property testray.main.component.name = "Support QA";

	setUp {
		Passwords.getPasswords();
	}

	tearDown {
		WWWHomepage.pause(timeInSeconds = 10);

		WWWSignIn.signOutAndSignIn(
			emailAddress = ${staticWWWAdminEmailAddress},
			password = ${staticWWWAdminPassword});

		WebContent.tearDownCP(table = '''| ABC Education Test 1 |''');
	}

	test AddCaseStudy {
		WWWHomepage.gotoHomePage();

		WWWHomepage.clickFooterSignInCreateAccountLink();

		WWWSignIn.signIn(
			emailAddress = ${staticWWWAdminEmailAddress},
			password = ${staticWWWAdminPassword});

		ProductMenu.gotoPortlet(
			category = "Content & Data",
			panel = "Site Administration",
			portlet = "Web Content");

		WebContent.gotoFolder(folderName = "RESOURCES");

		WebContent.gotoFolder(folderName = "CASE STUDIES");

		WebContent.gotoNewWebContentForm(type = "Case Study");

		WebContent.expandSidePanelHeader(sidePanelCategory = "Categorization");

		WebContent.createWebContent(table = '''| Title                |                 | ABC Education Test 1                                          |
	| Company Name         | Input           | ABC Education 1                                               |
	| Company Logo         | File Upload     | RESOURCES,case-studies,ABC EDUCATION,ABC Education logo yello |
	| Subheading           | Input           | Heading 1                                                     |
	| Summary              | Textarea        | This is the first test summary                                |
	| Subheading           | Input           | Heading 2                                                     |
	| Summary              | Textarea        | This is the second test summary                               |
	| Quote                | Textarea        | I am the first to comment on this case study                  |
	| Quotee               | Input           | First User                                                    |
	| Quotee Info          | Input           | The first user to comment                                     |
	| Asset                | File Upload     | RESOURCES,case-studies,ABC EDUCATION,ABC Education            |
	| Button Text          | Input           | ABC Education Case Study PDF                                  |
	| Additional Image     | File Upload     | RESOURCES,case-studies,ABC EDUCATION,ABC Education screenshot |
	| Key Features         | Textarea        | We have features like you cannot imagine                      |
	| Challenges           | Input           | One big challenge                                             |
	| Challenges           | Input           | Another slightly bigger challenge                             |
	| Result               | Input           | Result 1                                                      |
	| Brief Description    | Input           | First result from dealing with challenge one                  |
	| Result               | Input           | Result 2                                                      |
	| Brief Description    | Input           | Second result from dealing with challenge two                 |
	| Category List Filter | Category Select | Resources                                                     |
	| Industries           | Category Select | Education                                                     |
	| Language             | Category Select | English                                                       |
	| Location             | Category Select | United States                                                 |
	| Resource Types       | Category Select | Case Studies                                                  |
	| Solutions            | Category Select | Customer Portals                                              |
	| Topic                | Category Select | Digital Strategy                                              |''');

		WebContent.clickPublish();

		WWWHomepage.pause(timeInSeconds = 3);

		WWWSignIn.signOut();

		WWWHomepage.gotoRelativeURL(url = "resources");

		WWWResourceLibrary.filterResources(table = '''| Resource Types | Case Studies |''');

		WWWResourceLibrary.viewResource(resourceTitle = "ABC Education Test 1");

		WWWHomepage.gotoRelativeURL(url = "resources/case-studies/abc-education-test-1");

		WWWHomepage.viewText(table = '''| Heading 1                                     |
	| This is the first test summary                |
	| Heading 2                                     |
	| This is the second test summary               |
	| ABC Education Case Study PDF                  |
	| I am the first to comment on this case study  |
	| First User                                    |
	| THE FIRST USER TO COMMENT                     |
	| Key Features                                  |
	| We have features like you cannot imagine      |
	| Challenges                                    |
	| One big challenge                             |
	| Another slightly bigger challenge             |
	| Results                                       |
	| Result 1                                      |
	| First result from dealing with challenge one  |
	| Result 2                                      |
	| Second result from dealing with challenge two |
	| TOPIC                                         |
	| Digital Strategy                              |''');
	}

}