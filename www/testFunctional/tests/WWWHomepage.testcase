definition {

	property testray.main.component.name = "Support QA";

	test AdditionalFooterNavigation {
		WWWHomepage.gotoHomePage();

		WWWHomepage.clickFooterLink(linkName = "Contact Us");

		WWWHomepage.viewNoErrors();

		WWWHomepage.viewURLContent(urlText = "www-uat.liferay.com");

		WWWHomepage.gotoHomePage();

		WWWHomepage.clickFooterLink(linkName = "Privacy Policy");

		WWWHomepage.viewNoErrors();

		WWWHomepage.viewURLContent(urlText = "www-uat.liferay.com");
	}

	test ChangeLanguages {
		WWWHomepage.gotoHomePage();

		WWWHomepage.changeLanguage(language = "Chinese");

		WWWHomepage.viewNoErrors();

		WWWHomepage.viewURLContent(urlText = "/zh");

		WWWHomepage.gotoTranslatedHomePage();

		WWWHomepage.changeLanguage(language = "Australian English");

		WWWHomepage.viewNoErrors();

		WWWHomepage.viewURLContent(urlText = "/en-AU");

		WWWHomepage.gotoTranslatedHomePage();

		WWWHomepage.changeLanguage(language = "American English");

		WWWHomepage.viewNoErrors();

		WWWHomepage.gotoHomePage();

		WWWHomepage.changeLanguage(language = "French");

		WWWHomepage.viewNoErrors();

		WWWHomepage.viewURLContent(urlText = "/fr");

		WWWHomepage.gotoTranslatedHomePage();

		WWWHomepage.changeLanguage(language = "German");

		WWWHomepage.viewNoErrors();

		WWWHomepage.viewURLContent(urlText = "/de");

		WWWHomepage.gotoTranslatedHomePage();

		WWWHomepage.changeLanguage(language = "Italian");

		WWWHomepage.viewNoErrors();

		WWWHomepage.viewURLContent(urlText = "/it");

		WWWHomepage.gotoTranslatedHomePage();

		WWWHomepage.changeLanguage(language = "Portuguese");

		WWWHomepage.viewNoErrors();

		WWWHomepage.viewURLContent(urlText = "/pt");

		WWWHomepage.gotoTranslatedHomePage();

		WWWHomepage.changeLanguage(language = "Spanish");

		WWWHomepage.viewNoErrors();

		WWWHomepage.viewURLContent(urlText = "/es");

		WWWHomepage.gotoTranslatedHomePage();

		WWWHomepage.changeLanguage(language = "Japanese");

		WWWHomepage.viewNoErrors();

		WWWHomepage.viewURLContent(urlText = ".co.jp");
	}

	test Changelanguagesviafooterdropdown {
		WWWHomepage.gotoHomePage();

		WWWHomepage.changeLanguageViaFooterDropdown(languageName = "中文");

		WWWHomepage.viewNoErrors();

		WWWHomepage.viewURLContent(urlText = "/zh");

		WWWHomepage.gotoTranslatedHomePage();

		WWWHomepage.changeLanguageViaFooterDropdown(languageName = "English (Australia)");

		WWWHomepage.viewNoErrors();

		WWWHomepage.viewURLContent(urlText = "/en-AU");

		WWWHomepage.gotoTranslatedHomePage();

		WWWHomepage.changeLanguageViaFooterDropdown(languageName = "English (United States)");

		WWWHomepage.viewNoErrors();

		WWWHomepage.gotoHomePage();

		WWWHomepage.changeLanguageViaFooterDropdown(languageName = "Français");

		WWWHomepage.viewNoErrors();

		WWWHomepage.viewURLContent(urlText = "/fr");

		WWWHomepage.gotoTranslatedHomePage();

		WWWHomepage.changeLanguageViaFooterDropdown(languageName = "Deutsch");

		WWWHomepage.viewNoErrors();

		WWWHomepage.viewURLContent(urlText = "/de");

		WWWHomepage.gotoTranslatedHomePage();

		WWWHomepage.changeLanguageViaFooterDropdown(languageName = "Italiano");

		WWWHomepage.viewNoErrors();

		WWWHomepage.viewURLContent(urlText = "/it");

		WWWHomepage.gotoTranslatedHomePage();

		WWWHomepage.changeLanguageViaFooterDropdown(languageName = "Português");

		WWWHomepage.viewNoErrors();

		WWWHomepage.viewURLContent(urlText = "/pt");

		WWWHomepage.gotoTranslatedHomePage();

		WWWHomepage.changeLanguageViaFooterDropdown(languageName = "Español");

		WWWHomepage.viewNoErrors();

		WWWHomepage.viewURLContent(urlText = "/es");

		WWWHomepage.gotoTranslatedHomePage();

		WWWHomepage.changeLanguageViaFooterDropdown(languageName = "日本語");

		WWWHomepage.viewNoErrors();

		WWWHomepage.viewURLContent(urlText = ".co.jp");
	}

	test SocialMediaFooterNavigation {
		WWWHomepage.gotoHomePage();

		WWWHomepage.clickFooterSocialMediaLink(socialMedia = "Facebook");

		WWWHomepage.selectWindow(windowTitle = "Liferay | Diamond Bar CA | Facebook");

		WWWHomepage.viewNoErrors();

		WWWHomepage.closeWindow(windowTitle = "Liferay | Diamond Bar CA | Facebook");

		WWWHomepage.clickFooterSocialMediaLink(socialMedia = "Github");

		WWWHomepage.selectWindow(windowTitle = "Liferay Inc. · GitHub");

		WWWHomepage.viewNoErrors();

		WWWHomepage.closeWindow(windowTitle = "Liferay Inc. · GitHub");

		WWWHomepage.clickFooterSocialMediaLink(socialMedia = "Instagram");

		WWWHomepage.selectWindow(windowTitle = "Liferay, Inc. (@liferayinc) | Instagram");

		WWWHomepage.viewNoErrors();

		WWWHomepage.closeWindow(windowTitle = "Liferay, Inc. (@liferayinc) | Instagram");

		WWWHomepage.clickFooterSocialMediaLink(socialMedia = "LinkedIn");

		WWWHomepage.selectPopUpWindow();

		WWWHomepage.viewNoErrors();

		WWWHomepage.closePopUpWindow();

		WWWHomepage.clickFooterSocialMediaLink(socialMedia = "Twitter");

		WWWHomepage.selectWindow(windowTitle = "Liferay (@Liferay) / Twitter");

		WWWHomepage.viewNoErrors();

		WWWHomepage.closeWindow(windowTitle = "Liferay (@Liferay) / Twitter");

		WWWHomepage.clickFooterSocialMediaLink(socialMedia = "YouTube");

		WWWHomepage.selectWindow(windowTitle = "Liferay - YouTube");

		WWWHomepage.viewNoErrors();

		WWWHomepage.closeWindow(windowTitle = "Liferay - YouTube");
	}

	test Viewhomepagehreflangcanonicaltags {
		WWWHomepage.gotoHomePage();

		WWWHomepage.changeLanguage(language = "Chinese");

		WWWHomepage.assertHreflangCanonicalTag(relativeLanguageUrl = "zh/");

		WWWHomepage.gotoTranslatedHomePage();

		WWWHomepage.changeLanguage(language = "American English");

		WWWHomepage.assertHreflangCanonicalTag(relativeLanguageUrl = "");

		WWWHomepage.gotoHomePage();

		WWWHomepage.changeLanguage(language = "French");

		WWWHomepage.assertHreflangCanonicalTag(relativeLanguageUrl = "fr/");

		WWWHomepage.gotoTranslatedHomePage();

		WWWHomepage.changeLanguage(language = "German");

		WWWHomepage.assertHreflangCanonicalTag(relativeLanguageUrl = "de/");

		WWWHomepage.gotoTranslatedHomePage();

		WWWHomepage.changeLanguage(language = "Italian");

		WWWHomepage.assertHreflangCanonicalTag(relativeLanguageUrl = "it/");

		WWWHomepage.gotoTranslatedHomePage();

		WWWHomepage.changeLanguage(language = "Portuguese");

		WWWHomepage.assertHreflangCanonicalTag(relativeLanguageUrl = "pt/");

		WWWHomepage.gotoTranslatedHomePage();

		WWWHomepage.changeLanguage(language = "Spanish");

		WWWHomepage.assertHreflangCanonicalTag(relativeLanguageUrl = "es/");
	}

	test Viewhomepagehreflangtags {
		WWWHomepage.gotoHomePage();

		WWWHomepage.assertHreflangTag(
			hreflang = "zh-CN",
			relativeLanguageUrl = "zh/");

		WWWHomepage.assertHreflangTag(
			hreflang = "es-ES",
			relativeLanguageUrl = "es/");

		WWWHomepage.assertHreflangTag(
			hreflang = "it-IT",
			relativeLanguageUrl = "it/");

		WWWHomepage.assertHreflangTag(
			hreflang = "fr-FR",
			relativeLanguageUrl = "fr/");

		WWWHomepage.assertHreflangTag(
			hreflang = "en-US",
			relativeLanguageUrl = "");

		WWWHomepage.assertHreflangTag(
			hreflang = "pt-BR",
			relativeLanguageUrl = "pt/");

		WWWHomepage.assertHreflangTag(
			hreflang = "de-DE",
			relativeLanguageUrl = "de/");
	}

	test Viewhomepagetitleandmetadescription {
		WWWHomepage.gotoHomePage();

		WWWHomepage.assertPageTitle(pageTitle = "Digital Experience Software Tailored to Your Needs | Liferay");

		WWWHomepage.assertPageMetaDescription(pageMetaDescription = "Build portals, intranets, websites and connected experiences on the most extensible digital experience platform around. Learn more.");
	}

	test ViewOGTags {
		WWWHomepage.gotoHomePage();

		WWWHomepage.assertPageOgTitleTag(pageOgTitleTag = "Digital Experience Software Tailored to Your Needs | Liferay");

		WWWHomepage.assertPageOgDescriptionTag(pageOgDescriptionTag = "Build portals, intranets, websites and connected experiences on the most extensible digital experience platform around. Learn more.");

		WWWHomepage.assertPageOgURLTag(pageOgUrlTag = "https://www-uat.liferay.com/");

		WWWHomepage.assertPageOgImageTag(pageOgImageTag = "https://www-uat.liferay.com/documents/10182/0/open_graph_image");
	}

}