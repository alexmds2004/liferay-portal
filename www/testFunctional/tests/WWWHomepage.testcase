definition {

	property testray.main.component.name = "Support QA";

	test AdditionalFooterNavigation {
		LocalFile.WWWHomepage.gotoHomePage();

		LocalFile.WWWHomepage.clickFooterLink(linkName = "Contact Us");

		LocalFile.WWWHomepage.viewNoErrors();

		LocalFile.WWWHomepage.viewURLContent(urlText = "www-uat.liferay.com");

		LocalFile.WWWHomepage.gotoHomePage();

		LocalFile.WWWHomepage.clickFooterLink(linkName = "Privacy Policy");

		LocalFile.WWWHomepage.viewNoErrors();

		LocalFile.WWWHomepage.viewURLContent(urlText = "www-uat.liferay.com");
	}

	test ChangeLanguages {
		LocalFile.WWWHomepage.gotoHomePage();

		LocalFile.WWWHomepage.changeLanguage(language = "Chinese");

		LocalFile.WWWHomepage.viewNoErrors();

		LocalFile.WWWHomepage.viewURLContent(urlText = "/zh");

		LocalFile.WWWHomepage.gotoTranslatedHomePage();

		LocalFile.WWWHomepage.changeLanguage(language = "Australian English");

		LocalFile.WWWHomepage.viewNoErrors();

		LocalFile.WWWHomepage.viewURLContent(urlText = "/en-AU");

		LocalFile.WWWHomepage.gotoTranslatedHomePage();

		LocalFile.WWWHomepage.changeLanguage(language = "American English");

		LocalFile.WWWHomepage.viewNoErrors();

		LocalFile.WWWHomepage.gotoHomePage();

		LocalFile.WWWHomepage.changeLanguage(language = "French");

		LocalFile.WWWHomepage.viewNoErrors();

		LocalFile.WWWHomepage.viewURLContent(urlText = "/fr");

		LocalFile.WWWHomepage.gotoTranslatedHomePage();

		LocalFile.WWWHomepage.changeLanguage(language = "German");

		LocalFile.WWWHomepage.viewNoErrors();

		LocalFile.WWWHomepage.viewURLContent(urlText = "/de");

		LocalFile.WWWHomepage.gotoTranslatedHomePage();

		LocalFile.WWWHomepage.changeLanguage(language = "Italian");

		LocalFile.WWWHomepage.viewNoErrors();

		LocalFile.WWWHomepage.viewURLContent(urlText = "/it");

		LocalFile.WWWHomepage.gotoTranslatedHomePage();

		LocalFile.WWWHomepage.changeLanguage(language = "Portuguese");

		LocalFile.WWWHomepage.viewNoErrors();

		LocalFile.WWWHomepage.viewURLContent(urlText = "/pt");

		LocalFile.WWWHomepage.gotoTranslatedHomePage();

		LocalFile.WWWHomepage.changeLanguage(language = "Spanish");

		LocalFile.WWWHomepage.viewNoErrors();

		LocalFile.WWWHomepage.viewURLContent(urlText = "/es");

		LocalFile.WWWHomepage.gotoTranslatedHomePage();

		LocalFile.WWWHomepage.changeLanguage(language = "Japanese");

		LocalFile.WWWHomepage.viewNoErrors();

		LocalFile.WWWHomepage.viewURLContent(urlText = ".co.jp");
	}

	test Changelanguagesviafooterdropdown {
		LocalFile.WWWHomepage.gotoHomePage();

		LocalFile.WWWHomepage.changeLanguageViaFooterDropdown(languageName = "中文");

		LocalFile.WWWHomepage.viewNoErrors();

		LocalFile.WWWHomepage.viewURLContent(urlText = "/zh");

		LocalFile.WWWHomepage.gotoTranslatedHomePage();

		LocalFile.WWWHomepage.changeLanguageViaFooterDropdown(languageName = "English (Australia)");

		LocalFile.WWWHomepage.viewNoErrors();

		LocalFile.WWWHomepage.viewURLContent(urlText = "/en-AU");

		LocalFile.WWWHomepage.gotoTranslatedHomePage();

		LocalFile.WWWHomepage.changeLanguageViaFooterDropdown(languageName = "English (United States)");

		LocalFile.WWWHomepage.viewNoErrors();

		LocalFile.WWWHomepage.gotoHomePage();

		LocalFile.WWWHomepage.changeLanguageViaFooterDropdown(languageName = "Français");

		LocalFile.WWWHomepage.viewNoErrors();

		LocalFile.WWWHomepage.viewURLContent(urlText = "/fr");

		LocalFile.WWWHomepage.gotoTranslatedHomePage();

		LocalFile.WWWHomepage.changeLanguageViaFooterDropdown(languageName = "Deutsch");

		LocalFile.WWWHomepage.viewNoErrors();

		LocalFile.WWWHomepage.viewURLContent(urlText = "/de");

		LocalFile.WWWHomepage.gotoTranslatedHomePage();

		LocalFile.WWWHomepage.changeLanguageViaFooterDropdown(languageName = "Italiano");

		LocalFile.WWWHomepage.viewNoErrors();

		LocalFile.WWWHomepage.viewURLContent(urlText = "/it");

		LocalFile.WWWHomepage.gotoTranslatedHomePage();

		LocalFile.WWWHomepage.changeLanguageViaFooterDropdown(languageName = "Português");

		LocalFile.WWWHomepage.viewNoErrors();

		LocalFile.WWWHomepage.viewURLContent(urlText = "/pt");

		LocalFile.WWWHomepage.gotoTranslatedHomePage();

		LocalFile.WWWHomepage.changeLanguageViaFooterDropdown(languageName = "Español");

		LocalFile.WWWHomepage.viewNoErrors();

		LocalFile.WWWHomepage.viewURLContent(urlText = "/es");

		LocalFile.WWWHomepage.gotoTranslatedHomePage();

		LocalFile.WWWHomepage.changeLanguageViaFooterDropdown(languageName = "日本語");

		LocalFile.WWWHomepage.viewNoErrors();

		LocalFile.WWWHomepage.viewURLContent(urlText = ".co.jp");
	}

	test SocialMediaFooterNavigation {
		LocalFile.WWWHomepage.gotoHomePage();

		LocalFile.WWWHomepage.clickFooterSocialMediaLink(socialMedia = "Facebook");

		LocalFile.WWWHomepage.selectWindow(windowTitle = "Liferay | Diamond Bar CA | Facebook");

		LocalFile.WWWHomepage.viewNoErrors();

		LocalFile.WWWHomepage.closeWindow(windowTitle = "Liferay | Diamond Bar CA | Facebook");

		LocalFile.WWWHomepage.clickFooterSocialMediaLink(socialMedia = "Github");

		LocalFile.WWWHomepage.selectWindow(windowTitle = "Liferay Inc. · GitHub");

		LocalFile.WWWHomepage.viewNoErrors();

		LocalFile.WWWHomepage.closeWindow(windowTitle = "Liferay Inc. · GitHub");

		LocalFile.WWWHomepage.clickFooterSocialMediaLink(socialMedia = "Instagram");

		LocalFile.WWWHomepage.selectWindow(windowTitle = "Liferay, Inc. (@liferayinc) • Instagram photos and videos");

		LocalFile.WWWHomepage.viewNoErrors();

		LocalFile.WWWHomepage.closeWindow(windowTitle = "Liferay, Inc. (@liferayinc) • Instagram photos and videos");

		LocalFile.WWWHomepage.clickFooterSocialMediaLink(socialMedia = "LinkedIn");

		LocalFile.WWWHomepage.selectPopUpWindow();

		LocalFile.WWWHomepage.viewNoErrors();

		LocalFile.WWWHomepage.closePopUpWindow();

		LocalFile.WWWHomepage.clickFooterSocialMediaLink(socialMedia = "Twitter");

		LocalFile.WWWHomepage.selectWindow(windowTitle = "Liferay (@Liferay) / Twitter");

		LocalFile.WWWHomepage.viewNoErrors();

		LocalFile.WWWHomepage.closeWindow(windowTitle = "Liferay (@Liferay) / Twitter");

		LocalFile.WWWHomepage.clickFooterSocialMediaLink(socialMedia = "YouTube");

		LocalFile.WWWHomepage.selectWindow(windowTitle = "Liferay - YouTube");

		LocalFile.WWWHomepage.viewNoErrors();

		LocalFile.WWWHomepage.closeWindow(windowTitle = "Liferay - YouTube");
	}

	test Viewhomepagehreflangcanonicaltags {
		LocalFile.WWWHomepage.gotoHomePage();

		LocalFile.WWWHomepage.changeLanguage(language = "Chinese");

		LocalFile.WWWHomepage.assertHreflangCanonicalTag(relativeLanguageUrl = "zh/");

		LocalFile.WWWHomepage.gotoTranslatedHomePage();

		LocalFile.WWWHomepage.changeLanguage(language = "American English");

		LocalFile.WWWHomepage.assertHreflangCanonicalTag(relativeLanguageUrl = "");

		LocalFile.WWWHomepage.gotoHomePage();

		LocalFile.WWWHomepage.changeLanguage(language = "French");

		LocalFile.WWWHomepage.assertHreflangCanonicalTag(relativeLanguageUrl = "fr/");

		LocalFile.WWWHomepage.gotoTranslatedHomePage();

		LocalFile.WWWHomepage.changeLanguage(language = "German");

		LocalFile.WWWHomepage.assertHreflangCanonicalTag(relativeLanguageUrl = "de/");

		LocalFile.WWWHomepage.gotoTranslatedHomePage();

		LocalFile.WWWHomepage.changeLanguage(language = "Italian");

		LocalFile.WWWHomepage.assertHreflangCanonicalTag(relativeLanguageUrl = "it/");

		LocalFile.WWWHomepage.gotoTranslatedHomePage();

		LocalFile.WWWHomepage.changeLanguage(language = "Portuguese");

		LocalFile.WWWHomepage.assertHreflangCanonicalTag(relativeLanguageUrl = "pt/");

		LocalFile.WWWHomepage.gotoTranslatedHomePage();

		LocalFile.WWWHomepage.changeLanguage(language = "Spanish");

		LocalFile.WWWHomepage.assertHreflangCanonicalTag(relativeLanguageUrl = "es/");
	}

	test Viewhomepagehreflangtags {
		LocalFile.WWWHomepage.gotoHomePage();

		LocalFile.WWWHomepage.assertHreflangTag(
			hreflang = "zh-CN",
			relativeLanguageUrl = "zh/");

		LocalFile.WWWHomepage.assertHreflangTag(
			hreflang = "es-ES",
			relativeLanguageUrl = "es/");

		LocalFile.WWWHomepage.assertHreflangTag(
			hreflang = "it-IT",
			relativeLanguageUrl = "it/");

		LocalFile.WWWHomepage.assertHreflangTag(
			hreflang = "fr-FR",
			relativeLanguageUrl = "fr/");

		LocalFile.WWWHomepage.assertHreflangTag(
			hreflang = "en-US",
			relativeLanguageUrl = "");

		LocalFile.WWWHomepage.assertHreflangTag(
			hreflang = "pt-BR",
			relativeLanguageUrl = "pt/");

		LocalFile.WWWHomepage.assertHreflangTag(
			hreflang = "de-DE",
			relativeLanguageUrl = "de/");
	}

	test Viewhomepagetitleandmetadescription {
		LocalFile.WWWHomepage.gotoHomePage();

		LocalFile.WWWHomepage.assertPageTitle(pageTitle = "Digital Experience Software Tailored to Your Needs | Liferay");

		LocalFile.WWWHomepage.assertPageMetaDescription(pageMetaDescription = "Build portals, intranets, websites and connected experiences on the most extensible digital experience platform around. Learn more.");
	}

	test ViewOGTags {
		LocalFile.WWWHomepage.gotoHomePage();

		LocalFile.WWWHomepage.assertPageOgTitleTag(pageOgTitleTag = "Digital Experience Software Tailored to Your Needs | Liferay");

		LocalFile.WWWHomepage.assertPageOgDescriptionTag(pageOgDescriptionTag = "Build portals, intranets, websites and connected experiences on the most extensible digital experience platform around. Learn more.");

		LocalFile.WWWHomepage.assertPageOgURLTag(pageOgUrlTag = "https://www-uat.liferay.com/");

		LocalFile.WWWHomepage.assertPageOgImageTag(pageOgImageTag = "https://www-uat.liferay.com/documents/10182/0/open_graph_image");
	}

}