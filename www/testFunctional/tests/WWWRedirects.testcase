definition {

	property testray.main.component.name = "Support QA";

	setUp {
		Passwords.getPasswords();
	}

	tearDown {
		WWWHomepage.pause(timeInSeconds = 10);

		WWWSignIn.signOutAndSignIn(
			emailAddress = ${staticWWWAdminEmailAddress},
			password = ${staticWWWAdminPassword});

		WWWRedirects.tearDownCP(table = '''| privacy | https://www.liferay.com/privacy-policy |''');
	}

	test AddSourceLink {
		WWWHomepage.gotoHomePage();

		WWWHomepage.clickFooterSignInCreateAccountLink();

		WWWSignIn.signIn(
			emailAddress = ${staticWWWAdminEmailAddress},
			password = ${staticWWWAdminPassword});

		ProductMenu.gotoPortlet(
			category = "Configuration",
			panel = "Site Administration",
			portlet = "Redirection");

		WWWRedirects.clickAddButton();

		WWWRedirects.createSourceLink(table = '''| Source URL      | Input  | privacy                                |
	| Destination URL | Input  | https://www.liferay.com/privacy-policy |
	| Type            | Select | Temporary (302)                        |''');

		WWWHomepage.gotoRelativeURL(url = "privacy");

		WWWHomepage.viewURLContent(urlText = "privacy-policy");
	}

}