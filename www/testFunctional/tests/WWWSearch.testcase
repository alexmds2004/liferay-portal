definition {

	property testray.main.component.name = "Support QA";

	test ViewSearchResults {
		WWWHomepage.gotoHomePage();

		WWWHomepage.typeKeywordAndSearch(keyword = "Digital Experience Platform");

		WWWSearch.viewSearchResult(pageTitle = "Digital Experience Platform");

		WWWSearch.clickNextLink();

		WWWSearch.viewSearchResult(pageTitle = "Digital Experience Platform");

		WWWSearch.clickNextLink();

		WWWSearch.viewSearchResult(pageTitle = "Digital Experience Platform");

		WWWSearch.clickPreviousLink();

		WWWSearch.viewSearchResult(pageTitle = "Digital Experience Platform");

		WWWSearch.clickPreviousLink();

		WWWSearch.viewSearchResult(pageTitle = "Digital Experience Platform");

		WWWSearch.typeKeywordAndSearch(keyword = "Portal");

		WWWSearch.viewSearchResult(pageTitle = "Portal");

		WWWSearch.clickNextLink();

		WWWSearch.viewSearchResult(pageTitle = "Portal");

		WWWSearch.clickNextLink();

		WWWSearch.viewSearchResult(pageTitle = "Portal");

		WWWSearch.clickPreviousLink();

		WWWSearch.viewSearchResult(pageTitle = "Portal");

		WWWSearch.clickPreviousLink();

		WWWSearch.viewSearchResult(pageTitle = "Portal");
	}

}