definition {

	property testray.main.component.name = "Support QA";

	setUp {
		LocalFile.Passwords.getPasswords();
	}

	tearDown {
		LocalFile.WWWHomepage.pause(timeInSeconds = 10);

		LocalFile.WWWSignIn.signOutAndSignIn(
			emailAddress = ${staticWWWAdminEmailAddress},
			password = ${staticWWWAdminPassword});

		LocalFile.WebContent.tearDownCP(table = '''| Our Latest and Greatest Press Release |
	| Scheduled press release               |
	| American Press Release                |''');
	}

	test AddPressRelease {
		LocalFile.WWWHomepage.gotoHomePage();

		LocalFile.WWWHomepage.clickFooterSignInCreateAccountLink();

		LocalFile.WWWSignIn.signIn(
			emailAddress = ${staticWWWAdminEmailAddress},
			password = ${staticWWWAdminPassword});

		LocalFile.ProductMenu.gotoPortlet(
			category = "Content & Data",
			panel = "Site Administration",
			portlet = "Web Content");

		LocalFile.WebContent.gotoFolder(folderName = "COMPANY");

		LocalFile.WebContent.gotoFolder(folderName = "PRESS RELEASES");

		LocalFile.WebContent.gotoNewWebContentForm(type = "Press Release");

		LocalFile.WebContent.expandSidePanelHeader(sidePanelCategory = "Categorization");

		LocalFile.WebContent.createWebContent(table = '''| Title                |                 | Our Latest and Greatest Press Release                               |
	| Heading              | Input           | The Latest News From Liferay                                        |
	| Subheading           | Input           | We have lots to tell you                                            |
	| Content              | Textarea        | Plenty has happened at Liferay and we cannot wait to share with you |
	| Category List Filter | Category Select | Press Releases                                                      |
	| Language             | Category Select | English                                                             |
	| Location             | Category Select | United States                                                       |
	| News Type            | Category Select | Company                                                             |
	| type                 | Category Select | press-release                                                       |
	| Year                 | Category Select | 2020                                                                |''');

		LocalFile.WebContent.clickPublish();

		LocalFile.WWWHomepage.pause(timeInSeconds = 3);

		LocalFile.WWWSignIn.signOut();

		LocalFile.WWWHomepage.gotoRelativeURL(url = "press-releases");

		LocalFile.WWWHomepage.viewText(table = '''| Our Latest and Greatest Press Release |''');

		LocalFile.WWWHomepage.gotoRelativeURL(url = "press-release/our-latest-and-greatest-press-release");

		LocalFile.WWWHomepage.viewText(table = '''| The Latest News From Liferay                                        |
	| We have lots to tell you                                            |
	| Plenty has happened at Liferay and we cannot wait to share with you |''');
	}

	test LocalizePressRelease {
		LocalFile.WWWHomepage.gotoHomePage();

		LocalFile.WWWHomepage.clickFooterSignInCreateAccountLink();

		LocalFile.WWWSignIn.signIn(
			emailAddress = ${staticWWWAdminEmailAddress},
			password = ${staticWWWAdminPassword});

		LocalFile.ProductMenu.gotoPortlet(
			category = "Content & Data",
			panel = "Site Administration",
			portlet = "Web Content");

		LocalFile.WebContent.gotoFolder(folderName = "COMPANY");

		LocalFile.WebContent.gotoFolder(folderName = "PRESS RELEASES");

		LocalFile.WebContent.gotoNewWebContentForm(type = "Press Release");

		LocalFile.WebContent.expandSidePanelHeader(sidePanelCategory = "Categorization");

		LocalFile.WebContent.createWebContent(table = '''| Title                |                 | American Press Release                                       |
	| Heading              | Input           | News from the United States                                  |
	| Subheading           | Input           | News concerning our American Market                          |
	| Content              | Textarea        | We have much to tell you about our operations in Los Angeles |
	| Category List Filter | Category Select | Press Releases                                               |
	| Language             | Category Select | English                                                      |
	| Location             | Category Select | United States                                                |
	| News Type            | Category Select | Company                                                      |
	| type                 | Category Select | press-release                                                |
	| Year                 | Category Select | 2020                                                         |''');

		LocalFile.WebContent.changeCurrentLocalization(localization = "en-AU");

		LocalFile.WebContent.clearExistingWebContentFields(table = '''| Heading    | Input    |
	| Subheading | Input    |
	| Content    | Textarea |''');

		LocalFile.WebContent.createWebContent(table = '''| Heading    | Input    | News from the across the pond                                     |
	| Subheading | Input    | News concerning our friends in the states                         |
	| Content    | Textarea | We have much to tell you about what the Americans have been doing |''');

		LocalFile.WebContent.clickPublish();

		LocalFile.WWWHomepage.pause(timeInSeconds = 3);

		LocalFile.WWWSignIn.signOut();

		LocalFile.WWWHomepage.gotoRelativeURL(url = "press-releases");

		LocalFile.WWWHomepage.viewText(table = '''| American Press Release |''');

		LocalFile.WWWHomepage.gotoRelativeURL(url = "press-release/american-press-release");

		LocalFile.WWWHomepage.viewText(table = '''| News from the United States                                  |
	| News concerning our American Market                          |
	| We have much to tell you about our operations in Los Angeles |''');

		LocalFile.WWWHomepage.viewNoText(table = '''| News from the across the pond                                     |
	| News concerning our friends in the states                         |
	| We have much to tell you about what the Americans have been doing |''');

		LocalFile.WWWHomepage.changeLanguage(language = "Australian English");

		LocalFile.WWWHomepage.viewText(table = '''| News from the across the pond                                     |
	| News concerning our friends in the states                         |
	| We have much to tell you about what the Americans have been doing |''');

		LocalFile.WWWHomepage.viewNoText(table = '''| News from the United States                                  |
	| News concerning our American Market                          |
	| We have much to tell you about our operations in Los Angeles |''');
	}

	test SchedulePressRelease {
		LocalFile.WWWHomepage.gotoHomePage();

		LocalFile.WWWHomepage.clickFooterSignInCreateAccountLink();

		LocalFile.WWWSignIn.signIn(
			emailAddress = ${staticWWWAdminEmailAddress},
			password = ${staticWWWAdminPassword});

		LocalFile.ProductMenu.gotoPortlet(
			category = "Content & Data",
			panel = "Site Administration",
			portlet = "Web Content");

		LocalFile.WebContent.gotoFolder(folderName = "COMPANY");

		LocalFile.WebContent.gotoFolder(folderName = "PRESS RELEASES");

		LocalFile.WebContent.gotoNewWebContentForm(type = "Press Release");

		LocalFile.WebContent.expandSidePanelHeader(sidePanelCategory = "Categorization");

		LocalFile.WebContent.expandSidePanelHeader(sidePanelCategory = "Schedule");

		LocalFile.WebContent.createWebContent(table = '''| Title                |                 | Scheduled press release                                          |
	| Heading              | Input           | Scheduled News From Liferay                                      |
	| Subheading           | Input           | We have lots to tell you but we had to wait a bit                |
	| Content              | Textarea        | Plenty has happened at Liferay but we didn't tell you right away |
	| Category List Filter | Category Select | Press Releases                                                   |
	| Language             | Category Select | English                                                          |
	| Location             | Category Select | United States                                                    |
	| News Type            | Category Select | Company                                                          |
	| type                 | Category Select | press-release                                                    |
	| Year                 | Category Select | 2020                                                             |''');

		LocalFile.WebContent.changeDisplayDate(timeInMinutes = 6);

		LocalFile.WebContent.clickPublish();

		LocalFile.WWWHomepage.pause(timeInSeconds = 3);

		LocalFile.WWWSignIn.signOut();

		LocalFile.WWWHomepage.gotoRelativeURL(url = "press-releases");

		LocalFile.WWWHomepage.viewNoText(table = '''| Scheduled press release |''');

		LocalFile.WWWHomepage.gotoRelativeURL(url = "press-release/scheduled-press-release");

		LocalFile.WWWHomepage.viewNoText(table = '''| Scheduled News From Liferay                                      |
	| We have lots to tell you but we had to wait a bit                |
	| Plenty has happened at Liferay but we didn't tell you right away |''');

		LocalFile.WWWHomepage.pauseInMinutes(timeInMinutes = 30);

		LocalFile.WWWHomepage.gotoRelativeURL(url = "press-releases");

		LocalFile.WWWHomepage.viewText(table = '''| Scheduled press release |''');

		LocalFile.WWWHomepage.gotoRelativeURL(url = "press-release/scheduled-press-release");

		LocalFile.WWWHomepage.viewText(table = '''| Scheduled News From Liferay                                      |
	| We have lots to tell you but we had to wait a bit                |
	| Plenty has happened at Liferay but we didn't tell you right away |''');
	}

}