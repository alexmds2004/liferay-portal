definition {

	property testray.main.component.name = "Support QA";

	test Requestsalescontactviacontactsalesform {
		LocalFile.WWWHomepage.gotoHomePage();

		LocalFile.WWWHomepage.clickContactSalesButton();

		LocalFile.WWWContactSales.viewContactSalesPageAndForm();

		LocalFile.WWWContactSales.createSalesContactRequest(table = '''| Work Email                         | usr.contactsales1@lrcustomer.com.broken |
	| Country                            | United States                           |
	| State/Territory                    | California                              |
	| What would you like to talk about? | Test request sales contact              |
	| First Name                         | USR                                     |
	| Last Name                          | ContactSales1                           |
	| Company                            | Cosales                                 |
	| Phone                              | 555-555-5678                            |
	| Industry                           | Technology                              |''');

		LocalFile.WWWHomepage.pause(timeInSeconds = 5);

		LocalFile.WWWContactSales.viewMessageAfterSubmitContactSalesForm();

		LocalFile.WWWHomepage.viewURLContent(urlText = "contact-sales/thank-you");
	}

	test ViewContactSalesPage {
		LocalFile.WWWHomepage.gotoHomePage();

		LocalFile.WWWHomepage.clickContactSalesButton();

		LocalFile.WWWContactSales.viewContactSalesPageAndForm();
	}

}