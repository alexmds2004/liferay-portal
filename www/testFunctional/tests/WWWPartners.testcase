definition {

	property testray.main.component.name = "Support QA";

	test PartnersHomepageNavigation {
		LocalFile.WWWHomepage.gotoRelativeURL(url = "partners");

		LocalFile.WWWHomepage.viewNoErrors();

		LocalFile.WWWPartners.clickCardLink(cardName = "Find a Partner");

		LocalFile.WWWHomepage.viewNoErrors();

		LocalFile.WWWHomepage.viewURLContent(urlText = "www-uat.liferay.com");

		LocalFile.WWWHomepage.gotoRelativeURL(url = "partners");

		LocalFile.WWWPartners.clickCardLink(cardName = "Become a Partner");

		LocalFile.WWWHomepage.viewNoErrors();

		LocalFile.WWWHomepage.viewURLContent(urlText = "www-uat.liferay.com");

		LocalFile.WWWHomepage.gotoRelativeURL(url = "partners");

		LocalFile.WWWPartners.clickCardLink(cardName = "Partner Portal");

		LocalFile.WWWHomepage.viewNoErrors();

		LocalFile.WWWHomepage.viewNoURLContent(urlText = "www-uat.liferay.com");
	}

	test ViewOGTagsinPartnerspage {
		LocalFile.WWWHomepage.gotoRelativeURL(url = "partners");

		LocalFile.WWWHomepage.assertPageOgTitleTag(pageOgTitleTag = "Join the Liferay Partner Ecosystem");

		LocalFile.WWWHomepage.assertPageOgDescriptionTag(pageOgDescriptionTag = "Liferay's Partner Program helps system integrators differentiate themselves in a crowded field as they deliver valuable solutions and provide local support and expertise for our joint clients worldwide. Learn more.");

		LocalFile.WWWHomepage.assertPageOgURLTag(pageOgUrlTag = "https://www-uat.liferay.com/partners");

		LocalFile.WWWHomepage.assertPageOgImageTag(pageOgImageTag = "https://www-uat.liferay.com/documents/10182/0/open_graph_image");
	}

	test ViewPartnerspagehreflangtags {
		LocalFile.WWWHomepage.gotoRelativeURL(url = "partners");

		LocalFile.WWWHomepage.assertHreflangTag(
			hreflang = "zh-CN",
			relativeLanguageUrl = "zh/partners");

		LocalFile.WWWHomepage.assertHreflangTag(
			hreflang = "es-ES",
			relativeLanguageUrl = "es/partners");

		LocalFile.WWWHomepage.assertHreflangTag(
			hreflang = "it-IT",
			relativeLanguageUrl = "it/partners");

		LocalFile.WWWHomepage.assertHreflangTag(
			hreflang = "fr-FR",
			relativeLanguageUrl = "fr/partners");

		LocalFile.WWWHomepage.assertHreflangTag(
			hreflang = "en-US",
			relativeLanguageUrl = "partners");

		LocalFile.WWWHomepage.assertHreflangTag(
			hreflang = "pt-BR",
			relativeLanguageUrl = "pt/partners");

		LocalFile.WWWHomepage.assertHreflangTag(
			hreflang = "de-DE",
			relativeLanguageUrl = "de/partners");
	}

}