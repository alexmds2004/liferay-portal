		LocalFile.WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 2);

		LocalFile.WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 3);

		LocalFile.WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 4);

		LocalFile.WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 5);

		LocalFile.WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 6);

		LocalFile.WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 7);

		LocalFile.WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 8);

		LocalFile.WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 9);

		LocalFile.WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 10);

		LocalFile.WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 11);

		LocalFile.WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 12);
	}

	test ViewRecentLiferayExperienceBlogEntryIndex {
		LocalFile.WWWHomepage.gotoRelativeURL(url = "blog");

		LocalFile.WWWHomepage.acceptAllCookies();

		LocalFile.WWWBlogs.clickBlogCategoryLink(blogCategory = "Liferay Experience");

		LocalFile.WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 1);

		LocalFile.WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 2);

		LocalFile.WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 3);

		LocalFile.WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 4);

		LocalFile.WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 5);

		LocalFile.WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 6);

		LocalFile.WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 7);

		LocalFile.WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 8);

		LocalFile.WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 9);

		LocalFile.WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 10);

		LocalFile.WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 11);

		LocalFile.WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 12);
	}

	test ViewRecentTodaysExperiencesBlogEntryIndex {
		LocalFile.WWWHomepage.gotoRelativeURL(url = "blog");

		LocalFile.WWWHomepage.acceptAllCookies();

		LocalFile.WWWBlogs.clickBlogCategoryLink(blogCategory = "Customer Experience");

		LocalFile.WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 1);

		LocalFile.WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 2);

		LocalFile.WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 3);

		LocalFile.WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 4);

		LocalFile.WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 5);

		LocalFile.WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 6);

		LocalFile.WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 7);

		LocalFile.WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 8);

		LocalFile.WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 9);

		LocalFile.WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 10);

		LocalFile.WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 11);

		LocalFile.WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 12);
	}

