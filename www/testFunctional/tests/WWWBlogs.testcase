definition {

	property testray.main.component.name = "Support QA";

	test ViewBlogEntriesViaBlogLinks {
		WWWHomepage.gotoRelativeURL(url = "blog");

		WWWHomepage.acceptAllCookies();

		WWWBlogs.clickBlogEntryLinkByPosition(positionValue = 1);

		WWWBlogs.viewBlogEntryContent();

		WWWHomepage.gotoRelativeURL(url = "blog");

		WWWBlogs.clickBlogEntryLinkByPosition(positionValue = 3);

		WWWBlogs.viewBlogEntryContent();

		WWWHomepage.gotoRelativeURL(url = "blog");

		WWWBlogs.clickBlogEntryLinkByPosition(positionValue = 5);

		WWWBlogs.viewBlogEntryContent();

		WWWHomepage.gotoRelativeURL(url = "blog");

		WWWBlogs.clickBlogEntryLinkByPosition(positionValue = 7);

		WWWBlogs.viewBlogEntryContent();

		WWWHomepage.gotoRelativeURL(url = "blog");

		WWWBlogs.clickBlogEntryLinkByPosition(positionValue = 9);

		WWWBlogs.viewBlogEntryContent();
	}

	test ViewBlogEntriesViaCustomerExperienceFeaturedLinks {
		WWWHomepage.gotoRelativeURL(url = "blog");

		WWWHomepage.acceptAllCookies();

		WWWBlogs.clickFeaturedBlogLink(
			blogCategory = "Customer Experience",
			positionValue = 1);

		WWWBlogs.viewBlogEntryContent();

		WWWHomepage.gotoRelativeURL(url = "blog");

		WWWBlogs.clickFeaturedBlogLink(
			blogCategory = "Customer Experience",
			positionValue = 2);

		WWWBlogs.viewBlogEntryContent();

		WWWHomepage.gotoRelativeURL(url = "blog");

		WWWBlogs.clickFeaturedBlogLink(
			blogCategory = "Customer Experience",
			positionValue = 3);

		WWWBlogs.viewBlogEntryContent();
	}

	test ViewBlogEntriesViaLiferayExperienceFeaturedLinks {
		WWWHomepage.gotoRelativeURL(url = "blog");

		WWWHomepage.acceptAllCookies();

		WWWBlogs.clickFeaturedBlogLink(
			blogCategory = "Customer Experience",
			positionValue = 1);

		WWWBlogs.viewBlogEntryContent();

		WWWHomepage.gotoRelativeURL(url = "blog");

		WWWBlogs.clickFeaturedBlogLink(
			blogCategory = "Customer Experience",
			positionValue = 2);

		WWWBlogs.viewBlogEntryContent();
	}

	test ViewBlogEntriesViaTodaysExperiencesFeaturedLinks {
		WWWHomepage.gotoRelativeURL(url = "blog");

		WWWHomepage.acceptAllCookies();

		WWWBlogs.clickFeaturedBlogLink(
			blogCategory = "Customer Experience",
			positionValue = 1);

		WWWBlogs.viewBlogEntryContent();

		WWWHomepage.gotoRelativeURL(url = "blog");
	}

	test ViewRecentBlogEntryIndex {
		WWWHomepage.gotoRelativeURL(url = "blog");

		WWWHomepage.acceptAllCookies();

		WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 1);

		WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 2);

		WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 3);

		WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 4);

		WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 5);

		WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 6);
	}

	test ViewRecentBusinessPartnerExperienceBlogEntryIndex {
		WWWHomepage.gotoRelativeURL(url = "blog");

		WWWHomepage.acceptAllCookies();

		WWWBlogs.clickBlogCategoryLink(blogCategory = "Business Partner Experience");

		WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 1);

		WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 2);
	}

	test ViewRecentCustomerExperienceBlogEntryIndex {
		WWWHomepage.gotoRelativeURL(url = "blog");

		WWWHomepage.acceptAllCookies();

		WWWBlogs.clickBlogCategoryLink(blogCategory = "Customer Experience");

		WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 1);

		WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 2);

		WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 3);

		WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 4);

		WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 5);

		WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 6);

		WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 7);

		WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 8);

		WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 9);

		WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 10);

		WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 11);

		WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 12);
	}

	test ViewRecentEmployeeExperienceBlogEntryIndex {
		WWWHomepage.gotoRelativeURL(url = "blog");

		WWWHomepage.acceptAllCookies();

		WWWBlogs.clickBlogCategoryLink(blogCategory = "Employee Experience");

		WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 1);

		WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 2);

		WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 3);

		WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 4);

		WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 5);

		WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 6);

		WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 7);

		WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 8);

		WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 9);

		WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 10);

		WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 11);

		WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 12);
	}

	test ViewRecentLiferayExperienceBlogEntryIndex {
		WWWHomepage.gotoRelativeURL(url = "blog");

		WWWHomepage.acceptAllCookies();

		WWWBlogs.clickBlogCategoryLink(blogCategory = "Liferay Experience");

		WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 1);

		WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 2);

		WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 3);

		WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 4);

		WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 5);

		WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 6);

		WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 7);

		WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 8);

		WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 9);

		WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 10);

		WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 11);

		WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 12);
	}

	test ViewRecentTodaysExperiencesBlogEntryIndex {
		WWWHomepage.gotoRelativeURL(url = "blog");

		WWWHomepage.acceptAllCookies();

		WWWBlogs.clickBlogCategoryLink(blogCategory = "Customer Experience");

		WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 1);

		WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 2);

		WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 3);

		WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 4);

		WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 5);

		WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 6);

		WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 7);

		WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 8);

		WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 9);

		WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 10);

		WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 11);

		WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 12);
	}

}