definition {

	property testray.main.component.name = "Support QA";

	test ViewBlogEntriesViaBlogLinks {
		LocalFile.WWWHomepage.gotoRelativeURL(url = "blog");

		LocalFile.WWWHomepage.acceptAllCookies();

		LocalFile.WWWBlogs.clickBlogEntryLinkByPosition(positionValue = 1);

		LocalFile.WWWBlogs.viewBlogEntryContent();

		LocalFile.WWWHomepage.gotoRelativeURL(url = "blog");

		LocalFile.WWWBlogs.clickBlogEntryLinkByPosition(positionValue = 3);

		LocalFile.WWWBlogs.viewBlogEntryContent();

		LocalFile.WWWHomepage.gotoRelativeURL(url = "blog");

		LocalFile.WWWBlogs.clickBlogEntryLinkByPosition(positionValue = 5);

		LocalFile.WWWBlogs.viewBlogEntryContent();

		LocalFile.WWWHomepage.gotoRelativeURL(url = "blog");

		LocalFile.WWWBlogs.clickBlogEntryLinkByPosition(positionValue = 7);

		LocalFile.WWWBlogs.viewBlogEntryContent();

		LocalFile.WWWHomepage.gotoRelativeURL(url = "blog");

		LocalFile.WWWBlogs.clickBlogEntryLinkByPosition(positionValue = 9);

		LocalFile.WWWBlogs.viewBlogEntryContent();
	}

	test ViewBlogEntriesViaCustomerExperienceFeaturedLinks {
		LocalFile.WWWHomepage.gotoRelativeURL(url = "blog");

		LocalFile.WWWHomepage.acceptAllCookies();

		LocalFile.WWWBlogs.clickFeaturedBlogLink(
			blogCategory = "Customer Experience",
			positionValue = 1);

		LocalFile.WWWBlogs.viewBlogEntryContent();

		LocalFile.WWWHomepage.gotoRelativeURL(url = "blog");

		LocalFile.WWWBlogs.clickFeaturedBlogLink(
			blogCategory = "Customer Experience",
			positionValue = 2);

		LocalFile.WWWBlogs.viewBlogEntryContent();

		LocalFile.WWWHomepage.gotoRelativeURL(url = "blog");

		LocalFile.WWWBlogs.clickFeaturedBlogLink(
			blogCategory = "Customer Experience",
			positionValue = 3);

		LocalFile.WWWBlogs.viewBlogEntryContent();
	}

	test ViewBlogEntriesViaLiferayExperienceFeaturedLinks {
		LocalFile.WWWHomepage.gotoRelativeURL(url = "blog");

		LocalFile.WWWHomepage.acceptAllCookies();

		LocalFile.WWWBlogs.clickFeaturedBlogLink(
			blogCategory = "Customer Experience",
			positionValue = 1);

		LocalFile.WWWBlogs.viewBlogEntryContent();

		LocalFile.WWWHomepage.gotoRelativeURL(url = "blog");

		LocalFile.WWWBlogs.clickFeaturedBlogLink(
			blogCategory = "Customer Experience",
			positionValue = 2);

		LocalFile.WWWBlogs.viewBlogEntryContent();
	}

	test ViewBlogEntriesViaTodaysExperiencesFeaturedLinks {
		LocalFile.WWWHomepage.gotoRelativeURL(url = "blog");

		LocalFile.WWWHomepage.acceptAllCookies();

		LocalFile.WWWBlogs.clickFeaturedBlogLink(
			blogCategory = "Customer Experience",
			positionValue = 1);

		LocalFile.WWWBlogs.viewBlogEntryContent();

		LocalFile.WWWHomepage.gotoRelativeURL(url = "blog");
	}

	test ViewRecentBlogEntryIndex {
		LocalFile.WWWHomepage.gotoRelativeURL(url = "blog");

		LocalFile.WWWHomepage.acceptAllCookies();

		LocalFile.WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 1);

		LocalFile.WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 2);

		LocalFile.WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 3);

		LocalFile.WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 4);

		LocalFile.WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 5);

		LocalFile.WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 6);
	}

	test ViewRecentBusinessPartnerExperienceBlogEntryIndex {
		LocalFile.WWWHomepage.gotoRelativeURL(url = "blog");

		LocalFile.WWWHomepage.acceptAllCookies();

		LocalFile.WWWBlogs.clickBlogCategoryLink(blogCategory = "Business Partner Experience");

		LocalFile.WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 1);

		LocalFile.WWWBlogs.viewBlogEntryIndexByPosition(positionValue = 2);
	}

	test ViewRecentCustomerExperienceBlogEntryIndex {
		LocalFile.WWWHomepage.gotoRelativeURL(url = "blog");

		LocalFile.WWWHomepage.acceptAllCookies();

		LocalFile.WWWBlogs.clickBlogCategoryLink(blogCategory = "Customer Experience");

