definition {

	property testray.main.component.name = "Support QA";

	test DevelopersHomepageNavigation {
		LocalFile.WWWHomepage.gotoRelativeURL(url = "developers");

		LocalFile.WWWHomepage.viewNoErrors();

		LocalFile.WWWDevelopers.clickCardLink(cardName = "Community Site");

		LocalFile.WWWHomepage.viewNoErrors();

		LocalFile.WWWHomepage.viewNoURLContent(urlText = "www-uat.liferay.com");

		LocalFile.WWWHomepage.gotoRelativeURL(url = "developers");

		LocalFile.WWWDevelopers.clickCardLink(cardName = "Documentation");

		LocalFile.WWWHomepage.viewNoErrors();

		LocalFile.WWWHomepage.viewNoURLContent(urlText = "www-uat.liferay.com");

		LocalFile.WWWHomepage.gotoRelativeURL(url = "developers");

		LocalFile.WWWDevelopers.clickCardLink(cardName = "Community Downloads");

		LocalFile.WWWHomepage.viewNoErrors();

		LocalFile.WWWHomepage.viewURLContent(urlText = "www-uat.liferay.com");

		LocalFile.WWWHomepage.gotoRelativeURL(url = "developers");

		LocalFile.WWWDevelopers.clickCardLink(cardName = "Marketplace");

		LocalFile.WWWHomepage.viewNoErrors();

		LocalFile.WWWHomepage.viewNoURLContent(urlText = "www-uat.liferay.com");

		LocalFile.WWWHomepage.gotoRelativeURL(url = "developers");

		LocalFile.WWWDevelopers.clickCardLink(cardName = "Customer Portal");

		LocalFile.WWWHomepage.viewNoErrors();

		LocalFile.WWWHomepage.viewNoURLContent(urlText = "www-uat.liferay.com");
	}

	test ViewDeveloperspagehreflangtags {
		LocalFile.WWWHomepage.gotoRelativeURL(url = "developers");

		LocalFile.WWWHomepage.assertHreflangTag(
			hreflang = "zh-CN",
			relativeLanguageUrl = "zh/developers");

		LocalFile.WWWHomepage.assertHreflangTag(
			hreflang = "es-ES",
			relativeLanguageUrl = "es/developers");

		LocalFile.WWWHomepage.assertHreflangTag(
			hreflang = "fr-FR",
			relativeLanguageUrl = "fr/developers");

		LocalFile.WWWHomepage.assertHreflangTag(
			hreflang = "en-US",
			relativeLanguageUrl = "developers");

		LocalFile.WWWHomepage.assertHreflangTag(
			hreflang = "pt-BR",
			relativeLanguageUrl = "pt/developers");
	}

	test ViewOGTagsinDeveloperspage {
		LocalFile.WWWHomepage.gotoRelativeURL(url = "developers");

		LocalFile.WWWHomepage.assertPageOgTitleTag(pageOgTitleTag = "Liferay Developer Resources");

		LocalFile.WWWHomepage.assertPageOgDescriptionTag(pageOgDescriptionTag = "A collection of all the resources to develop with Liferay including the community, documentation, customer portal, downloads, and marketplace. Stay Nerdy");

		LocalFile.WWWHomepage.assertPageOgURLTag(pageOgUrlTag = "https://www-uat.liferay.com/developers");

		LocalFile.WWWHomepage.assertPageOgImageTag(pageOgImageTag = "https://www-uat.liferay.com/documents/10182/0/open_graph_image");
	}

}