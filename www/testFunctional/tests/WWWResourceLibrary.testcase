		WWWHomepage.pauseInMinutes(timeInMinutes = 1);

		Downloads.viewDownloadedFile(fileName = "Customer Experience Beyond Memos.pdf");

		WWWHomepage.viewURLContent(urlText = "resources/thank-you");
