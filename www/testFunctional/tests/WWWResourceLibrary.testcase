definition {

	property testray.main.component.name = "Support QA";

	test Downloade {
		WWWHomepage.gotoRelativeURL(url = "resources");

		WWWResourceLibrary.filterResources(table = '''| Resource Types | E-books |''');

		WWWResourceLibrary.clickResourceTypeWithTitle(resourceTitle = "5 Ways to Use Customer Engagement to Increase Profitability");

		WWWResourceLibrary.viewResourcesForm();

		WWWResourceLibrary.createResourceDownloadRequest(table = '''| Work Email                         | usr.resources1@lrcustomer.com.broken |
	| Country                            | United States                        |
	| State/Territory                    | California                           |
	| First Name                         | USR                                  |
	| Last Name                          | Resources1                           |
	| Company                            | Reusr                                |''');

		WWWHomepage.pauseInMinutes(timeInMinutes = 1);

		Downloads.viewDownloadedFile(fileName = "5 Ways Customer Engagement Increases Profitability.pdf");

		WWWHomepage.viewURLContent(urlText = "resources/thank-you");
	}

	test Downloadproductinforesourceviaresourcesform {
		WWWHomepage.gotoRelativeURL(url = "resources");

		WWWResourceLibrary.filterResources(table = '''| Resource Types | Product Info |''');

		WWWResourceLibrary.clickResourceTypeWithTitle(resourceTitle = "How Liferay DXP Helps Businesses Increase Profitability");

		WWWResourceLibrary.viewResourcesForm();

		WWWResourceLibrary.createResourceDownloadRequest(table = '''| Work Email                         | usr.resources1@lrcustomer.com.broken |
	| Country                            | United States                        |
	| State/Territory                    | California                           |
	| First Name                         | USR                                  |
	| Last Name                          | Resources1                           |
	| Company                            | Reusr                                |''');

		WWWHomepage.pauseInMinutes(timeInMinutes = 1);

		Downloads.viewDownloadedFile(fileName = "How Liferay DXP Helps Businesses Increase Profitability.pdf");

		WWWHomepage.viewURLContent(urlText = "resources/thank-you");
	}

	test Downloadresearchreportresourceviaresourcesform {
		WWWHomepage.gotoRelativeURL(url = "resources");

		WWWResourceLibrary.filterResources(table = '''| Resource Types | Research Reports |''');

		WWWResourceLibrary.clickResourceTypeWithTitle(resourceTitle = "Customer Experience Beyond Memos: A How-To Guide");

		WWWResourceLibrary.viewResourcesForm();

		WWWResourceLibrary.createResourceDownloadRequest(table = '''| Work Email                         | usr.resources1@lrcustomer.com.broken |
	| Country                            | United States                        |
