	test Downloadwhitepaperresourceviaresourcesform {
		WWWHomepage.gotoRelativeURL(url = "resources");

		WWWResourceLibrary.filterResources(table = '''| Resource Types | Whitepapers |''');

		WWWResourceLibrary.clickResourceTypeWithTitle(resourceTitle = "7 Essential Elements of a B2B Commerce Platform");

		WWWResourceLibrary.viewResourcesForm();

		WWWResourceLibrary.createResourceDownloadRequest(table = '''| Work Email                         | usr.resources1@lrcustomer.com.broken |
	| Country                            | United States                        |
	| State/Territory                    | California                           |
	| First Name                         | USR                                  |
	| Last Name                          | Resources1                           |
	| Company                            | Reusr                                |''');

		WWWHomepage.pauseInMinutes(timeInMinutes = 1);

		Downloads.viewDownloadedFile(fileName = "7 Essential Elements of a B2B Commerce Platform.pdf");

		WWWHomepage.viewURLContent(urlText = "resources/thank-you");
	}

	test FilterandSearchforResources {
		WWWHomepage.gotoRelativeURL(url = "resources");

		WWWResourceLibrary.filterResources(table = '''| Solutions      | Partner Portals |
	| Resource Types | E-books         |''');

		WWWResourceLibrary.searchResources(keyword = "Liferay DXP");

		WWWResourceLibrary.toggleResultsPerPage(resultsPerPage = 90);

		WWWResourceLibrary.viewResource(resourceTitle = "Five Ways Liferay DXP Enables Success for Insurance Providers");

		WWWResourceLibrary.viewNoResource(resourceTitle = "Conquering 6 Common Challenges With an Engaging Digital Agent Portal");

		WWWResourceLibrary.resetSearchButton();

		WWWResourceLibrary.searchResources(keyword = "Digital Agent Portal");

		WWWResourceLibrary.toggleResultsPerPage(resultsPerPage = 90);

		WWWResourceLibrary.viewResource(resourceTitle = "Conquering 6 Common Challenges With an Engaging Digital Agent Portal");

		WWWResourceLibrary.viewNoResource(resourceTitle = "Five Ways Liferay DXP Enables Success for Insurance Providers");

		WWWResourceLibrary.viewNoResource(resourceTitle = "Seven Popular Liferay Use Cases");

		WWWResourceLibrary.resetSearchButton();

		WWWResourceLibrary.searchResources(keyword = "Four types of Portals");

		WWWResourceLibrary.toggleResultsPerPage(resultsPerPage = 90);

		WWWResourceLibrary.viewResource(resourceTitle = "Four Types of Portals That Solve Enterprise Problems");

		WWWResourceLibrary.viewNoResource(resourceTitle = "Conquering 6 Common Challenges With an Engaging Digital Agent Portal");

		WWWResourceLibrary.viewNoResource(resourceTitle = "Five Ways Liferay DXP Enables Success for Insurance Providers");
	}

	test FilterResourcesByIndustries {
		WWWHomepage.gotoRelativeURL(url = "resources");

		WWWResourceLibrary.filterResources(table = '''| Industries | Manufacturing |''');

		WWWResourceLibrary.toggleResultsPerPage(resultsPerPage = 90);

		WWWResourceLibrary.viewResource(resourceTitle = "100,000 users united through a self-service portal, simplifying incident management");

		WWWResourceLibrary.viewResource(resourceTitle = "A Coordinated Commerce Strategy for B2B Companies");

		WWWResourceLibrary.clearAllResourceFilters();

		WWWResourceLibrary.filterResources(table = '''| Industries | Healthcare |''');

		WWWResourceLibrary.toggleResultsPerPage(resultsPerPage = 90);

		WWWResourceLibrary.viewResource(resourceTitle = "Transforming the Pharma and Life Sciences Industry");

		WWWResourceLibrary.viewResource(resourceTitle = "The Evolving Value of the Portal in Healthcare");

		WWWResourceLibrary.viewResource(resourceTitle = "Healthcare Insurer Delivers Streamlined Digital Experience for Customers and Employees");

		WWWResourceLibrary.viewNoResource(resourceTitle = "100,000 users united through a self-service portal, simplifying incident management");

		WWWResourceLibrary.viewNoResource(resourceTitle = "A Coordinated Commerce Strategy for B2B Companies");

		WWWResourceLibrary.clearAllResourceFilters();

		WWWResourceLibrary.filterResources(table = '''| Industries | Government |''');

		WWWResourceLibrary.toggleResultsPerPage(resultsPerPage = 90);

		WWWResourceLibrary.viewResource(resourceTitle = "Government: Department of the Citizen - Australia");

		WWWResourceLibrary.viewResource(resourceTitle = "A new intranet for the US Navy serves 40,000 users with exceptional performance and user satisfaction");

		WWWResourceLibrary.viewResource(resourceTitle = "Digital Transformation in the UK Public Sector");

		WWWResourceLibrary.viewResource(resourceTitle = "Council of Europe creates effective communication tool with Liferay Portal");

		WWWResourceLibrary.viewNoResource(resourceTitle = "Transforming the Pharma and Life Sciences Industry");

		WWWResourceLibrary.viewNoResource(resourceTitle = "The Evolving Value of the Portal in Healthcare");

		WWWResourceLibrary.viewNoResource(resourceTitle = "Healthcare Insurer Delivers Streamlined Digital Experience for Customers and Employees");

		WWWResourceLibrary.clearAllResourceFilters();

		WWWResourceLibrary.filterResources(table = '''| Industries | Not For Profit/NGO |''');

		WWWResourceLibrary.toggleResultsPerPage(resultsPerPage = 90);

		WWWResourceLibrary.viewResource(resourceTitle = "Public website gives access to new mobile audience with responsive design");

		WWWResourceLibrary.viewNoResource(resourceTitle = "Government: Department of the Citizen - Australia");

		WWWResourceLibrary.viewNoResource(resourceTitle = "A new intranet for the US Navy serves 40,000 users with exceptional performance and user satisfaction");

		WWWResourceLibrary.viewNoResource(resourceTitle = "Digital Transformation in the UK Public Sector");

		WWWResourceLibrary.viewNoResource(resourceTitle = "Council of Europe creates effective communication tool with Liferay Portal");
	}

	test FilterResourcesBySolution {
		WWWHomepage.gotoRelativeURL(url = "resources");

		WWWResourceLibrary.filterResources(table = '''| Solutions | Customer Portals |''');

		WWWResourceLibrary.toggleResultsPerPage(resultsPerPage = 90);

		WWWResourceLibrary.viewResource(resourceTitle = "The Evolving Value of a Portal");

		WWWResourceLibrary.viewResource(resourceTitle = "What is a Portal");

		WWWResourceLibrary.viewResource(resourceTitle = "Portal Best Practices");

		WWWResourceLibrary.clearAllResourceFilters();

		WWWResourceLibrary.filterResources(table = '''| Solutions | Intranets |''');

		WWWResourceLibrary.toggleResultsPerPage(resultsPerPage = 90);

		WWWResourceLibrary.viewResource(resourceTitle = "Building a Better, More Secure Collaborative Platform for Researchers");

		WWWResourceLibrary.clearAllResourceFilters();

		WWWResourceLibrary.filterResources(table = '''| Solutions | B2B Commerce |''');

		WWWResourceLibrary.toggleResultsPerPage(resultsPerPage = 90);

		WWWResourceLibrary.viewResource(resourceTitle = "7 Best Practices for B2B Ecommerce Success");

		WWWResourceLibrary.viewResource(resourceTitle = "How to Use Your E-Commerce Site to Empower Your Sales Team");

		WWWResourceLibrary.viewResource(resourceTitle = "B2B E-Commerce RFP Kit");

		WWWResourceLibrary.viewResource(resourceTitle = "B2BecNews Report - Choosing the Right E-Commerce Platform");

		WWWResourceLibrary.viewNoResource(resourceTitle = "Building a Better, More Secure Collaborative Platform for Researchers");

		WWWResourceLibrary.clearAllResourceFilters();

		WWWResourceLibrary.filterResources(table = '''| Solutions | Websites |''');

		WWWResourceLibrary.toggleResultsPerPage(resultsPerPage = 90);

		WWWResourceLibrary.viewResource(resourceTitle = "Public website gives access to new mobile audience with responsive design");

		WWWResourceLibrary.viewNoResource(resourceTitle = "7 Best Practices for B2B Ecommerce Success");

		WWWResourceLibrary.viewNoResource(resourceTitle = "How to Use Your E-Commerce Site to Empower Your Sales Team");

		WWWResourceLibrary.viewNoResource(resourceTitle = "B2B E-Commerce RFP Kit");

		WWWResourceLibrary.viewNoResource(resourceTitle = "B2BecNews Report - Choosing the Right E-Commerce Platform");
	}

	test FilterResourcesByType {
		WWWHomepage.gotoRelativeURL(url = "resources");

		WWWResourceLibrary.filterResources(table = '''| Resource Types | Whitepapers |''');

		WWWResourceLibrary.toggleResultsPerPage(resultsPerPage = 90);

		WWWResourceLibrary.viewResourceType(resourceType = "Whitepaper");

		WWWResourceLibrary.viewNoResourceType(resourceType = "Case Studies");

		WWWResourceLibrary.viewNoResourceType(resourceType = "E-books");

		WWWResourceLibrary.viewNoResourceType(resourceType = "Research Reports");

		WWWResourceLibrary.clearAllResourceFilters();

		WWWResourceLibrary.filterResources(table = '''| Resource Types | Case Studies |''');

		WWWResourceLibrary.toggleResultsPerPage(resultsPerPage = 90);

		WWWResourceLibrary.viewResourceType(resourceType = "Case Studies");

		WWWResourceLibrary.viewNoResourceType(resourceType = "Whitepaper");

		WWWResourceLibrary.viewNoResourceType(resourceType = "E-books");

		WWWResourceLibrary.viewNoResourceType(resourceType = "Product Info");

		WWWResourceLibrary.viewNoResourceType(resourceType = "Research Reports");

		WWWResourceLibrary.clearAllResourceFilters();

		WWWResourceLibrary.filterResources(table = '''| Resource Types | E-books |''');

		WWWResourceLibrary.toggleResultsPerPage(resultsPerPage = 90);

		WWWResourceLibrary.viewResourceType(resourceType = "E-books");

		WWWResourceLibrary.viewNoResourceType(resourceType = "Case Studies");

		WWWResourceLibrary.viewNoResourceType(resourceType = "Whitepaper");

		WWWResourceLibrary.viewNoResourceType(resourceType = "Product Info");

		WWWResourceLibrary.viewNoResourceType(resourceType = "Research Reports");

		WWWResourceLibrary.clearAllResourceFilters();

		WWWResourceLibrary.filterResources(table = '''| Resource Types | Product Info |''');

		WWWResourceLibrary.toggleResultsPerPage(resultsPerPage = 90);

		WWWResourceLibrary.viewResourceType(resourceType = "Product Info");

		WWWResourceLibrary.viewNoResourceType(resourceType = "E-books");

		WWWResourceLibrary.viewNoResourceType(resourceType = "Case Studies");

		WWWResourceLibrary.viewNoResourceType(resourceType = "Research Reports");

		WWWResourceLibrary.clearAllResourceFilters();

		WWWResourceLibrary.filterResources(table = '''| Resource Types | Research Reports |''');

		WWWResourceLibrary.toggleResultsPerPage(resultsPerPage = 90);

		WWWResourceLibrary.viewResourceType(resourceType = "Research Reports");

		WWWResourceLibrary.viewNoResourceType(resourceType = "Product Info");

		WWWResourceLibrary.viewNoResourceType(resourceType = "E-books");

		WWWResourceLibrary.viewNoResourceType(resourceType = "Case Studies");

		WWWResourceLibrary.viewNoResourceType(resourceType = "Whitepaper");

		WWWResourceLibrary.clearAllResourceFilters();

		WWWResourceLibrary.filterResources(table = '''| Resource Types | Whitepapers |''');

		WWWResourceLibrary.toggleResultsPerPage(resultsPerPage = 90);

		WWWResourceLibrary.viewResourceType(resourceType = "Whitepaper");

		WWWResourceLibrary.viewNoResourceType(resourceType = "Case Studies");

		WWWResourceLibrary.viewNoResourceType(resourceType = "E-books");

		WWWResourceLibrary.viewNoResourceType(resourceType = "Research Reports");
	}

	test FilterResourcesUsingMultipleCriteria {
		WWWHomepage.gotoRelativeURL(url = "resources");

		WWWResourceLibrary.filterResources(table = '''| Solutions      | Websites      |
	| Industries     | Government    |
	| Resource Types | Case Studies  |''');

		WWWResourceLibrary.toggleResultsPerPage(resultsPerPage = 90);

		WWWResourceLibrary.viewResource(resourceTitle = "New platform skyrockets search usage");

		WWWResourceLibrary.clearAllResourceFilters();

		WWWResourceLibrary.filterResources(table = '''| Solutions      | Customer Portals |
	| Industries     | Manufacturing    |
	| Resource Types | Case Studies     |''');

		WWWResourceLibrary.toggleResultsPerPage(resultsPerPage = 90);

		WWWResourceLibrary.viewResource(resourceTitle = "Agricultural Equipment Manufacturer Doubles Site Visitors");

		WWWResourceLibrary.viewNoResource(resourceTitle = "New platform skyrockets search usage");

		WWWResourceLibrary.clearAllResourceFilters();

		WWWResourceLibrary.filterResources(table = '''| Solutions      | B2B Commerce     |
	| Industries     | Manufacturing    |
	| Resource Types | Research Reports |''');

		WWWResourceLibrary.toggleResultsPerPage(resultsPerPage = 90);

		WWWResourceLibrary.viewResource(resourceTitle = "Why Customer Centricity is Essential to Manufacturers");

		WWWResourceLibrary.viewNoResource(resourceTitle = "Agricultural Equipment Manufacturer Doubles Site Visitors");

		WWWResourceLibrary.clearAllResourceFilters();

		WWWResourceLibrary.filterResources(table = '''| Solutions      | Websites           |
	| Industries     | Financial Services |
	| Resource Types | Case Studies       |''');

		WWWResourceLibrary.toggleResultsPerPage(resultsPerPage = 90);

		WWWResourceLibrary.viewResource(resourceTitle = "Leading Financial Services Company Publishes Content and Code Faster with Liferay");

		WWWResourceLibrary.viewResource(resourceTitle = "Integrated portal platform at center of Britam");

		WWWResourceLibrary.viewNoResource(resourceTitle = "Why Customer Centricity is Essential to Manufacturers");
	}

	test SearchResourcesByKeyword {
		WWWHomepage.gotoRelativeURL(url = "resources");

		WWWResourceLibrary.searchResources(keyword = "Portal");

		WWWResourceLibrary.toggleResultsPerPage(resultsPerPage = 90);

		WWWResourceLibrary.viewResource(resourceTitle = "The Evolving Value of a Portal");

		WWWResourceLibrary.viewResource(resourceTitle = "What is a Portal");

		WWWResourceLibrary.viewResource(resourceTitle = "Portal Best Practices");

		WWWResourceLibrary.resetSearchButton();

		WWWResourceLibrary.searchResources(keyword = "Digital Transformation");

		WWWResourceLibrary.toggleResultsPerPage(resultsPerPage = 90);

		WWWResourceLibrary.viewResource(resourceTitle = "Jumpstart Your Digital Transformation With a Digital Experience Platform");

		WWWResourceLibrary.viewResource(resourceTitle = "Building Trust in Government Through Digital Transformation");

		WWWResourceLibrary.viewNoResource(resourceTitle = "What is a Portal");

		WWWResourceLibrary.viewNoResource(resourceTitle = "Portal Best Practices");

		WWWResourceLibrary.resetSearchButton();

		WWWResourceLibrary.searchResources(keyword = "E-Commerce");

		WWWResourceLibrary.toggleResultsPerPage(resultsPerPage = 90);

		WWWResourceLibrary.viewResource(resourceTitle = "7 Best Practices for B2B Ecommerce Success");

		WWWResourceLibrary.viewResource(resourceTitle = "How to Use Your E-Commerce Site to Empower Your Sales Team");

		WWWResourceLibrary.viewResource(resourceTitle = "B2B E-Commerce RFP Kit");

		WWWResourceLibrary.viewResource(resourceTitle = "B2BecNews Report - Choosing the Right E-Commerce Platform");

		WWWResourceLibrary.viewNoResource(resourceTitle = "Jumpstart Your Digital Transformation With a Digital Experience Platform");

		WWWResourceLibrary.resetSearchButton();

		WWWResourceLibrary.searchResources(keyword = "Customer Experience");

		WWWResourceLibrary.toggleResultsPerPage(resultsPerPage = 90);

		WWWResourceLibrary.viewResource(resourceTitle = "Leveraging AI to Improve the B2B Customer Experience");

		WWWResourceLibrary.viewResource(resourceTitle = "Four Strategies to Transform Your Customer Experience");

		WWWResourceLibrary.viewResource(resourceTitle = "Liferay DXP Business Overview");

		WWWResourceLibrary.viewResource(resourceTitle = "Three Key Strategies for Consistent Customer Experiences");

		WWWResourceLibrary.viewNoResource(resourceTitle = "7 Best Practices for B2B Ecommerce Success");

		WWWResourceLibrary.viewNoResource(resourceTitle = "How to Use Your E-Commerce Site to Empower Your Sales Team");
	}

}