definition {

	property testray.main.component.name = "Support QA";

	test CustomersHomepageNavigation {
		WWWHomepage.gotoRelativeURL(url = "customers");

		WWWHomepage.viewNoErrors();

		WWWCustomers.clickCardLink(cardName = "Customer Portal");

		WWWHomepage.viewNoErrors();

		WWWHomepage.viewNoURLContent(urlText = "www-uat.liferay.com");

		WWWHomepage.gotoRelativeURL(url = "customers");

		WWWCustomers.clickCardLink(cardName = "Customer Onboarding Journey");

		WWWHomepage.viewNoErrors();

		WWWHomepage.viewNoURLContent(urlText = "www-uat.liferay.com");

		WWWHomepage.gotoRelativeURL(url = "customers");

		WWWCustomers.clickCardLink(cardName = "Documentation");

		WWWHomepage.viewNoErrors();

		WWWHomepage.viewNoURLContent(urlText = "www-uat.liferay.com");

		WWWHomepage.gotoRelativeURL(url = "customers");

		WWWCustomers.clickCardLink(cardName = "Learning");

		WWWHomepage.viewNoErrors();

		WWWHomepage.viewNoURLContent(urlText = "www-uat.liferay.com");

		WWWHomepage.gotoRelativeURL(url = "customers");

		WWWCustomers.clickCardLink(cardName = "Partner Directory");

		WWWHomepage.viewNoErrors();

		WWWHomepage.viewNoURLContent(urlText = "www-uat.liferay.com");

		WWWHomepage.gotoRelativeURL(url = "customers");

		WWWCustomers.clickCardLink(cardName = "Marketplace");

		WWWHomepage.viewNoErrors();

		WWWHomepage.viewNoURLContent(urlText = "www-uat.liferay.com");
	}

	test ViewCustomerspagehreflangtags {
		WWWHomepage.gotoRelativeURL(url = "customers");

		WWWHomepage.assertHreflangTag(
			hreflang = "zh-CN",
			relativeLanguageUrl = "zh/customers");

		WWWHomepage.assertHreflangTag(
			hreflang = "es-ES",
			relativeLanguageUrl = "es/customers");

		WWWHomepage.assertHreflangTag(
			hreflang = "it-IT",
			relativeLanguageUrl = "it/customers");

		WWWHomepage.assertHreflangTag(
			hreflang = "fr-FR",
			relativeLanguageUrl = "fr/customers");

		WWWHomepage.assertHreflangTag(
			hreflang = "en-US",
			relativeLanguageUrl = "customers");

		WWWHomepage.assertHreflangTag(
			hreflang = "pt-BR",
			relativeLanguageUrl = "pt/customers");

		WWWHomepage.assertHreflangTag(
			hreflang = "de-DE",
			relativeLanguageUrl = "de/customers");
	}

	test ViewOGTagsinCustomerspage {
		WWWHomepage.gotoRelativeURL(url = "customers");

		WWWHomepage.assertPageOgTitleTag(pageOgTitleTag = "Liferay Customer Resources");

		WWWHomepage.assertPageOgDescriptionTag(pageOgDescriptionTag = "A collection of all the resources to be successful with Liferay including documentation, onboarding, customer portal, partner directory, education, and marketplace");

		WWWHomepage.assertPageOgURLTag(pageOgUrlTag = "https://www-uat.liferay.com/customers");

		WWWHomepage.assertPageOgImageTag(pageOgImageTag = "https://www-uat.liferay.com/documents/10182/0/open_graph_image");
	}

}