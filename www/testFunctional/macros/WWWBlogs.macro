definition {

	var wwwAdminEmailAddress = PropsUtil.get("www.admin.email.address");
	var wwwAdminPassword = PropsUtil.get("www.admin.password");
	var wwwURL = PropsUtil.get("www.liferay.url");

	macro clickBlogCategoryLink {
		var currentUrl = WWWHomepage.getURL();
		var key_blogCategory = ${blogCategory};

		ScrollWebElementIntoView(locator1 = "WWWBlogs#BLOG_CATEGORY_LINK");

		Click.pauseMakeVisibleClickAt(locator1 = "WWWBlogs#BLOG_CATEGORY_LINK");

		WaitForSPARefresh();

		var newUrl = WWWHomepage.getURL();

		while ((${newUrl} == ${currentUrl})) {
			Click.pauseMakeVisibleClickAt(locator1 = "WWWBlogs#BLOG_CATEGORY_LINK");

			WaitForSPARefresh();

			var newUrl = WWWHomepage.getURL();
		}
	}

	macro clickBlogEntryLink {
		var key_blogsEntryTitle = ${blogsEntryTitle};

		Click.pauseMakeVisibleClickAt(locator1 = "WWWBlogs#BLOG_ENTRY_LINK");
	}

	macro clickBlogEntryLinkByPosition {
		var currentUrl = WWWHomepage.getURL();
		var key_positionValue = ${positionValue};

		ScrollWebElementIntoView(locator1 = "WWWBlogs#BLOG_ENTRY_LINK_BY_POSITION");

		Click.pauseMakeVisibleClickAt(locator1 = "WWWBlogs#BLOG_ENTRY_LINK_BY_POSITION");

		WaitForSPARefresh();

		var newUrl = WWWHomepage.getURL();

		while ((${newUrl} == ${currentUrl})) {
			Click.pauseMakeVisibleClickAt(locator1 = "WWWBlogs#BLOG_ENTRY_LINK_BY_POSITION");

			WaitForSPARefresh();

			var newUrl = WWWHomepage.getURL();
		}
	}

	macro clickFeaturedBlogLink {
		var currentUrl = WWWHomepage.getURL();
		var key_blogCategory = ${blogCategory};
		var key_positionValue = ${positionValue};

		ScrollWebElementIntoView(locator1 = "WWWBlogs#FEATURED_BLOG_CATEGORY_LINK");

		Click.pauseMakeVisibleClickAt(locator1 = "WWWBlogs#FEATURED_BLOG_CATEGORY_LINK");

		WaitForSPARefresh();

		var newUrl = WWWHomepage.getURL();

		while ((${newUrl} == ${currentUrl})) {
			Click.pauseMakeVisibleClickAt(locator1 = "WWWBlogs#FEATURED_BLOG_CATEGORY_LINK");

			WaitForSPARefresh();

			var newUrl = WWWHomepage.getURL();
		}
	}

	macro clickReadPostButton {
		var currentUrl = WWWHomepage.getURL();

		ScrollWebElementIntoView(locator1 = "WWWBlogs#READ_POST_BUTTON");

		Click.pauseMakeVisibleClickAt(locator1 = "WWWBlogs#READ_POST_BUTTON");

		WaitForSPARefresh();

		var newUrl = WWWHomepage.getURL();

		while ((${newUrl} == ${currentUrl})) {
			Click.pauseMakeVisibleClickAt(locator1 = "WWWBlogs#READ_POST_BUTTON");

			WaitForSPARefresh();

			var newUrl = WWWHomepage.getURL();
		}
	}

	macro clickViewMoreButton {
		var currentUrl = WWWHomepage.getURL();

		ScrollWebElementIntoView(locator1 = "WWWBlogs#VIEW_MORE_BUTTON");

		Click.pauseMakeVisibleClickAt(locator1 = "WWWBlogs#VIEW_MORE_BUTTON");

		WaitForSPARefresh();

		var newUrl = WWWHomepage.getURL();

		while ((${newUrl} == ${currentUrl})) {
			Click.pauseMakeVisibleClickAt(locator1 = "WWWBlogs#VIEW_MORE_BUTTON");

			WaitForSPARefresh();

			var newUrl = WWWHomepage.getURL();
		}
	}

	macro searchBlogEntries {
		var currentUrl = WWWHomepage.getURL();

		ScrollWebElementIntoView(locator1 = "WWWBlogs#SEARCH_FIELD");

		Type(
			locator1 = "WWWBlogs#SEARCH_FIELD",
			value1 = ${keyword});

		KeyPress(
			locator1 = "WWWBlogs#SEARCH_FIELD",
			value1 = "\RETURN");

		WaitForSPARefresh();

		var newUrl = WWWHomepage.getURL();

		while ((${newUrl} == ${currentUrl})) {
			Type(
				locator1 = "WWWBlogs#SEARCH_FIELD",
				value1 = ${keyword});

			KeyPress(
				locator1 = "WWWBlogs#SEARCH_FIELD",
				value1 = "\RETURN");

			WaitForSPARefresh();

			var newUrl = WWWHomepage.getURL();
		}
	}

	macro selectLocale {
		var currentUrl = WWWHomepage.getURL();

		ScrollWebElementIntoView(locator1 = "WWWBlogs#SWITCH_LOCALES_SELECT");

		Select.pauseSelect(
			locator1 = "WWWBlogs#SWITCH_LOCALES_SELECT",
			value1 = ${locale});

		WaitForSPARefresh();

		var newUrl = WWWHomepage.getURL();

		while ((${newUrl} == ${currentUrl})) {
			Select.pauseSelect(
				locator1 = "WWWBlogs#SWITCH_LOCALES_SELECT",
				value1 = ${locale});

			WaitForSPARefresh();

			var newUrl = WWWHomepage.getURL();
		}
	}

	macro viewBlogEntryContent {
		AssertVisible(locator1 = "WWWBlogEntry#BLOG_ENTRY_CATEGORY");

		AssertVisible(locator1 = "WWWBlogEntry#BLOG_ENTRY_TITLE");

		if (IsElementPresent(locator1 = "WWWBlogEntry#BLOG_ENTRY_AUTHOR")) {
			AssertVisible(locator1 = "WWWBlogEntry#BLOG_ENTRY_AUTHOR");
		}

		AssertVisible(locator1 = "WWWBlogEntry#BLOG_ENTRY_CONTENT");

		AssertVisible(locator1 = "WWWBlogEntry#BLOG_ENTRY_DATE");
	}

	macro viewBlogEntryIndex {
		var key_blogsEntryTitle = ${blogsEntryTitle};

		ScrollWebElementIntoView(locator1 = "WWWBlogs#BLOG_ENTRY_LINK");

		AssertVisible(locator1 = "WWWBlogs#BLOG_ENTRY_LINK");

		AssertVisible(locator1 = "WWWBlogs#BLOG_ENTRY_IMAGE");

		AssertVisible(locator1 = "WWWBlogs#BLOG_ENTRY_CATEGORY");

		AssertVisible(locator1 = "WWWBlogs#BLOG_ENTRY_TITLE");

		AssertVisible(locator1 = "WWWBlogs#BLOG_ENTRY_DESCRIPTION");
	}

	macro viewBlogEntryIndexByPosition {
		var key_positionValue = ${positionValue};

		ScrollWebElementIntoView(locator1 = "WWWBlogs#BLOG_ENTRY_LINK_BY_POSITION");

		AssertVisible(locator1 = "WWWBlogs#BLOG_ENTRY_LINK_BY_POSITION");

		AssertVisible(locator1 = "WWWBlogs#BLOG_ENTRY_IMAGE_BY_POSITION");

		AssertVisible(locator1 = "WWWBlogs#BLOG_ENTRY_CATEGORY_BY_POSITION");

		AssertVisible(locator1 = "WWWBlogs#BLOG_ENTRY_TITLE_BY_POSITION");

		AssertVisible(locator1 = "WWWBlogs#BLOG_ENTRY_DESCRIPTION_BY_POSITION");
	}

	macro viewNoBlogEntryIndex {
		var key_blogsEntryTitle = ${blogsEntryTitle};

		AssertElementNotPresent(locator1 = "WWWBlogs#BLOG_ENTRY_LINK");

		AssertElementNotPresent(locator1 = "WWWBlogs#BLOG_ENTRY_IMAGE");

		AssertElementNotPresent(locator1 = "WWWBlogs#BLOG_ENTRY_CATEGORY");

		AssertElementNotPresent(locator1 = "WWWBlogs#BLOG_ENTRY_TITLE");

		AssertElementNotPresent(locator1 = "WWWBlogs#BLOG_ENTRY_DESCRIPTION");
	}

}