definition {

	var wwwAdminEmailAddress = PropsUtil.get("www.admin.email.address");
	var wwwAdminPassword = PropsUtil.get("www.admin.password");
	var wwwURL = PropsUtil.get("www.liferay.url");

	macro acceptAllCookies {
		if (IsElementPresent(locator1 = "WWWHomepage#ACCEPT_ALL_COOKIES_BUTTON")) {
			if (IsVisible(locator1 = "WWWHomepage#ACCEPT_ALL_COOKIES_BUTTON")) {
				Click(locator1 = "WWWHomepage#ACCEPT_ALL_COOKIES_BUTTON");
			}
		}
	}

	macro assertHreflangCanonicalTag {
		var key_href = "${wwwURL}/${relativeLanguageUrl}";

		if (${relativeLanguageUrl} == "") {
			var key_href = ${wwwURL};
		}

		AssertElementPresent(locator1 = "WWWHomepage#LANGUAGE_CANONICAL_URL");
	}

	macro assertHreflangTag {
		if (${relativeLanguageUrl} == "") {
			var key_href = ${wwwURL};
		}
		else {
			var key_href = "${wwwURL}/${relativeLanguageUrl}";
		}

		var key_hreflang = ${hreflang};

		AssertElementPresent(locator1 = "WWWHomepage#LANGUAGE_HREF");
	}

	macro assertPageMetaDescription {
		var key_pageMetaDescription = ${pageMetaDescription};

		AssertElementPresent(locator1 = "WWWHomepage#META_DESCRIPTION");
	}

	macro assertPageOgDescriptionTag {
		var key_pageOgDescriptionTag = ${pageOgDescriptionTag};

		AssertElementPresent(locator1 = "WWWHomepage#META_PROPERTY_OG_DESCRIPTION");
	}

	macro assertPageOgImageTag {
		var key_pageOgImageTag = ${pageOgImageTag};

		AssertElementPresent(locator1 = "WWWHomepage#META_PROPERTY_OG_IMAGE");
	}

	macro assertPageOgTitleTag {
		var key_pageOgTitleTag = ${pageOgTitleTag};

		AssertElementPresent(locator1 = "WWWHomepage#META_PROPERTY_OG_TITLE");
	}

	macro assertPageOgURLTag {
		var key_pageOgUrlTag = ${pageOgUrlTag};

		AssertElementPresent(locator1 = "WWWHomepage#META_PROPERTY_OG_URL");
	}

	macro assertPageTitle {
		var key_pageTitle = ${pageTitle};

		AssertElementPresent(locator1 = "WWWHomepage#TITLE");
	}

	macro changeLanguage {
		var currentUrl = selenium.getAttribute("//meta[@property='og:url'][1]@content");

		Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#DROPDOWN_SELECT_LANGUAGE_LINK");

		if (${language} == "Chinese") {
			Click(locator1 = "WWWHomepage#DROPDOWN_CHINESE_LANGUAGE_LINK");

			WaitForSPARefresh();

			var newUrl = selenium.getAttribute("//meta[@property='og:url'][1]@content");

			if (!(contains(${currentUrl}, "/zh"))) {
				while ((${newUrl} == ${currentUrl})) {
					Click(locator1 = "WWWHomepage#DROPDOWN_SELECT_LANGUAGE_LINK");

					Click(locator1 = "WWWHomepage#DROPDOWN_CHINESE_LANGUAGE_LINK");

					WaitForSPARefresh();

					var newUrl = selenium.getAttribute("//meta[@property='og:url'][1]@content");
				}
			}
		}
		else if (${language} == "Australian English") {
			Click(locator1 = "WWWHomepage#DROPDOWN_AUSTRALIA_ENGLISH_LANGUAGE_LINK");

			WaitForSPARefresh();

			var newUrl = selenium.getAttribute("//meta[@property='og:url'][1]@content");

			if (!(contains(${currentUrl}, "/en-AU"))) {
				while ((${newUrl} == ${currentUrl})) {
					Click(locator1 = "WWWHomepage#DROPDOWN_SELECT_LANGUAGE_LINK");

					Click(locator1 = "WWWHomepage#DROPDOWN_AUSTRALIA_ENGLISH_LANGUAGE_LINK");

					WaitForSPARefresh();

					var newUrl = selenium.getAttribute("//meta[@property='og:url'][1]@content");
				}
			}
		}
		else if (${language} == "American English") {
			Click(locator1 = "WWWHomepage#DROPDOWN_UNITED_STATES_ENGLISH_LANGUAGE_LINK");

			WaitForSPARefresh();

			var newUrl = selenium.getAttribute("//meta[@property='og:url'][1]@content");

			if (!(contains(${currentUrl}, "/en")) || contains(${currentUrl}, "/en-AU")) {
				while ((${newUrl} == ${currentUrl})) {
					Click(locator1 = "WWWHomepage#DROPDOWN_SELECT_LANGUAGE_LINK");

					Click(locator1 = "WWWHomepage#DROPDOWN_UNITED_STATES_ENGLISH_LANGUAGE_LINK");

					WaitForSPARefresh();

					var newUrl = selenium.getAttribute("//meta[@property='og:url'][1]@content");
				}
			}
		}
		else if (${language} == "French") {
			Click(locator1 = "WWWHomepage#DROPDOWN_FRENCH_LANGUAGE_LINK");

			WaitForSPARefresh();

			var newUrl = selenium.getAttribute("//meta[@property='og:url'][1]@content");

			if (!(contains(${currentUrl}, "/fr"))) {
				while ((${newUrl} == ${currentUrl})) {
					Click(locator1 = "WWWHomepage#DROPDOWN_SELECT_LANGUAGE_LINK");

					Click(locator1 = "WWWHomepage#DROPDOWN_FRENCH_LANGUAGE_LINK");

					WaitForSPARefresh();

					var newUrl = selenium.getAttribute("//meta[@property='og:url'][1]@content");
				}
			}
		}
		else if (${language} == "German") {
			Click(locator1 = "WWWHomepage#DROPDOWN_GERMAN_LANGUAGE_LINK");

			WaitForSPARefresh();

			var newUrl = selenium.getAttribute("//meta[@property='og:url'][1]@content");

			if (!(contains(${currentUrl}, "/de"))) {
				while ((${newUrl} == ${currentUrl})) {
					Click(locator1 = "WWWHomepage#DROPDOWN_SELECT_LANGUAGE_LINK");

					Click(locator1 = "WWWHomepage#DROPDOWN_GERMAN_LANGUAGE_LINK");

					WaitForSPARefresh();

					var newUrl = selenium.getAttribute("//meta[@property='og:url'][1]@content");
				}
			}
		}
		else if (${language} == "Italian") {
			Click(locator1 = "WWWHomepage#DROPDOWN_ITALIAN_LANGUAGE_LINK");

			WaitForSPARefresh();

			var newUrl = selenium.getAttribute("//meta[@property='og:url'][1]@content");

			if (!(contains(${currentUrl}, "/it"))) {
				while ((${newUrl} == ${currentUrl})) {
					Click(locator1 = "WWWHomepage#DROPDOWN_SELECT_LANGUAGE_LINK");

					Click(locator1 = "WWWHomepage#DROPDOWN_ITALIAN_LANGUAGE_LINK");

					WaitForSPARefresh();

					var newUrl = selenium.getAttribute("//meta[@property='og:url'][1]@content");
				}
			}
		}
		else if (${language} == "Portuguese") {
			Click(locator1 = "WWWHomepage#DROPDOWN_PORTUGUESE_LANGUAGE_LINK");

			WaitForSPARefresh();

			var newUrl = selenium.getAttribute("//meta[@property='og:url'][1]@content");

			if (!(contains(${currentUrl}, "/pt"))) {
				while ((${newUrl} == ${currentUrl})) {
					Click(locator1 = "WWWHomepage#DROPDOWN_SELECT_LANGUAGE_LINK");

					Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#DROPDOWN_PORTUGUESE_LANGUAGE_LINK");

					WaitForSPARefresh();

					var newUrl = selenium.getAttribute("//meta[@property='og:url'][1]@content");
				}
			}
		}
		else if (${language} == "Spanish") {
			Click(locator1 = "WWWHomepage#DROPDOWN_SPANISH_LANGUAGE_LINK");

			WaitForSPARefresh();

			var newUrl = selenium.getAttribute("//meta[@property='og:url'][1]@content");

			if (!(contains(${currentUrl}, "/es"))) {
				while ((${newUrl} == ${currentUrl})) {
					Click(locator1 = "WWWHomepage#DROPDOWN_SELECT_LANGUAGE_LINK");

					Click(locator1 = "WWWHomepage#DROPDOWN_SPANISH_LANGUAGE_LINK");

					WaitForSPARefresh();

					var newUrl = selenium.getAttribute("//meta[@property='og:url'][1]@content");
				}
			}
		}
		else if (${language} == "Japanese") {
			Click(locator1 = "WWWHomepage#DROPDOWN_JAPANESE_LANGUAGE_LINK");

			WaitForSPARefresh();

			var newUrl = selenium.getAttribute("//meta[@property='og:url'][1]@content");

			if (!(contains(${currentUrl}, "co.jp"))) {
				while ((${newUrl} == ${currentUrl})) {
					Click(locator1 = "WWWHomepage#DROPDOWN_SELECT_LANGUAGE_LINK");

					Click(locator1 = "WWWHomepage#DROPDOWN_JAPANESE_LANGUAGE_LINK");

					WaitForSPARefresh();

					var newUrl = selenium.getAttribute("//meta[@property='og:url'][1]@content");
				}
			}
		}
		else {
			fail("Invalid language ${language}. Please use one of the following languages or update the test if changes are necessary: Chinese, Australian English, American English, French, German, Italian, Japanese, Portuguese, Spanish");
		}
	}

	macro changeLanguageViaFooterDropdown {
		var currentUrl = WWWHomepage.getURL();
		var key_languageName = ${languageName};

		if (IsElementPresent(locator1 = "WWWHomepage#ERROR_MESSAGE_CLOSE_BUTTON")) {
			WWWHomepage.pause(timeInSeconds = 2);

			if (IsElementPresent(locator1 = "WWWHomepage#ERROR_MESSAGE_CLOSE_BUTTON")) {
				Click(locator1 = "WWWHomepage#ERROR_MESSAGE_CLOSE_BUTTON");
			}
		}

		ScrollBy(value1 = "0, 9999");

		Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#FOOTER_LANGUAGE_LINK");

		Click(locator1 = "WWWHomepage#FOOTER_SELECT_LANGUAGE_LINK");

		WaitForSPARefresh();

		var newUrl = WWWHomepage.getURL();

		while ((${newUrl} == ${currentUrl})) {
			Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#FOOTER_LANGUAGE_LINK");

			Click(locator1 = "WWWHomepage#FOOTER_SELECT_LANGUAGE_LINK");

			WaitForSPARefresh();

			var newUrl = WWWHomepage.getURL();
		}
	}

	macro clickCategoryButton {
		var currentUrl = WWWHomepage.getURL();

		WWWHomepage.mouseOverTab(tabName = ${tabName});

		var key_buttonName = ${buttonName};
		var key_categoryName = ${categoryName};

		Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#CATEGORY_BUTTON");

		WaitForSPARefresh();

