definition {

	var wwwAdminEmailAddress = PropsUtil.get("www.admin.email.address");
	var wwwAdminPassword = PropsUtil.get("www.admin.password");
	var wwwURL = PropsUtil.get("www.liferay.url");

	macro signIn {
		Type(
			locator1 = "WWWSignIn#EMAIL_ADDRESS_FIELD",
			value1 = ${emailAddress});

		Type(
			locator1 = "WWWSignIn#PASSWORD_FIELD",
			value1 = ${password});

		Click(locator1 = "WWWSignIn#SIGN_IN_BUTTON");
	}

	macro signOut {
		Open(locator1 = "${wwwURL}/c/portal/logout");
	}

	macro signOutAndSignIn {
		WWWSignIn.signOut();

		WWWHomepage.clickFooterSignInCreateAccountLink();

		WWWSignIn.signIn(
			emailAddress = ${emailAddress},
			password = ${password});
	}

}