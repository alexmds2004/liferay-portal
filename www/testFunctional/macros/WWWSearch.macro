definition {

	var wwwAdminEmailAddress = PropsUtil.get("www.admin.email.address");
	var wwwAdminPassword = PropsUtil.get("www.admin.password");
	var wwwURL = PropsUtil.get("www.liferay.url");

	macro clickNextLink {
		ScrollWebElementIntoView(locator1 = "WWWSearch#NEXT_LINK");

		Click.pauseMakeVisibleClickAt(locator1 = "WWWSearch#NEXT_LINK");
	}

	macro clickPreviousLink {
		ScrollWebElementIntoView(locator1 = "WWWSearch#PREVIOUS_LINK");

		Click.pauseMakeVisibleClickAt(locator1 = "WWWSearch#PREVIOUS_LINK");
	}

	macro typeKeywordAndSearch {
		Type(
			locator1 = "WWWSearch#SEARCH_FIELD",
			value1 = ${keyword});

		KeyPress(
			locator1 = "WWWSearch#SEARCH_FIELD",
			value1 = "\RETURN");
	}

	macro viewSearchResult {
		var key_pageTitle = ${pageTitle};

		AssertVisible(locator1 = "WWWSearch#SEARCH_RESULT_LINK");

		AssertVisible(locator1 = "WWWSearch#SEARCH_RESULT_URL");

		AssertVisible(locator1 = "WWWSearch#SEARCH_RESULT_DESCRIPTION");
	}

}