definition {

	var wwwCoJpURL = PropsUtil.get("www.liferay.co.jp.url");

	macro getURL {
		WaitForSPARefresh();

		if (IsElementPresent(locator1 = "//meta[@property='og:url'][1]")) {
			var url = selenium.getAttribute("//meta[@property='og:url'][1]@content");
		}
		else if (IsElementPresent(locator1 = "//link[@rel='canonical']")) {
			var url = selenium.getAttribute("//link[@rel='canonical']@href");
		}
		else {
			var url = selenium.getAttribute("//link[contains(@href,'http')][1]@href");
		}

		return ${url};
	}

	macro gotoRelativeURL {
		Open(locator1 = "${wwwCoJpURL}/${url}");

		WaitForSPARefresh();

		var currentUrl = WWWCoJp.getURL();

		if (${currentUrl} != "https://www-uat.liferay.com/${url}") {
			Open(locator1 = "${wwwCoJpURL}/${url}");

			WaitForSPARefresh();
		}
	}

    macro viewDropdownTabLinks {
		var key_positionValue = 1;
		var linksRemain = "true";

		if (IsElementPresent(locator1 = "WWWCoJp#DROPDOWN_LINK")) {
			var pageElementsFound = ${pageElementsFound} + 1;

			while ((${linksRemain} == "true") && (${key_positionValue} != 15)) {
				while (IsElementPresent(locator1 = "WWWCoJp#DROPDOWN_LINK")) {
					var dropdownTabLink = selenium.getAttribute("xpath=(//ul[contains(@class,'dropdown-menu')]/li/a[contains(@class,'dropdown-item')])@href");

					var curl = '''
						${dropdownTabLink} -I
					''';

					var httpResponseStatusCode = JSONCurlUtil.get(${curl});

					if (contains(${httpResponseStatusCode}, "HTTP/2 400") || contains(${httpResponseStatusCode}, "HTTP/2 404")) {
						echo("The ${dropdownTabLink} page is not working properly.");

						var key_positionValue = ${key_positionValue} + 1;
					}
					else {
						echo("The ${dropdownTabLink} page is working properly.");

						var key_positionValue = ${key_positionValue} + 1;
					}
				}
			}

			var linksRemain = "false";
		}
	}

	macro viewFooterNavigationLinks {
		var key_positionValue = 1;
		var linksRemain = "true";

		if (IsElementPresent(locator1 = "WWWCoJp#FOOTER_LINK")) {
			var pageElementsFound = ${pageElementsFound} + 1;

			while ((${linksRemain} == "true") && (${key_positionValue} != 15)) {
				while (IsElementPresent(locator1 = "WWWCoJp#FOOTER_LINK")) {
					var footerNavigationLink = selenium.getAttribute("xpath=(//div[contains(@class,'site-footer')]//li[contains(@class,'lfr-nav-item open')]/a)[${key_positionValue}]@href");

					var curl = '''
						${footerNavigationLink} -I
					''';

					var httpResponseStatusCode = JSONCurlUtil.get(${curl});

					if (contains(${httpResponseStatusCode}, "HTTP/2 400") || contains(${httpResponseStatusCode}, "HTTP/2 404")) {
						echo("The ${footerNavigationLink} page is not working properly.");

						var key_positionValue = ${key_positionValue} + 1;
					}
					else {
						echo("The ${footerNavigationLink} page is working properly.");

						var key_positionValue = ${key_positionValue} + 1;
					}
				}
			}

			var linksRemain = "false";
		}
	}

	macro viewNoErrors {
		if (IsElementPresent(locator1 = "WWWCoJp#ERROR_BLOCK")) {
			static var staticErrorCount = ${staticErrorCount} + 1;

			echo("An unexpected error has occurred.");
		}

		if (IsElementPresent(locator1 = "WWWCoJp#ERROR_MESSAGE_1")) {
			static var staticErrorCount = ${staticErrorCount} + 1;

			echo("An unexpected error has occurred.");
		}

		if (IsElementPresent(locator1 = "WWWCoJp#ERROR_MESSAGE_2")) {
			static var staticErrorCount = ${staticErrorCount} + 1;

			echo("An unexpected error has occurred.");
		}

		if (IsElementPresent(locator1 = "WWWCoJp#PAGE_DOES_NOT_EXIST_MESSAGE_1")) {
			static var staticErrorCount = ${staticErrorCount} + 1;

			echo("An unexpected error has occurred.");
		}

		if (IsElementPresent(locator1 = "WWWCoJp#PAGE_DOES_NOT_EXIST_MESSAGE_2")) {
			static var staticErrorCount = ${staticErrorCount} + 1;

			echo("An unexpected error has occurred.");
		}

		if (IsElementPresent(locator1 = "WWWCoJp#PAGE_NOT_FOUND_MESSAGE_1")) {
			static var staticErrorCount = ${staticErrorCount} + 1;

			echo("An unexpected error has occurred.");
		}

		if (IsElementPresent(locator1 = "WWWCoJp#PAGE_NOT_FOUND_MESSAGE_2")) {
			static var staticErrorCount = ${staticErrorCount} + 1;

			echo("An unexpected error has occurred.");
		}

		if (IsElementPresent(locator1 = "WWWCoJp#BAD_REQUEST_MESSAGE")) {
			static var staticErrorCount = ${staticErrorCount} + 1;

			echo("An unexpected error has occurred.");
		}
	}


    macro viewPage {
		static var pageElementsFound = 0;
		static var staticErrorCount = 0;

		WWWCoJp.gotoRelativeURL(url = ${url});

		if (${url} == "") {
			WWWCoJp.viewDropdownTabLinks(url = ${url});
		}

		WWWCoJp.viewPageLinks();

		if (${url} == "") {
			WWWCoJp.viewFooterNavigationLinks(url = ${url});
		}

		echo("Total page elements found: ${pageElementsFound}");

		if (${pageElementsFound} == 0) {
			fail("No page elements were found on the page with the relative url ${url}. This could mean that the page element paths need to be updated or it could indicate a problem with the site page. Please investigate.");
		}

        if (${staticErrorCount} != 0) {
			fail("A total of ${staticErrorCount} errors were found. Please investigate.");
		}
	}

	macro viewPageLinks {
		var key_positionValue = 1;
		var linksRemain = "true";

		if (IsElementPresent(locator1 = "WWWCoJp#PAGE_LINK")) {
			var pageElementsFound = ${pageElementsFound} + 1;

			while ((${linksRemain} == "true") && (maxIterations = "100")) {
				while ((IsElementPresent(locator1 = "WWWCoJp#PAGE_LINK")) && (maxIterations = "100")) {
					var pageLink = selenium.getAttribute("xpath=(//div[contains(@class,'layout-content')]//a)[${key_positionValue}]@href");

					var curl = '''
						${pageLink} -I
					''';

					var httpResponseStatusCode = JSONCurlUtil.get(${curl});

					if (contains(${httpResponseStatusCode}, "HTTP/2 400") || contains(${httpResponseStatusCode}, "HTTP/2 404")) {
						echo("The ${pageLink} page is not working properly.");

						var key_positionValue = ${key_positionValue} + 1;
					}
					else {
						echo("The ${pageLink} page is working properly.");

						var key_positionValue = ${key_positionValue} + 1;
					}
				}
			}

			var linksRemain = "false";
		}
	}

}