definition {

	@summary = "Add new event in calendar"
	macro addNewEventInCalendar {
		Default.WaitForVisible(locator1 = "Portal.Calendar#ADD_EVENT_BUTTON");

		Portal.CalendarNavigator.gotoAddEvent();
	}

	@summary = "Fill in the information and publish the event"
	macro fillInformationAndPublishTheEvent {
		Portal.CalendarEvent.editTitle(eventTitle = ${eventTitle});

		Portal.CalendarEvent.tag(tagText = "upcoming");

		Portal.CalendarEvent.publish();

		Portal.Alert.viewSuccessMessage();

		Portal.IFrame.closeFrame();
	}

	@summary = "Make sure the created event is visible on the home page in the 'Upcoming Events' section"
	macro makeSureEventVisibleUpcomingEventsSection {
		Default.WaitForVisible(locator1 = "UpcomingEvents#SECTION_UPCOMING_EVENTS");

		Default.AssertElementPresent(
			key_titleEventCard = ${titleEventCard},
			locator1 = "UpcomingEvents#TITLE_UPCOMING_EVENTS_CARD");
	}

}