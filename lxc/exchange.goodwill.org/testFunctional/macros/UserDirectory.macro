definition {

	@summary = "Checks custom field was created by checking its presence while seeing a user profile"
	macro assertUserCustomField {
		Default.WaitForVisible(locator1 = "Portal.ApplicationsMenu#TOGGLE");

		Portal.ApplicationsMenu.gotoPortlet(
			category = "Users",
			panel = "Control Panel",
			portlet = "Users and Organizations");

		Default.WaitForVisible(locator1 = "UserDirectory#USER_LIST_ITEM");

		Default.Click(locator1 = "UserDirectory#USER_LIST_ITEM");

		Default.WaitForElementPresent(
			key_createdFieldLabel = ${createdFieldLabel},
			locator1 = "UserDirectory#CUSTOM_FIELD_LABEL");

		Default.AssertElementPresent(
			key_createdFieldLabel = ${createdFieldLabel},
			locator1 = "UserDirectory#CUSTOM_FIELD_LABEL");
	}

	@summary = "Creates a user custom field via the applications menu control panel"
	macro createCustomField {
		Default.WaitForVisible(locator1 = "Portal.Button#PLUS");

		Default.Click(locator1 = "Portal.Button#PLUS");

		Default.Click(
			key_inputFieldType = ${inputFieldType},
			locator1 = "UserDirectory#CUSTOM_FIELD_TYPE");

		Default.Type(
			key_customFieldInfo = "name",
			locator1 = "UserDirectory#CUSTOM_FIELD_INFORMATION",
			value1 = ${customFieldName});

		Default.Type(
			key_customFieldInfo = "defaultValue",
			locator1 = "UserDirectory#CUSTOM_FIELD_INFORMATION",
			value1 = "Custom Field Value");

		Portal.Button.clickSave();
	}

}