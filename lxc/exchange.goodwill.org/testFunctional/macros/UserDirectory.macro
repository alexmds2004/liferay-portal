definition {

	@summary = "Assert that user cards are different after applying the filter"
	macro assertFilterIsApplied {
		Portal.TestUtils.assertNotEquals(
			actual = ${firstItem},
			expected = ${secondItem});
	}

	@summary = "Checks custom field was created by checking its presence while seeing a user profile"
	macro assertUserCustomField {
		Default.WaitForVisible(locator1 = "Portal.ApplicationsMenu#TOGGLE");

		Portal.ApplicationsMenu.gotoPortlet(
			category = "Users",
			panel = "Control Panel",
			portlet = "Users and Organizations");

		Default.WaitForVisible(locator1 = "UserDirectory#USER_LIST_ITEM");

		Default.Click(locator1 = "UserDirectory#USER_LIST_ITEM");

		Default.WaitForElementPresent(
			key_createdFieldLabel = ${createdFieldLabel},
			locator1 = "UserDirectory#CUSTOM_FIELD_LABEL");

		Default.AssertElementPresent(
			key_createdFieldLabel = ${createdFieldLabel},
			locator1 = "UserDirectory#CUSTOM_FIELD_LABEL");
	}

	@summary = "Creates a user custom field via the applications menu control panel"
	macro createCustomField {
		Default.WaitForVisible(locator1 = "Portal.Button#PLUS");

		Default.Click(locator1 = "Portal.Button#PLUS");

		Default.Click(
			key_inputFieldType = ${inputFieldType},
			locator1 = "UserDirectory#CUSTOM_FIELD_TYPE");

		Default.Type(
			key_customFieldInfo = "name",
			locator1 = "UserDirectory#CUSTOM_FIELD_INFORMATION",
			value1 = ${customFieldName});

		Default.Type(
			key_customFieldInfo = "defaultValue",
			locator1 = "UserDirectory#CUSTOM_FIELD_INFORMATION",
			value1 = "Custom Field Value");

		Portal.Button.clickSave();
	}

	@summary = "Navigates to the 'User' resource section"
	macro gotoCustomFieldResource {
		var key_resourceName = ${resourceName};

		Default.WaitForElementPresent(locator1 = "UserDirectory#USER_RESOURCE");

		Default.ScrollWebElementIntoView(locator1 = "UserDirectory#USER_RESOURCE");

		Default.Click(locator1 = "UserDirectory#USER_RESOURCE");
	}

	// LXC: Refactor: This macro is a workaround it is needed due to a checkbox input issue
	// LXC Refactor Ticket: LRQA-80650

	@summary = "Retrieve the amount of items allocated in a filter"
	macro getUsersNames {
		Default.WaitForVisible(locator1 = "UserDirectory#SEARCH_BAR");

		var UsersNames = "";

		for (var index : list "1,2,3") {
			var UserName = selenium.getText("UserDirectory#USER_CARD_TITLE");

			var UsersNames = StringUtil.concat(${UsersNames}, "${UserName} ");
		}

		return ${UsersNames};
	}

	@summary = "Select a filter from the directory section"
	macro selectFilter {
		Default.WaitForVisible(locator1 = "UserDirectory#SEARCH_BAR");

		Default.Click(locator1 = "UserDirectory#SEARCH_BAR");

		for (var count : list "1,2,3") {
			Default.KeyPress(
				locator1 = "UserDirectory#SEARCH_BAR",
				value1 = "\TAB");
		}

		Default.KeyPress(
			locator1 = "UserDirectory#FILTER_ITEM",
			value1 = "\SPACE");
	}

}