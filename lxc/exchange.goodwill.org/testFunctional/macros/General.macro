definition {

	@summary = "Navigates to any option from the applications menu"
	macro goToAppMenuPortlet {
		Default.WaitForVisible(locator1 = "Portal.ApplicationsMenu#TOGGLE");

		Portal.ApplicationsMenu.gotoPortlet(
			category = ${category},
			panel = ${panel},
			portlet = ${portlet});
	}

	@summary = "Navigates to any menu item from vertical menu bar"
	macro goToMenuItem {
		if (isSet(submenuItem)) {
			Default.MouseOver(
				key_menuItemName = ${menuItem},
				locator1 = "General#MENU_BAR_OPTION");

			Default.Click(
				key_submenuItemName = ${submenuItem},
				locator1 = "General#SUBMENU_BAR_OPTION");
		}
		else {
			Default.Click(
				key_menuItemName = ${menuItem},
				locator1 = "General#MENU_BAR_OPTION");
		}
	}

	@summary = "Goes to Calendar page"
	macro openCalendar {
		General.goToMenuItem(
			menuItem = "Calendar & Events",
			submenuItem = "Calendar");

		Default.WaitForVisible(locator1 = "Portal.Calendar#ADD_EVENT_BUTTON");
	}

}