definition {

	@summary = "Launching Login page"
	macro launchLoginPage {
		var portal = PropsUtil.get("portal.url");

		var loginPage = "${portal}/c/login";

		Default.Open(locator1 = ${loginPage});
	}

	@summary = "Launching MODL page"
	macro launchModlPage {
		var portal = PropsUtil.get("portal.url");

		Default.Open(locator1 = ${portal});
	}

	@summary = "Delete events that are no longer needed"
	macro tearDownEventsInCalendar {
		Utils.launchModlPage();

		General.openCalendar();

		Portal.CalendarEvent.deleteSpecific(eventTitle = ${eventTitle});
	}

}