definition {

	property test.env = "modl";
	property testray.main.component.name = "Goodwill";

	setUp {
		Utils.launchModlPage();

		Login.loginAsAdminUser();
	}

	tearDown {
		General.goToAppMenuPortlet(
			category = "Configuration",
			panel = "Control Panel",
			portlet = "Custom Fields");

		Portal.CustomFields.deleteCP(
			customFieldName = "Custom Field Name",
			resourceName = "User");
	}

	@description = "Automation ID: LRQA-80546 | Test Summary: Verify that results can be filtered by a custom facet that points to the expando field"
	@priority = 5
	test CanFilterByCustomFacet {
		task ("Given 'Directory' page is loaded") {
			General.goToMenuItem(menuItem = "Directory");
		}

		task ("When a filter is selected") {
			var beforeFilter = UserDirectory.getUsersNames();

			UserDirectory.selectFilter();
		}

		task ("Then new set of user cards is displayed") {
			var afterFilter = UserDirectory.getUsersNames();

			UserDirectory.assertFilterIsApplied(
				firstItem = ${beforeFilter},
				secondItem = ${afterFilter});
		}
	}

	@description = "Automation ID: LRQA-80544 | Test Summary: Verify that a custom field for Users can be created and populate with data"
	@priority = 5
	test CanPopulateUserCustomField {
		task ("Given the Custom Fields portlet is loaded") {
			General.goToAppMenuPortlet(
				category = "Configuration",
				panel = "Control Panel",
				portlet = "Custom Fields");
		}

		task ("When a custom field is created for the 'User' resource") {
			UserDirectory.gotoCustomFieldResource(resourceName = "User");

			UserDirectory.createCustomField(
				customFieldName = "Custom Field Name",
				inputFieldType = "Text Area");
		}

		task ("Then the created custom field should be present when adding a new user") {
			UserDirectory.assertUserCustomField(createdFieldLabel = "Custom Field Name");
		}
	}

}