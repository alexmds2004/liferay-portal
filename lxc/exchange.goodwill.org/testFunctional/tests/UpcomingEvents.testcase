definition {

	property test.env = "modl";
	property testray.main.component.name = "Goodwill";

	setUp {
		Utils.launchModlPage();

		Login.loginAsAdminUser();
	}

	tearDown {
		Utils.tearDownEventsInCalendar(eventTitle = "future test event");
	}

	@description = "Automation ID: LRQA-80537 | Test Summary: Verify that an upcoming event scheduled in the future is visible in home page"
	@priority = 5
	test ShowsUpcomingEventInHomePage {
		task ("Given the calendar page is loaded") {
			General.openCalendar();
		}

		task ("When I schedule an event in the future") {
			UpcomingEvents.addNewEventInCalendar();

			UpcomingEvents.fillInformationAndPublishTheEvent(eventTitle = "future test event");
		}

		task ("Then the event must be visible on the home page") {
			General.goToMenuItem(menuItem = "Home");

			UpcomingEvents.makeSureEventVisibleUpcomingEventsSection(titleEventCard = "future test event");
		}
	}

}