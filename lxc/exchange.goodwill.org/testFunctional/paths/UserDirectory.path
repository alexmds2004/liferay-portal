<html>
<head>
<title>UserDirectory</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">UserDirectory</td></tr>
</thead>

<tbody>
<tr>
	<td>CUSTOM_FIELD_LABEL</td>
	<td>//form[contains(@name,'UsersAdminPortlet')]//label[contains(normalize-space(),'${key_createdFieldLabel}')]</td>
	<td></td>
</tr>
<tr>
	<td>CUSTOM_FIELD_INFORMATION</td>
	<td>//label[contains(@for,'${key_customFieldInfo}')]//following-sibling::*[contains(@id,'${key_customFieldInfo}')]</td>
	<td></td>
</tr>
<tr>
	<td>CUSTOM_FIELD_LIST_ITEM</td>
	<td>xpath=(//table[contains(@class,'list')]//span[contains(normalize-space(),'${key_resourceName}')])[1]</td>
	<td></td>
</tr>
<tr>
	<td>CUSTOM_FIELD_TYPE</td>
	<td>//div[contains(@class,'form-content')]//label[contains(normalize-space(),'${key_inputFieldType}')]</td>
	<td></td>
</tr>
<tr>
	<td>FILTER_ITEM</td>
	<td>//div[contains(@class,'checkbox')]//input[contains(@class,'term')]</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_BAR</td>
	<td>//div[contains(@class,'search-bar')]//input[contains(@data-qa-id,'searchInput')]</td>
	<td></td>
</tr>
<tr>
	<td>USER_CARD_TITLE</td>
	<td>xpath=(//div[contains(@class,'user-card')]//*[contains(@class,'card-title')]//a)[${index}]</td>
	<td></td>
</tr>
<tr>
	<td>USER_LIST_ITEM</td>
	<td>xpath=(//div[contains(@id,'UsersAdminPortlet')]//tbody/tr[contains(@id,'users')]//a)[1]</td>
	<td></td>
</tr>
<tr>
	<td>USER_RESOURCE</td>
	<td>//td[contains(@class,'resource-column')]//span[contains(normalize-space(),'${key_resourceName}')]</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>