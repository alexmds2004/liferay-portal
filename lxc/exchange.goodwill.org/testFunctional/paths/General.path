<html>
<head>
<title>General</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">General</td></tr>
</thead>

<tbody>
<tr>
	<td>MENU_BAR_OPTION</td>
	<td>xpath=(//nav[contains(@class,'menubar') and contains(@class,'vertical')]//span[contains(text(),'${key_menuItemName}')]//ancestor::a[contains(@role,'menuitem')])[1]</td>
	<td></td>
</tr>
<tr>
	<td>SUBMENU_BAR_OPTION</td>
	<td>xpath=(//div[contains(@class,'nav-second-level')]//span[text()='${key_submenuItemName}'])[1]</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>