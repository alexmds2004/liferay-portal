definition {

	@summary = "Ensures that the home page is loaded"
	macro viewPageLoaded {
		Default.AssertVisible(locator1 = "Portal.ControlMenu#HEADING");

		Default.AssertVisible(locator1 = "HomePage#USER_BAR");

		Default.AssertLocation.assertPartialLocation(value1 = "home");
	}

	@summary = "Ensures that the top bar items are visible"
	macro viewTopBar {
		Default.AssertVisible(locator1 = "Portal.ControlMenu#HEADING");

		Default.AssertVisible(locator1 = "Portal.ControlMenu#EDIT_COG");

		Default.AssertVisible(locator1 = "Portal.ControlMenu#APPLICATIONS_MENU_ICON");

		Default.AssertVisible(locator1 = "Portal.ControlMenu#SIMULATION");
	}

}