definition {

	@summary = "Performs login process getting the password from an environment variable"
	macro signIn {
		var loginUserEmail = PropsUtil.get("test.this.yusen.test.account.dev.admin.login");
		var loginUserPassword = PropsUtil.getEnvironmentVariable("YUSEN_USER_PASSWORD");

		Utils.goToLogin();

		Default.Type(
			locator1 = "Portal.TextInput#EMAIL_ADDRESS",
			value1 = ${loginUserEmail});

		Default.Type(
			locator1 = "Portal.TextInput#PASSWORD",
			value1 = ${loginUserPassword});

		Portal.Button.click(button = "Sign In");

		Default.WaitForElementPresent(locator1 = "Portal.UserBar#USER_AVATAR_BUTTON");
	}

}