definition {

	@summary = "Launches login page from base URL"
	macro goToLogin {
		var baseURL = PropsUtil.get("test.this.yusen.portal.url.dev");

		Default.Open(locator1 = "${baseURL}/c/portal/login");
	}

	@summary = "Launches home page in DEV enronment"
	macro launchDevHomePage {
		var portalDev = PropsUtil.get("test.this.yusen.portal.url.dev");

		Default.Open(locator1 = "${portalDev}/home");

		Default.WaitForElementPresent(locator1 = "Portal.UserBar#USER_AVATAR_BUTTON");
	}

	@summary = "Launches yusen page in DEV enronment"
	macro launchDevPage {
		var portalDev = PropsUtil.get("test.this.yusen.portal.url.dev");

		Default.Open(locator1 = ${portalDev});
	}

}