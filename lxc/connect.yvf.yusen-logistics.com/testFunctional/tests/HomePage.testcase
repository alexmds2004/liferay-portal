definition {

	property test.env = "dev";
	property testray.main.component.name = "Yusen";

	setUp {
		Utils.launchDevPage();
	}

	@description = "Automation ID: LRQA-80329 | Test Summary: Verify that home page is properly loaded"
	@priority = 5
	test CanBeLoaded {
		task ("Given the user is logged in") {
			Login.signIn();
		}

		task ("When the home page URL is launched") {
			Utils.launchDevHomePage();
		}

		task ("Then the home page should be properly loaded") {
			HomePage.viewPageLoaded();
		}
	}

	@description = "Automation ID: LRQA-80329 | Test Summary: Verify user can log in"
	@priority = 5
	test CanLogIn {
		task ("When the user logs in to the website") {
			Login.signIn();
		}

		task ("Then the user avatar button should be visible") {
			General.viewUserAvatarButton();
		}
	}

}