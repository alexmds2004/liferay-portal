definition {

	@summary = "Perform login process"
	macro signIn {
		var loginUserName = PropsUtil.get("test.this.crosig.test.account.uat.user.login");
		var loginUserPassword = PropsUtil.get("test.this.crosig.test.account.uat.user.password");

		Default.WaitForElementPresent(locator1 = "Portal.TextInput#EMAIL_ADDRESS");

		Default.Type(
			locator1 = "Portal.TextInput#EMAIL_ADDRESS",
			value1 = ${loginUserName});

		Default.Type(
			locator1 = "Portal.TextInput#PASSWORD",
			value1 = ${loginUserPassword});

		Default.Click(locator1 = "Portal.Button#SUBMIT");

		Default.WaitForElementNotPresent(locator1 = "Portal.Button#SUBMIT");
	}

}