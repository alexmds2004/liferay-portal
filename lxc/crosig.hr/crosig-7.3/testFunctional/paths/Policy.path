<html>
<head>
<title>Policy</title>
</head>

<body>

<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">Policy</td></tr>
</thead>

<tbody>

<tr>
	<td>CHOOSE_VESSEL_BUTTON</td>
	<td>//table[contains(@class,'table-autofit')]//td/*[contains(text(),'${key_vesselName}')]/ancestor::tr//button</td>
	<td></td>
</tr>
<tr>
	<td>CONTACT_FILTER_CITY_DROPDOWN</td>
	<td>//div[contains(@class,'city-dropdown')]/select[contains(@id,'cityFilter')]</td>
	<td></td>
</tr>
<tr>
	<td>CONTACT_FILTER_CITY_DROPDOWN_ITEM</td>
	<td>xpath=(//div[contains(@class,'dropdown-menu')][contains(@class,'show')]//button)[${key_index}]</td>
	<td></td>
</tr>
<tr>
	<td>CONTACT_FILTER_TYPE_DROPDOWN</td>
	<td>//select[contains(@id,'TypeFilter') and contains(@class,'type-dropdown')]</td>
	<td></td>
</tr>
<tr>
	<td>CONTACT_FILTER_TYPE_DROPDOWN_ITEM</td>
	<td>xpath=(//select[contains(@id,'TypeFilter') and contains(@class,'type-dropdown')]/option)[${key_index}]</td>
	<td></td>
</tr>
<tr>
	<td>CONTACT_LOOKUP_TEXT_INPUT_FIELD</td>
	<td>//div[contains(@class,'searchField')]/div[contains(@class,'group-item')]/input[contains(@id,'lastNameInputText')]</td>
	<td></td>
</tr>
<tr>
	<td>CONTACT_LOOKUP_SEARCH_BUTTON</td>
	<td>//div[contains(@class,'searchFieldButton')]/*/button[contains(@class,'btn-primary')]</td>
	<td></td>
</tr>
<tr>
	<td>CONTACT_LOOKUP_ADD_ROLE_BUTTON</td>
	<td>//table[contains(@class,'table-autofit')]//td/*[contains(@class,'add-role')]</td>
	<td></td>
</tr>
<tr>
	<td>CONTACT_LOOKUP_SELECT_ROLE_BUTTON</td>
	<td>xpath=(//button[contains(@class,'dropdown-item') and contains(text(),'${key_role}')])[${key_index}]</td>
	<td></td>
</tr>
<tr>
	<td>CONTACT_LOOKUP_ADD_TO_POLICY_BUTTON</td>
	<td>//div[contains(@class,'dropdown')]/button[contains(@class,'dropdown-toggle')][contains(text(),'ADD')]</td>
	<td></td>
</tr>
<tr>
	<td>CONTACT_POLICY_TABLE</td>
	<td>xpath=(//table[contains(@class,'table-autofit')]//tr)[3]/td[contains(text(),'${key_addedContactName}')]</td>
	<td></td>
</tr>
<tr>
	<td>CONTACT_TABLE_ITEM</td>
	<td>xpath=(//table[contains(@class,'table-autofit')]/tbody//td)[${key_index}]/*[contains(text(),'${key_item}')]</td>
	<td></td>
</tr>
<tr>
	<td>CONTACT_TABLE_NAME</td>
	<td>xpath=(//table[contains(@class,'table-autofit')]/tbody//td)[${key_index}]/*</td>
	<td></td>
</tr>
<tr>
	<td>FORM_PAGE_HEADER</td>
	<td>//div[contains(@id,'modal-body')]//*[contains(text(),'${key_header}')]</td>
	<td></td>
</tr>
<tr>
	<td>FORM_PRIMARY_BUTTON_SELECT_BUTTON</td>
	<td>//div/*[contains(text(),'${key_text}')]/ancestor::div/following-sibling::button</td>
	<td></td>
</tr>
<tr>
	<td>LOOKUP_VESSEL_SEARCH_INPUT</td>
	<td>//div[contains(@id,'vesselLookupInputGroup')]//input[contains(@id,'vesselNib')]</td>
	<td></td>
</tr>
<tr>
	<td>LOOKUP_VESSEL_TABLE_ITEM</td>
	<td>xpath=(//table[contains(@class,'table-autofit')]/tbody//td)[${key_index}]</td>
	<td></td>
</tr>
<tr>
	<td>NEW_PROPOSAL_BUTTON</td>
	<td>//div[contains(@class,'site-title')]/following-sibling::div/button[contains(text(),'NEW PROPOSAL')]</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_FIELD</td>
	<td>//div[contains(@class,'searchField')]/div[contains(@class,'group-item')]/input[contains(@data-testid,'InputText')]</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_TABLE_RESULT</td>
	<td>//div[contains(@class,'desktop-only')]/*[contains(text(),'Contacts Found')]</td>
	<td></td>
</tr>
<tr>
	<td>USE_CONTACT_BUTTON</td>
	<td>//table[contains(@class,'table-autofit')]/tbody//div/button[contains(@class,'btn-primary')]</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>