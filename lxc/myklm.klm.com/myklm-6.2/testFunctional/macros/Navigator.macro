definition {

	@summary = "Navigate to the selected page, which is opened in a separated tab, via index"
	macro goToPage {
		Default.Click(
			key_index = ${openPageIndex},
			locator1 = "Navigator#PAGE_LINK_INDEX");

		Default.Click(
			key_index = ${openLinksPage},
			locator1 = "Navigator#PAGE_LINK_INDEX");
	}

}