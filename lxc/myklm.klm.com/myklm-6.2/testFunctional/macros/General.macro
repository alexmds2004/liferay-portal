definition {

	@summary = "Navigates to any menu and submenu item in the menu bar"
	macro goToMenuItem {
		if (isSet(submenuItem)) {
			Default.MouseOver(
				key_menuItemName = ${menuItem},
				locator1 = "General#MENU_BAR_OPTION");

			Default.Click(
				key_submenuItemName = ${submenuItem},
				locator1 = "General#SUBMENU_BAR_OPTION");
		}
		else {
			Default.Click(
				key_menuItemName = ${menuItem},
				locator1 = "General#MENU_BAR_OPTION");
		}
	}

	@summary = "Navigate between pages that open in different tabs I close the unnecessary tab"
	macro goToPages {
		Default.Click(
			key_index = ${openPageIndex},
			locator1 = "General#ACCESS_PAGES_INDEX");

		Default.Click(
			key_index = ${openLinksPage},
			locator1 = "General#ACCESS_PAGES_INDEX");

		Default.Close.closeWindow();
	}

