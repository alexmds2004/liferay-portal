definition {

	setUp {
		Utils.launchHomePage();

		Login.signIn();
	}

	@description = "Automation ID: KLMUA-172 | Test Summary: Verify that the useful links are redirecting to the right pages"
	@priority = 5
	test LinksAreRedirectingToRightPages {
		task ("Given that the 'Ground Services' page of the 'Division Sites' section is loaded") {
			General.goToMenuItem(
				menuItem = "Division Sites",
				submenuItem = "Ground Services");

			Default.SelectWindow.selectPopUp(locator1 = "null");
		}

		task ("When I navigate to the 'Passenger Services' page and access one of the helpful links it opens in a different tab") {
			General.goToPages(
				openLinksPage = 1,
				openPageIndex = 3);

			Default.SelectWindow.selectPopUp(locator1 = "PROCEDURES & WERKINSTRUCTIES - Liferay");
		}

		task ("Then the 'Procedures & Werkinstructies' page loads correctly") {
			General.viewPage(
				breadcrumbTitle = "PROCEDURES & WERKINSTRUCTIES",
				partialURL = "procedures-werkinstructies",
				titlePage = "Procedures & Werkinstructies");
		}
	}

}