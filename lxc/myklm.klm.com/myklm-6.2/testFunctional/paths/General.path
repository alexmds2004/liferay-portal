<html>
<head>
<title>General</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">General</td></tr>
</thead>

<tbody>
<tr>
	<td>ANY_TITLE_PAGE</td>
	<td>//div//span[contains(text(),'${key_titlePage}')]</td>
	<td></td>
</tr>
<tr>
	<td>BREADCRUMB_TITLE</td>
	<td>//div[@id='breadcrumbs']//*[contains(text(),'${key_breadcrumbTitle}')]</td>
	<td></td>
</tr>
<tr>
	<td>NAVIGATION_MENU_ITEM</td>
	<td>xpath=(//div[@id='klm-nav']//span[contains(text(),'${key_menuItemName}')])[1]</td>
	<td></td>
</tr>
<tr>
	<td>NAVIGATION_SUBMENU_ITEM</td>
	<td>xpath=(//div[@id='klm-nav']//ancestor::a[contains(text(),'${key_submenuItemName}')])[1]</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>