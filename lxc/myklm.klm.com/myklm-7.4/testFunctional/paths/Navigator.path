<html>
<head>
<title>Navigator</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">Navigator</td></tr>
</thead>

<tbody>
<tr>
	<td>PAGE_LINK_INDEX</td>
	<td>xpath=(//div[@id='main-content']//div[contains(@id,'JournalContentPortlet')]//div[@class='relatedArticles']//a)[${key_index}]</td>
	<td></td>
</tr>
<tr>
	<td>PAGES</td>
	<td>//div[contains(@id,'JournalContentPortlet')]//following::div[contains(@data-analytics-asset-title,'${key_navigationPages}')]//a</td>
	<td></td>
</tr>
<tr>
	<td>SECTION_NAME</td>
	<td>xpath=(//span[text()='${key_sectionName}']//following::div[@class='HRListContent']/a)[${key_index}]</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>