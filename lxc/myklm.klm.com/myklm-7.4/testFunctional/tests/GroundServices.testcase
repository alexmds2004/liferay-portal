definition {

	setUp {
		Utils.launchHomePage();

		Login.signIn();
	}

	@description = "Automation ID: KLMUA-172 | Test Summary: Verify that the useful links are redirecting to the right pages"
	@priority = 5
	test LinksAreRedirectingToRightPages {
		task ("Given that the user goes to 'Division Sites > Ground Services' page") {
			General.goToMenuItem(
				menuItem = "Division Sites",
				submenuItem = "Ground Services");

			Default.SelectWindow.selectPopUp(locator1 = "null");
		}

		task ("When the user navigates to 'Procedures & Werkinstructies' under 'Passenger Services' page") {
			Navigator.goToPage(
				linkIndex = 1,
				navigationPages = "Passenger Services");

			Default.SelectWindow.selectPopUp(locator1 = "PROCEDURES & WERKINSTRUCTIES - Passenger Services - Liferay DXP");
		}

		task ("Then the user will be redirected to the 'Procedures & Werkinstructies' page") {
			General.viewPage(
				breadcrumbTitle = "PROCEDURES & WERKINSTRUCTIES",
				partialURL = "procedures-werkinstructies",
				titlePage = "Procedures & Werkinstructies");
		}
	}

}