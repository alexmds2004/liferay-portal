definition {

	@summary = "Navigates to any menu and submenu item in the menu bar"
	macro goToMenuItem {
		Default.WaitForPageLoad();

		if (isSet(submenuItem)) {
			Default.MouseOver(
				key_menuItemName = ${menuItem},
				locator1 = "General#NAVIGATION_MENU_ITEM");

			Default.Click(
				key_submenuItemName = ${submenuItem},
				locator1 = "General#NAVIGATION_SUBMENU_ITEM");
		}
		else {
			Default.Click.clickAtNotVisible(
				key_menuItemName = ${menuItem},
				locator1 = "General#NAVIGATION_MENU_ITEM");
		}
	}

	@summary = "View that the page is loaded correctly"
	macro viewPage {
		Default.WaitForPageLoad();

		Default.AssertElementPresent(
			key_breadcrumbTitle = ${breadcrumbTitle},
			locator1 = "General#BREADCRUMB_TITLE");

		Default.AssertElementPresent(
			key_titlePage = ${titlePage},
			locator1 = "General#ANY_TITLE_PAGE");

		Default.AssertLocation.assertPartialLocation(value1 = ${partialURL});
	}

}