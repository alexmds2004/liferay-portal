definition {

	@summary = "Download file via curl"
	macro downloadFileViaCurl {
		var currentURL = selenium.getCurrentUrl();
		var testDependenciesDir = PropsUtil.get("output.dir.name");

		var curl = '''${currentURL} --create-dirs -o ${testDependenciesDir}/${fileName}''';

		com.liferay.poshi.runner.util.JSONCurlUtil.get(${curl});
	}

	@summary = "Get the name of the file to be downloaded"
	macro getFileName {
		var key_index = ${downloadIndex};
		var fileName = selenium.getText("Navigator#PAGE_LINK_INDEX");

		var fileName = StringUtil.replace(${fileName}, " ", "-");

		Default.Click(locator1 = "Navigator#PAGE_LINK_INDEX");

		return ${fileName};
	}

}