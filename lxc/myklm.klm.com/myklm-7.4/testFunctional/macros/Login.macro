definition {

	@summary = "Perform login process"
	macro signIn {
		var loginUsername = PropsUtil.get("test.this.klm.test.account.uat.admin.login");
		var loginUserPassword = PropsUtil.get("test.this.klm.test.account.uat.admin.password");

		Default.Click(locator1 = "Login#BUTTON_SIGN_IN");

		Default.WaitForElementPresent(locator1 = "Portal.TextInput#SCREEN_NAME");

		Default.Type(
			locator1 = "Portal.TextInput#SCREEN_NAME",
			value1 = ${loginUsername});

		Default.Type(
			locator1 = "Portal.TextInput#PASSWORD",
			value1 = ${loginUserPassword});

		Default.Click(locator1 = "Portal.Button#SUBMIT");
	}

}