definition {

	@summary = "Navigate to the selected page, which is opened in a separated tab, via index"
	macro goToPage {
		if (isSet(pageIndex)) {
			Default.Click(
				key_index = ${pageIndex},
				key_sectionName = ${sectionName},
				locator1 = "Navigator#SECTION_NAME");
		}

		if (isSet(navigationPages)) {
			Default.Click(
				key_navigationPages = ${navigationPages},
				locator1 = "Navigator#PAGES");
		}

		if (isSet(linkIndex)) {
			Default.Click.pauseClickAt(
				key_index = ${linkIndex},
				locator1 = "Navigator#PAGE_LINK_INDEX");
		}
	}

}