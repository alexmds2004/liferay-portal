definition {

	macro acceptCookies {
		if (Default.IsElementPresent(locator1 = "LDHome#COOKIE_BANNER_BUTTON")) {
			Default.Click(locator1 = "LDHome#COOKIE_BANNER_BUTTON");
		}
	}

	macro launchLDProd {
		var portalURL = PropsUtil.get("test.this.liferaydev.portal.url.prod");

		Default.Open(locator1 = ${portalURL});

		Default.Pause(locator1 = 1000);
	}

	macro launchLDUat {
		var portalUatURL = PropsUtil.get("test.this.liferaydev.portal.url.modl");

		Default.Open(locator1 = ${portalUatURL});
	}

	@summary = "Deletes asked questions which are no longer needed"
	macro tearDownAsk {
		LDLogin.switchToRegularUser();

		LDNavigation.goToAsk();

		LDAsk.openCard(cardTitle = "Commerce");

		Default.WaitForElementPresent(locator1 = "LDAsk#QUESTION");

		while ((Default.IsElementPresent(key_questionTitle = "Test Question Title", locator1 = "LDAsk#QUESTION_TITLE")) && (maxIterations = "50")) {
			LDAsk.deleteQuestion(questionTitle = "Test Question Title");
		}

		while ((Default.IsElementPresent(key_questionTitle = "Edited Test Question Title", locator1 = "LDAsk#QUESTION_TITLE")) && (maxIterations = "50")) {
			LDAsk.deleteQuestion(questionTitle = "Edited Test Question Title");
		}
	}

	macro validateCurrentURL {
		var currentURL = ${currentURL};
		var notExpectedContent = ${notExpectedContent};

		if (!(isSet(currentURL))) {
			var currentURL = selenium.getCurrentUrl();
		}

		if (!(isSet(notExpectedContent))) {
			var notExpectedContent = "/web/guest";
		}

		if (contains(${currentURL}, ${notExpectedContent})) {
			Portal.TestUtils.fail(message = "FAILED: Not expected content: \"${notExpectedContent}\" is present.");
		}
		else {
			Portal.TestUtils.pass(message = "PASSED: Not expected content: \"${notExpectedContent}\" is not present.");
		}
	}

}