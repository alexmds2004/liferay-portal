definition {

	macro signIn {
		LDNavigation.goToLogin();

		Default.Type(
			locator1 = "Portal.TextInput#EMAIL_ADDRESS",
			value1 = ${userEmailAddress});

		Default.Type(
			locator1 = "Portal.TextInput#PASSWORD",
			value1 = ${userPassword});

		Portal.Button.click(button = "Sign In");

		// LRQA-78208 - We need to have an explicit wait (Pause) in order to wait for the login process be completed

		Default.Pause(locator1 = 5000);

		Default.WaitForElementPresent(locator1 = "LDUserProfile#USER_AVATAR_BUTTON");
	}

	macro signInWithAdminUser {
		var userEmailAddress = PropsUtil.get("test.this.liferaydev.test.account.modl.admin.login");
		var userPassword = PropsUtil.getEnvironmentVariable("MODL_CUSTOMER_USERS_PASSWORD");

		LDLogin.signIn(
			userEmailAddress = ${userEmailAddress},
			userPassword = ${userPassword});
	}

	macro signInWithNonAdminUser {
		var userEmailAddress = PropsUtil.get("test.this.liferaydev.test.account.modl.user.login");
		var userPassword = PropsUtil.getEnvironmentVariable("MODL_CUSTOMER_USERS_PASSWORD");

		LDLogin.signIn(
			userEmailAddress = ${userEmailAddress},
			userPassword = ${userPassword});
	}

	macro signOut {
		if (Default.IsElementPresent(locator1 = "LDUserProfile#USER_AVATAR_BUTTON")) {
			Portal.UserBar.signOut();
		}
	}

}