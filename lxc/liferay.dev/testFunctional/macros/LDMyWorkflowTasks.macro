definition {

	macro approveWorkflowAsset {
		Portal.UserBar.gotoDropdownItem(dropdownItem = "My Workflow Tasks");

		Default.Click(
			key_tabName = "Assigned to My Roles",
			locator1 = "SystemWorkflow#MY_WORKFLOW_TASKS_TAB");

		Default.Click(
			key_itemName = ${itemTitle},
			locator1 = "Icon#SPECIFIC_VERTICAL_ELLIPSIS");

		Default.WaitForElementPresent(
			key_option = "Assign to Me",
			locator1 = "Icon#ELLIPSIS_OPTION");

		Default.Click(
			key_option = "Assign to Me",
			locator1 = "Icon#ELLIPSIS_OPTION");

		Default.SelectFrame(locator1 = "SystemWorkflow#WORKFLOW_COMMENT_IFRAME");

		Default.Click(
			key_buttonName = "Done",
			locator1 = "LDAsk#ANY_BUTTON");

		Default.SelectFrameTop();

		Alert.viewSuccessMessage();

		Default.Refresh();

		Default.Click(
			key_tabName = "Assigned to Me",
			locator1 = "SystemWorkflow#MY_WORKFLOW_TASKS_TAB");

		Default.WaitForVisible(
			key_itemName = ${itemTitle},
			locator1 = "Icon#SPECIFIC_VERTICAL_ELLIPSIS");

		Default.Click(
			key_itemName = ${itemTitle},
			locator1 = "Icon#SPECIFIC_VERTICAL_ELLIPSIS");

		Default.Click(
			key_option = "Approve",
			locator1 = "Icon#ELLIPSIS_OPTION");

		Default.SelectFrame(locator1 = "SystemWorkflow#APPROVAL_IFRAME");

		Default.Click(
			key_buttonName = "Done",
			locator1 = "LDAsk#ANY_BUTTON");

		Default.SelectFrameTop();

		Alert.viewSuccessMessage();
	}

}