definition {

	setUp {
		Utils.launchModlHomePage();

		Utils.closeModalImage();

		General.gotoMenuItem(menuItem = "MDS Hoteles");
	}

	@description = "Automation ID: LRQA-80033 | Test Summary: Verify user can search for hotels (redirects to the MDS Hotel URL)"
	@priority = 5
	test CanSearchHotels {
		task ("When we select and apply the hotel 'disponibilidad' filters") {
			var todayDate = MDSHotels.getTodayDate();

			MDSHotels.selectFilterOption(
				AdultsFieldId = "adultos",
				ChildrenFieldId = "ninos",
				RoomsFieldId = "habitaciones",
				Selectednumber = 2);

			MDSHotels.applyHotelFilter();
		}

		task ("Then the selected hotel should be visible at the title of the redirected page") {
			MDSHotels.viewAppliedHotelFilter(hotelName = "Concepción");
		}
	}

	@description = "Automation ID: LRQA-80108 | Test Summary: Verify user can select the hotels in the dropdown and see the respective habitaciones"
	@priority = 5
	test CanSeeHotelHabitaciones {
		task ("Given the the user gets the name of the active item in the habitaciones carousel") {
			MDSHotels.selectHotelPage(hotelName = "Concepción");

			var conceptionHotelRooms = MDSHotels.getHabitacionesName();
		}

		task ("When the user selects a different hotel page") {
			MDSHotels.selectHotelPage(hotelName = "Chillán");
		}

		task ("Then the user should be able to see differents rooms in the habitaciones carousel") {
			var chillanHotelRooms = MDSHotels.getHabitacionesName();

			MDSHotels.compareHotelHabitaciones(
				firstHotel = ${conceptionHotelRooms},
				secondHotel = ${chillanHotelRooms});
		}
	}

	@description = "Automation ID: LRQA-80109 | Test Summary: Verify Carousell (Habitaciones) is visible"
	@priority = 5
	test ViewHabitacionesCarousell {
		task ("Given the user get's the name of the active item in the habitaciones carrousel") {
			var firstActiveItemName = MDSHotels.getActiveItemName(cardIndex = 1);
		}

		task ("When the user click's on the carrousel button") {
			MDSHotels.slideCarrousel();
		}

		task ("Then the active item should be different from the previous one") {
			var secondActiveItemName = MDSHotels.getActiveItemName(cardIndex = 2);

			MDSHotels.compareActiveItem(
				firstItem = ${firstActiveItemName},
				secondItem = ${secondActiveItemName});
		}
	}

}