definition {

	property test.env = "modl";
	property testray.main.component.name = "Marina del Sol";

	setUp {
		Utils.launchModlHomePage();

		Utils.closeModalImage();
	}

	@description = "Automation ID: LRQA-80372 | Test Summary: Verify user can filter Promociones per day"
	@priority = 5
	test CanFilterPromocionesPerDay {
		task ("Given the filter 'Todas' is applied to 'Promociones' section into 'MDS Casinos' page") {
			General.gotoMenuItem(menuItem = "MDS Casinos");

			MDSCasinos.selectWeekDayOption(weekdayOption = "Todas");

			var allCardsValue = MDSCasinos.getCardText();
		}

		task ("When I filter by a specific day in 'Promociones' section") {
			MDSCasinos.selectWeekDayOption(weekdayOption = "Lunes");

			var lunesCardsValue = MDSCasinos.getCardText();
		}

		task ("Then a different cards list should be visible") {
			General.validateDifference(
				firstItem = ${allCardsValue},
				secondItem = ${lunesCardsValue});
		}
	}

	@description = "Automation ID: LRQA-80031 | Test Summary: Verify Carousel (Promociones) is visible"
	@priority = 5
	test ShowsCarouselPromocionesWithImages {
		task ("When I navigate to the 'MDS Casinos' page") {
			General.gotoMenuItem(menuItem = "MDS Casinos");
		}

		task ("Then the main carousel of the 'Promociones' section is visible") {
			MDSCasinos.verifyCarouselIsVisible(carouselBanner = "splide01");

			MDSCasinos.verifyCarouselContents(
				carouselSliderNumber = 01,
				index = 1);
		}
	}

	@description = "Automation ID: LRQA-80194 | Test Summary: Verify Carousel (Máquinas y premios - cards are visible)"
	@priority = 4
	test ShowsMaquinasYPremiosCarouselCards {
		task ("When I navigate to the 'MDS Casinos' page") {
			General.gotoMenuItem(menuItem = "MDS Casinos");
		}

		task ("Then the cards from the 'Máquinas y premios' section are visible") {
			MDSCasinos.verifyCardIsVisible();
		}
	}

	@description = "Automation ID: LRQA-80047 | Test Summary: Verify Carousel (Máquinas y premios - main carousell is visible)"
	@priority = 5
	test ShowsMaquinasYPremiosMainCarousel {
		task ("When I navigate to the 'MDS Casinos' page") {
			General.gotoMenuItem(menuItem = "MDS Casinos");
		}

		task ("Then the main carousel of the 'Máquinas y premios' section is visible") {
			MDSCasinos.verifyCarouselIsVisible(carouselBanner = "splide02");

			MDSCasinos.verifyCarouselContents(
				carouselSliderNumber = 02,
				index = 2);
		}
	}

}