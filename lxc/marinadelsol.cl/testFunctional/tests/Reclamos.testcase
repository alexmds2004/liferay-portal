definition {

	property test.env = "modl";
	property testray.main.component.name = "Marina del Sol";

	setUp {
		Utils.launchModlHomePage();

		Utils.closeModalImage();
	}

	@description = "Automation ID: LRQA-80392 | Test Summary: Verify user can submit a complaint/reclamos (make sure the complaint is present in the complaint's object list)"
	@priority = 5
	@refactor
	test UserCanSubmitReclamos {
		task ("Given I navigate to the 'Reclamos' page") {
			General.goToFooterInfomationArea(pageInformations = "Reclamos");
		}

		task ("When I fill out the 'Reclamos' form and submit the form") {
			Reclamos.fillFormReclamos(
				apellidos = "Test Appelidos",
				correo = "test@test.com",
				descripcion = "Test Descripcion",
				domicilio = "Test Street 99",
				elAreaCorrespondeSuReclamo = "otros",
				formatDateAndTime = "00/00/0000, 00:00",
				nacionalidad = "Brasil",
				nombre = "Test Reclamos",
				pasaporte = "12345678-9",
				peticion = "Test Peticion",
				telefono = 123456789);

			Portal.Button.click(button = "Enviar");
		}

		task ("Then the message that the 'Reclamos' was successfully received is displayed") {
			Reclamos.assertReclamoSuccssfully(successMessage = "Gracias. Hemos recibido correctamente su información");
		}

		// LXC Refactor: The test is incomplete due to the lack of information about how to access the Objects and to be able to validate that the 'Reclamos' have been added to the entries
		// LXC Refactor ticket: LRQA-80446

	}

}