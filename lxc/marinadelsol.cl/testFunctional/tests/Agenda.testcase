definition {

	property test.env = "modl";
	property testray.main.component.name = "Marina del Sol";

	setUp {
		Utils.launchModlHomePage();

		Utils.closeModalImage();

		General.gotoMenuItem(menuItem = "Agenda");
	}

	@description = "Automation ID: LRQA-80244 | Test Summary: Verify user can search the agenda for events"
	@priority = 5
	test UserCanSearch {
		task ("Given the user has filled out the filter fields") {
			var searchedEvent = Agenda.getEventName(index = 1);
			var differentEvent = Agenda.getEventName(index = 2);

			Agenda.searchForEvent(eventName = ${searchedEvent});

			Agenda.selectFilterOption(eventType = "Todos");
		}

		task ("When the filters are applied") {
			Agenda.applyFilters();
		}

		task ("Then only the cards with the selected filters should be displayed") {
			Agenda.viewCardsAfterFilter(
				differentEventName = ${differentEvent},
				eventName = ${searchedEvent});
		}
	}

	@description = "Automation ID: LRQA-80536 | Test Summary: Verify user can filter the events in the agenda (tipo)"
	@priority = 5
	test UserCanSearchUsingFilterType {
		task ("Given the 'Todos' filter is applied on the 'Agenda' page") {
			Agenda.selectFilterOption(eventType = "Todos");

			Agenda.applyFilters();

			var allCardsTextAgenda = Agenda.getCardsText();
		}

		task ("When I apply the filter by type Events") {
			Agenda.selectFilterOption(eventType = "Eventos");

			Agenda.applyFilters();

			var allCardsTextUsingFilterEventos = Agenda.getCardsText();
		}

		task ("Then a different cards list should be visible") {
			General.validateDifference(
				firstItem = ${allCardsTextAgenda},
				secondItem = ${allCardsTextUsingFilterEventos});
		}
	}

	@description = "Automation ID: LRQA-80554 | Test Summary: Verify agenda of events changes according to the selected casino"
	@priority = 5
	test ViewAgendaChangesAccordingSelectedCasino {
		task ("Given the 'Eventos' filter is applied") {
			Agenda.selectFilterOption(eventType = "Eventos");

			Agenda.applyFilters();

			var allCardsTextAgenda = Agenda.getCardsText();
		}

		task ("When I change to 'Chillán' casino and apply the 'Eventos' filter") {
			Agenda.selectCasinos(nameCasino = "Chillán");

			Agenda.selectFilterOption(eventType = "Eventos");

			Agenda.applyFilters();

			var cardsTextAgendaEventosChillan = Agenda.getCardsText();
		}

		task ("Then a different cards list should be visible") {
			General.validateDifference(
				firstItem = ${allCardsTextAgenda},
				secondItem = ${cardsTextAgendaEventosChillan});
		}
	}

}