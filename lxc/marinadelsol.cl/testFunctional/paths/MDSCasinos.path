<html>
<head>
<title>MDSCasinos</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">MDSCasinos</td></tr>
</thead>

<tbody>
<tr>
	<td>CONTENT_PROMOCIONES</td>
	<td>//div[@id='promociones']</td>
	<td></td>
</tr>
<tr>
	<td>PROMOCIONES_CARD_IMAGES_INDEX</td>
	<td>xpath=(//div[@id='promociones']//*[contains(@class,'mds-promotion-card')]//img)[${key_index}]</td>
	<td></td>
</tr>
<tr>
	<td>CAROUSEL_BANNER</td>
	<td>//div[contains(@class,'mds-container-carrousel')][@id='${key_carrouselBanner}']</td>
	<td></td>
</tr>
<tr>
	<td>SECTION_CARDS_CAROUSEL_MAQUINAS_Y_PREMIOS</td>
	<td>//div[@data-analytics-asset-title='Máquinas y premios']//following::div[@id='mds-carrousel-prizes-list']</td>
	<td></td>
</tr>
<tr>
	<td>CARD_MAQUINAS_Y_PREMIOS</td>
	<td>xpath=(//div[@id='mds-carrousel-prizes-list']//div[contains(@class,'is-visible')])[1]</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>