<html>
<head>
<title>Reclamos</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">Reclamos</td></tr>
</thead>

<tbody>
<tr>
	<td>FORM_RECLAMOS</td>
	<td>//input[(@id='${key_fieldName}')]</td>
	<td></td>
</tr>
<tr>
	<td>FORM_RECLAMOS_NACIONALIDAD</td>
	<td>//div[@class='mds-form-field']//select[@id='recNacionalidad']</td>
	<td></td>
</tr>
<tr>
	<td>FORM_TEXT_AREA</td>
	<td>//div[@class='mds-form-field']//*[@id='${key_fieldName}']</td>
	<td></td>
</tr>
<tr>
	<td>SUCCESS_RECLAMO_MESSAGE</td>
	<td>//section[contains(@class,'mds-content-container')]//div[contains(text(),'${key_successMessage}')]</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>