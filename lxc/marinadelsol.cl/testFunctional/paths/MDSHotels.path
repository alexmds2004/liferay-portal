<html>
<head>
<title>MDSHoltels</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">MDSHoltels</td></tr>
</thead>

<tbody>
<tr>
	<td>CONTAINER_ACTIONS</td>
	<td>//div[contains(@class,'container-actions')]/*[contains(@id,'${key_actionId}')]</td>
	<td></td>
</tr>
<tr>
	<td>DROPDOWN_SELECTOR</td>
	<td>//div[contains(@id,'select-casino')]//select</td>
	<td></td>
</tr>
<tr>
	<td>FILTER_INPUT</td>
	<td>//div[contains(@class,'container-inputs')]/div//*[contains(@id,'${key_filterId}')]</td>
	<td></td>
</tr>
<tr>
	<td>FILTER_SECTION_TEXT</td>
	<td>//div[contains(@class,'txt-hotel')]/*[contains(text(),'${key_hotelName}')]</td>
	<td></td>
</tr>
<tr>
	<td>HABITATION_CARROUSEL</td>
	<td>//div[contains(@class,'mds-carrousel') and contains(@id,'carrusel-dcyc')]</td>
	<td></td>
</tr>
<tr>
	<td>HABITATION_CARROUSEL_ITEM</td>
	<td>xpath=(//div[contains(@class,'rooms-carrousel')]//div[contains(@id,'carrusel') and contains(@id,'list')]/div[contains(@class,'visible')])[${key_index}]//p</td>
	<td></td>
</tr>
<tr>
	<td>RADIO_SELECTOR</td>
	<td>//div[contains(@class,'selector-hotel')]//div[contains(@class,'container-radio')]/input[contains(@id,'${key_hotelName}')]</td>
	<td></td>
</tr>
<tr>
	<td>REDIRECTED_PAGE_TITLE</td>
	<td>//*[contains(@class,'progressbar-hotelName')]/*[contains(text(),'${key_hotelName}')]</td>
	<td></td>
</tr>
<tr>
	<td>SELECT_HOTEL_DROPDOWN_ARROW_ICON</td>
	<td>//div[contains(@class,'language-select') and contains(@id,'select-casino')]/*[contains(@class,'select__icon')]</td>
	<td></td>
</tr>
<tr>
	<td>TODAY_DATE</td>
	<td>//div[contains(@class,'container-inputs')]/div[contains(@class,'field')]/div/input[contains(@id,'fecha-llegada')]@min</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>