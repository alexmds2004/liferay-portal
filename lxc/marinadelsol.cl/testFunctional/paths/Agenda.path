<html>
<head>
<title>Agenda</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">Agenda</td></tr>
</thead>

<tbody>
<tr>
	<td>APPLY_FILTER_BUTTON</td>
	<td>//div[contains(@class,'agenda-banner')]//button[contains(@id,'btn-submit')]</td>
	<td></td>
</tr>
<tr>
	<td>EVENT_CARD</td>
	<td>//div[contains(@class,'agenda-moths')]//div[contains(@class,'day-container')]//div[contains(@class,'agenda__events')]//a[contains(@class,'promotion-card')]</td>
	<td></td>
</tr>
<tr>
	<td>EVENT_CARD_NAME</td>
	<td>//div[contains(@class,'agenda-moths')]//div[contains(@class,'day-container')]/div[contains(@class,'agenda__events')]//div//p[contains(text(),'${key_eventName}')]</td>
	<td></td>
</tr>
<tr>
	<td>FILTER_CONTAINER</td>
	<td>//div[contains(@class,'agenda-banner')]//div[contains(@class,'filter-container')]</td>
	<td></td>
</tr>
<tr>
	<td>FILTER_FIELD</td>
	<td>//div[contains(@class,'filter-container')]//div[contains(@class,'form-field')]//*[contains(@id,'${key_fieldId}')]</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>