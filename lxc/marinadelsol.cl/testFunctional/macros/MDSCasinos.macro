definition {

	@summary = "Verify that the cards in the 'Máquinas y premios' section are visible"
	macro verifyCardsIsVisible {
		Default.ScrollWebElementIntoView(locator1 = "MDSCasinos#CAROUSEL_CARDS_MAQUINAS_Y_PREMIOS");

		Default.IsVisible(locator1 = "MDSCasinos#CARDS_MAQUINAS_Y_PREMIOS");
	}

	@summary = "Verify if the content of the carousel corresponds to the page where the carousel is set"
	macro verifyCarouselContents {
		var key_index = ${index};
		var key_carouselSliderNumber = ${carouselSliderNumber};

		Default.WaitForPageLoad();

		var slideButtonActive = selenium.getAttribute("xpath=(//div[contains(@class,'mds-container-carrousel')])[${key_index}]//button[contains(@class,'is-active')]@aria-controls");
		var imageVisible = selenium.getAttribute("//div[contains(@class,'mds-container-carrousel')]//div[@id='splide${key_carouselSliderNumber}-list']//div[contains(@class,'is-visible')]@id");

		Portal.TestUtils.assertEquals(
			actual = ${slideButtonActive},
			expected = ${imageVisible});
	}

	@summary = "Verify that the main carousel banner is visible"
	macro verifyCarouselIsVisible {
		if (Default.IsVisible(key_carrouselBanner = ${carouselBanner}, locator1 = "MDSCasinos#CAROUSEL_BANNER")) {
			Default.AssertElementPresent(
				key_carrouselBanner = ${carouselBanner},
				locator1 = "MDSCasinos#CAROUSEL_BANNER");
		}
		else {
			Default.ScrollWebElementIntoView(locator1 = "MDSCasinos#CAROUSEL_BANNER");

			Default.AssertElementPresent(
				key_carrouselBanner = ${carouselBanner},
				locator1 = "MDSCasinos#CAROUSEL_BANNER");
		}
	}

}