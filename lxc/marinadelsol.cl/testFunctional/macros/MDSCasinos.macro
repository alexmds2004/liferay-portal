definition {

	@summary = "Verify if the content of the carousel corresponds to the page where the carousel is set"
	macro verifyCarouselContents {
		var key_index = ${index};
		var key_carouselSliderNumber = ${carouselSliderNumber};

		Default.WaitForPageLoad();

		var slideButtonActive = selenium.getAttribute("xpath=(//div[contains(@class,'mds-container-carrousel')])[${key_index}]//button[contains(@class,'is-active')]@aria-controls");
		var imageVisible = selenium.getAttribute("//div[contains(@class,'mds-container-carrousel')]//div[@id='splide${key_carouselSliderNumber}-list']//div[contains(@class,'is-visible')]@id");

		Portal.TestUtils.assertEquals(
			actual = ${slideButtonActive},
			expected = ${imageVisible});
	}
