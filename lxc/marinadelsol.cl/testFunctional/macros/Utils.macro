definition {

	@summary = "Close Modal Image"
	macro closeModalImage {
		if (Default.isElementPresent(locator1 = "General#MODAL_IMAGE")) {
			Default.Click(locator1 = "General#MODAL_IMAGE");
		}
	}

	@summary = "Launching MODL Home page"
	macro launchModlHomePage {
		var portal = PropsUtil.get(" test.this.marinadelsol.portal.url.modl");

		Default.WaitForVisible(locator1 = "General#LOGO");
	}

}