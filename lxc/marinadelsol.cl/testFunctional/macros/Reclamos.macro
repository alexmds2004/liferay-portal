definition {

	@summary = "Fill in the fields of the 'Reclamos' form"
	macro fillFormReclamos {
		Default.Type.sendKeys(
			key_fieldName = "fechaIncidente",
			locator1 = "Reclamos#FORM_RECLAMOS",
			value1 = ${formatDateAndTime});

		Default.KeyPress(
			key_fieldName = "fechaIncidente",
			locator1 = "Reclamos#FORM_RECLAMOS",
			value1 = "\ENTER");

		Default.Type(
			key_fieldName = "recNombre",
			locator1 = "Reclamos#FORM_RECLAMOS",
			value1 = ${nombre});

		Default.Type(
			key_fieldName = "recApellidos",
			locator1 = "Reclamos#FORM_RECLAMOS",
			value1 = ${apellidos});

		Default.Type(
			key_fieldName = "recCIPasaporte",
			locator1 = "Reclamos#FORM_RECLAMOS",
			value1 = ${pasaporte});

		Default.Type(
			key_fieldName = "recDescripcion",
			locator1 = "Reclamos#FORM_TEXT_AREA",
			value1 = ${descripcion});

		Default.Type(
			key_fieldName = "recPeticion",
			locator1 = "Reclamos#FORM_TEXT_AREA",
			value1 = ${peticion});

		Default.Click(
			key_fieldName = "recOtros",
			locator1 = "Reclamos#FORM_RECLAMOS",
			value1 = ${elAreaCorrespondeSuReclamo});

		Default.Select(
			locator1 = "Reclamos#FORM_RECLAMOS_NACIONALIDAD",
			value1 = ${nacionalidad});

		Default.Type(
			key_fieldName = "recDomicilio",
			locator1 = "Reclamos#FORM_RECLAMOS",
			value1 = ${domicilio});

		Default.Type(
			key_fieldName = "recTelefono",
			locator1 = "Reclamos#FORM_RECLAMOS",
			value1 = ${telefono});

		Default.Type(
			key_fieldName = "recCorreo",
			locator1 = "Reclamos#FORM_RECLAMOS",
			value1 = ${correo});
	}

	@summary = "Making sure the success message when submitting a 'Reclamo' is displayed"
	macro viewSuccessMessage {
		Default.WaitForPageLoad();

		Default.AssertVisible(
			key_successMessage = ${successMessage},
			locator1 = "Reclamos#SUCCESS_RECLAMO_MESSAGE");
	}

}