definition {

	@summary = "Go to the page by clicking on the information area in the footer"
	macro goToFooterInfomationArea {
		Default.ScrollWebElementIntoView(locator1 = "General#FOOTER");

		Default.Click(
			key_pageInformation = ${pageInformation},
			locator1 = "General#FOOTER_INFORMATION_PAGES");

		Default.WaitForPageLoad();
	}

	@summary = "Goes to menu item"
	macro gotoMenuItem {
		Default.Click(
			key_menuItem = ${menuItem},
			locator1 = "General#MENU_ITEM");

		if (${menuItem} == "MDS Hoteles") {
			Default.WaitForVisible(
				key_hotelName = "Concepción",
				locator1 = "MDSHotels#FILTER_SECTION_TEXT");
		}

		Default.WaitForPageLoad();
	}

	@summary = "Validate the difference between two items"
	macro validateDifference {
		Portal.TestUtils.assertNotEquals(
			actual = ${firstItem},
			expected = ${secondItem});
	}

}