definition {

	@summary = "selecting a pop-up window after clicking on the apply filter in the Hotels filter container."
	macro applyHotelFilter {
		Default.Click(
			key_actionId = "btn-disponibilidad",
			locator1 = "MDSHotels#CONTAINER_ACTIONS");

		Default.SelectWindow.selectPopUp(locator1 = "null");
	}

	@summary = "Compare two active items in a carousel and print a message indicating whether they are equal or not."
	macro compareActiveItem {
		if (${firstItem} == ${secondItem}) {
			fail("${firstItem} == ${secondItem}");
		}
		else {
			echo("${firstItem} != ${secondItem}");
		}
	}

	@summary = "Compare the room's from the selected hotels and print a message indicating whether they are equal or not."
	macro compareHotelHabitations {
		if (${firstHotel} == ${secondHotel}) {
			fail("${firstHotel} == ${secondHotel}");
		}
		else {
			echo("${firstHotel} != ${secondHotel}");
		}
	}

	@summary = "Get the name of the active item in the habitaciones carousel of the Hotels section"
	macro getActiveItemName {
		Default.ScrollWebElementIntoView(locator1 = "MDSHotels#HABITATION_CARROUSEL");

		var activeItemName = selenium.getText("MDSHotels#HABITATION_CARROUSEL_ACTIVE_ITEM");

		echo(${activeItemName});

		return ${activeItemName};
	}

	@summary = "Get the names of the room's displayed in the habitaciones carousel of the Hotels section, by iterating over each item and concatenating its name to a string"
	macro getHabitacionesName {
		var habitacionesNames = "";

		Default.ScrollWebElementIntoView(locator1 = "MDSHotels#HABITATION_CARROUSEL");

		for (var key_index : list "1,2,3,4,5") {
			var habitacionesName = selenium.getText("MDSHotels#HABITATION_CARROUSEL_ITEM");

			var habitacionesNames = StringUtil.concat(${habitacionesNames}, "${habitacionesName} ");
		}

		return ${habitacionesNames};
	}

	@summary = "Get today's date"
	macro getTodayDate {
		var today = selenium.getAttribute("MDSHotels#TODAY_DATE");

		return ${formatedTodayDate};
	}

	@summary = "Select filter options in the Hotels section, by checking if each option is set and selects the corresponding filter option"
	macro selectFilterOption {
		if (isSet(hotelName)) {
			Default.Click(
				key_hotelName = ${hotelName},
				locator1 = "MDSHotels#RADIO_SELECTOR");
		}

		if (isSet(RoomsFieldId)) {
			Default.Select(
				key_filterId = ${RoomsFieldId},
				locator1 = "MDSHotels#FILTER_INPUT",
				value1 = ${Selectednumber});
		}

		if (isSet(AdultsFieldId)) {
			Default.Select(
				key_filterId = ${AdultsFieldId},
				locator1 = "MDSHotels#FILTER_INPUT",
				value1 = ${Selectednumber});
		}

		if (isSet(ChildrenFieldId)) {
			Default.Select(
				key_filterId = ${ChildrenFieldId},
				locator1 = "MDSHotels#FILTER_INPUT",
				value1 = ${Selectednumber});
		}
	}

	@summary = "Select a hotel page in the Hotels section, by clicking on the hotel dropdown and selecting the corresponding hotel name"
	macro selectHotelPage {
		Default.Select(
			locator1 = "MDSHotels#DROPDOWN_SELECTOR",
			value1 = ${hotelName});
	}

	@summary = "Verify that the page redirected to the selected hotel after applying hotel filters"
	macro viewAppliedHotelFilter {
		Default.WaitForVisible(
			key_hotelName = ${hotelName},
			locator1 = "MDSHotels#REDIRECTED_PAGE_TITLE");
	}

}