definition {

	@summary = "Applies filters to the events in the Agenda section"
	macro applyFilters {
		Default.Click(locator1 = "Agenda#APPLY_FILTER_BUTTON");
	}

	@summary = "retrieves the name of an event card displayed in the Agenda section."
	macro getEventName {
		var key_index = ${index};

		Default.WaitForVisible(locator1 = "Agenda#EVENT_CARD");

		var eventName = selenium.getText("xpath=(//div[contains(@class,'agenda-moths')]//div[contains(@class,'day-container')]/div[contains(@class,'agenda__events')]//div/p)[${key_index}]");

		return ${eventName};
	}

	@summary = "Executes a single action to search for a specific event in the Agenda section"
	macro searchForEvent {
		Default.Type(
			locator1 = "Agenda#FILTER_SEARCH_FIELD",
			value1 = ${eventName});
	}

	@summary = "Selects a specific event type from a dropdown filter in the Agenda section."
	macro selectFilterOption {
		Default.Select(
			locator1 = "Agenda#FILTER_SELECT_FIELD",
			value1 = ${eventType});
	}

	@summary = "Verifies if event cards are displayed in the Agenda section after applying filters."
	macro viewCardsAfterFilter {
		Default.AssertElementPresent(
			key_eventName = ${eventName},
			locator1 = "Agenda#EVENT_CARD_NAME");

		Default.AssertElementNotPresent(
			key_eventName = ${differentEventName},
			locator1 = "Agenda#EVENT_CARD_NAME");
	}

}