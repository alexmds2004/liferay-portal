definition {

	@summary = "Applies filters to the events in the Agenda section"
	macro applyFilters {
		Default.Click(locator1 = "Agenda#APPLY_FILTER_BUTTON");
	}

	@summary = "Get the text of the cards in the 'Agenda' section"
	macro getCardsText {
		if (${filtered} == "true") {
			if (Default.IsElementPresent(locator1 = "Agenda#CONTAINER_CARDS_INDEX")) {
				var filterResult = selenium.getText("Agenda#CONTAINER_CARDS_INDEX");
			}
			else {
				var filterResult = "null";
			}

			return ${filterResult};
		}
		else {
			var allCardsText = selenium.getText("Agenda#CONTAINER_CARDS_INDEX");

			return ${allCardsText};
		}
	}

	@summary = "Retrieves the name of an event card displayed in the Agenda section"
	macro getEventName {
		var key_index = ${index};

		Default.WaitForVisible(locator1 = "Agenda#EVENT_CARD");

		var eventName = selenium.getText("xpath=(//div[contains(@class,'agenda-moths')]//div[contains(@class,'day-container')]/div[contains(@class,'agenda__events')]//div/p)[${key_index}]");

		return ${eventName};
	}

	@summary = "Executes a single action to search for a specific event in the Agenda section"
	macro searchForEvent {
		Default.Type(
			key_fieldId = "title",
			locator1 = "Agenda#FILTER_FIELD",
			value1 = ${eventName});
	}

	@summary = "Select the casino displayed on the 'Agenda' page"
	macro selectCasinos {
		Default.Select(
			locator1 = "Agenda#OPTIONS_CASINOS",
			value1 = ${nameCasino});
	}

	@summary = "Select options from the 'Agenda' section dropdown filter"
	macro selectFilterOption {
		Default.Select(
			key_fieldId = "type",
			locator1 = "Agenda#FILTER_FIELD",
			value1 = ${eventType});

		if (isSet(startDate)) {
			Default.Click(
				key_fieldId = "startDate",
				locator1 = "Agenda#FILTER_FIELD");

			Default.KeyPress(
				locator1 = "Agenda#AGENDA_START_DATE",
				value1 = "\TAB");

			Default.KeyPress(
				locator1 = "Agenda#AGENDA_START_DATE",
				value1 = "\TAB");

			Default.KeyPress(
				locator1 = "Agenda#AGENDA_START_DATE",
				value1 = "\ENTER");
		}

		if (isSet(endDate)) {
			Default.Click(
				key_fieldId = "endDate",
				locator1 = "Agenda#FILTER_FIELD");

			Default.KeyPress(
				locator1 = "Agenda#AGENDA_END_DATE",
				value1 = "\TAB");

			Default.KeyPress(
				locator1 = "Agenda#AGENDA_END_DATE",
				value1 = "\TAB");

			Default.KeyPress(
				locator1 = "Agenda#AGENDA_END_DATE",
				value1 = "\ENTER");
		}
	}

	@summary = "Verifies if event cards are displayed in the Agenda section after applying filters"
	macro viewCardsAfterFilter {
		Default.AssertElementPresent(
			key_eventName = ${eventName},
			locator1 = "Agenda#EVENT_CARD_NAME");

		Default.AssertElementNotPresent(
			key_eventName = ${differentEventName},
			locator1 = "Agenda#EVENT_CARD_NAME");
	}

}