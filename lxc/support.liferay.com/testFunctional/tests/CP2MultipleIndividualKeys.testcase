definition {

	property test.env = "uat";
	property testray.main.component.name = "Customer Portal 2.0";

	setUp {
		Utils.launchUatPage();

		Login.loginAsAdminUser();
	}

	@description = "Automation ID: LRQA-79354 | Test Summary: Verify that user can see the correct option of download when they select two keys with the same expiration date."
	@priority = 5
	test MultipleIndividualKeysAgregatedDowloadOptions {
		task ("Given I go to the test account") {
			HomePage.searchProject(projectName = "2022 FIFA World Cup Qatar - FAN ID");

			Portal.CustomerPortal.enterOnProject(title = "2022 FIFA World Cup Qatar - FAN ID");
		}

		task ("And I click on DXP product") {
			Portal.CP2NavigationMenu.goToProductActivation();

			Portal.CP2NavigationMenu.clickOnProductButton(product = "DXP");
		}

		task ("And I view the Actions button") {
			Portal.CustomerPortal.viewButton(text = "Actions");
		}

		task ("And I filter the table by On-Premise key type") {
			Portal.CP2ActivationKeys.filterKeyTable(
				filterOption = "On-Premise",
				filterType = "Key Type");
		}

		task ("When I select two keys from the table with same Expiration Date") {
			Portal.CP2ActivationKeys.selectKeyCheckboxByExpirationDate(
				date = "Mar 30, 2023",
				position = 1);

			Portal.CP2ActivationKeys.selectKeyCheckboxByExpirationDate(
				date = "Mar 30, 2023",
				position = 2);
		}

		task ("When I click at the download button") {
			Portal.CustomerPortal.clickAtButton(text = "Download");
		}

		task ("When I click at the 'Aggregate key single file' option") {
			Portal.CP2ActivationKeys.clickAtDropdownItem(dropdownItem = "Aggregate key single file");
		}

		task ("And I get the expected downloaded file name") {
			CP2ActivationKeys.viewDownloadedLicenseFile(downloadedFileName = "activation-key-multiple-products-7.3-2022fifaworldcupqatar-fanid.xml");
		}

		task ("When I click at the 'Individual keys multiple files' option") {
			Portal.CP2ActivationKeys.clickAtDropdownItem(dropdownItem = "Individual keys multiple files");
		}

		task ("And I get the expected downloaded file name") {
			CP2ActivationKeys.viewDownloadedLicenseFile(downloadedFileName = "activation-key-2022fifaworldcupqatar-fanid.xml");
		}
	}

}