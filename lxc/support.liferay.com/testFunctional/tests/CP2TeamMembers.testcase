definition {

	property test.env = "uat";
	property testray.main.component.name = "Customer Portal 2.0";

	setUp {
		Utils.launchUatPage();

		Login.loginAsAdminUser();
	}

	@description = "Automation ID: LRQA-79218 | Test Summary: Verify if when a Project has reached or is reaching the limit, the ticket requestor role should be disabled in drop down"
	@priority = "4"
	test IfMaxRequestorDropDisabled {
		task ("Given team members page is open") {
			HomePage.searchProject(projectName = "2022 FIFA World Cup Qatar - FAN ID");

			Portal.CustomerPortal.enterOnProject(title = "2022 FIFA World Cup Qatar - FAN ID");

			Portal.CP2NavigationMenu.goToTeamMembers();

			Portal.CustomerPortal.clickAtButton(text = "Invite");
		}

		task ("When I invite the users to the project") {
			CP2TeamMembers.addFieldsTeamMembers(
				rowEmailList = "test1,test2,test3,test4,test5,test6,test7",
				rowRole = "Requester");
		}

		task ("Then the dropdown option should be disabled") {
			Default.AssertElementPresent(locator1 = "CP2TeamMembers#ROLE_INVITE");
		}
	}

}