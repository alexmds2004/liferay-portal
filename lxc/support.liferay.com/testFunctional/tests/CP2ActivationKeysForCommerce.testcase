definition {

	property test.env = "uat";
	property testray.main.component.name = "Customer Portal 2.0";

	setUp {
		Utils.launchUatPage();

		Login.loginAsAdminUser();
	}

	@description = "Automation ID: LRQA-79267 | Test Summary: Verify that when the DXP version of the project is below 7.3, clicking on subscriptions the user can select from a drop-down list their Commerce subscriptions"
	@priority = 5
	test CanViewTheDropdownListWhenTheVersionIsLowerThanTheCurrentOne {
		task ("Assert that project has DXP 7.0") {
			HomePage.searchProject(projectName = "Avangrid Portals");

			Portal.CustomerPortal.enterOnProject(title = "Avangrid Portals");

			Portal.CP2NavigationMenu.goToProductActivation();

			Portal.CP2NavigationMenu.clickOnProductButton(product = "DXP");

			Portal.CP2ActivationKeys.assertDropdownSelection(option = "7.0");
		}

		task ("Assert Access to Commerce Activation Key Page") {
			Portal.CP2NavigationMenu.clickOnProductButton(product = "Commerce");

			Portal.CustomerPortal.assertPageTitle(title = "Activation Keys");

			CP2ActivationKeys.assertSubscriptionDropdown(subscription = "Production");

			CP2ActivationKeys.assertSubscriptionTermDropdown(subscriptionTerm = "Aug 23, 2022 - Aug 31, 2023");
		}

		task ("Assert that project has DXP 7.1") {
			Portal.CP2Utils.clickBreadcrumb(project = "NASA ICE");

			Portal.CP2NavigationMenu.clickOnProductButton(product = "DXP");

			Portal.CP2ActivationKeys.assertDropdownSelection(option = "7.1");
		}

		task ("Assert Access to Commerce Activation Key Page") {
			Portal.CP2NavigationMenu.clickOnProductButton(product = "Commerce");

			Portal.CustomerPortal.assertPageTitle(title = "Activation Keys");

			CP2ActivationKeys.assertSubscriptionDropdown(subscription = "Production");

			CP2ActivationKeys.assertSubscriptionTermDropdown(subscriptionTerm = "Feb 1, 2023 - Feb 1, 2024");
		}

		task ("Assert that project has DXP 7.2") {
			Portal.CP2Utils.clickBreadcrumb(project = "Liferay, Inc.");

			Portal.CP2NavigationMenu.clickOnProductButton(product = "DXP");

			Portal.CP2ActivationKeys.assertDropdownSelection(option = "7.2");
		}

		task ("Assert Access to Commerce Activation Key Page") {
			Portal.CP2NavigationMenu.clickOnProductButton(product = "Commerce");

			Portal.CustomerPortal.assertPageTitle(title = "Activation Keys");

			CP2ActivationKeys.assertSubscriptionDropdown(subscription = "Development");

			CP2ActivationKeys.assertSubscriptionTermDropdown(subscriptionTerm = "Oct 15, 2020 - Oct 14, 2021");
		}

		task ("Assert that project has DXP 7.3") {
			Portal.CP2Utils.clickBreadcrumb(project = "Maharashtra Tourism Website Revamp");

			Portal.CP2NavigationMenu.clickOnProductButton(product = "DXP");

			Portal.CP2ActivationKeys.assertDropdownSelection(option = "7.3");
		}

		task ("Assert Commerce Activation Key Page") {
			Portal.CP2NavigationMenu.clickOnProductButton(product = "Commerce");

			Portal.CustomerPortal.assertPageTitle(title = "Activation Keys");

			var versions = "DXP 7.4 GA1+,DXP 7.3 FP3/SP2+,DXP 7.3 FP2/SP1";
			var instructions = "All Commerce modules are enabled by default.,Commerce is activated using a portal property.,Commerce requires an activation key.";

			Portal.CP2ActivationKeys.assertInstructionsTable(textList = ${versions});

			Portal.CP2ActivationKeys.assertInstructionsTable(textList = ${instructions});
		}

		task ("Assert that project has DXP 7.4") {
			Portal.CP2Utils.clickBreadcrumb(project = "2022 FIFA World Cup Qatar - FAN ID");

			Portal.CP2NavigationMenu.clickOnProductButton(product = "DXP");

			Portal.CP2ActivationKeys.assertDropdownSelection(option = "7.4");
		}

		task ("Assert Commerce Activation Key Page") {
			Portal.CP2NavigationMenu.clickOnProductButton(product = "Commerce");

			Portal.CustomerPortal.assertPageTitle(title = "Activation Keys");

			var versions = "DXP 7.4 GA1+,DXP 7.3 FP3/SP2+,DXP 7.3 FP2/SP1";
			var instructions = "All Commerce modules are enabled by default.,Commerce is activated using a portal property.,Commerce requires an activation key.";

			Portal.CP2ActivationKeys.assertInstructionsTable(textList = ${versions});

			Portal.CP2ActivationKeys.assertInstructionsTable(textList = ${instructions});
		}
	}

}