definition {

	property test.env = "uat";
	property testray.main.component.name = "Customer Portal 2.0";

	setUp {
		Utils.launchUatPage();

		Login.loginAsAdminUser();
	}

	@description = "Automation ID: LRQA-79355 | Test Summary: Verify that after clicking the Download Key button the user download the appropriate Elasticsearch license"
	@priority = 4
	test CanDownloadTheKeyWhenASubscriptionIsSelected {
		task ("Given I go to the test account") {
			HomePage.searchProject(projectName = "Avangrid Portals");

			Portal.CustomerPortal.enterOnProject(title = "Avangrid Portals");
		}

		task ("And I click on DXP product") {
			Portal.CP2NavigationMenu.goToProductActivation();

			Portal.CP2NavigationMenu.clickOnProductButton(product = "Enterprise Search");
		}

		task ("When I click at the download button") {
			Portal.CustomerPortal.clickAtButton(text = "Download Key");
		}

		task ("Then the license must be properly downloaded") {
			CP2ActivationKeys.viewDownloadedLicenseFile(downloadedFileName = "activation-key-dxpdevelopment-7.0-avangridportals.xml");
		}
	}

}