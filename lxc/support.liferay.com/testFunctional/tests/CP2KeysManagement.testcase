definition {

	property test.env = "uat";
	property testray.main.component.name = "Customer Portal 2.0";

	setUp {
		Utils.launchUatPage();

		Login.loginAsAdminUser();
	}

	@description = "Automation ID: LRQA-79291 | Test Summary: Verify that when the user clicks on the download icon a key is downloaded"
	@priority = "4"
	test CanViewTheActivationKeyDownload {
		task ("Given I go to the test account") {
			HomePage.searchProject(projectName = "NASA ICE");

			Portal.CustomerPortal.enterOnProject(title = "NASA ICE");
		}

		task ("And I click on DXP product") {
			Portal.CP2NavigationMenu.goToProductActivation();

			Portal.CP2NavigationMenu.clickOnProductButton(product = "DXP");
		}

		task ("When I click on the download button at the Activation Keys Table") {
			Portal.CP2ActivationKeys.clickAtDownloadButton(entitlementName = "NASA ICE");
		}

		task ("Then the activation key file should be properly downloaded") {
			Portal.ImportExport.assertDownloadedFileName(downloadedFile = "activation-key-dxpproduction-7.4-nasaice.xml");
		}
	}

}