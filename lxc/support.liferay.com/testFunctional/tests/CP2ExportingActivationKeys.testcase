definition {

	property test.env = "uat";
	property testray.main.component.name = "Customer Portal 2.0";

	setUp {
		Utils.launchUatPage();

		Login.loginAsAdminUser();
	}

    @description = "LRQA-79292 - Verify if the option to 'Export all key details (csv)' successfully downloads keys and shows a success message"
	@priority = "3"
	test SuccessMessageWhenKeyIsDownloaded {
		task ("Given I go to the test account") {
            HomePage.searchProject(projectName = "NASA ICE");

			Portal.CustomerPortal.enterOnProject(title = "NASA ICE");
		}

		task ("And I click on DXP product") {
			Portal.CP2NavigationMenu.goToProductActivation();

			Portal.CP2NavigationMenu.clickOnProductButton(product = "DXP");
		}

		task ("Then the user is able to export activation keys and receives a success message") {
			Portal.CP2ActivationKeys.exportAllKeyDetails(fileName = "activation-keys.csv");
		}
	}
}