definition {

	@summary = "Clear the card status"
	macro clearActivationStatus {
		var key_status = ${status};

		Portal.ApplicationsMenu.gotoPortlet(
			category = "Object",
			panel = "Control Panel",
			portlet = "Account Subscription Groups");

		Portal.Search.searchCP(searchTerm = ${key_status});

		Default.Click(
			key_accountName = ${key_status},
			locator1 = "CP2Utils#KORONEIKI_ACCOUNT_ELLIPSIS_BUTTON");

		Portal.MenuItem.click(menuItem = "View");

		Portal.CP2DXPCloudSetup.typeSetupDXPCloudInfoFields(
			label = "activationStatus",
			value = "");

		Default.Click(locator1 = "Portal.Button#SAVE");

		Portal.Alert.viewSuccessMessage();
	}

	@summary = "Delete the entries created on specific objects"
	macro deleteSpecificObjectEntry {
		Portal.ApplicationsMenu.gotoPortlet(
			category = "Object",
			panel = "Control Panel",
			portlet = ${portlet});

		Default.Click(
			key_accountName = ${entry},
			locator1 = "CP2Utils#KORONEIKI_ACCOUNT_ELLIPSIS_BUTTON");

		Portal.MenuItem.click(menuItem = "Delete");

		Default.AssertConfirm(value1 = "It may affect many records. Are you sure you want to delete this entry?");
	}

	macro getValueFieldKoroneikiByAccountName {
		var key_label = ${field};

		Portal.ApplicationsMenu.gotoPortlet(
			category = "Object",
			panel = "Control Panel",
			portlet = "Koroneiki Accounts");

		CP2Utils.viewCPObjectCustomInfoByAccountName(accountName = ${accountName});

		Default.WaitForElementPresent(locator1 = "CP2Utils#FIELDS_KORONEIKI_VALUE");

		var value = selenium.getElementValue("CP2Utils#FIELDS_KORONEIKI_VALUE");

		return ${value};
	}

	@summary = "Searching for a specific project"
	macro viewCPObjectCustomInfoByAccountName {
		Default.Type(
			locator1 = "CP2Utils#SEARCH",
			value1 = ${accountName});

		Default.KeyPress(
			locator1 = "CP2Utils#SEARCH",
			value1 = "\ENTER");

		Default.Click(
			key_accountName = ${accountName},
			locator1 = "CP2Utils#KORONEIKI_ACCOUNT_ELLIPSIS_BUTTON");

		Portal.MenuItem.click(menuItem = "View");
	}

}