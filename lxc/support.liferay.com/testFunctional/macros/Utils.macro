definition {

	@summary = "Clear the card status"
	macro clearStatus {
		var key_status = ${status};

		Portal.ApplicationsMenu.gotoPortlet(
			category = "Object",
			panel = "Control Panel",
			portlet = "Account Subscription Groups");

		Portal.Search.searchCP(searchTerm = ${key_status});

		if (Default.IsElementPresent(key_accountName = ${key_status}, locator1 = "Utils#KORONEIKI_ACCOUNT_ELLIPSIS_BUTTON")) {
			Default.Click(
				key_accountName = ${key_status},
				locator1 = "Utils#KORONEIKI_ACCOUNT_ELLIPSIS_BUTTON");

			Portal.MenuItem.click(menuItem = "View");

			Portal.CP2DXPCloudSetup.typeSetupDXPCloudInfoFields(
				label = "activationStatus",
				value = "");

			Default.Click(locator1 = "Portal.Button#SAVE");
		}
	}

	@summary = "Delete the entries created on specific objects"
	macro deleteSpecificObjectEntry {
		Portal.ApplicationsMenu.gotoPortlet(
			category = "Object",
			panel = "Control Panel",
			portlet = ${portlet});

		Portal.Search.searchCP(searchTerm = ${entry});

		if (Default.IsElementPresent(key_accountName = ${entry}, locator1 = "Utils#KORONEIKI_ACCOUNT_ELLIPSIS_BUTTON")) {
			Default.Click(
				key_accountName = ${entry},
				locator1 = "Utils#KORONEIKI_ACCOUNT_ELLIPSIS_BUTTON");

			MenuItem.clickNoError(menuItem = "Delete");

			Default.AssertConfirm.waitForConfirmation(value1 = "It may affect many records. Are you sure you want to delete this entry?");

			Portal.Alert.viewSuccessMessage();
		}
	}

	macro getValueFieldKoroneikiByAccountName {
		var key_label = ${field};

		Portal.ApplicationsMenu.gotoPortlet(
			category = "Object",
			panel = "Control Panel",
			portlet = "Koroneiki Accounts");

		Utils.viewCPObjectCustomInfoByAccountName(accountName = ${accountName});

		Default.WaitForElementPresent(locator1 = "Utils#FIELDS_KORONEIKI_VALUE");

		var value = selenium.getElementValue("Utils#FIELDS_KORONEIKI_VALUE");

		return ${value};
	}

	@summary = "Launching UAT page"
	macro launchUatPage {
		var portal = PropsUtil.get("portal.url");

		Default.Open(locator1 = "${portal}/en/web/customer-portal");
	}

	@summary = "Searching for a specific account"
	macro viewCPObjectCustomInfoByAccountName {
		Default.Type(
			locator1 = "Utils#SEARCH",
			value1 = ${accountName});

		Default.KeyPress(
			locator1 = "Utils#SEARCH",
			value1 = "\ENTER");

		Default.Click(
			key_accountName = ${accountName},
			locator1 = "Utils#KORONEIKI_ACCOUNT_ELLIPSIS_BUTTON");

		Portal.MenuItem.click(menuItem = "View");
	}

}