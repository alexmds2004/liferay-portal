definition {

	@summary = "Making sure activation key is not available"
	macro assertActivationKeyNotPresent {
		Default.AssertElementNotPresent(
			key_text = ${environmentName},
			locator1 = "Portal.CP2ActivationKeys#RESPONSIVE_TABLE");
	}

	@summary = "Making sure the subscription field has options"
	macro assertSubscriptionDropdown {
		Default.WaitForVisible(
			key_subscription = ${subscription},
			locator1 = "CP2ActivationKeys#SUBSCRIPTION");

		Default.AssertVisible(
			key_subscription = ${subscription},
			locator1 = "CP2ActivationKeys#SUBSCRIPTION");
	}

	@summary = "Making sure the subscription term field has options"
	macro assertSubscriptionTermDropdown {
		Default.WaitForVisible(
			key_subscriptionTerm = ${subscriptionTerm},
			locator1 = "CP2ActivationKeys#SUBSCRIPTION_TERM");

		Default.AssertVisible(
			key_subscriptionTerm = ${subscriptionTerm},
			locator1 = "CP2ActivationKeys#SUBSCRIPTION_TERM");
	}

	@summary = "Deactivating an existing key by the environment name"
	macro deactivateExistingKey {
		Portal.CP2ActivationKeys.selectKeyCheckboxByEnvironmentName(key_environmentName = ${environmentName});

		Portal.Button.click(button = "Deactivate");

		Portal.Button.click(button = "Confirm Deactivate Keys");

		Portal.Button.click(button = "Continue");

		Alert.viewSuccessMessage();
	}

	@summary = "Downloading an activation key from the open modal window"
	macro downloadActivationKeyFromModal {
		Default.Click(
			key_buttonName = "Download Key",
			locator1 = "CP2ActivationKeys#MODAL_BUTTON");

		Portal.Alert.viewSuccessMessage();
	}

	@summary = "Generating a new activation key"
	macro generateNewKey {
		if (!(isSet(key_text))) {
			var key_text = "";
		}

		Default.WaitForVisible(locator1 = "Portal.CP2ActivationKeys#RESPONSIVE_TABLE");

		Default.Click.pauseClickAt(
			key_text = "Actions",
			locator1 = "Portal.CustomerPortalSite#ANY_BUTTON");

		Default.Click.pauseClickAt(
			key_dropdownItem = "Generate New",
			locator1 = "Portal.CP2ActivationKeys#DROPDOWN_ITEM_BUTTON");

		Portal.CP2ActivationKeys.selectGenerateActivationKeyOptionByField(
			field = "Key Type",
			option = "Backup (Production)");

		var key_position = 1;

		Portal.CP2ActivationKeys.selectSubscription(position = ${key_position});

		Portal.CustomerPortal.clickAtButton(text = "Next");

		Portal.CP2ActivationKeys.fulfillGenerateActivationKeyTextField(
			content = ${environmentName},
			field = "Environment Name");

		Portal.CP2ActivationKeys.fulfillGenerateActivationKeyTextField(
			content = "localhost",
			field = "Host Name");

		Portal.CustomerPortal.clickAtButton(text = "Generate 1 Key");

		Alert.viewSuccessMessage();
	}

	@summary = "Searches for an activation key"
	macro searchActivationKey {
		Default.WaitForElementPresent(locator1 = "CP2ActivationKeys#SEARCH_FIELD");

		Default.Type(
			locator1 = "CP2ActivationKeys#SEARCH_FIELD",
			value1 = ${searchTerm});

		Default.KeyPress(
			locator1 = "CP2ActivationKeys#SEARCH_FIELD",
			value1 = "\ENTER");
	}

	@summary = "Checking if activation key details are shown"
	macro viewActivationKeyDetails {
		Default.WaitForPageLoad();

		CP2ActivationKeys.searchActivationKey(searchTerm = ${environmentName});

		Default.WaitForVisible(
			key_text = ${environmentName},
			locator1 = "Portal.CP2ActivationKeys#RESPONSIVE_TABLE");

		Default.Click(
			key_text = ${environmentName},
			locator1 = "Portal.CP2ActivationKeys#RESPONSIVE_TABLE");

		Default.AssertElementPresent(
			key_environmentName = ${environmentName},
			locator1 = "Portal.CP2ActivationKeys#KEY_DETAILS_MODAL");
	}

	@summary = "I should be able to view the downloaded license file"
	macro viewDownloadedLicenseFile {
		echo("Expected file name: ${downloadedFileName}");

		var tempDir = PropsUtil.get("output.dir.name");

		var downloadedFilePath = "${tempDir}/${downloadedFileName}";

		var fileExists = FileUtil.exists(${downloadedFilePath});

		if (${fileExists} == "true") {
			echo("File named ${downloadedFileName} was downloaded.");
		}
	}

	macro clickAtDownloadButton {
		var key_entitlementName = ${entitlementName};

		Default.WaitForElementPresent(locator1 = "Portal.CP2ActivationKeys#TABLES_DOWNLOAD_BUTTON");

		Default.Click(locator1 = "Portal.CP2ActivationKeys#TABLES_DOWNLOAD_BUTTON");

		Default.DownloadTempFile();
	}

}