definition {

	@summary = "Invite several users in the team members"
	macro addFieldsTeamMembers {
		if (!(isSet(position))) {
			var position = 0;
		}

		for (var rowEmail : list ${rowEmailList}) {
			if (isSet(addMembers) && (${position} != 0)) {
				Default.Click(locator1 = "Portal.CP2TeamMembers#ADD_MORE_MEMBERS");
			}

			Default.Type(
				key_fieldNumber = ${position},
				locator1 = "Portal.CP2TeamMembers#EMAIL_FIELD",
				value1 = "${rowEmail}@liferay.com");

			Default.Select(
				key_rowNumber = ${position},
				locator1 = "Portal.CP2TeamMembers#ROLE_SELECT",
				value1 = ${rowRole});

			var position = ${position} + 1;
		}
	}

	@summary = "Assert role status"
	macro assertThatRoleIsDisabled {
		Default.AssertElementPresent(
			key_number = ${position},
			locator1 = "CP2TeamMembers#ROLE_DISABLED",
			value1 = ${role});
	}

	@summary = "Send invitation and assert succes message"
	macro sendInvitation {
		Portal.CustomerPortal.clickAtButton(text = "Send Invitations");

		Alert.viewSuccessMessage();
	}

}