definition {

	@summary = "Performing login process"
	macro _signIn {
		if (${userRole} == "admin") {
			var userEmailAddress = PropsUtil.get("test.this.cp.test.account.modl.admin.login");
			var userPassword = PropsUtil.getEnvironmentVariable("MODL_CUSTOMER_USERS_PASSWORD");
		}

		Default.WaitForElementPresent(locator1 = "CP2Utils#EMAIL_ADDRESS");

		Default.Type(
			locator1 = "CP2Utils#EMAIL_ADDRESS",
			value1 = ${userEmailAddress});

		Default.Type(
			locator1 = "CP2Utils#PASSWORD",
			value1 = ${userPassword});

		Default.Click(locator1 = "CP2Utils#SIGN_IN_BUTTON");

		Default.WaitForElementNotPresent(locator1 = "CP2Utils#SIGN_IN_BUTTON");

		Default.WaitForVisible(locator1 = "HomePage#SEARCH_BAR");
	}

	@summary = "Log in to the website as admin user"
	macro loginAsAdminUser {
		Login._signIn(userRole = "admin");
	}

}