definition {

	macro loginOktaToUpdateCP {
		var oktaURL = PropsUtil.get("okta.liferay.login.dev.url");
		var oktaUserEmail = PropsUtil.get("okta.user.email.address");
		var oktaUserPassword = PropsUtil.getEnvironmentVariable("OKTA_MODL_USER_PASSWORD");

		Portal.Open.openInTheNewTab(locator1 = ${oktaURL});

		Default.Type(
			locator1 = "OktaLogin#EMAIL_ADDRESS_FIELD",
			value1 = ${oktaUserEmail});

		Default.Type(
			locator1 = "OktaLogin#PASSWORD_FIELD",
			value1 = ${oktaUserPassword});

		Default.Click(locator1 = "OktaLogin#SIGN_IN_BUTTON");

		Default.WaitForElementPresent(locator1 = "Portal.CustomerPortalSite#LIFERAY_SITE");

		Portal.Navigator.closeWindow();
	}

}