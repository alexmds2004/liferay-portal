<html>
<head>
<title>CP2Utils</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">CP2Utils</td></tr>
</thead>

<tbody>
<tr>
	<td>SEARCH</td>
	<td>//div[contains(@class,'control-menu-container')]/parent::div//input[@placeholder='Search']</td>
	<td></td>
</tr>
<tr>
	<td>KORONEIKI_ACCOUNT_ELLIPSIS_BUTTON</td>
	<td>//*[text()='${key_accountName}']/parent::*//following-sibling::*[contains(@class, 'item-actions')]//*[@type='button']</td>
	<td></td>
</tr>
<tr>
	<td>FIELDS_KORONEIKI_VALUE</td>
	<td>//*[@class='ddm-label' and text()='${key_label}']/parent::*//input[@type='text']</td>
	<td></td>
</tr>

<!-- LOGIN FIELDS -->

<tr>
	<td>SIGN_IN_BUTTON</td>
	<td>//button[contains(.,'Sign In')] | //input[@value='Sign In']</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>