definition {

	@summary = "Returns the current date and time"
	macro getSystemDateAndTime {
		var currentDateAndTime = DateUtil.getFormattedCurrentDate("MMM dd, yyyy HH:mm");

		static var dateAndTime = ${currentDateAndTime};

		return ${dateAndTime};
	}

	@summary = "Launching UAT page"
	macro launchUatPage {
		var portal = PropsUtil.get("portal.url");

		Default.Open(locator1 = ${portal});
	}

	@summary = "Deletes object entries which are no longer needed"
	macro tearDownObjectEntries {
		Utils.launchUatPage();

		Portal.ApplicationsMenu.gotoPortlet(
			category = "Custom Apps",
			panel = "Applications",
			portlet = ${objectPluralLabel});

		ObjectsAdmin.searchEntry(inputText = ${entryText});

		ObjectsAdmin.waitForObjectPageLoad();

		while ((Default.IsElementPresent(key_text = ${entryText}, locator1 = "ObjectsAdmin#DROPDOWN_BUTTON")) && (maxIterations = "50")) {
			ObjectsAdmin.deleteEntry(inputText = ${entryText});
		}
	}

}