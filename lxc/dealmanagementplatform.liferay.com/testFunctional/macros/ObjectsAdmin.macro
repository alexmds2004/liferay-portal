definition {

	@summary = "Creates a VC_Address entry"
	macro addVCAddressEntry {
		Default.Click(locator1 = "Portal.Button#PLUS");

		if (isSet(address)) {
			Default.Type(
				key_text = "Address",
				locator1 = "Portal.TextInput#ANY",
				value1 = ${address});
		}

		if (isSet(apartmentNumber)) {
			Default.Type(
				key_text = "Apartment number",
				locator1 = "Portal.TextInput#ANY",
				value1 = ${apartmentNumber});
		}

		if (isSet(city)) {
			Default.Type(
				key_text = "City",
				locator1 = "Portal.TextInput#ANY",
				value1 = ${city});
		}

		if (isSet(country)) {
			Default.Type(
				key_text = "Country",
				locator1 = "Portal.TextInput#ANY",
				value1 = ${country});
		}

		if (isSet(postalCode)) {
			Default.Type(
				key_text = "Postal Code",
				locator1 = "Portal.TextInput#ANY",
				value1 = ${postalCode});
		}

		Default.Click(
			key_text = "Save",
			locator1 = "Portal.Button#ANY");

		Portal.Alert.viewSuccessMessage();

		Default.Click(locator1 = "Portal.Form#FORM_BACK_BUTTON");
	}

	@summary = "Creates a VC_Contact entry"
	macro addVCContactEntry {
		Default.Click(locator1 = "Portal.Button#PLUS");

		if (isSet(contactPerson)) {
			Default.Type(
				key_text = "Contact Person",
				locator1 = "Portal.TextInput#ANY",
				value1 = ${contactPerson});
		}

		if (isSet(email)) {
			Default.Type(
				key_text = "E-Mail",
				locator1 = "Portal.TextInput#ANY",
				value1 = ${email});
		}

		if (isSet(mobileNumber)) {
			Default.Type(
				key_text = "Mobile Number",
				locator1 = "Portal.TextInput#ANY",
				value1 = ${mobileNumber});
		}

		if (isSet(officeNumber)) {
			Default.Type(
				key_text = "Office Number",
				locator1 = "Portal.TextInput#ANY",
				value1 = ${officeNumber});
		}

		Default.Click(
			key_text = "Save",
			locator1 = "Portal.Button#ANY");

		Portal.Alert.viewSuccessMessage();

		Default.Click(locator1 = "Portal.Form#FORM_BACK_BUTTON");
	}

	@summary = "Creates a VC_User entry"
	macro addVCUserEntry {
		Default.Click(locator1 = "Portal.Button#PLUS");

		if (isSet(notificationEventsFirstName)) {
			Default.Type(
				key_text = "Notification Events First Name",
				locator1 = "Portal.TextInput#ANY",
				value1 = ${notificationEventsFirstName});
		}

		if (isSet(contact)) {
			Default.Type(
				key_text = "Contact",
				locator1 = "Portal.TextInput#ANY",
				value1 = ${contact});

			Default.Click(locator1 = "ObjectsAdmin#AUTOCOMPLETE_DROPDOWN_ITEM");
		}

		if (isSet(permanentResidenceAddress)) {
			Default.Type(
				key_text = "Permanent Residence Address",
				locator1 = "Portal.TextInput#ANY",
				value1 = ${permanentResidenceAddress});

			Default.Click(locator1 = "ObjectsAdmin#AUTOCOMPLETE_DROPDOWN_ITEM");
		}

		if (isSet(notificationEventsEmail)) {
			Default.Type(
				key_text = "Notification Events Email",
				locator1 = "Portal.TextInput#ANY",
				value1 = ${notificationEventsEmail});
		}

		if (isSet(complianceState)) {
			Default.Click(
				key_fieldName = "complianceState",
				locator1 = "ObjectsAdmin#SELECT_FIELD");

			Default.Click(
				key_dropdownOption = ${complianceState},
				locator1 = "ObjectsAdmin#FORM_DROPDOWN_OPTION");
		}

		if (isSet(noticesContact)) {
			Default.Type(
				key_text = "Notices Contact",
				locator1 = "Portal.TextInput#ANY",
				value1 = ${noticesContact});

			Default.Click(locator1 = "ObjectsAdmin#AUTOCOMPLETE_DROPDOWN_ITEM");
		}

		if (isSet(noticesAddress)) {
			Default.Type(
				key_text = "Notices Address",
				locator1 = "Portal.TextInput#ANY",
				value1 = ${noticesAddress});

			Default.Click(locator1 = "ObjectsAdmin#AUTOCOMPLETE_DROPDOWN_ITEM");
		}

		if (isSet(state)) {
			Default.Click(
				key_fieldName = "state",
				locator1 = "ObjectsAdmin#SELECT_FIELD");

			Default.Click(
				key_dropdownOption = ${state},
				locator1 = "ObjectsAdmin#FORM_DROPDOWN_OPTION");
		}

		Default.Click(
			key_text = "Save",
			locator1 = "Portal.Button#ANY");

		Portal.Alert.viewSuccessMessage();

		Default.Click(locator1 = "Portal.Form#FORM_BACK_BUTTON");
	}

	@summary = "Ensures that an object entry is visible in the objects table"
	macro assertObjectEntryVisible {
		Default.WaitForElementPresent(
			key_rowItem = ${rowItem},
			locator1 = "ObjectsAdmin#TABLE_ROW");

		Default.AssertVisible(
			key_rowItem = ${rowItem},
			locator1 = "ObjectsAdmin#TABLE_ROW");
	}

}