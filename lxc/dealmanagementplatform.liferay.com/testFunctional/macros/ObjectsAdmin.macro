definition {

	@summary = "Creates a VC_Address entry"
	macro addVCAddressEntry {
		Default.Click(locator1 = "Portal.Button#PLUS");

		ObjectsAdmin.fillVCAddressForm(
			setAddress = ${address},
			setApartmentNumber = ${apartmentNumber},
			setCity = ${city},
			setCountry = ${country},
			setPostalCode = ${postalCode});

		Portal.Button.clickSave();

		Portal.Alert.viewSuccessMessage();

		ObjectsAdmin.exitEntry();
	}

	@summary = "Creates a VC_Contact entry"
	macro addVCContactEntry {
		Default.Click(locator1 = "Portal.Button#PLUS");

		ObjectsAdmin.fillVCContactForm(
			setContactPerson = ${contactPerson},
			setEmail = ${email},
			setMobileNumber = ${mobileNumber},
			setOfficeNumber = ${officeNumber});

		Portal.Button.clickSave();

		Portal.Alert.viewSuccessMessage();

		ObjectsAdmin.exitEntry();
	}

	@summary = "Creates a VC_User entry"
	macro addVCUserEntry {
		Default.Click(locator1 = "Portal.Button#PLUS");

		ObjectsAdmin.fillVCUserForm(
			setComplianceState = ${complianceState},
			setContact = ${contact},
			setNoticesAddress = ${noticesAddress},
			setNoticesContact = ${noticesContact},
			setNotificationEventsEmail = ${notificationEventsEmail},
			setNotificationEventsFirstName = ${notificationEventsFirstName},
			setPermanentResidenceAddress = ${permanentResidenceAddress},
			setState = ${state});

		Portal.Button.clickSave();

		Portal.Alert.viewSuccessMessage();

		ObjectsAdmin.exitEntry();
	}

	@summary = "Ensures that an object entry is visible in the objects table"
	macro assertObjectEntryVisible {
		Default.WaitForElementPresent(
			key_rowItem = ${rowItem},
			locator1 = "ObjectsAdmin#TABLE_ROW");

		Default.AssertVisible(
			key_rowItem = ${rowItem},
			locator1 = "ObjectsAdmin#TABLE_ROW");
	}

	@summary = "Deletes an object entry"
	macro deleteEntry {
		Default.Click(
			key_text = ${inputText},
			locator1 = "ObjectsAdmin#DROPDOWN_BUTTON");

		Default.Click(
			key_menuItem = "Delete",
			locator1 = "ObjectsAdmin#MENU_ITEM");

		Default.Confirm.acceptAlert();

		ObjectsAdmin.waitForObjectPageLoad();
	}

	@summary = "Updates a VC_User entry"
	macro editVCUserEntry {
		ObjectsAdmin.openEntry(entryText = ${inputText});

		ObjectsAdmin.fillVCUserForm(
			setComplianceState = ${complianceState},
			setContact = ${contact},
			setNoticesAddress = ${noticesAddress},
			setNoticesContact = ${noticesContact},
			setNotificationEventsEmail = ${notificationEventsEmail},
			setNotificationEventsFirstName = ${notificationEventsFirstName},
			setPermanentResidenceAddress = ${permanentResidenceAddress},
			setState = ${state});

		Portal.Button.clickSave();

		Portal.Alert.viewSuccessMessage();

		ObjectsAdmin.exitEntry();
	}

	@summary = "Leaves an open object entry"
	macro exitEntry {
		Default.Click(locator1 = "Portal.Form#FORM_BACK_BUTTON");
	}

	@summary = "Fills out a VC_Address form"
	macro fillVCAddressForm {
		if (isSet(setAddress)) {
			Default.Type(
				key_text = "Address",
				locator1 = "Portal.TextInput#ANY",
				value1 = ${setAddress});
		}

		if (isSet(setApartmentNumber)) {
			Default.Type(
				key_text = "Apartment number",
				locator1 = "Portal.TextInput#ANY",
				value1 = ${setApartmentNumber});
		}

		if (isSet(setCity)) {
			Default.Type(
				key_text = "City",
				locator1 = "Portal.TextInput#ANY",
				value1 = ${setCity});
		}

		if (isSet(setCountry)) {
			Default.Type(
				key_text = "Country",
				locator1 = "Portal.TextInput#ANY",
				value1 = ${setCountry});
		}

		if (isSet(setPostalCode)) {
			Default.Type(
				key_text = "Postal Code",
				locator1 = "Portal.TextInput#ANY",
				value1 = ${setPostalCode});
		}
	}

	@summary = "Fills out a VC_Contact form"
	macro fillVCContactForm {
		if (isSet(setContactPerson)) {
			Default.Type(
				key_text = "Contact Person",
				locator1 = "Portal.TextInput#ANY",
				value1 = ${setContactPerson});
		}

		if (isSet(setEmail)) {
			Default.Type(
				key_text = "E-Mail",
				locator1 = "Portal.TextInput#ANY",
				value1 = ${setEmail});
		}

		if (isSet(setMobileNumber)) {
			Default.Type(
				key_text = "Mobile Number",
				locator1 = "Portal.TextInput#ANY",
				value1 = ${setMobileNumber});
		}

		if (isSet(setOfficeNumber)) {
			Default.Type(
				key_text = "Office Number",
				locator1 = "Portal.TextInput#ANY",
				value1 = ${setOfficeNumber});
		}
	}

	@summary = "Fills out a VC_Contact form"
	macro fillVCUserForm {
		if (isSet(setNotificationEventsFirstName)) {
			Default.Type(
				key_text = "Notification Events First Name",
				locator1 = "Portal.TextInput#ANY",
				value1 = ${setNotificationEventsFirstName});
		}

		if (isSet(setContact)) {
			Default.Type(
				key_text = "Contact",
				locator1 = "Portal.TextInput#ANY",
				value1 = ${setContact});

			Default.Click(locator1 = "ObjectsAdmin#AUTOCOMPLETE_DROPDOWN_ITEM");

			Default.WaitForElementNotPresent(locator1 = "ObjectsAdmin#INVALID_FIELD_VALUE");
		}

		if (isSet(setPermanentResidenceAddress)) {
			Default.Type(
				key_text = "Permanent Residence Address",
				locator1 = "Portal.TextInput#ANY",
				value1 = ${setPermanentResidenceAddress});

			Default.Click(locator1 = "ObjectsAdmin#AUTOCOMPLETE_DROPDOWN_ITEM");

			Default.WaitForElementNotPresent(locator1 = "ObjectsAdmin#INVALID_FIELD_VALUE");
		}

		if (isSet(setNotificationEventsEmail)) {
			Default.Type(
				key_text = "Notification Events Email",
				locator1 = "Portal.TextInput#ANY",
				value1 = ${setNotificationEventsEmail});
		}

		if (isSet(setComplianceState)) {
			Default.Click(
				key_fieldName = "complianceState",
				locator1 = "ObjectsAdmin#SELECT_FIELD");

			Default.Click(
				key_menuItem = ${setComplianceState},
				locator1 = "ObjectsAdmin#MENU_ITEM");
		}

		if (isSet(setNoticesContact)) {
			Default.Type(
				key_text = "Notices Contact",
				locator1 = "Portal.TextInput#ANY",
				value1 = ${setNoticesContact});

			Default.Click(locator1 = "ObjectsAdmin#AUTOCOMPLETE_DROPDOWN_ITEM");

			Default.WaitForElementNotPresent(locator1 = "ObjectsAdmin#INVALID_FIELD_VALUE");
		}

		if (isSet(setNoticesAddress)) {
			Default.Type(
				key_text = "Notices Address",
				locator1 = "Portal.TextInput#ANY",
				value1 = ${setNoticesAddress});

			Default.Click(locator1 = "ObjectsAdmin#AUTOCOMPLETE_DROPDOWN_ITEM");

			Default.WaitForElementNotPresent(locator1 = "ObjectsAdmin#INVALID_FIELD_VALUE");
		}

		if (isSet(setState)) {
			Default.Click(
				key_fieldName = "state",
				locator1 = "ObjectsAdmin#SELECT_FIELD");

			Default.Click(
				key_menuItem = ${setState},
				locator1 = "ObjectsAdmin#MENU_ITEM");
		}
	}

	@summary = "Opens an object entry"
	macro openEntry {
		Default.Click(
			key_text = ${entryText},
			locator1 = "ObjectsAdmin#DROPDOWN_BUTTON");

		Default.Click(
			key_menuItem = "View",
			locator1 = "ObjectsAdmin#MENU_ITEM");
	}

	@summary = "Open object using a filter by searching for the word 'VC'"
	macro openObject {
		ObjectsAdmin.searchEntry(inputText = "VC");

		Default.ScrollWebElementIntoView(
			key_label = ${label},
			locator1 = "Portal.ObjectPortlet#SELECT_OBJECT");

		Portal.ObjectPortlet.selectObject(label = ${label});
	}

	@summary = "Searches for an object entry through search input"
	macro searchEntry {
		Default.Type(
			locator1 = "Portal.TextInput#SEARCH",
			value1 = ${inputText});

		Default.KeyPress(
			locator1 = "Portal.TextInput#SEARCH",
			value1 = "\ENTER");
	}

	@summary = "View if there are relationships present in the relationships tab"
	macro viewObjectRelationships {
		Default.AssertElementPresent(
			key_labelRelationships = ${labelRelationships},
			key_typeRelationships = ${typeRelationships},
			locator1 = "ObjectsAdmin#RELATIONSHIPS_TYPE");
	}

	@summary = "Waits until the object page is loaded"
	macro waitForObjectPageLoad {
		Default.WaitForVisible(locator1 = "ObjectsAdmin#OBJECTS_PAGE_LOADING");

		Default.WaitForElementNotPresent(locator1 = "ObjectsAdmin#OBJECTS_PAGE_LOADING");
	}

}