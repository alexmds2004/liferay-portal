definition {

	@summary = "Creates a VC_Address entry"
	macro addVCAddressEntry {
		Default.Click(locator1 = "Portal.Button#PLUS");

		ObjectsAdmin.fillVCAddressForm(
			setAddress = ${address},
			setApartmentNumber = ${apartmentNumber},
			setCity = ${city},
			setCountry = ${country},
			setPostalCode = ${postalCode});

		General.clickSaveButton();

		Portal.Alert.viewSuccessMessage();

		ObjectsAdmin.exitEntry();
	}

	@summary = "Creates a VC_Contact entry"
	macro addVCContactEntry {
		Default.Click(locator1 = "Portal.Button#PLUS");

		ObjectsAdmin.fillVCContactForm(
			setContactPerson = ${contactPerson},
			setEmail = ${email},
			setMobileNumber = ${mobileNumber},
			setOfficeNumber = ${officeNumber});

		General.clickSaveButton();

		Portal.Alert.viewSuccessMessage();

		ObjectsAdmin.exitEntry();
	}

	@summary = "Creates a VC_User entry"
	macro addVCUserEntry {
		Default.Click(locator1 = "Portal.Button#PLUS");

		ObjectsAdmin.fillVCUserForm(
			setComplianceState = ${complianceState},
			setContact = ${contact},
			setNoticesAddress = ${noticesAddress},
			setNoticesContact = ${noticesContact},
			setNotificationEventsEmail = ${notificationEventsEmail},
			setNotificationEventsFirstName = ${notificationEventsFirstName},
			setPermanentResidenceAddress = ${permanentResidenceAddress},
			setState = ${state});

		General.clickSaveButton();

		Portal.Alert.viewSuccessMessage();

		ObjectsAdmin.exitEntry();
	}

	@summary = "Ensures that an object entry is visible in the objects table"
	macro assertObjectEntryVisible {
		Default.WaitForElementPresent(
			key_rowItem = ${rowItem},
			locator1 = "ObjectsAdmin#TABLE_ROW");

		Default.AssertVisible(
			key_rowItem = ${rowItem},
			locator1 = "ObjectsAdmin#TABLE_ROW");
	}

	@summary = "Updates a VC_User entry"
	macro editVCUserEntry {
		ObjectsAdmin.openEntry(entryText = ${inputText});

		ObjectsAdmin.fillVCUserForm(
			setComplianceState = ${complianceState},
			setContact = ${contact},
			setNoticesAddress = ${noticesAddress},
			setNoticesContact = ${noticesContact},
			setNotificationEventsEmail = ${notificationEventsEmail},
			setNotificationEventsFirstName = ${notificationEventsFirstName},
			setPermanentResidenceAddress = ${permanentResidenceAddress},
			setState = ${state});

		General.clickSaveButton();

		Portal.Alert.viewSuccessMessage();

		ObjectsAdmin.exitEntry();
	}

	@summary = "Leaves an open object entry"
	macro exitEntry {
		Default.Click(locator1 = "Portal.Form#FORM_BACK_BUTTON");
	}

	@summary = "Fills out a VC_Address form"
	macro fillVCAddressForm {
		if (isSet(setAddress)) {
			Default.Type(
				key_text = "Address",
				locator1 = "Portal.TextInput#ANY",
				value1 = ${setAddress});
		}

		if (isSet(setApartmentNumber)) {
			Default.Type(
				key_text = "Apartment number",
				locator1 = "Portal.TextInput#ANY",
				value1 = ${setApartmentNumber});
		}

		if (isSet(setCity)) {
			Default.Type(
				key_text = "City",
				locator1 = "Portal.TextInput#ANY",
				value1 = ${setCity});
		}

		if (isSet(setCountry)) {
			Default.Type(
				key_text = "Country",
				locator1 = "Portal.TextInput#ANY",
				value1 = ${setCountry});
		}

		if (isSet(setPostalCode)) {
			Default.Type(
				key_text = "Postal Code",
				locator1 = "Portal.TextInput#ANY",
				value1 = ${setPostalCode});
		}
	}

	@summary = "Fills out a VC_Contact form"
	macro fillVCContactForm {
		if (isSet(setContactPerson)) {
			Default.Type(
				key_text = "Contact Person",
				locator1 = "Portal.TextInput#ANY",
				value1 = ${setContactPerson});
		}

		if (isSet(setEmail)) {
			Default.Type(
				key_text = "E-Mail",
				locator1 = "Portal.TextInput#ANY",
				value1 = ${setEmail});
		}

		if (isSet(setMobileNumber)) {
			Default.Type(
				key_text = "Mobile Number",
				locator1 = "Portal.TextInput#ANY",
				value1 = ${setMobileNumber});
		}

		if (isSet(setOfficeNumber)) {
			Default.Type(
				key_text = "Office Number",
				locator1 = "Portal.TextInput#ANY",
				value1 = ${setOfficeNumber});
		}
	}

	@summary = "Searches for an object entry through search input"
	macro searchEntry {
		Default.Type(
			locator1 = "Portal.TextInput#SEARCH",
			value1 = ${inputText});

		Default.KeyPress(
			locator1 = "Portal.TextInput#SEARCH",
			value1 = "\ENTER");
	}

}