definition {

	@summary = "Creates a VC_Address entry"
	macro addVCAddressEntry {
		Default.Click(locator1 = "Portal.Button#PLUS");

		if (isSet(address)) {
			Default.Type(
				key_text = "Address",
				locator1 = "Portal.TextInput#ANY",
				value1 = ${address});
		}

		if (isSet(apartmentNumber)) {
			Default.Type(
				key_text = "Apartment number",
				locator1 = "Portal.TextInput#ANY",
				value1 = ${apartmentNumber});
		}

		if (isSet(city)) {
			Default.Type(
				key_text = "City",
				locator1 = "Portal.TextInput#ANY",
				value1 = ${city});
		}

		if (isSet(country)) {
			Default.Type(
				key_text = "Country",
				locator1 = "Portal.TextInput#ANY",
				value1 = ${country});
		}

		if (isSet(postalCode)) {
			Default.Type(
				key_text = "Postal Code",
				locator1 = "Portal.TextInput#ANY",
				value1 = ${postalCode});
		}

		Default.Click(
			key_text = "Save",
			locator1 = "Portal.Button#ANY");

		Portal.Alert.viewSuccessMessage();

		Default.Click(locator1 = "Portal.Form#FORM_BACK_BUTTON");
	}

	@summary = "Creates a VC_Contact entry"
	macro addVCContactEntry {
		Default.Click(locator1 = "Portal.Button#PLUS");

		if (isSet(contactPerson)) {
			Default.Type(
				key_text = "Contact Person",
				locator1 = "Portal.TextInput#ANY",
				value1 = ${contactPerson});
		}

		if (isSet(email)) {
			Default.Type(
				key_text = "E-Mail",
				locator1 = "Portal.TextInput#ANY",
				value1 = ${email});
		}

		if (isSet(mobileNumber)) {
			Default.Type(
				key_text = "Mobile Number",
				locator1 = "Portal.TextInput#ANY",
				value1 = ${mobileNumber});
		}

		if (isSet(officeNumber)) {
			Default.Type(
				key_text = "Office Number",
				locator1 = "Portal.TextInput#ANY",
				value1 = ${officeNumber});
		}

		Default.Click(
			key_text = "Save",
			locator1 = "Portal.Button#ANY");

		Portal.Alert.viewSuccessMessage();

		Default.Click(locator1 = "Portal.Form#FORM_BACK_BUTTON");
	}

}