definition {

	@summary = "Making sure home page elements are present at home page"
	macro viewPageElements {
		if (isSet(headerText)) {
			Default.AssertVisible(
				key_headerText = ${headerText},
				locator1 = "HomePage#HEADER_TEXT");
		}

		Default.AssertElementPresent(locator1 = "HomePage#CONTROL_MENU_NAVIGATION_BAR");
	}

}