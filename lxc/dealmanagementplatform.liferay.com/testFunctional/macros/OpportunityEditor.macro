definition {

	@summary = "Creates a new Sourcing Contract"
	macro createSourcingContract {
		OpportunityEditor.submitCompanyForm();

		OpportunityEditor.submitTypesFormOpportunity();

		OpportunityEditor.submitTypesFormFinancialProduct();

		OpportunityEditor.submitSourcingContractForm();

		Default.WaitForVisible(locator1 = "OpportunityEditor#SUBMISSION_CONFIRMATION_MESSAGE");
	}

	@summary = "Goes to any navigation bar item"
	macro goToNavItem {
		Default.WaitForVisible(
			key_navItem = ${navItem},
			locator1 = "OpportunityEditor#NAV_ITEM");

		Default.Click(
			key_navItem = ${navItem},
			locator1 = "OpportunityEditor#NAV_ITEM");
	}

	@summary = "Selects any tab by name"
	macro selectTab {
		Default.Click(
			key_tabName = ${key_tabName},
			locator1 = "OpportunityEditor#ANY_TAB");
	}

}