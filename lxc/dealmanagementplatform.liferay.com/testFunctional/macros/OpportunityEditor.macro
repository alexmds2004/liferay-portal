definition {

	@summary = "Creates a new Sourcing Contract"
	macro createSourcingContract {
		OpportunityEditor.submitCompanyForm();

		OpportunityEditor.submitTypesFormOpportunity();

		OpportunityEditor.submitTypesFormFinancialProduct();

		OpportunityEditor.submitSourcingContractForm();

		Default.WaitForVisible(locator1 = "OpportunityEditor#SUBMISSION_CONFIRMATION_MESSAGE");
	}

	@summary = "Goes to any navigation bar item"
	macro goToNavItem {
		Default.WaitForVisible(
			key_navItem = ${navItem},
			locator1 = "OpportunityEditor#NAV_ITEM");

		Default.Click(
			key_navItem = ${navItem},
			locator1 = "OpportunityEditor#NAV_ITEM");
	}

	@summary = "Selects any tab by name"
	macro selectTab {
		Default.Click(
			key_tabName = ${key_tabName},
			locator1 = "OpportunityEditor#ANY_TAB");
	}

	@summary = "Submits the form under 'Company' tab"
	macro submitCompanyForm {
		OpportunityEditor.selectTab(key_tabName = "Company");

		OpportunityEditor.selectTab(key_tabName = "Company description");

		Default.Type(
			key_fieldLabel = "Company Name",
			key_indexNumber = 1,
			locator1 = "Portal.TextInput#GENERIC_TEXT_INPUT_N",
			value1 = "VC_CompanyDescription - Company Name");

		Default.Type(
			key_fieldLabel = "Company Description",
			key_indexNumber = 1,
			locator1 = "Portal.TextInput#GENERIC_TEXT_INPUT_N",
			value1 = "VC_CompanyDescription - Company Description");

		OpportunityEditor.submitFormByIndex(index = 4);

		OpportunityEditor.selectTab(key_tabName = "Company Funding");

		Default.Type.sendKeys(
			locator1 = "OpportunityEditor#COMPANY_DESCRIPTION_INPUT_FIELD",
			value1 = "VC_CompanyDescription");

		Portal.ACUtils.waitForScrollDown();

		Default.KeyPress(
			locator1 = "OpportunityEditor#COMPANY_DESCRIPTION_INPUT_FIELD",
			value1 = "\ENTER");

		OpportunityEditor.submitFormByIndex(index = 4);
	}

	@summary = "Clicks at any 'Submit' button by index"
	macro submitFormByIndex {
		Default.Click(
			key_indexNumber = ${index},
			key_text = "Submit",
			locator1 = "Portal.Button#ANY_N");

		Default.WaitForVisible(locator1 = "OpportunityEditor#SUBMISSION_CONFIRMATION_MESSAGE");
	}

	@summary = "Submits the form under 'Sourcing Contract' tab"
	macro submitSourcingContractForm {
		OpportunityEditor.selectTab(key_tabName = "Sourcing Contract");

		var totalText = selenium.getText("OpportunityEditor#INVESTIMENT_OPOTUNITY_ID");

		static var extractedId = StringUtil.extractLast(${totalText}, "ID: ");

		Default.Type(
			key_fieldLabel = "Investment Opportunity ID",
			locator1 = "OpportunityEditor#INPUT_FIELD",
			value1 = ${extractedId});

		Default.KeyPress(
			key_fieldLabel = "Investment Opportunity ID",
			locator1 = "OpportunityEditor#INPUT_FIELD",
			value1 = "\ENTER");
	}

	@summary = "Submits the 'Financial product' form under 'Types' tab"
	macro submitTypesFormFinancialProduct {
		OpportunityEditor.selectTab(key_tabName = "Types");

		OpportunityEditor.selectTab(key_tabName = "Financial product");

		Default.Click(
			key_fieldName = "Product Type",
			locator1 = "OpportunityEditor#SELECT_FIELD");

		Default.Click(
			key_item = "Primary Equity Shares",
			locator1 = "OpportunityEditor#DROPDOWN_ITEM");

		Default.Click(
			key_fieldName = "Opportunity Type",
			locator1 = "OpportunityEditor#SELECT_FIELD");

		Default.Click(
			key_item = "Opportunity Type",
			locator1 = "OpportunityEditor#DROPDOWN_ITEM");

		OpportunityEditor.submitFormByIndex(index = 10);
	}

	@summary = "Submits the 'Opportunity' form under 'Types' tab"
	macro submitTypesFormOpportunity {
		OpportunityEditor.selectTab(key_tabName = "Types");

		OpportunityEditor.selectTab(key_tabName = "Opportunity");

		Default.Type(
			key_fieldLabel = "Investment Opportunity Type",
			locator1 = "Portal.TextInput#GENERIC_TEXT_INPUT",
			value1 = "Opportunity Type");

		Default.KeyPress(
			key_fieldLabel = "Investment Opportunity Type",
			locator1 = "Portal.TextInput#GENERIC_TEXT_INPUT",
			value1 = "\ENTER");

		Default.WaitForVisible(locator1 = "OpportunityEditor#SUBMISSION_CONFIRMATION_MESSAGE");
	}

}