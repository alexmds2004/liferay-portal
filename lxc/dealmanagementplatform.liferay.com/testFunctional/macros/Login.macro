definition {

	@summary = "Perform login process"
	macro _signIn {
		if (${userRole} == "admin") {
			var loginUserEmail = PropsUtil.get("test.this.concluder.test.account.modl.admin.login");
			var loginUserPassword = PropsUtil.getEnvironmentVariable("MODL_CUSTOMER_USERS_PASSWORD");
		}

		Default.WaitForElementPresent(
			fieldName = "login",
			locator1 = "Login#INPUT_FIELD");

		Default.Type(
			fieldName = "login",
			locator1 = "Login#INPUT_FIELD",
			value1 = ${loginUserEmail});

		Default.Type(
			fieldName = "password",
			locator1 = "Login#INPUT_FIELD",
			value1 = ${loginUserPassword});

		Default.Click(
			key_text = "Sign In",
			locator1 = "Portal.Button#ANY");

		Default.WaitForElementNotPresent(
			key_text = "Sign In",
			locator1 = "Portal.Button#ANY");

		Default.WaitForElementPresent(locator1 = "HomePage#LOGIN_CONFIRMATION");
	}

	@summary = "Log in to the website as admin user"
	macro loginAsAdminUser {
		Login._signIn(userRole = "admin");
	}

}