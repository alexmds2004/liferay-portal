definition {

	@summary = "Creates an Investiment Opportunity site"
	macro CreateSite {
		Portal.ApplicationsMenu.gotoPortlet(
			category = "Sites",
			panel = "Control Panel",
			portlet = "Sites");

		Portal.LexiconEntry.gotoAdd();

		Default.Click(
			key_tab = "Custom Site Templates",
			locator1 = "Portal.NavTab#TAB_LINK");

		Default.WaitForVisible(
			key_tab = "Custom Site Templates",
			locator1 = "Portal.NavTab#ACTIVE_TAB_LINK");

		Default.Click(
			key_card = "Investment Opportunity",
			locator1 = "Portal.Card#CARD");

		Default.SelectFrame(locator1 = "Portal.IFrame#MODAL_BODY");

		Portal.PortletEntry.inputName(name = ${siteName});

		Portal.Button.click(button = "Add");

		Default.SelectFrameTop();

		Portal.Alert.viewSuccessMessage();
	}

}