definition {

	@summary = "Goes to the site pages from control panel"
	macro gotoSitePages {
		Portal.ApplicationsMenu.gotoPortlet(
			category = "Sites",
			panel = "Control Panel",
			portlet = "Sites");

		ObjectsAdmin.searchEntry(inputText = ${siteName});

		Portal.LexiconTable.clickEllipsisItem(
			item = "Go to Pages",
			tableEntry = ${siteName});

		Default.SelectWindow.selectPopUp(locator1 = "null");
	}

}