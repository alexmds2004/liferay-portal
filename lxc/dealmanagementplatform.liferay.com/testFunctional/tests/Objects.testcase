definition {

	property test.env = "uat";
	property testray.main.component.name = "Concluder";

	setUp {
		Utils.launchUatPage();

		Login.loginAsAdminUser();

		Utils.getSystemDateAndTime();
	}

	tearDown {
		Utils.tearDownObjectEntries(
			entryText = "EditedName",
			objectPluralLabel = "VC_Users");

		Utils.tearDownObjectEntries(
			entryText = "FirstName",
			objectPluralLabel = "VC_Users");

		Utils.tearDownObjectEntries(
			entryText = "Test Apartment number",
			objectPluralLabel = "VC_Addresses");

		Utils.tearDownObjectEntries(
			entryText = "Test E-Mail",
			objectPluralLabel = "VC_Contacts");
	}

	@description = "Automation ID: LRQA-79179 | Test Summary: Verify that state manager can be updated"
	@priority = 5
	test CanChangeStateManager {
		var firstName = "FirstName - ${dateAndTime}";

		task ("Given a VC_User is created with the state set as 'Basic Information'") {
			Portal.ApplicationsMenu.gotoPortlet(
				category = "Custom Apps",
				panel = "Applications",
				portlet = "VC_Users");

			ObjectsAdmin.addVCUserEntry(
				notificationEventsEmail = "NotificationEventsEmail",
				notificationEventsFirstName = ${firstName},
				state = "Basic Information");
		}

		task ("When the state is updated to 'Account created'") {
			ObjectsAdmin.searchEntry(inputText = ${firstName});

			ObjectsAdmin.editVCUserEntry(
				inputText = ${firstName},
				state = "Account created");
		}

		task ("Then the entry should be visible with the updated state value in VC_Users page") {
			ObjectsAdmin.searchEntry(inputText = ${firstName});

			ObjectsAdmin.assertObjectEntryVisible(rowItem = "Account created");
		}
	}

	@description = "Automation ID: LRQA-79175 | Test Summary: Verify that a VC_User object can be created"
	@priority = 5
	test CanCreateObject {
		var address1 = "Test Address 1 - ${dateAndTime}";
		var email1 = "Test E-Mail 1 - ${dateAndTime}";
		var firstName = "FirstName - ${dateAndTime}";
		var person1 = "Test Contact Person 1 - ${dateAndTime}";

		task ("Given a VC_Address and a VC_Contact are created") {
			Portal.ApplicationsMenu.gotoPortlet(
				category = "Custom Apps",
				panel = "Applications",
				portlet = "VC_Addresses");

			ObjectsAdmin.addVCAddressEntry(
				address = ${address1},
				apartmentNumber = "Test Apartment number 1 - ${dateAndTime}",
				city = "Test City 1",
				country = "Test Country 1",
				postalCode = "Test Postal Code 1");

			Portal.ApplicationsMenu.gotoPortlet(
				category = "Custom Apps",
				panel = "Applications",
				portlet = "VC_Contacts");

			ObjectsAdmin.addVCContactEntry(
				contactPerson = ${person1},
				email = ${email1},
				mobileNumber = "Test Mobile Number 1",
				officeNumber = "Test Office Number 1");
		}

		task ("When a VC_User is created using the information from VC_Address and VC_Contact") {
			Portal.ApplicationsMenu.gotoPortlet(
				category = "Custom Apps",
				panel = "Applications",
				portlet = "VC_Users");

			ObjectsAdmin.addVCUserEntry(
				complianceState = "Compliance in progress",
				contact = ${person1},
				notificationEventsEmail = "NotificationEventsEmail",
				notificationEventsFirstName = ${firstName},
				permanentResidenceAddress = ${address1},
				state = "Basic Information");
		}

		task ("Then the new VC_User entry should be visible in VC_Users page") {
			ObjectsAdmin.searchEntry(inputText = ${firstName});

			ObjectsAdmin.assertObjectEntryVisible(rowItem = ${firstName});
		}
	}

	@description = "Automation ID: LRQA-79177 | Test Summary: Verify that a VC_User object can be deleted"
	@priority = 5
	test CanDeletObject {
		var firstName = "FirstName - ${dateAndTime}";

		task ("Given a VC_User is created") {
			Portal.ApplicationsMenu.gotoPortlet(
				category = "Custom Apps",
				panel = "Applications",
				portlet = "VC_Users");

			ObjectsAdmin.addVCUserEntry(notificationEventsFirstName = ${firstName});
		}

		task ("When the VC_User entry is deleted") {
			ObjectsAdmin.searchEntry(inputText = ${firstName});

			ObjectsAdmin.deleteEntry(inputText = ${firstName});
		}

		task ("Then the entry should not be visible in VC_Users page") {
			ObjectsAdmin.searchEntry(inputText = ${firstName});

			Portal.ObjectAdmin.assertNoResultsWereFound();
		}
	}

	@description = "Automation ID: LRQA-79176 | Test Summary: Verify that a VC_User object can be edited"
	@priority = 5
	test CanEditObject {
		var editedName = "EditedName - ${dateAndTime}";
		var firstName = "FirstName - ${dateAndTime}";

		task ("Given a VC_User is created") {
			Portal.ApplicationsMenu.gotoPortlet(
				category = "Custom Apps",
				panel = "Applications",
				portlet = "VC_Users");

			ObjectsAdmin.addVCUserEntry(notificationEventsFirstName = ${firstName});
		}

		task ("When the 'Notification Events First Name' is changed") {
			ObjectsAdmin.searchEntry(inputText = ${firstName});

			ObjectsAdmin.editVCUserEntry(
				inputText = ${firstName},
				notificationEventsFirstName = ${editedName});
		}

		task ("Then the entry should be visible with the updated 'Notification Events First Name' value in VC_Users page") {
			ObjectsAdmin.searchEntry(inputText = ${editedName});

			ObjectsAdmin.assertObjectEntryVisible(rowItem = ${editedName});
		}
	}

	@description = "Automation ID: LRQA-79180 | Test Summary: Verify that VC_User can have 2 adresses set"
	@priority = 5
	test CanHaveMultipleAdresses {
		var address1 = "Test Address 1 - ${dateAndTime}";
		var address2 = "Test Address 2 - ${dateAndTime}";
		var firstName = "FirstName - ${dateAndTime}";

		task ("Given two VC_Address entries are created") {
			Portal.ApplicationsMenu.gotoPortlet(
				category = "Custom Apps",
				panel = "Applications",
				portlet = "VC_Addresses");

			ObjectsAdmin.addVCAddressEntry(
				address = ${address1},
				apartmentNumber = "Test Apartment number 1 - ${dateAndTime}",
				city = "Test City 1",
				country = "Test Country 1",
				postalCode = "Test Postal Code 1");

			ObjectsAdmin.addVCAddressEntry(
				address = ${address2},
				apartmentNumber = "Test Apartment number 2 - ${dateAndTime}",
				city = "Test City 2",
				country = "Test Country 2",
				postalCode = "Test Postal Code 2");
		}

		task ("When a VC_User is created using both addresses") {
			Portal.ApplicationsMenu.gotoPortlet(
				category = "Custom Apps",
				panel = "Applications",
				portlet = "VC_Users");

			ObjectsAdmin.addVCUserEntry(
				noticesAddress = ${address2},
				notificationEventsFirstName = ${firstName},
				permanentResidenceAddress = ${address1});
		}

		task ("Then the new VC_User entry should be visible in VC_Users page") {
			ObjectsAdmin.searchEntry(inputText = ${firstName});

			ObjectsAdmin.assertObjectEntryVisible(rowItem = ${firstName});
		}
	}

	@description = "Automation ID: LRQA-79461 | Test Summary: Verify that VC_User can have 2 contacts set"
	@priority = 5
	test CanHaveMultipleContacts {
		var firstName = "FirstName - ${dateAndTime}";
		var person1 = "Test Contact Person 1 - ${dateAndTime}";
		var person2 = "Test Contact Person 2 - ${dateAndTime}";

		task ("Given two VC_Contacts entries are created") {
			Portal.ApplicationsMenu.gotoPortlet(
				category = "Custom Apps",
				panel = "Applications",
				portlet = "VC_Contacts");

			ObjectsAdmin.addVCContactEntry(
				contactPerson = ${person1},
				email = "Test E-Mail 1 - ${dateAndTime}",
				mobileNumber = "Test Mobile Number 1",
				officeNumber = "Test Office Number 1");

			ObjectsAdmin.addVCContactEntry(
				contactPerson = ${person2},
				email = "Test E-Mail 2 - ${dateAndTime}",
				mobileNumber = "Test Mobile Number 2",
				officeNumber = "Test Office Number 2");
		}

		task ("When a VC_User is created using both contacts") {
			Portal.ApplicationsMenu.gotoPortlet(
				category = "Custom Apps",
				panel = "Applications",
				portlet = "VC_Users");

			ObjectsAdmin.addVCUserEntry(
				contact = ${person1},
				noticesContact = ${person2},
				notificationEventsFirstName = ${firstName});
		}

		task ("Then the new VC_User entry should be visible in VC_Users page") {
			ObjectsAdmin.searchEntry(inputText = ${firstName});

			ObjectsAdmin.assertObjectEntryVisible(rowItem = ${firstName});
		}
	}

	@description = "Automation ID: LRQA-79462 | Test Summary: Verify that state manager can be set as its current state"
	@priority = 5
	test CanSetSameStateManagerValue {
		var firstName = "FirstName - ${dateAndTime}";

		task ("Given a VC_User is created with two states set") {
			Portal.ApplicationsMenu.gotoPortlet(
				category = "Custom Apps",
				panel = "Applications",
				portlet = "VC_Users");

			ObjectsAdmin.addVCUserEntry(
				complianceState = "Compliance in progress",
				notificationEventsEmail = "NotificationEventsEmail",
				notificationEventsFirstName = ${firstName},
				state = "Basic Information");
		}

		task ("When the two states are set to the same values") {
			ObjectsAdmin.searchEntry(inputText = ${firstName});

			ObjectsAdmin.editVCUserEntry(
				complianceState = "Compliance in progress",
				inputText = ${firstName},
				state = "Basic Information");
		}

		task ("Then the entry should be visible with the same state values in VC_Users page") {
			ObjectsAdmin.searchEntry(inputText = ${firstName});

			ObjectsAdmin.assertObjectEntryVisible(rowItem = "Basic Information");

			ObjectsAdmin.assertObjectEntryVisible(rowItem = "Compliance in progress");
		}
	}

	@description = "Automation ID: LRQA-79178 | Test Summary: Verify that VC_Address object relationship is set as one to many"
	@priority = 5
	test ShowsExpectedObjectRelationship {
		task ("Given the objects page is open") {
			Portal.ObjectAdmin.openObjectAdmin();
		}

		task ("When I navigate to the relationship tab into VC_Address object") {
			ObjectsAdmin.openObject(label = "VC_Address");

			Portal.ObjectAdmin.gotoRelationshipsTab();
		}

		task ("Then the object relationship is set as one to many") {
			ObjectsAdmin.viewObjectRelationships(
				labelRelationships = "Notices Address",
				typeRelationships = "oneToMany");
		}
	}

}