definition {

	property test.env = "uat";
	property testray.main.component.name = "Concluder";

	setUp {
		Utils.launchUatPage();

		Login.loginAsAdminUser();
	}

	@description = "Automation ID: LRQA-79174 | Test Summary: Verify that home page is properly loaded"
	@priority = "5"
	test ShowsHomePageElements {
		task ("Then Concluder page should be properly loaded") {
			HomePage.viewPageElements(headerText = "Concluder");
		}
	}

}