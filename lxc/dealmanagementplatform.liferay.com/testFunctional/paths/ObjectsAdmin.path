<html>
<head>
<title>ObjectsAdmin</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">ObjectsAdmin</td></tr>
</thead>

<tbody>
<tr>
	<td>AUTOCOMPLETE_DROPDOWN_ITEM</td>
	<td>//div[contains(@class,'autocomplete-dropdown') and contains(@class,'show')]//button</td>
	<td></td>
</tr>
<tr>
	<td>DROPDOWN_BUTTON</td>
	<td>//div[contains(@class,'table')]//div[@class='dnd-td']//*[contains(@class,'text-truncate')][contains(text(),'${key_text}')]//ancestor::div[@class='dnd-tr']//div[@class='dropdown']//button</td>
	<td></td>
</tr>
<tr>
	<td>INVALID_FIELD_VALUE</td>
	<td>//div[contains(@class,'feedback-item')][contains(text(),'invalid')]</td>
	<td></td>
</tr>
<tr>
	<td>MENU_ITEM</td>
	<td>//div[contains(@class,'dropdown-menu')][contains(@class,'show')]//*[contains(text(),'${key_menuItem}')]</td>
	<td></td>
</tr>
<tr>
	<td>OBJECTS_PAGE_LOADING</td>
	<td>//div[contains(@class,'portlet-body')]//span[contains(@class,'loading')]</td>
	<td></td>
</tr>
<tr>
	<td>SELECT_FIELD</td>
	<td>//div[contains(@class,'field-container')][@data-field-name='${key_fieldName}']//div[contains(@class,'input-trigger')]</td>
	<td></td>
</tr>
<tr>
	<td>RELATIONSHIPS_TYPE</td>
	<td>xpath=(//div[(@class='table-list-title')]//a[text()='${key_labelRelationships}']//following::div[text()='${key_typeRelationships}'])[1]</td>
	<td></td>
</tr>
<tr>
	<td>TABLE_ROW</td>
	<td>//div[contains(@class,'table')]//div[@class='dnd-td']//*[contains(@class,'text-truncate')][text()='${key_rowItem}']//ancestor::div[@class='dnd-tr']</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>