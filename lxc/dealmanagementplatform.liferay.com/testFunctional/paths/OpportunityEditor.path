<html>
<head>
<title>OpportunityEditor</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">OpportunityEditor</td></tr>
</thead>

<tbody>
<tr>
	<td>ANY_TAB</td>
	<td>xpath=(//button[contains(@aria-controls,'tab')]/span[contains(text(),'${key_tabName}')])[1]</td>
	<td></td>
</tr>
<tr>
	<td>COMPANY_DESCRIPTION_INPUT_FIELD</td>
	<td>xpath=(//label[contains(text(),'Company Description')]/following-sibling::input[contains(@placeholder,'Choose an Option')])[1]</td>
	<td></td>
</tr>
<tr>
	<td>DROPDOWN_ITEM</td>
	<td>//div[contains(@class,'dropdown')][contains(@class,'show')]//*[text()='${key_item}']</td>
	<td></td>
</tr>
<tr>
	<td>INPUT_FIELD</td>
	<td>//label[contains(text(),'${key_fieldLabel}')]//following-sibling::input</td>
	<td></td>
</tr>
<tr>
	<td>INVESTIMENT_OPOTUNITY_ID</td>
	<td>//div[contains(@data-analytics-asset-title,'SiteID')]//*[contains(text(),'ID')]</td>
	<td></td>
</tr>
<tr>
	<td>LISTBOX_BUTTON_N</td>
	<td>xpath=(//span[contains(@class,'input-group-item')]/button[contains(@aria-controls,'listbox')])[${key_index}]</td>
	<td></td>
</tr>
<tr>
	<td>NAV_ITEM</td>
	<td>//div[contains(@id,'navbar')]//span[contains(text(),'${key_navItem}')]//ancestor::a</td>
	<td></td>
</tr>
<tr>
	<td>SELECT_FIELD</td>
	<td>//div[contains(@class,'input')][contains(@class,'list')]//label[contains(text(),'${key_fieldName}')]</td>
	<td></td>
</tr>
<tr>
	<td>SUBMISSION_CONFIRMATION_MESSAGE</td>
	<td>//div[contains(text(),'Thank you. Your information was successfully received.')]</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>