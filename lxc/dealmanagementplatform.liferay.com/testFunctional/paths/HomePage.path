<html>
<head>
<title>HomePage</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">HomePage</td></tr>
</thead>

<tbody>
<tr>
	<td>CONTROL_MENU_NAVIGATION_BAR</td>
	<td>//div[contains(@class,'control-menu-nav') and contains(@id,'controlMenu')]</td>
	<td></td>
</tr>
<tr>
	<td>HEADER_TEXT</td>
	<td>//div[contains(@class,'heading')]//*[contains(text(),'${key_headerText}')]</td>
	<td></td>
</tr>
<tr>
	<td>LOGIN_CONFIRMATION</td>
	<td>//div[contains(@id,'LoginPortlet')]//div[contains(text(),'You are signed in')]</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>