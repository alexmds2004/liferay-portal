<html>
<head>
<title>Dashboard</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">Dashboard</td></tr>
</thead>

<tbody>
<tr>
	<td>CARD_MOVIMENT</td>
	<td>xpath=(//div[@id='movement-card-list']//div[contains(@class,'movement-single-card')])[1]</td>
	<td></td>
</tr>
<tr>
	<td>MOVEMENT_SINGLE_CARD</td>
	<td>xpath=(//div[contains(@class,'movement-single-card')])[${key_index}]</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>