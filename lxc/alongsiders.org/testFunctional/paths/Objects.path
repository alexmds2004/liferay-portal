<html>
<head>
<title>Objects</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">Objects</td></tr>
</thead>

<tbody>
<tr>
	<td>DROPDOWN_MENU</td>
	<td>//label[text()='${key_inputName}']/following-sibling::div//input</td>
	<td></td>
</tr>
<tr>
	<td>DROPDOWN_ITEM</td>
	<td>//button[@class='dropdown-item'][text()='${key_itemName}']</td>
	<td></td>
</tr>
<tr>
	<td>FIDGET_SPINNER</td>
	<td>(//span[@class="spinner-border"]//span[text()='Loading data...'])[${key_index}]</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>