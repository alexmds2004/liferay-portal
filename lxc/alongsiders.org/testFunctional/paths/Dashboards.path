<html>
<head>
<title>Dashboards</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">Dashboards</td></tr>
</thead>

<tbody>
<tr>
	<td>COUNTRY_BAR</td>
	<td>xpath=(//div[@class='country-bar'])[${key_index}]</td>
	<td></td>
</tr>
<tr>
	<td>DATA_SQUARE</td>
	<td>xpath=(//div[@class="data-square"])[${key_index}]</td>
	<td></td>
</tr>
<tr>
	<td>MAP_DASHBOARD</td>
	<td>//div[@class='map']</td>
	<td></td>
</tr>
<tr>
	<td>MOVEMENT_SINGLE_CARD</td>
	<td>xpath=(//div[contains(@class,'movement-single-card')])[${key_index}]</td>
	<td></td>
</tr>
<tr>
	<td>MOVEMENT_DASHBOARD</td>
	<td>xpath=(//*[@component='MovementDashboard']//div[contains(@class,'movement-level-card')])[${key_index}]</td>
	<td></td>
</tr>
<tr>
	<td>PIE_CHART</td>
	<td>xpath=(//div[contains(@class,'pie-chart')])[${key_index}]</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>