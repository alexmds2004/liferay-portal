<html>
<head>
<title>Dashboards</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">Dashboards</td></tr>
</thead>

<tbody>
<tr>
	<td>APEXCHARTS_INDEX</td>
	<td>xpath=(//div/*[contains(text(),'LBS School Grade')]//following-sibling::div//div[@id='apexchartsPieChart']//*[name()='g'][contains(@class,'apexcharts-pie')]/*[name()='path'])[12]</td>
	<td></td>
</tr>
<tr>
	<td>COUNTRY_BAR</td>
	<td>xpath=(//div[@class='country-bar'])[${key_index}]</td>
	<td></td>
</tr>
<tr>
	<td>COUNTRY_LBS</td>
	<td>//div[contains(@class,'multiselect')]//span[contains(text(),'${key_country}')]</td>
	<td></td>
</tr>
<tr>
	<td>DATA_SQUARE</td>
	<td>xpath=(//div[@class="data-square"])[${key_index}]</td>
	<td></td>
</tr>
<tr>
	<td>DROPDOWN_COUNTRY_LBS</td>
	<td>//div[contains(@class,'multiselect')]//span</td>
	<td></td>
</tr>
<tr>
	<td>INPUT_MOVEMENT_ID</td>
	<td>//div[contains(@data-field-name,'MovementId')]//input[@class='form-control']</td>
	<td></td>
</tr>
<tr>
	<td>LEGEND_CHARTS</td>
	<td>//div[contains(@class,'apexcharts-legend')]//span[contains(text(),'${key_legendChartsText}')]</td>
	<td></td>
</tr>
<tr>
	<td>MAP_DASHBOARD</td>
	<td>//*[contains(text(),'Alongsiders by Country')]/following-sibling::div/div[@class='map']</td>
	<td></td>
</tr>
<tr>
	<td>MOVEMENT_CARD</td>
	<td>xpath=(//div[@id='movement-card-list']//div[contains(@class,'movement-single-card')])[1]</td>
	<td></td>
</tr>
<tr>
	<td>MOVEMENT_DASHBOARD</td>
	<td>xpath=(//*[@component='MovementDashboard']//div[contains(@class,'movement-level-card')])[${key_index}]</td>
	<td></td>
</tr>
<tr>
	<td>MOVEMENT_SINGLE_CARD</td>
	<td>xpath=(//div[contains(@class,'movement-single-card')])[${key_index}]</td>
	<td></td>
</tr>
<tr>
	<td>NAME_MOVIMENT_LIST</td>
	<td>//div//*[contains(@class,'text-truncate')][contains(text(),'${key_textName}')]</td>
	<td></td>
</tr>
<tr>
	<td>PIE_CHART</td>
	<td>xpath=(//div[contains(@class,'pie-chart')])[${key_index}]</td>
	<td></td>
</tr>
<tr>
	<td>PIE_CHART_INDEX</td>
	<td>xpath=(//span[@class='apexcharts-legend-text'])[5]</td>
	<td></td>
</tr>
<tr>
	<td>REMOVE_COUNTRY_LBS</td>
	<td>//div[@class='multiselect__tags']//*[contains(text(),'${key_countryRemove}')]//following-sibling::*[contains(@class,'tag-icon')]</td>
	<td></td>
</tr>
<tr>
	<td>SPINNER</td>
	<td>xpath=(//span[contains(@class,'spinner-border')]/span[contains(.,'Loading data...')])[1]</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>