<html>
<head>
<title>General</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">General</td></tr>
</thead>

<tbody>
<tr>
	<td>ANY_DROPDOWN_ITEM</td>
	<td>//*[@class='dropdown-item'][text()='${key_dropdownName}']</td>
	<td></td>
</tr>
<tr>
	<td>ANY_NAVBAR_BUTTON</td>
	<td>//div[contains(@id,'navigationCollapse')]//span[contains(text(),'${key_itemNavBar}')]</td>
	<td></td>
</tr>
<tr>
	<td>SITE_LOGO</td>
	<td>//div[@class='public-site-navbar']//img[contains(@class,'site-logo')]</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>