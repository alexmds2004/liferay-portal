definition {

	@summary = "Fills the movements form"
	macro fillMovementsForm {
		Portal.PortletEntry.inputName(name = ${name});

		Default.Type(
			locator1 = "Dashboards#INPUT_MOVEMENT_ID",
			value1 = ${movementId});

		if (isSet(inputName)) {
			Default.Click(
				key_inputName = ${inputName},
				locator1 = "Objects#DROPDOWN_MENU");

			Default.Click(
				key_itemName = ${itemName},
				locator1 = "Objects#DROPDOWN_ITEM");
		}
	}

	@summary = "Get the value on the movements card"
	macro getMovementsValue {
		var key_index = 1;

		Default.WaitForPageLoad();

		Default.WaitForVisible(locator1 = "Dashboards#MOVEMENT_SINGLE_CARD");

		var initialValue = selenium.getText("Dashboards#MOVEMENT_SINGLE_CARD");

		var extractValue = StringUtil.extractDigits(${initialValue});

		return ${extractValue};
	}

}