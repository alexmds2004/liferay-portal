definition {

	@summary = "Get the value on the movements card"
	macro getMovementsValue {
		var key_index = 1;

		Default.WaitForElementPresent(locator1 = "Dashboards#SPINNER");

		Default.AssertElementNotPresent(locator1 = "Dashboards#SPINNER");

		var initialValue = selenium.getText("Dashboards#MOVEMENT_SINGLE_CARD");

		var extractValue = StringUtil.extractDigits(${initialValue});

		echo("EXTRACT VALUE: ${extractValue}");

		echo("INITIAL VALUE: ${initialValue}");

		return ${extractValue};
	}

	@summary = "Fills the movements form"
	macro typeMovementsForm {
		Portal.PortletEntry.inputName(name = ${name});

		Default.Type(
			locator1 = "Dashboards#INPUT_MOVEMENT_ID",
			value1 = ${movementId});

		if (isSet(inputName)) {
			Default.Click(
				key_inputName = ${inputName},
				locator1 = "Objects#DROPDOWN_MENU");

			Default.Click(
				key_itemName = ${itemName},
				locator1 = "Objects#DROPDOWN_ITEM");
		}
	}

	@summary = "Validates that the map on the dashboard is visible"
	macro viewCountryList {
		Default.AssertVisible(
			key_index = ${index},
			locator1 = "Dashboards#COUNTRY_BAR");
	}

	@summary = "Validates if the data card section in panel is visible"
	macro viewDashboardDataCard {
		for (var index : list "1,2,3,4") {
			Default.AssertVisible(
				key_index = "${index}",
				locator1 = "Dashboards#DATA_SQUARE");
		}
	}

	@summary = "Validates that the map on the dashboard is visible"
	macro viewMapInDashboard {
		Default.AssertVisible(locator1 = "Dashboards#MAP_DASHBOARD");
	}

	@summary = "Validates if the movement section in panel is visible"
	macro viewMovementDashboard {
		if (${dashboard} == "Movement Dashboards") {
			for (var index : list "1,2") {
				Default.AssertVisible(
					key_index = ${index},
					locator1 = "Dashboards#MOVEMENT_DASHBOARD");
			}
		}
		else {
			for (var index : list "1,2,3,4,5,6") {
				Default.AssertVisible(
					key_index = ${index},
					locator1 = "Dashboards#MOVEMENT_SINGLE_CARD");
			}
		}
	}

	@summary = "Validates if the pie chart is visible"
	macro viewPieChartDashboard {
		Default.AssertVisible(
			key_index = ${index},
			locator1 = "Dashboards#PIE_CHART");
	}

}