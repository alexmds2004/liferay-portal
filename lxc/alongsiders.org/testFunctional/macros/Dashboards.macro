definition {

	@summary = "Validates if the movement section in panel is visible"
	macro viewDashboardMovement {
		if ("${cambodiaSection}" == "true") {
			for (var index : list "1,2") {
				Default.AssertVisible(
					key_index = "${index}",
					locator1 = "Dashboards#MOVEMENT_CAMBODIA");
			}
		}
		else {
			for (var numberCard : list "0,1,2,3,4,5") {
				Default.AssertVisible(
					key_numberCard = "${numberCard}",
					locator1 = "Dashboards#MOVEMENT_SINGLE_CARD");
			}
		}
	}

}