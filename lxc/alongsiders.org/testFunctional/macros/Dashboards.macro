definition {

	@summary = "Validates if the data card section in panel is visible"
	macro viewDashboardDataCard {
		for (var index : list "1,2,3,4") {
			Default.AssertVisible(
				key_index = "${index}",
				locator1 = "Dashboards#DATA_SQUARE");
		}
	}

	@summary = "Validates if the movement section in panel is visible"
	macro viewMovementDashboard {
		if ("${cambodiaSection}" == "true") {
			for (var index : list "1,2") {
				Default.AssertVisible(
					key_index = "${index}",
					locator1 = "Dashboards#MOVEMENT_CAMBODIA");
			}
		}
		else {
			for (var index : list "1,2,3,4,5,6") {
				Default.AssertVisible(
					key_index = "${index}",
					locator1 = "Dashboards#MOVEMENT_SINGLE_CARD");
			}
		}
	}

}