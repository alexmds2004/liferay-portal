definition {

	@summary = "Add country to 'LBS Over Time' dashboard list"
	macro addCountryInChartLbs {
		Default.WaitForVisible(locator1 = "Dashboards#DROPDOWN_COUNTRY_LBS");

		Default.ScrollWebElementIntoView(locator1 = "Dashboards#DROPDOWN_COUNTRY_LBS");

		Default.Click(locator1 = "Dashboards#DROPDOWN_COUNTRY_LBS");

		Default.Click.clickAtNotVisible(
			key_country = ${addCountry},
			locator1 = "Dashboards#COUNTRY_LBS");
	}

	@summary = "View country added to 'LBS Over Time' chart"
	macro viewCountryChartsLbs {
		Default.Click.clickAtNotVisible(
			key_legendChartsText = ${legendCharts},
			locator1 = "Dashboards#LEGEND_CHARTS");

		Default.AssertElementPresent(
			key_country = ${viewCountryDropdown},
			locator1 = "Dashboards#COUNTRY_LBS");
	}

	@summary = "Validates that country list is visible"
	macro viewCountryList {
		Default.AssertVisible(
			key_index = ${index},
			locator1 = "Dashboards#COUNTRY_BAR");
	}

	@summary = "Validates if the data card section in panel is visible"
	macro viewDashboardDataCard {
		for (var index : list "1,2,3,4") {
			Default.AssertVisible(
				key_index = ${index},
				locator1 = "Dashboards#DATA_SQUARE");
		}
	}

	@summary = "Validates that the map on the dashboard is visible"
	macro viewMapInDashboard {
		Default.AssertVisible(locator1 = "Dashboards#MAP_DASHBOARD");
	}

	@summary = "Validates if the movement section in panel is visible"
	macro viewMovementDashboard {
		if (${dashboard} == "Movement Dashboards") {
			for (var index : list "1,2") {
				Default.AssertVisible(
					key_index = ${index},
					locator1 = "Dashboards#MOVEMENT_DASHBOARD");
			}
		}
		else {
			for (var index : list "1,2,3,4,5,6") {
				Default.AssertVisible(
					key_index = ${index},
					locator1 = "Dashboards#MOVEMENT_SINGLE_CARD");
			}
		}
	}

	@summary = "Validates if the pie chart is visible"
	macro viewPieChartDashboard {
		Default.AssertVisible(
			key_index = ${index},
			locator1 = "Dashboards#PIE_CHART");
	}

}