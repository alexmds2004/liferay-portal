definition {

	@summary = "Launching UAT Home page"
	macro launchUatHomePage {
		var portal = PropsUtil.get("test.this.alongsiders.portal.url.modl");

		Default.Open(locator1 = "${portal}/home");

		Default.WaitForVisible(locator1 = "General#SITE_LOGO");
	}

	@summary = "Navigates to one of the options in the navbar menu"
	macro navigateToMenuItem {
		var key_navBarItem = ${navBarItem};

		if (isSet(dropdownName)) {
			var key_dropdownName = ${dropdownName};

			Default.MouseOver(locator1 = "General#ANY_NAVBAR_BUTTON");

			Default.Click(locator1 = "General#ANY_DROPDOWN_ITEM");
		}
		else {
			Default.Click(locator1 = "General#ANY_NAVBAR_BUTTON");
		}
	}

	@summary = "Delete 'testlxc' entries created in 'Movements'"
	macro tearDownMovements {
		Portal.ApplicationsMenu.gotoPortlet(
			category = "Content",
			panel = "Applications",
			portlet = "Movements");

		Portal.ObjectPortlet.searchEntry(entryName = "testlxc");

		Portal.CreateObject.deleteObjectViaUI(objectLabel = "testlxc");

		Default.Confirm.acceptAlert();
	}

}