definition {

	@summary = "Navigation to navbar in menu"
	macro navigationMenuItem {
		var key_itemNavBar = "${itemNavBar}";

		Default.Click(locator1 = "General#ANY_NAVBAR_BUTTON");
	}

	@summary = "Launching UAT Home page"
	macro launchUatHomePage {
		var portal = PropsUtil.get("test.this.alongsiders.portal.url.uat");

		Default.Open(locator1 = "${portal}/home");

		Default.WaitForVisible(locator1 = "General#SITE_LOGO");
	}

}