definition {

	@summary = "Check if current number is greater than or equal to expected"
	macro greaterOrEqual {
		echo(${expected});

		echo(${actual});

		var result = MathUtil.isGreaterThanOrEqualTo(${actual}, ${expected});

		if (${result} == "true") {
			echo("PASSED");
		}
		else {
			Portal.TestUtils.fail(message = "FAILED: actual '${actual}' is different than expected '${expected}'");
		}
	}
