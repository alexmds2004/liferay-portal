definition {

	@summary = "Check if current number is greater than or equal to expected"
	macro greaterOrEqual {
		echo(${expected});

		echo(${actual});

		var result = MathUtil.isGreaterThanOrEqualTo(${actual}, ${expected});

		if (${result} == "true") {
			echo("PASSED");
		}
		else {
			Portal.TestUtils.fail(message = "FAILED: actual '${actual}' is different than expected '${expected}'");
		}
	}

	@summary = "View card numbers 'Movements'"
	macro viewDashboardsMovements {
		var count = 0;

		for (var key_index : list "1,2,3,4,5") {
			Default.WaitForPageLoad();

			Default.WaitForVisible(locator1 = "Dashboard#CARD_MOVIMENT");

			var key_index = selenium.getText("Dashboard#MOVEMENT_SINGLE_CARD");

			echo(${key_index});

			var numberCard = StringUtil.extractDigits(${key_index});

			echo(${numberCard});

			Dashboard.greaterOrEqual(
				actual = ${numberCard},
				expected = 0);

			if (${numberCard} == 0) {
				var count = ${count} + 1;

				echo(${count});

				if (${count} == 5) {
					Portal.TestUtils.fail(message = "FAILED: All the five cards is zero");
				}
			}
		}
	}

}