definition {

	@summary = "Check if home page has loaded"
	macro viewHomePageLoaded {
		var key_navButton = "Home";

		Default.AssertElementPresent(locator1 = "General#ANY_NAVBAR_BUTTON");

		Default.AssertElementPresent(locator1 = "General#SITE_LOGO");
	}

	@summary = "Check if navbar items are visible"
	macro viewNavbarIsVisible {
		for (var navOption : list "Home,Global,Regional,Cambodia") {
			Default.AssertVisible(
				key_navButton = "${navOption}",
				locator1 = "General#ANY_NAVBAR_BUTTON");
		}
	}

}