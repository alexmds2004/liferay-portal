definition {

	property test.env = "uat";
	property testray.main.component.name = "Alongsiders";

	setUp {
		Utils.launchUatHomePage();

		Login.signIn();
	}

	@description = "Automation ID: LRQA-79334 | Test Summary: Verify Objects are loaded at objects admin page"
	@priority = 5
	test ShowsExistingObjects {
		task ("Given I navigate to the objects admin page") {
			Portal.ApplicationsMenu.gotoPortlet(
				category = "Object",
				panel = "Control Panel",
				portlet = "Objects");
		}

		task ("Then the objects are displayed") {
			Portal.ObjectAdmin.assertObjectColumnValue(
				label = "Movement",
				scope = "company",
				status = "Approved",
				system = "No");

			Portal.ObjectAdmin.assertObjectColumnValue(
				label = "Country",
				scope = "company",
				status = "Approved",
				system = "No");
		}
	}

}