definition {

	property test.env = "uat";
	property testray.main.component.name = "Alongsiders";

	setUp {
		Utils.launchUatHomePage();

		Login.signIn();
	}

	@description = "Automation ID: LRQA-79508 | Test Summary: Verify that is possible to add a country at 'Alongsiders and LBS Over Time' section"
	@priority = 5
	test CanAddCountryToGrowthChart {
		task ("When the customer navigates to the Global Dashboard") {
			Utils.navigateToMenuItem(navBarItem = "Global Dashboard");
		}

		task ("And I add a country to the 'LBS Over Time' chart") {
			Dashboards.addCountryInChartLbs(addCountry = "Nigeria");
		}

		task ("Then the country name is visible on the chart") {
			Dashboards.viewCountryChartsLbs(
				legendCharts = "Nigeria",
				viewCountryDropdown = "Nigeria");
		}
	}

	@description = "Automation ID: LRQA-79347 | Test Summary: Verify that cards at 'Data' section are loaded"
	@priority = 5
	test ShowsCardsAtDataSection {
		task ("When the customer navigates to the Global Dashboard") {
			Utils.navigateToMenuItem(navBarItem = "Global Dashboard");
		}

		task ("Then the customer can see the data card section") {
			Dashboards.viewDashboardDataCard();
		}

		task ("When the customer navigates to the Africa Dashboard") {
			Utils.navigateToMenuItem(
				dropdownName = "Africa Dashboard",
				navBarItem = "Regional Dashboards");
		}

		task ("Then the customer can see the data card section") {
			Dashboards.viewDashboardDataCard();
		}
	}

	@description = "Automation ID: LRQA-79333 | Test Summary: Verify that cards at 'Movements' section are loaded"
	@priority = 5
	test ShowsCardsAtMovementSection {
		task ("When the customer navigates to the Global Dashboard") {
			Utils.navigateToMenuItem(navBarItem = "Global Dashboard");
		}

		task ("Then the customer can see the movement section") {
			Dashboards.viewMovementDashboard();
		}

		task ("When the customer navigates to the Africa Dashboard") {
			Utils.navigateToMenuItem(
				dropdownName = "Africa Dashboard",
				navBarItem = "Regional Dashboards");
		}

		task ("Then the customer can see the movement section") {
			Dashboards.viewMovementDashboard();
		}

		task ("When the customer navigates to the Cambodia (Chanthy)") {
			Utils.navigateToMenuItem(
				dropdownName = "Cambodia (Chanthy)",
				navBarItem = "Movement Dashboards");
		}

		task ("Then the customer can see the movement section") {
			Dashboards.viewMovementDashboard(dashboard = "Movement Dashboards");
		}
	}

	@description = "Automation ID: LRQA-79416 | Test Summary: Verify that pie charts are loaded"
	@priority = 5
	test ShowsPieCharts {
		task ("When the customer navigates to the Global Dashboard") {
			Utils.navigateToMenuItem(navBarItem = "Global Dashboard");
		}

		task ("Then the customer can see the pie chart on the dashboard") {
			Dashboards.viewPieChartDashboard(index = 1);
		}

		task ("When the customer navigates to the Africa Dashboard") {
			Utils.navigateToMenuItem(
				dropdownName = "Africa Dashboard",
				navBarItem = "Regional Dashboards");
		}

		task ("Then the customer can see the pie chart on the dashboard") {
			Dashboards.viewPieChartDashboard(index = 1);
		}
	}

	@description = "Automation ID: LRQA-79412 | Test Summary: Verify that the country list is shown at 'Alongsiders by Country' section"
	@priority = 5
	test ViewCountryList {
		task ("When the customer navigates to the Global Dashboard") {
			Utils.navigateToMenuItem(navBarItem = "Global Dashboard");
		}

		task ("Then the customer can see the country on the dashboard") {
			Dashboards.viewCountryList(index = 1);
		}

		task ("When the customer navigates to the Africa Dashboard") {
			Utils.navigateToMenuItem(
				dropdownName = "Africa Dashboard",
				navBarItem = "Regional Dashboards");
		}

		task ("Then the customer can see the country on the dashboard") {
			Dashboards.viewCountryList(index = 1);
		}
	}

	@description = "Automation ID: LRQA-79333 | Test Summary: Verify that the map is loaded at 'Alongsiders by Country' section"
	@priority = 5
	test ViewDashboardMap {
		task ("When the customer navigates to the Global Dashboard") {
			Utils.navigateToMenuItem(navBarItem = "Global Dashboard");
		}

		task ("Then the customer can see the map on the dashboard") {
			Dashboards.viewMapInDashboard();
		}

		task ("When the customer navigates to the Africa Dashboard") {
			Utils.navigateToMenuItem(
				dropdownName = "Africa Dashboard",
				navBarItem = "Regional Dashboards");
		}

		task ("Then the customer can see the map on the dashboard") {
			Dashboards.viewMapInDashboard();
		}
	}

}