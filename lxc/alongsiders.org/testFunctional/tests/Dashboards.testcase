definition {

	property test.env = "uat";
	property testray.main.component.name = "Alongsiders";

	setUp {
		Utils.launchUatHomePage();

		Login.signIn();
	}

	@description = "Automation ID: LRQA-79333 | Test Summary: Verify that cards at 'Movements' section are loaded"
	@priority = "5"
	test ShowsCardsAtMovementSection {
		task ("When the customer navigates to the Global Dashboard") {
			Utils.navigationMenuItem(itemNavBar = "Global Dashboard");
		}

		task ("Then the customer can see the movement section") {
			Dashboards.viewDashboardMovement();
		}

		task ("When the customer navigates to the Africa Dashboard") {
			Utils.navigationMenuItem(
				dropdownName = "Africa Dashboard",
				itemNavBar = "Regional Dashboards");
		}

		task ("Then the customer can see the movement section") {
			Dashboards.viewDashboardMovement();
		}

		task ("When the customer navigates to the Cambodia (Chanthy)") {
			Utils.navigationMenuItem(
				dropdownName = "Cambodia (Chanthy)",
				itemNavBar = "Movement Dashboards");
		}

		task ("Then the customer can see the movement section") {
			Dashboards.viewDashboardMovement(cambodiaSection = "true");
		}
	}

}