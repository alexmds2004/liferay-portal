definition {

	property test.env = "uat";
	property testray.main.component.name = "Alongsiders";

	setUp {
		Utils.launchUatHomePage();

		Login.signIn();
	}

	@description = "Automation ID: LRQA-79276 | Test Summary: Verify user is properly redirected by clicking at 'Dashboard' in navigation menu"
	@priority = 5
	test CanNavigateToDashboardFromNavigationMenu {
		task ("When the customer clicks 'Dashboard' in the navigation menu") {
			Utils.navigateToMenuItem(navBarItem = "Global Dashboard");
		}

		task ("Then Home Page is loaded") {
			HomePage.viewHomePageLoaded();
		}
	}

	@description = "Automation ID: LRQA-79439 | Test Summary: Verify 'LBS School Grade' pie chart has slices with different values"
	@priority = 5
	@refactor
	test HasDifferentSliceValues {
		task ("When I navigate to the Africa Dashboard page") {
			Utils.navigateToMenuItem(
				dropdownName = "Africa Dashboard",
				navBarItem = "Regional Dashboards");
		}

		task ("Then 'LBS School Grade' pie chart values are displayed") {
			Dashboards.viewChartDifferentOrEqual();
		}
	}

	@description = "Automation ID: LRQA-79336 | Test Summary: Verify some cards from 'Movements' have values different than '0'"
	@priority = 5
	test ShowsCardValuesHigherThanZero {
		task ("When I navigate to the Global Dashboards page") {
			Utils.navigateToMenuItem(navBarItem = "Global Dashboard");
		}

		task ("Then the 'Movements' cards are displayed with values other than '0'") {
			Dashboards.viewDashboardsMovementsAreNotZero();
		}
	}

	@description = "Automation ID: LRQA-75412 | Test Summary: Verify that home page is properly loaded"
	@priority = 5
	test ViewHomePageElements {
		task ("Then Home Page is loaded") {
			HomePage.viewHomePageLoaded();
		}
	}

	@description = "Automation ID: LRQA-79268 | Test Summary: Verify navigation menu items are visible at the tob bar"
	@priority = 5
	test ViewNavigationMenuOptions {
		task ("Then navigation menu options are visible") {
			HomePage.viewNavbarIsVisible();
		}
	}

}