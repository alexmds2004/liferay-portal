definition {

	property test.env = "uat";
	property testray.main.component.name = "Alongsiders";

	setUp {
		Utils.launchUatHomePage();

		Login.signIn();
	}

	@description = "Automation ID: LRQA-79276 | Test Summary: Verify user is properly redirected by clicking at 'Dashboard' in navigation menu"
	@priority = "5"
	test CanNavigateToDashboardFromNavigationMenu {
		task ("When the customer clicks 'Dashboard' in the navigation menu") {
			Utils.navigationMenuItem(itemNavBar = "Global Dashboard");
		}

		task ("Then Home Page is loaded") {
			HomePage.viewHomePageLoaded();
		}
	}

	@description = "Automation ID: LRQA-75412 | Test Summary: Verify that home page is properly loaded"
	@priority = "5"
	test ViewHomePageElements {
		task ("Then Home Page is loaded") {
			HomePage.viewHomePageLoaded();
		}
	}

	@description = "Automation ID: LRQA-79268 | Test Summary: Verify navigation menu items are visible at the tob bar"
	@priority = "5"
	test ViewNavigationMenuOptions {
		task ("Then navigation menu options are visible") {
			HomePage.viewNavbarIsVisible();
		}
	}

}