<html>
<head>
<title>Search</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">Search</td></tr>
</thead>

<tbody>
<tr>
	<td>ASSERT_LINKS_LIST_ITEM</td>
	<td>xpath=(//div//*[contains(@class,'links-list')])[${key_index}]//a[contains(@href,'q=${key_recentSearchedItem}')]</td>
	<td></td>
</tr>
<tr>
	<td>BUTTON_CLOSE</td>
	<td>//div[contains(@class,'transition is-open')]//span[@aria-label="Fechar"][contains(@class,'close-search')]</td>
	<td></td>
</tr>
<tr>
	<td>GET_LINKS_LIST_ITEM</td>
	<td>xpath=(//div//*[contains(@class,'links-list')])[${key_index}]//a[contains(@href,'')]</td>
	<td></td>
</tr>
<tr>
	<td>HIGHLIGHTED_RESULTS</td>
	<td>//*[contains(@class,'highlight')][text()='${key_searchTerm}']</td>
	<td></td>
</tr>
<tr>
	<td>LINKS_LIST_TITLE</td>
	<td>//div/*[contains(@class,'links-title')][text()='${key_listName}']</td>
	<td></td>
</tr>
<tr>
	<td>RESULTS</td>
	<td>//section[contains(@id,'SearchResultsPortlet')]//p[contains(text(),' Resultados para ')]/*[text()='${key_contentSearch}']</td>
	<td></td>
</tr>
<tr>
	<td>CENTER_MAIN_INPUT</td>
	<td>//div[contains(@class,'search-bar')]//input[@value='${key_searchTerm}']</td>
	<td></td>
</tr>
<tr>
	<td>INPUT</td>
	<td>//div[contains(@class,'search-bar')]//input[@data-qa-id='searchInput']</td>
	<td></td>
</tr>
<tr>
	<td>PLACEHOLDER</td>
	<td>//input[contains(@placeholder,'${key_placeholdertText}')]</td>
	<td></td>
</tr>
<tr>
	<td>SUGGESTIONS_LIST_ITEM</td>
	<td>//ul[@class='suggestions-list']//*[text()='${key_searchTerm}']</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>