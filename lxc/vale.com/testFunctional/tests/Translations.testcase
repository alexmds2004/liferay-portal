definition {

	property test.env = "uat";
	property testray.main.component.name = "Vale";

	setUp {
		Utils.launchUatHomePage();

		Utils.acceptCookies();
	}

	@description = "Automation ID: LRQA-79221 | Test Summary: Verify if expressions have been translated"
	@priority = "5"
	test ViewMissingTranslations {
		task ("Then preposition 'of' should be translated to 'de'") {
			Translations.viewVideoCountPreposition(preposition = "de");
		}

		task ("When I open the window search") {
			Search.gotoSearchPortlet();
		}

		task ("Then the search screen texts must be translated") {
			Translations.viewSearchElements(listNameTranslation = "Links rápidos,Buscas recentes");
		}

		task ("When I search any thing in search field") {
			Search.searchContent(searchTerm = "vale");
		}

		task ("Then view the text that informs the results in Portuguese") {
			Translations.viewTranslationsInResultsSearch(contentSearch = "vale");
		}
	}

}