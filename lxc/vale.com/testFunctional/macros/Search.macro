definition {

	@summary = "Click in the list link"
	macro clickListItem {
		Default.Click(
			key_index = ${index},
			locator1 = "Search#GET_LINKS_LIST_ITEM");
	}

	@summary = "Get the item name from the links list"
	macro getItemName {
		var key_index = ${index};

		Default.WaitForVisible(locator1 = "Search#GET_LINKS_LIST_ITEM");

		var itemInformation = selenium.getText("Search#GET_LINKS_LIST_ITEM");

		var itemName = StringUtil.extractLast(${itemInformation}, "Acesse a página ");

		return ${itemName};
	}

	@summary = "Open search portlet"
	macro openSearchPortlet {
		Default.WaitForPageLoad(locator1 = "General#SEARCH_ICON");

		Default.WaitForVisible(locator1 = "General#SEARCH_ICON");

		Default.Click(locator1 = "General#SEARCH_ICON");
	}

	@summary = "Search for content"
	macro searchContent {
		Search.typeInSearchField(searchText = ${searchTerm});

		Default.KeyPress(
			locator1 = "Search#INPUT",
			value1 = "\ENTER");
	}

	@summary = "Type on search input"
	macro typeInSearchField {
		Default.Type(
			locator1 = "Search#INPUT",
			value1 = ${searchText});
	}

	@summary = "View list of link shortcuts"
	macro viewLinksSearch {
		Default.AssertElementPresent(
			key_listName = ${listName},
			locator1 = "Search#LINKS_LIST_TITLE");
	}

	@summary = "View placeholder"
	macro viewPlaceholder {
		Default.AssertElementPresent(
			key_placeholdertText = ${placeholderText},
			locator1 = "Search#PLACEHOLDER");
	}

	@summary = "View item in the list of links"
	macro viewSearchedItem {
		Default.AssertVisible(
			key_index = ${index},
			key_recentSearchedItem = ${recentSearchedItem},
			locator1 = "Search#ASSERT_LINKS_LIST_ITEM");
	}

	@summary = "View if the searched term is in match with the page"
	macro viewSearchedResults {
		Default.AssertVisible(
			key_searchTerm = ${searchTerm},
			locator1 = "Search#HIGHLIGHTED_RESULTS");

		Default.AssertElementPresent(
			key_searchTerm = ${searchTerm},
			locator1 = "Search#CENTER_MAIN_INPUT");

		Default.AssertLocation.assertPartialLocation(value1 = ${partialURL});
	}

	@summary = "Validates if the search result is translated after performing a search"
	macro viewSearchResultsMessageIsTranslated {
		Default.AssertElementPresent(
			key_contentSearch = ${contentSearch},
			locator1 = "Search#RESULTS");
	}

	@summary = "Validates if the search sections are translated according to the current site language"
	macro viewSearchSectionsAreTranslated {
		for (var section : list ${sectionList}) {
			Default.AssertElementPresent(
				key_listName = ${section},
				locator1 = "Search#LINKS_LIST_TITLE");
		}
	}

	@summary = "View item in search suggestions"
	macro viewSuggestionList {
		Default.AssertVisible(
			key_searchTerm = ${searchTerm},
			locator1 = "Search#SUGGESTIONS_LIST_ITEM");
	}

}