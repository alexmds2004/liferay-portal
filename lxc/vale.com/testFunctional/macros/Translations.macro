definition {

	@summary = "Validates if the phrases in the search tab have been translated."
	macro viewSearchElements {
		Default.Click(locator1 = "General#SEARCH_ICON");

		for (var name : list "${listNameTranslation}") {
			Default.AssertElementPresent(
				key_listName = "${name}",
				locator1 = "Search#LINKS_LIST_TITLE");
		}
	}

	@summary = "Checks if the phrase for the number of found results has been translated."
	macro viewTranslationsInResultsSearch {
		Default.AssertElementPresent(
			key_contentSearch = "${contentSearch}",
			locator1 = "Search#RESULTS_IN_SEARCH");
	}

}