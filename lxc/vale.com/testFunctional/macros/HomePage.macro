definition {

	@summary = "View if the know more button is visible after scrolling down through the arrow icon"
	macro assertScrollDownToKnowMore {
		Portal.ACUtils.waitForScrollDown();

		Default.AssertVisible(locator1 = "HomePage#KNOW_MORE_AFTER_SCROLL_DOWN");

		Default.Click(locator1 = "HomePage#KNOW_MORE_AFTER_SCROLL_DOWN");
	}

	@summary = "Get the news title"
	macro getNewsTitle {
		var newsTitleText = selenium.getText("HomePage#ACTIVE_NEWS_CARD_TITLE");

		return ${newsTitleText};
	}

	@summary = "Go to news and open"
	macro openNews {
		Default.ScrollWebElementIntoView(
			key_text = "Todas as notícias",
			locator1 = "Portal.Button#ANY");

		Default.Click.pauseClickAt(locator1 = "HomePage#ACTIVE_NEWS_CARD");
	}

	@summary = "Open social media icons in page footer"
	macro openSocialMedia {
		Default.Click.pauseClickAt(
			key_socialMediaName = ${socialMediaName},
			locator1 = "General#FOOTER_SOCIAL_MEDIA_IMAGE");

		Default.SelectWindow.selectPopUp(locator1 = "null");
	}

	@summary = "Click on the arrow icon bellow 'scroll down to know more'"
	macro scrollDownToKnowMore {
		Default.Click(
			key_text = "Desça para saber mais",
			locator1 = "HomePage#SCROLL_DOWN_BUTTON_TEXT");
	}

	@summary = "View main sections in home page"
	macro viewMainSections {
		Default.AssertElementPresent(locator1 = "HomePage#CAROUSEL_IMAGE_SECTION");

		Default.AssertElementPresent(locator1 = "HomePage#VIDEO_SECTION");

		Default.AssertElementPresent(locator1 = "HomePage#CAROUSEL_CARD_VIDEO_SECTION");

		Default.AssertElementPresent(locator1 = "HomePage#NEWS_SECTION");

		Default.AssertElementPresent(locator1 = "HomePage#FOOTER");
	}

	@summary = "View if there is news on the page"
	macro viewNewsPage {
		Default.WaitForVisible(locator1 = "HomePage#NEWS_HEADER");

		if (Default.IsElementNotPresent(key_newsTitle = ${newsTitle}, locator1 = "HomePage#NEWS_TITLE")) {
			Default.AssertElementPresent(
				key_text = ${newsTitle},
				locator1 = "General#TEXT_ANY");
		}
		else {
			Default.AssertElementPresent(
				key_newsTitle = ${newsTitle},
				locator1 = "HomePage#NEWS_TITLE");
		}
	}

	@summary = "View scroll down button text in home page"
	macro viewScrollDownButtonText {
		Default.WaitForElementPresent(
			key_text = ${buttonText},
			locator1 = "HomePage#SCROLL_DOWN_BUTTON_TEXT");

		Default.AssertVisible(
			key_text = ${buttonText},
			locator1 = "HomePage#SCROLL_DOWN_BUTTON_TEXT");
	}

	@summary = "View if social media is being opened"
	macro viewSocialMedia {
		Default.AssertLocation.assertPartialLocation(value1 = ${socialMediaName});

		var url = selenium.getLocation();

		var urlLowerCase = StringUtil.toLowerCase(${url});

		Portal.TestUtils.assertPartialEquals(
			actual = ${urlLowerCase},
			expected = "vale");
	}

	@summary = "View social media icons in page footer"
	macro viewSocialMediaIconsInFooter {
		for (var socialMediaName : list "facebook,youtube,linkedin,instagram,twitter") {
			Default.AssertElementPresent(
				key_socialMediaName = ${socialMediaName},
				locator1 = "General#FOOTER_SOCIAL_MEDIA_IMAGE");
		}
	}

	@summary = "View carousel swiper works swiping active images"
	macro viewSwipingImagesInCarouselSwiper {
		task ("Making sure the current image loaded in carousel swiper is the selected image") {
			var indicatorIndex = ${slideNumber} - 1;

			if (Default.IsElementPresent(key_indicatorIndex = ${indicatorIndex}, locator1 = "HomePage#CAROUSEL_IMAGE_SWIPER_INDICATOR_INACTIVE")) {
				Default.Click(
					key_indicatorIndex = ${indicatorIndex},
					locator1 = "HomePage#CAROUSEL_IMAGE_SWIPER_INDICATOR_INACTIVE");
			}

			Default.AssertElementPresent(
				key_indicatorIndex = ${indicatorIndex},
				locator1 = "HomePage#CAROUSEL_IMAGE_SWIPER_INDICATOR_ACTIVE");

			Default.AssertVisible(
				key_imageNumber = ${slideNumber},
				locator1 = "HomePage#CAROUSEL_IMAGE_SWIPER_ACTIVE_IMAGE");
		}
	}

	@summary = "View carousel swiper works swiping active news by button next and previous"
	macro viewSwipingNewsInCarouselSwiper {
		task ("Making sure the current news in carousel swiper is present") {
			Default.AssertElementPresent(
				key_indicatorIndex = ${indicatorIndex},
				locator1 = "HomePage#CAROUSEL_NEWS_SWIPER_INDICATOR_ACTIVE");

			if (${button} == "next") {
				Default.Click.pauseClickAt(
					key_boolean = "false",
					locator1 = "HomePage#CAROUSEL_NEWS_SWIPER_BUTTON_NEXT");
			}
			else {
				Default.Click.pauseClickAt(
					key_boolean = "false",
					locator1 = "HomePage#CAROUSEL_NEWS_SWIPER_BUTTON_PREVIOUS");
			}

			Default.AssertElementPresent(
				key_indicatorIndex = ${indicatorIndex},
				locator1 = "HomePage#CAROUSEL_NEWS_SWIPER_INDICATOR_INACTIVE");
		}
	}

	@summary = "View carousel video swiper with video"
	macro viewVideoCarouselSwiper {
		Default.ScrollWebElementIntoView(locator1 = "HomePage#CAROUSEL_CARD_VIDEO_SECTION");

		Default.AssertElementPresent(locator1 = "HomePage#CAROUSEL_CARD_VIDEO_BUTTON_NEXT");

		Default.AssertElementPresent(locator1 = "HomePage#CAROUSEL_CARD_VIDEO_SWIPER");
	}

	@summary = "Validates if the preposition 'of' has been translated to 'de' in video carousel"
	macro viewVideoCountPrepositionIsTranslated {
		Default.AssertElementPresent(
			key_preposition = ${preposition},
			locator1 = "HomePage#PREPOSITION_COUNT_VIDEO");
	}

	@summary = "View if carousel videos are present"
	macro viewVideoPresent {
		Default.ScrollWebElementIntoView(locator1 = "HomePage#CAROUSEL_CARD_VIDEO_BUTTON_NEXT");

		for (var index : list "1,2,3") {
			Default.AssertElementPresent(
				key_indexVideo = ${index},
				locator1 = "HomePage#VIDEO_SWIPER");

			Default.AssertElementPresent(
				key_indexSwiper = ${index},
				locator1 = "HomePage#VIDEO_SWIPER_ACTIVE");

			if (${index} != 3) {
				Default.Click.pauseClickAt(locator1 = "HomePage#CAROUSEL_CARD_VIDEO_BUTTON_NEXT");
			}
		}
	}

}