<html>
<head>
<title>Maps</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">Maps</td></tr>
</thead>

<tbody>

<tr>
	<td>COUNTRY_LIST</td>
	<td>//div[@class='control-panel']//ul[contains(@class,'select-list')]/li[contains(text(),'${key_country}')]</td>
	<td></td>
</tr>
<tr>
	<td>DETAILS_PAGE</td>
	<td>//div[@class='container']//*[contains(text(),'${key_detailsType}')]</td>
	<td></td>
</tr>
<tr>
	<td>MAPS_PICKUP_FILTER</td>
	<td>//button[contains(@class,'filter')]/*[contains(text(),'Filter')]</td>
	<td></td>
</tr>
<tr>
	<td>FOOTER_LINKS</td>
	<td>//div[contains(@class,'portlet-content')]//a[contains(text(),'${key_linkName'})]</td>
	<td></td>
</tr>
<tr>
	<td>ICON_TYPE_PLACE</td>
	<td>//button[contains(@class,'without-arrow')]//i[contains(@class,'type-place')]</td>
	<td></td>
</tr>
<tr>
	<td>MAP_SEARCH_SUGGESTIONS</td>
	<td>//ul[contains(@class,'smap-suggest')]</td>
	<td></td>
</tr>
<tr>
	<td>MAP_SEARCH_RESULTS_OPTION</td>
	<td>xpath=(//ul[contains(@class,'result list')]/li)[2]</td>
	<td></td>
</tr>
<tr>
	<td>MAP_SEARCH_RESULTS</td>
	<td>//div[contains(@class,'control-panel')]/ul[contains(@class,'result')]</td>
	<td></td>
</tr>
<tr>
	<td>MAP_FILTER_OPTIONS</td>
	<td>//div[contains(@class,'item')]//Label[contains(text(),'${key_filterOptions}')]</td>
	<td></td>
</tr>
<tr>
	<td>MAPS_SEARCH_FIELD</td>
	<td>//div[contains(@class,'search-form-group')]//input[(@id='mapy-cz-search-input')]</td>
	<td></td>
</tr>
<tr>
	<td>FIND_PARCELBOX_ICON</td>
	<td>//button[contains(@class,'without-arrow')][text()='${key_deliverShipment}']</td>
	<td></td>
</tr>
<tr>
	<td>SELECT_COUNTRY_DROPDOWN</td>
	<td>//div[@class='control-panel']//*[contains(text(),'Select country')]</td>
	<td></td>
</tr>
<tr>
	<td>SELECT_RESULT</td>
	<td>xpath=(//span[contains(@class,'result__item-title')])[1]</td>
	<td></td>
</tr>
<tr>
	<td>RESULT_ITEM_INDEX</td>
	<td>xpath=(//div[contains(@class,'item-info')]//span[contains(@class,'item-title')])[1]</td>
	<td></td>
</tr>
<tr>
	<td>RESULT_PLACE_BUTTON</td>
	<td>//button[(@type='button')][(text()='Select this place')]</td>
	<td></td>
</tr>
<tr>
	<td>LOADING_MAP_INDICATOR</td>
	<td>//div[@class='ppl-parcelshop-map']/div[contains(text(),'Loading map')]</td>
	<td></td>
</tr>
<tr>
	<td>SHOW_DETAIL_BUTTON</td>
	<td>//div[contains(@class,'control-panel')]/a/button[contains(text(),'detail')]</td>
	<td></td>
</tr>
<tr>
	<td>SHOW_RESULTS_BUTTON</td>
	<td>//button[contains(@class,'block')][contains(text(),'Show results')]</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>