<html>
<head>
<title>Complaints</title>
</head>

<body>

<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">Complaints</td></tr>
</thead>

<tbody>

<tr>
	<td>ATTACHMENTS_FILE_INPUT</td>
	<td>//input[@type='file'][contains(@id,'${key_fileInputOption}')]</td>
	<td></td>
</tr>
<tr>
	<td>CLAIMS_STEPPER</td>
	<td>//ul[contains(@class,'stepper')]//div[contains(@class,'${key_itemStatus}')]//div[contains(normalize-space(),'${key_itemName}')]</td>
	<td></td>
</tr>
<tr>
	<td>COMPLAINTS_FORM_INPUT</td>
	<td>//form//div[contains(@class,'form-group')]//label/following-sibling::input[contains(@name,'${key_inputName}')]</td>
	<td></td>
</tr>
<tr>
	<td>ERROR_NOTIFICATION</td>
	<td>//div[contains(@class,'error')]</td>
	<td></td>
</tr>
<tr>
	<td>CONTACT_DETAILS_FORM_INPUT</td>
	<td>//div[@class='container']//label//font[contains(text(),'${key_inputOption}')]/ancestor::label/following-sibling::input</td>
	<td></td>
</tr>
<tr>
	<td>FORM_RADIO_BUTTON</td>
	<td>//div[@class='container']//input/following-sibling::label[contains(text(),'${key_radioOption}')]</td>
	<td></td>
</tr>
<tr>
	<td>FORM_CHECKBOX</td>
	<td>//div[contains(@class,'checkbox')]/input[contains(@name,'${key_checkboxName}')]</td>
	<td></td>
</tr>
<tr>
	<td>SHIPMENT_CATEGORY_DROPDOWN</td>
	<td>//select[@name='shipmentCategory']</td>
	<td></td>
</tr>
<tr>
	<td>TEXTAREA_INPUT</td>
	<td>//div[contains(@class,'textarea')]/label//font[contains(text(),'${key_textareaLabel}')]</td>
	<td></td>
</tr>
<tr>
	<td>DROP_ZONE_ERROR_MESSAGE</td>
	<td>//div[contains(@class,'attachment')]//*[contains(@class,'drop-zone') and contains(@class,'error')]</td>
	<td></td>
</tr>
<tr>
	<td>FORM_CHECKBOX_NAME</td>
	<td>//div[contains(@class,'checkbox')]/input[contains(@name,'${key_checkboxName}')]</td>
	<td></td>
</tr>
<tr>
	<td>FORM_CHECKBOX_LABEL</td>
	<td>//div[contains(@class,'checkbox')]//following-sibling::label[contains(normalize-space(),'${key_checkboxLabel}')]</td>
	<td></td>
</tr>
<tr>
	<td>FORM_CHECKBOX_IMAGE</td>
	<td>//div[contains(@class,'checkbox')]/input[contains(@id,'${key_inputId}')]/following-sibling::label[contains(normalize-space(),'')]/img</td>
	<td></td>
</tr>
<tr>
	<td>SUMMARY_EDIT_BUTTON</td>
	<td>xpath=(//button[contains(text(),'${key_editOption}')])[${key_index}]</td>
	<td></td>
</tr>
<tr>
	<td>SUMMARY_TABLE_FIELD</td>
	<td>//table[@class='table-summary']//th[contains(text(),'${key_formField}')]/following-sibling::td[contains(text(),'${key_contentStatus}')]</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>