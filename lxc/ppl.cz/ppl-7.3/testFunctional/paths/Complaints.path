<html>
<head>
<title>Complaints</title>
</head>

<body>

<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">Complaints</td></tr>
</thead>

<tbody>

<tr>
	<td>COMPLAINTS_FORM_INPUTS</td>
	<td>//form//div[contains(@class,'form-group')]//label[contains(normalize-space(),'${key_inputLabels}')]/following-sibling::input</td>
	<td></td>
</tr>
<tr>
	<td>INPUT_FIELD_ERROR_MESSAGE</td>
	<td>//div[contains(@class,'has-error')]//*[contains(text(),'${key_errorType}')]</td>
	<td></td>
</tr>
<tr>
	<td>INCORRECT_ENTRIES_ERROR_MESSAGE</td>
	<td>//div[contains(@class,'notification--error')]//div[contains(text(),'Entries are incorrect')]</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>