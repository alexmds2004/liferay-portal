<html>
<head>
<title>Complaints</title>
</head>

<body>

<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">Complaints</td></tr>
</thead>

<tbody>

<tr>
	<td>COMPLAINTS_FORM_INPUT</td>
	<td>//form//div[contains(@class,'form-group')]//label[contains(normalize-space(),'${key_inputLabel}')]/following-sibling::input</td>
	<td></td>
</tr>
<tr>
	<td>ERROR_NOTIFICATION</td>
	<td>//div[contains(@class,'error')]</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>