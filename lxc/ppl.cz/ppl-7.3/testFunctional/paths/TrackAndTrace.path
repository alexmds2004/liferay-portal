<html>
<head>
<title>TrackAndTrace</title>
</head>

<body>

<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">TrackAndTrace</td></tr>
</thead>

<tbody>

<tr>
	<td>SHIPMENT_INPUT</td>
	<td>//input[@name='shipmentId']</td>
	<td></td>
</tr>
<tr>
	<td>SHIPMENT_ID</td>
	<td>//span[contains(@class,'cursor-pointer')][text()='${key_shipmentId}']</td>
	<td></td>
</tr>
<tr>
	<td>ERROR_MESSAGE</td>
	<td>//div[contains(@class,'error')]//span[contains(text(),'${key_errorMessage}')]</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>