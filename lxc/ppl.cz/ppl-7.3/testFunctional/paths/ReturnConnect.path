<html>
<head>
<title>ReturnConnect</title>
</head>

<body>

<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">ReturnConnect</td></tr>
</thead>

<tbody>

<tr>
	<td>ANY_BUTTON_RETURN_GOODS</td>
	<td>//div[@class='banner__item']/a[@data-lfr-editable-id="tile${key_buttonNumber}Button"]</td>
	<td></td>
</tr>
<tr>
	<td>RETURN_LABEL_BUTTON</td>
	<td>//div[contains(@id,'return-connect-search')]//button[@type='submit']</td>
	<td></td>
</tr>
<tr>
	<td>RETURN_CONSIGNMENT_BUTTON</td>
	<td>xpath=(//div[@id="pickupSelectionRow"]//a[contains(@data-lfr-editable-id,'returnMethodLink')])[${key_index}]</td>
	<td></td>
</tr>
<tr>
	<td>CONSIGNMENT_INPUT</td>
	<td>//div[@class='portlet-body']//input[@name='${key_inputName}']</td>
	<td></td>
</tr>
<tr>
	<td>ZOBRAZIT_SECTION</td>
	<td>//section[@id='portlet_parcelshops']//*[text()='${key_name}']</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>