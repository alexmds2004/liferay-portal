definition {

	@summary = "Click on Continue complaint form button"
	macro continueForm {
		Portal.Button.click(button = "Continue");
	}

	@summary = "Fill the complaints form"
	macro fillComplaintForm {
		if (isSet(shipmentNumber)) {
			Default.Type(
				key_inputLabel = "Shipment number",
				locator1 = "Complaints#COMPLAINTS_FORM_INPUT",
				value1 = "${shipmentNumber}");
		}

		if (isSet(postCode)) {
			Default.Type(
				key_inputLabel = "Postcode",
				locator1 = "Complaints#COMPLAINTS_FORM_INPUT",
				value1 = "${postCode}");
		}
	}

	@summary = "Click on Submit complaints Form button"
	macro submitForm {
		Portal.Button.clickSubmitButton();
	}

	@summary = "View if required field error message appears/is visible"
	macro viewFieldRuleMessage {
		Default.AssertVisible(
			key_errorMessage = "${errorMessage}",
			locator1 = "Complaints#INPUT_FIELD_ERROR_MESSAGE");
	}

	@summary = "View if the entries are incorrect"
	macro viewIncorrectEntriesMessage {
		Default.AssertVisible(
			key_errorMessage = "${errorMessage}",
			locator1 = "Complaints#SUBMIT_ENTRIES_ERROR_MESSAGE");
	}

	@summary = "View if Uncompleted claim error message is visible"
	macro viewUncompletedClaimErrorMessage {
		Default.AssertVisible(
			key_errorMessage = "${errorMessage}",
			locator1 = "Complaints#SUBMIT_ENTRIES_ERROR_MESSAGE");
	}

}