definition {

	@summary = "Continue complaint form button"
	macro continueForm {
		Default.Click(locator1 = "Complaints#CONTINUE_FORM_BUTTON");
	}

	@summary = "Fill the complaints form"
	macro fillComplaintForm {
		Default.Type(
			key_inputLabels = "${inputLabels}",
			locator1 = "Complaints#COMPLAINTS_FORM_INPUTS",
			value1 = "${typeInput}");
	}

	@summary = "Go to Damaged shipment section"
	macro gotoDamagedShipment {
		General.scrollToFooter();

		Default.Click(
			key_linkName = "Damaged shipment",
			locator1 = "General#FOOTER_LINKS");
	}

	@summary = "Submit complaints Form"
	macro submitForm {
		Default.Click(locator1 = "Complaints#SUBMIT_FORM_BUTTON");
	}

}