definition {

	@summary = "Click on Continue complaint form button"
	macro continueForm {
		Portal.Button.click(button = "Continue");
	}

	@summary = "Fill the form"
	macro fillForm {
		if (isSet(shipmentNumber)) {
			Default.Type(
				key_inputLabel = "Shipment number",
				locator1 = "Complaints#COMPLAINTS_FORM_INPUT",
				value1 = "${shipmentNumber}");
		}

		if (isSet(postCode)) {
			Default.Type(
				key_inputLabel = "Postcode",
				locator1 = "Complaints#COMPLAINTS_FORM_INPUT",
				value1 = "${postCode}");
		}

		if (isSet(emailAddress)) {
			Default.Type(
				key_inputLabel = "e-mail",
				locator1 = "Complaints#COMPLAINTS_FORM_INPUT",
				value1 = "${emailAddress}");
		}

		if (isSet(phoneNumber)) {
			Default.Type(
				key_inputLabel = "Phone",
				locator1 = "Complaints#COMPLAINTS_FORM_INPUT",
				value1 = "${phoneNumber}");
		}

		if (isSet(companyName)) {
			Default.Type(
				key_inputLabel = "company name",
				locator1 = "Complaints#COMPLAINTS_FORM_INPUT",
				value1 = "${companyName}");
		}

		if (isSet(streetNumber)) {
			Default.Type(
				key_inputLabel = "Street and number",
				locator1 = "Complaints#COMPLAINTS_FORM_INPUT",
				value1 = "${streetNumber}");
		}

		if (isSet(city)) {
			Default.Type(
				key_inputLabel = "City",
				locator1 = "Complaints#COMPLAINTS_FORM_INPUT",
				value1 = "${city}");
		}

		if (isSet(priceOfContent)) {
			Default.Type(
				key_inputLabel = "Price",
				locator1 = "Complaints#COMPLAINTS_FORM_INPUT",
				value1 = "${priceOfContent}");
		}
	}

	@summary = "Click on Submit complaint form button"
	macro submitForm {
		Portal.Button.clickSubmitButton();
	}

	@summary = "Validating an error message that appears when the entry is wrong/invalid"
	macro viewIncorrectEntryMessage {
		Default.AssertVisible(locator1 = "Complaints#ERROR_NOTIFICATION");
	}

}