definition {

	@summary = "Click on Continue complaint form button"
	macro continueForm {
		Portal.Button.click(button = "Continue");
	}

	@summary = "Fill the complaints form"
	macro fillComplaintForm {
		Default.Type(
			key_inputLabel = "${inputLabel}",
			locator1 = "Complaints#COMPLAINTS_FORM_INPUT",
			value1 = "${inputValue}");
	}

	@summary = "Go to Damaged shipment section"
	macro gotoDamagedShipment {
		General.scrollToFooter();

		Default.Click(
			key_linkName = "Damaged shipment",
			locator1 = "General#FOOTER_LINKS");
	}

	@summary = "Click on Submit complaints Form button"
	macro submitForm {
		Portal.Button.clickSubmitButton();
	}

	@summary = "View if required field error message appears/is visible"
	macro viewFieldIsRequiredErrorMessage {
		Default.AssertVisible(
			key_errorType = "${errorType}",
			locator1 = "Complaints#INPUT_FIELD_ERROR_MESSAGE");
	}

	@summary = "View if the entries are incorrect"
	macro viewIncorrectEntries {
		Default.AssertVisible(locator1 = "Complaints#INCORRECT_ENTRIES_ERROR_MESSAGE");
	}

	@summary = "View if the entries are incorrect"
	macro viewIncorrectEntries {
		Default.AssertVisible(locator1 = "Complaints#INCORRECT_ENTRIES_ERROR_MESSAGE");
	}

}