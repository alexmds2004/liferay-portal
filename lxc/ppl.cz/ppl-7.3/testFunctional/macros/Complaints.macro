definition {

	@summary = "Click on Continue complaint form button"
	macro continueForm {
		Portal.Button.click(button = "Continue");
	}

	@summary = "Fill the form"
	macro fillForm {
		if (isSet(shipmentNumber)) {
			Default.Type(
				key_inputLabel = "Shipment number",
				locator1 = "Complaints#COMPLAINTS_FORM_INPUT",
				value1 = "${shipmentNumber}");
		}

		if (isSet(postCode)) {
			Default.Type(
				key_inputLabel = "Postcode",
				locator1 = "Complaints#COMPLAINTS_FORM_INPUT",
				value1 = "${postCode}");
		}

		if (isSet(emailAddress)) {
			Default.Type(
				key_inputLabel = "e-mail",
				locator1 = "Complaints#COMPLAINTS_FORM_INPUT",
				value1 = "${emailAddress}");
		}

		if (isSet(phoneNumber)) {
			Default.Type(
				key_inputLabel = "Phone",
				locator1 = "Complaints#COMPLAINTS_FORM_INPUT",
				value1 = "${phoneNumber}");
		}

		if (isSet(companyName)) {
			Default.Type(
				key_inputLabel = "company name",
				locator1 = "Complaints#COMPLAINTS_FORM_INPUT",
				value1 = "${companyName}");
		}

		if (isSet(streetNumber)) {
			Default.Type(
				key_inputLabel = "Street and number",
				locator1 = "Complaints#COMPLAINTS_FORM_INPUT",
				value1 = "${streetNumber}");
		}

		if (isSet(city)) {
			Default.Type(
				key_inputLabel = "City",
				locator1 = "Complaints#COMPLAINTS_FORM_INPUT",
				value1 = "${city}");
		}

		if (isSet(priceOfContent)) {
			Default.Type(
				key_inputLabel = "Price",
				locator1 = "Complaints#COMPLAINTS_FORM_INPUT",
				value1 = "${priceOfContent}");
		}
	}

	@summary = "Fill textarea input"
	macro fillTextareaInput {
		if (isSet(describeContent)) {
			Default.Type(
				key_text = "contentDescription",
				locator1 = "Portal.TextArea#ANY",
				value1 = "${describeContent}");
		}

		if (isSet(describeDamage)) {
			Default.Type(
				key_text = "shipmentDamageDescription",
				locator1 = "Portal.TextArea#ANY",
				value1 = "${describeDamage}");
		}

		if (isSet(additionalInformation)) {
			Default.Type(
				key_text = "damageAdditionalData",
				locator1 = "Portal.TextArea#ANY",
				value1 = "${additionalInformation}");
		}

		if (isSet(describePartialMissing)) {
			Default.Type(
				key_text = "shipmentPartialMissingDescription",
				locator1 = "Portal.TextArea#ANY",
				value1 = "${describePartialMissing}");
		}

		if (isSet(describeMissing)) {
			Default.Type(
				key_text = "shipmentMissingDescription",
				locator1 = "Portal.TextArea#ANY",
				value1 = "${describePartialMissing}");
		}
	}

	@summary = "Select a option in a checkbox input"
	macro selectComplaintCheckbox {
		if (isSet(inputId)) {
			Default.Click(
				key_inputId = "${inputId}",
				locator1 = "Complaints#FORM_CHECKBOX_IMAGE");
		}

		if (isSet(checkboxLabel)) {
			Default.Click(
				key_checkboxLabel = "${checkboxLabel}",
				locator1 = "Complaints#FORM_CHECKBOX_LABEL");
		}

		if (isSet(checkboxName)) {
			Default.Click(
				key_checkboxName = "${checkboxName}",
				locator1 = "Complaints#FORM_CHECKBOX_NAME");
		}
	}

	@summary = "Select a option in a radio input"
	macro selectComplaintRadio {
		Default.Click(
			key_radioOption = "${radioOption}",
			locator1 = "Complaints#FORM_RADIO_BUTTONS");
	}

	@summary = "Select a option in shipment category dropdown input"
	macro selectShipmentCategoryDropdown {
		Default.Select(
			locator1 = "Complaints#SHIPMENT_CATEGORY_DROPDOWN",
			value1 = "${shipmentCategoryOption}");
	}

	@summary = "Click on Submit complaint form button"
	macro submitForm {
		Portal.Button.clickSubmitButton();
	}

	@summary = "Upload a file to the 'Attachments' Form"
	macro uploadFile {
		var filePath = Utils.getFilePath(fileName = "${fileName}");

		Default.UploadFile(
			key_fileInputOption = "${fileInputOption}",
			locator1 = "Complaints#ATTACHMENTS_FILE_INPUT",
			value1 = "${filePath}");
	}

	@summary = "View the stepper status in claims form"
	macro viewClaimStatus {
		Default.AssertElementPresent(
			key_itemName = "${itemName}",
			key_itemStatus = "${itemStatus}",
			locator1 = "Complaints#CLAIMS_STEPPER");
	}

	@summary = "Validating an error message that appears when the entry is wrong/invalid"
	macro viewIncorrectEntryMessage {
		Default.AssertVisible(locator1 = "Complaints#ERROR_NOTIFICATION");
	}

	// PPL Refactor: This macro is a workaround it is needed in the 7.3 (due to a checkbox input issue)
	// PPL Refactor Ticket: PPLUPGD1122-78

	@summary = "Check the 'Privacy Conditions' checkbox"
	macro checkPrivacyConditions {
		Default.KeyPress(
			key_inputLabel = "Postcode",
			locator1 = "Complaints#COMPLAINTS_FORM_INPUT",
			value1 = "\TAB");

		Default.KeyPress(
			key_checkboxName = "privacyConditions",
			locator1 = "Complaints#FORM_CHECKBOX_NAME",
			value1 = "\SPACE");
	}

	@summary = "check if the inputed data is the one appearing in the summary table"
	macro viewInputtedData {
		Default.AssertVisible(
			key_formField = "${formField}",
			key_inputtedData = "${inputtedData}",
			locator1 = "Complaints#SUMMARY_TABLE_FIELD");
	}

	@summary = "check if a invalid type of document was attached"
	macro viewInvalidDocumentErrorMessage {
		Default.AssertElementPresent(locator1 = "Complaints#DROP_ZONE_ERROR_MESSAGE");
	}

}