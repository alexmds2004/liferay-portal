definition {

	@summary = "Continue complaint form button"
	macro continueForm {
		Default.Click(locator1 = "Complaints#CONTINUE_FORM_BUTTON");
	}

	@summary = "Fill the complaints form"
	macro fillComplaintForm {
		Default.Type(
			key_inputLabels = "${inputLabels}",
			locator1 = "Complaints#COMPLAINTS_FORM_INPUTS",
			value1 = "${typeInput}");
	}

}