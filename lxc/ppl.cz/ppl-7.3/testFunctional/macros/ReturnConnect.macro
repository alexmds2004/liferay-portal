definition {

	@summary = "Navigates to the 'Returning goods' tab"
	macro gotoReturnShipment {
		var key_linkName = "Returning goods";
		var key_numberButton = "${numberButton}";

		Default.Click(locator1 = "General#FOOTER_LINKS");

		Default.Click(locator1 = "ReturnConnect#ANY_BUTTON_RETURN_GOODS");
	}

}