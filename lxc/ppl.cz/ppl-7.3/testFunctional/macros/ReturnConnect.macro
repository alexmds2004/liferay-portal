definition {

	@summary = "Navigates to the 'Returning goods' tab"
	macro gotoReturnShipment {
		var key_linkName = "Returning goods";
		var key_numberButton = ${numberButton};

		Default.Click(locator1 = "General#FOOTER_LINKS");

		Default.Click(locator1 = "ReturnConnect#ANY_BUTTON_RETURN_GOODS");
	}

	@summary = "Enters the shipment number and/or zip code into their respective fields"
	macro returningAConsignment {
		var key_inputName = ${inputName};

		Default.Type(
			locator1 = "ReturnConnect#INPUT_CONSIGNMENT",
			value1 = ${inputValue});

		if (${buttonSubmit} == "true") {
			Default.Click(locator1 = "ReturnConnect#BUTTON_RETURN_LABEL");
		}
	}

	@summary = "Selects the return method and chooses the selected address from the map"
	macro sendReturnConsignment {
		var key_methodReturn = ${methodReturn};

		Default.Click(locator1 = "ReturnConnect#BUTTON_RETURN_CONSIGNMENT");

		Default.Type(
			locator1 = "Maps#MAPS_SEARCH_FIELD",
			value1 = ${mapInput});

		Default.KeyPress(
			locator1 = "Maps#MAPS_SEARCH_FIELD",
			value1 = "\DOWN");

		Default.KeyPress(
			locator1 = "Maps#MAPS_SEARCH_FIELD",
			value1 = "\ENTER");

		Default.Click(locator1 = "Maps#RESULT_ITEM_INDEX");

		Default.Click(locator1 = "Maps#DEATILS_ZOBRAZIT");
	}

	@summary = "validates if the error message appeared"
	macro viewErrorMessage {
		Default.AssertElementPresent(
			key_errorMessage = ${errorMessage},
			locator1 = "TrackAndTrace#ERROR_MESSAGE");
	}

	@summary = "Validate if the data confirmation page has loaded"
	macro viewIfThePageHasLoaded {
		Default.SelectWindow.selectPopUp(locator1 = "null");

		for (var elementName : list "Kontaktní informace,Služby") {
			Default.AssertElementPresent(
				key_name = ${elementName},
				locator1 = "ReturnConnect#ZOBRAZIT_PAGE");
		}

		Default.SelectWindow.selectPopUp(locator1 = "null");
	}

}