definition {

	@summary = "Accept the conditions"
	macro acceptConditions {
		Default.ScrollWebElementIntoView(locator1 = "General#ACCEPT_CONDITIONS");

		Default.Click(locator1 = "General#ACCEPT_CONDITIONS");
	}

	@summary = "Accept Cookies"
	macro acceptCookies {
		Default.Click(locator1 = "General#ACCEPT_COOKIES");
	}

	@summary = "Accept the terms and conditions"
	macro acceptTermsAndConditions {
		Default.WaitForPageLoad();

		Default.ScrollWebElementIntoView(locator1 = "General#ACCEPT_TERMS_CONDITIONS");

		Default.Click(locator1 = "General#ACCEPT_TERMS_CONDITIONS");
	}

	@summary = "Click in pay button"
	macro buttonPay {
		Default.MouseOver(locator1 = "General#BUTTON_PAY");

		Default.Click(locator1 = "General#BUTTON_PAY");
	}

	@summary = "Scroll into fotter section"
	macro scrollToFooter {
		Default.ScrollWebElementIntoView(locator1 = "General#FOOTER");

		Default.WaitForVisible(locator1 = "General#FOOTER");
	}

	@summary = "Choose a language for the page"
	macro selectLanguage {
		Default.Select(
			locator1 = "General#LANGUAGE_BUTTON",
			value1 = "${language}");
	}

	@summary = "Click in submit button"
	macro submit {
		Default.Click(
			key_buttonSubmit = "${buttonSubmit}",
			locator1 = "General#BUTTON_SUBMIT");
	}

	@summary = "View page is properly loaded"
	macro viewPage {
		if (isSet(headerText)) {
			Default.WaitForVisible(
				key_headerText = "${headerText}",
				locator1 = "General#HEADER_TEXT");
		}

		if (isSet(pageText)) {
			Default.WaitForVisible(
				key_text = "${pageText}",
				locator1 = "General#TEXT_ANY");
		}

		if (isSet(partialURL)) {
			var lowerCasePartialURL = StringUtil.toLowerCase("${partialURL}");

			Default.AssertLocation.assertPartialLocation(value1 = "${lowerCasePartialURL}");
		}
	}

}