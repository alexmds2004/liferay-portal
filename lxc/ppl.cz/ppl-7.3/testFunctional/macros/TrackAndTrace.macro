definition {

	@summary = "Search for shipment tracking using shipment number"
	macro searchShipmentTracking {
		Default.Click(locator1 = "TrackAndTrace#SHIPMENT_INPUT");

		Default.Type(
			locator1 = "TrackAndTrace#SHIPMENT_INPUT",
			value1 = "${shipmentInput}");

		General.submit(buttonSubmit = "Track a shipment");
	}

	@summary = "View if the error message is displayed"
	macro viewErrorMessage {
		Default.AssertElementPresent.pauseAssertVisible(
			key_textErrorMessage = "${textErrorMessage}",
			locator1 = "TrackAndTrace#ERROR_MESSAGE");
	}

}