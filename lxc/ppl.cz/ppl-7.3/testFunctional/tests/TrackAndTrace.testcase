definition {

	setUp {
		Utils.launchUatHomePage();

		General.acceptCookies();
	}

	@description = "Automation ID: PPLUPGD1122-55 | Test Summary: Verify that an error message is displayed when the user insert a incorrect shippment number"
	@priority = "5"
	test CannotTrackParcelWithInvalidShippmentNumber {
		task ("Given I accept cookies and navigate to 'Track a shipment'") {
			General.acceptCookies();

			Menu.gotoMenuItem(menuItem = "Track a shipment");
		}

		task ("When I click the button to search for the shipment without adding any shipment number") {
			General.submit(buttonSubmit = "Track a shipment");
		}

		task ("Then the error message 'This field is required' is displayed") {
			TrackAndTrace.viewErrorMessage(textErrorMessage = "This field is required");
		}

		task ("When I search for an invalid tracking code") {
			TrackAndTrace.searchShipmentTracking(shipmentInput = "13578925");
		}

		task ("Then the error message is 'Shipment not found' displayed") {
			TrackAndTrace.viewErrorMessage(textErrorMessage = "Shipment not found");
		}
	}

}