definition {

	setUp {
		Utils.launchUatHomePage();

		General.acceptCookies();
	}

	@description = "Automation ID: PPLUPGD1122-46 | Test Summary: Verify that the user is able to filter pick up points using the available filters"
	@priority = "5"
	test CanFilterPickUpPoints {
		task ("Given the user navigate to pickup map") {
			Maps.gotoPickupMap();

			General.viewPage(partialURL = "/mapa-vydejnich-mist");

			Maps.viewControlPanel(selectCountryLangVariation = "Vyberte zemi");
		}

		task ("When the user select a country and search for a location and get the name of the first item in results list") {
			Maps.selectCountryDropdown(
				country = "Česko",
				selectCountryLangVariation = "Vyberte zemi");

			Maps.searchForLocation(searchInput = "Sokolovská 651/136a, praha");

			var beforeFilterActive = Maps.getPickUpPointNameBeforeFilter();
		}

		task ("Then the nearest's pickup points should be available in the results") {
			Maps.viewSearchResult();
		}

		task ("When the user selects the filter's that he wants") {
			Maps.openFilterOptions(filterLanguageVariation = "Filtrovat místa");

			Maps.selectPickupFilters(filterOptions = "Parcelshop");

			Maps.selectPickupFilters(filterOptions = "Neděle");

			Maps.selectPickupFilters(filterOptions = "Platba kartou");

			Maps.selectPickupFilters(filterOptions = "Malá");

			Maps.showFilterResults(showResultsLangVariation = "Zobrazit místa");

			var afterFilterActive = Maps.getPickUpPointNameAfterFilter();
		}

		task ("Then the list of pickup points should be different than before") {
			Portal.TestUtils.assertNotEquals(
				actual = "${afterFilter}",
				expected = "${beforeFilter}");
		}
	}

	@description = "Automation ID: PPLUPGD1122-39 | Test Summary: Verify that the user can search for a pickup point on the map and see the point details"
	@priority = "5"
	test CanSearchPickUpPoints {
		task ("Given the user navigate to pickup map") {
			Maps.gotoPickupMap();

			General.viewPage(partialURL = "/mapa-vydejnich-mist");

			Maps.viewControlPanel(selectCountryLangVariation = "Vyberte zemi");
		}

		task ("When the user select a country and search for a location") {
			Maps.selectCountryDropdown(
				country = "Česko",
				selectCountryLangVariation = "Vyberte zemi");

			Maps.searchForLocation(searchInput = "Sokolovská 651/136a, praha");
		}

		task ("Then the nearest's pickup points should be available in the results") {
			Maps.viewSearchResult();

			Maps.selectLocation();
		}

		task ("When the user open the details page") {
			Maps.gotoDetails();

			Default.SelectWindow.selectPopUp(locator1 = "null");
		}

		task ("Then the details about the pickup point shoud be displayed on the page") {
			Maps.viewDetailsPage(detailsType = "Kontaktní informace");

			Maps.viewDetailsPage(detailsType = "Služby");
		}
	}

}