<html>
<head>
<title>Checkout</title>
</head>

<body>

<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">Checkout</td></tr>
</thead>

<tbody>
<tr>
	<td>BUTTON_ADD_TO_CART</td>
	<td>xpath=(//div[@class='product-card-tiles']//button[contains(@class,'add-to-cart')])[${key_index}]</td>
	<td></td>
</tr>
<tr>
	<td>COMMERCE_PORTLET</td>
	<td>//div[contains(@class,'CommerceCheckoutPortlet')]</td>
	<td></td>
</tr>
<tr>
	<td>ORDER_DETAIL</td>
	<td>//section[contains(@id,'order') and contains(@id,'content')]//*[contains(text(),'Order')]//following-sibling::*[contains(text(),'${key_orderDetail}')]</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>