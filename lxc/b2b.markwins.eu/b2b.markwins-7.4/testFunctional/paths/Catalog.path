<html>
<head>
<title>Catalog</title>
</head>

<body>

<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">Catalog</td></tr>
</thead>

<tbody>
<tr>
	<td>FILTER_LIST</td>
	<td>xpath=(//div[contains(@id,'CategoriesNavigationWrapper')]//ul[contains(@class,'category-list')]//div[contains(@class,'tree-${key_retractableStatus}')]//*[contains(@class,'icon-${key_retractableStatusIcon}')]/..)[${key_indexList}]</td>
	<td></td>
</tr>
<tr>
	<td>FILTER_LIST_ITEM</td>
	<td>xpath=(//div[contains(@id,'CategoriesNavigationWrapper')]//li[contains(@class,'tree-node')]/div/following-sibling::ul//a)[${key_indexItem}]</td>
	<td></td>
</tr>
<tr>
	<td>CATALOG_HEADER_TITLE</td>
	<td>//div[contains(@class,'category-detail')]//*[contains(@class,'category-title')][contains(text(),'${key_headerTitle}')]</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>