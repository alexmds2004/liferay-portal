definition {

	@summary = "Add a product to the cart from catalog page"
	macro addProductToCart {
		Default.WaitForPageLoad();

		Default.WaitForVisible(locator1 = "Portal.CommerceAccelerators#MINI_CART_BUTTON");

		Default.Click.pauseClickAt(
			key_index = 1,
			locator1 = "Checkout#BUTTON_ADD_TO_CART");
	}

	@summary = "Get the order ID in the order summary section"
	macro getOrderId {
		Default.WaitForVisible(locator1 = "Checkout#ORDER_ID_FIELD");

		var orderId = selenium.getAttribute("//div[contains(@class,'order-summary')]//div[contains(@class,'form-group')]/input[contains(@id,'OrderNumber')]@value");

		return ${orderId};
	}

	@summary = "Navigate to the order details page"
	macro gotoOrderDetails {
		Default.Click(
			key_buttonLabel = "Order Details",
			locator1 = "Checkout#ORDER_DETAIL_REDIRECT_BUTTON");
	}

	@summary = "Proceed with the checkout and choose the shipping method"
	macro proceedCommerceCheckout {
		Default.WaitForVisible(locator1 = "Checkout#COMMERCE_PORTLET");

		Default.Click.mouseOverClick(locator1 = "Portal.Button#CONTINUE");

		var orderId = Checkout.getOrderId();

		Default.Click.mouseOverClick(locator1 = "Portal.Button#CONTINUE");

		return ${orderId};
	}

	@summary = "Submit the purchase in the mini cart"
	macro submitMiniCartCheckout {
		Default.Click.mouseOverClick(locator1 = "Portal.CommerceAccelerators#MINI_CART_BUTTON");

		Portal.Button.click(button = "Submit");
	}

	@summary = "Assert that the the order is with a pending status after completing a checkout"
	macro viewOrderDetails {
		Default.WaitForVisible(
			key_orderDetail = ${orderDetail},
			locator1 = "Checkout#ORDER_DETAIL");

		Default.WaitForVisible(
			key_orderDetail = "Pending",
			locator1 = "Checkout#ORDER_DETAIL");
	}

	@summary = "View success message after completing the checkout"
	macro viewSuccessMessage {
		Default.AssertElementPresent(
			locator1 = "Portal.CommerceAccelerators#CHECKOUT_SUCCESS_MESSAGE",
			value1 = "Success! Your order has been processed.");
	}

}