definition {

	@summary = "Perform login process"
	macro signIn {
		var loginUserName = PropsUtil.get("test.this.markwins.test.account.uat.admin.login");
		var loginUserPassword = PropsUtil.get("test.this.markwins.test.account.uat.admin.password");

		Default.WaitForVisible(locator1 = "Portal.Button#SIGN_IN");

		Default.Type(
			key_text = "Screen Name",
			locator1 = "Portal.TextInput#ANY",
			value1 = ${loginUserName});

		Default.Type(
			key_text = "Password",
			locator1 = "Portal.TextInput#ANY",
			value1 = ${loginUserPassword});

		Default.Click(locator1 = "Portal.Button#SIGN_IN");

		Default.WaitForPageLoad();
	}

}