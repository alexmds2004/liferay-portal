definition {

	setUp {
		Utils.launchHomePage();

		Login.signIn();
	}

	@description = "Automation ID: PPUMK2302-38 | Test Summary: Verify that the user is able to filter the products"
	@priority = 5
	test CanFilterProducts {
		task ("Given the user is redirected to the catalog page") {
			Navigate.gotoSidebarItem(navItemName = "Catalog");
		}

		task ("When the user selects a filter") {
			var filterName = Catalog.getFilterName(indexItem = 2);

			Catalog.selectFilter(indexItem = 2);
		}

		task ("Then the selected filter name should be visible in the top of the page") {
			Catalog.viewAppliedFilter(headerTitle = ${filterName});
		}
	}

}