definition {

	setUp {
		Utils.launchHomePage();

		Login.signIn();
	}

	@description = "Automation ID: PPUMK2302-31 | Test Summary: Verify that is possible to download a brand template"
	@priority = 5
	test CanDownloadBrandTemplate {
		task ("When the user selects a brand template to download") {
			HomePage.downloadBrandTemplate(brandName = "Markwins Intl");
		}

		task ("Then the selected brand template should be downloaded") {
			HomePage.viewDownloadedBrandTemplate(FileBrandName = "Markwins-Intl");
		}
	}

	@description = "Automation ID: PPUMK2302-36 | Test Summary: Verify that the buyer is not able to upload the order using an invalid template with the incorrect amount of items"
	@priority = 5
	test CantUploadInvalidTemplate {
		task ("When the user Uploads an invalid brand template") {
			HomePage.uploadBrandTemplate(fileName = "InvalidTemplate.xlsx");
		}

		task ("Then an error message should be displayed") {
			HomePage.viewUploadedTemplate(
				fileName = "InvalidTemplate.xlsx",
				invalidTemplateMessage = "not valid");
		}
	}

	@description = "Automation ID: PPUMK2302-34 | Test Summary: Verify that isn't possible for the buyer to upload a file with unsupported format"
	@priority = 5
	test CantUploadUnsupportedFileFormat {
		task ("When the user Uploads an unsupported file format") {
			HomePage.uploadBrandTemplate(fileName = "UnsupportedFile.png");
		}

		task ("Then an error message should be displayed") {
			HomePage.viewUploadedTemplate(
				fileName = "UnsupportedFile.png",
				unsupportedFileMessage = "not supported");
		}
	}

	@description = "Automation ID: PPUMK2302-36 | Test Summary: Verify that the buyer is able to upload the order using a valid template with the correct amount of items"
	@priority = 5
	test CanUploadValidTemplate {
		task ("When the user Uploads an valid brand template") {
			HomePage.uploadBrandTemplate(fileName = "ValidTemplate.xlsx");
		}

		task ("Then a success message should be displayed") {
			HomePage.viewUploadedTemplate(
				fileName = "ValidTemplate.xlsx",
				validTemplateMessage = "uploaded successfully");
		}
	}

}