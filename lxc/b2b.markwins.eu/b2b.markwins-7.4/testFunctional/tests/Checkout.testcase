definition {

	setUp {
		Utils.launchHomePage();

		Login.signIn();
	}

	@description = "Automation ID: PPUMK2302-27 | Test Summary: Verify that the customer is able to complete a checkout"
	@priority = 5
	test CanCompleteCheckout {
		task ("Given that I navigate to Catalog menu") {
			Portal.CommerceNavigator.gotoMiniumSidebarItem(menuItem = "Catalog");
		}

		task ("When I add a product to the cart and submit to checkout in the mini cart") {
			Checkout.addProductToCart();

			Checkout.submitMiniCartCheckout();
		}

		task ("And I proceed with the steps to complete the checkout and choose the shipping method") {
			var orderId = Checkout.proceedCommerceCheckout();
		}

		task ("Then the success message informs you that the request has been processed") {
			Checkout.viewSuccessMessage();
		}

		task ("When I go to the order details section") {
			Checkout.gotoOrderDetails();
		}

		task ("Then the order details should be visible in the page") {
			Checkout.viewOrderDetails(orderDetail = ${orderId});
		}
	}

}