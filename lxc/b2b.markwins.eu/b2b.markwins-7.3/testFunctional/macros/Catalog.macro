definition {

	@summary = "Get the name of the selected Filter"
	macro getFilterName {
		var key_indexItem = ${indexItem};
		var filterName = selenium.getText("Catalog#FILTER_LIST_ITEM");

		return ${filterName};
	}

	@summary = "Select a filter from the catalog section"
	macro selectFilter {
		Default.Click(
			key_indexList = 1,
			key_retractableStatus = "collapsed",
			locator1 = "Catalog#FILTER_LIST");

		Default.Click(
			key_indexItem = ${indexItem},
			locator1 = "Catalog#FILTER_LIST_ITEM");
	}

	@summary = "Assert that the selected filter was applied"
	macro viewAppliedFilter {
		Default.WaitForVisible(
			key_headerTitle = ${headerTitle},
			locator1 = "Catalog#CATALOG_HEADER_TITLE");
	}

}