definition {

	@summary = "Get the name of the selected Filter"
	macro getFilterName {
		var key_indexItem = ${indexItem};
		var filterName = selenium.getText("Catalog#FILTER_LIST_ITEM");

		return ${filterName};
	}

	@summary = "Navigate to the catalog page"
	macro gotoCatalogPage {
		Default.Click.clickAtNotVisible(
			key_navItemName = ${navItemName},
			locator1 = "Catalog#CATALOG_NAV_MENU_ITEM");
	}

}