definition {

	@summary = "Add a product to the cart"
	macro addProductsToCart {
		Default.WaitForPageLoad();

		Default.WaitForVisible(locator1 = "Portal.CommerceAccelerators#MINI_CART_BUTTON");

		Default.Click.pauseClickAt(
			key_index = 1,
			locator1 = "Checkout#BUTTON_ADD_TO_CART");
	}

	@summary = "Proceed with the checkout and choose the shipping method"
	macro proceedCommerceCheckout {
		Default.WaitForVisible(locator1 = "Checkout#COMMERCE_PORTLET");

		Default.Click.mouseOverClick(locator1 = "Portal.Button#CONTINUE");

		Default.Click(
			key_text = "Expedited",
			locator1 = "Checkout#SHIPPING_OPTION");

		Default.Click.mouseOverClick(locator1 = "Portal.Button#CONTINUE");

		Default.Click.mouseOverClick(locator1 = "Portal.Button#CONTINUE");

		Default.Click(locator1 = "Portal.Button#CONTINUE");
	}
