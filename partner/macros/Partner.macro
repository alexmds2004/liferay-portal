definition {

	var partnerAdminEmailAddress = PropsUtil.get("partner.admin.email.address");
	var partnerAdminPassword = PropsUtil.get("partner.admin.password");
	var partnerURL = PropsUtil.get("partner.portal.url");
	var partnerURLLogin = PropsUtil.get("partner.portal.url.login");

	macro gotoRelativeURL {
		Open(locator1 = "${partnerURL}/${url}");

		WaitForSPARefresh();
	}

	macro loginToPortal {
		Open(locator1 = "${partnerURLLogin}");
		
		Type.typePause(
			locator1 = "Partner#EMAIL_ADDRESS",
			value1 = ${partnerAdminEmailAddress});

		Type.typePause(
			locator1 = "Partner#PASSWORD",
			value1 = ${partnerAdminPassword});

		if (isSet(rememberMeChecked) && (${rememberMeChecked} == "true")) {
			Check(locator1 = "Partner#REMEMBER_ME");
		}

		Click(locator1 = "Partner#SIGN_IN_BUTTON");

		Pause(locator1 = 5000);
	}

	macro viewFooterNavigationLinks {
		var key_positionValue = 1;
		var linksRemain = "true";

		if (IsElementPresent(locator1 = "Partner#FOOTER_LINK")) {
			var pageElementsFound = ${pageElementsFound} + 1;

			while ((${linksRemain} == "true") && (${key_positionValue} != 15)) {
				while (IsElementPresent(locator1 = "Partner#FOOTER_LINK")) {
					var footerNavigationLink = selenium.getAttribute("xpath=(//h4[contains(@class,'nav-item-header')]/following-sibling::ul//a)[${key_positionValue}]@href");

					var curl = '''
						${footerNavigationLink} -I
					''';

					var httpResponseStatusCode = JSONCurlUtil.get(${curl});

					if (contains(${httpResponseStatusCode}, "HTTP/2 400") || contains(${httpResponseStatusCode}, "HTTP/2 404")) {
						echo("The ${footerNavigationLink} page is not working properly.");

						var key_positionValue = ${key_positionValue} + 1;
					}
					else {
						echo("The ${footerNavigationLink} page is working properly.");

						var key_positionValue = ${key_positionValue} + 1;
					}
				}
			}

			var linksRemain = "false";
		}
	}

	macro viewPage {
		static var pageElementsFound = 0;

		Partner.loginToPortal();
		
		Partner.gotoRelativeURL(url = ${url});

		if (${url} == "") {
			Partner.viewTopInfoNavigationLinks();
		}

		Partner.viewPageImages();

		Partner.viewPageLinks();

		if (${url} == "") {
			Partner.viewFooterNavigationLinks();
		}

		if (${url} == "") {
			Partner.viewSocialMediaFooterNavigationLinks();
		}

		echo("Total page elements found: ${pageElementsFound}");

		if (${pageElementsFound} == 0) {
			fail("No page elements were found on the page with the relative url ${url}. This could mean that the page element paths need to be updated or it could indicate a problem with the site page. Please investigate.");
		}
	}

	macro viewPageImages {
		var key_positionValue = 1;
		var imagesRemain = "true";

		if (IsElementPresent(locator1 = "Partner#PAGE_IMAGE")) {
			var pageElementsFound = ${pageElementsFound} + 1;

			while ((${imagesRemain} == "true") && (maxIterations = "50")) {
				while ((IsElementPresent(locator1 = "Partner#PAGE_IMAGE")) && (maxIterations = "50")) {
					AssertElementPresent(locator1 = "Partner#PAGE_IMAGE");

					ScrollWebElementIntoView(locator1 = "Partner#PAGE_IMAGE");

					if (IsNotVisible(locator1 = "Partner#PAGE_IMAGE")) {
						AssertElementPresent(locator1 = "Partner#PAGE_IMAGE");
					}
					else {
						AssertVisible(locator1 = "Partner#PAGE_IMAGE");
					}

					var key_positionValue = ${key_positionValue} + 1;
				}
			}

			var imagesRemain = "false";
		}
	}

	macro viewPageLinks {
		var key_positionValue = 1;
		var linksRemain = "true";

		if (IsElementPresent(locator1 = "Partner#PAGE_LINK")) {
			var pageElementsFound = ${pageElementsFound} + 1;

			while ((${linksRemain} == "true") && (maxIterations = "100")) {
				while ((IsElementPresent(locator1 = "Partner#PAGE_LINK")) && (maxIterations = "100")) {
					var pageLink = selenium.getAttribute("xpath=(//div[contains(@class,'d-lg-block container-fluid')]//a)[${key_positionValue}]@href");

					if (contains(${pageLink}, "mailto")) {
						var key_positionValue = ${key_positionValue} + 1;
					}
					else {
						if (contains(${pageLink}, "&")) {
							var pageLink = StringUtil.replace(${pageLink}, "&", "%26");
						}

						var curl = '''
							${pageLink} -I
						''';

						var httpResponseStatusCode = JSONCurlUtil.get(${curl});

						if (contains(${httpResponseStatusCode}, "HTTP/2 400") || contains(${httpResponseStatusCode}, "HTTP/2 404")) {
							echo("The ${pageLink} page is not working properly.");

							var key_positionValue = ${key_positionValue} + 1;
						}
						else {
							echo("The ${pageLink} page is working properly.");

							var key_positionValue = ${key_positionValue} + 1;
						}
					}
				}
			}

			var linksRemain = "false";
		}
	}

	macro viewSocialMediaFooterNavigationLinks {
		var key_positionValue = 1;
		var linksRemain = "true";

		if (IsElementPresent(locator1 = "Partner#FOOTER_SOCIAL_MEDIA_LINK")) {
			var pageElementsFound = ${pageElementsFound} + 1;

			while ((${linksRemain} == "true") && (${key_positionValue} != 6)) {
				while (IsElementPresent(locator1 = "Partner#FOOTER_SOCIAL_MEDIA_LINK")) {
					var socialMediaFooterLink = selenium.getAttribute("xpath=(//div[contains(@class,'social-nav')]//li/a)[${key_positionValue}]@href");

					echo("PAGE LINK: ${socialMediaFooterLink}");

					var curl = '''
						${socialMediaFooterLink} -I
					''';

					var httpResponseStatusCode = JSONCurlUtil.get(${curl});

					if (contains(${httpResponseStatusCode}, "HTTP/2 400") || contains(${httpResponseStatusCode}, "HTTP/2 404")) {
						echo("The ${socialMediaFooterLink} page is not working properly.");

						var key_positionValue = ${key_positionValue} + 1;
					}
					else {
						echo("The ${socialMediaFooterLink} page is working properly.");

						var key_positionValue = ${key_positionValue} + 1;
					}
				}
			}

			var linksRemain = "false";
		}
	}

	macro viewTopInfoNavigationLinks {
		var key_positionValue = 1;
		var linksRemain = "true";

		if (IsElementPresent(locator1 = "Partner#TOP_INFO_NAVIGATION_LINK")) {
			var pageElementsFound = ${pageElementsFound} + 1;

			while ((${linksRemain} == "true") && (${key_positionValue} != 3)) {
				while (IsElementPresent(locator1 = "Partner#TOP_INFO_NAVIGATION_LINK")) {
					var topInfoNavigationLink = selenium.getAttribute("xpath=(//div[contains(@class,'utility-nav-left')])[1]//a[${key_positionValue}]@href");

					echo("PAGE LINK: ${topInfoNavigationLink}");

					var curl = '''
						${topInfoNavigationLink} -I
					''';

					var httpResponseStatusCode = JSONCurlUtil.get(${curl});

					if (contains(${httpResponseStatusCode}, "HTTP/2 400") || contains(${httpResponseStatusCode}, "HTTP/2 404")) {
						echo("The ${topInfoNavigationLink} page is not working properly.");

						var key_positionValue = ${key_positionValue} + 1;
					}
					else {
						echo("The ${topInfoNavigationLink} page is working properly.");

						var key_positionValue = ${key_positionValue} + 1;
					}
				}
			}

			var linksRemain = "false";
		}
	}


}