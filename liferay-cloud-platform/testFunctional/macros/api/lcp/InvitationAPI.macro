definition {

	macro acceptInvitation {
		var baseURL = Utils.getApiBaseURL();
		var token = MailhogAPI.fetchInvitationToken(email = ${email});
		var user = PropsUtil.get("test.this.lcp.test.team.user.email");
		var password = PropsUtil.get("test.this.lcp.test.team.user.password");
		var curl = '''
			${baseURL}/projects/${projectId}/invite?email=${email}\&invitationToken=${token} \
				-w "Status Code:%{http_code}" \
				-H "accept: application/json" \
				-H "Content-Type: application/json"
		''';

		var response = JSONCurlUtil.get(${curl});

		UtilsAPI.failIfApiErrorResponse(
			message = "acceptInvitation: failed to accept invitation.",
			response = ${response});
	}

	macro addTeamMember {
		InvitationAPI.sendInvitation(
			email = ${email},
			projectId = ${projectId},
			role = ${role});

		InvitationAPI.acceptInvitation(
			email = ${email},
			projectId = ${projectId});
	}

	macro sendInvitation {
		var baseURL = Utils.getApiBaseURL();
		var user = PropsUtil.get("test.this.lcp.test.team.user.email");
		var password = PropsUtil.get("test.this.lcp.test.team.user.password");

		var curl = '''
			${baseURL}/projects/${projectId}/invite \
				-w "Status Code:%{http_code}" \
				-u ${user}:${password} \
				-H "accept: application/json" \
				-H "Content-Type: application/json" \
				-d '{
					"email": "${email}",
					"role": "${role}"
				}'
		''';

		var response = JSONCurlUtil.post(${curl});

		UtilsAPI.failIfApiErrorResponse(
			message = "sendInvitation: failed to send invitation.",
			response = ${response});
	}

}