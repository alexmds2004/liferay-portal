definition {

	macro deployFromRepo {
		var user = PropsUtil.get("test.this.lcp.test.team.user.email");
		var password = PropsUtil.get("test.this.lcp.test.team.user.password");
		var baseURL = PropsUtil.get("test.this.lcp.test.base.url.api");
		var projectID = ${projectID};
		var qaExamplesRepo = "https://github.com/LiferayCloud/qa-examples/tree/master";

		var curl = '''
			https://${baseURL}/projects/${projectID}/build \
				-w "Status Code:%{http_code}" \
				-u ${user}:${password} \
				-H "Content-Type: application/json" \
				-d '{
					"provider": "github",
					"repository": "${qaExamplesRepo}/${repo}",
					"deploy": true
				}'
		''';

		var response = JSONCurlUtil.post(${curl});

		UtilsAPI.failIfApiErrorResponse(
			message = "deployFromRepo: Unable to deploy.",
			response = ${response});
	}

}