definition {

	macro checkServiceReadyStatus {
		var tries = 0;
		var maxTries = ${maxTries};
		var user = PropsUtil.get("test.this.lcp.test.team.user.email");
		var password = PropsUtil.get("test.this.lcp.test.team.user.password");
		var baseURL = PropsUtil.get("test.this.lcp.test.base.url.api");
		var projectID = ${projectID};
		var serviceID = ${serviceID};

		while ((${tries} != ${maxTries}) && (${readyStatus} != "true")) {
			var curl = '''
				https://${baseURL}/projects/${projectID}/services/${serviceID} \
					-u ${user}:${password} \
			''';

			var response = JSONCurlUtil.get(${curl});

			UtilsAPI.failIfApiErrorResponse(
				message = "checkServiceReadyStatus: Unable to check services are ready.",
				response = ${response});

			var readyStatus = JSONUtil.getWithJSONPath(${response}, "$['ready']");

			if (${readyStatus} != "true") {
				echo("Status for service is ${readyStatus}. Try attempt #${tries}");

				var tries = ${tries} + 1;

				Default.Pause(locator1 = 5000);
			}
			else {
				return ${readyStatus};

				echo("Status for service is ${readyStatus}");
			}

			if (${tries} == ${maxTries}) {
				fail("Timed out with waiting for ${serviceID} service to be ready.");
			}
		}
	}

	macro fetchServiceStatus {
		var user = PropsUtil.get("test.this.lcp.test.team.user.email");
		var password = PropsUtil.get("test.this.lcp.test.team.user.password");
		var serviceID = ${serviceID};
		var projectID = ${projectID};
		var serviceDomain = ${serviceDomain};

		var curl = '''
			https://${serviceID}-${projectID}.${serviceDomain} \
				-w "Status Code:%{http_code}" \
				-u ${user}:${password} \
		''';

		var response = JSONCurlUtil.get(${curl});

		UtilsAPI.failIfApiErrorResponse(
			message = "fetchServiceStatus: Unable to fetch service status.",
			response = ${response});

		var serviceStatus = JSONUtil.getWithJSONPath(${response}, "$['status']");

		return ${serviceStatus};

		echo("The service status is: ${serviceStatus}");
	}

}