definition {

	macro checkApiResponseAndContinue {
		var statusCode = RegexUtil.replace(${response}, "(Code:2)", 1);

		if (!(contains(${statusCode}, "Code:2"))) {
			echo("${message} - ${response}");
		}
	}

	macro failIfApiErrorResponse {
		var statusCode = RegexUtil.replace(${response}, "(Code:2)", 1);

		if (!(contains(${statusCode}, "Code:2"))) {
			fail("${message} - ${response}");
		}
	}

	macro getCluster {
		var baseURL = Utils.getApiBaseURL();
		var user = PropsUtil.get("test.this.lcp.test.team.user.email");
		var password = PropsUtil.get("test.this.lcp.test.team.user.password");

		var curl = '''
			${baseURL}/projects/${projectId} \
				-w "Status Code:%{http_code}" \
				-u ${user}:${password} \
		''';

		var response = JSONCurlUtil.get(${curl});

		UtilsAPI.failIfApiErrorResponse(
			message = "getCluster failure message: Unable to get cluster for ${projectId}.",
			response = ${response});

		var cluster = JSONUtil.getWithJSONPath(${response}, "cluster");

		return ${cluster};
	}

	macro getClusterLocation {
		var baseURL = Utils.getApiBaseURL();
		var clusterName = UtilsAPI.getCluster(projectId = ${projectId});
		var curl = '''
			${baseURL}/clusters \
				-w "Status Code:%{http_code}" \
		''';

		var response = JSONCurlUtil.get(${curl});

		UtilsAPI.failIfApiErrorResponse(
			message = "getClusterLocation failure message: Unable to fetch cluster location for ${projectId}.",
			response = ${response});

		var location = JSONUtil.getWithJSONPath(${response}, "$.[?(@.name=='${clusterName}')].location");

		return ${location};
	}

	macro tearDownProjects {
		for (var projectId : list ${staticProjectIdTearDowns}) {
			ProjectsAPI.deleteProject(
				isTearDown = "true",
				projectId = ${projectId});
		}
	}

}