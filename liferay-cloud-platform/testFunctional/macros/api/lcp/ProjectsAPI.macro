definition {

	var user = PropsUtil.get("test.this.lcp.test.team.user.email");
	var password = PropsUtil.get("test.this.lcp.test.team.user.password");

	macro createProject {
		var baseURL = Utils.getApiBaseURL();

		if (isSet(prefix)) {
			var newProjectId = Utils.createProjectId();

			var projectId = "${prefix}${newProjectId}";
		}

		if (!(isSet(projectId)) && !(isSet(prefix))) {
			var projectId = Utils.createProjectId();
		}

		if (!(isSet(environment))) {
			var environment = "false";
		}

		if (!(isSet(cluster))) {
			var cluster = "us-west1-c1";
		}

		var curl = '''
			${baseURL}/projects \
				-w "Status Code:%{http_code}" \
				-u ${user}:${password} \
				-H "accept: application/json" \
				-H "Content-Type: application/json" \
				-d
				{
					"projectId": "${projectId}",
					"cluster": "${cluster}",
					"environment": '${environment}'
				}
		''';

		var response = JSONCurlUtil.post(${curl});

		if (${environment} == "false") {
			ListUtil.add(${staticProjectIdTearDowns}, ${projectId});
		}

		UtilsAPI.failIfApiErrorResponse(
			message = "createProject: failed to create ${projectId}.",
			response = ${response});

		return ${projectId};
	}

	macro deleteProject {
		var baseURL = Utils.getApiBaseURL();

		var curl = '''
			${baseURL}/projects/${projectId} \
				-w "Status Code:%{http_code}" \
				-u ${user}:${password} \
		''';

		var response = JSONCurlUtil.delete(${curl});

		if (${isTearDown} == "true") {
			UtilsAPI.checkApiResponseAndContinue(
				message = "deleteProject: failed to delete ${projectId}.",
				response = ${response});
		}
		else {
			UtilsAPI.failIfApiErrorResponse(
				message = "deleteProject: failed to delete ${projectId}.",
				response = ${response});
		}
	}

	macro fetchProjectUid {
		var baseURL = Utils.getApiBaseURL();

		var curl = '''
			${baseURL}/projects/${projectId} \
				-w "Status Code:%{http_code}" \
				-u ${user}:${password} \
				-H "accept: application/json" \
				-H "Content-Type: application/json"
		''';

		var response = JSONCurlUtil.get(${curl});

		UtilsAPI.failIfApiErrorResponse(
			message = "fetchProjectUid: Unable to fetch ProjectUid for ${projectId}.",
			response = ${response});

		var projectUid = JSONUtil.getWithJSONPath(${response}, "$['id']");

		return ${projectUid};
	}

}