definition {

	macro createSecret {
		var user = PropsUtil.get("test.this.lcp.test.team.user.email");
		var password = PropsUtil.get("test.this.lcp.test.team.user.password");
		var baseURL = PropsUtil.get("test.this.lcp.test.base.url.api");

		var curl = '''
			https://${baseURL}/projects/${projectId}/secrets \
				-w "Status Code:%{http_code}" \
				-u ${user}:${password} \
				-H "accept: application/json" \
				-H "Content-Type: application/json" \
				-d '{
					"name": "${secretName}",
					"value": "${secretValue}",
					"description": "${secretDescription}"
				}'
		''';

		var response = JSONCurlUtil.post(${curl});

		UtilsAPI.failIfApiErrorResponse(
			message = "createSecret: Unable to create secret.",
			response = ${response});
	}

}