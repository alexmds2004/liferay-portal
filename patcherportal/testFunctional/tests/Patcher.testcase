      | Support Ticket  | ${staticTicketNumber}   |
      | Version         | 1.0                     |
      | Project Version | fix-pack-base-7110      |
      | Content         | 0 Fix Packs + 6 Tickets |
      | Patcher Status  | Merging                 |''');

		PatcherBuild.viewChildBuild(
			accountCode = "STVINTRA",
			childBuildName = "${staticFixContent1}, LPS-113730, LPS-113733, LPS-85987, LPS-88314, LPS-93497",
			supportTicket = ${staticTicketNumber},
			table = '''| Version         | 1.0                                                                           |
      | Name            | ${staticFixContent1}, LPS-113730, LPS-113733, LPS-85987, LPS-88314, LPS-93497 |
      | Project Version | fix-pack-base-7110                                                            |
      | Patcher Status  | Merging Only                                                                  |''');

		PatcherBuild.viewChildBuildFix(
			accountCode = "STVINTRA",
			childBuildName = "${staticFixContent1}, LPS-113730, LPS-113733, LPS-85987, LPS-88314, LPS-93497",
			fixName = "LPS-85987, LPS-88314, LPS-93497",
			supportTicket = ${staticTicketNumber},
			table = '''| Name     | LPS-85987, LPS-88314, LPS-93497 |
      | Version  | 1.2                             |
      | Git Hash | 7e6ec8fbff                      |
      | Status   | Complete                        |
      | Type     | Patch                           |''');

		PatcherBuild.viewChildBuildFix(
			accountCode = "STVINTRA",
			childBuildName = "${staticFixContent1}, LPS-113730, LPS-113733, LPS-85987, LPS-88314, LPS-93497",
			fixName = "LPS-113730, LPS-113733",
			supportTicket = ${staticTicketNumber},
			table = '''| Name     | LPS-113730, LPS-113733 |
      | Version  | 1.0                    |
      | Git Hash | f589f0ad31             |
      | Status   | Complete               |
      | Type     | Patch                  |''');

		PatcherBuild.viewChildBuildFix(
			accountCode = "STVINTRA",
			childBuildName = "${staticFixContent1}, LPS-113730, LPS-113733, LPS-85987, LPS-88314, LPS-93497",
			fixName = ${staticFixContent1},
			supportTicket = ${staticTicketNumber},
			table = '''| Name     | ${staticFixContent1} |
      | Version  | 1.0                  |
      | Git Hash | 65281272e0           |
      | Status   | Complete             |
      | Type     | Workaround           |''');

		PatcherBuild.checkForMergeCompletion(
			accountCode = "STVINTRA",
			supportTicket = ${staticTicketNumber});

		PatcherBuild.checkForCompileCompletion(
			accountCode = "STVINTRA",
			jenkinsValue = "fixpack-builder-hotfix-7x(uat)",
			supportTicket = ${staticTicketNumber});

