	@priority = 4
	test CheckforsuccessfulDXP70buildcreation {
		Patcher.loginAsAdmin();

		PatcherFix.generateRandomFixContentForFix1();

		PatcherFix.create(table = '''| Product         | DXP 7.0                                                         |
      | Project Version | fix-pack-de-45-7010                                             |
      | Content         | ${staticFixContent1},LPS-107154,LPS-107323                      |
      | Branch Name     | LPE-17046                                                       |
      | Github URL      | git@github.com:Liferay-Patcher-Test-Fixes/liferay-portal-ee.git |''');

		Patcher.pause(timeInSeconds = 5);

		PatcherFix.view(
			fixContent = ${staticFixContent1},
			fixType = "Patch",
			table = '''| Content         | ${staticFixContent1}, LPS-107154, LPS-107323 |
      | Version         | 1.0                                          |
      | Product         | DXP 7.0                                      |
      | Project Version | fix-pack-de-45-7010                          |
      | Patcher Status  | Adding                                       |
      | Type            | Patch                                        |''');

		PatcherFix.checkForAddCompletion(
			fixContent = ${staticFixContent1},
			fixType = "Patch");

		PatcherFix.view(
			fixContent = ${staticFixContent1},
			fixType = "Patch",
			table = '''| Content         | ${staticFixContent1}, LPS-107154, LPS-107323 |
      | Version         | 1.0                                          |
      | Product         | DXP 7.0                                      |
      | Project Version | fix-pack-de-45-7010                          |
      | Git Hash        | fc21fefa42                                   |
      | Patcher Status  | Complete                                     |
      | Type            | Patch                                        |
      | Jenkins         | fixpack-builder-agent(uat)                   |''');

		Patcher.generateRandomTicketNumber();

		PatcherBuild.createForNewAccount(table = '''| Product                            | DXP 7.0               |
      | Project Version                    | fix-pack-de-45-7010   |
      | Tickets List                       | ${staticFixContent1}  |
      | Troubleshooting Ticket Suggestions | LPS-107154,LPS-107323 |
      | Account Code                       | SKODAINTRANET         |
      | Support Ticket                     | ${staticTicketNumber} |''');

		PatcherBuild.setAccountCodeAsStaticVariable(accountCode = "SKODAINTRANET");

		Patcher.pause(timeInSeconds = 5);

		PatcherBuild.view(
			accountCode = "SKODAINTRANET",
			supportTicket = ${staticTicketNumber},
			table = '''| Type            | Official                |
      | Support Ticket  | ${staticTicketNumber}   |
      | Version         | 1.0                     |
      | Project Version | fix-pack-de-45-7010     |
      | Content         | 0 Fix Packs + 3 Tickets |
      | Patcher Status  | Merging                 |''');

		PatcherBuild.viewChildBuild(
			accountCode = "SKODAINTRANET",
			childBuildName = "${staticFixContent1}, LPS-107154, LPS-107323",
			supportTicket = ${staticTicketNumber},
			table = '''| Version         | 1.0                                          |
      | Name            | ${staticFixContent1}, LPS-107154, LPS-107323 |
      | Project Version | fix-pack-de-45-7010                          |
      | Patcher Status  | Merging Only                                 |''');

		PatcherBuild.viewChildBuildFix(
			accountCode = "SKODAINTRANET",
			childBuildName = ${staticFixContent1},
			fixName = "${staticFixContent1}, LPS-107154, LPS-107323",
			supportTicket = ${staticTicketNumber},
			table = '''| Name     | ${staticFixContent1}, LPS-107154, LPS-107323 |
      | Version  | 1.0                                          |
      | Git Hash | fc21fefa42                                   |
      | Status   | Complete                                     |
      | Type     | Patch                                        |''');

		PatcherBuild.checkForMergeCompletion(
			accountCode = "SKODAINTRANET",
			supportTicket = ${staticTicketNumber});

		PatcherBuild.checkForCompileCompletion(
			accountCode = "SKODAINTRANET",
			jenkinsValue = "fixpack-builder-hotfix-7x(uat)",
			supportTicket = ${staticTicketNumber});

		PatcherBuild.view(
			accountCode = "SKODAINTRANET",
			supportTicket = ${staticTicketNumber},
			table = '''| Type            | Official                       |
      | Support Ticket  | ${staticTicketNumber}          |
      | Version         | 1.0                            |
      | Project Version | fix-pack-de-45-7010            |
      | Content         | 0 Fix Packs + 3 Tickets        |
      | Patcher Status  | Complete                       |
      | Jenkins         | fixpack-builder-hotfix-7x(uat) |
      | Jenkins         | fixpack-builder-agent(uat)     |''');

		PatcherBuild.viewChildBuild(
			accountCode = "SKODAINTRANET",
			childBuildName = ${staticFixContent1},
			supportTicket = "${staticTicketNumber}, LPS-107154, LPS-107323",
			table = '''| Version         | 1.0                                          |
      | Name            | ${staticFixContent1}, LPS-107154, LPS-107323 |
      | Project Version | fix-pack-de-45-7010                          |
      | Patcher Status  | Complete                                     |
      | Jenkins         | fixpack-builder-agent(uat)                   |
      | Jenkins         | fixpack-builder-hotfix-7x(uat)               |''');
	}

	@priority = 4
	test CheckforsuccessfulDXP71buildcreation {
		Patcher.loginAsAdmin();

		PatcherFix.generateRandomFixContentForFix1();

		PatcherFix.create(table = '''| Product         | DXP 7.1                                                         |
      | Project Version | fix-pack-base-7110                                              |
      | Content         | ${staticFixContent1}                                            |
      | Branch Name     | LPS-89343_GA1                                                   |
      | Github URL      | git@github.com:Liferay-Patcher-Test-Fixes/liferay-portal-ee.git |
      | Workaround      | true                                                            |''');

		Patcher.pause(timeInSeconds = 5);

		PatcherFix.view(
			fixContent = ${staticFixContent1},
			fixType = "Workaround",
			table = '''| Content         | ${staticFixContent1} |
      | Version         | 1.0                  |
      | Product         | DXP 7.1              |
      | Project Version | fix-pack-base-7110   |
      | Patcher Status  | Adding               |
      | Type            | Workaround           |''');

		PatcherFix.checkForAddCompletion(
			fixContent = ${staticFixContent1},
			fixType = "Workaround");

		PatcherFix.view(
			fixContent = ${staticFixContent1},
			fixType = "Workaround",
			table = '''| Content         | ${staticFixContent1}       |
      | Version         | 1.0                        |
      | Product         | DXP 7.1                    |
      | Project Version | fix-pack-base-7110         |
      | Git Hash        | 65281272e0                 |
      | Patcher Status  | Complete                   |
      | Type            | Workaround                 |
      | Jenkins         | fixpack-builder-agent(uat) |''');

		Patcher.generateRandomTicketNumber();

		PatcherBuild.createForNewAccount(table = '''| Product                            | DXP 7.1                                             |
      | Project Version                    | fix-pack-base-7110                                  |
      | Tickets List                       | ${staticFixContent1}                                |
      | Troubleshooting Ticket Suggestions | LPS-85987,LPS-88314,LPS-93497,LPS-113730,LPS-113733 |
