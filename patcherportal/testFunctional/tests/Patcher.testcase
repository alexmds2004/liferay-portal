		PatcherFix.create(table = '''| Product         | DXP 7.3                                                         |
      | Project Version | fix-pack-dxp-1-7310                                             |
      | Content         | ${staticFixContent1}                                            |
      | Branch Name     | 7310fp01_LPS-94011                                              |
      | Github URL      | git@github.com:Liferay-Patcher-Test-Fixes/liferay-portal-ee.git |
      | Workaround      | true                                                            |''');

