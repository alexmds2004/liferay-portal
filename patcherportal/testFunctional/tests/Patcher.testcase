definition {

	property testray.main.component.name = "Support QA";

	tearDown {
		Patcher.openURL();

		ZendeskTicketAPI._tearDownTicketByIds(ticketIdList = ${staticRequestIdList});

		PatcherBuild.tearDownBuild(
			accountCode = ${staticAccountCode},
			supportTicket = ${staticTicketNumber});

		PatcherBuild.tearDownBuild(
			accountCode = ${staticAccountCode},
			supportTicket = ${staticTicketNumber});

		PatcherBuild.tearDownBuild(
			accountCode = ${staticAccountCode},
			supportTicket = ${staticRequestIdList});

		PatcherFix.tearDownFix(
			fixContent = "${staticFixContent1}, ${staticFixContent3}",
			fixType = "Generated");

		PatcherFix.tearDownFix(
			fixContent = "${staticFixContent1}, ${staticFixContent3}",
			fixType = "Generated Private Public");

		PatcherFix.tearDownFix(
			fixContent = "${staticFixContent1}, ${staticFixContent3}",
			fixType = "Patch");

		PatcherFix.tearDownFix(
			fixContent = ${staticFixContent},
			fixType = "Rebase");

		PatcherFix.tearDownFix(
			fixContent = ${staticFixContent1},
			fixType = "Rebase");

