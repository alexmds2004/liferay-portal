			accountCode = "STVINTRA",
			supportTicket = ${staticTicketNumber},
			table = '''| Type            | Official                       |
      | Support Ticket  | ${staticTicketNumber}          |
      | Version         | 1.0                            |
      | Project Version | fix-pack-base-7110             |
      | Content         | 0 Fix Packs + 6 Tickets        |
      | Patcher Status  | Complete                       |
      | Jenkins         | fixpack-builder-hotfix-7x(uat) |
      | Jenkins         | fixpack-builder-agent(uat)     |''');

		PatcherBuild.viewChildBuild(
			accountCode = "STVINTRA",
			childBuildName = "${staticFixContent1}, LPS-113730, LPS-113733, LPS-85987, LPS-88314, LPS-93497",
			supportTicket = ${staticTicketNumber},
			table = '''| Version         | 1.0                                                                           |
      | Name            | ${staticFixContent1}, LPS-113730, LPS-113733, LPS-85987, LPS-88314, LPS-93497 |
      | Project Version | fix-pack-base-7110                                                            |
      | Patcher Status  | Complete Merging Only                                                         |
      | Jenkins         | fixpack-builder-agent(uat)                                                    |
      | Jenkins         | fixpack-builder-hotfix-7x(uat)                                                |''');
	}

