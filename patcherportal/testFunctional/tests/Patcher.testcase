			fixType = "Workaround",
			table = '''| Content         | ${staticFixContent2} |
      | Version         | 1.0                  |
      | Product         | DXP 7.3              |
      | Project Version | fix-pack-dxp-2-7310  |
      | Patcher Status  | Adding               |
      | Type            | Workaround           |''');

		PatcherFix.checkForAddCompletion(
			fixContent = ${staticFixContent1},
			fixType = "Workaround");

		PatcherFix.checkForAddCompletion(
			fixContent = ${staticFixContent2},
			fixType = "Workaround");

		PatcherFix.view(
			fixContent = ${staticFixContent1},
			fixType = "Workaround",
			table = '''| Content         | ${staticFixContent1}       |
      | Version         | 1.0                        |
      | Product         | DXP 7.3                    |
      | Project Version | fix-pack-dxp-1-7310        |
      | Git Hash        | 439fdf4bb4                 |
      | Patcher Status  | Complete                   |
      | Type            | Workaround                 |
      | Jenkins         | fixpack-builder-agent(uat) |''');

		PatcherFix.view(
			fixContent = ${staticFixContent2},
			fixType = "Workaround",
			table = '''| Content         | ${staticFixContent2}       |
      | Version         | 1.0                        |
      | Product         | DXP 7.3                    |
      | Project Version | fix-pack-dxp-2-7310        |
      | Git Hash        | 6a060a5d07                 |
      | Patcher Status  | Complete                   |
      | Type            | Workaround                 |
      | Jenkins         | fixpack-builder-agent(uat) |''');

		Patcher.generateRandomTicketNumber();

		PatcherBuild.createForNewAccount(table = '''| Product         | DXP 7.3                                   |
      | Project Version | fix-pack-dxp-2-7310                       |
      | Tickets List    | ${staticFixContent1},${staticFixContent2} |
      | Account Code    | STVINTRA                                  |
      | Support Ticket  | ${staticTicketNumber}                     |
      | Merge Only      | true                                      |''');

		PatcherBuild.setAccountCodeAsStaticVariable(accountCode = "STVINTRA");

		Patcher.pause(timeInSeconds = 5);

		PatcherBuild.view(
			accountCode = "STVINTRA",
			supportTicket = ${staticTicketNumber},
			table = '''| Type            | Official                |
      | Support Ticket  | ${staticTicketNumber}   |
      | Version         | 1.0                     |
      | Project Version | fix-pack-dxp-2-7310     |
      | Content         | 0 Fix Packs + 2 Tickets |
      | Patcher Status  | Rebasing Merging Only   |''');

		PatcherBuild.viewBuildFix(
			accountCode = "STVINTRA",
			fixName = ${staticFixContent1},
			supportTicket = ${staticTicketNumber},
			table = '''| Name     | ${staticFixContent1} |
      | Version  | 1.0                  |
      | Status   | Rebasing             |
      | Type     | Rebase               |''');

		PatcherBuild.viewBuildFix(
			accountCode = "STVINTRA",
			fixName = ${staticFixContent2},
			supportTicket = ${staticTicketNumber},
			table = '''| Name     | ${staticFixContent2} |
      | Version  | 1.0                  |
      | Git Hash | 6a060a5d07           |
      | Status   | Complete             |
      | Type     | Workaround           |''');

		PatcherBuild.checkForRebaseCompletion(
			accountCode = "STVINTRA",
			supportTicket = ${staticTicketNumber});

		PatcherBuild.checkForMergeCompletion(
			accountCode = "STVINTRA",
			supportTicket = ${staticTicketNumber});

		PatcherBuild.checkForJenkinsLink(
			accountCode = "STVINTRA",
			jenkinsValue = "fixpack-builder-agent(uat)",
			supportTicket = ${staticTicketNumber});

		PatcherBuild.view(
			accountCode = "STVINTRA",
			supportTicket = ${staticTicketNumber},
			table = '''| Type            | Official                   |
      | Support Ticket  | ${staticTicketNumber}      |
      | Version         | 1.0                        |
      | Project Version | fix-pack-dxp-2-7310        |
      | Content         | 0 Fix Packs + 2 Tickets    |
      | Patcher Status  | Complete Merging Only      |
      | Jenkins         | fixpack-builder-agent(uat) |''');
	}

