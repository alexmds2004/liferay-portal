definition {

	var supportURL = PropsUtil.get("support.liferay.url");

	macro clearAllRefinements {
		AssertClick(
			locator1 = "ReleaseNotes#REFINE_BY_CLEAR_ALL_LINK",
			value1 = "Clear All");
	}

	macro clickChangelogEntry {
		var key_summary = ${summary};

		Click(locator1 = "ReleaseNotes#CHANGELOG_SUMMARY");
	}

	macro closeChangelogDetails {
		Click(locator1 = "ReleaseNotes#CHANGELOG_DETAILS_CLOSE_BUTTON");
	}

	macro gotoChangelog {
		AssertClick(
			locator1 = "ReleaseNotes#CHANGELOG_TAB",
			value1 = "Changelog");
	}

	macro gotoCommerceReleaseNotes {
		Open(locator1 = "${supportURL}/group/customer/commerce-release-notes");

		AssertVisible(locator1 = "ReleaseNotes#COMMERCE_RELEASE_NOTES_HEADER");
	}

	macro gotoDXPReleaseNotes {
		Open(locator1 = "${supportURL}/group/customer/dxp-release-notes");

		AssertVisible(locator1 = "ReleaseNotes#DXP_RELEASE_NOTES_HEADER");
	}

	macro gotoHighlights {
		AssertClick(
			locator1 = "ReleaseNotes#HIGHLIGHTS_TAB",
			value1 = "Highlights");
	}

	macro gotoModuleChanges {
		AssertClick(
			locator1 = "ReleaseNotes#MODULE_CHANGES_TAB",
			value1 = "Module Changes");
	}

	macro gotoResultsFirstPage {
		Click(locator1 = "ReleaseNotes#GO_TO_FIRST_PAGE_LINK");
	}

	macro gotoResultsLastPage {
		Click(locator1 = "ReleaseNotes#GO_TO_LAST_PAGE_LINK");
	}

	macro gotoResultsNextPage {
		Click(locator1 = "ReleaseNotes#GO_TO_NEXT_PAGE_LINK");
	}

	macro gotoResultsPageNumber {
		var key_pageNumber = ${pageNumber};

		Click(locator1 = "ReleaseNotes#GO_TO_PAGE_NUMBER_LINK");
	}

	macro gotoResultsPreviousPage {
		Click(locator1 = "ReleaseNotes#GO_TO_PREVIOUS_PAGE_LINK");
	}

	macro refineFilters {
		if (IsElementPresent(locator1 = "ReleaseNotes#REFINE_BY_SEE_MORE_LINK")) {
			if (IsTextEqual(locator1 = "ReleaseNotes#REFINE_BY_SEE_MORE_LINK", value1 = "See More")) {
				Click(locator1 = "ReleaseNotes#REFINE_BY_SEE_MORE_LINK");

				AssertTextEquals(
					locator1 = "ReleaseNotes#REFINE_BY_SEE_MORE_LINK",
					value1 = "See Less");
			}
		}

		var rawTable = TableUtil.newTable(${table});

		for (var row : table ${rawTable}) {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ((${field} == "Contains Text") || (${field} == "Name")) {
				Type(
					locator1 = "ReleaseNotes#REFINE_BY_TEXT_FIELD",
					value1 = ${value});

				OSBAdmin.pause(timeInSeconds = 2);

				KeyPress(
					locator1 = "ReleaseNotes#REFINE_BY_TEXT_FIELD",
					value1 = "\RETURN");
			}
			else if (${field} == "Only Show Changes") {
				if (${value} == "true") {
					if (IsElementPresent(locator1 = "ReleaseNotes#MODULE_CHANGE_UNCHANGED_ROW")) {
						Click(locator1 = "ReleaseNotes#REFINE_BY_TOGGLE_SWITCH");
					}
				}
				else {
					if (IsElementNotPresent(locator1 = "ReleaseNotes#MODULE_CHANGE_UNCHANGED_ROW")) {
						Click(locator1 = "ReleaseNotes#REFINE_BY_TOGGLE_SWITCH");
					}
				}
			}
			else {
				var key_filterName = ${field};

				if (${value} == "true") {
					Check(locator1 = "ReleaseNotes#REFINE_BY_CHECKBOX");
				}
				else {
					Uncheck(locator1 = "ReleaseNotes#REFINE_BY_CHECKBOX");
				}
			}
		}
	}

	macro setSearchFilters {
		Select(
			locator1 = "ReleaseNotes#PRODUCT_SELECT",
			value1 = ${productName});

		Select(
			locator1 = "ReleaseNotes#FROM_SELECT",
			value1 = ${fixPackName1});

		Select(
			locator1 = "ReleaseNotes#TO_SELECT",
			value1 = ${fixPackName2});
	}

	macro sortChangelogResultsInAscendingOrder {
		if (IsElementPresent(locator1 = "ReleaseNotes#RELEASE_COLUMN_DESCENDING_ORDER_ARROW")) {
			Click(locator1 = "ReleaseNotes#RELEASE_COLUMN_DESCENDING_ORDER_ARROW");
		}
	}

	macro sortChangelogResultsInDescendingOrder {
		if (IsElementPresent(locator1 = "ReleaseNotes#RELEASE_COLUMN_ASCENDING_ORDER_ARROW")) {
			Click(locator1 = "ReleaseNotes#RELEASE_COLUMN_ASCENDING_ORDER_ARROW");
		}
	}

	macro sortHighlightResultsInDescendingOrder {
		if (IsElementPresent(locator1 = "ReleaseNotes#RELEASED_COLUMN_ASCENDING_ORDER_ARROW")) {
			Click(locator1 = "ReleaseNotes#RELEASED_COLUMN_ASCENDING_ORDER_ARROW");
		}
	}

	macro sortHightlightResultsInAscendingOrder {
		if (IsElementPresent(locator1 = "ReleaseNotes#RELEASED_COLUMN_DESCENDING_ORDER_ARROW")) {
			Click(locator1 = "ReleaseNotes#RELEASED_COLUMN_DESCENDING_ORDER_ARROW");
		}
	}

	macro viewChangelogEntry {
		var key_summary = ${summary};

		AssertElementPresent(locator1 = "ReleaseNotes#CHANGELOG_SUMMARY");

		AssertElementPresent(locator1 = "ReleaseNotes#CHANGELOG_COMPONENT");

		AssertElementPresent(locator1 = "ReleaseNotes#CHANGELOG_RELEASE");

		AssertElementPresent(locator1 = "ReleaseNotes#CHANGELOG_KEY");
	}

	macro viewChangelogEntryByPosition {
		var key_positionValue = ${positionValue};

		AssertTextEquals.assertPartialText(
			locator1 = "ReleaseNotes#CHANGELOG_SUMMARY_POSITION",
			value1 = ${summary});
	}

	macro viewChangelogEntryDetails {
		AssertTextEquals(
			locator1 = "ReleaseNotes#CHANGELOG_DETAILS_HEADER",
			value1 = "Details");

		AssertTextEquals.assertPartialText(
			locator1 = "ReleaseNotes#CHANGELOG_DETAILS_SUMMARY",
			value1 = ${summary});

		AssertElementPresent(locator1 = "ReleaseNotes#CHANGELOG_DETAILS_DESCRIPTION_HEADER");

		AssertElementPresent(locator1 = "ReleaseNotes#CHANGELOG_DETAILS_DESCRIPTION_CONTENT");

		AssertElementPresent(locator1 = "ReleaseNotes#CHANGELOG_DETAILS_COMPONENTS_HEADER");

		AssertElementPresent(locator1 = "ReleaseNotes#CHANGELOG_DETAILS_RELEASE_HEADER");

		AssertElementPresent(locator1 = "ReleaseNotes#CHANGELOG_DETAILS_KEY_HEADER");

		AssertElementPresent(locator1 = "ReleaseNotes#CHANGELOG_DETAILS_KEY_CONTENT");
	}

	macro viewChangelogEntryText {
		var key_summary = ${summary};
		var rawTable = TableUtil.newTable(${table});

		for (var row : table ${rawTable}) {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if (${field} == "Summary") {
				AssertTextEquals(
					locator1 = "ReleaseNotes#CHANGELOG_SUMMARY",
					value1 = ${value});
			}
			else if (${field} == "Component") {
				AssertTextEquals(
					locator1 = "ReleaseNotes#CHANGELOG_COMPONENT",
					value1 = ${value});
			}
			else if (${field} == "Release") {
				AssertTextEquals(
					locator1 = "ReleaseNotes#CHANGELOG_RELEASE",
					value1 = ${value});
			}
			else if (${field} == "Key") {
				AssertTextEquals(
					locator1 = "ReleaseNotes#CHANGELOG_KEY",
					value1 = ${value});
			}
			else {
				fail("No such changelog entry field ${field}");
			}
		}

		ReleaseNotes.viewChangelogEntry(summary = ${summary});
	}

	macro viewChangelogReleaseVersion {
		var key_version = ${version};

		AssertTextEquals(
			locator1 = "ReleaseNotes#CHANGELOG_RELEASE_VIA_VERSION",
			value1 = ${version});
	}

	macro viewChangelogReleaseVersionByPosition {
		var key_positionValue = ${positionValue};

		AssertTextEquals.assertPartialText(
			locator1 = "ReleaseNotes#CHANGELOG_RELEASE_POSITION",
			value1 = ${version});
	}

	macro viewFixPackHighlights {
		var key_fixPackName = ${fixPackName};

		AssertTextEquals(
			locator1 = "ReleaseNotes#FIX_PACK_HEADER",
			value1 = ${fixPackName});

		AssertTextEquals(
			locator1 = "ReleaseNotes#FIX_PACK_PRODUCT_NAME",
			value1 = ${productName});

		AssertElementPresent(locator1 = "ReleaseNotes#FIX_PACK_DATE");

		AssertElementPresent(locator1 = "ReleaseNotes#FIX_PACK_KEY_HIGHLIGHTS_HEADER");

		AssertElementPresent(locator1 = "ReleaseNotes#FIX_PACK_KEY_HIGHLIGHTS_DETAILS");

		AssertElementPresent(locator1 = "ReleaseNotes#FIX_PACK_IMPORTANT_CHANGES_HEADER");

		AssertElementPresent(locator1 = "ReleaseNotes#FIX_PACK_IMPORTANT_CHANGES_DETAILS");

		AssertElementPresent(locator1 = "ReleaseNotes#FIX_PACK_KNOWN_ISSUES_HEADER");

		AssertElementPresent(locator1 = "ReleaseNotes#FIX_PACK_KNOWN_ISSUES_DETAILS");

		AssertElementPresent(locator1 = "ReleaseNotes#FIX_PACK_SECURITY_HEADER");

		AssertElementPresent(locator1 = "ReleaseNotes#FIX_PACK_SECURITY_DETAILS");
	}

	macro viewFixPackHighlightsByPosition {
		var key_positionValue = ${positionValue};

		AssertTextEquals(
			locator1 = "ReleaseNotes#FIX_PACK_HEADER_POSITION",
			value1 = ${fixPackName});
	}

	macro viewFixPackHighlightsWithRefinedFilters {
		var key_fixPackName = ${fixPackName};

		AssertTextEquals(
			locator1 = "ReleaseNotes#FIX_PACK_HEADER",
			value1 = ${fixPackName});

		AssertTextEquals(
			locator1 = "ReleaseNotes#FIX_PACK_PRODUCT_NAME",
			value1 = ${productName});

		AssertElementPresent(locator1 = "ReleaseNotes#FIX_PACK_DATE");

		var rawTable = TableUtil.newTable(${table});

		for (var row : table ${rawTable}) {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if (${field} == "Key Highlights") {
				if (${value} == "true") {
					AssertElementPresent(locator1 = "ReleaseNotes#FIX_PACK_KEY_HIGHLIGHTS_HEADER");

					AssertElementPresent(locator1 = "ReleaseNotes#FIX_PACK_KEY_HIGHLIGHTS_DETAILS");
				}
				else {
					if (IsElementPresent(locator1 = "ReleaseNotes#FIX_PACK_KEY_HIGHLIGHTS_HEADER")) {
						AssertNotVisible(locator1 = "ReleaseNotes#FIX_PACK_KEY_HIGHLIGHTS_HEADER");

						AssertNotVisible(locator1 = "ReleaseNotes#FIX_PACK_KEY_HIGHLIGHTS_DETAILS");
					}
					else {
						AssertElementNotPresent(locator1 = "ReleaseNotes#FIX_PACK_KEY_HIGHLIGHTS_HEADER");

						AssertElementNotPresent(locator1 = "ReleaseNotes#FIX_PACK_KEY_HIGHLIGHTS_DETAILS");
					}
				}
			}
			else if (${field} == "Important Changes") {
				if (${value} == "true") {
					AssertElementPresent(locator1 = "ReleaseNotes#FIX_PACK_IMPORTANT_CHANGES_HEADER");

					AssertElementPresent(locator1 = "ReleaseNotes#FIX_PACK_IMPORTANT_CHANGES_DETAILS");
				}
				else {
					if (IsElementPresent(locator1 = "ReleaseNotes#FIX_PACK_IMPORTANT_CHANGES_HEADER")) {
						AssertNotVisible(locator1 = "ReleaseNotes#FIX_PACK_IMPORTANT_CHANGES_HEADER");

						AssertNotVisible(locator1 = "ReleaseNotes#FIX_PACK_IMPORTANT_CHANGES_DETAILS");
					}
					else {
						AssertElementNotPresent(locator1 = "ReleaseNotes#FIX_PACK_IMPORTANT_CHANGES_HEADER");

						AssertElementNotPresent(locator1 = "ReleaseNotes#FIX_PACK_IMPORTANT_CHANGES_DETAILS");
					}
				}
			}
			else if (${field} == "Known Issues") {
				if (${value} == "true") {
					AssertElementPresent(locator1 = "ReleaseNotes#FIX_PACK_KNOWN_ISSUES_HEADER");

					AssertElementPresent(locator1 = "ReleaseNotes#FIX_PACK_KNOWN_ISSUES_DETAILS");
				}
				else {
					if (IsElementPresent(locator1 = "ReleaseNotes#FIX_PACK_KNOWN_ISSUES_HEADER")) {
						AssertNotVisible(locator1 = "ReleaseNotes#FIX_PACK_KNOWN_ISSUES_HEADER");

						AssertNotVisible(locator1 = "ReleaseNotes#FIX_PACK_KNOWN_ISSUES_DETAILS");
					}
					else {
						AssertElementNotPresent(locator1 = "ReleaseNotes#FIX_PACK_KNOWN_ISSUES_HEADER");

						AssertElementNotPresent(locator1 = "ReleaseNotes#FIX_PACK_KNOWN_ISSUES_DETAILS");
					}
				}
			}
			else if (${field} == "Security") {
				if (${value} == "true") {
					AssertElementPresent(locator1 = "ReleaseNotes#FIX_PACK_SECURITY_HEADER");

					AssertElementPresent(locator1 = "ReleaseNotes#FIX_PACK_SECURITY_DETAILS");
				}
				else {
					if (IsElementPresent(locator1 = "ReleaseNotes#FIX_PACK_SECURITY_HEADER")) {
						AssertNotVisible(locator1 = "ReleaseNotes#FIX_PACK_SECURITY_HEADER");

						AssertNotVisible(locator1 = "ReleaseNotes#FIX_PACK_SECURITY_DETAILS");
					}
					else {
						AssertElementNotPresent(locator1 = "ReleaseNotes#FIX_PACK_SECURITY_HEADER");

						AssertElementNotPresent(locator1 = "ReleaseNotes#FIX_PACK_SECURITY_DETAILS");
					}
				}
			}
			else {
				fail("No such fix pack highlight field ${field}");
			}
		}
	}

	macro viewGetLatestFixPackLink {
		var key_fixPackName = ${fixPackName};

		AssertTextEquals(
			locator1 = "ReleaseNotes#GET_LATEST_FIX_PACK_LINK",
			value1 = "Get ${fixPackName}");
	}

	macro viewModuleChange {
		var key_name = ${name};

		AssertElementPresent(locator1 = "ReleaseNotes#MODULE_CHANGE_NAME");

		AssertElementPresent(locator1 = "ReleaseNotes#MODULE_CHANGE_GROUP");

		AssertElementPresent(locator1 = "ReleaseNotes#MODULE_CHANGE_FIX_PACK_FROM");

		AssertElementPresent(locator1 = "ReleaseNotes#MODULE_CHANGE_FIX_PACK_TO");
	}

	macro viewModuleChangeText {
		var key_name = ${name};
		var rawTable = TableUtil.newTable(${table});

		for (var row : table ${rawTable}) {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if (${field} == "Name") {
				AssertTextEquals(
					locator1 = "ReleaseNotes#MODULE_CHANGE_NAME",
					value1 = ${value});
			}
			else if (${field} == "Group") {
				AssertTextEquals(
					locator1 = "ReleaseNotes#MODULE_CHANGE_GROUP",
					value1 = ${value});
			}
			else if (${field} == "Fix Pack From") {
				AssertTextEquals(
					locator1 = "ReleaseNotes#MODULE_CHANGE_FIX_PACK_FROM",
					value1 = ${value});
			}
			else if (${field} == "Fix Pack To") {
				AssertTextEquals(
					locator1 = "ReleaseNotes#MODULE_CHANGE_FIX_PACK_TO",
					value1 = ${value});
			}
			else if (${field} == "Change") {
				if (${value} == "true") {
					AssertElementPresent(locator1 = "ReleaseNotes#MODULE_CHANGE_CHANGE_LABEL");
				}
				else {
					AssertElementNotPresent(locator1 = "ReleaseNotes#MODULE_CHANGE_CHANGE_LABEL");
				}
			}
			else {
				fail("No such module change field ${field}");
			}
		}

		ReleaseNotes.viewModuleChange(name = ${name});
	}

	macro viewNoFixPackHighlights {
		var key_fixPackName = ${fixPackName};

		AssertElementNotPresent(locator1 = "ReleaseNotes#FIX_PACK_HEADER");

		AssertElementNotPresent(locator1 = "ReleaseNotes#FIX_PACK_PRODUCT_NAME");

		AssertElementNotPresent(locator1 = "ReleaseNotes#FIX_PACK_DATE");

		AssertElementNotPresent(locator1 = "ReleaseNotes#FIX_PACK_KEY_HIGHLIGHTS_HEADER");

		AssertElementNotPresent(locator1 = "ReleaseNotes#FIX_PACK_KEY_HIGHLIGHTS_DETAILS");

		AssertElementNotPresent(locator1 = "ReleaseNotes#FIX_PACK_IMPORTANT_CHANGES_HEADER");

		AssertElementNotPresent(locator1 = "ReleaseNotes#FIX_PACK_IMPORTANT_CHANGES_DETAILS");

		AssertElementNotPresent(locator1 = "ReleaseNotes#FIX_PACK_KNOWN_ISSUES_HEADER");

		AssertElementNotPresent(locator1 = "ReleaseNotes#FIX_PACK_KNOWN_ISSUES_DETAILS");

		AssertElementNotPresent(locator1 = "ReleaseNotes#FIX_PACK_SECURITY_HEADER");

		AssertElementNotPresent(locator1 = "ReleaseNotes#FIX_PACK_SECURITY_DETAILS");
	}

	macro viewNoModuleChange {
		var key_name = ${name};

		AssertElementNotPresent(locator1 = "ReleaseNotes#MODULE_CHANGE_NAME");

		AssertElementNotPresent(locator1 = "ReleaseNotes#MODULE_CHANGE_GROUP");

		AssertElementNotPresent(locator1 = "ReleaseNotes#MODULE_CHANGE_FIX_PACK_FROM");

		AssertElementNotPresent(locator1 = "ReleaseNotes#MODULE_CHANGE_FIX_PACK_TO");
	}

	macro viewResultsCount {
		if (${resultsCount} == 1) {
			AssertTextEquals(
				locator1 = "ReleaseNotes#RESULTS_COUNT",
				value1 = "${resultsCount} Result");
		}
		else {
			AssertTextEquals(
				locator1 = "ReleaseNotes#RESULTS_COUNT",
				value1 = "${resultsCount} Results");
		}
	}

	macro viewResultsCurrentPageNumber {
		var key_pageNumber = ${pageNumber};

		AssertElementPresent(locator1 = "ReleaseNotes#CURRENT_PAGE_NUMBER");
	}

}