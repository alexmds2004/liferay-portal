definition {

	var customerAdminEmailAddress = PropsUtil.get("customer.admin.email.address");
	var customerAdminPassword = PropsUtil.get("customer.admin.password");
	var customerURL = PropsUtil.get("customer.portal.url");

	macro _viewCustomerProjectTeamMembersViaIndex {
		var key_userName = ${userName};
		var rawTable = TableUtil.newTable(${table});

		for (var row : table ${rawTable}) {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if (${field} == "Name") {
				AssertTextEquals.assertPartialText(
					locator1 = "CustomerProjectTeamMembers#TEAM_MEMBER_NAME",
					value1 = ${value});
			}
			else if (${field} == "Email Address") {
				var key_userEmailAddress = ${value};

				AssertTextEquals(
					locator1 = "CustomerProjectTeamMembers#TEAM_MEMBER_EMAIL_ADDRESS",
					value1 = ${value});
			}
			else if (${field} == "Role") {
				var key_userRoles = ${value};

				AssertTextEquals(
					locator1 = "CustomerProjectTeamMembers#TEAM_MEMBER_ROLE",
					value1 = ${value});
			}
			else {
				fail("No such user field ${field}");
			}
		}
	}

	macro _viewCustomerTeamMember {
		var rawTable = TableUtil.newTable(${table});

		for (var row : table ${rawTable}) {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if (${field} == "Name") {
				AssertTextEquals(
					locator1 = "CustomerProjectTeamMembers#TEAM_MEMBER_NAME",
					value1 = ${value});
			}
			else if (${field} == "Email") {
				var key_userEmailAddress = ${value};

				AssertTextEquals(
					locator1 = "CustomerProjectTeamMembers#TEAM_MEMBER_EMAIL_ADDRESS",
					value1 = ${value});
			}
			else if (${field} == "Support Seat") {
				if (${value} == "true") {
					IsElementPresent(locator1 = "CustomerProjectTeamMembers#TEAM_MEMBER_SUPPORT_SEAT");
				}
				else if (${value} == "false") {
					IsElementNotPresent(locator1 = "CustomerProjectTeamMembers#TEAM_MEMBER_SUPPORT_SEAT");
				}
				else {
					fail("No such value ${value} is valid");
				}
			}
			else if (${field} == "Role") {
				var key_userRoles = ${value};

				AssertTextEquals(
					locator1 = "CustomerProjectTeamMembers#TEAM_MEMBER_ROLE",
					value1 = ${value});
			}
			else if (${field} == "Status") {
				var key_userMemberStatus = ${value};

				AssertTextEquals(
					locator1 = "CustomerProjectTeamMembers#TEAM_MEMBER_STATUS",
					value1 = ${value});
			}
			else {
				fail("No such team member detail field ${field}");
			}
		}
	}

	macro _viewNoCustomerProjectTeamMembersViaIndex {
		var key_userName = ${userName};

		AssertElementNotPresent(locator1 = "CustomerProjectTeamMembers#TEAM_MEMBER_NAME");
	}

	macro searchCustomerSubscription {
		WaitForSPARefresh();

		CustomerProjects.typeKeywordViaSearchCustomerProjectField(keyword = ${keyword});

		CustomerProjects.clickSearchCustomerProjectButton();
	}

}