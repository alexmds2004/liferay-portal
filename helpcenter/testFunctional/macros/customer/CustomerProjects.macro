definition {

	var customerURL = PropsUtil.get("customer.portal.url");

	macro _clickSkipInviteTeamMember {
		Click(locator1 = "CustomerProjects#CUSTOMER_SKIP_INVITE_TEAM_MEMBERS_BUTTON");
	}

	macro _clickStartProjectSetup {
		Click(locator1 = "CustomerProjects#CUSTOMER_START_PROJECT_SETUP_BUTTON");
	}

	macro _viewCustomerProjectDetails {
		var key_projectName = ${projectName};
		var rawTable = TableUtil.newTable(${table});

		WaitForSPARefresh();

		for (var row : table ${rawTable}) {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if (${field} == "Code") {
				AssertElementPresent(locator1 = "CustomerProjects#PROJECT_CODE");
			}
			else if (${field} == "State") {
				AssertElementPresent(locator1 = "CustomerProjects#PROJECT_STATE");
			}
			else if (${field} == "Ends On") {
				AssertElementPresent(locator1 = "CustomerProjects#PROJECT_ENDS_ON");
			}
			else if (${field} == "Support Region") {
				AssertElementPresent(locator1 = "CustomerProjects#PROJECT_SUPPORT_REGION");
			}
			else {
				fail("No such customer project details field ${field} was located at the page");
			}
		}
	}

	macro _viewNoCustomerProjectDetails {
		var key_projectName = ${projectName};

		AssertElementNotPresent(locator1 = "CustomerProjects#PROJECT_NAME");
	}

	macro clickCustomerProject {
		var key_projectName = ${projectName};

		while (IsElementNotPresent(locator1 = "CustomerProjects#PROJECT_NAME")) {
			OSBAdmin.pause(timeInSeconds = 1);
		}

		Click(locator1 = "CustomerProjects#PROJECT_NAME");
	}

	macro clickSearchCustomerProjectButton {
		Click(locator1 = "CustomerProjects#SEARCH_PROJECTS_FIELD_BUTTON");
	}

	macro searchCustomerProject {
		CustomerProjects.typeKeywordViaSearchCustomerProjectField(keyword = ${keyword});

		CustomerProjects.clickSearchCustomerProjectButton();

		WaitForSPARefresh();
	}

	macro searchCustomerSubscriptionWithKeyword {
		WaitForSPARefresh();

		CustomerProjects.typeKeywordViaSearchCustomerProjectField(keyword = ${keyword});

		CustomerProjects.clickSearchCustomerProjectButton();
	}

	macro typeKeywordViaSearchCustomerProjectField {
		WaitForSPARefresh();

		while (IsElementNotPresent(locator1 = "CustomerProjects#SEARCH_PROJECTS_FIELD")) {
			Refresh();
		}

		Type(
			locator1 = "CustomerProjects#SEARCH_PROJECTS_FIELD",
			value1 = ${keyword});
	}

}