definition {

	macro chooseSubscriptionAtActivationTab {
		var key_subscriptionActivationTab = ${subscription};

		if (IsElementNotPresent(locator1 = "CustomerProjectNavigation#PROJECT_ACTIVATION_TAB_PRODUCT")) {
			Click(locator1 = "CustomerProjectNavigation#PROJECT_ACTIVATION_TAB");
		}

		Click(locator1 = "CustomerProjectNavigation#PROJECT_ACTIVATION_TAB_PRODUCT");
	}

	macro clickOnTab {
		var key_subscriptionTab = ${tab};

		Click(locator1 = "CustomerProjectNavigation#PROJECT_PAGE_TAB");
	}

}