definition {

	var customerURL = PropsUtil.get("customer.portal.url");
	var apiClientId = PropsUtil.get("customer.client.id");
	var apiClientSecret = PropsUtil.get("customer.client.secret");
	var customerAdminEmailAddress = PropsUtil.get("customer.admin.email.address");
	var customerAdminPassword = PropsUtil.get("customer.admin.password");

	macro _getCustomerAccountSubscriptionId {
		var AccountKey = CustomerAccountApi._getCustomerAccountKeyViaAccountName(accountName = ${accountName});
		var productKey = KoroneikiProductAPI._getProductKeyViaProductName(productName = ${productName});

		var curl = '''
			${customerURL}/o/c/accountsubscriptions?filter="accountKey+eq+'${AccountKey}'"
			-H "Authorization: Bearer ${staticAccessToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
		''';

		var subscriptionId = JSONCurlUtil.get("${curl}", "$.items[?(@.productKey=='${productKey}')].id");

		var subscriptionId = StringUtil.replace("${subscriptionId}", "[", "");

		var subscriptionId = StringUtil.replace("${subscriptionId}", "]", "");

		var subscriptionId = StringUtil.replace("${subscriptionId}", "\"", "");

		echo("ID value for ${accountName} and Product Key ${productKey}: ${subscriptionId}");

		return "${subscriptionId}";
	}

	macro _deleteCustomerSubscription {
		var subscriptionId = CustomerSubscriptionApi._getCustomerAccountSubscriptionId(accountName = ${accountName}, productName = ${productName});

		var curl = '''
			${customerURL}/o/c/accountsubscriptions/${subscriptionId} --tlsv1.2
			-H "Authorization: Bearer ${staticAccessToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
		''';

		com.liferay.poshi.runner.util.JSONCurlUtil.delete(${curl});
	}

	macro tearDownSubscriptionsOnCustomer {
		var rawTable = TableUtil.newTable(${table});

		for (var row : table ${rawTable}) {
			var productName = "${row[0]}";

			CustomerSubscriptionApi._deleteCustomerSubscription(accountName = ${accountName}, productName = ${productName});
		}
	}
}