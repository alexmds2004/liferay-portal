definition {

	var customerURL = PropsUtil.get("customer.portal.url");

	@prose = "I click on the project with the name ${projectName} on the customer project details page"
	macro clickCustomerProject {
		var key_projectFieldValue = "${projectName}";

		while (IsElementNotPresent(locator1 = "CustomerProject#CUSTOMER_PROJECT_DETAILS_NAME")) {
			OSBAdmin.pause(timeInSeconds = "1");
		}

		Click(locator1 = "CustomerProject#CUSTOMER_PROJECT_DETAILS_NAME");
	}

	@prose = "I click on customer search accounts button"
	macro clickSearchCustomerProjectButton {
		Click(locator1 = "CustomerProject#CUSTOMER_SEARCH_PROJECTS_FIELD_BUTTON");
	}

	@prose = "I log into the customer homepage as ${userEmailAddress} with password ${userPassword}"
	macro loginToCustomer {
		Open(locator1 = "${customerURL}");

		Type(
			locator1 = "OktaLogin#EMAIL_ADDRESS_FIELD",
			value1 = "${userEmailAddress}");

		Type(
			locator1 = "OktaLogin#PASSWORD_FIELD",
			value1 = "${userPassword}");

		Click(locator1 = "OktaLogin#SIGN_IN_BUTTON");

		AssertElementNotPresent(locator1 = "OktaLogin#SIGN_IN_BUTTON");
	}

	@prose = "I search the customer projects page using the keyword ${keyword}"
	macro searchCustomerProject {
		CustomerProject.typeKeywordViaSearchCustomerProjectField(keyword = "${keyword}");

		CustomerProject.clickSearchCustomerProjectButton();

		WaitForSPARefresh();
	}

	@prose = "I type in the keyword ${keyword} into the Customer Search Projects field"
	macro typeKeywordViaSearchCustomerProjectField {
		WaitForSPARefresh();

		while (IsElementNotPresent(locator1 = "CustomerProject#CUSTOMER_SEARCH_PROJECTS_FIELD")) {
			Refresh();
		}

		Type(
			locator1 = "CustomerProject#CUSTOMER_SEARCH_PROJECTS_FIELD",
			value1 = "${keyword}");
	}

	@prose = "I should be able to view the following project ${projectName} values in the customer project details page ${table}"
	macro _viewCustomerProjectDetails {
		var key_projectName = "${projectName}";
		var RawTable rawTable = new RawTable("${table}");

		WaitForSPARefresh();

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Code") {
				var key_projectCodeField = "${value}";
				AssertElementPresent(locator1 = "CustomerProject#CUSTOMER_PROJECT_DETAILS_CODE");
			}
			else if ("${field}" == "State") {
				var key_projectStateField = "${value}";
				AssertElementPresent(locator1 = "CustomerProject#CUSTOMER_PROJECT_DETAILS_STATE");
			}
			else if ("${field}" == "Ends On") {
				var key_projectEndsOnField = "${value}";
				AssertElementPresent(locator1 = "CustomerProject#CUSTOMER_PROJECT_DETAILS_ENDS_ON");
			}
			else if ("${field}" == "Support Region") {
				var key_projectSupportRegionField = "${value}";
				AssertElementPresent(locator1 = "CustomerProject#CUSTOMER_PROJECT_DETAILS_SUPPORT_REGION");
			}
			else {
				fail("No such customer project details field ${field} was located at the page");
			}
		}
	}

	@prose = "I should not be able to view the following project ${projectName} in the customer project details page"
	macro _viewNoCustomerProjectDetails {
		var key_projectFieldValue = "${projectName}";

		AssertElementNotPresent(locator1 = "CustomerProject#CUSTOMER_PROJECT_DETAILS_NAME");
	}

	@prose = "I click on start project setup on setup pop up"
	macro _clickStartProjectSetup {
		Click(locator1 = "CustomerProject#CUSTOMER_START_PROJECT_SETUP_BUTTON");
	}

	@prose = "I click on skip button on invite team members pop up"
	macro _clickSkipInviteTeamMember {
		Click(locator1 = "CustomerProject#CUSTOMER_SKIP_INVITE_TEAM_MEMBERS_BUTTON");
	}

}