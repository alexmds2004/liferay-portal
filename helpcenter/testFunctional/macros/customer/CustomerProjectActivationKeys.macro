definition {

	@prose = "I click on the generate button on the generate activation key form"
	macro clickActivationKeyFormGenerateButton {
		Click(locator1 = "CustomerProjectActivationKeys#GENERATE_ACTIVATION_KEYS");
	}

	@prose = "I click on the next button on generate activation key form"
	macro clickActivationKeyFormNextButton {
		Click(locator1 = "CustomerProjectActivationKeys#GENERATE_ACTIVATION_KEYS_FORM_NEXT");
	}

	@prose = "I click on download Activation Key"
	macro clickDownloadActivationKeyButton {
		Click(locator1 = "CustomerProjectActivationKeys#DOWNLOAD_ACTIVATION_KEYS_BUTTON");
	}

	@prose = "I click on the generate activation key button on activation keys index"
	macro clickGenerateActivationKeyButton {
		Click(locator1 = "CustomerProjectActivationKeys#ACTIONS");

		Click(locator1 = "CustomerProjectActivationKeys#GENERATE_NEW_ACTIVATION_KEY");
	}

	@prose = "I populate the Activation Keys dropdown on download key page with the following values ${table}"
	macro populateActivationKeyDownloadDropdown {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			var key_field = "${field}";
			var key_value = "${value}";

			if ("${field}" == "Subscription") {
				Select(
					locator1 = "CustomerProjectActivationKeys#DOWNLOAD_ACTIVATION_KEYS_DROPDOWN",
					value1 = "${key_value}");
			}
			else if ("${field}" == "Subscription Term") {
				Select(
					locator1 = "CustomerProjectActivationKeys#DOWNLOAD_ACTIVATION_KEYS_DROPDOWN",
					value1 = "${key_value}");
			}
			else {
				echo("No such ${field} field found.");
			}
		}
	}

	@prose = "I populate the activation key form with the following values ${table}"
	macro populateActivationKeyForm {
		var  rawTable = TableUtil.newTable(${table});

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var option = "${row[1]}";
			var value = "${row[2]}";

			var key_projectField = "${field}";
			var key_projectValue = "${value}";

			if ("${option}" == "Select") {
				if ("${field}" == "Cluster Nodes") {
					Select(
						locator1 = "CustomerProjectActivationKeys#GENERATE_ACTIVATION_KEYS_FORM_OPTION_CLUSTER",
						value1 = "${key_projectValue}");				
				}
				else {
					Select(
						locator1 = "CustomerProjectActivationKeys#GENERATE_ACTIVATION_KEYS_FORM_OPTION",
						value1 = "${key_projectValue}");
				}

			}
			else if ("${option}" == "Radio Button") {
				Click(locator1 = "CustomerProjectActivationKeys#GENERATE_ACTIVATION_KEYS_FORM_SUBSCRIPTION");
			}
			else if ("${option}" == "Input") {
				Type(
					locator1 = "CustomerProjectActivationKeys#GENERATE_ACTIVATION_KEYS_FORM_INPUT",
					value1 = "${key_projectValue}");
			}
			else if ("${option}" == "Textarea") {
				Type(
					locator1 = "CustomerProjectActivationKeys#GENERATE_ACTIVATION_KEYS_FORM_TEXTAREA",
					value1 = "${key_projectValue}");
			}
			else {
				echo("No such ${field} field found.");
			}
		}
	}

	@prose = "I search the activation key with the keyword ${keyword}"
	macro seachActivationKey {
		Type(
			locator1 = "CustomerProjectActivationKeys#SEARCH_ACTIVATION_KEY_FIELD",
			value1 = "${keyword}");

		Click(locator1 = "CustomerProjectActivationKeys#SEARCH_ACTIVATION_KEY_BUTTON");
	}

	@prose = "I should be able to view a Portal or DXP activation key with the environment name ${key_licenseKeyword} on product activation tab with the following values ${table}"
	macro viewActivatonKey {
		var  rawTable = TableUtil.newTable(${table});

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			var key_value = "${value}";

			if ("${field}" == "Environment Name") {
				AssertElementPresent(locator1 = "CustomerProjectActivationKeys#ENVIRONMENT_NAME");
			}
			else if ("${field}" == "Description") {
				AssertElementPresent(locator1 = "CustomerProjectActivationKeys#DESCRIPTION");
			}
			else if ("${field}" == "Key Type") {
				AssertElementPresent(locator1 = "CustomerProjectActivationKeys#KEY_TYPE");
			}
			else if ("${field}" == "Host Name / Cluster Size") {
				AssertElementPresent(locator1 = "CustomerProjectActivationKeys#HOST_NAME");
			}
			else if ("${field}" == "Environment Type") {
				AssertElementPresent(locator1 = "CustomerProjectActivationKeys#ENVIRONMENT_TYPE");
			}
			else if ("${field}" == "Expiration Date") {
				AssertElementPresent(locator1 = "CustomerProjectActivationKeys#EXPIRATION_DATE");
			}
			else if ("${field}" == "Status") {
				AssertElementPresent(locator1 = "CustomerProjectActivationKeys#STATUS");
			}
			else {
				echo("No such ${field} field found.");
			}
		}
	}

}