definition{

	@prose = "I choose the ${subscription} subscription at the product activation tab"
	macro chooseSubscriptionAtActivationTab {
		var key_subscriptionActivationTab = "${subscription}";

		if (IsElementNotPresent(locator1 = "CustomerSubscription#SUBSCRIPTION_PRODUCT_ACTIVATION_TAB_OPTION")) {
			Click(locator1 = "CustomerSubscription#SUBSCRIPTION_PRODUCT_ACTIVATION_TAB");
		}

		Click(locator1 = "CustomerSubscription#SUBSCRIPTION_PRODUCT_ACTIVATION_TAB_OPTION");
	}

	@prose = "I click on the customer subscription page"
	macro clickCustomerSubscriptionPage {
		Click.makeVisibleClickAt(locator1 = "CustomerSubscription#SUBSCRIPTION_SELECT_HEADER");
	}

	@prose = "I filter the subscriptions details page to show only ${filter} subscriptions"
	macro filterCustomerSubscriptionStatusDropdown {

		if ("${filter}" == "Active") {
			if (IsElementNotPresent(locator1 = "CustomerSubscription#SUBSCRIPTION_DROPDOWN_ACTIVE")) {
				Click.makeVisibleClickAt(locator1 = "CustomerSubscription#SUBSCRIPTION_DROPDOWN");
				Click(locator1 = "CustomerSubscription#SUBSCRIPTION_DROPDOWN_ALL");
				Click(locator1 = "CustomerSubscription#SUBSCRIPTION_DROPDOWN_EXPIRED");
				Click(locator1 = "CustomerSubscription#SUBSCRIPTION_DROPDOWN_FUTURE");
				Click(locator1 = "CustomerSubscription#SUBSCRIPTION_SELECT_HEADER");
			}
		}
		else if ("${filter}" == "Expired") {
			if (IsElementNotPresent(locator1 = "CustomerSubscription#SUBSCRIPTION_DROPDOWN_ALL_SELECTED")) {
				Click.makeVisibleClickAt(locator1 = "CustomerSubscription#SUBSCRIPTION_DROPDOWN");
				Click(locator1 = "CustomerSubscription#SUBSCRIPTION_DROPDOWN_ALL");
				Click(locator1 = "CustomerSubscription#SUBSCRIPTION_DROPDOWN_ACTIVE");
				Click(locator1 = "CustomerSubscription#SUBSCRIPTION_DROPDOWN_FUTURE");
				Click(locator1 = "CustomerSubscription#SUBSCRIPTION_SELECT_HEADER");
			}
		}
		else if ("${filter}" == "Future") {
			if (IsElementNotPresent(locator1 = "CustomerSubscription#SUBSCRIPTION_DROPDOWN_ALL_SELECTED")) {
				Click.makeVisibleClickAt(locator1 = "CustomerSubscription#SUBSCRIPTION_DROPDOWN");
				Click(locator1 = "CustomerSubscription#SUBSCRIPTION_DROPDOWN_ALL");
				Click(locator1 = "CustomerSubscription#SUBSCRIPTION_DROPDOWN_ACTIVE");
				Click(locator1 = "CustomerSubscription#SUBSCRIPTION_DROPDOWN_EXPIRED");
				Click(locator1 = "CustomerSubscription#SUBSCRIPTION_SELECT_HEADER");
			}
		}
		else if ("${filter}" == "All") {
			if (IsElementNotPresent(locator1 = "CustomerSubscription#SUBSCRIPTION_DROPDOWN_ALL_SELECTED")) {
				Click.makeVisibleClickAt(locator1 = "CustomerSubscription#SUBSCRIPTION_DROPDOWN");
				Click(locator1 = "CustomerSubscription#SUBSCRIPTION_DROPDOWN_ALL");
				Click(locator1 = "CustomerSubscription#SUBSCRIPTION_DROPDOWN_ACTIVE");
				Click(locator1 = "CustomerSubscription#SUBSCRIPTION_DROPDOWN_EXPIRED");
				Click(locator1 = "CustomerSubscription#SUBSCRIPTION_SELECT_HEADER");
			}
		}
	}

	@prose = "I filter the subscriptions details page to show only subscriptions related to ${filter}"
	macro filterCustomerSelectedSubscriptionDropdown {
		var key_subscriptionFilter = "${filter}";

		if (IsElementNotPresent(locator1 = "CustomerSubscription#SUBSCRIPTION_FILTER_NAME")) {
			Click.makeVisibleClickAt(locator1 = "CustomerSubscription#SUBSCRIPTION_FILTER_DROPDOWN_BUTTON");
			Click(locator1 = "CustomerSubscription#SUBSCRIPTION_FILTER_NAME_SELECT");
			Click(locator1 = "CustomerSubscription#SUBSCRIPTION_SELECT_HEADER");
		}
		else {
			echo("The Selected filter ${filter} is already chosen");
		}
	}

	@prose = "I click on the ${tab} tab at customer portal"
	macro clickOnTab {
		var key_subscriptionTab = "${tab}";

		Click(locator1 = "CustomerSubscription#SUBSCRIPTION_DETAILS_PAGE_TAB");
	}

	@prose = "I search the customer subscription page using the keyword ${keyword}"
	macro searchCustomerSubscriptionWithKeyword {
		WaitForSPARefresh();

		CustomerProject.typeKeywordViaSearchCustomerProjectField(keyword = "${keyword}");

		CustomerProject.clickSearchCustomerProjectButton();
	}

    @prose = "I should be able to view a ${subscriptionName} subscription purchase on the customer subscription page with the following values ${table}"
	macro viewCustomerSubscriptionPurchaseDetails {
		var key_subscriptionName = "${subscriptionName}";
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Type") {
                key_subscriptionType = "${value}";
				AssertTextEquals(
					locator1 = "CustomerSubscription#SUBSCRIPTION_TYPE",
					value1 = "${value}");
			}
			else if ("${field}" == "Name") {
				key_subscriptionName = "${value}";
				AssertTextEquals(
					locator1 = "CustomerSubscription#SUBSCRIPTION_NAME",
					value1 = "${value}");
			}
			else if ("${field}" == "Instance Size") {
				key_subscriptionInstanceSize = "${value}";
				AssertTextEquals.assertPartialText(
					locator1 = "CustomerSubscription#SUBSCRIPTION_INSTANCE_SIZE",
					value1 = "${value}");
			}
			else if ("${field}" == "Date") {
				key_subscriptionDate = "${value}";
				AssertTextEquals(
					locator1 = "CustomerSubscription#SUBSCRIPTION_DATE",
					value1 = "${value}");
			}
			else if ("${field}" == "State") {
				key_subscriptionState = "${value}";
				AssertTextEquals(
					locator1 = "CustomerSubscription#SUBSCRIPTION_STATE",
					value1 = "${value}");
			}
			else {
				fail("No such subscription detail field ${field}");
			}
		}
	}

	@prose = "I should be able to view a support level purchase on the customer subscription page with the following values ${table}"
	macro viewSuportLevelCustomerSubscriptionPurchase {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Name") {
                key_subscriptionName = "${value}";
				AssertTextEquals(
					locator1 = "CustomerSubscription#SUBSCRIPTION_SUPPORT_LEVEL_NAME",
					value1 = "${value}");
			}
			else if ("${field}" == "Support Level Duration") {
				key_subscriptionDate = "${value}";
				AssertTextEquals(
					locator1 = "CustomerSubscription#SUBSCRIPTION_SUPPORT_LEVEL_DATE",
					value1 = "${value}");
			}
			else if ("${field}" == "Status") {
				key_subscriptionStatus = "${value}";
				AssertTextEquals(
					locator1 = "CustomerSubscription#SUBSCRIPTION_SUPPORT_LEVEL_STATUS",
					value1 = "${value}");
			}
			else {
				fail("No such subscription detail field ${field}");
			}
		}
	}
	
}