definition {

	@prose = "I click on the customer subscription page"
	macro clickCustomerSubscriptionPage {
		Click.makeVisibleClickAt(locator1 = "CustomerProjectOverview#SUBSCRIPTION_SELECT_HEADER");
	}

	@prose = "I filter the subscriptions details page to show only subscriptions related to ${filter}"
	macro filterCustomerSelectedSubscriptionDropdown {
		var key_subscriptionProduct = ${filter};

		if (IsElementNotPresent(locator1 = "CustomerProjectOverview#SUBSCRIPTION_PRODUCT_FILTER_NAME")) {
			Click.makeVisibleClickAt(locator1 = "CustomerProjectOverview#SUBSCRIPTION_PRODUCT_FILTER_DROPDOWN_BUTTON");

			Click(locator1 = "CustomerProjectOverview#SUBSCRIPTION_PRODUCT_FILTER_NAME_SELECT");

			Click(locator1 = "CustomerProjectOverview#SUBSCRIPTION_SELECT_HEADER");
		}
		else {
			echo("The Selected filter ${filter} is already chosen");
		}
	}

	@prose = "I filter the subscriptions details page to show only ${filter} subscriptions"
	macro filterCustomerSubscriptionStatusDropdown {
		if (${filter} == "Active") {
			if (IsElementNotPresent(locator1 = "CustomerProjectOverview#SUBSCRIPTION_STATUS_DROPDOWN_ACTIVE")) {
				Click.makeVisibleClickAt(locator1 = "CustomerProjectOverview#SUBSCRIPTION_STATUS_DROPDOWN");

				Click(locator1 = "CustomerProjectOverview#SUBSCRIPTION_STATUS_DROPDOWN_ALL");

				Click(locator1 = "CustomerProjectOverview#SUBSCRIPTION_STATUS_DROPDOWN_EXPIRED");

				Click(locator1 = "CustomerProjectOverview#SUBSCRIPTION_STATUS_DROPDOWN_FUTURE");

				Click(locator1 = "CustomerProjectOverview#SUBSCRIPTION_SELECT_HEADER");
			}
		}
		else if (${filter} == "Expired") {
			if (IsElementNotPresent(locator1 = "CustomerProjectOverview#SUBSCRIPTION_STATUS_DROPDOWN_ALL_SELECTED")) {
				Click.makeVisibleClickAt(locator1 = "CustomerProjectOverview#SUBSCRIPTION_STATUS_DROPDOWN");

				Click(locator1 = "CustomerProjectOverview#SUBSCRIPTION_STATUS_DROPDOWN_ALL");

				Click(locator1 = "CustomerProjectOverview#SUBSCRIPTION_STATUS_DROPDOWN_ACTIVE");

				Click(locator1 = "CustomerProjectOverview#SUBSCRIPTION_STATUS_DROPDOWN_FUTURE");

				Click(locator1 = "CustomerProjectOverview#SUBSCRIPTION_SELECT_HEADER");
			}
		}
		else if (${filter} == "Future") {
			if (IsElementNotPresent(locator1 = "CustomerProjectOverview#SUBSCRIPTION_STATUS_DROPDOWN_ALL_SELECTED")) {
				Click.makeVisibleClickAt(locator1 = "CustomerProjectOverview#SUBSCRIPTION_STATUS_DROPDOWN");

				Click(locator1 = "CustomerProjectOverview#SUBSCRIPTION_STATUS_DROPDOWN_ALL");

				Click(locator1 = "CustomerProjectOverview#SUBSCRIPTION_STATUS_DROPDOWN_ACTIVE");

				Click(locator1 = "CustomerProjectOverview#SUBSCRIPTION_STATUS_DROPDOWN_EXPIRED");

				Click(locator1 = "CustomerProjectOverview#SUBSCRIPTION_SELECT_HEADER");
			}
		}
		else if (${filter} == "All") {
			if (IsElementNotPresent(locator1 = "CustomerProjectOverview#SUBSCRIPTION_STATUS_DROPDOWN_ALL_SELECTED")) {
				Click.makeVisibleClickAt(locator1 = "CustomerProjectOverview#SUBSCRIPTION_STATUS_DROPDOWN");

				Click(locator1 = "CustomerProjectOverview#SUBSCRIPTION_STATUS_DROPDOWN_ALL");

				Click(locator1 = "CustomerProjectOverview#SUBSCRIPTION_STATUS_DROPDOWN_ACTIVE");

				Click(locator1 = "CustomerProjectOverview#SUBSCRIPTION_STATUS_DROPDOWN_EXPIRED");

				Click(locator1 = "CustomerProjectOverview#SUBSCRIPTION_SELECT_HEADER");
			}
		}
	}

	@prose = "I should be able to view a ${subscriptionName} subscription purchase on the customer project overview page with the following values ${table}"
	macro viewCustomerSubscriptionPurchaseDetails {
		var key_subscriptionName = ${subscriptionName};
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table ${rawTable}) {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if (${field} == "Type") {
				var key_subscriptionType = ${value};

				AssertTextEquals(
					locator1 = "CustomerProjectOverview#SUBSCRIPTION_TYPE",
					value1 = ${value});
			}
			else if (${field} == "Name") {
				var key_subscriptionName = ${value};

				AssertTextEquals(
					locator1 = "CustomerProjectOverview#SUBSCRIPTION_NAME",
					value1 = ${value});
			}
			else if (${field} == "Instance Size") {
				var key_subscriptionInstanceSize = ${value};

				AssertTextEquals.assertPartialText(
					locator1 = "CustomerProjectOverview#SUBSCRIPTION_INSTANCE_SIZE",
					value1 = ${value});
			}
			else if (${field} == "Date") {
				var key_subscriptionDate = ${value};

				AssertTextEquals(
					locator1 = "CustomerProjectOverview#SUBSCRIPTION_DATE",
					value1 = ${value});
			}
			else if (${field} == "State") {
				var key_subscriptionState = ${value};

				AssertTextEquals(
					locator1 = "CustomerProjectOverview#SUBSCRIPTION_STATE",
					value1 = ${value});
			}
			else {
				fail("No such subscription detail field ${field}");
			}
		}
	}

	@prose = "I should be able to view a support level purchase on the customer subscription page with the following values ${table}"
	macro viewSuportLevelCustomerSubscriptionPurchase {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table ${rawTable}) {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if (${field} == "Name") {
				var key_supportLevelName = ${value};

				AssertTextEquals(
					locator1 = "CustomerProjectOverview#SUPPORT_LEVEL_NAME",
					value1 = ${value});
			}
			else if (${field} == "Support Level Duration") {
				var key_supportLevelDate = ${value};

				AssertTextEquals(
					locator1 = "CustomerProjectOverview#SUPPORT_LEVEL_DATE",
					value1 = ${value});
			}
			else if (${field} == "Status") {
				var key_supportLevelStatus = ${value};

				AssertTextEquals(
					locator1 = "CustomerProjectOverview#SUPPORT_LEVEL_STATUS",
					value1 = ${value});
			}
			else {
				fail("No such subscription detail field ${field}");
			}
		}
	}

}