definition {

	var zendeskURL = PropsUtil.get("zendesk.liferay.url");

	macro _tearDownArticlesByName {
		var rawTable = TableUtil.newTable(${table});

		for (var row : table ${rawTable}) {
			var articleName = "${row[0]}";

			Open(locator1 = "${zendeskURL}/knowledge/lists/");

			ZendeskHomepage.pause(timeInSeconds = 5);

			if (IsElementPresent(locator1 = "ZendeskKCApp#GOT_IT_BUTTON")) {
				Click(locator1 = "ZendeskKCApp#GOT_IT_BUTTON");
			}

			Type(
				locator1 = "ZendeskKCApp#SEARCH_ARTICLE_FIELD",
				value1 = ${articleName});

			KeyPress(
				locator1 = "ZendeskKCApp#SEARCH_ARTICLE_FIELD",
				value1 = "\ENTER");

			if (IsElementPresent(key_articleName = ${articleName}, locator1 = "ZendeskKCApp#ARTICLE")) {
				Click(
					key_articleName = ${articleName},
					locator1 = "ZendeskKCApp#SELECT_ARTICLE");

				Click(locator1 = "ZendeskKCApp#ARTICLE_SETTINGS");

				Click(locator1 = "ZendeskKCApp#ARTICLE_SETTINGS_DELETE_OPTION");

				Click(locator1 = "ZendeskKCApp#ARTICLE_SETTINGS_DELETE_BUTTON");
			}
		}
	}

	macro checkArticleReviewStatus {
		Open(locator1 = "${zendeskURL}/knowledge/lists/");

		ZendeskHomepage.pause(timeInSeconds = 5);

		if (IsElementPresent(locator1 = "ZendeskKCApp#GOT_IT_BUTTON")) {
			Click(locator1 = "ZendeskKCApp#GOT_IT_BUTTON");
		}

		Type(
			locator1 = "ZendeskKCApp#SEARCH_ARTICLE_FIELD",
			value1 = ${articleName});

		KeyPress(
			locator1 = "ZendeskKCApp#SEARCH_ARTICLE_FIELD",
			value1 = "\ENTER");

		AssertElementPresent(
			key_articleName = ${articleName},
			key_reviewStatus = ${reviewStatus},
			locator1 = "ZendeskKCApp#ARTICLE_STATUS");
	}

	macro clickAppsbutton {
		ZendeskHomepage.pause(timeInSeconds = 5);

		if (IsElementNotPresent(locator1 = "ZendeskTicketView#HIDE_APPS_BUTTON")) {
			Click(locator1 = "ZendeskTicketView#APPS_BUTTON");
		}
	}

	macro createFastTrackArticle {
		var rawTable = TableUtil.newTable(${table});

		for (var row : table ${rawTable}) {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if (${field} == "Ticket ID") {
				var ticketId = ${value};
			}
			else if (${field} == "Template") {
				var articleTemplate = ${value};

				if ((${articleTemplate} == "DXPC Fast Track Article") || (${articleTemplate} == "Fast Track Article")) {
					echo("${articleTemplate} is a valid template");
				}
				else {
					fail("No such template ${field}");
				}
			}
			else if (${field} == "Name") {
				var articleName = ${value};
			}
			else if (${field} == "Description") {
				var articleDescription = ${value};
			}
			else if (${field} == "Review Status") {
				var reviewStatus = ${value};
			}
			else {
				fail("No such field ${field}");
			}
		}

		ZendeskTicket.gotoViaId(ticketId = ${ticketId});

		ZendeskKCApp.clickAppsbutton();

		SelectFrame(locator1 = "ZendeskKCApp#KNOWLEDGE_CAPTURE_IFRAME");

		Click(locator1 = "ZendeskKCApp#CREATE_KNOWLEDGE_BUTTON");

		ScrollWebElementIntoView(locator1 = "ZendeskKCApp#DXPC_FAST_TRACK_ARTICLE_TEMPLATE_LINK");

		SelectFrameTop();

		SelectFrame(locator1 = "ZendeskKCApp#KNOWLEDGE_CAPTURE_IFRAME");

		if (${articleTemplate} == "DXPC Fast Track Article") {
			Click(locator1 = "ZendeskKCApp#DXPC_FAST_TRACK_ARTICLE_TEMPLATE_LINK");
		}
		else if (${articleTemplate} == "Fast Track Article") {
			Click(locator1 = "ZendeskKCApp#FAST_TRACK_ARTICLE_TEMPLATE_LINK");
		}

		WaitForSPARefresh();

		SelectFrameTop();

		if (${articleTemplate} == "DXPC Fast Track Article") {
			SelectWindow(locator1 = "New DXP Cloud Article");
		}
		else if (${articleTemplate} == "Fast Track Article") {
			SelectWindow(locator1 = "Fast Track Article");
		}

		AssertElementPresent(locator1 = "ZendeskKBArticleCreate#ARTICLE_NAME_FIELD");

		Click(locator1 = "ZendeskKBArticleCreate#ARTICLE_NAME_FIELD");

		KeyPress.keyDown(
			locator1 = "ZendeskKBArticleCreate#ARTICLE_NAME_INPUT",
			value1 = "\CONTROL");

		KeyPress(
			locator1 = "ZendeskKBArticleCreate#ARTICLE_NAME_INPUT",
			value1 = "a");

		Type.sendKeys(
			locator1 = "ZendeskKBArticleCreate#ARTICLE_NAME_INPUT",
			value1 = ${articleName});

		KeyPress.keyUp(
			locator1 = "ZendeskKBArticleCreate#ARTICLE_NAME_INPUT",
			value1 = "\CONTROL");

		SelectFrame(locator1 = "ZendeskKBArticleCreate#ARTICLE_DESCRIPTION_IFRAME");

		Click(locator1 = "ZendeskKBArticleCreate#ARTICLE_DESCRIPTION_BODY");

		KeyPress.keyDown(
			locator1 = "ZendeskKBArticleCreate#ARTICLE_DESCRIPTION_BODY",
			value1 = "\CONTROL");

		KeyPress(
			locator1 = "ZendeskKBArticleCreate#ARTICLE_DESCRIPTION_BODY",
			value1 = "a");

		Type.sendKeys(
			locator1 = "ZendeskKBArticleCreate#ARTICLE_DESCRIPTION_BODY",
			value1 = ${articleDescription});

		KeyPress.keyUp(
			locator1 = "ZendeskKBArticleCreate#ARTICLE_DESCRIPTION_BODY",
			value1 = "\CONTROL");

		SelectFrameTop();

		SelectWindow(locator1 = ${articleName});

		Click(locator1 = "ZendeskKBArticleCreate#SAVE_ARTICLE_BUTTON");

		if (${reviewStatus} == "Published") {
			Click(locator1 = "ZendeskKBArticleCreate#UPDATE_ARTICLE_OPTION_DROPDOWN_BUTTON");

			Click(locator1 = "ZendeskKBArticleCreate#PUBLISH_ARTICLE_OPTION_LINK");
		}
	}

	macro editArticle {
		var rawTable = TableUtil.newTable(${table});

		for (var row : table ${rawTable}) {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if (${field} == "Article Name") {
				var articleName = ${value};
			}
			else if (${field} == "Article Name Update") {
				var articleNameUpdate = ${value};
			}
			else if (${field} == "Article Description Update") {
				var articleDescriptionUpdate = ${value};
			}
			else if (${field} == "Review Status") {
				var reviewStatus = ${value};
			}
			else if (${field} == "Review Status Update") {
				var reviewStatusUpdate = ${value};
			}
			else {
				fail("No such field ${field}");
			}
		}

		Open(locator1 = "${zendeskURL}/knowledge/lists/");

		ZendeskHomepage.pause(timeInSeconds = 5);

		if (IsElementPresent(locator1 = "ZendeskKCApp#GOT_IT_BUTTON")) {
			Click(locator1 = "ZendeskKCApp#GOT_IT_BUTTON");
		}

		Type(
			locator1 = "ZendeskKCApp#SEARCH_ARTICLE_FIELD",
			value1 = ${articleName});

		KeyPress(
			locator1 = "ZendeskKCApp#SEARCH_ARTICLE_FIELD",
			value1 = "\ENTER");

		Click(
			key_articleName = ${articleName},
			key_reviewStatus = ${reviewStatus},
			locator1 = "ZendeskKCApp#ARTICLE_STATUS");

		Click(locator1 = "ZendeskKBArticleCreate#ARTICLE_NAME_FIELD");

		KeyPress.keyDown(
			locator1 = "ZendeskKBArticleCreate#ARTICLE_NAME_INPUT",
			value1 = "\CONTROL");

		KeyPress(
			locator1 = "ZendeskKBArticleCreate#ARTICLE_NAME_INPUT",
			value1 = "a");

		Type.sendKeys(
			locator1 = "ZendeskKBArticleCreate#ARTICLE_NAME_INPUT",
			value1 = ${articleNameUpdate});

		KeyPress.keyUp(
			locator1 = "ZendeskKBArticleCreate#ARTICLE_NAME_INPUT",
			value1 = "\CONTROL");

		SelectFrame(locator1 = "ZendeskKBArticleCreate#ARTICLE_DESCRIPTION_IFRAME");

		Click(locator1 = "ZendeskKBArticleCreate#ARTICLE_DESCRIPTION_BODY");

		KeyPress.keyDown(
			locator1 = "ZendeskKBArticleCreate#ARTICLE_DESCRIPTION_BODY",
			value1 = "\CONTROL");

		KeyPress(
			locator1 = "ZendeskKBArticleCreate#ARTICLE_DESCRIPTION_BODY",
			value1 = "a");

		Type.sendKeys(
			locator1 = "ZendeskKBArticleCreate#ARTICLE_DESCRIPTION_BODY",
			value1 = ${articleDescriptionUpdate});

		KeyPress.keyUp(
			locator1 = "ZendeskKBArticleCreate#ARTICLE_DESCRIPTION_BODY",
			value1 = "\CONTROL");

		SelectFrameTop();

		SelectWindow(locator1 = ${articleNameUpdate});

		Click(locator1 = "ZendeskKBArticleCreate#UPDATE_ARTICLE_BUTTON");

		if (${reviewStatusUpdate} == "Published") {
			ZendeskHomepage.pause(timeInSeconds = 10);

			Click(locator1 = "ZendeskKBArticleCreate#UPDATE_ARTICLE_OPTION_DROPDOWN_BUTTON");

			Click(locator1 = "ZendeskKBArticleCreate#PUBLISH_ARTICLE_OPTION_LINK");
		}
	}

	macro viewArticle {
		SelectFrame(locator1 = "ZendeskKCApp#KNOWLEDGE_CAPTURE_IFRAME");

		if (IsElementPresent(locator1 = "ZendeskKCApp#CLOSE_CREATE_KNOWLEDGE_BUTTON")) {
			Click(locator1 = "ZendeskKCApp#CLOSE_CREATE_KNOWLEDGE_BUTTON");
		}

		SelectFrameTop();

		SelectFrame(locator1 = "ZendeskKCApp#KNOWLEDGE_CAPTURE_IFRAME");

		Type(
			locator1 = "ZendeskKCApp#SEARCH_ARTICLE_IFRAME",
			value1 = ${articleName});

		KeyPress(
			locator1 = "ZendeskKCApp#SEARCH_ARTICLE_IFRAME",
			value1 = "\ENTER");

		Click(
			key_articleName = ${articleName},
			locator1 = "ZendeskKCApp#ARTICLE_NAME");

		SelectFrameTop();

		SelectFrame(locator1 = "ZendeskKCApp#KNOWLEDGE_CAPTURE_POPUP_IFRAME");

		AssertElementPresent(
			key_articleName = ${articleName},
			locator1 = "ZendeskKCApp#KNOWLEDGE_CAPTURE_POPUP_ARTICLE_NAME");

		AssertElementPresent(
			key_articleDescription = ${articleDescription},
			locator1 = "ZendeskKCApp#KNOWLEDGE_CAPTURE_POPUP_ARTICLE_DESCRIPTION");

		SelectFrameTop();

		Click(locator1 = "ZendeskKCApp#KNOWLEDGE_CAPTURE_POPUP_CLOSE_LINK");
	}

	macro viewNoArticle {
		SelectFrame(locator1 = "ZendeskKCApp#KNOWLEDGE_CAPTURE_IFRAME");

		if (IsElementPresent(locator1 = "ZendeskKCApp#CLOSE_CREATE_KNOWLEDGE_BUTTON")) {
			Click(locator1 = "ZendeskKCApp#CLOSE_CREATE_KNOWLEDGE_BUTTON");
		}

		SelectFrameTop();

		SelectFrame(locator1 = "ZendeskKCApp#KNOWLEDGE_CAPTURE_IFRAME");

		Type(
			locator1 = "ZendeskKCApp#SEARCH_ARTICLE_IFRAME",
			value1 = ${articleName});

		KeyPress(
			locator1 = "ZendeskKCApp#SEARCH_ARTICLE_IFRAME",
			value1 = "\ENTER");

		AssertElementNotPresent(
			key_articleName = ${articleName},
			locator1 = "ZendeskKCApp#ARTICLE_NAME");

		SelectFrameTop();
	}

	macro viewNoArticleViaList {
		Open(locator1 = "${zendeskURL}/knowledge/lists/");

		ZendeskHomepage.pause(timeInSeconds = 5);

		if (IsElementPresent(locator1 = "ZendeskKCApp#GOT_IT_BUTTON")) {
			Click(locator1 = "ZendeskKCApp#GOT_IT_BUTTON");
		}

		Type(
			locator1 = "ZendeskKCApp#SEARCH_ARTICLE_FIELD",
			value1 = ${articleName});

		KeyPress(
			locator1 = "ZendeskKCApp#SEARCH_ARTICLE_FIELD",
			value1 = "\ENTER");

		AssertElementNotPresent(
			key_articleName = ${articleName},
			locator1 = "ZendeskKCApp#ARTICLE");
	}

}