definition {

	var zendeskURL = PropsUtil.get("zendesk.liferay.url");

	macro viewKBArticleAttachment {
		AssertVisible(locator1 = "ZendeskKBArticle#ARTICLE_ATTACHMENT");
	}

	macro viewKBArticleBody {
		AssertVisible(locator1 = "ZendeskKBArticle#ARTICLE_BODY");
	}

	macro viewKBArticleFastTrackSection {
		AssertVisible(locator1 = "ZendeskKBArticle#FAST_TRACK");
	}

	macro viewKBArticleSectionContent {
		var key_articleSection = ${articleSection};

		AssertVisible(locator1 = "ZendeskKBArticle#SECTION_CONTENT");
	}

	macro viewKBArticleSectionGated {
		var key_articleSection = ${articleSection};

		AssertVisible(locator1 = "ZendeskKBArticle#GATED_SECTION");
	}

	macro viewKBArticleSectionHeader {
		var key_articleSection = ${articleSection};

		AssertVisible(locator1 = "ZendeskKBArticle#SECTION_HEADER");
	}

	macro viewKBArticleSignInMessageWithSignInButton {
		AssertVisible(locator1 = "ZendeskKBArticle#SUBSCRIBER_EXCLUSIVE_CONTENT_MESSAGE_TITLE");

		AssertVisible(locator1 = "ZendeskKBArticle#SUBSCRIBER_EXCLUSIVE_CONTENT_SIGN_IN_MESSAGE_CONTENT");

		AssertVisible(locator1 = "ZendeskKBArticle#SUBSCRIBER_EXCLUSIVE_CONTENT_SIGN_IN_MESSAGE_BUTTON");
	}

	macro viewKBArticleSubscriptionMessageWithSubscriptionLink {
		AssertVisible(locator1 = "ZendeskKBArticle#SUBSCRIBER_EXCLUSIVE_CONTENT_MESSAGE_TITLE");

		AssertVisible(locator1 = "ZendeskKBArticle#SUBSCRIBER_EXCLUSIVE_CONTENT_SUBSCRIPTION_MESSAGE_CONTENT");

		AssertVisible(locator1 = "ZendeskKBArticle#SUBSCRIBER_EXCLUSIVE_CONTENT_SUBSCRIPTION_MESSAGE_LINK");
	}

	macro viewKBArticleTitle {
		var key_articleTitle = ${articleTitle};

		AssertVisible(locator1 = "ZendeskKBArticle#ARTICLE_TITLE");
	}

	macro viewKBArticleVoteControls {
		AssertVisible(locator1 = "ZendeskKBArticle#ARTICLE_VOTES_TITLE");

		AssertVisible(locator1 = "ZendeskKBArticle#ARTICLE_VOTES_YES_BUTTON");

		AssertVisible(locator1 = "ZendeskKBArticle#ARTICLE_VOTES_NO_BUTTON");
	}

	macro viewNoKBArticleAttachment {
		AssertNotVisible(locator1 = "ZendeskKBArticle#ARTICLE_ATTACHMENT");
	}

	macro viewNoKBArticleSectionContent {
		var key_articleSection = ${articleSection};

		AssertElementNotPresent(locator1 = "ZendeskKBArticle#SECTION_CONTENT");
	}

	macro viewNoKBArticleSectionGated {
		var key_articleSection = ${articleSection};

		AssertElementNotPresent(locator1 = "ZendeskKBArticle#GATED_SECTION");
	}

	macro viewNoKBArticleSubscriptionMessage {
		AssertElementNotPresent(locator1 = "ZendeskKBArticle#SUBSCRIBER_EXCLUSIVE_CONTENT_MESSAGE_TITLE");

		AssertElementNotPresent(locator1 = "ZendeskKBArticle#SUBSCRIBER_EXCLUSIVE_CONTENT_SUBSCRIPTION_MESSAGE_CONTENT");

		AssertElementNotPresent(locator1 = "ZendeskKBArticle#SUBSCRIBER_EXCLUSIVE_CONTENT_SIGN_IN_MESSAGE_CONTENT");
	}

	macro viewNoKBArticleVoteControls {
		AssertNotVisible(locator1 = "ZendeskKBArticle#ARTICLE_VOTES_TITLE");

		AssertNotVisible(locator1 = "ZendeskKBArticle#ARTICLE_VOTES_YES_BUTTON");

		AssertNotVisible(locator1 = "ZendeskKBArticle#ARTICLE_VOTES_NO_BUTTON");
	}

}