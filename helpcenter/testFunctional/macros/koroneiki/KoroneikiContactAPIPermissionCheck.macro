	macro _setContactPermissionsViaUuid {
		var contactUuid = KoroneikiContactAPI._getContactUuidViaContactEmailAddress(contactEmailAddress = ${contactEmailAddress});
		var rawTable = TableUtil.newTable(${table});

		for (var row : table ${rawTable}) {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if (${field} == "Delete") {
				var value = StringUtil.lowerCase(${value});

				var delete = ${value};
			}
			else if (${field} == "Permissions") {
				var value = StringUtil.lowerCase(${value});

				var permissions = ${value};
			}
			else if (${field} == "Update") {
				var value = StringUtil.lowerCase(${value});

				var update = ${value};
			}
			else if (${field} == "View") {
				var value = StringUtil.lowerCase(${value});

				var view = ${value};
			}
			else {
				fail("No such permission field ${field}");
			}
		}

		if (!(isSet(delete))) {
			var delete = "false";
		}

		if (!(isSet(permissions))) {
			var permissions = "false";
		}

		if (!(isSet(update))) {
			var update = "false";
		}

		if (!(isSet(view))) {
			var view = "false";
		}

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/contacts/by-uuid/${contactUuid}/contact-permissions --tlsv1.2
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				-d
				{
					"delete": "${delete}",
					"permissions": "${permissions}",
					"roleNames": [
						"${roleName}"
					],
					"update": "${update}",
					"view": "${view}"
				}
		''';

		com.liferay.poshi.runner.util.JSONCurlUtil.put(${curl});
	}

