			if (contains(${contactObject}, "lastName=")) {
				var value = JSONCurlUtil.get(${curl}, "$.lastName");

				var lastName = ${value};
			}
			else {
				var lastName = "";
			}
		}

		if (!(isSet(middleName))) {
			var contactObject = JSONCurlUtil.get(${curl}, "$");

			if (contains(${contactObject}, "middleName=")) {
				var value = JSONCurlUtil.get(${curl}, "$.middleName");

				var middleName = ${value};
			}
			else {
				var middleName = "";
			}
		}

		if (!(isSet(uuid))) {
			var contactObject = JSONCurlUtil.get(${curl}, "$");

			if (contains(${contactObject}, "uuid=")) {
				var value = JSONCurlUtil.get(${curl}, "$.uuid");

				var uuid = ${value};
			}
			else {
				var uuid = "";
			}
		}

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/contacts/by-uuid/${contactUuid} --tlsv1.2
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				-d
				{
					"emailAddress": "${emailAddress}",
					"emailAddressVerified": ${emailAddressVerified},
					"firstName": "${firstName}",
					"languageId": "${languageId}",
					"lastName": "${lastName}",
					"middleName": "${middleName}",
					"uuid": "${uuid}"
				}
		''';

		com.liferay.poshi.runner.util.JSONCurlUtil.put(${curl});
	}

	macro _updateContactViaUuidAttempt {
		var contactUuid = KoroneikiContactAPI._getContactUuidViaContactEmailAddress(contactEmailAddress = ${contactEmailAddress});
		var rawTable = TableUtil.newTable(${table});

		for (var row : table ${rawTable}) {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if (${field} == "Email Address") {
				var emailAddress = ${value};
			}
			else if (${field} == "Email Address Verified") {
				var emailAddressVerified = ${value};
			}
			else if (${field} == "First Name") {
				var firstName = ${value};
			}
			else if (${field} == "Language") {
				var languageId = ${value};
			}
			else if (${field} == "Last Name") {
				var lastName = ${value};
			}
			else if (${field} == "Middle Name") {
				var middleName = ${value};
			}
			else if (${field} == "UUID") {
				var uuid = ${value};
			}
			else {
				fail("No such contact field ${field}");
			}
		}

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/contacts/by-uuid/${contactUuid} --tlsv1.2
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
		''';

		if (!(isSet(emailAddress))) {
