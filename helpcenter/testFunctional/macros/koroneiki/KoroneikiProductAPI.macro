		}

		if (!(isSet(permissions))) {
			var permissions = "false";
		}

		if (!(isSet(update))) {
			var update = "false";
		}

		if (!(isSet(view))) {
			var view = "false";
		}

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/products/${productKey}/product-permissions --tlsv1.2
				--header "API_Token: ${apiToken}"
