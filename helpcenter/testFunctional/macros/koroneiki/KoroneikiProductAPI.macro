				-H "Content-Type: application/json"
				-d
				{
					"consume": "${consume}",
					"delete": "${delete}",
					"permissions": "${permissions}",
					"roleNames": [
						"${roleName}"
					],
					"update": "${update}",
					"view": "${view}"
				}
