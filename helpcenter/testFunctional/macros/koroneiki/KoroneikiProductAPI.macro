definition {

	var apiToken = PropsUtil.get("koroneiki.api.token");
	var koroneikiAdminEmail = PropsUtil.get("koroneiki.admin.email.address");
	var koroneikiAdminPassword = PropsUtil.get("koroneiki.admin.password");
	var koroneikiURL = PropsUtil.get("koroneiki.liferay.url");
	var roleName = PropsUtil.get("koroneiki.non.permission.role.name");

	macro _createProduct {
		var properties = "";
		var rawTable = TableUtil.newTable(${table});

		for (var row : table ${rawTable}) {
			var field = "${row[0]}";
			var value1 = "${row[1]}";
			var value2 = "${row[2]}";

			if (${field} == "Agent Name") {
				var value1 = StringUtil.replace(${value1}, " ", "%20");

				var agentName = ${value1};
			}
			else if (${field} == "Name") {
				var name = ${value1};
			}
			else if (${field} == "Product Field and Value") {
				if (${properties} == "") {
					var properties = "\"${value1}\":\"${value2}\"";
				}
				else {
					var properties = "${properties},\"${value1}\":\"${value2}\"";
				}
			}
			else {
				fail("No such product field ${field}");
			}
		}

		if (!(isSet(agentName))) {
			var agentName = "";
		}

		if (!(isSet(name))) {
			var name = "";
		}

		if (${properties} == "") {
			if (${agentName} == "") {
				var curl = '''
					${koroneikiURL}/o/koroneiki-rest/v1.0/products --tlsv1.2
						--header "API_Token: ${apiToken}"
						-H "accept: application/json"
						-H "Content-Type: application/json"
						-d
						{
							"name": "${name}"
						}
				''';
			}
			else {
				var curl = '''
					${koroneikiURL}/o/koroneiki-rest/v1.0/products?agentName=${agentName}\&agentUID=a1b2c3d4-e5f6-g7h8-i9j1-0k11l12m13n1 --tlsv1.2
						--header "API_Token: ${apiToken}"
						-H "accept: application/json"
						-H "Content-Type: application/json"
						-d
						{
							"name": "${name}"
						}
				''';
			}
		}
		else {
			if (${agentName} == "") {
				var curl = '''
					${koroneikiURL}/o/koroneiki-rest/v1.0/products --tlsv1.2
						--header "API_Token: ${apiToken}"
						-H "accept: application/json"
						-H "Content-Type: application/json"
						-d
						{
							"name": "${name}",
							"properties": {
								${properties}
							}
						}
				''';
			}
			else {
				var curl = '''
					${koroneikiURL}/o/koroneiki-rest/v1.0/products?agentName=${agentName}\&agentUID=a1b2c3d4-e5f6-g7h8-i9j1-0k11l12m13n1 --tlsv1.2
						--header "API_Token: ${apiToken}"
						-H "accept: application/json"
						-H "Content-Type: application/json"
						-d
						{
							"name": "${name}",
							"properties": {
								${properties}
							}
						}
				''';
			}
		}

		com.liferay.poshi.runner.util.JSONCurlUtil.post(${curl});
	}

	macro _createProductExternalLink {
		var productKey = KoroneikiProductAPI._getProductKeyViaProductName(productName = ${productName});
		var rawTable = TableUtil.newTable(${table});

		for (var row : table ${rawTable}) {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if (${field} == "Domain") {
				var domain = ${value};
			}
			else if (${field} == "Entity Id") {
				var entityId = ${value};
			}
			else if (${field} == "Entity Name") {
				var entityName = ${value};
			}
			else {
				fail("No such external link field ${field}");
			}
		}

		if (!(isSet(domain))) {
			var domain = "";
		}

		if (!(isSet(entityId))) {
			var entityId = "";
		}

		if (!(isSet(entityName))) {
			var entityName = "";
		}

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/products/${productKey}/external-links --tlsv1.2
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				-d
				{
					"domain": "${domain}",
					"entityId": "${entityId}",
					"entityName": "${entityName}"
				}
		''';

		com.liferay.poshi.runner.util.JSONCurlUtil.post(${curl});
	}

	macro _createProductExternalLinkNestedField {
		var rawTable = TableUtil.newTable(${table});

		for (var row : table ${rawTable}) {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if (${field} == "Domain") {
				var domain = ${value};
			}
			else if (${field} == "Entity Id") {
				var entityId = ${value};
			}
			else if (${field} == "Entity Name") {
				var entityName = ${value};
			}
			else if (${field} == "URL") {
				var url = ${value};
			}
			else {
				fail("No such external link field ${field}");
			}
		}

		if (!(isSet(domain))) {
			var domain = "";
		}

		if (!(isSet(entityId))) {
			var entityId = "";
		}

		if (!(isSet(entityName))) {
			var entityName = "";
		}

		if (!(isSet(url))) {
			var url = "";
		}

		static var staticProductExternalLinksNestedField = "{\"domain\":\"${domain}\",\"entityId\":\"${entityId}\",\"entityName\":\"${entityName}\",\"url\":\"${url}\"}";

		return ${staticProductExternalLinksNestedField};
	}

	macro _createProductNestedFieldForNonexistentProduct {
		static var staticProductNestedField = "{\"name\":\"${productName}\"}";

		return ${staticProductNestedField};
	}

	macro _deleteProduct {
		var productKey = KoroneikiProductAPI._getProductKeyViaProductName(productName = ${productName});

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/products/${productKey} --tlsv1.2
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
		''';

		com.liferay.poshi.runner.util.JSONCurlUtil.delete(${curl});
	}

	macro _deleteProductExternalLink {
		var externalLinkKey = KoroneikiProductAPI._getProductExternalLinkKey(
			entityId = ${entityId},
			productName = ${productName});

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/external-links/${externalLinkKey} --tlsv1.2
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
		''';

		com.liferay.poshi.runner.util.JSONCurlUtil.delete(${curl});
	}

	macro _generateProductId {
		var productKey = KoroneikiProductAPI._getProductKeyViaProductName(productName = ${productName});

		var productId = StringUtil.replace(${productKey}, "KOR-", "");

		static var staticProductId = ${productId};

		return ${staticProductId};
	}

	macro _generateProductKey {
		var productKey = KoroneikiProductAPI._getProductKeyViaProductName(productName = ${productName});

		static var staticProductKey = ${productKey};

		return ${staticProductKey};
	}

	macro _getProductExternalLinkKey {
		var productKey = KoroneikiProductAPI._getProductKeyViaProductName(productName = ${productName});

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/products/${productKey}/external-links --tlsv1.2
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
		''';

		var externalLinkKey = JSONCurlUtil.get(${curl}, "$.items[?(@.entityId=='${entityId}')].key");

		var externalLinkKey = StringUtil.replace(${externalLinkKey}, "[", "");

		var externalLinkKey = StringUtil.replace(${externalLinkKey}, "]", "");

		var externalLinkKey = StringUtil.replace(${externalLinkKey}, "\"", "");

		echo("External link key value for ${entityId} for product ${productName}: ${externalLinkKey}");

		return ${externalLinkKey};
	}

	macro _getProductKeyViaProductName {
		if (contains(${productName}, " ")) {
			var keyword = StringUtil.replace(${productName}, " ", "+");
		}
		else {
			var keyword = ${productName};
		}

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/products?filter="name%20eq%20'${keyword}'" --tlsv1.2
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
		''';

		var productKey = JSONCurlUtil.get(${curl}, "$.items[?(@.name=='${productName}')].key");

		var productKey = StringUtil.replace(${productKey}, "[", "");

		var productKey = StringUtil.replace(${productKey}, "]", "");

		var productKey = StringUtil.replace(${productKey}, "\"", "");

		echo("Product key value for ${productName}: ${productKey}");

		return ${productKey};
	}

	macro _renameFirstProductIdValue {
		static var staticProductId1 = ${staticProductId};

		return ${staticProductId1};
	}

	macro _renameSecondProductIdValue {
		static var staticProductId2 = ${staticProductId};

		return ${staticProductId2};
	}

	macro _renameThirdProductIdValue {
		static var staticProductId3 = ${staticProductId};

		return ${staticProductId3};
	}

	macro _setProductPermissions {
		var productKey = KoroneikiProductAPI._getProductKeyViaProductName(productName = ${productName});
		var rawTable = TableUtil.newTable(${table});

		for (var row : table ${rawTable}) {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if (${field} == "Consume") {
				var value = StringUtil.lowerCase(${value});

				var consume = ${value};
			}
			else if (${field} == "Delete") {
				var value = StringUtil.lowerCase(${value});

				var delete = ${value};
			}
			else if (${field} == "Permissions") {
				var value = StringUtil.lowerCase(${value});

				var permissions = ${value};
			}
			else if (${field} == "Update") {
				var value = StringUtil.lowerCase(${value});

				var update = ${value};
			}
			else if (${field} == "View") {
				var value = StringUtil.lowerCase(${value});

				var view = ${value};
			}
			else {
				fail("No such permission field ${field}");
			}
		}

		if (!(isSet(consume))) {
			var consume = "false";
		}

		if (!(isSet(delete))) {
			var delete = "false";
		}

		if (!(isSet(permissions))) {
			var permissions = "false";
		}

		if (!(isSet(update))) {
			var update = "false";
		}

		if (!(isSet(view))) {
			var view = "false";
		}

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/products/${productKey}/product-permissions --tlsv1.2
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				-d
				{
					"consume": "${consume}",
					"delete": "${delete}",
					"permissions": "${permissions}",
					"roleNames": [
						"${roleName}"
					],
					"update": "${update}",
					"view": "${view}"
				}
		''';

		com.liferay.poshi.runner.util.JSONCurlUtil.put(${curl});
	}

	macro _tearDownProductExternalLinks {
		var rawTable = TableUtil.newTable(${table});

		for (var row : table ${rawTable}) {
			var entityId = "${row[0]}";

			if (contains(${productName}, " ")) {
				var keyword = StringUtil.replace(${productName}, " ", "+");
			}
			else {
				var keyword = ${productName};
			}

			var curl = '''
				${koroneikiURL}/o/koroneiki-rest/v1.0/products?filter="name%20eq%20'${keyword}'" --tlsv1.2
					--header "API_Token: ${apiToken}"
					-H "accept: application/json"
					-H "Content-Type: application/json"
			''';

			var allProducts = JSONCurlUtil.get(${curl}, "$");

			if (contains(${allProducts}, ${productName})) {
				var productKey = KoroneikiProductAPI._getProductKeyViaProductName(productName = ${productName});

				var curl = '''
					${koroneikiURL}/o/koroneiki-rest/v1.0/products/${productKey}/external-links --tlsv1.2
						--header "API_Token: ${apiToken}"
						-H "accept: application/json"
						-H "Content-Type: application/json"
				''';

				var allProductExternalLinks = JSONCurlUtil.get(${curl}, "$");

				if (contains(${allProductExternalLinks}, ${entityId})) {
					KoroneikiProductAPI._deleteProductExternalLink(
						entityId = ${entityId},
						productName = ${productName});

					echo("Entity ID of external link for ${productName} deleted: ${entityId}");
				}
			}
		}
	}

	macro _tearDownProductPermissions {
		if (contains(${productName}, " ")) {
			var keyword = StringUtil.replace(${productName}, " ", "+");
		}
		else {
			var keyword = ${productName};
		}

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/products?filter="name%20eq%20'${keyword}'" --tlsv1.2
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
		''';

		var allProducts = JSONCurlUtil.get(${curl}, "$");

		if (contains(${allProducts}, ${productName})) {
			var productKey = KoroneikiProductAPI._getProductKeyViaProductName(productName = ${productName});

			var curl = '''
				${koroneikiURL}/o/koroneiki-rest/v1.0/products/${productKey}/product-permissions --tlsv1.2
					--header "API_Token: ${apiToken}"
					-H "accept: application/json"
					-H "Content-Type: application/json"
					-d
					{
						"assignContact": "true",
						"delete": "true",
						"permissions": "true",
						"roleNames": [
							"${roleName}"
						],
						"update": "true",
						"view": "true"
					}
			''';

			com.liferay.poshi.runner.util.JSONCurlUtil.delete(${curl});
		}
	}

	macro _tearDownProducts {
		var rawTable = TableUtil.newTable(${table});

		for (var row : table ${rawTable}) {
			var productName = "${row[0]}";

			if (contains(${productName}, " ")) {
				var keyword = StringUtil.replace(${productName}, " ", "+");
			}
			else {
				var keyword = ${productName};
			}

			var curl = '''
				${koroneikiURL}/o/koroneiki-rest/v1.0/products?filter="name%20eq%20'${keyword}'" --tlsv1.2
					--header "API_Token: ${apiToken}"
					-H "accept: application/json"
					-H "Content-Type: application/json"
			''';

			var allProducts = JSONCurlUtil.get(${curl}, "$");

			if (contains(${allProducts}, ${productName})) {
				KoroneikiProductAPI._deleteProduct(productName = ${productName});

				echo("Name of product deleted: ${productName}");
			}
		}
	}

	macro _unsetProductPermissions {
		var productKey = KoroneikiProductAPI._getProductKeyViaProductName(productName = ${productName});
		var rawTable = TableUtil.newTable(${table});

		for (var row : table ${rawTable}) {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if (${field} == "Consume") {
				var value = StringUtil.lowerCase(${value});

				var consume = ${value};
			}
			else if (${field} == "Delete") {
				var value = StringUtil.lowerCase(${value});

				var delete = ${value};
			}
			else if (${field} == "Permissions") {
				var value = StringUtil.lowerCase(${value});

				var permissions = ${value};
			}
			else if (${field} == "Update") {
				var value = StringUtil.lowerCase(${value});

				var update = ${value};
			}
			else if (${field} == "View") {
				var value = StringUtil.lowerCase(${value});

				var view = ${value};
			}
			else {
				fail("No such permission field ${field}");
			}
		}

		if (!(isSet(consume))) {
