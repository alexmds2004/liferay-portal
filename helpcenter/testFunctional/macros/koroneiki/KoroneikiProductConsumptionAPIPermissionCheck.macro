	macro _viewNoProductConsumption {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = ${accountName});
		var productKey = KoroneikiProductAPI._getProductKeyViaProductName(productName = ${productName});
		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}/product-consumptions --tlsv1.2
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
		''';

		var allAccountProductConsumptions = JSONCurlUtil.get(${curl}, "$");

		if (contains(${allAccountProductConsumptions}, ${productKey})) {
			fail("The product consumption made by ${accountName} for the product ${productName} is visible to non permissioned users");
		}

		var productConsumptionKey = KoroneikiAccountAPI._getAccountProductConsumptionKeyViaAccountAndProductName(
			accountName = ${accountName},
			productName = ${productName});

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/product-consumptions/${productConsumptionKey} --tlsv1.2
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
		''';

		var accountProductConsumption = JSONCurlUtil.get(${curl}, "$");

		if (contains(${accountProductConsumption}, ${productKey})) {
			fail("The product consumption made by ${accountName} for the product ${productName} is visible to non permissioned users");
		}
	}

	macro _viewNoProductConsumptionExternalLink {
		var productConsumptionKey = KoroneikiAccountAPI._getAccountProductConsumptionKeyViaAccountAndProductName(
			accountName = ${accountName},
			productName = ${productName});

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/product-consumptions/${productConsumptionKey}/external-links --tlsv1.2
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
		''';

		var allProductConsumptionExternalLinks = JSONCurlUtil.get(${curl}, "$");

		if (contains(${allProductConsumptionExternalLinks}, ${entityId})) {
			fail("The external link with the entity id ${entityId} on the product consumption made by the account ${accountName} for the product ${productName} is visible to non permissioned users");
		}

		var externalLinkKey = KoroneikiProductConsumptionAPI._getProductConsumptionExternalLinkKey(
			accountName = ${accountName},
			entityId = ${entityId},
			productName = ${productName});

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/external-links/${externalLinkKey} --tlsv1.2
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
		''';

		var productConsumptionExternalLink = JSONCurlUtil.get(${curl}, "$");

		if (contains(${productConsumptionExternalLink}, ${entityId})) {
			fail("The external link with the entity id ${entityId} on the product consumption made by the account ${accountName} for the product ${productName} is visible to non permissioned users");
		}
	}

	macro _viewNoProductConsumptionViaExternalLink {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = ${accountName});
		var productKey = KoroneikiProductAPI._getProductKeyViaProductName(productName = ${productName});
		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/product-consumptions/by-external-link/${domain}/${entityName}/${entityId} --tlsv1.2
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
		''';

		var accountProductConsumption = JSONCurlUtil.get(${curl}, "$");

		if (contains(${accountProductConsumption}, ${accountKey}) || contains(${accountProductConsumption}, ${productKey})) {
			fail("The product consumption made by ${accountName} for the product ${productName} is visible to non permissioned users");
		}
	}

	macro _viewProductConsumption {
		var productConsumptionKey = KoroneikiAccountAPI._getAccountProductConsumptionKeyViaAccountAndProductName(
			accountName = ${accountName},
			productName = ${productName});

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/product-consumptions/${productConsumptionKey} --tlsv1.2
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
		''';
		var rawTable = TableUtil.newTable(${table});

		for (var row : table ${rawTable}) {
			var field = "${row[0]}";
			var value1 = "${row[1]}";
			var value2 = "${row[2]}";

			if (${field} == "End Date") {
				var valueFromAPI = JSONCurlUtil.get(${curl}, "$.endDate");
			}
			else if (${field} == "External Link Nested Field") {
				var valueFromAPI = JSONCurlUtil.get(${curl}, "$.externalLinks");
			}
			else if (${field} == "Product Field and Value") {
				var valueFromAPI = JSONCurlUtil.get(${curl}, "$.properties.${value1}");
			}
			else if (${field} == "Product Purchase") {
				if (${value1} == "true") {
					var valueFromAPI = JSONCurlUtil.get(${curl}, "$.productPurchaseKey");
				}
			}
			else if (${field} == "Start Date") {
				var valueFromAPI = JSONCurlUtil.get(${curl}, "$.startDate");
			}
			else {
				fail("No such product consumption field ${field}");
			}

			if (${field} == "Product Field and Value") {
				echo("Expected property field ${value1} value: ${value2}");

				echo("Actual property field ${value1} value: ${valueFromAPI}");

				if (!(contains(${value2}, ${valueFromAPI}))) {
					fail("Actual property field ${value1} value ${valueFromAPI} does not match expected property field ${value1} value ${value2}");
				}
			}
			else if (${field} == "Product Purchase") {
				if (${value1} == "true") {
					var productPurchaseKey = KoroneikiAccountAPI._getAccountProductPurchaseKeyViaAccountAndProductName(
						accountName = ${accountName},
						productName = ${productName});

					echo("Expected ${field} Value: ${productPurchaseKey}");

					echo("Actual ${field} Value: ${valueFromAPI}");

					if (!(contains(${productPurchaseKey}, ${valueFromAPI}))) {
						fail("Actual ${field} value ${valueFromAPI} does not match expected ${field} value ${productPurchaseKey}");
					}
				}
			}
			else if (contains(${field}, "Nested Field")) {
				echo("Expected Partial ${field} Value: ${value1}");

				echo("Actual ${field} Value: ${valueFromAPI}");

				if (!(contains(${valueFromAPI}, ${value1}))) {
					fail("Actual ${field} value ${valueFromAPI} does not contain the expected ${field} value ${value1}");
				}
			}
			else {
				echo("Expected ${field} Value: ${value1}");

				echo("Actual ${field} Value: ${valueFromAPI}");

				if (!(contains(${value1}, ${valueFromAPI}))) {
					fail("Actual ${field} value ${valueFromAPI} does not match expected ${field} value ${value1}");
				}
			}
		}
	}

}