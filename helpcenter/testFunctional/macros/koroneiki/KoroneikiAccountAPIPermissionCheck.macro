	macro _createAccountProductPurchaseAttempt {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = ${accountName});
		var productKey = KoroneikiProductAPI._getProductKeyViaProductName(productName = ${productName});
		var properties = "";
		var rawTable = TableUtil.newTable(${table});

		for (var row : table ${rawTable}) {
			var field = "${row[0]}";
			var value1 = "${row[1]}";
			var value2 = "${row[2]}";

			if (${field} == "End Date") {
				var endDate = ${value1};
			}
			else if (${field} == "Original End Date") {
				var originalEndDate = ${value1};
			}
			else if (${field} == "Perpetual") {
				var value1 = StringUtil.lowerCase(${value1});

				var value1 = StringUtil.replace(${value1}, " ", "-");

				var perpetual = ${value1};
			}
			else if (${field} == "Product Field and Value") {
				if (${properties} == "") {
					var properties = "\"${value1}\": \"${value2}\"";
				}
				else {
					var properties = "${properties},\"${value1}\": \"${value2}\"";
				}
			}
			else if (${field} == "Quantity") {
				var quantity = ${value1};
			}
			else if (${field} == "Start Date") {
				var startDate = ${value1};
			}
			else if (${field} == "Status") {
				var status = ${value1};
			}
			else {
				fail("No such product purchase field ${field}");
			}
		}

		if (!(isSet(endDate))) {
			var endDate = "";
		}

		if (!(isSet(originalEndDate))) {
			var originalEndDate = "";
		}

		if (!(isSet(perpetual))) {
			var perpetual = "true";
		}

		if (!(isSet(quantity))) {
			var quantity = 1;
		}

		if (!(isSet(startDate))) {
			var startDate = "";
		}

		if (!(isSet(status))) {
			var status = "";
		}

		if (${properties} == "") {
			var curl = '''
				${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}/product-purchases --tlsv1.2
					--header "API_Token: ${apiToken}"
					-H "accept: application/json"
					-H "Content-Type: application/json"
					-d
					{
						"endDate": "${endDate}",
						"originalEndDate": "${originalEndDate}",
						"perpetual": ${perpetual},
						"productKey": "${productKey}",
						"quantity": ${quantity},
						"startDate": "${startDate}",
						"status": "${status}"
					}
			''';
		}
		else {
			var curl = '''
				${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}/product-purchases --tlsv1.2
					--header "API_Token: ${apiToken}"
