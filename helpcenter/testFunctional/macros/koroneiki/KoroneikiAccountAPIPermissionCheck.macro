				var value1 = JSONCurlUtil.get(${curl}, "$.internal");

				var internal = ${value1};
			}
			else {
				var internal = "false";
			}
		}

		if (!(isSet(language))) {
			var accountObject = JSONCurlUtil.get(${curl}, "$");

			if (contains(${accountObject}, "language=")) {
				var value1 = JSONCurlUtil.get(${curl}, "$.language");

