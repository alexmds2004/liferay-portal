						"contactEmailAddress": "${contactEmailAddress}",
						"dataRegion": "${dataRegion}",
						"description": "${description}",
						"faxNumber": "${faxNumber}",
						"internal": ${internal},
						"language": "${language}",
						"name": "${name}",
						"phoneNumber": "${phoneNumber}",
						"profileEmailAddress": "${profileEmailAddress}",
						"properties": {
							${properties}
						},
						"region": "${region}",
						"status": "${status}",
						"tier": "${tier}",
						"website": "${website}"
					}
			''';
		}

		com.liferay.poshi.runner.util.JSONCurlUtil.put(${curl});
	}

	macro _updateAccountAttempt {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = ${accountName});
		var properties = "";
		var rawTable = TableUtil.newTable(${table});

		for (var row : table ${rawTable}) {
			var field = "${row[0]}";
			var value1 = "${row[1]}";
			var value2 = "${row[2]}";

			if (${field} == "Account Field and Value") {
				if (${properties} == "") {
					var properties = "\"${value1}\":\"${value2}\"";
				}
				else {
					var properties = "${properties},\"${value1}\":\"${value2}\"";
				}
			}
			else if (${field} == "Code") {
				var code = ${value1};
			}
			else if (${field} == "Contact Email Address") {
				var contactEmailAddress = ${value1};
			}
			else if (${field} == "Data Region") {
				var dataRegion = ${value1};
			}
			else if (${field} == "Description") {
				var description = ${value1};
			}
			else if (${field} == "Fax Number") {
				var faxNumber = ${value1};
			}
			else if (${field} == "Internal") {
				var internal = ${value1};
			}
			else if (${field} == "Language") {
				var language = ${value1};
			}
			else if (${field} == "Name") {
				var name = ${value1};
			}
			else if (${field} == "Phone Number") {
				var phoneNumber = ${value1};
			}
			else if (${field} == "Profile Email Address") {
				var profileEmailAddress = ${value1};
			}
			else if (${field} == "Region") {
				var region = ${value1};
			}
			else if (${field} == "Status") {
				var status = ${value1};
			}
			else if (${field} == "Tier") {
				var tier = ${value1};
			}
			else if (${field} == "Website") {
				var website = ${value1};
			}
			else {
				fail("No such account field ${field}");
			}
		}

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey} --tlsv1.2
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
		''';

		if (!(isSet(code))) {
			var accountObject = JSONCurlUtil.get(${curl}, "$");

			if (contains(${accountObject}, "code=")) {
				var value1 = JSONCurlUtil.get(${curl}, "$.code");

				var code = ${value1};
			}
			else {
				var code = "";
			}
		}

		if (!(isSet(contactEmailAddress))) {
			var accountObject = JSONCurlUtil.get(${curl}, "$");

			if (contains(${accountObject}, "contactEmailAddress=")) {
				var value1 = JSONCurlUtil.get(${curl}, "$.contactEmailAddress");

