	macro _viewNoAccount {
		if (contains(${accountName}, " ")) {
			var keyword = StringUtil.replace(${accountName}, " ", "+");
		}
		else {
			var keyword = ${accountName};
		}

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/accounts?filter="name%20eq%20'${keyword}'" --tlsv1.2
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
		''';

		var allAccounts = JSONCurlUtil.get(${curl}, "$");

		if (contains(${allAccounts}, ${accountName})) {
			fail("The account with the name ${accountName} is visible to a non permissioned user");
		}

		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = ${accountName});

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey} --tlsv1.2
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
		''';

		var account = JSONCurlUtil.get(${curl}, "$");

		if (contains(${account}, ${accountName})) {
			fail("The account with the name ${accountName} is visible to a non permissioned user");
		}
	}

	macro _viewNoAccountAuditEntry {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = ${accountName});

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}/audit-entries --tlsv1.2
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
		''';

		var accountAuditEntries = JSONCurlUtil.get(${curl}, "$");

		if (contains(${accountAuditEntries}, ${fieldName}) || contains(${accountAuditEntries}, ${oldValue}) || contains(${accountAuditEntries}, ${newValue})) {
			fail("The account audit entry for a change to the account ${accountName} field ${fieldName} from the old value ${oldValue} to the new value ${newValue} is visible to a non permissioned user");
		}

		var auditEntryKey = KoroneikiAccountAPI._getAccountAuditEntryKey(
			accountName = ${accountName},
			fieldName = ${fieldName},
			newValue = ${newValue},
			oldValue = ${oldValue});

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/audit-entries/${auditEntryKey} --tlsv1.2
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
		''';

		var accountAuditEntry = JSONCurlUtil.get(${curl}, "$");

		if (contains(${accountAuditEntry}, ${fieldName}) || contains(${accountAuditEntry}, ${oldValue}) || contains(${accountAuditEntry}, ${newValue})) {
			fail("The account audit entry for a change to the account ${accountName} field ${fieldName} from the old value ${oldValue} to the new value ${newValue} is visible to a non permissioned user");
		}
	}

