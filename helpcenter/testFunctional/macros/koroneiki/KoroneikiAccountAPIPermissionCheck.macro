		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = ${parentAccountName});

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}/child-accounts --tlsv1.2
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
		''';

		var allChildAccounts = JSONCurlUtil.get(${curl}, "$");

		if (contains(${allChildAccounts}, ${childAccountName})) {
			fail("The account with the name ${childAccountName} in ${parentAccountName} is visible to a non permissioned user");
		}
	}

