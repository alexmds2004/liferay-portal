	macro _createAccountAttempt {
		var properties = "";
		var rawTable = TableUtil.newTable(${table});

		for (var row : table ${rawTable}) {
			var field = "${row[0]}";
			var value1 = "${row[1]}";
			var value2 = "${row[2]}";

			if (${field} == "Account Field and Value") {
				if (${properties} == "") {
					var properties = "\"${value1}\":\"${value2}\"";
				}
				else {
					var properties = "${properties},\"${value1}\":\"${value2}\"";
				}
			}
			else if (${field} == "Code") {
				var code = ${value1};
			}
			else if (${field} == "Contact Email Address") {
				var contactEmailAddress = ${value1};
			}
			else if (${field} == "Data Region") {
				var dataRegion = ${value1};
			}
			else if (${field} == "Description") {
				var description = ${value1};
			}
			else if (${field} == "Fax Number") {
				var faxNumber = ${value1};
			}
			else if (${field} == "Internal") {
				var internal = ${value1};
			}
			else if (${field} == "Language") {
				var language = ${value1};
			}
			else if (${field} == "Name") {
				var name = ${value1};
			}
			else if (${field} == "Phone Number") {
				var phoneNumber = ${value1};
			}
			else if (${field} == "Profile Email Address") {
				var profileEmailAddress = ${value1};
			}
			else if (${field} == "Region") {
				var region = ${value1};
			}
			else if (${field} == "Status") {
				var status = ${value1};
			}
			else if (${field} == "Tier") {
				var tier = ${value1};
			}
			else if (${field} == "Website") {
				var website = ${value1};
			}
			else {
				fail("No such account field ${field}");
			}
		}

		if (!(isSet(code))) {
			var code = "";
		}

		if (!(isSet(contactEmailAddress))) {
			var contactEmailAddress = "";
		}

		if (!(isSet(dataRegion))) {
			var dataRegion = "";
		}

		if (!(isSet(description))) {
			var description = "";
		}

		if (!(isSet(faxNumber))) {
			var faxNumber = "";
		}

		if (!(isSet(internal))) {
			var internal = "false";
		}

		if (!(isSet(language))) {
			var language = "";
		}

		if (!(isSet(name))) {
			var name = "";
		}

		if (!(isSet(phoneNumber))) {
			var phoneNumber = "";
		}

		if (!(isSet(profileEmailAddress))) {
			var profileEmailAddress = "";
		}

		if (!(isSet(region))) {
			var region = "";
		}

		if (!(isSet(status))) {
			var status = "";
		}

		if (!(isSet(tier))) {
			var tier = "";
		}

		if (!(isSet(website))) {
			var website = "";
		}

		if (${properties} == "") {
			var curl = '''
				${koroneikiURL}/o/koroneiki-rest/v1.0/accounts --tlsv1.2
					--header "API_Token: ${apiToken}"
					-H "accept: application/json"
					-H "Content-Type: application/json"
					-d
					{
						"code": "${code}",
						"contactEmailAddress": "${contactEmailAddress}",
						"dataRegion": "${dataRegion}",
						"description": "${description}",
						"faxNumber": "${faxNumber}",
						"internal": ${internal},
						"language": "${language}",
						"name": "${name}",
						"phoneNumber": "${phoneNumber}",
						"profileEmailAddress": "${profileEmailAddress}",
						"region": "${region}",
						"status": "${status}",
						"tier": "${tier}",
						"website": "${website}"
					}
			''';
		}
		else {
			var curl = '''
				${koroneikiURL}/o/koroneiki-rest/v1.0/accounts --tlsv1.2
					--header "API_Token: ${apiToken}"
					-H "accept: application/json"
					-H "Content-Type: application/json"
					-d
					{
						"code": "${code}",
						"contactEmailAddress": "${contactEmailAddress}",
						"dataRegion": "${dataRegion}",
						"description": "${description}",
						"faxNumber": "${faxNumber}",
						"internal": ${internal},
						"language": "${language}",
						"name": "${name}",
						"phoneNumber": "${phoneNumber}",
						"profileEmailAddress": "${profileEmailAddress}",
						"properties": {
							${properties}
						},
						"region": "${region}",
						"status": "${status}",
						"tier": "${tier}",
						"website": "${website}"
					}
			''';
		}

		com.liferay.poshi.runner.util.JSONCurlUtil.post(${curl});
	}

	macro _createAccountExternalLinkAttempt {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = ${accountName});
		var rawTable = TableUtil.newTable(${table});

		for (var row : table ${rawTable}) {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if (${field} == "Domain") {
				var domain = ${value};
			}
			else if (${field} == "Entity Id") {
				var entityId = ${value};
			}
			else if (${field} == "Entity Name") {
				var entityName = ${value};
			}
			else {
				fail("No such external link field ${field}");
			}
		}

		if (!(isSet(domain))) {
			var domain = "";
		}

		if (!(isSet(entityId))) {
			var entityId = "";
		}

		if (!(isSet(entityName))) {
			var entityName = "";
		}

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}/external-links --tlsv1.2
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				-d
				{
					"domain": "${domain}",
					"entityId": "${entityId}",
					"entityName": "${entityName}"
				}
		''';

		com.liferay.poshi.runner.util.JSONCurlUtil.post(${curl});
	}

