		if (!(isSet(addressType))) {
			var addressType = "";
		}

		if (!(isSet(mailing))) {
			var mailing = "false";
		}

		if (!(isSet(postalCode))) {
			var postalCode = "";
		}

		if (!(isSet(primary))) {
			var primary = "false";
		}

		if (!(isSet(streetAddressLine1))) {
