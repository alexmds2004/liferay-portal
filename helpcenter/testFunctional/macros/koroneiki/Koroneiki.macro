definition {

	var koroneikiURL = PropsUtil.get("koroneiki.liferay.url");

	macro clickEntityActionsLink {
		var key_entityName = ${entityName};

		Click(locator1 = "Koroneiki#ENTITY_ACTIONS_LINK");
	}

	macro clickNewEntityButton {
		Click(locator1 = "Koroneiki#NEW_ENTITY_BUTTON");

		var key_field = "";

		AssertVisible(locator1 = "KoroneikiEntityForm#INPUT_FIELD");
	}

	macro clickTab {
		var key_tabName = ${tabName};

		Click(locator1 = "Koroneiki#TAB");
	}

	macro gotoAccounts {
		if (IsElementNotPresent(locator1 = "Koroneiki#HOME_LINK")) {
			Open(locator1 = ${koroneikiURL});
		}

		ProductMenu.gotoPortlet(
			category = "Koroneiki",
			panel = "Control Panel",
			portlet = "Accounts");
	}

	macro gotoContacts {
		if (IsElementNotPresent(locator1 = "Koroneiki#HOME_LINK")) {
			Open(locator1 = ${koroneikiURL});
		}

		ProductMenu.gotoPortlet(
			category = "Koroneiki",
			panel = "Control Panel",
			portlet = "Contacts");
	}

	macro gotoProductPurchases {
		if (IsElementNotPresent(locator1 = "Koroneiki#HOME_LINK")) {
			Open(locator1 = ${koroneikiURL});
		}

		ProductMenu.gotoPortlet(
			category = "Koroneiki",
			panel = "Control Panel",
			portlet = "Products");

		Koroneiki.clickTab(tabName = "Purchases");
	}

	macro gotoProducts {
		if (IsElementNotPresent(locator1 = "Koroneiki#HOME_LINK")) {
			Open(locator1 = ${koroneikiURL});
		}

		ProductMenu.gotoPortlet(
			category = "Koroneiki",
			panel = "Control Panel",
			portlet = "Products");
	}

	macro gotoTeams {
		if (IsElementNotPresent(locator1 = "Koroneiki#HOME_LINK")) {
			Open(locator1 = ${koroneikiURL});
		}

		ProductMenu.gotoPortlet(
			category = "Koroneiki",
			panel = "Control Panel",
			portlet = "Teams");
	}

	macro search {
		Type(
			locator1 = "Koroneiki#SEARCH_FIELD",
			value1 = ${keyword});

		KeyPress(
			locator1 = "Koroneiki#SEARCH_FIELD",
			value1 = "\RETURN");
	}

	macro tearDownAccounts {
		var rawTable = TableUtil.newTable(${table});

		for (var row : table ${rawTable}) {
			var entityName = "${row[0]}";

			Koroneiki.search(keyword = ${entityName});

			var key_entityName = ${entityName};

			if (IsElementPresent(locator1 = "Koroneiki#ENTITY_ROW")) {
				Click(locator1 = "Koroneiki#ENTITY_ACTIONS_LINK");

				var key_action = "Delete";

				ClickNoError(locator1 = "Koroneiki#MENULIST_ACTION");

				Confirm(value1 = "Are you sure you want to delete this account?");

				Message.success();
			}
		}
	}

	macro tearDownContacts {
		var rawTable = TableUtil.newTable(${table});

		for (var row : table ${rawTable}) {
			var entityName = "${row[0]}";

			Koroneiki.search(keyword = ${entityName});

