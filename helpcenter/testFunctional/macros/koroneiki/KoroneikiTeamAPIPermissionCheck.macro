	macro _createTeamExternalLinkAttempt {
		var teamKey = KoroneikiTeamAPI._getTeamKeyViaTeamName(teamName = ${teamName});
		var rawTable = TableUtil.newTable(${table});

		for (var row : table ${rawTable}) {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if (${field} == "Domain") {
				var domain = ${value};
			}
			else if (${field} == "Entity Id") {
				var entityId = ${value};
			}
			else if (${field} == "Entity Name") {
				var entityName = ${value};
			}
			else {
				fail("No such external link field ${field}");
			}
		}

		if (!(isSet(domain))) {
			var domain = "";
		}

		if (!(isSet(entityId))) {
			var entityId = "";
		}

		if (!(isSet(entityName))) {
			var entityName = "";
		}

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/teams/${teamKey}/external-links --tlsv1.2
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				-d
				{
					"domain": "${domain}",
					"entityId": "${entityId}",
					"entityName": "${entityName}"
				}
		''';

		com.liferay.poshi.runner.util.JSONCurlUtil.post(${curl});
	}

	macro _deleteTeam {
