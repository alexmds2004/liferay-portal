	macro _viewContact {
		var teamKey = KoroneikiTeamAPI._getTeamKeyViaTeamName(teamName = ${teamName});

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/teams/${teamKey}/contacts --tlsv1.2
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
		''';

		var contactEmailAddressFromAPI = JSONCurlUtil.get(${curl}, "$.items[?(@.emailAddress=='${contactEmailAddress}')].emailAddress");

		var contactEmailAddressFromAPI = StringUtil.replace(${contactEmailAddressFromAPI}, "[", "");

		var contactEmailAddressFromAPI = StringUtil.replace(${contactEmailAddressFromAPI}, "]", "");

		var contactEmailAddressFromAPI = StringUtil.replace(${contactEmailAddressFromAPI}, "\"", "");

		echo("Expected contact email address value: ${contactEmailAddress}");

		echo("Actual contact email address value: ${contactEmailAddressFromAPI}");

		if (${contactEmailAddressFromAPI} != ${contactEmailAddress}) {
			fail("Actual contact email address value ${contactEmailAddressFromAPI} does not match expected contact email address value ${contactEmailAddress}");
		}
	}

	macro _viewContactRole {
		var teamKey = KoroneikiTeamAPI._getTeamKeyViaTeamName(teamName = ${teamName});
		var contactUuid = KoroneikiContactAPI._getContactUuidViaContactEmailAddress(contactEmailAddress = ${contactEmailAddress});

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/teams/${teamKey}/contacts/by-uuid/${contactUuid}/roles --tlsv1.2
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
		''';

		var contactRoleNameFromAPI = JSONCurlUtil.get(${curl}, "$.items[?(@.name=='${contactRoleName}')].name");

		var contactRoleNameFromAPI = StringUtil.replace(${contactRoleNameFromAPI}, "[", "");

		var contactRoleNameFromAPI = StringUtil.replace(${contactRoleNameFromAPI}, "]", "");

		var contactRoleNameFromAPI = StringUtil.replace(${contactRoleNameFromAPI}, "\"", "");

		echo("Expected contact role name value: ${contactRoleName}");

		echo("Actual contact role name value: ${contactRoleNameFromAPI}");

		if (${contactRoleNameFromAPI} != ${contactRoleName}) {
			fail("Actual contact role name value ${contactRoleNameFromAPI} does not match expected contact role name value ${contactRoleName}");
		}
	}

	macro _viewNoContact {
		var teamKey = KoroneikiTeamAPI._getTeamKeyViaTeamName(teamName = ${teamName});

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/teams/${teamKey}/contacts --tlsv1.2
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
		''';

		var allAccountContacts = JSONCurlUtil.get(${curl}, "$");

		if (contains(${allAccountContacts}, ${contactEmailAddress})) {
			fail("The account with the name ${accountName} contact ${contactEmailAddress} is visible to a non permissioned user");
		}
	}

	macro _viewNoContactRole {
		var teamKey = KoroneikiTeamAPI._getTeamKeyViaTeamName(teamName = ${teamName});
		var contactUuid = KoroneikiContactAPI._getContactUuidViaContactEmailAddress(contactEmailAddress = ${contactEmailAddress});

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/teams/${teamKey}/contacts/by-uuid/${contactUuid}/roles --tlsv1.2
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
		''';

		var allAccountContactContactRoles = JSONCurlUtil.get(${curl}, "$");

		if (contains(${allAccountContactContactRoles}, ${contactRoleName})) {
			fail("The contact with the email address ${contactEmailAddress} on the account with the name ${accountName} has their contact role ${contactRoleName} visible to a non permissioned user");
		}
	}

	macro _viewNoTeam {
		if (contains(${teamName}, " ")) {
			var keyword = StringUtil.replace(${teamName}, " ", "+");
		}
		else {
			var keyword = ${teamName};
		}

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/teams?filter="name%20eq%20'${keyword}'" --tlsv1.2
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
		''';

		var allTeams = JSONCurlUtil.get(${curl}, "$");

		if (contains(${allTeams}, ${teamName})) {
			fail("The team with the name ${teamName} is visible to a non permissioned user");
		}

		var teamKey = KoroneikiTeamAPI._getTeamKeyViaTeamName(teamName = ${teamName});

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/teams/${teamKey} --tlsv1.2
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
		''';

		var team = JSONCurlUtil.get(${curl}, "$");

		if (contains(${team}, ${teamName})) {
			fail("The team with the name ${teamName} is visible to a non permissioned user");
		}
	}

	macro _viewNoTeamAssignedAccount {
		var teamKey = KoroneikiTeamAPI._getTeamKeyViaTeamName(teamName = ${teamName});

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/teams/${teamKey}/assigned-accounts --tlsv1.2
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
		''';

		var allTeamAccounts = JSONCurlUtil.get(${curl}, "$");

		if (contains(${allTeamAccounts}, ${accountName})) {
			fail("The assigned account with the name ${accountName} for the team ${teamName} is visible to a non permissioned user");
		}
	}

	macro _viewNoTeamAuditEntry {
		var teamKey = KoroneikiTeamAPI._getTeamKeyViaTeamName(teamName = ${teamName});

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/teams/${teamKey}/audit-entries --tlsv1.2
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
		''';

		var teamAuditEntries = JSONCurlUtil.get(${curl}, "$");

		if (contains(${teamAuditEntries}, ${fieldName}) || contains(${teamAuditEntries}, ${oldValue}) || contains(${teamAuditEntries}, ${newValue})) {
			fail("The team audit entry for a change to the team ${teamName} field ${fieldName} from the old value ${oldValue} to the new value ${newValue} is visible to a non permissioned user");
		}

		var auditEntryKey = KoroneikiTeamAPI._getTeamAuditEntryKey(
			fieldName = ${fieldName},
			newValue = ${newValue},
			oldValue = ${oldValue},
			teamName = ${teamName});

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/audit-entries/${auditEntryKey} --tlsv1.2
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
		''';

		var teamAuditEntry = JSONCurlUtil.get(${curl}, "$");

		if (contains(${teamAuditEntry}, ${fieldName}) || contains(${teamAuditEntry}, ${oldValue}) || contains(${teamAuditEntry}, ${newValue})) {
			fail("The team audit entry for a change to the team ${teamName} field ${fieldName} from the old value ${oldValue} to the new value ${newValue} is visible to a non permissioned user");
		}
	}

	macro _viewNoTeamExternalLink {
		var teamKey = KoroneikiTeamAPI._getTeamKeyViaTeamName(teamName = ${teamName});

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/teams/${teamKey}/external-links --tlsv1.2
