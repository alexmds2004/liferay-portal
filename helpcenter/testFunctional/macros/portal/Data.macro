definition {

	macro _createAccountOrProjectCode {
		if (isSet(accountName)) {
			var accountCode = StringUtil.substring("${accountName}", "0", "6");
		}
		else {
			var accountCode = "";
		}

		if (isSet(projectName)) {
			var projectCode = StringUtil.substring("${projectName}", "0", "6");
		}
		else {
			var projectCode = "";
		}

		var code = "${accountCode}${projectCode}";

		var code = StringUtil.upperCase("${code}");

		return "${code}";
	}

	macro generateCharacterString {
		var stringLengthDoubled = MathUtil.product("${stringLength}", "2");

		var string = StringUtil.randomString("${stringLengthDoubled}");

		var characterString = StringUtil.extractChars("${string}");

		var characterString = StringUtil.substring("${characterString}", "0", "${stringLength}");

		return "${characterString}";
	}

	@prose = "I generate several static variables for Support"
	macro generateSupportStaticVariables {
		var firstName = Data.generateCharacterString(stringLength = "3");
		var lastName = Data.generateCharacterString(stringLength = "10");

		var firstName = StringUtil.lowerCase("${firstName}");
		var lastName = StringUtil.lowerCase("${lastName}");

		var accountName = Data.generateCharacterString(stringLength = "16");
		var projectName = Data.generateCharacterString(stringLength = "16");

		static var staticProjectName = "${projectName}";
		static var staticAccountName = "${accountName}";

		static var staticScreenName = "${firstName}.${lastName}";

		static var staticEmail = "${staticScreenName}@company.com.broken";


		var projectCode = Data._createAccountOrProjectCode(
			accountName = "${accountName}",
			projectName = "${projectName}");

		static var staticProjectCode = "${projectCode}";

		var accountCode = Data._createAccountOrProjectCode(accountName = "${accountName}");

		static var staticAccountCode = "${accountCode}";

		static var staticContactFirstName = StringUtil.upperCase("${firstName}");
		static var staticContactLastName = StringUtil.upperCaseFirstLetter("${lastName}");

		static var staticDossieraAccountKey = StringUtil.randomString("18");
		static var staticDossieraAddressKey1 = MathUtil.randomNumber("30000000");
		static var staticDossieraAddressKey2 = MathUtil.randomNumber("30000000");
		static var staticDossieraContactKey = MathUtil.randomNumber("30000000");
		static var staticDossieraProjectKey = MathUtil.randomNumber("30000000");

		static var staticEndDay = DateUtil.getDate("335");
		static var staticEndMonth = DateUtil.getMonth("335");
		static var staticEndMonthName = DateUtil.getMonthName("335");
		static var staticEndYear = DateUtil.getYear("335");

		static var staticSalesforceOpportunityKey = StringUtil.randomString("18");
		static var staticSalesforceOpportunityLineItemKey1 = StringUtil.randomString("18");
		static var staticSalesforceOpportunityLineItemKey2 = StringUtil.randomString("18");
		static var staticSalesforceOwnerUserKey = StringUtil.randomString("18");
		static var staticSalesforceProjectKey = StringUtil.randomString("18");

		static var staticStartDay = DateUtil.getDate("0");
		static var staticStartMonth = DateUtil.getMonth("0");
		static var staticStartMonthName = DateUtil.getMonthName("0");
		static var staticStartYear = DateUtil.getYear("0");

		echo("Email: ${staticEmail}");

		echo("Screen Name: ${staticScreenName}");

		echo("Account Name: ${staticAccountName}");

		echo("Project Name: ${staticProjectName}");

		echo("Contact First Name: ${staticContactFirstName}");

		echo("Contact Last Name: ${staticContactLastName}");

		echo("Dossiera Account Key: ${staticDossieraAccountKey}");

		echo("Dossiera Address Key 1: ${staticDossieraAddressKey1}");

		echo("Dossiera Address Key 2: ${staticDossieraAddressKey2}");

		echo("Dossiera Contact Key: ${staticDossieraContactKey}");

		echo("Dossiera Project Key: ${staticDossieraProjectKey}");

		echo("Salesforce Opportunity Key: ${staticSalesforceOpportunityKey}");

		echo("Salesforce Opportunity Line Item Key: ${staticSalesforceOpportunityLineItemKey1}");

		echo("Salesforce Opportunity Line Item Key: ${staticSalesforceOpportunityLineItemKey2}");

		echo("Salesforce Owner User Key: ${staticSalesforceOwnerUserKey}");

		echo("Salesforce Project Key: ${staticSalesforceProjectKey}");

		echo("Start Day: ${staticStartDay}");

		echo("Start Month: ${staticStartMonth}");

		echo("Start Month Name: ${staticStartMonthName}");

		echo("Start Year: ${staticStartYear}");

		echo("End Day: ${staticEndDay}");

		echo("End Month: ${staticEndMonth}");

		echo("End Month Name: ${staticEndMonthName}");

		echo("End Year: ${staticEndYear}");

		echo("Project Code: ${staticProjectCode}");

		echo("Account Code: ${staticAccountCode}");

		return "${staticEmail}";

		return "${staticScreenName}";

		return "${staticAccountName}";

		return "${staticProjectName}";

		return "${staticContactFirstName}";

		return "${staticContactLastName}";

		return "${staticDossieraAccountKey}";

		return "${staticDossieraAddressKey1}";

		return "${staticDossieraAddressKey2}";

		return "${staticDossieraContactKey}";

		return "${staticDossieraProjectKey}";

		return "${staticSalesforceOpportunityKey}";

		return "${staticSalesforceOpportunityLineItemKey1}";

		return "${staticSalesforceOpportunityLineItemKey2}";

		return "${staticSalesforceOwnerUserKey}";

		return "${staticSalesforceProjectKey}";

		return "${staticStartDay}";

		return "${staticStartMonth}";

		return "${staticStartMonthName}";

		return "${staticStartYear}";

		return "${staticEndDay}";

		return "${staticEndMonth}";

		return "${staticEndMonthName}";

		return "${staticEndYear}";

		return "${staticProjectCode}";

		return "${staticAccountCode}";
	}

}