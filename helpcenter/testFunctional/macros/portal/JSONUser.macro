				-d userIds=${supportUserId}
		''';

		com.liferay.poshi.runner.util.JSONCurlUtil.post(${curl});
	}

	macro createViaKoroneiki {
		var rawTable = TableUtil.newTable(${table});

		for (var row : table ${rawTable}) {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if (${field} == "Screen Name") {
				var userScreenName = ${value};
			}
			else if (${field} == "Email Address") {
				var userEmailAddress = ${value};
			}
			else if (${field} == "First Name") {
				var userFirstName = ${value};
			}
			else if (${field} == "Last Name") {
				var userLastName = ${value};
			}
			else {
				fail("No such user field ${field}");
			}
		}

		var companyId = JSONCompany.getKoroneikiCompanyId();
		var openId = StringUtil.randomString(5);

		var curl = '''
			${koroneikiURL}/api/jsonws/user/add-user
				-u ${koroneikiAdminEmailAddress}:${koroneikiAdminPassword}
				-d companyId=${companyId}
				-d autoPassword=false
				-d password1=osbadminqauser
				-d password2=osbadminqauser
				-d autoScreenName=false
				-d screenName=${userScreenName}
				-d emailAddress=${userEmailAddress}
				-d facebookId=0
				-d openId=${openId}
				-d locale=
				-d firstName=${userFirstName}
				-d middleName=
				-d lastName=${userLastName}
				-d prefixId=0
				-d suffixId=0
				-d male=true
				-d birthdayMonth=4
				-d birthdayDay=31
				-d birthdayYear=1986
				-d jobTitle=
				-d groupIds=
				-d organizationIds=
				-d roleIds=
				-d userGroupIds=
				-d sendEmail=true
		''';

		static var koroneikiUserId = JSONCurlUtil.post(${curl}, "$.userId");

		echo("Koroneiki User ID: ${koroneikiUserId}");

		if (!(isSet(staticKoroneikiUserIdList))) {
			static var staticKoroneikiUserIdList = ${koroneikiUserId};
		}
		else {
			static var staticKoroneikiUserIdList = "${staticKoroneikiUserIdList},${koroneikiUserId}";
		}

		echo("Koroneiki User ID List: ${staticKoroneikiUserIdList}");

		return ${staticKoroneikiUserIdList};
	}

