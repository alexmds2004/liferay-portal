	macro tearDownUsersViaSupportOrganization {
		var organizationSearchResults = JSONOrganization.searchOrganization(organizationName = ${organizationName});

		if (contains(${organizationSearchResults}, ${organizationName})) {
			var rawTable = TableUtil.newTable(${table});

			for (var row : table ${rawTable}) {
				var userEmailAddress = "${row[0]}";
				var organizationId = JSONOrganization.getSupportOrganizationId(organizationName = ${organizationName});

				echo("Support Organization ID: ${organizationId}");

				var curl = '''
					${supportURL}/api/jsonws/user/get-organization-users
						-u ${supportAdminEmailAddress}:${supportAdminPassword}
						-d organizationId=${organizationId}
				''';

				var organizationMembers = JSONCurlUtil.post(${curl});

				if (contains(${organizationMembers}, ${userEmailAddress})) {
					var companyId = JSONCompany.getSupportCompanyId();

					var curl = '''
						${supportURL}/api/jsonws/user/get-user-by-email-address
							-u ${supportAdminEmailAddress}:${supportAdminPassword}
							-d companyId=${companyId}
							-d emailAddress=${userEmailAddress}
					''';

					var supportUserId = JSONCurlUtil.post(${curl}, "$.userId");

					echo("Support User ID: ${supportUserId}");

					var curl = '''
						${supportURL}/api/jsonws/user/update-status
							-u ${supportAdminEmailAddress}:${supportAdminPassword}
							-d userId=${supportUserId}
							-d status=5
					''';

					com.liferay.poshi.runner.util.JSONCurlUtil.post(${curl});

					var curl = '''
						${supportURL}/api/jsonws/user/delete-user
							-u ${supportAdminEmailAddress}:${supportAdminPassword}
							-d userId=${supportUserId}
					''';

					com.liferay.poshi.runner.util.JSONCurlUtil.post(${curl});
				}
			}
		}
	}

	macro unsetUserFromSupportOrganization {
		var organizationId = JSONOrganization.getSupportOrganizationId(organizationName = ${organizationName});
		var companyId = JSONCompany.getSupportCompanyId();

		var curl = '''
			${supportURL}/api/jsonws/user/get-user-by-email-address
				-u ${supportAdminEmailAddress}:${supportAdminPassword}
				-d companyId=${companyId}
				-d emailAddress=${userEmailAddress}
		''';

		var supportUserId = JSONCurlUtil.post(${curl}, "$.userId");

		echo("Support User ID: ${supportUserId}");

		var curl = '''
			${supportURL}/api/jsonws/user/unset-organization-users
				-u ${supportAdminEmailAddress}:${supportAdminPassword}
				-d userIds=${supportUserId}
				-d organizationId=${organizationId}
		''';

		com.liferay.poshi.runner.util.JSONCurlUtil.post(${curl});
	}

	macro updateProvisioningPassword {
		var curl = '''
			${provisioningURL}/api/jsonws/user/get-user-by-email-address
				-u ${provisioningAdminEmailAddress}:${provisioningAdminPassword}
				-d companyId=${companyId}
				-d emailAddress=${userEmailAddress}
		''';

		var provisioningUserId = JSONCurlUtil.post(${curl}, "$.userId");

		echo("Provisioning User ID: ${provisioningUserId}");

		OSBAdmin.logoutAndLoginToProvisioning(
			userEmailAddress = ${provisioningAdminEmailAddress},
			userPassword = ${provisioningAdminPassword});

		Open(locator1 = "https://webserver-lrprovisioning-uat.lfr.cloud/group/control_panel/manage?p_p_id=com_liferay_users_admin_web_portlet_UsersAdminPortlet&p_p_lifecycle=0&p_p_state=maximized&p_p_mode=view&_com_liferay_users_admin_web_portlet_UsersAdminPortlet_mvcRenderCommandName=%2Fusers_admin%2Fedit_user&_com_liferay_users_admin_web_portlet_UsersAdminPortlet_p_u_i_d=${provisioningUserId}&_com_liferay_users_admin_web_portlet_UsersAdminPortlet_screenNavigationCategoryKey=general&_com_liferay_users_admin_web_portlet_UsersAdminPortlet_screenNavigationEntryKey=password");

		Type(
			locator1 = "UserAccount#NEW_PASSWORD_FIELD",
			value1 = ${userPassword});

		Type(
			locator1 = "UserAccount#ENTER_AGAIN_FIELD",
			value1 = ${userPassword});

		Button.save();

		Message.success();

		OSBAdmin.logoutOfProvisioning();
	}

	macro updateSupportPassword {
		var companyId = JSONCompany.getSupportCompanyId();

		var curl = '''
			${supportURL}/api/jsonws/user/get-user-by-email-address
				-u ${supportAdminEmailAddress}:${supportAdminPassword}
				-d companyId=${companyId}
				-d emailAddress=${userEmailAddress}
		''';

		var supportUserId = JSONCurlUtil.post(${curl}, "$.userId");

		echo("Support User ID: ${supportUserId}");

		var curl = '''
			${supportURL}/api/jsonws/user/update-password
				-u ${supportAdminEmailAddress}:${supportAdminPassword}
				-d userId=${supportUserId}
				-d password1=${userPassword}
				-d password2=${userPassword}
				-d passwordReset=false
		''';

		var response = JSONCurlUtil.post(${curl});
		var currentIteration = 0;

		while ((${currentIteration} != ${pollMaximumIterations}) && contains(${response}, "must not be changed until")) {
			ZendeskHomepage.pause(timeInSeconds = ${pollIntervalInSeconds});

			var currentIteration = ${currentIteration} + 1;
			var response = JSONCurlUtil.post(${curl});
		}
	}

	macro viewNoSupportUserOrganizationSync {
		var companyId = JSONCompany.getSupportCompanyId();

		var curl = '''
			${supportURL}/api/jsonws/user/get-user-by-email-address
				-u ${supportAdminEmailAddress}:${supportAdminPassword}
				-d companyId=${companyId}
				-d emailAddress=${userEmailAddress}
		''';

		var supportUserId = JSONCurlUtil.post(${curl}, "$.userId");

		echo("Support User ID: ${supportUserId}");

		var curl = '''
			${supportURL}/api/jsonws/organization/get-user-organizations
				-u ${supportAdminEmailAddress}:${supportAdminPassword}
				-d userId=${supportUserId}
		''';

		var userOrganizations = JSONCurlUtil.post(${curl});
		var currentIteration = 0;

		while ((${currentIteration} != ${pollMaximumIterations}) && contains(${userOrganizations}, ${organizationName})) {
			var currentIteration = ${currentIteration} + 1;

			ZendeskHomepage.pause(timeInSeconds = ${pollIntervalInSeconds});

			var companyId = JSONCompany.getSupportCompanyId();

			var curl = '''
				${supportURL}/api/jsonws/user/get-user-by-email-address
					-u ${supportAdminEmailAddress}:${supportAdminPassword}
					-d companyId=${companyId}
					-d emailAddress=${userEmailAddress}
			''';

			var supportUserId = JSONCurlUtil.post(${curl}, "$.userId");

			echo("Support User ID: ${supportUserId}");

			var curl = '''
				${supportURL}/api/jsonws/organization/get-user-organizations
					-u ${supportAdminEmailAddress}:${supportAdminPassword}
					-d userId=${supportUserId}
			''';

			var userOrganizations = JSONCurlUtil.post(${curl});
		}

		if (contains(${userOrganizations}, ${organizationName})) {
			fail("After ${currentIteration} checks, the user with the email address ${userEmailAddress} appears to be in the support organization ${organizationName}");
		}
	}

	macro viewSupportUserOrganizationSync {
		var companyId = JSONCompany.getSupportCompanyId();

		var curl = '''
			${supportURL}/api/jsonws/user/get-user-by-email-address
				-u ${supportAdminEmailAddress}:${supportAdminPassword}
				-d companyId=${companyId}
				-d emailAddress=${userEmailAddress}
		''';

		var supportUserId = JSONCurlUtil.post(${curl}, "$.userId");

		echo("Support User ID: ${supportUserId}");

		var curl = '''
			${supportURL}/api/jsonws/organization/get-user-organizations
				-u ${supportAdminEmailAddress}:${supportAdminPassword}
				-d userId=${supportUserId}
		''';

		var userOrganizations = JSONCurlUtil.post(${curl});
		var currentIteration = 0;

		while ((${currentIteration} != ${pollMaximumIterations}) && !(contains(${userOrganizations}, ${organizationName}))) {
			var currentIteration = ${currentIteration} + 1;

			ZendeskHomepage.pause(timeInSeconds = ${pollIntervalInSeconds});

			var companyId = JSONCompany.getSupportCompanyId();

			var curl = '''
				${supportURL}/api/jsonws/user/get-user-by-email-address
					-u ${supportAdminEmailAddress}:${supportAdminPassword}
					-d companyId=${companyId}
					-d emailAddress=${userEmailAddress}
			''';

			var supportUserId = JSONCurlUtil.post(${curl}, "$.userId");

			echo("Support User ID: ${supportUserId}");

			var curl = '''
				${supportURL}/api/jsonws/organization/get-user-organizations
					-u ${supportAdminEmailAddress}:${supportAdminPassword}
					-d userId=${supportUserId}
			''';

			var userOrganizations = JSONCurlUtil.post(${curl});
		}

		if (!(contains(${userOrganizations}, ${organizationName}))) {
			fail("After ${currentIteration} checks, the user with the email address ${userEmailAddress} appears to have not been added to the support organization ${organizationName}");
		}
	}

	macro viewSupportUserSync {
		var companyId = JSONCompany.getSupportCompanyId();

		var curl = '''
			${supportURL}/api/jsonws/user/get-user-by-email-address
				-u ${supportAdminEmailAddress}:${supportAdminPassword}
				-d companyId=${companyId}
				-d emailAddress=${userEmailAddress}
		''';

		var userObject = JSONCurlUtil.post(${curl});
		var currentIteration = 0;

		while ((${currentIteration} != ${pollMaximumIterations}) && contains(${userObject}, "NoSuchUserException")) {
			var currentIteration = ${currentIteration} + 1;

			ZendeskHomepage.pause(timeInSeconds = ${pollIntervalInSeconds});

			var userObject = JSONCurlUtil.post(${curl});
		}

		if (contains(${userObject}, "NoSuchUserException")) {
			fail("After ${currentIteration} checks, the support user appears to have not been added to the support site");
		}
	}

}