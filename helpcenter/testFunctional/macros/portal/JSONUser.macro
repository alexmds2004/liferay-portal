definition {

	var koroneikiAdminEmailAddress = PropsUtil.get("koroneiki.admin.email.address");
	var koroneikiAdminPassword = PropsUtil.get("koroneiki.admin.password");
	var koroneikiURL = PropsUtil.get("koroneiki.liferay.url");
	var provisioningAdminEmailAddress = PropsUtil.get("provisioning.admin.email.address");
	var provisioningAdminPassword = PropsUtil.get("provisioning.admin.password");
	var provisioningURL = PropsUtil.get("provisioning.liferay.url");
	var pollIntervalInSeconds = PropsUtil.get("osb.to.zendesk.sync.poll.interval.in.seconds");
	var pollMaximumIterations = PropsUtil.get("osb.to.zendesk.sync.poll.maximum.iterations");
	var supportAdminEmailAddress = PropsUtil.get("support.admin.email.address");
	var supportAdminPassword = PropsUtil.get("support.admin.password");
	var supportURL = PropsUtil.get("support.liferay.url");
	var webAdminEmailAddress = PropsUtil.get("web.admin.email.address");
	var webAdminPassword = PropsUtil.get("web.admin.password");
	var webURL = PropsUtil.get("web.liferay.url");

	macro assignUserToProvisioningRole {
		var roleId = JSONRole.getProvisioningRoleIdByName(roleName = ${roleName});
		var companyId = JSONCompany.getProvisioningCompanyId();

		var curl = '''
			${provisioningURL}/api/jsonws/user/get-user-by-email-address
				-u ${provisioningAdminEmailAddress}:${provisioningAdminPassword}
				-d companyId=${companyId}
				-d emailAddress=${userEmailAddress}
		''';

		var provisioningUserId = JSONCurlUtil.post(${curl}, "$.userId");

		echo("Provisioning User ID: ${provisioningUserId}");

		var curl = '''
			${provisioningURL}/api/jsonws/user/add-role-users
				-u ${provisioningAdminEmailAddress}:${provisioningAdminPassword}
				-d roleId=${roleId}
				-d userIds=${provisioningUserId}
		''';

		com.liferay.poshi.runner.util.JSONCurlUtil.post(${curl});
	}

	macro assignUserToSupportGroup {
		var groupId = JSONGroup.getSupportGroupId(groupName = ${groupName});
		var companyId = JSONCompany.getSupportCompanyId();

		var curl = '''
			${supportURL}/api/jsonws/user/get-user-by-email-address
				-u ${supportAdminEmailAddress}:${supportAdminPassword}
				-d companyId=${companyId}
				-d emailAddress=${userEmailAddress}
		''';

		var supportUserId = JSONCurlUtil.post(${curl}, "$.userId");

		echo("Support User ID: ${supportUserId}");

		var curl = '''
			${supportURL}/api/jsonws/user/add-group-users
				-u ${supportAdminEmailAddress}:${supportAdminPassword}
				-d groupId=${groupId}
				-d userIds=${supportUserId}
		''';

		com.liferay.poshi.runner.util.JSONCurlUtil.post(${curl});
	}

	macro assignUserToSupportOrganization {
		var organizationId = JSONOrganization.getSupportOrganizationId(organizationName = ${organizationName});
		var companyId = JSONCompany.getSupportCompanyId();

		var curl = '''
