definition {

	var popupTitle = PropsUtil.get("osb.admin.popup.title");
	var supportURL = PropsUtil.get("support.liferay.url");

	macro resyncEntitlements {
		OSBAdmin.gotoOSBAdminEntitlements();

		var key_entitlementName = ${entitlementName};

		ClickNoError(locator1 = "OSBAdminEntitlement#RESYNC_BUTTON");

		Confirm(value1 = "Are you sure you want to resync?");

		Message.success();
	}

}