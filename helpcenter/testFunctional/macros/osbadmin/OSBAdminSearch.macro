definition {

	var popupTitle = PropsUtil.get("osb.admin.popup.title");
	var supportURL = PropsUtil.get("support.liferay.url");

	macro searchAdvancedAccountViaKoroneikiAccountKey {
		OSBAdmin.gotoOSBAdmin();

		Click(locator1 = "OSBAdmin#ACCOUNTS_TAB");

		OSBAdminSearch.toggleSearch(searchType = "Advanced");

		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = ${accountName});

		Type(
			locator1 = "OSBAdmin#ADVANCED_SEARCH_KORONEIKI_ACCOUNT_KEY_FIELD",
			value1 = ${accountKey});

		KeyPress(
			locator1 = "OSBAdmin#ADVANCED_SEARCH_KORONEIKI_ACCOUNT_KEY_FIELD",
			value1 = "\RETURN");
	}

	macro searchBasic {
		OSBAdminSearch.toggleSearch(searchType = "Basic");

		Type(
			locator1 = "OSBAdmin#BASIC_SEARCH_KEYWORD_FIELD",
			value1 = ${keyword});

		if (IsVisible(locator1 = "Button#SEARCH_BUTTON")) {
			Button.search();
		}
		else {
			KeyPress(
				locator1 = "OSBAdmin#BASIC_SEARCH_KEYWORD_FIELD",
				value1 = "\RETURN");
		}
	}

	macro searchBasicProject {
		OSBAdmin.gotoOSBAdmin();

		Click(locator1 = "OSBAdmin#ACCOUNTS_TAB");

		OSBAdminSearch.searchBasic(keyword = ${projectCode});
	}

	macro searchBasicProjectViaName {
		OSBAdmin.gotoOSBAdmin();

		AssertClick(
			locator1 = "OSBAdmin#ACCOUNTS_TAB",
			value1 = "Accounts");

		var keyword = "\"${projectName}\"";

		OSBAdminSearch.searchBasic(keyword = ${keyword});
	}

	macro tearDownSearchResultRow {
		var key_code = ${code};

		while (IsElementPresent(locator1 = "OSBAdmin#SEARCH_RESULT_ACTION_BUTTON")) {
			Click(locator1 = "OSBAdmin#SEARCH_RESULT_ACTION_BUTTON");

			ClickNoError(locator1 = "OSBAdmin#SEARCH_RESULT_ACTION_MENU_DELETE");

			Confirm(value1 = "Are you sure you want to delete this? It will be deleted immediately.");

			Message.success();

			OSBAdmin.pause(timeInSeconds = 5);
		}
	}

	macro toggleSearch {
		OSBAdmin.pause(timeInSeconds = 5);

		if (${searchType} == "Basic") {
			if (IsElementPresent(locator1 = "OSBAdmin#ADVANCED_SEARCH_EXPANDED")) {
				Click(locator1 = "OSBAdmin#SEARCH_TOGGLE_CARET");
			}
		}
		else {
			if (IsElementNotPresent(locator1 = "OSBAdmin#ADVANCED_SEARCH_EXPANDED")) {
				Click(locator1 = "OSBAdmin#SEARCH_TOGGLE_CARET");
			}
		}
	}

}