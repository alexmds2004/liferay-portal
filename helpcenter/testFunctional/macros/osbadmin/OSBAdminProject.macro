	macro unlinkProject {
		var script = '''
			import com.liferay.portal.kernel.cache.CacheRegistryUtil;
			import com.liferay.portal.kernel.dao.db.DB;
			import com.liferay.portal.kernel.dao.db.DBManagerUtil;

			long accounEntryId = ${accountEntryId};

			DB db = DBManagerUtil.getDB();

			db.runSQL("delete from OSB_ExternalIdMapper where classPK = " + accounEntryId);

			CacheRegistryUtil.clear();
			''';

		Open(locator1 = "${supportURL}/group/control_panel/manage?p_p_id=com_liferay_server_admin_web_portlet_ServerAdminPortlet&p_p_lifecycle=0&p_p_state=maximized&p_p_mode=view&_com_liferay_server_admin_web_portlet_ServerAdminPortlet_mvcRenderCommandName=%2Fserver_admin%2Fview&_com_liferay_server_admin_web_portlet_ServerAdminPortlet_tabs1=script&_com_liferay_server_admin_web_portlet_ServerAdminPortlet_tabs2=");

		OSBAdmin.pause(timeInSeconds = 3);

		if (IsElementPresent(locator1 = "ProductMenu#PRODUCT_MENU_OPENED")) {
			Click(locator1 = "ProductMenu#TOGGLE");
		}

		Select(
			locator1 = "ServerAdministrationScript#LANGUAGE_SELECT",
			value1 = "Groovy");

		Type(
			locator1 = "ServerAdministrationScript#SCRIPT_FIELD",
			value1 = ${script});

		Click(locator1 = "ServerAdministrationScript#EXECUTE_BUTTON");

		Message.success();
	}

	macro view {
		OSBAdminProject.gotoProjectViaName(projectName = ${projectName});

		var rawTable = TableUtil.newTable(${table});

		for (var row : table ${rawTable}) {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if (${field} == "Status") {
				AssertTextEquals.assertPartialText(
					locator1 = "OSBAdminProjectAdd#STATUS_FIELD",
					value1 = ${value});
			}
			else if (${field} == "Koroneiki Account Key") {
				if (${value} == "Obtain from project name") {
					var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = ${projectName});

					AssertValue(
						locator1 = "OSBAdminProjectAdd#KORONEIKI_ACCOUNT_KEY_FIELD",
						value1 = ${accountKey});
				}
				else {
					AssertValue(
						locator1 = "OSBAdminProjectAdd#KORONEIKI_ACCOUNT_KEY_FIELD",
						value1 = ${value});
				}
			}
			else if (${field} == "Dossiera Account Key") {
				AssertValue(
					locator1 = "OSBAdminProjectAdd#DOSSIERA_ACCOUNT_KEY_FIELD",
					value1 = ${value});
			}
			else if (${field} == "Special Instructions") {
				AssertValue(
					locator1 = "OSBAdminProjectAdd#SPECIAL_INSTRUCTIONS_FIELD",
					value1 = ${value});
			}
			else if (${field} == "Region") {
				Click(locator1 = "OSBAdminProjectAdd#SUPPORT_REGIONS_TAB");

				var key_item = ${value};

				AssertTextEquals(
					locator1 = "OSBAdminProjectAdd#SUPPORT_REGION",
					value1 = ${value});
			}
			else if (${field} == "Language") {
				Click(locator1 = "OSBAdminProjectAdd#SUPPORT_LANGUAGES_TAB");

				var key_item = ${value};

				AssertTextEquals(
					locator1 = "OSBAdminProjectAdd#SUPPORT_LANGUAGE",
					value1 = ${value});
			}
			else {
				var key_field = ${field};

				if (IsElementPresent(locator1 = "OSBAdminProjectAdd#READ_ONLY_FIELD_LABEL")) {
					AssertTextEquals.assertPartialText(
						locator1 = "OSBAdminProjectAdd#READ_ONLY_FIELD_VALUE",
						value1 = ${value});
				}
				else {
					fail("No such project field ${field}");
				}
			}
		}
	}

	macro viewNoneViaName {
		OSBAdminSearch.searchBasicProjectViaName(projectName = ${projectName});

		var key_name = ${projectName};

		AssertElementNotPresent(locator1 = "OSBAdmin#SEARCH_RESULT_NAME");
	}

}