	macro searchKeyword {
		Type(
			locator1 = "ProjectDetails#SEARCH_FIELD",
			value1 = ${keyword});

		KeyPress(
			locator1 = "ProjectDetails#SEARCH_FIELD",
			value1 = "\RETURN");
	}

	macro searchProject {
		Type(
			locator1 = "ProjectDetails#SEARCH_FIELD",
			value1 = ${projectName});

		KeyPress(
			locator1 = "ProjectDetails#SEARCH_FIELD",
			value1 = "\RETURN");
