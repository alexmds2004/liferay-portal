	macro viewSourceCodeAccessFormErrors {
		var rawTable = TableUtil.newTable(${table});

		for (var row : table ${rawTable}) {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if (${field} == "Main Error") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProjectDetailsSourceCodeAccessForm#ERROR_MESSAGE",
					value1 = ${value});
			}
			else if (${field} == "Name Field Error") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProjectDetailsSourceCodeAccessForm#NAME_FIELD_ERROR",
					value1 = ${value});
			}
			else if (${field} == "Email Address Field Error") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProjectDetailsSourceCodeAccessForm#EMAIL_ADDRESS_FIELD_ERROR",
					value1 = ${value});
			}
			else if (${field} == "GitHub Username Field Error") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProjectDetailsSourceCodeAccessForm#GITHUB_USERNAME_FIELD_ERROR",
					value1 = ${value});
			}
			else {
				fail("No such Source Code Access error ${field}. Please use Main Error, Name Field Error, Email Address Field Error, or GitHub Username Field Error");
			}
		}
	}

