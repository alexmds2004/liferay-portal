	macro viewAttachment {
		var key_fileKeyword = ${fileKeyword};
		var rawTable = TableUtil.newTable(${table});

		for (var row : table ${rawTable}) {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if (${field} == "Ticket") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProjectDetailsProject#ATTACHMENT_TICKET",
					value1 = ${value});
			}
			else if (${field} == "File Name") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProjectDetailsProject#ATTACHMENT_FILE_NAME",
					value1 = ${value});
			}
			else if (${field} == "File Name Link") {
				if (${value} == "true") {
					AssertVisible(locator1 = "ProjectDetailsProject#ATTACHMENT_FILE_NAME_LINK");
				}
				else {
					AssertElementNotPresent(locator1 = "ProjectDetailsProject#ATTACHMENT_FILE_NAME_LINK");
				}
			}
			else if (${field} == "File Size") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProjectDetailsProject#ATTACHMENT_FILE_SIZE",
					value1 = ${value});
			}
			else if (${field} == "Attached") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProjectDetailsProject#ATTACHMENT_ATTACHED",
					value1 = ${value});
			}
			else if (${field} == "Does Not Contain Personal Data") {
				if (${value} == "true") {
					AssertVisible(locator1 = "ProjectDetailsProject#ATTACHMENT_DOES_NOT_CONTAIN_PERSONAL_DATA_CHECKED");
				}
				else {
					AssertElementNotPresent(locator1 = "ProjectDetailsProject#ATTACHMENT_DOES_NOT_CONTAIN_PERSONAL_DATA_CHECKED");
				}
			}
			else {
				fail("No such attachment field ${field}");
			}
		}
	}

	macro viewAttachmentActionsLink {
		var key_fileKeyword = ${fileKeyword};

		AssertVisible(locator1 = "ProjectDetailsProject#ATTACHMENT_ACTIONS_LINK");

		AssertElementNotPresent(locator1 = "ProjectDetailsProject#ATTACHMENT_DELETE_LINK");
	}

	macro viewAttachmentDeleteLink {
		var key_fileKeyword = ${fileKeyword};

		AssertVisible(locator1 = "ProjectDetailsProject#ATTACHMENT_DELETE_LINK");

		AssertElementNotPresent(locator1 = "ProjectDetailsProject#ATTACHMENT_ACTIONS_LINK");
	}

	macro viewDetails {
		var rawTable = TableUtil.newTable(${table});

		for (var row : table ${rawTable}) {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if (${field} == "Project Code") {
				AssertTextEquals(
					locator1 = "ProjectDetailsProject#PROJECT_CODE",
					value1 = ${value});
			}
			else if (${field} == "Dossiera Account") {
				AssertTextEquals(
					locator1 = "ProjectDetailsProject#DOSSIERA_ACCOUNT",
					value1 = ${value});
			}
			else if (${field} == "State") {
				AssertTextEquals(
					locator1 = "ProjectDetailsProject#STATE",
					value1 = ${value});
			}
			else if (${field} == "Level") {
				AssertTextEquals(
					locator1 = "ProjectDetailsProject#LEVEL",
					value1 = ${value});
			}
			else if (${field} == "Support Region") {
				AssertTextEquals(
					locator1 = "ProjectDetailsProject#SUPPORT_REGION",
					value1 = ${value});
			}
			else if (${field} == "Partner") {
				AssertTextEquals(
					locator1 = "ProjectDetailsProject#PARTNER",
					value1 = ${value});
			}
			else if (${field} == "Partner Support") {
				AssertTextEquals(
					locator1 = "ProjectDetailsProject#PARTNER_SUPPORT",
					value1 = ${value});
			}
			else if (${field} == "Tier") {
				AssertTextEquals(
					locator1 = "ProjectDetailsProject#TIER",
					value1 = ${value});
			}
			else if (${field} == "Industry") {
				AssertTextEquals(
					locator1 = "ProjectDetailsProject#INDUSTRY",
					value1 = ${value});
			}
			else if (${field} == "Last Modified") {
				if (${value} == "Today") {
					var day = DateUtil.getCurrentDate();
					var month = DateUtil.getCurrentMonth();
					var year = DateUtil.getCurrentYear();

					var yearEdit = StringUtil.replaceFirst(${year}, 20, "");

					var startDate = "${month}/${day}/${yearEdit}";

					if (IsTextNotEqual(locator1 = "ProjectDetailsProject#LAST_MODIFIED", value1 = ${startDate})) {
						var day = DateUtil.getDate(1);
						var month = DateUtil.getMonth(1);
						var year = DateUtil.getYear(1);

						var yearEdit = StringUtil.replaceFirst(${year}, 20, "");

						var startDate = "${month}/${day}/${yearEdit}";

						AssertTextEquals(
							locator1 = "ProjectDetailsProject#LAST_MODIFIED",
							value1 = ${startDate});
					}
					else {
						AssertTextEquals(
							locator1 = "ProjectDetailsProject#LAST_MODIFIED",
							value1 = ${startDate});
					}
				}
				else {
					AssertTextEquals(
						locator1 = "ProjectDetailsProject#LAST_MODIFIED",
						value1 = ${value});
				}
			}
			else if (${field} == "Modified By") {
				AssertTextEquals(
					locator1 = "ProjectDetailsProject#MODIFIED_BY",
					value1 = ${value});
			}
			else {
				fail("No such project details field ${field}");
			}
		}
	}

	macro viewEnvironmentConfiguration {
		var key_environmentName = ${environmentName};
		var rawTable = TableUtil.newTable(${table});

		for (var row : table ${rawTable}) {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if (${field} == "Name") {
				AssertTextEquals(
					locator1 = "ProjectDetailsProject#ENVIRONMENT_NAME",
					value1 = ${value});
			}
			else if (${field} == "Product") {
				AssertTextEquals(
					locator1 = "ProjectDetailsProject#ENVIRONMENT_PRODUCT",
					value1 = ${value});
			}
			else if (${field} == "Liferay Version") {
				AssertTextEquals(
					locator1 = "ProjectDetailsProject#ENVIRONMENT_LIFERAY_VERSION",
					value1 = ${value});
			}
			else if (${field} == "Commerce Version") {
				if (IsElementPresent(locator1 = "ProjectDetailsProject#ENVIRONMENT_DETAILS_EXPAND_BUTTON")) {
					Click(locator1 = "ProjectDetailsProject#ENVIRONMENT_DETAILS_EXPAND_BUTTON");
				}

				AssertTextEquals(
					locator1 = "ProjectDetailsProject#ENVIRONMENT_COMMERCE_VERSION",
					value1 = ${value});
			}
			else if (${field} == "Operating System") {
				if (IsElementPresent(locator1 = "ProjectDetailsProject#ENVIRONMENT_DETAILS_EXPAND_BUTTON")) {
					Click(locator1 = "ProjectDetailsProject#ENVIRONMENT_DETAILS_EXPAND_BUTTON");
				}

				AssertTextEquals(
					locator1 = "ProjectDetailsProject#ENVIRONMENT_OPERATING_SYSTEM",
					value1 = ${value});
			}
			else if (${field} == "Application Server") {
				if (IsElementPresent(locator1 = "ProjectDetailsProject#ENVIRONMENT_DETAILS_EXPAND_BUTTON")) {
					Click(locator1 = "ProjectDetailsProject#ENVIRONMENT_DETAILS_EXPAND_BUTTON");
				}

				AssertTextEquals(
					locator1 = "ProjectDetailsProject#ENVIRONMENT_APPLICATION_SERVER",
					value1 = ${value});
			}
			else if (${field} == "Search") {
				if (IsElementPresent(locator1 = "ProjectDetailsProject#ENVIRONMENT_DETAILS_EXPAND_BUTTON")) {
					Click(locator1 = "ProjectDetailsProject#ENVIRONMENT_DETAILS_EXPAND_BUTTON");
				}

				AssertTextEquals(
					locator1 = "ProjectDetailsProject#ENVIRONMENT_SEARCH",
					value1 = ${value});
			}
			else if (${field} == "Java Version") {
				if (IsElementPresent(locator1 = "ProjectDetailsProject#ENVIRONMENT_DETAILS_EXPAND_BUTTON")) {
					Click(locator1 = "ProjectDetailsProject#ENVIRONMENT_DETAILS_EXPAND_BUTTON");
				}

				AssertTextEquals(
					locator1 = "ProjectDetailsProject#ENVIRONMENT_JAVA_VERSION",
					value1 = ${value});
			}
			else if (${field} == "Database") {
				if (IsElementPresent(locator1 = "ProjectDetailsProject#ENVIRONMENT_DETAILS_EXPAND_BUTTON")) {
					Click(locator1 = "ProjectDetailsProject#ENVIRONMENT_DETAILS_EXPAND_BUTTON");
				}

				AssertTextEquals(
					locator1 = "ProjectDetailsProject#ENVIRONMENT_DATABASE",
					value1 = ${value});
			}
			else if (${field} == "Cloud Services") {
				if (IsElementPresent(locator1 = "ProjectDetailsProject#ENVIRONMENT_DETAILS_EXPAND_BUTTON")) {
					Click(locator1 = "ProjectDetailsProject#ENVIRONMENT_DETAILS_EXPAND_BUTTON");
				}

				AssertTextEquals(
					locator1 = "ProjectDetailsProject#ENVIRONMENT_CLOUD_SERVICES",
					value1 = ${value});
			}
			else if (${field} == "Browser") {
				if (IsElementPresent(locator1 = "ProjectDetailsProject#ENVIRONMENT_DETAILS_EXPAND_BUTTON")) {
					Click(locator1 = "ProjectDetailsProject#ENVIRONMENT_DETAILS_EXPAND_BUTTON");
				}

