	}

	macro deleteAttachment {
		var key_fileKeyword = ${fileKeyword};

		if (IsElementPresent(locator1 = "ProjectDetailsProject#ATTACHMENT_ACTIONS_LINK")) {
			Click(locator1 = "ProjectDetailsProject#ATTACHMENT_ACTIONS_LINK");

			var key_action = "Delete";

			ClickNoError(locator1 = "ProjectDetailsProject#MENULIST_ACTION");
		}
		else {
			ClickNoError(locator1 = "ProjectDetailsProject#ATTACHMENT_DELETE_LINK");
		}

		Confirm(value1 = "Are you sure you want to delete this?");

		Message.success();
	}

	macro deleteEnvironmentConfiguration {
		var key_environmentName = ${environmentName};

		if (IsElementPresent(locator1 = "ProjectDetailsProject#ENVIRONMENT_DETAILS_EXPAND_BUTTON")) {
			Click(locator1 = "ProjectDetailsProject#ENVIRONMENT_DETAILS_EXPAND_BUTTON");
		}

		Click(locator1 = "ProjectDetailsProject#ENVIRONMENT_DELETE_BUTTON");

		Confirm(value1 = "Are you sure you want to delete this?");

		Message.success();
	}

	macro deleteSourceCodeAccessUser {
		var key_userEmailAddress = ${userEmailAddress};

		ProjectDetails.expandSourceCodeAccessUserPanel(userEmailAddress = ${userEmailAddress});

		ClickNoError(locator1 = "ProjectDetailsProject#SOURCE_CODE_ACCESS_USER_DETAILS_DELETE_BUTTON");

		Confirm(value1 = "Are you sure you want to delete this?");
	}

	macro downloadAttachmentViaActionLink {
		var key_fileKeyword = ${fileKeyword};

		Click(locator1 = "ProjectDetailsProject#ATTACHMENT_FILE_NAME_LINK");

		DownloadTempFile();
	}

	macro editAttachmentToBeAccessibleFromAnywhere {
		var key_fileKeyword = ${fileKeyword};

		Click(locator1 = "ProjectDetailsProject#ATTACHMENT_ACTIONS_LINK");

		var key_action = "Edit Access";

		Click(locator1 = "ProjectDetailsProject#MENULIST_ACTION");

		SelectFrame(locator1 = "ProjectDetailsEditAccessForm#EDIT_ACCESS_IFRAME");

		AssertTextEquals.assertPartialText(
			locator1 = "ProjectDetailsEditAccessForm#INFO_MESSAGE",
			value1 = "Note: This action cannot be undone.");

		Check(locator1 = "ProjectDetailsEditAccessForm#NO_PERSONAL_DATA_CHECKBOX");

		Button.save();

		SelectFrameTop();
	}

	macro editEnvironmentConfiguration {
		var key_environmentName = ${environmentName};

		if (IsElementPresent(locator1 = "ProjectDetailsProject#ENVIRONMENT_DETAILS_EXPAND_BUTTON")) {
			Click(locator1 = "ProjectDetailsProject#ENVIRONMENT_DETAILS_EXPAND_BUTTON");
		}

		Click(locator1 = "ProjectDetailsProject#ENVIRONMENT_EDIT_BUTTON");

		var rawTable = TableUtil.newTable(${table});

		for (var row : table ${rawTable}) {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if (${field} == "Name") {
				while (IsElementNotPresent(locator1 = "ProjectDetailsEnvironmentForm#NAME_FIELD_EMPTY")) {
					DoubleClick(locator1 = "ProjectDetailsEnvironmentForm#NAME_FIELD");

					KeyPress(
						locator1 = "ProjectDetailsEnvironmentForm#NAME_FIELD",
						value1 = "\BACK_SPACE");
				}

				Type(
					locator1 = "ProjectDetailsEnvironmentForm#NAME_FIELD",
					value1 = ${value});
			}
			else if (${field} == "Product") {
				Select(
					locator1 = "ProjectDetailsEnvironmentForm#PRODUCT_SELECT",
					value1 = ${value});
			}
			else if (${field} == "Commerce Version") {
				Select(
					locator1 = "ProjectDetailsEnvironmentForm#COMMERCE_VERSION_SELECT",
					value1 = ${value});
			}
			else if (${field} == "Liferay Version") {
				Select(
					locator1 = "ProjectDetailsEnvironmentForm#LIFERAY_VERSION_SELECT",
					value1 = ${value});
			}
			else if (${field} == "Operating System") {
				Select(
					locator1 = "ProjectDetailsEnvironmentForm#OPERATING_SYSTEM_SELECT",
					value1 = ${value});
			}
			else if (${field} == "Java Version") {
				Select(
					locator1 = "ProjectDetailsEnvironmentForm#JAVA_VERSION_SELECT",
					value1 = ${value});
			}
			else if (${field} == "Application Server") {
				Select(
					locator1 = "ProjectDetailsEnvironmentForm#APPLICATION_SERVER_SELECT",
					value1 = ${value});
			}
			else if (${field} == "Database") {
				Select(
					locator1 = "ProjectDetailsEnvironmentForm#DATABASE_SELECT",
					value1 = ${value});
			}
			else if (${field} == "Cloud Services") {
				Select(
					locator1 = "ProjectDetailsEnvironmentForm#CLOUD_SERVICES_SELECT",
					value1 = ${value});
			}
			else if (${field} == "Browser") {
				Select(
					locator1 = "ProjectDetailsEnvironmentForm#BROWSER_SELECT",
					value1 = ${value});
			}
			else if (${field} == "Search") {
				var key_option = ${value};

				Click(locator1 = "ProjectDetailsEnvironmentForm#SEARCH_SELECT_OPTION");
			}
			else {
				fail("No such environment configuration field ${field}");
			}
		}

		Button.save();

		Message.success();
	}

