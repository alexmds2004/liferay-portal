definition {

	macro acceptGitHubInvitation {
		Open(locator1 = "https://github.com/is-support-integration/liferay-dxp/invitations");

		if (IsElementPresent(locator1 = "GitHub#GITHUB_SIGN_UP_PAGE_LINK")) {
			if (IsVisible(locator1 = "GitHub#GITHUB_TOGGLE_NAVIGATION")) {
				Click(locator1 = "GitHub#GITHUB_TOGGLE_NAVIGATION");
			}

			Click(locator1 = "GitHub#GITHUB_SIGN_IN_PAGE_LINK");

			Type(
				locator1 = "GitHub#GITHUB_SIGN_IN_USERNAME_FIELD",
				value1 = ${userGitHubUsername});

			Type(
				locator1 = "GitHub#GITHUB_SIGN_IN_PASSWORD_FIELD",
				value1 = ${userPassword});

			Click(locator1 = "GitHub#GITHUB_SIGN_IN_BUTTON");
		}

		Click(locator1 = "GitHub#GITHUB_ACCEPT_INVITATION_BUTTON");
	}

	macro viewISSupportIntegrationGitHubRespository {
		Open(locator1 = "https://github.com/is-support-integration/liferay-dxp");

		if (IsElementPresent(locator1 = "GitHub#GITHUB_SIGN_IN_PAGE_LINK")) {
			Click(locator1 = "GitHub#GITHUB_SIGN_IN_PAGE_LINK");

			Type(
				locator1 = "GitHub#GITHUB_SIGN_IN_USERNAME_FIELD",
				value1 = ${userGitHubUsername});

			Type(
				locator1 = "GitHub#GITHUB_SIGN_IN_PASSWORD_FIELD",
				value1 = ${userPassword});

			Click(locator1 = "GitHub#GITHUB_SIGN_IN_BUTTON");
		}

		AssertVisible(locator1 = "GitHub#GITHUB_IS_SUPPPORT_INTEGRATION_REPOSITORY_HEADER_LINK");
	}

	macro viewNoGitHubInvitation {
		Open(locator1 = "https://github.com/is-support-integration/liferay-dxp/invitations");

		if (IsElementPresent(locator1 = "GitHub#GITHUB_SIGN_IN_PAGE_LINK")) {
			Click(locator1 = "GitHub#GITHUB_SIGN_IN_PAGE_LINK");

			Type(
				locator1 = "GitHub#GITHUB_SIGN_IN_USERNAME_FIELD",
				value1 = ${userGitHubUsername});

			Type(
				locator1 = "GitHub#GITHUB_SIGN_IN_PASSWORD_FIELD",
				value1 = ${userPassword});

			Click(locator1 = "GitHub#GITHUB_SIGN_IN_BUTTON");
		}

		AssertElementNotPresent(locator1 = "GitHub#GITHUB_ACCEPT_INVITATION_BUTTON");
	}

	macro viewNoGitHubRespository {
		Open(locator1 = "https://github.com/is-support-integration/liferay-dxp");

		if (IsElementPresent(locator1 = "GitHub#GITHUB_SIGN_IN_PAGE_LINK")) {
			Click(locator1 = "GitHub#GITHUB_SIGN_IN_PAGE_LINK");

			Type(
				locator1 = "GitHub#GITHUB_SIGN_IN_USERNAME_FIELD",
				value1 = ${userGitHubUsername});

			Type(
				locator1 = "GitHub#GITHUB_SIGN_IN_PASSWORD_FIELD",
				value1 = ${userPassword});

			Click(locator1 = "GitHub#GITHUB_SIGN_IN_BUTTON");
		}

		AssertElementNotPresent(locator1 = "GitHub#GITHUB_IS_SUPPPORT_INTEGRATION_REPOSITORY_HEADER_LINK");
	}

}