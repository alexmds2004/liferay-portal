definition {

	var provisioningURL = PropsUtil.get("provisioning.liferay.url");

	macro _viewNoAccount {
		var key_accountName = ${ccountName};

		AssertElementNotPresent(locator1 = "ProvisioningTeam#ACCOUNT_ROW");
	}

	macro _viewNoTeamMember {
		var key_memberEmailAddress = ${memberEmailAddress};

		AssertElementNotPresent(locator1 = "ProvisioningTeam#MEMBER_ROW");
	}

	macro _viewNoTeamMemberUnassignLink {
		var key_memberEmailAddress = ${memberEmailAddress};

		AssertElementNotPresent(locator1 = "ProvisioningTeam#MEMBER_UNASSIGN_LINK");
	}

	macro _viewTeamAccount {
		var key_accountName = ${accountName};
		var rawTable = TableUtil.newTable(${table});

		for (var row : table ${rawTable}) {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if (${field} == "Account Name") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningTeam#ACCOUNT_NAME",
					value1 = ${value});
			}
			else if (${field} == "Code") {
				AssertTextEquals(
					locator1 = "ProvisioningTeam#ACCOUNT_CODE",
					value1 = ${value});
			}
			else if (${field} == "Support End Date") {
				AssertTextEquals(
					locator1 = "ProvisioningTeam#ACCOUNT_SUPPORT_END_DATE",
					value1 = ${value});
			}
			else if (${field} == "Region") {
				AssertTextEquals(
					locator1 = "ProvisioningTeam#ACCOUNT_REGION",
					value1 = ${value});
			}
			else if (${field} == "SLA") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningTeam#ACCOUNT_SLA",
					value1 = ${value});
			}
			else if (${field} == "Tier") {
				AssertTextEquals(
					locator1 = "ProvisioningTeam#ACCOUNT_TIER",
					value1 = ${value});
			}
			else if (${field} == "Account State") {
				AssertTextEquals(
					locator1 = "ProvisioningTeam#ACCOUNT_STATE",
					value1 = ${value});
			}
			else {
				fail("No such account field ${field}");
			}
		}
	}

	macro _viewTeamDetails {
		var rawTable = TableUtil.newTable(${table});

		for (var row : table ${rawTable}) {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if (${field} == "Name") {
				AssertTextEquals(
					locator1 = "ProvisioningTeam#TEAM_HEADER",
					value1 = ${value});
			}
			else if (${field} == "Created") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningTeam#TEAM_CREATED_DATE",
					value1 = ${value});
			}
			else if (${field} == "Last Modified") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningTeam#TEAM_LAST_MODIFIED_DATE",
					value1 = ${value});
			}
			else {
				fail("No such team detail field ${field}");
			}
		}
	}

	macro _viewTeamMember {
		var key_memberEmailAddress = ${memberEmailAddress};
		var rawTable = TableUtil.newTable(${table});

		for (var row : table ${rawTable}) {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if (${field} == "Name") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningTeam#MEMBER_NAME",
					value1 = ${value});
			}
			else if (${field} == "Email Address") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningTeam#MEMBER_EMAIL_ADDRESS",
					value1 = ${value});
			}
			else if (${field} == "Status") {
				AssertTextEquals(
					locator1 = "ProvisioningTeam#MEMBER_STATUS",
					value1 = ${value});
			}
			else {
				fail("No such team member field ${field}");
			}
		}
	}

	macro assignMember {
		SelectFrame(locator1 = "ProvisioningTeamAssignMembers#ASSIGN_MEMBERS_IFRAME");

		Type(
			locator1 = "ProvisioningTeamAssignMembers#ASSIGN_MEMBERS_SEARCH_FIELD",
			value1 = ${memberEmailAddress});

		Click(locator1 = "ProvisioningTeamAssignMembers#ASSIGN_MEMBERS_SEARCH_BUTTON");

		var key_memberEmailAddress = ${memberEmailAddress};

		Check(locator1 = "ProvisioningTeamAssignMembers#MEMBER_CHECKBOX");

		SelectFrameTop();

		Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningTeamAssignMembers#DONE_BUTTON");

		while (IsElementPresent(locator1 = "ProvisioningTeamAssignMembers#DONE_BUTTON")) {
			SelectFrame(locator1 = "ProvisioningTeamAssignMembers#ASSIGN_MEMBERS_IFRAME");

			Uncheck(locator1 = "ProvisioningTeamAssignMembers#MEMBER_CHECKBOX");

			Check(locator1 = "ProvisioningTeamAssignMembers#MEMBER_CHECKBOX");

			SelectFrameTop();

			Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningTeamAssignMembers#DONE_BUTTON");
		}
	}

	macro clickAssignMembersButton {
		Click(locator1 = "ProvisioningTeam#ASSIGN_MEMBERS_BUTTON");
	}

	macro clickDeleteButton {
		ClickNoError(locator1 = "ProvisioningTeam#TEAM_DELETE_BUTTON");

		Confirm(value1 = "Are you sure you want to delete this team?");
	}

	macro clickEditButton {
		Click(locator1 = "ProvisioningTeam#TEAM_EDIT_BUTTON");

		AssertVisible(locator1 = "ProvisioningTeamForm#NAME_FIELD");
	}

	macro clickMemberLink {
		var key_memberEmailAddress = ${memberEmailAddress};

		Click(locator1 = "ProvisioningTeam#MEMBER_LINK");
	}

	macro clickSyncFromOktaButton {
		Click(locator1 = "ProvisioningTeam#TEAM_SYNC_FROM_OKTA_BUTTON");

		Message.success();
	}

	macro clickTeamFormCancelButton {
		Click(locator1 = "ProvisioningTeamForm#CANCEL_BUTTON");
	}

	macro populateTeamFormAndSave {
		Type(
			locator1 = "ProvisioningTeamForm#NAME_FIELD",
			value1 = ${teamName});

		Click(locator1 = "ProvisioningTeamForm#SAVE_BUTTON");
	}

	macro populateTeamFormWithDuplicateNameAndSave {
		Type(
			locator1 = "ProvisioningTeamForm#NAME_FIELD",
			value1 = ${teamName});

		Click(locator1 = "ProvisioningTeamForm#SAVE_BUTTON");

		AssertTextEquals.assertPartialText(
			locator1 = "ProvisioningTeamForm#NAME_IN_USE_ERROR_MESSAGE",
			value1 = "Error:");

		AssertTextEquals.assertPartialText(
			locator1 = "ProvisioningTeamForm#NAME_IN_USE_ERROR_MESSAGE",
			value1 = "A team with name ${teamName} on account ${accountName} is already in use");
	}

	macro search {
		Type(
			locator1 = "ProvisioningTeam#SEARCH_FIELD",
			value1 = ${keyword});

		KeyPress(
			locator1 = "ProvisioningTeam#SEARCH_FIELD",
			value1 = "\RETURN");
	}

	macro unassignMember {
		var key_memberEmailAddress = ${memberEmailAddress};

		ClickNoError(locator1 = "ProvisioningTeam#MEMBER_UNASSIGN_LINK");

		Confirm(value1 = "Are you sure you want to unassign this contact?");
	}

	macro viewDisabledMemberCheckbox {
		SelectFrame(locator1 = "ProvisioningTeamAssignMembers#ASSIGN_MEMBERS_IFRAME");

		var key_memberEmailAddress = ${memberEmailAddress};

		AssertElementPresent(locator1 = "ProvisioningTeamAssignMembers#MEMBER_CHECKBOX_DISABLED");

		SelectFrameTop();

		Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningTeamAssignMembers#CANCEL_BUTTON");

		while (IsElementPresent(locator1 = "ProvisioningTeamAssignMembers#CANCEL_BUTTON")) {
			Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningTeamAssignMembers#CANCEL_BUTTON");
		}
	}

	macro viewNoAssignMembersButton {
		AssertElementNotPresent(locator1 = "ProvisioningTeam#TEAM_DELETE_BUTTON");
	}

	macro viewNoDeleteButton {
		AssertElementNotPresent(locator1 = "ProvisioningTeam#TEAM_DELETE_BUTTON");
	}

	macro viewNoEditButton {
		AssertElementNotPresent(locator1 = "ProvisioningTeam#TEAM_EDIT_BUTTON");
	}

}