		AssertTextEquals.assertPartialText(
			locator1 = "Provisioning#ERROR_MESSAGE",
			value1 = "Product ${productId} cannot be deleted because it is referenced by one or more product consumptions");
	}

	macro viewProductIndexProductPurchaseErrorMessage {
		AssertTextEquals.assertPartialText(
			locator1 = "Provisioning#ERROR_MESSAGE",
			value1 = "Error:");

		AssertTextEquals.assertPartialText(
			locator1 = "Provisioning#ERROR_MESSAGE",
			value1 = "Product ${productId} cannot be deleted because it is referenced by one or more product purchases");
	}

	macro viewSearchAccountsField {
		while (IsElementNotPresent(locator1 = "Provisioning#SEARCH_ACCOUNTS_FIELD")) {
			Refresh();
		}

		AssertVisible(locator1 = "Provisioning#SEARCH_ACCOUNTS_FIELD");
	}

	macro viewSearchDropdownResult {
		var key_result = ${result};
		var rawTable = TableUtil.newTable(${table});

		for (var row : table ${rawTable}) {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if (${field} == "Name") {
				AssertTextEquals(
					locator1 = "Provisioning#SEARCH_ACCOUNTS_DROPDOWN_RESULT_NAME",
					value1 = ${value});
			}
			else if (${field} == "Code") {
				AssertTextEquals(
					locator1 = "Provisioning#SEARCH_ACCOUNTS_DROPDOWN_RESULT_CODE",
					value1 = ${value});
			}
			else {
				fail("No such search result dropdown field ${field}");
			}
		}
	}

	macro viewSearchInfoMessage {
		var key_result = ${result};
		var rawTable = TableUtil.newTable(${table});

		for (var row : table ${rawTable}) {
			var type = "${row[0]}";
			var value = "${row[1]}";

			if (${type} == "Text") {
				AssertTextEquals.assertPartialText(
					locator1 = "Provisioning#SEARCH_MESSAGE_TEXT",
					value1 = ${value});
			}
			else if (${type} == "Label") {
				var key_labelContent = ${value};

				AssertTextEquals.assertPartialText(
					locator1 = "Provisioning#SEARCH_MESSAGE_LABEL",
					value1 = ${value});
			}
			else {
				fail("No such search info message type ${type}. Please use Text or Label as the type value.");
			}
		}
	}

}