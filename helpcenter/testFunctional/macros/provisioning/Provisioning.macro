definition {

	var provisioningURL = PropsUtil.get("provisioning.liferay.url");

	macro _viewAccountViaIndex {
		var key_accountName = ${accountName};
		var rawTable = TableUtil.newTable(${table});

		for (var row : table ${rawTable}) {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if (${field} == "Name") {
				AssertTextEquals.assertPartialText(
					locator1 = "Provisioning#ACCOUNT_NAME",
					value1 = ${value});
			}
			else if (${field} == "Code") {
				AssertTextEquals(
					locator1 = "Provisioning#ACCOUNT_CODE",
					value1 = ${value});
			}
			else if (${field} == "Support End Date") {
				AssertTextEquals(
					locator1 = "Provisioning#ACCOUNT_SUPPORT_END_DATE",
					value1 = ${value});
			}
			else if (${field} == "Partner") {
				AssertTextEquals(
					locator1 = "Provisioning#ACCOUNT_PARTNER",
					value1 = ${value});
			}
			else if (${field} == "Region") {
				AssertTextEquals(
					locator1 = "Provisioning#ACCOUNT_REGION",
					value1 = ${value});
			}
			else if (${field} == "SLA") {
				AssertTextEquals.assertPartialText(
					locator1 = "Provisioning#ACCOUNT_SLA",
					value1 = ${value});
			}
			else if (${field} == "Tier") {
				AssertTextEquals(
					locator1 = "Provisioning#ACCOUNT_TIER",
					value1 = ${value});
			}
			else if (${field} == "State") {
				AssertTextEquals(
					locator1 = "Provisioning#ACCOUNT_STATE",
					value1 = ${value});
			}
			else {
				fail("No such account field ${field}");
			}
		}
	}

	macro _viewLicenseViaIndex {
		var key_licenseKeyword = ${licenseKeyword};
		var rawTable = TableUtil.newTable(${table});

		for (var row : table ${rawTable}) {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if (${field} == "Name") {
				AssertTextEquals.assertPartialText(
					locator1 = "Provisioning#LICENSE_NAME",
					value1 = ${value});
			}
			else if (${field} == "Description") {
				AssertTextEquals(
					locator1 = "Provisioning#LICENSE_DESCRIPTION",
					value1 = ${value});
			}
			else if (${field} == "Account") {
				AssertTextEquals(
					locator1 = "Provisioning#LICENSE_ACCOUNT",
					value1 = ${value});
			}
			else if (${field} == "Expiration Date") {
				AssertTextEquals(
					locator1 = "Provisioning#LICENSE_EXPIRATION_DATE",
					value1 = ${value});
			}
			else if (${field} == "Product") {
				AssertTextEquals.assertPartialText(
					locator1 = "Provisioning#LICENSE_PRODUCT",
					value1 = ${value});
			}
			else if (${field} == "Type") {
				AssertTextEquals(
					locator1 = "Provisioning#LICENSE_TYPE",
					value1 = ${value});
			}
			else if (${field} == "Details") {
				var key_label = StringUtil.extractFirst(${value}, ":");

				var key_label = StringUtil.trim(${key_label});
				var value = StringUtil.extractLast(${value}, ":");

				var value = StringUtil.trim(${value});

				AssertTextEquals.assertPartialText(
					locator1 = "Provisioning#LICENSE_DETAILS",
					value1 = ${value});
			}
			else if (${field} == "Status") {
				AssertTextEquals(
					locator1 = "Provisioning#LICENSE_STATUS",
					value1 = ${value});
			}
			else if (${field} == "Complimentary") {
				if (${value} == "true") {
					AssertElementPresent(
						locator1 = "Provisioning#LICENSE_COMPLIMENTARY_CHECKED",
						value1 = ${value});
				}
				else {
					AssertElementPresent(
						locator1 = "Provisioning#LICENSE_COMPLIMENTARY_NOT_CHECKED",
						value1 = ${value});
				}
			}
			else {
				fail("No such license field ${field}");
			}
		}
	}

