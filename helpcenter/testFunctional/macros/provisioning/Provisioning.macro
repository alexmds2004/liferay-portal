		for (var row : table ${rawTable}) {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if (${field} == "Name") {
				AssertTextEquals(
					locator1 = "Provisioning#PRODUCT_BUNDLE_NAME_NON_LINK",
					value1 = ${value});

				AssertElementNotPresent(locator1 = "Provisioning#PRODUCT_BUNDLE_NAME");
			}
			else {
				fail("No such product bundle field ${field}");
			}
		}
	}

