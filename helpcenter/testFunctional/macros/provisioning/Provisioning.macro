	macro sendKeysKeywordViaSearchAccountsField {
		while (IsElementNotPresent(locator1 = "Provisioning#SEARCH_ACCOUNTS_FIELD")) {
			Refresh();
		}

		DoubleClick(locator1 = "Provisioning#SEARCH_ACCOUNTS_FIELD");

		Type.clickAtSendKeys(
			locator1 = "Provisioning#SEARCH_ACCOUNTS_FIELD",
			value1 = ${keyword});

		KeyPress(
			locator1 = "Provisioning#SEARCH_ACCOUNTS_FIELD",
			value1 = "\SPACE");

		KeyPress(
			locator1 = "Provisioning#SEARCH_ACCOUNTS_FIELD",
			value1 = "\BACK_SPACE");
	}

	macro sendKeysKeywordViaSearchLicensesField {
		DoubleClick(locator1 = "Provisioning#SEARCH_LICENSES_FIELD");

		Type.clickAtSendKeys(
			locator1 = "Provisioning#SEARCH_LICENSES_FIELD",
			value1 = ${keyword});

		KeyPress(
			locator1 = "Provisioning#SEARCH_LICENSES_FIELD",
			value1 = "\SPACE");

		KeyPress(
			locator1 = "Provisioning#SEARCH_LICENSES_FIELD",
			value1 = "\BACK_SPACE");
	}

	macro setIndexPagination {
		var key_itemsPerPage = ${itemsPerPage};

		if (IsElementNotPresent(locator1 = "Provisioning#PAGINATION_ITEMS_PER_PAGE_DROPDOWN_VISIBLE")) {
			Click(locator1 = "Provisioning#PAGINATION_ITEMS_PER_PAGE_DROPDOWN_LINK");
		}

		Click(locator1 = "Provisioning#PAGINATION_ITEMS_PER_PAGE_LINK");
	}

	macro tearDownProductBundles {
		var rawTable = TableUtil.newTable(${table});

		for (var row : table ${rawTable}) {
			var productBundleName = "${row[0]}";

			var key_productBundleName = ${productBundleName};

			if (IsElementPresent(locator1 = "Provisioning#PRODUCT_BUNDLE_ROW")) {
				Provisioning.clickProductBundleDeleteButton(productBundleName = ${productBundleName});
			}
		}
	}

