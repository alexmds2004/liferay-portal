	macro _viewUserViaIndex {
		var key_userName = ${userName};
		var rawTable = TableUtil.newTable(${table});

		for (var row : table ${rawTable}) {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if (${field} == "Name") {
				AssertTextEquals.assertPartialText(
					locator1 = "Provisioning#USER_NAME",
					value1 = ${value});
			}
			else if (${field} == "Email Address") {
				AssertTextEquals(
					locator1 = "Provisioning#USER_EMAIL_ADDRESS",
					value1 = ${value});
			}
			else if (${field} == "Entitlements") {
				if (${value} == "") {
					AssertNotVisible(locator1 = "Provisioning#USER_ENTITLEMENTS");
				}
				else {
					AssertTextEquals.assertPartialText(
						locator1 = "Provisioning#USER_ENTITLEMENTS",
						value1 = ${value});
				}
			}
			else if (${field} == "Number of Accounts") {
				AssertTextEquals(
					locator1 = "Provisioning#USER_NUMBER_OF_ACCOUNTS",
					value1 = ${value});
			}
			else if (${field} == "Status") {
				AssertTextEquals(
					locator1 = "Provisioning#USER_STATUS",
					value1 = ${value});
			}
			else {
				fail("No such user field ${field}");
			}
		}
	}

	macro assertNoAlert {
		AssertAlertNotPresent();
	}

	macro clickAccount {
