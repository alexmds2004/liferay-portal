	macro clickTab {
		var key_tabName = StringUtil.lowerCase(${tabName});

		var key_tabName = StringUtil.replace(${key_tabName}, " ", "-");

		var key_tabName = StringUtil.replace(${key_tabName}, "/", "-");

		Click(locator1 = "Provisioning#TAB");
	}

	macro clickUser {
		var key_userName = ${userName};

		Click(locator1 = "Provisioning#USER_NAME");
	}

	macro collapseAccountAdvancedSearchForm {
		while (IsElementNotPresent(locator1 = "Provisioning#SEARCH_ACCOUNTS_FIELD")) {
			Refresh();
		}

		AssertVisible(locator1 = "Provisioning#SEARCH_ACCOUNTS_FIELD");

		if (IsElementPresent(locator1 = "Provisioning#SEARCH_ACCOUNTS_ADVANCED_SEARCH_EXPANDED")) {
			Click.pauseClickAt(locator1 = "Provisioning#SEARCH_ACCOUNTS_ADVANCED_SEARCH_BUTTON");
		}
	}

	macro collapseAdvancedSearchPanel {
		var key_panelLabel = ${panelLabel};

		if (IsElementPresent(locator1 = "Provisioning#ADVANCED_SEARCH_PANEL_EXPANDED")) {
			Click(locator1 = "Provisioning#ADVANCED_SEARCH_PANEL");
		}
	}

	macro collapseLicenseAdvancedSearchForm {
		AssertVisible(locator1 = "Provisioning#SEARCH_LICENSES_FIELD");

		if (IsElementPresent(locator1 = "Provisioning#SEARCH_LICENSES_ADVANCED_SEARCH_EXPANDED")) {
			Click.pauseClickAt(locator1 = "Provisioning#SEARCH_LICENSES_ADVANCED_SEARCH_BUTTON");
