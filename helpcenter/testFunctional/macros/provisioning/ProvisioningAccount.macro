	macro searchAndAssertHistoryEntry {
		ScrollWebElementIntoView(locator1 = "ProvisioningAccount#HISTORY_PAGINATION");

		if (IsElementPresent(locator1 = "ProvisioningAccount#HISTORY_PAGE_NUMBER", key_pageNumber = "1")) {
			Click.clickNoMouseOver(locator1 = "ProvisioningAccount#HISTORY_PAGE_NUMBER", key_pageNumber = "1");		
		}

		while ((IsElementNotPresent(locator1 = "ProvisioningAccount#${path}", value1 = ${value})) && (IsElementNotPresent(locator1 = "ProvisioningAccount#HISTORY_NEXT_PAGE_DISABLED"))) {
			ProvisioningAccount.clickHistoryNextPage();
		}

		if (IsElementNotPresent(locator1 = "ProvisioningAccount#${path}", value1 = ${value})) {
			fail("No such ${value} value in history entry");
		}		
	}

	macro viewAccountHistoryEntryByKeyword {
		var key_keyword = ${keyword};
		var key_fieldName = ${fieldName};
		var rawTable = TableUtil.newTable(${table});

		for (var row : table ${rawTable}) {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if (${fieldName} == "status") {
				if (${field} == "Update Description") {
					var key_additionalEntity = StringUtil.replace(${value}, "${keyword} > ", "");

					ProvisioningAccount.searchAndAssertHistoryEntry(
						path = "HISTORY_UPDATE_DESCRIPTION_BY_KEYWORD",
						key_keyword = ${key_keyword},
						key_additionalEntity = ${key_additionalEntity},
						value = ${value});					
				}
				else if (${field} == "Update Field Name") {
					ProvisioningAccount.searchAndAssertHistoryEntry(
						path = "HISTORY_UPDATE_STATUS_FIELD_NAME_BY_KEYWORD",
						key_keyword = ${key_keyword},
						value = ${value});						
				}
				else if (${field} == "Update Field Original Value") {
					ProvisioningAccount.searchAndAssertHistoryEntry(
						path = "HISTORY_UPDATE_STATUS_FIELD_ORIGINAL_VALUE_BY_KEYWORD",
						key_keyword = ${key_keyword},
						value = ${value});						
				}
				else if (${field} == "Update Field New Value") {
					ProvisioningAccount.searchAndAssertHistoryEntry(
						path = "HISTORY_UPDATE_STATUS_FIELD_NEW_VALUE_BY_KEYWORD",
						key_keyword = ${key_keyword},
						value = ${value});						
				}
				else {
					fail("No such history entry field ${field}");
				}
			}
			else {
				if (${field} == "Update Description") {
					var key_additionalEntity = StringUtil.replace(${value}, "${keyword} > ", "");

					ProvisioningAccount.searchAndAssertHistoryEntry(
						path = "HISTORY_UPDATE_DESCRIPTION_BY_KEYWORD",
						key_keyword = ${key_keyword},
						key_additionalEntity = ${key_additionalEntity},
						value = ${value});							
				}
				else if (${field} == "Update Field Name") {
					ProvisioningAccount.searchAndAssertHistoryEntry(
						path = "HISTORY_UPDATE_FIELD_NAME_BY_KEYWORD",
						key_keyword = ${key_keyword},
						key_fieldName = ${key_fieldName},
						value = ${value});						
				}
				else if (${field} == "Update Field Original Value") {
					var key_originalValue = ${value};

					ProvisioningAccount.searchAndAssertHistoryEntry(
						path = "HISTORY_UPDATE_FIELD_ORIGINAL_VALUE_BY_KEYWORD",
						key_keyword = ${key_keyword},
						key_fieldName = ${key_fieldName},
						key_originalValue = ${key_originalValue},
						value = ${value});						
				}
				else if (${field} == "Update Field New Value") {
					var key_newValue = ${value};

					ProvisioningAccount.searchAndAssertHistoryEntry(
						path = "HISTORY_UPDATE_FIELD_NEW_VALUE_BY_KEYWORD",
						key_keyword = ${key_keyword},
						key_fieldName = ${key_fieldName},						
						key_newValue = ${key_newValue},
						value = ${value});							
				}
				else {
					fail("No such history entry field ${field}");
				}
			}
		}
	}

	macro viewAccountHistoryEntryByKeywordAndPosition {
		var key_keyword = ${keyword};
		var key_fieldName = ${fieldName};
		var key_positionValue = ${positionValue};
		var rawTable = TableUtil.newTable(${table});

		for (var row : table ${rawTable}) {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if (${fieldName} == "status") {
				if (${field} == "Update Description") {
					ProvisioningAccount.searchAndAssertHistoryEntry(
						path = "HISTORY_UPDATE_DESCRIPTION_BY_KEYWORD_AND_POSITION",
						key_keyword = ${key_keyword},
						key_positionValue = ${key_positionValue},
						value = ${value});						
				}
				else if (${field} == "Update Field Name") {
					ProvisioningAccount.searchAndAssertHistoryEntry(
						path = "HISTORY_UPDATE_STATUS_FIELD_NAME_BY_KEYWORD_AND_POSITION",
						key_keyword = ${key_keyword},
						key_positionValue = ${key_positionValue},
						value = ${value});						
				}
				else if (${field} == "Update Field Original Value") {
					ProvisioningAccount.searchAndAssertHistoryEntry(
						path = "HISTORY_UPDATE_STATUS_FIELD_ORIGINAL_VALUE_BY_KEYWORD_AND_POSITION",
						key_keyword = ${key_keyword},
						key_positionValue = ${key_positionValue},
						value = ${value});						
				}
				else if (${field} == "Update Field New Value") {
					ProvisioningAccount.searchAndAssertHistoryEntry(
						path = "HISTORY_UPDATE_STATUS_FIELD_NEW_VALUE_BY_KEYWORD_AND_POSITION",
						key_keyword = ${key_keyword},
						key_positionValue = ${key_positionValue},
						value = ${value});						
				}
				else {
					fail("No such history entry field ${field}");
				}
			}
			else {
				if (${field} == "Update Description") {
					ProvisioningAccount.searchAndAssertHistoryEntry(
						path = "HISTORY_UPDATE_DESCRIPTION_BY_KEYWORD_AND_POSITION",
						key_keyword = ${key_keyword},
						key_positionValue = ${key_positionValue},
						value = ${value});						
				}
				else if (${field} == "Update Field Name") {
					ProvisioningAccount.searchAndAssertHistoryEntry(
						path = "HISTORY_UPDATE_FIELD_NAME_BY_KEYWORD_AND_POSITION",
						key_keyword = ${key_keyword},
						key_fieldName = ${key_fieldName},
						key_positionValue = ${key_positionValue},
						value = ${value});						
				}
				else if (${field} == "Update Field Original Value") {
					ProvisioningAccount.searchAndAssertHistoryEntry(
						path = "HISTORY_UPDATE_FIELD_ORIGINAL_VALUE_BY_KEYWORD_AND_POSITION",
						key_keyword = ${key_keyword},
						key_fieldName = ${key_fieldName},
						key_positionValue = ${key_positionValue},
						value = ${value});						
				}
				else if (${field} == "Update Field New Value") {
					ProvisioningAccount.searchAndAssertHistoryEntry(
						path = "HISTORY_UPDATE_FIELD_NEW_VALUE_BY_KEYWORD_AND_POSITION",
						key_keyword = ${key_keyword},
						key_fieldName = ${key_fieldName},
						key_positionValue = ${key_positionValue},
						value = ${value});						
				}
				else {
					fail("No such history entry field ${field}");
				}
			}
		}
	}

	macro viewAccountHistoryEntryByKeywords {
		var key_keyword1 = ${keyword1};
		var key_keyword2 = ${keyword2};
		var key_fieldName = ${fieldName};
		var rawTable = TableUtil.newTable(${table});

		for (var row : table ${rawTable}) {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if (${fieldName} == "status") {
				if (${field} == "Update Description") {
					while ((IsElementNotPresent(locator1 = "ProvisioningAccount#HISTORY_UPDATE_DESCRIPTION_BY_KEYWORDS", value1 = ${value})) && (IsElementNotPresent(locator1 = "ProvisioningAccount#HISTORY_NEXT_PAGE_DISABLED"))) {
						ProvisioningAccount.clickHistoryNextPage();
					}

					if (IsElementNotPresent(locator1 = "ProvisioningAccount#HISTORY_UPDATE_DESCRIPTION_BY_KEYWORDS", value1 = ${value})) {
						fail("History entry field ${field} of value ${value} is not present.");
					}
				}
				else if (${field} == "Update Field Name") {
					while ((IsElementNotPresent(locator1 = "ProvisioningAccount#HISTORY_UPDATE_STATUS_FIELD_NAME_BY_KEYWORDS", value1 = ${value})) && (IsElementNotPresent(locator1 = "ProvisioningAccount#HISTORY_NEXT_PAGE_DISABLED"))) {
						ProvisioningAccount.clickHistoryNextPage();
					}

					if (IsElementNotPresent(locator1 = "ProvisioningAccount#HISTORY_UPDATE_STATUS_FIELD_NAME_BY_KEYWORDS", value1 = ${value})) {
						fail("History entry field ${field} of value ${value} is not present.");
					}
				}
				else if (${field} == "Update Field Original Value") {
					while ((IsElementNotPresent(locator1 = "ProvisioningAccount#HISTORY_UPDATE_STATUS_FIELD_ORIGINAL_VALUE_BY_KEYWORDS", value1 = ${value})) && (IsElementNotPresent(locator1 = "ProvisioningAccount#HISTORY_NEXT_PAGE_DISABLED"))) {
						ProvisioningAccount.clickHistoryNextPage();
					}

					if (IsElementNotPresent(locator1 = "ProvisioningAccount#HISTORY_UPDATE_STATUS_FIELD_ORIGINAL_VALUE_BY_KEYWORDS", value1 = ${value})) {
						fail("History entry field ${field} of value ${value} is not present.");
					}
				}
				else if (${field} == "Update Field New Value") {
					while ((IsElementNotPresent(locator1 = "ProvisioningAccount#HISTORY_UPDATE_STATUS_FIELD_NEW_VALUE_BY_KEYWORDS", value1 = ${value})) && (IsElementNotPresent(locator1 = "ProvisioningAccount#HISTORY_NEXT_PAGE_DISABLED"))) {
						ProvisioningAccount.clickHistoryNextPage();
					}

					if (IsElementNotPresent(locator1 = "ProvisioningAccount#HISTORY_UPDATE_STATUS_FIELD_NEW_VALUE_BY_KEYWORDS", value1 = ${value})) {
						fail("History entry field ${field} of value ${value} is not present.");
					}
				}
				else {
					fail("No such history entry field ${field}");
				}
			}
			else {
				if (${field} == "Update Description") {
					while ((IsElementNotPresent(locator1 = "ProvisioningAccount#HISTORY_UPDATE_DESCRIPTION_BY_KEYWORDS", value1 = ${value})) && (IsElementNotPresent(locator1 = "ProvisioningAccount#HISTORY_NEXT_PAGE_DISABLED"))) {
						ProvisioningAccount.clickHistoryNextPage();
					}

					if (IsElementNotPresent(locator1 = "ProvisioningAccount#HISTORY_UPDATE_DESCRIPTION_BY_KEYWORDS", value1 = ${value})) {
						fail("History entry field ${field} of value ${value} is not present.");
					}
				}
				else if (${field} == "Update Field Name") {
					while ((IsElementNotPresent(locator1 = "ProvisioningAccount#HISTORY_UPDATE_FIELD_NAME_BY_KEYWORDS", value1 = ${value})) && (IsElementNotPresent(locator1 = "ProvisioningAccount#HISTORY_NEXT_PAGE_DISABLED"))) {
						ProvisioningAccount.clickHistoryNextPage();
					}

					if (IsElementNotPresent(locator1 = "ProvisioningAccount#HISTORY_UPDATE_FIELD_NAME_BY_KEYWORDS", value1 = ${value})) {
						fail("History entry field ${field} of value ${value} is not present.");
					}
				}
				else if (${field} == "Update Field Original Value") {
					while ((IsElementNotPresent(locator1 = "ProvisioningAccount#HISTORY_UPDATE_FIELD_ORIGINAL_VALUE_BY_KEYWORDS", value1 = ${value})) && (IsElementNotPresent(locator1 = "ProvisioningAccount#HISTORY_NEXT_PAGE_DISABLED"))) {
						ProvisioningAccount.clickHistoryNextPage();
					}

					if (IsElementNotPresent(locator1 = "ProvisioningAccount#HISTORY_UPDATE_FIELD_ORIGINAL_VALUE_BY_KEYWORDS", value1 = ${value})) {
						fail("History entry field ${field} of value ${value} is not present.");
					}
				}
				else if (${field} == "Update Field New Value") {
					var key_newValue = ${value};

					while ((IsElementNotPresent(locator1 = "ProvisioningAccount#HISTORY_UPDATE_FIELD_NEW_VALUE_BY_KEYWORD", value1 = ${value})) && (IsElementNotPresent(locator1 = "ProvisioningAccount#HISTORY_NEXT_PAGE_DISABLED"))) {
						ProvisioningAccount.clickHistoryNextPage();
					}

					if (IsElementNotPresent(locator1 = "ProvisioningAccount#HISTORY_UPDATE_FIELD_NEW_VALUE_BY_KEYWORD", value1 = ${value})) {
						fail("History entry field ${field} of value ${value} is not present.");
					}
				}
				else {
					fail("No such history entry field ${field}");
				}
			}
		}
	}

