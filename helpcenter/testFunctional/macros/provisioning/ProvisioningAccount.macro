	macro clickSyncToCustomerPortalButton {
		var CPSyncSuccess = "false";

		while ((${CPSyncSuccess} == "false") && (maxIterations = "35")) {
			Click(locator1 = "ProvisioningAccount#ACCOUNT_SYNC_TO_CUSTOMER_PORTAL_BUTTON");

			OSBAdmin.pause(timeInSeconds = ${pollIntervalInSeconds});

			if (IsElementPresent(locator1 = "Message#SUCCESS_MESSAGE")) {
				Message.success();

				var CPSyncSuccess = "true";
			}
			else {
				var CPSyncSuccess = "false";
			}

			echo("Customer Portal Sync Success: ${CPSyncSuccess}");
		}

		if (${CPSyncSuccess} == "false") {
			fail("After ${currentIteration} checks, the provisioning Sync To Customer Portal process may have failed.");
		}
	}

	macro clickSyncToZendeskButton {
		var currentIteration = 0;

		Click(locator1 = "ProvisioningAccount#ACCOUNT_SYNC_TO_ZENDESK_BUTTON");

		OSBAdmin.pause(timeInSeconds = ${pollIntervalInSeconds});

		if (IsElementPresent(locator1 = "Message#SUCCESS_MESSAGE")) {
			Message.success();

			var zendeskSyncSuccess = "true";
		}
		else {
			var zendeskSyncSuccess = "false";
		}

		echo("Zendesk Sync Success: ${zendeskSyncSuccess}");

		while ((${currentIteration} != ${pollMaximumIterations}) && (${zendeskSyncSuccess} == "false")) {
			var currentIteration = ${currentIteration} + 1;

			OSBAdmin.pause(timeInSeconds = ${pollIntervalInSeconds});

			Click(locator1 = "ProvisioningAccount#ACCOUNT_SYNC_TO_ZENDESK_BUTTON");

			OSBAdmin.pause(timeInSeconds = ${pollIntervalInSeconds});

			if (IsElementPresent(locator1 = "Message#SUCCESS_MESSAGE")) {
				Message.success();

				var zendeskSyncSuccess = "true";
			}
			else {
				var zendeskSyncSuccess = "false";
			}

			echo("Zendesk Sync Success: ${zendeskSyncSuccess}");
		}

		if (${zendeskSyncSuccess} == "false") {
			fail("After ${currentIteration} checks, the provisioning Sync To Zendesk process may have failed.");
		}
	}

