definition {

	var pollIntervalInSeconds = PropsUtil.get("osb.to.zendesk.sync.poll.interval.in.seconds");
	var pollMaximumIterations = PropsUtil.get("osb.to.zendesk.sync.poll.maximum.iterations");
	var provisioningURL = PropsUtil.get("provisioning.liferay.url");

	macro _viewAccountContact {
		var key_contactEmailAddress = ${emailAddress};
		var rawTable = TableUtil.newTable(${table});

		for (var row : table ${rawTable}) {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if (${field} == "Name") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#CONTACT_NAME",
					value1 = ${value});
			}
			else if (${field} == "Email Address") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#CONTACT_EMAIL_ADDRESS",
					value1 = ${value});
			}
			else if (${field} == "Role") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#CONTACT_ROLE",
					value1 = ${value});
			}
			else if (${field} == "User Status") {
				AssertTextEquals(
					locator1 = "ProvisioningAccount#CONTACT_USER_STATUS",
					value1 = ${value});
			}
			else {
				fail("No such contact field ${field}");
			}
		}
	}

	macro _viewAccountDetails {
		var rawTable = TableUtil.newTable(${table});

		for (var row : table ${rawTable}) {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if (${field} == "Name") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#ACCOUNT_HEADER",
					value1 = ${value});
			}
			else if (${field} == "Code") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#ACCOUNT_HEADER",
					value1 = ${value});
			}
			else if (${field} == "State") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#ACCOUNT_STATE",
					value1 = ${value});
			}
			else if (${field} == "Support Region") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#ACCOUNT_SUPPORT_REGION",
					value1 = ${value});
			}
			else if (${field} == "Country") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#ACCOUNT_COUNTRY",
					value1 = ${value});
			}
			else if (${field} == "SLA") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#ACCOUNT_SLA",
					value1 = ${value});
			}
			else if (${field} == "Tier") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#ACCOUNT_TIER",
					value1 = ${value});
			}
			else if (${field} == "EWSA") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#ACCOUNT_EWSA",
					value1 = ${value});
			}
			else if (${field} == "Support Seats") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#ACCOUNT_SUPPORT_SEATS",
					value1 = ${value});
			}
			else if (${field} == "FLS Partner") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#ACCOUNT_FLS_PARTNER",
					value1 = ${value});
			}
			else if (${field} == "Primary Contact") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#ACCOUNT_PRIMARY_CONTACT",
					value1 = ${value});
			}
			else {
				fail("No such account detail field ${field}");
			}
		}
	}

	macro _viewAccountDetailsViaDetailsTab {
		var rawTable = TableUtil.newTable(${table});

		for (var row : table ${rawTable}) {
			var field = "${row[0]}";
			var value = "${row[1]}";
			var positionValue = "${row[2]}";
			var key_field = ${field};

			if (${positionValue} == "") {
				var key_positionValue = 1;
			}
			else {
				var key_positionValue = ${positionValue};
			}

			AssertElementPresent(locator1 = "ProvisioningAccount#ACCOUNT_DETAILS_FIELD_LABEL");

			if ((${field} == "Permanent Licenses") || (${field} == "Self Provisioning") || (${field} == "Complimentary") || (${field} == "Primary")) {
				if (${value} == "true") {
					AssertElementPresent(locator1 = "ProvisioningAccount#ACCOUNT_DETAILS_FIELD_VALUE_TOGGLE_SWITCH_ON");
				}
				else {
					AssertElementPresent(locator1 = "ProvisioningAccount#ACCOUNT_DETAILS_FIELD_VALUE_TOGGLE_SWITCH_OFF");
				}
			}
			else if ((IsElementPresent(locator1 = "ProvisioningAccount#ACCOUNT_DETAILS_FIELD_VALUE_EDITABLE")) && (${field} != "State")) {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#ACCOUNT_DETAILS_FIELD_VALUE_EDITABLE",
					value1 = ${value});
			}
			else if (${field} == "OEM Instructions") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#ACCOUNT_DETAILS_FIELD_VALUE_LINK",
					value1 = ${value});
			}
			else if (${field} == "State") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#ACCOUNT_DETAILS_FIELD_VALUE_LABEL",
					value1 = ${value});
			}
			else {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#ACCOUNT_DETAILS_FIELD_VALUE",
					value1 = ${value});
			}
		}
	}

