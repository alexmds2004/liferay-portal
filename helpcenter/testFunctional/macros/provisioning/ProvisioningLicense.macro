	macro _viewLicenseViaDownloadLicensePage {
		var key_licenseKeyword = ${licenseKeyword};

		AssertElementPresent(locator1 = "ProvisioningLicenseDownloadLicense#LICENSE_ROW");

		var rawTable = TableUtil.newTable(${table});

		for (var row : table ${rawTable}) {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if (${field} == "Name") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningLicenseDownloadLicense#LICENSE_NAME",
					value1 = ${value});
			}
			else if (${field} == "Description") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningLicenseDownloadLicense#LICENSE_DESCRIPTION",
					value1 = ${value});
			}
			else if (${field} == "Product") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningLicenseDownloadLicense#LICENSE_PRODUCT",
					value1 = ${value});
			}
			else if (${field} == "Version") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningLicenseDownloadLicense#LICENSE_VERSION",
					value1 = ${value});
			}
			else if (${field} == "Type") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningLicenseDownloadLicense#LICENSE_TYPE",
					value1 = ${value});
			}
			else if (${field} == "Start Date") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningLicenseDownloadLicense#LICENSE_START_DATE",
					value1 = ${value});
			}
			else if (${field} == "Expiration Date") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningLicenseDownloadLicense#LICENSE_EXPIRATION_DATE",
					value1 = ${value});
			}
			else if (${field} == "Host Name") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningLicenseDownloadLicense#LICENSE_HOST_NAME",
					value1 = ${value});
			}
			else if (${field} == "IP Addresses") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningLicenseDownloadLicense#LICENSE_IP_ADDRESSES",
					value1 = ${value});
			}
			else if (${field} == "MAC Addresses") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningLicenseDownloadLicense#LICENSE_MAC_ADDRESSES",
					value1 = ${value});
			}
			else if (${field} == "Status") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningLicenseDownloadLicense#LICENSE_STATUS",
					value1 = ${value});
			}
			else {
				fail("No such download license field ${field}");
			}
		}
	}

	macro _viewNoLicenseViaDownloadLicensePage {
		var key_licenseKeyword = ${licenseKeyword};

		AssertElementNotPresent(locator1 = "ProvisioningLicenseDownloadLicense#LICENSE_ROW");
	}

	macro assertDownloadedLicensePresent {
		var downloadedFileName = ProvisioningLicense.formatLicenseFileName(
			fileType = ${fileType},
			table = ${table});

		echo("Expected file name: ${downloadedFileName}");

		var tempDir = PropsUtil.get("output.dir.name");

		var downloadedFilePath = "${tempDir}/${downloadedFileName}";

		var fileExists = FileUtil.exists(${downloadedFilePath});

		if (${fileExists} == "true") {
			echo("File named ${downloadedFileName} was downloaded.");
		}
		else {
			echo("File named ${downloadedFileName} may not have been downloaded. Will check for license file with inverted file name.");

			var downloadedInvertedFileName = ProvisioningLicense.formatInvertedLicenseFileName(
				fileType = ${fileType},
				table = ${table});

			echo("Trying to find file named: ${downloadedInvertedFileName}");

			var downloadedFilePath = "${tempDir}/${downloadedInvertedFileName}";

			var fileExists = FileUtil.exists(${downloadedFilePath});

			if (${fileExists} == "true") {
				echo("File named ${downloadedInvertedFileName} was downloaded.");
			}
			else {
				fail("Files named ${downloadedFileName} and ${downloadedInvertedFileName} NOT FOUND in folder ${tempDir}!");
			}
		}
	}

