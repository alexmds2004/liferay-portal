	macro downloadLicenseViaDownloadLicensePage {
		var licenseKeyIdList = "";
		var rawTable = TableUtil.newTable(${table});

		for (var row : table ${rawTable}) {
			var licenseKeyId = "${row[0]}";

			if (${licenseKeyIdList} == "") {
				var licenseKeyIdList = ${licenseKeyId};
			}
			else {
				var licenseKeyIdList = "${licenseKeyIdList},${licenseKeyId}";
			}
		}

		var key_licenseKeyIdList = ${licenseKeyIdList};

		Click(locator1 = "ProvisioningLicenseDownloadLicense#DOWNLOAD_BUTTON");

		DownloadTempFile();
	}

	macro formatInvertedLicenseFileName {
		var rawTable = TableUtil.newTable(${table});
		var licenseType = "";
		var product = "";
		var version = "";
		var licenseName = "";
		var copy = "";

		for (var row : table ${rawTable}) {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if (${field} == "License Type") {
				var licenseType = "${value}-";
			}
			else if (${field} == "Product") {
				if (${product} == "") {
					var product = "${value}-";
				}
				else {
					var product = "${product}${value}-";
				}
			}
			else if (${field} == "Version") {
				var version = "${value}-";
			}
			else if (${field} == "License Name") {
				if (${licenseName} == "") {
					var licenseName = ${value};
				}
				else {
					var licenseName = "${value}-${licenseName}";
				}
			}
			else if (${field} == "Copy") {
				var copy = " (${value})";
			}
			else {
				fail("No such field ${field} required!");
			}
		}

		var downloadedFileName = "${licenseType}${product}${version}${licenseName}";

		var downloadedFileName = StringUtil.toLowerCase(${downloadedFileName});

		var downloadedFileName = StringUtil.replace(${downloadedFileName}, " ", "");

		var downloadedFileName = "${downloadedFileName}${copy}.${fileType}";

		if (isSet(staticDownloadedListName)) {
			static var staticDownloadedListName = "${staticDownloadedListName},${downloadedFileName}";
		}
		else {
			static var staticDownloadedListName = ${downloadedFileName};
		}

		return ${staticDownloadedListName};

		return ${downloadedFileName};
	}

	macro formatLicenseFileName {
		var rawTable = TableUtil.newTable(${table});
		var licenseType = "";
		var product = "";
		var version = "";
		var licenseName = "";
		var copy = "";

		for (var row : table ${rawTable}) {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if (${field} == "License Type") {
				var licenseType = "${value}-";
			}
			else if (${field} == "Product") {
				if (${product} == "") {
					var product = "${value}-";
				}
				else {
					var product = "${product}${value}-";
				}
			}
			else if (${field} == "Version") {
				var version = "${value}-";
			}
			else if (${field} == "License Name") {
				if (${licenseName} == "") {
					var licenseName = ${value};
				}
				else {
					var licenseName = "${licenseName}-${value}";
				}
			}
			else if (${field} == "Copy") {
				var copy = " (${value})";
			}
			else {
				fail("No such field ${field} required!");
			}
		}

		var downloadedFileName = "${licenseType}${product}${version}${licenseName}";

		var downloadedFileName = StringUtil.toLowerCase(${downloadedFileName});

		var downloadedFileName = StringUtil.replace(${downloadedFileName}, " ", "");

		var downloadedFileName = "${downloadedFileName}${copy}.${fileType}";

		if (isSet(staticDownloadedListName)) {
			static var staticDownloadedListName = "${staticDownloadedListName},${downloadedFileName}";
		}
		else {
			static var staticDownloadedListName = ${downloadedFileName};
		}

		return ${staticDownloadedListName};

		return ${downloadedFileName};
	}

