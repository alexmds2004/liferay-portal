	macro populateExtendLicenseFormViaPosition {
		var rawTable = TableUtil.newTable(${table});
		var key_positionValue = ${positionValue};

		for (var row : table ${rawTable}) {
			var key_product = "${row[0]}";
			var field = "${row[1]}";
			var value = "${row[2]}";

			if (${field} == "Subscription Term") {
				Select(
					locator1 = "ProvisioningLicenseExtend#SUBSCRIPTION_TERM_SELECT",
					value1 = ${value});
			}
			else if (${field} == "Start Date") {
				if (contains(${value}, ",")) {
					Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningLicenseExtend#START_DATE_PICKER_DROPDOWN_BUTTON_POSITION");

					var month = StringUtil.extractFirst(${value}, " ");

					var fullMonth = KoroneikiProductPurchaseAPI._getFullMonthName(month = ${month});
					var year = StringUtil.extractLast(${value}, " ");
					var day = StringUtil.replace(${value}, "${month} ", "");

					var day = StringUtil.replace(${day}, ", ${year}", "");

					var singleDigitDay = StringUtil.startsWith(${day}, 0);

					if (${singleDigitDay} == "true") {
						var day = StringUtil.replace(${day}, 0, "");
					}

					Select(
						locator1 = "ProvisioningLicenseExtend#CALENDAR_DATE_PICKER_MONTH_SELECT",
						value1 = ${fullMonth});

					Select(
						locator1 = "ProvisioningLicenseExtend#CALENDAR_DATE_PICKER_YEAR_SELECT",
						value1 = ${year});

					var key_day = ${day};

					Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningLicenseExtend#CALENDAR_DATE_PICKER_DAY_BUTTON");

					Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningLicenseExtend#START_DATE_PICKER_DROPDOWN_BUTTON_POSITION");
				}
				else {
					Click.pauseMakeVisibleClickAt(
						locator1 = "ProvisioningLicenseExtend#START_DATE_FIELD_POSITION",
						value1 = ${value});

					Type(
						locator1 = "ProvisioningLicenseExtend#START_DATE_FIELD_POSITION",
						value1 = ${value});

					KeyPress(
						locator1 = "ProvisioningLicenseExtend#START_DATE_FIELD_POSITION",
						value1 = "\RETURN");
				}
			}
			else if (${field} == "Expiration Date") {
				if (contains(${value}, ",")) {
					Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningLicenseExtend#EXPIRATION_DATE_PICKER_DROPDOWN_BUTTON_POSITION");

					var month = StringUtil.extractFirst(${value}, " ");

					var fullMonth = KoroneikiProductPurchaseAPI._getFullMonthName(month = ${month});
					var year = StringUtil.extractLast(${value}, " ");
					var day = StringUtil.replace(${value}, "${month} ", "");

					var day = StringUtil.replace(${day}, ", ${year}", "");

					var singleDigitDay = StringUtil.startsWith(${day}, 0);

					if (${singleDigitDay} == "true") {
						var day = StringUtil.replace(${day}, 0, "");
					}

					Select(
