definition {

	var provisioningURL = PropsUtil.get("provisioning.liferay.url");

	macro _viewNoSubscriptionLicense {
		var key_licenseKeyword = ${licenseKeyword};

		AssertElementNotPresent(locator1 = "ProvisioningSubscription#LICENSE_ROW");
	}

	macro _viewSubscriptionDetails {
		var rawTable = TableUtil.newTable(${table});

		for (var row : table ${rawTable}) {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if (${field} == "Name") {
				AssertTextEquals(
					locator1 = "ProvisioningSubscription#SUBSCRIPTION_HEADER",
					value1 = ${value});
			}
			else if (${field} == "State") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningSubscription#SUBSCRIPTION_STATE",
					value1 = ${value});
			}
			else if (${field} == "Instance Size") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningSubscription#SUBSCRIPTION_INSTANCE_SIZE",
					value1 = ${value});
			}
			else if (${field} == "Support Life") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningSubscription#SUBSCRIPTION_SUPPORT_LIFE",
					value1 = ${value});
			}
			else if (${field} == "Grace Period") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningSubscription#SUBSCRIPTION_GRACE_PERIOD",
					value1 = ${value});
			}
			else if (${field} == "Provisioned") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningSubscription#SUBSCRIPTION_PROVISIONED",
					value1 = ${value});
			}
			else if (${field} == "Purchased") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningSubscription#SUBSCRIPTION_PURCHASED",
					value1 = ${value});
			}
			else {
				fail("No such subscription detail field ${field}");
			}
		}
	}

	macro _viewSubscriptionLicense {
		var key_licenseKeyword = ${licenseKeyword};

		AssertElementPresent(locator1 = "ProvisioningSubscription#LICENSE_ROW");

		var rawTable = TableUtil.newTable(${table});

		for (var row : table ${rawTable}) {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if (${field} == "Name") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningSubscription#LICENSE_NAME",
					value1 = ${value});
			}
			else if (${field} == "Description") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningSubscription#LICENSE_DESCRIPTION",
					value1 = ${value});
			}
			else if (${field} == "Expiration Date") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningSubscription#LICENSE_EXPIRATION_DATE",
					value1 = ${value});
			}
			else if (${field} == "Product") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningSubscription#LICENSE_PRODUCT",
					value1 = ${value});
			}
			else if (${field} == "Type") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningSubscription#LICENSE_TYPE",
					value1 = ${value});
			}
			else if (${field} == "Details") {
				var key_label = StringUtil.extractFirst(${value}, ":");

				var key_label = StringUtil.trim(${key_label});
				var value = StringUtil.extractLast(${value}, ":");

				var value = StringUtil.trim(${value});

				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningSubscription#LICENSE_DETAILS",
					value1 = ${value});
			}
			else if (${field} == "Status") {
				AssertTextEquals(
					locator1 = "ProvisioningSubscription#LICENSE_STATUS",
					value1 = ${value});
			}
			else if (${field} == "Complimentary") {
				if (${value} == "true") {
					AssertElementPresent(
						locator1 = "ProvisioningSubscription#LICENSE_COMPLIMENTARY_CHECKED",
						value1 = ${value});
				}
				else {
					AssertElementPresent(
						locator1 = "ProvisioningSubscription#LICENSE_COMPLIMENTARY_NOT_CHECKED",
						value1 = ${value});
				}
			}
			else {
				fail("No such subscription license field ${field}");
			}
		}
	}

	macro _viewSubscriptionTerm {
		var key_startDateEndDate = ${startDateEndDate};
		var rawTable = TableUtil.newTable(${table});

		for (var row : table ${rawTable}) {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if (${field} == "Start - End Date") {
				AssertTextEquals(
					locator1 = "ProvisioningSubscription#TERM_START_END_DATE",
					value1 = ${value});
			}
			else if (${field} == "Grace Period") {
				AssertTextEquals(
					locator1 = "ProvisioningSubscription#TERM_GRACE_PERIOD",
					value1 = ${value});
			}
			else if (${field} == "Provisioned") {
				AssertTextEquals(
					locator1 = "ProvisioningSubscription#TERM_PROVISIONED",
					value1 = ${value});
			}
			else if (${field} == "Purchased") {
				AssertTextEquals(
					locator1 = "ProvisioningSubscription#TERM_PURCHASED",
					value1 = ${value});
			}
			else if (${field} == "Salesforce Opportunity Key") {
				AssertTextEquals(
					locator1 = "ProvisioningSubscription#TERM_SALESFORCE_OPPORTUNITY_KEY",
					value1 = ${value});
			}
			else if (${field} == "Instance Size") {
				AssertTextEquals(
					locator1 = "ProvisioningSubscription#TERM_INSTANCE_SIZE",
					value1 = ${value});
			}
			else if (${field} == "State") {
				AssertTextEquals(
					locator1 = "ProvisioningSubscription#TERM_STATE",
					value1 = ${value});
			}
			else {
				fail("No such subscription term field ${field}");
			}
		}
	}

	macro clickGenerateLicenseButton {
		Click(locator1 = "ProvisioningSubscription#GENERATE_LICENSE_BUTTON");
	}

	macro clickLicensesActionDropdownButton {
		Click(locator1 = "ProvisioningSubscription#LICENSE_ALL_ACTION_BUTTON");

		var key_action = ${action};

		if (${action} == "Deactivate") {
			ClickNoError(locator1 = "ProvisioningSubscription#LICENSE_ALL_DROPDOWN_ACTION_BUTTON");

			Confirm(value1 = "Are you sure you want to deactivate the license key(s)?");
		}
		else if (${action} == "Activate") {
			ClickNoError(locator1 = "ProvisioningSubscription#LICENSE_ALL_DROPDOWN_ACTION_BUTTON");

			Confirm(value1 = "Are you sure you want to activate the license key(s)?");
		}
		else if (${action} == "Make Complimentary") {
			ClickNoError(locator1 = "ProvisioningSubscription#LICENSE_ALL_DROPDOWN_ACTION_BUTTON");

			Confirm(value1 = "Are you sure you want to make the license key(s) complimentary?");
		}
		else if (${action} == "Remove Complimentary") {
			ClickNoError(locator1 = "ProvisioningSubscription#LICENSE_ALL_DROPDOWN_ACTION_BUTTON");

			Confirm(value1 = "Are you sure you want to proceed? The license key(s) will no longer be complimentary.");
		}
		else {
			Click(locator1 = "ProvisioningSubscription#LICENSE_ALL_DROPDOWN_ACTION_BUTTON");
		}
	}

	macro clickLicensesDownloadButton {
		Click(locator1 = "ProvisioningSubscription#LICENSE_ALL_DOWNLOAD_BUTTON");
	}

	macro clickLicensesExtendButton {
		Click(locator1 = "ProvisioningSubscription#LICENSE_ALL_EXTEND_BUTTON");
	}

	macro clickLicensesReplaceButton {
		Click(locator1 = "ProvisioningSubscription#LICENSE_ALL_REPLACE_BUTTON");
	}

	macro clickSubscriptionFormCancelButton {
		Click(locator1 = "ProvisioningSubscriptionForm#CANCEL_BUTTON");
	}

	macro clickSubscriptionFormNextButton {
		Click(locator1 = "ProvisioningSubscriptionForm#NEXT_BUTTON");
	}

	macro clickSubscriptionFormSaveButton {
		Click(locator1 = "ProvisioningSubscriptionForm#SAVE_BUTTON");
	}

	macro clickSubscriptionFormSelectButton {
		Click(locator1 = "ProvisioningSubscriptionForm#SELECT_BUTTON");
	}

	macro clickSubscriptionProvisionedLink {
		Click(locator1 = "ProvisioningSubscription#SUBSCRIPTION_PROVISIONED");
	}

	macro clickSubscriptionTermActionDropdownButton {
		var key_startDateEndDate = ${startDateEndDate};

		Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningSubscription#TERM_ACTION_BUTTON");

		var key_action = ${action};

		Click(locator1 = "ProvisioningSubscription#TERM_DROPDOWN_ACTION_BUTTON");
	}

	macro clickSubscriptionTermProvisionedLink {
		var key_startDateEndDate = ${startDateEndDate};

		Click(locator1 = "ProvisioningSubscription#SUBSCRIPTION_PROVISIONED");
	}

	macro populateExtendAllActiveSubscriptionsForm {
		var rawTable = TableUtil.newTable(${table});

		for (var row : table ${rawTable}) {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if (${field} == "Grace Period End Date") {
				if (contains(${value}, ",")) {
					Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningSubscriptionExtend#GRACE_PERIOD_END_DATE_PICKER_DROPDOWN_BUTTON");

					var month = StringUtil.extractFirst(${value}, " ");

					var fullMonth = KoroneikiProductPurchaseAPI._getFullMonthName(month = ${month});
					var year = StringUtil.extractLast(${value}, " ");
					var day = StringUtil.replace(${value}, "${month} ", "");

					var day = StringUtil.replace(${day}, ", ${year}", "");

					var singleDigitDay = StringUtil.startsWith(${day}, 0);

					if (${singleDigitDay} == "true") {
						var day = StringUtil.replace(${day}, 0, "");
					}

					Select(
						locator1 = "ProvisioningSubscriptionExtend#CALENDAR_DATE_PICKER_MONTH_SELECT",
						value1 = ${fullMonth});

					Select(
						locator1 = "ProvisioningSubscriptionExtend#CALENDAR_DATE_PICKER_YEAR_SELECT",
						value1 = ${year});

					var key_day = ${day};

					Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningSubscriptionExtend#CALENDAR_DATE_PICKER_DAY_BUTTON");

					Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningSubscriptionExtend#GRACE_PERIOD_END_DATE_PICKER_DROPDOWN_BUTTON");
				}
				else {
					Click.pauseMakeVisibleClickAt(
						locator1 = "ProvisioningSubscriptionExtend#GRACE_PERIOD_END_DATE_FIELD",
						value1 = ${value});

					Type(
						locator1 = "ProvisioningSubscriptionExtend#GRACE_PERIOD_END_DATE_FIELD",
						value1 = ${value});

					KeyPress(
						locator1 = "ProvisioningSubscriptionExtend#GRACE_PERIOD_END_DATE_FIELD",
						value1 = "\RETURN");
				}
			}
			else {
				fail("No such extend license field ${field}.");
			}
		}
	}

	macro populateSubscriptionForm {
		var rawTable = TableUtil.newTable(${table});

		for (var row : table ${rawTable}) {
			var product = "${row[0]}";
			var field = "${row[1]}";
			var value = "${row[2]}";
			var key_entityName = ${product};

			if (${field} == "Subscription Term") {
				Select(
					locator1 = "ProvisioningSubscriptionForm#SUBSCRIPTION_TERM_SELECT",
					value1 = ${value});
			}
			else if (${field} == "Salesforce Opportunity Key") {
				if (${product} == "Bulk Input") {
					if (${value} == "") {
						Type(
							locator1 = "ProvisioningSubscriptionForm#SALESFORCE_OPPORTUNITY_KEY_BULK_INPUT_BUTTON",
							value1 = "");

						KeyPress(
							locator1 = "ProvisioningSubscriptionForm#SALESFORCE_OPPORTUNITY_KEY_BULK_INPUT_BUTTON",
							value1 = "\SPACE");

						KeyPress(
							locator1 = "ProvisioningSubscriptionForm#SALESFORCE_OPPORTUNITY_KEY_BULK_INPUT_BUTTON",
							value1 = "\BACK_SPACE");
					}
					else {
						Type(
							locator1 = "ProvisioningSubscriptionForm#SALESFORCE_OPPORTUNITY_KEY_BULK_INPUT_BUTTON",
							value1 = ${value});
					}
				}
				else {
					if (${value} == "") {
						Type(
							locator1 = "ProvisioningSubscriptionForm#SALESFORCE_OPPORTUNITY_KEY_FIELD",
							value1 = "");

						KeyPress(
							locator1 = "ProvisioningSubscriptionForm#SALESFORCE_OPPORTUNITY_KEY_FIELD",
							value1 = "\SPACE");

						KeyPress(
							locator1 = "ProvisioningSubscriptionForm#SALESFORCE_OPPORTUNITY_KEY_FIELD",
							value1 = "\BACK_SPACE");
					}
					else {
						Type(
							locator1 = "ProvisioningSubscriptionForm#SALESFORCE_OPPORTUNITY_KEY_FIELD",
							value1 = ${value});
					}
				}
			}
			else if (${field} == "Purchased") {
				Type(
					locator1 = "ProvisioningSubscriptionForm#PURCHASED_FIELD",
					value1 = ${value});
			}
			else if (${field} == "Perpetual") {
				AssertElementPresent(locator1 = "ProvisioningSubscriptionForm#PERPETUAL_CHECBOX");

				if (${value} == "true") {
					if (IsNotChecked(locator1 = "ProvisioningSubscriptionForm#PERPETUAL_CHECBOX")) {
						Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningSubscriptionForm#PERPETUAL_CHECBOX");
					}

					if (IsElementPresent(locator1 = "ProvisioningSubscriptionForm#START_DATE_FIELD")) {
						AssertVisible(locator1 = "ProvisioningSubscriptionForm#START_DATE_FIELD_DISABLED");
					}

					if (IsElementPresent(locator1 = "ProvisioningSubscriptionForm#END_DATE_FIELD")) {
						AssertVisible(locator1 = "ProvisioningSubscriptionForm#END_DATE_FIELD_DISABLED");
					}

					if (IsElementPresent(locator1 = "ProvisioningSubscriptionForm#GRACE_PERIOD_FIELD")) {
						AssertVisible(locator1 = "ProvisioningSubscriptionForm#GRACE_PERIOD_FIELD_DISABLED");
					}
				}
				else {
					if (IsChecked(locator1 = "ProvisioningSubscriptionForm#PERPETUAL_CHECBOX")) {
						Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningSubscriptionForm#PERPETUAL_CHECBOX");
					}

					if (IsElementPresent(locator1 = "ProvisioningSubscriptionForm#START_DATE_FIELD")) {
						AssertElementNotPresent(locator1 = "ProvisioningSubscriptionForm#START_DATE_FIELD_DISABLED");
					}

					if (IsElementPresent(locator1 = "ProvisioningSubscriptionForm#END_DATE_FIELD")) {
						AssertElementNotPresent(locator1 = "ProvisioningSubscriptionForm#END_DATE_FIELD_DISABLED");
					}

					if (IsElementPresent(locator1 = "ProvisioningSubscriptionForm#GRACE_PERIOD_FIELD")) {
						AssertElementNotPresent(locator1 = "ProvisioningSubscriptionForm#GRACE_PERIOD_FIELD_DISABLED");
					}
				}
			}
			else if (${field} == "Start Date") {
				if (contains(${value}, ",")) {
					Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningSubscriptionForm#START_DATE_PICKER_DROPDOWN_BUTTON");

					var month = StringUtil.extractFirst(${value}, " ");

					var fullMonth = KoroneikiProductPurchaseAPI._getFullMonthName(month = ${month});
					var year = StringUtil.extractLast(${value}, " ");
					var day = StringUtil.replace(${value}, "${month} ", "");

					var day = StringUtil.replace(${day}, ", ${year}", "");

					var singleDigitDay = StringUtil.startsWith(${day}, 0);

					if (${singleDigitDay} == "true") {
						var day = StringUtil.replace(${day}, 0, "");
					}

					Select(
						locator1 = "ProvisioningSubscriptionForm#CALENDAR_DATE_PICKER_MONTH_SELECT",
						value1 = ${fullMonth});

					Select(
						locator1 = "ProvisioningSubscriptionForm#CALENDAR_DATE_PICKER_YEAR_SELECT",
						value1 = ${year});

					var key_day = ${day};

					Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningSubscriptionForm#CALENDAR_DATE_PICKER_DAY_BUTTON");

					Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningSubscriptionForm#START_DATE_PICKER_DROPDOWN_BUTTON");
				}
				else {
					Click.pauseMakeVisibleClickAt(
						locator1 = "ProvisioningSubscriptionForm#START_DATE_FIELD",
						value1 = ${value});

					Type(
						locator1 = "ProvisioningSubscriptionForm#START_DATE_FIELD",
						value1 = ${value});

					KeyPress(
						locator1 = "ProvisioningSubscriptionForm#START_DATE_FIELD",
						value1 = "\RETURN");
				}
			}
			else if (${field} == "End Date") {
				if (contains(${value}, ",")) {
					Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningSubscriptionForm#END_DATE_PICKER_DROPDOWN_BUTTON");

					var month = StringUtil.extractFirst(${value}, " ");

					var fullMonth = KoroneikiProductPurchaseAPI._getFullMonthName(month = ${month});
					var year = StringUtil.extractLast(${value}, " ");
					var day = StringUtil.replace(${value}, "${month} ", "");

					var day = StringUtil.replace(${day}, ", ${year}", "");

					var singleDigitDay = StringUtil.startsWith(${day}, 0);

					if (${singleDigitDay} == "true") {
						var day = StringUtil.replace(${day}, 0, "");
					}

					Select(
						locator1 = "ProvisioningSubscriptionForm#CALENDAR_DATE_PICKER_MONTH_SELECT",
						value1 = ${fullMonth});

					Select(
						locator1 = "ProvisioningSubscriptionForm#CALENDAR_DATE_PICKER_YEAR_SELECT",
						value1 = ${year});

					var key_day = ${day};

					Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningSubscriptionForm#CALENDAR_DATE_PICKER_DAY_BUTTON");

					Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningSubscriptionForm#END_DATE_PICKER_DROPDOWN_BUTTON");
				}
				else {
					Click.pauseMakeVisibleClickAt(
						locator1 = "ProvisioningSubscriptionForm#END_DATE_FIELD",
						value1 = ${value});

					Type(
						locator1 = "ProvisioningSubscriptionForm#END_DATE_FIELD",
						value1 = ${value});

					KeyPress(
						locator1 = "ProvisioningSubscriptionForm#END_DATE_FIELD",
						value1 = "\RETURN");
				}
			}
			else if (${field} == "Instance Size") {
				Select(
					locator1 = "ProvisioningSubscriptionForm#INSTANCE_SIZE_SELECT",
					value1 = ${value});
			}
			else if (${field} == "Grace Period") {
				if (IsElementPresent(locator1 = "ProvisioningSubscriptionForm#GRACE_PERIOD_BUTTON")) {
					Click(locator1 = "ProvisioningSubscriptionForm#GRACE_PERIOD_BUTTON");
				}

				Type(
					locator1 = "ProvisioningSubscriptionForm#GRACE_PERIOD_FIELD",
					value1 = ${value});
			}
			else if (${field} == "Status") {
				Select(
					locator1 = "ProvisioningSubscriptionForm#STATUS_SELECT",
					value1 = ${value});
			}
			else {
				fail("No such editable subscription field ${field}.");
			}
		}
	}

	macro populateSubscriptionFormAndSave {
		ProvisioningSubscription.populateSubscriptionForm(table = ${table});

		Click(locator1 = "ProvisioningSubscriptionForm#SAVE_BUTTON");
	}

	macro populateSubscriptionTermFormAndProceed {
		var rawTable = TableUtil.newTable(${table});

		for (var row : table ${rawTable}) {
			var product = "${row[0]}";
			var term = "${row[1]}";
			var key_entityName = ${product};

			Select(
				locator1 = "ProvisioningSubscriptionForm#SUBSCRIPTION_TERM_SELECT",
				value1 = ${term});
		}

		Click(locator1 = "ProvisioningSubscriptionForm#NEXT_BUTTON");
	}

	macro removeSubscriptionRow {
		var key_entityName = ${productName};

		Click(locator1 = "ProvisioningSubscriptionForm#DELETE_BUTTON");
	}

	macro search {
		Type(
			locator1 = "ProvisioningSubscription#SEARCH_FIELD",
			value1 = ${keyword});

		KeyPress(
			locator1 = "ProvisioningSubscription#SEARCH_FIELD",
			value1 = "\RETURN");
	}

	macro selectAllLicensesViaLicensesTab {
		Check(locator1 = "ProvisioningSubscription#LICENSE_ALL_CHECKBOX");
	}

	macro selectAllProductsViaSubscriptionSelectWindow {
		SelectFrame(locator1 = "ProvisioningSubscriptionSelect#SELECT_IFRAME");

		if (${keyword} != "") {
			Type(
				locator1 = "ProvisioningSubscriptionSelect#SELECT_SEARCH_FIELD",
				value1 = "\"${keyword}\"");

			Click(locator1 = "ProvisioningSubscriptionSelect#SELECT_SEARCH_BUTTON");
		}

		var rawTable = TableUtil.newTable(${table});

		Check(locator1 = "ProvisioningSubscriptionSelect#SELECT_ALL_CHECKBOX");

		SelectFrameTop();

		Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningSubscriptionSelect#DONE_BUTTON");

		while (IsElementPresent(locator1 = "ProvisioningSubscriptionSelect#DONE_BUTTON")) {
			SelectFrame(locator1 = "ProvisioningSubscriptionSelect#SELECT_IFRAME");

			Uncheck(locator1 = "ProvisioningSubscriptionSelect#SELECT_ALL_CHECKBOX");

			Check(locator1 = "ProvisioningSubscriptionSelect#SELECT_ALL_CHECKBOX");

			SelectFrameTop();

			Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningSubscriptionSelect#DONE_BUTTON");
		}
	}

	macro selectLicensesViaLicensesTab {
		var rawTable = TableUtil.newTable(${table});

		for (var row : table ${rawTable}) {
			var licenseKeyword = "${row[0]}";

			var key_licenseKeyword = ${licenseKeyword};

			Check(locator1 = "ProvisioningSubscription#LICENSE_CHECKBOX");
		}
	}

	macro selectProductsViaSubscriptionSelectWindow {
		SelectFrame(locator1 = "ProvisioningSubscriptionSelect#SELECT_IFRAME");

		if (${keyword} != "") {
			Type(
				locator1 = "ProvisioningSubscriptionSelect#SELECT_SEARCH_FIELD",
				value1 = "\"${keyword}\"");

			Click(locator1 = "ProvisioningSubscriptionSelect#SELECT_SEARCH_BUTTON");
		}

		var rawTable = TableUtil.newTable(${table});

		for (var row : table ${rawTable}) {
			var product = "${row[0]}";

			var key_entityName = ${product};

			Check(locator1 = "ProvisioningSubscriptionSelect#ENTITY_CHECKBOX");
		}

		SelectFrameTop();

		Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningSubscriptionSelect#DONE_BUTTON");

		while (IsElementPresent(locator1 = "ProvisioningSubscriptionSelect#DONE_BUTTON")) {
			SelectFrame(locator1 = "ProvisioningSubscriptionSelect#SELECT_IFRAME");

			Uncheck(locator1 = "ProvisioningSubscriptionSelect#ENTITY_CHECKBOX");

			Check(locator1 = "ProvisioningSubscriptionSelect#ENTITY_CHECKBOX");

			SelectFrameTop();

			Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningSubscriptionSelect#DONE_BUTTON");
		}
	}

	macro selectProductViaSubscriptionSelectWindow {
		SelectFrame(locator1 = "ProvisioningSubscriptionSelect#SELECT_IFRAME");

		Type(
			locator1 = "ProvisioningSubscriptionSelect#SELECT_SEARCH_FIELD",
			value1 = "\"${productName}\"");

		Click(locator1 = "ProvisioningSubscriptionSelect#SELECT_SEARCH_BUTTON");

		var key_entityName = ${productName};

		Check(locator1 = "ProvisioningSubscriptionSelect#ENTITY_CHECKBOX");

		SelectFrameTop();

		Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningSubscriptionSelect#DONE_BUTTON");

		while (IsElementPresent(locator1 = "ProvisioningSubscriptionSelect#DONE_BUTTON")) {
			SelectFrame(locator1 = "ProvisioningSubscriptionSelect#SELECT_IFRAME");

			Uncheck(locator1 = "ProvisioningSubscriptionSelect#ENTITY_CHECKBOX");

			Check(locator1 = "ProvisioningSubscriptionSelect#ENTITY_CHECKBOX");

			SelectFrameTop();

			Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningSubscriptionSelect#DONE_BUTTON");
		}
	}

	macro viewDisabledSubscriptionDeleteButton {
		var key_entityName = ${productName};

		AssertVisible(locator1 = "ProvisioningSubscriptionForm#DELETE_BUTTON_DISABLED");
	}

	macro viewDisabledSubscriptionFormSaveButton {
		AssertElementPresent(locator1 = "ProvisioningSubscriptionForm#SAVE_BUTTON_DISABLED");
	}

	macro viewErrorMessage {
		AssertTextEquals.assertPartialText(
			locator1 = "ProvisioningSubscriptionForm#ERROR_MESSAGE",
			value1 = ${errorMessage});
	}

	macro viewNoGenerateLicenseButton {
		AssertElementNotPresent(locator1 = "ProvisioningSubscription#GENERATE_LICENSE_BUTTON");
	}

	macro viewNoLicensesActionDropdownButton {
		Click(locator1 = "ProvisioningSubscription#LICENSE_ALL_ACTION_BUTTON");

		AssertElementNotPresent(locator1 = "ProvisioningSubscription#LICENSE_ALL_DROPDOWN_ACTION_BUTTON");
	}

	macro viewNoLicensesExtendButton {
		AssertElementNotPresent(locator1 = "ProvisioningSubscription#LICENSE_ALL_EXTEND_BUTTON");
	}

	macro viewNoLicensesReplaceButton {
		AssertElementNotPresent(locator1 = "ProvisioningSubscription#LICENSE_ALL_REPLACE_BUTTON");
	}

	macro viewNoSubscriptionTermActionDropdownButton {
		var key_startDateEndDate = ${startDateEndDate};

		AssertElementNotPresent(locator1 = "ProvisioningSubscription#TERM_ACTION_BUTTON");
	}

}