definition {

	property testray.main.component.name = "Support QA";
	property type = "koroneiki";

	tearDown {
		KoroneikiProductAPI._tearDownProductPermissions(productName = "Liferay Digital Experience Platform");

		KoroneikiProductAPI._tearDownProductPermissions(productName = "Liferay Portal Six");

		KoroneikiProductAPI._tearDownProducts(table = '''| Liferay Digital Experience Platform |
	| Liferay Portal Six                  |''');
	}

	test Createproductattemptbynonpermissioneduser {
		KoroneikiProductAPIPermissionCheck._createProductAttempt(table = '''| Name | Liferay Digital Experience Platform | |''');

		KoroneikiProductAPI._viewNoProduct(productName = "Liferay Digital Experience Platform");
	}

	test Createproductexternallinkattemptbynonpermissioneduser {
		KoroneikiProductAPI._createProduct(table = '''| Name | Liferay Digital Experience Platform | |''');

		KoroneikiProductAPIPermissionCheck._createProductExternalLinkAttempt(
			productName = "Liferay Digital Experience Platform",
			table = '''| Domain      | liferaydxp |
	| Entity Id   | 1234       |
	| Entity Name | LiferayDXP |''');

		KoroneikiProductAPI._viewNoProductExternalLink(
			entityId = 1234,
			productName = "Liferay Digital Experience Platform");
	}

	test Removeproductattemptbynewlynonpermissioneduser {
		KoroneikiProductAPI._createProduct(table = '''| Name | Liferay Digital Experience Platform | |''');

		KoroneikiProductAPI._setProductPermissions(
			productName = "Liferay Digital Experience Platform",
			table = '''| Delete | true |''');

		KoroneikiProductAPI._unsetProductPermissions(
			productName = "Liferay Digital Experience Platform",
			table = '''| Delete | true |''');

		KoroneikiProductAPIPermissionCheck._deleteProductAttempt(productName = "Liferay Digital Experience Platform");

		KoroneikiProductAPI._viewProduct(
			productName = "Liferay Digital Experience Platform",
			table = '''| Name | Liferay Digital Experience Platform | |''');

		KoroneikiProductAPIPermissionCheck._viewNoProduct(productName = "Liferay Digital Experience Platform");
	}

	test Removeproductattemptbynonpermissioneduser {
		KoroneikiProductAPI._createProduct(table = '''| Name | Liferay Digital Experience Platform | |''');

		KoroneikiProductAPIPermissionCheck._deleteProductAttempt(productName = "Liferay Digital Experience Platform");

		KoroneikiProductAPI._viewProduct(
			productName = "Liferay Digital Experience Platform",
			table = '''| Name | Liferay Digital Experience Platform | |''');

		KoroneikiProductAPIPermissionCheck._viewNoProduct(productName = "Liferay Digital Experience Platform");
	}

	test Removeproductbypermissioneduser {
		KoroneikiProductAPI._createProduct(table = '''| Name | Liferay Digital Experience Platform | |''');

		KoroneikiProductAPI._setProductPermissions(
			productName = "Liferay Digital Experience Platform",
			table = '''| Delete | true |''');

		KoroneikiProductAPIPermissionCheck._deleteProduct(productName = "Liferay Digital Experience Platform");

		KoroneikiProductAPI._viewNoProduct(productName = "Liferay Digital Experience Platform");
	}

	test Removeproductexternallinkattemptbynonpermissioneduser {
		KoroneikiProductAPI._createProduct(table = '''| Name | Liferay Digital Experience Platform | |''');

		KoroneikiProductAPI._createProductExternalLink(
			productName = "Liferay Digital Experience Platform",
			table = '''| Domain      | liferaydxp |
	| Entity Id   | 1234       |
	| Entity Name | LiferayDXP |''');

		KoroneikiProductAPIPermissionCheck._deleteProductExternalLinkAttempt(
			entityId = 1234,
			productName = "Liferay Digital Experience Platform");

		KoroneikiProductAPI._viewProductExternalLink(
			entityId = 1234,
			productName = "Liferay Digital Experience Platform",
			table = '''| Domain      | liferaydxp |
	| Entity Id   | 1234       |
	| Entity Name | LiferayDXP |''');

		KoroneikiProductAPIPermissionCheck._viewNoProductExternalLink(
			entityId = 1234,
			productName = "Liferay Digital Experience Platform");

		KoroneikiProductAPIPermissionCheck._viewNoProductViaExternalLink(
			domain = "liferaydxp",
			entityId = 1234,
			entityName = "LiferayDXP",
			productName = "Liferay Digital Experience Platform");
	}

	test Setproductpermissionattemptbynewlynonpermissioneduser {
		KoroneikiProductAPI._createProduct(table = '''| Name | Liferay Digital Experience Platform | |''');

		KoroneikiProductAPI._setProductPermissions(
			productName = "Liferay Digital Experience Platform",
			table = '''| Permissions | true |''');

		KoroneikiProductAPI._unsetProductPermissions(
			productName = "Liferay Digital Experience Platform",
			table = '''| Permissions | true |''');

		KoroneikiProductAPIPermissionCheck._setProductPermissionsAttempt(
			productName = "Liferay Digital Experience Platform",
			table = '''| Update | true |
	| View   | true |''');

		KoroneikiProductAPIPermissionCheck.updateProductAttempt(
			productName = "Liferay Digital Experience Platform",
			table = '''| Name | Liferay Portal Six | |''');

		KoroneikiProductAPI._viewProduct(
			productName = "Liferay Digital Experience Platform",
			table = '''| Name | Liferay Digital Experience Platform | |''');

		KoroneikiProductAPI._viewNoProduct(productName = "Liferay Portal Six");

		KoroneikiProductAPIPermissionCheck._viewNoProduct(productName = "Liferay Digital Experience Platform");
	}

	test Setproductpermissionattemptbynonpermissioneduser {
		KoroneikiProductAPI._createProduct(table = '''| Name | Liferay Digital Experience Platform | |''');

		KoroneikiProductAPIPermissionCheck._setProductPermissionsAttempt(
			productName = "Liferay Digital Experience Platform",
			table = '''| Update | true |
	| View   | true |''');

		KoroneikiProductAPIPermissionCheck.updateProductAttempt(
			productName = "Liferay Digital Experience Platform",
			table = '''| Name | Liferay Portal Six | |''');

		KoroneikiProductAPI._viewProduct(
			productName = "Liferay Digital Experience Platform",
			table = '''| Name | Liferay Digital Experience Platform | |''');

		KoroneikiProductAPI._viewNoProduct(productName = "Liferay Portal Six");

		KoroneikiProductAPIPermissionCheck._viewNoProduct(productName = "Liferay Digital Experience Platform");
	}

	test Setproductpermissionsbypermissioneduser {
		KoroneikiProductAPI._createProduct(table = '''| Name | Liferay Digital Experience Platform | |''');

		KoroneikiProductAPI._setProductPermissions(
			productName = "Liferay Digital Experience Platform",
			table = '''| Permissions | true |''');

		KoroneikiProductAPIPermissionCheck._setProductPermissions(
			productName = "Liferay Digital Experience Platform",
			table = '''| Update | true |
	| View   | true |''');

		KoroneikiProductAPIPermissionCheck.updateProduct(
			productName = "Liferay Digital Experience Platform",
			table = '''| Name | Liferay Portal Six | |''');

		KoroneikiProductAPI._viewProduct(
			productName = "Liferay Portal Six",
			table = '''| Name | Liferay Portal Six | |''');

		KoroneikiProductAPI._viewNoProduct(productName = "Liferay Digital Experience Platform");

		KoroneikiProductAPIPermissionCheck._viewProduct(
			productName = "Liferay Portal Six",
			table = '''| Name | Liferay Portal Six | |''');
	}

	test Unsetproductpermissionattemptbynewlynonpermissioneduser {
		KoroneikiProductAPI._createProduct(table = '''| Name | Liferay Digital Experience Platform | |''');

		KoroneikiProductAPI._setProductPermissions(
			productName = "Liferay Digital Experience Platform",
			table = '''| Permissions | true |
	| Update      | true |
	| View        | true |''');

		KoroneikiProductAPI._unsetProductPermissions(
			productName = "Liferay Digital Experience Platform",
			table = '''| Permissions | true |''');

		KoroneikiProductAPIPermissionCheck._unsetProductPermissionsAttempt(
			productName = "Liferay Digital Experience Platform",
			table = '''| Update | true |
	| View   | true |''');

		KoroneikiProductAPIPermissionCheck.updateProduct(
			productName = "Liferay Digital Experience Platform",
			table = '''| Name | Liferay Portal Six | |''');

		KoroneikiProductAPI._viewProduct(
			productName = "Liferay Portal Six",
			table = '''| Name | Liferay Portal Six | |''');

		KoroneikiProductAPI._viewNoProduct(productName = "Liferay Digital Experience Platform");

		KoroneikiProductAPIPermissionCheck._viewProduct(
			productName = "Liferay Portal Six",
			table = '''| Name | Liferay Portal Six | |''');
	}

	test Unsetproductpermissionattemptbynonpermissioneduser {
		KoroneikiProductAPI._createProduct(table = '''| Name | Liferay Digital Experience Platform | |''');

		KoroneikiProductAPI._setProductPermissions(
			productName = "Liferay Digital Experience Platform",
			table = '''| Update | true |
	| View   | true |''');

		KoroneikiProductAPIPermissionCheck._unsetProductPermissionsAttempt(
			productName = "Liferay Digital Experience Platform",
			table = '''| Update | true |
	| View   | true |''');

		KoroneikiProductAPIPermissionCheck.updateProduct(
			productName = "Liferay Digital Experience Platform",
			table = '''| Name | Liferay Portal Six | |''');

		KoroneikiProductAPI._viewProduct(
			productName = "Liferay Portal Six",
			table = '''| Name | Liferay Portal Six | |''');

		KoroneikiProductAPI._viewNoProduct(productName = "Liferay Digital Experience Platform");

		KoroneikiProductAPIPermissionCheck._viewProduct(
			productName = "Liferay Portal Six",
			table = '''| Name | Liferay Portal Six | |''');
	}

	test Unsetproductpermissionsbypermissioneduser {
		KoroneikiProductAPI._createProduct(table = '''| Name | Liferay Digital Experience Platform | |''');

		KoroneikiProductAPI._setProductPermissions(
			productName = "Liferay Digital Experience Platform",
			table = '''| Permissions | true |''');

		KoroneikiProductAPIPermissionCheck._setProductPermissions(
			productName = "Liferay Digital Experience Platform",
			table = '''| Update | true |
	| View   | true |''');

		KoroneikiProductAPIPermissionCheck._unsetProductPermissions(
			productName = "Liferay Digital Experience Platform",
			table = '''| Update | true |
	| View   | true |''');

		KoroneikiProductAPIPermissionCheck.updateProductAttempt(
			productName = "Liferay Digital Experience Platform",
			table = '''| Name | Liferay Portal Six | |''');

		KoroneikiProductAPI._viewProduct(
			productName = "Liferay Digital Experience Platform",
			table = '''| Name | Liferay Digital Experience Platform | |''');

		KoroneikiProductAPI._viewNoProduct(productName = "Liferay Portal Six");

		KoroneikiProductAPIPermissionCheck._viewNoProduct(productName = "Liferay Digital Experience Platform");
	}

	test Updateproductattemptbynewlynonpermissioneduser {
		KoroneikiProductAPI._createProduct(table = '''| Name | Liferay Digital Experience Platform | |''');

		KoroneikiProductAPI._setProductPermissions(
			productName = "Liferay Digital Experience Platform",
			table = '''| Update | true |''');

		KoroneikiProductAPI._unsetProductPermissions(
			productName = "Liferay Digital Experience Platform",
			table = '''| Update | true |''');

		KoroneikiProductAPIPermissionCheck.updateProductAttempt(
			productName = "Liferay Digital Experience Platform",
			table = '''| Name | Liferay Portal Six | |''');

		KoroneikiProductAPI._viewProduct(
			productName = "Liferay Digital Experience Platform",
			table = '''| Name | Liferay Digital Experience Platform | |''');

		KoroneikiProductAPI._viewNoProduct(productName = "Liferay Portal Six");

		KoroneikiProductAPIPermissionCheck._viewNoProduct(productName = "Liferay Digital Experience Platform");
	}

	test Updateproductattemptbynonpermissioneduser {
		KoroneikiProductAPI._createProduct(table = '''| Name | Liferay Digital Experience Platform | |''');

		KoroneikiProductAPIPermissionCheck.updateProductAttempt(
			productName = "Liferay Digital Experience Platform",
			table = '''| Name | Liferay Portal Six | |''');

		KoroneikiProductAPI._viewProduct(
			productName = "Liferay Digital Experience Platform",
			table = '''| Name | Liferay Digital Experience Platform | |''');

		KoroneikiProductAPI._viewNoProduct(productName = "Liferay Portal Six");

		KoroneikiProductAPIPermissionCheck._viewNoProduct(productName = "Liferay Digital Experience Platform");
	}

	test Updateproductbypermissioneduser {
		KoroneikiProductAPI._createProduct(table = '''| Name | Liferay Digital Experience Platform | |''');

		KoroneikiProductAPI._setProductPermissions(
			productName = "Liferay Digital Experience Platform",
			table = '''| Update | true |''');

		KoroneikiProductAPIPermissionCheck.updateProduct(
			productName = "Liferay Digital Experience Platform",
			table = '''| Name | Liferay Portal Six | |''');

		KoroneikiProductAPI._viewProduct(
			productName = "Liferay Portal Six",
			table = '''| Name | Liferay Portal Six | |''');

		KoroneikiProductAPI._viewNoProduct(productName = "Liferay Digital Experience Platform");
	}

	test Viewproductattemptbynewlynonpermissioneduser {
		KoroneikiProductAPI._createProduct(table = '''| Name | Liferay Digital Experience Platform | |''');

		KoroneikiProductAPI._setProductPermissions(
			productName = "Liferay Digital Experience Platform",
			table = '''| View | true |''');

		KoroneikiProductAPI._unsetProductPermissions(
			productName = "Liferay Digital Experience Platform",
			table = '''| View | true |''');

		KoroneikiProductAPIPermissionCheck._viewNoProduct(productName = "Liferay Digital Experience Platform");
	}

	test Viewproductattemptbynonpermissioneduser {
		KoroneikiProductAPI._createProduct(table = '''| Name | Liferay Digital Experience Platform | |''');

		KoroneikiProductAPIPermissionCheck._viewNoProduct(productName = "Liferay Digital Experience Platform");
	}

	test Viewproductbypermissioneduser {
		KoroneikiProductAPI._createProduct(table = '''| Name | Liferay Digital Experience Platform | |''');

		KoroneikiProductAPI._setProductPermissions(
			productName = "Liferay Digital Experience Platform",
			table = '''| View | true |''');

		KoroneikiProductAPIPermissionCheck._viewProduct(
			productName = "Liferay Digital Experience Platform",
			table = '''| Name | Liferay Digital Experience Platform | |''');
	}

	test Viewproductexternallinkattemptbynonpermissioneduser {
		KoroneikiProductAPI._createProduct(table = '''| Name | Liferay Digital Experience Platform | |''');

		KoroneikiProductAPI._createProductExternalLink(
			productName = "Liferay Digital Experience Platform",
			table = '''| Domain      | liferaydxp |
	| Entity Id   | 1234       |
	| Entity Name | LiferayDXP |''');

		KoroneikiProductAPI._viewProductExternalLink(
			entityId = 1234,
			productName = "Liferay Digital Experience Platform",
			table = '''| Domain      | liferaydxp |
	| Entity Id   | 1234       |
	| Entity Name | LiferayDXP |''');

		KoroneikiProductAPIPermissionCheck._viewNoProductExternalLink(
			entityId = 1234,
			productName = "Liferay Digital Experience Platform");

		KoroneikiProductAPIPermissionCheck._viewNoProductViaExternalLink(
			domain = "liferaydxp",
			entityId = 1234,
			entityName = "LiferayDXP",
			productName = "Liferay Digital Experience Platform");
	}

}