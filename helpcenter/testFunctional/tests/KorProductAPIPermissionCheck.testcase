definition {

	property testray.main.component.name = "Support QA";
	property type = "koroneiki";

	tearDown {
		LocalFile.KoroneikiProductAPI._tearDownProductPermissions(productName = "Liferay Digital Experience Platform");

		LocalFile.KoroneikiProductAPI._tearDownProductPermissions(productName = "Liferay Portal Six");

		LocalFile.KoroneikiProductAPI._tearDownProducts(table = '''| Liferay Digital Experience Platform |
	| Liferay Portal Six                  |''');
	}

	test Createproductattemptbynonpermissioneduser {
		LocalFile.KoroneikiProductAPIPermissionCheck._createProductAttempt(table = '''| Name | Liferay Digital Experience Platform | |''');

		LocalFile.KoroneikiProductAPI._viewNoProduct(productName = "Liferay Digital Experience Platform");
	}

	test Createproductexternallinkattemptbynonpermissioneduser {
		LocalFile.KoroneikiProductAPI._createProduct(table = '''| Name | Liferay Digital Experience Platform | |''');

		LocalFile.KoroneikiProductAPIPermissionCheck._createProductExternalLinkAttempt(
			productName = "Liferay Digital Experience Platform",
			table = '''| Domain      | liferaydxp |
	| Entity Id   | 1234       |
	| Entity Name | LiferayDXP |''');

		LocalFile.KoroneikiProductAPI._viewNoProductExternalLink(
			entityId = 1234,
			productName = "Liferay Digital Experience Platform");
	}

	test Removeproductattemptbynewlynonpermissioneduser {
		LocalFile.KoroneikiProductAPI._createProduct(table = '''| Name | Liferay Digital Experience Platform | |''');

		LocalFile.KoroneikiProductAPI._setProductPermissions(
			productName = "Liferay Digital Experience Platform",
			table = '''| Delete | true |''');

		LocalFile.KoroneikiProductAPI._unsetProductPermissions(
			productName = "Liferay Digital Experience Platform",
			table = '''| Delete | true |''');

		LocalFile.KoroneikiProductAPIPermissionCheck._deleteProductAttempt(productName = "Liferay Digital Experience Platform");

		LocalFile.KoroneikiProductAPI._viewProduct(
			productName = "Liferay Digital Experience Platform",
			table = '''| Name | Liferay Digital Experience Platform | |''');

		LocalFile.KoroneikiProductAPIPermissionCheck._viewNoProduct(productName = "Liferay Digital Experience Platform");
	}

	test Removeproductattemptbynonpermissioneduser {
		LocalFile.KoroneikiProductAPI._createProduct(table = '''| Name | Liferay Digital Experience Platform | |''');

		LocalFile.KoroneikiProductAPIPermissionCheck._deleteProductAttempt(productName = "Liferay Digital Experience Platform");

		LocalFile.KoroneikiProductAPI._viewProduct(
			productName = "Liferay Digital Experience Platform",
			table = '''| Name | Liferay Digital Experience Platform | |''');

		LocalFile.KoroneikiProductAPIPermissionCheck._viewNoProduct(productName = "Liferay Digital Experience Platform");
	}

	test Removeproductbypermissioneduser {
		LocalFile.KoroneikiProductAPI._createProduct(table = '''| Name | Liferay Digital Experience Platform | |''');

		LocalFile.KoroneikiProductAPI._setProductPermissions(
			productName = "Liferay Digital Experience Platform",
			table = '''| Delete | true |''');

		LocalFile.KoroneikiProductAPIPermissionCheck._deleteProduct(productName = "Liferay Digital Experience Platform");

		LocalFile.KoroneikiProductAPI._viewNoProduct(productName = "Liferay Digital Experience Platform");
	}

	test Removeproductexternallinkattemptbynonpermissioneduser {
		LocalFile.KoroneikiProductAPI._createProduct(table = '''| Name | Liferay Digital Experience Platform | |''');

		LocalFile.KoroneikiProductAPI._createProductExternalLink(
			productName = "Liferay Digital Experience Platform",
			table = '''| Domain      | liferaydxp |
	| Entity Id   | 1234       |
	| Entity Name | LiferayDXP |''');

		LocalFile.KoroneikiProductAPIPermissionCheck._deleteProductExternalLinkAttempt(
			entityId = 1234,
			productName = "Liferay Digital Experience Platform");

		LocalFile.KoroneikiProductAPI._viewProductExternalLink(
			entityId = 1234,
			productName = "Liferay Digital Experience Platform",
			table = '''| Domain      | liferaydxp |
	| Entity Id   | 1234       |
	| Entity Name | LiferayDXP |''');

		LocalFile.KoroneikiProductAPIPermissionCheck._viewNoProductExternalLink(
			entityId = 1234,
			productName = "Liferay Digital Experience Platform");

		LocalFile.KoroneikiProductAPIPermissionCheck._viewNoProductViaExternalLink(
			domain = "liferaydxp",
			entityId = 1234,
			entityName = "LiferayDXP",
			productName = "Liferay Digital Experience Platform");
	}

	test Setproductpermissionattemptbynewlynonpermissioneduser {
		LocalFile.KoroneikiProductAPI._createProduct(table = '''| Name | Liferay Digital Experience Platform | |''');

		LocalFile.KoroneikiProductAPI._setProductPermissions(
			productName = "Liferay Digital Experience Platform",
			table = '''| Permissions | true |''');

		LocalFile.KoroneikiProductAPI._unsetProductPermissions(
			productName = "Liferay Digital Experience Platform",
			table = '''| Permissions | true |''');

		LocalFile.KoroneikiProductAPIPermissionCheck._setProductPermissionsAttempt(
			productName = "Liferay Digital Experience Platform",
			table = '''| Update | true |
	| View   | true |''');

		LocalFile.KoroneikiProductAPIPermissionCheck.updateProductAttempt(
			productName = "Liferay Digital Experience Platform",
			table = '''| Name | Liferay Portal Six | |''');

		LocalFile.KoroneikiProductAPI._viewProduct(
			productName = "Liferay Digital Experience Platform",
			table = '''| Name | Liferay Digital Experience Platform | |''');

		LocalFile.KoroneikiProductAPI._viewNoProduct(productName = "Liferay Portal Six");

		LocalFile.KoroneikiProductAPIPermissionCheck._viewNoProduct(productName = "Liferay Digital Experience Platform");
	}

	test Setproductpermissionattemptbynonpermissioneduser {
		LocalFile.KoroneikiProductAPI._createProduct(table = '''| Name | Liferay Digital Experience Platform | |''');

		LocalFile.KoroneikiProductAPIPermissionCheck._setProductPermissionsAttempt(
			productName = "Liferay Digital Experience Platform",
			table = '''| Update | true |
	| View   | true |''');

		LocalFile.KoroneikiProductAPIPermissionCheck.updateProductAttempt(
			productName = "Liferay Digital Experience Platform",
			table = '''| Name | Liferay Portal Six | |''');

		LocalFile.KoroneikiProductAPI._viewProduct(
			productName = "Liferay Digital Experience Platform",
			table = '''| Name | Liferay Digital Experience Platform | |''');

		LocalFile.KoroneikiProductAPI._viewNoProduct(productName = "Liferay Portal Six");

		LocalFile.KoroneikiProductAPIPermissionCheck._viewNoProduct(productName = "Liferay Digital Experience Platform");
	}

	test Setproductpermissionsbypermissioneduser {
		LocalFile.KoroneikiProductAPI._createProduct(table = '''| Name | Liferay Digital Experience Platform | |''');

		LocalFile.KoroneikiProductAPI._setProductPermissions(
			productName = "Liferay Digital Experience Platform",
			table = '''| Permissions | true |''');

		LocalFile.KoroneikiProductAPIPermissionCheck._setProductPermissions(
			productName = "Liferay Digital Experience Platform",
			table = '''| Update | true |
	| View   | true |''');

		LocalFile.KoroneikiProductAPIPermissionCheck.updateProduct(
			productName = "Liferay Digital Experience Platform",
			table = '''| Name | Liferay Portal Six | |''');

		LocalFile.KoroneikiProductAPI._viewProduct(
			productName = "Liferay Portal Six",
			table = '''| Name | Liferay Portal Six | |''');

		LocalFile.KoroneikiProductAPI._viewNoProduct(productName = "Liferay Digital Experience Platform");

		LocalFile.KoroneikiProductAPIPermissionCheck._viewProduct(
			productName = "Liferay Portal Six",
			table = '''| Name | Liferay Portal Six | |''');
	}

	test Unsetproductpermissionattemptbynewlynonpermissioneduser {
		LocalFile.KoroneikiProductAPI._createProduct(table = '''| Name | Liferay Digital Experience Platform | |''');

		LocalFile.KoroneikiProductAPI._setProductPermissions(
			productName = "Liferay Digital Experience Platform",
			table = '''| Permissions | true |
	| Update      | true |
	| View        | true |''');

		LocalFile.KoroneikiProductAPI._unsetProductPermissions(
			productName = "Liferay Digital Experience Platform",
			table = '''| Permissions | true |''');

		LocalFile.KoroneikiProductAPIPermissionCheck._unsetProductPermissionsAttempt(
			productName = "Liferay Digital Experience Platform",
			table = '''| Update | true |
	| View   | true |''');

		LocalFile.KoroneikiProductAPIPermissionCheck.updateProduct(
			productName = "Liferay Digital Experience Platform",
			table = '''| Name | Liferay Portal Six | |''');

		LocalFile.KoroneikiProductAPI._viewProduct(
			productName = "Liferay Portal Six",
			table = '''| Name | Liferay Portal Six | |''');

		LocalFile.KoroneikiProductAPI._viewNoProduct(productName = "Liferay Digital Experience Platform");

		LocalFile.KoroneikiProductAPIPermissionCheck._viewProduct(
			productName = "Liferay Portal Six",
			table = '''| Name | Liferay Portal Six | |''');
	}

	test Unsetproductpermissionattemptbynonpermissioneduser {
		LocalFile.KoroneikiProductAPI._createProduct(table = '''| Name | Liferay Digital Experience Platform | |''');

		LocalFile.KoroneikiProductAPI._setProductPermissions(
			productName = "Liferay Digital Experience Platform",
			table = '''| Update | true |
	| View   | true |''');

		LocalFile.KoroneikiProductAPIPermissionCheck._unsetProductPermissionsAttempt(
			productName = "Liferay Digital Experience Platform",
			table = '''| Update | true |
	| View   | true |''');

		LocalFile.KoroneikiProductAPIPermissionCheck.updateProduct(
			productName = "Liferay Digital Experience Platform",
			table = '''| Name | Liferay Portal Six | |''');

		LocalFile.KoroneikiProductAPI._viewProduct(
			productName = "Liferay Portal Six",
			table = '''| Name | Liferay Portal Six | |''');

		LocalFile.KoroneikiProductAPI._viewNoProduct(productName = "Liferay Digital Experience Platform");

		LocalFile.KoroneikiProductAPIPermissionCheck._viewProduct(
			productName = "Liferay Portal Six",
			table = '''| Name | Liferay Portal Six | |''');
	}

	test Unsetproductpermissionsbypermissioneduser {
		LocalFile.KoroneikiProductAPI._createProduct(table = '''| Name | Liferay Digital Experience Platform | |''');

		LocalFile.KoroneikiProductAPI._setProductPermissions(
