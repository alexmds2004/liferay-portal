	test Viewproductattemptbynewlynonpermissioneduser {
		LocalFile.KoroneikiProductAPI._createProduct(table = '''| Name | Liferay Digital Experience Platform | |''');

		LocalFile.KoroneikiProductAPI._setProductPermissions(
