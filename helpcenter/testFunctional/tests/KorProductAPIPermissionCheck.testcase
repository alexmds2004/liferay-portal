			table = '''| Update | true |
	| View   | true |''');

		LocalFile.KoroneikiProductAPIPermissionCheck._unsetProductPermissions(
			productName = "Liferay Digital Experience Platform",
			table = '''| Update | true |
	| View   | true |''');

		LocalFile.KoroneikiProductAPIPermissionCheck.updateProductAttempt(
			productName = "Liferay Digital Experience Platform",
			table = '''| Name | Liferay Portal Six | |''');

		LocalFile.KoroneikiProductAPI._viewProduct(
			productName = "Liferay Digital Experience Platform",
			table = '''| Name | Liferay Digital Experience Platform | |''');

		LocalFile.KoroneikiProductAPI._viewNoProduct(productName = "Liferay Portal Six");

		LocalFile.KoroneikiProductAPIPermissionCheck._viewNoProduct(productName = "Liferay Digital Experience Platform");
	}

