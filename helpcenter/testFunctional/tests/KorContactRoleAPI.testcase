definition {

	property testray.main.component.name = "Support QA";
	property type = "koroneiki";

	tearDown {
		LocalFile.KoroneikiContactRoleAPI._tearDownContactRoles(table = '''| Default Account Customer Role  |
	| Default Account Worker Role    |
	| Default Team Role              |
	| Optional Account Customer Role |
	| Optional Account Worker Role   |
	| Optional Team Role             |''');
	}

	test Createandviewaccountcustomercontactrole {
		LocalFile.KoroneikiContactRoleAPI._createContactRole(table = '''| Description | This is the default customer role for accounts |
	| Name        | Default Account Customer Role                  |
	| Type        | Account Customer                               |''');

		LocalFile.KoroneikiContactRoleAPI._viewContactRole(
			contactRoleName = "Default Account Customer Role",
			table = '''| Description | This is the default customer role for accounts |
	| Name        | Default Account Customer Role                  |
	| Type        | Account Customer                               |''');
	}

	test Createandviewaccountworkercontactrole {
		LocalFile.KoroneikiContactRoleAPI._createContactRole(table = '''| Description | This is the default worker role for accounts |
	| Name        | Default Account Worker Role                  |
	| Type        | Account Worker                               |''');

		LocalFile.KoroneikiContactRoleAPI._viewContactRole(
			contactRoleName = "Default Account Worker Role",
			table = '''| Description | This is the default worker role for accounts |
	| Name        | Default Account Worker Role                  |
	| Type        | Account Worker                               |''');
	}

	test Createandviewcontactroleexternallink {
		LocalFile.KoroneikiContactRoleAPI._createContactRole(table = '''| Description | This is the default customer role for accounts |
	| Name        | Default Account Customer Role                  |
	| Type        | Account Customer                               |''');

		LocalFile.KoroneikiContactRoleAPI._createContactRoleExternalLink(
			contactRoleName = "Default Account Customer Role",
			table = '''| Domain      | contactrole |
	| Entity Id   | 1234        |
	| Entity Name | ContactRole |''');

		LocalFile.KoroneikiContactRoleAPI._viewContactRoleOnExternalLinkViaIdAndDomain(
			contactRoleName = "Default Account Customer Role",
			domain = "contactrole",
			entityId = 1234,
			table = '''| Domain      | contactrole |
	| Entity Id   | 1234        |
	| Entity Name | ContactRole |''');
	}

