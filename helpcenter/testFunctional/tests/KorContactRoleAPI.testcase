	test Updatecontactroletypeattemptfromaccountcustomertoteamandview {
		LocalFile.KoroneikiContactRoleAPI._createContactRole(table = '''| Description | This is the default customer role for accounts |
	| Name        | Default Account Customer Role                  |
	| Type        | Account Customer                               |''');

		LocalFile.KoroneikiContactRoleAPI._createContactRole(table = '''| Description | This is the default role for teams |
	| Name        | Default Team Role                  |
	| Type        | Team                               |''');

		LocalFile.KoroneikiContactRoleAPI._updateContactRole(
			contactRoleName = "Default Account Customer Role",
			table = '''| Description | This is the optional customer role for accounts |
	| Name        | Optional Account Customer Role                  |
	| Type        | Team                                            |''');

		LocalFile.KoroneikiContactRoleAPI._updateContactRole(
			contactRoleName = "Default Team Role",
			table = '''| Description | This is the optional role for teams |
	| Name        | Optional Team Role                  |
	| Type        | Account Customer                    |''');

		LocalFile.KoroneikiContactRoleAPI._viewContactRole(
			contactRoleName = "Optional Account Customer Role",
			table = '''| Description | This is the optional customer role for accounts |
	| Name        | Optional Account Customer Role                  |
	| Type        | Account Customer                                |''');

		LocalFile.KoroneikiContactRoleAPI._viewContactRole(
			contactRoleName = "Optional Team Role",
			table = '''| Description | This is the optional role for teams |
	| Name        | Optional Team Role                  |
	| Type        | Team                                |''');
