			contactRoleName = "Default Account Worker Role",
			table = '''| Description | This is the optional worker role for accounts |
	| Name        | Optional Account Worker Role                  |
	| Type        | Team                                          |''');

		LocalFile.KoroneikiContactRoleAPI._updateContactRole(
