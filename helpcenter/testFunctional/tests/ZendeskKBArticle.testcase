definition {

//	property testray.main.component.name = "Support QA";
//	property type = "zendesk.frontend";

	setUp {
		Passwords.getPasswords();
	}

	tearDown {
		ZendeskUserAPI._tearDownUsersByExternalIdTable(table = '''| Enduser1 |''');

		ZendeskOrganizationAPI._tearDownOrganizationsByExternalIdTable(table = '''| 12341234 |''');
	}

	test ViewFastTrackArticleAsCustomer {
		ZendeskOrganizationAPI._createOrganization(table = '''| Status           | Approved                   |
	| Name             | Frontend Org Name 1        |
	| Tags             | liferay_dxp,liferay_portal |
	| Shared Tickets   | true                       |
	| Shared Comments  | true                       |
	| SLA              | Gold                       |
	| Tier             | T4                         |
	| Support Region   | US                         |
	| Support Language | English                    |
	| External ID      | 12341234                   |''');

		ZendeskUserAPI._createUser(table = '''| Name         | Zendesk Enduser1                    |
	| Tags         | osb_customer                        |
	| Password     | ${staticZendeskAdminPassword}       |
	| Role         | End-user                            |
	| Access       | Organization                        |
	| Email        | zendesk.enduser1@zendesk.com.broken |
	| Phone Number | +1 (555) 555-5555                   |
	| Organization | Frontend Org Name 1                 |
	| Language     | English                             |
	| Time Zone    | Pacific Time (US & Canada)          |
	| External ID  | Enduser1                            |''');

		ZendeskHomepage.login(
			userEmailAddress = "zendesk.enduser1@zendesk.com.broken",
			userPassword = ${staticZendeskAdminPassword});

		ZendeskHomepage.pause(timeInSeconds = 10);

		ZendeskHomepage.gotoPageURL(zendeskPageUrl = "/hc/en-us/articles/360037464812");

		ZendeskHomepage.acceptAllCookies();

		ZendeskKBArticle.viewKBArticleTitle(articleTitle = "Unable to startup the server: NPE while loading configurations from database");

		ZendeskKBArticle.viewKBArticleFastTrackSection();

		ZendeskKBArticle.viewKBArticleSectionHeader(articleSection = "issue");

		ZendeskKBArticle.viewKBArticleSectionContent(articleSection = "issue");

		ZendeskKBArticle.viewKBArticleSectionHeader(articleSection = "environment");

		ZendeskKBArticle.viewKBArticleSectionContent(articleSection = "environment");

		ZendeskKBArticle.viewKBArticleSectionHeader(articleSection = "resolution");

		ZendeskKBArticle.viewNoKBArticleSectionContent(articleSection = "resolution");

		ZendeskKBArticle.viewNoKBArticleVoteControls();

		ZendeskKBArticle.viewKBArticleSectionGated(articleSection = "resolution");

		ZendeskKBArticle.viewKBArticleSubscriptionMessageWithSubscriptionLink();
	}

	test ViewFastTrackArticleAsCustomerWithKBPermissions {
		ZendeskOrganizationAPI._createOrganization(table = '''| Status           | Approved                   |
	| Name             | Frontend Org Name 1        |
	| Tags             | liferay_dxp,liferay_portal |
	| Shared Tickets   | true                       |
	| Shared Comments  | true                       |
	| SLA              | Gold                       |
	| Tier             | T4                         |
	| Support Region   | US                         |
	| Support Language | English                    |
	| External ID      | 12341234                   |''');

		ZendeskUserAPI._createUser(table = '''| Name         | Zendesk Enduser1                    |
	| Tags         | osb_customer,osb_kb                 |
	| Password     | ${staticZendeskAdminPassword}       |
	| Role         | End-user                            |
	| Access       | Organization                        |
	| Email        | zendesk.enduser1@zendesk.com.broken |
	| Phone Number | +1 (555) 555-5555                   |
	| Organization | Frontend Org Name 1                 |
	| Language     | English                             |
	| Time Zone    | Pacific Time (US & Canada)          |
	| External ID  | Enduser1                            |''');

		ZendeskHomepage.login(
			userEmailAddress = "zendesk.enduser1@zendesk.com.broken",
			userPassword = ${staticZendeskAdminPassword});

		ZendeskHomepage.pause(timeInSeconds = 10);

		ZendeskHomepage.gotoPageURL(zendeskPageUrl = "/hc/en-us/articles/360037464812");

		ZendeskHomepage.acceptAllCookies();

		ZendeskKBArticle.viewKBArticleTitle(articleTitle = "Unable to startup the server: NPE while loading configurations from database");

		ZendeskKBArticle.viewKBArticleFastTrackSection();

		ZendeskKBArticle.viewKBArticleSectionHeader(articleSection = "issue");

		ZendeskKBArticle.viewKBArticleSectionContent(articleSection = "issue");

		ZendeskKBArticle.viewKBArticleSectionHeader(articleSection = "environment");

		ZendeskKBArticle.viewKBArticleSectionContent(articleSection = "environment");

		ZendeskKBArticle.viewKBArticleSectionHeader(articleSection = "resolution");

		ZendeskKBArticle.viewKBArticleSectionContent(articleSection = "resolution");

		ZendeskKBArticle.viewKBArticleSectionHeader(articleSection = "additionalInformation");

		ZendeskKBArticle.viewKBArticleSectionContent(articleSection = "additionalInformation");

		ZendeskKBArticle.viewKBArticleVoteControls();

		ZendeskKBArticle.viewNoKBArticleSectionGated(articleSection = "resolution");

		ZendeskKBArticle.viewNoKBArticleSubscriptionMessage();
	}

	test ViewFastTrackArticleAsGuest {
		ZendeskHomepage.gotoPageURL(zendeskPageUrl = "/hc/en-us/articles/360037464812");

		ZendeskHomepage.acceptAllCookies();

		ZendeskKBArticle.viewKBArticleTitle(articleTitle = "Unable to startup the server: NPE while loading configurations from database");

		ZendeskKBArticle.viewKBArticleFastTrackSection();

		ZendeskKBArticle.viewKBArticleSectionHeader(articleSection = "issue");

		ZendeskKBArticle.viewKBArticleSectionContent(articleSection = "issue");

		ZendeskKBArticle.viewKBArticleSectionHeader(articleSection = "environment");

		ZendeskKBArticle.viewKBArticleSectionContent(articleSection = "environment");

		ZendeskKBArticle.viewKBArticleSectionHeader(articleSection = "resolution");

		ZendeskKBArticle.viewNoKBArticleSectionContent(articleSection = "resolution");

		ZendeskKBArticle.viewNoKBArticleVoteControls();

		ZendeskKBArticle.viewKBArticleSectionGated(articleSection = "resolution");

		ZendeskKBArticle.viewKBArticleSignInMessageWithSignInButton();
	}

