		LocalFile.KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - Commerce Connector to Salesforce");

		LocalFile.KoroneikiContactAPI._createContactEntitlementNestedField(entitlementDefinitionName = "Customer");

		LocalFile.KoroneikiContactAPI._renameFirstContactEntitlementNestedFieldVariable();

		LocalFile.KoroneikiContactAPI._createContactEntitlementNestedField(entitlementDefinitionName = "Customer - Commerce Connector to Salesforce");

		LocalFile.KoroneikiContactAPI._renameSecondContactEntitlementNestedFieldVariable();

		LocalFile.KoroneikiContactAPI._viewContactViaEmailAddress(
			contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken",
			table = '''| Email Address            | koroneiki.contact1@lrcustomer.com.broken    |
	| Entitlement Nested Field | Customer                                    |
	| Entitlement Nested Field | Customer - Commerce Connector to Salesforce |
	| First Name               | Koroneiki                                   |
	| Language                 | English                                     |
	| Last Name                | Contact1                                    |
	| Middle Name              | User                                        |''');

		LocalFile.KoroneikiContactAPI._viewContactEntitlementViaNestedField(
			contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken",
			entitlementDefinitionName = "Customer");

		LocalFile.KoroneikiContactAPI._viewContactEntitlementViaNestedField(
			contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken",
			entitlementDefinitionName = "Customer - Commerce Connector to Salesforce");

		LocalFile.KoroneikiContactAPI._viewNoContactEntitlementViaNestedField(
			contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken",
			entitlementDefinitionName = "Customer - Commerce Connector to PunchOut2Go");
