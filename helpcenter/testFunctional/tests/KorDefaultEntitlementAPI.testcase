definition {

	property testray.main.component.name = "Support QA";
	property type = "koroneiki";

	tearDown {
		LocalFile.KoroneikiAccountAPI._tearDownAccounts(table = '''| Koroneiki Automotive |''');

		LocalFile.KoroneikiContactAPI._tearDownContacts(table = '''| koroneiki.contact1@lrcustomer.com.broken |''');
	}

	test Createcustomercommerceconnectortopunchout2goentitlement {
		LocalFile.KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORAUTO                              | |
	| Description           | Test automotive account on koroneiki | |
	| Fax Number            | 555-555-1234                         | |
	| Name                  | Koroneiki Automotive                 | |
	| Phone Number          | 555-555-5678                         | |
	| Region                | United States                        | |
	| Status                | Active                               | |
	| Tier                  | T4                                   | |
	| Website               | www.koroneikiautomotive.com          | |''');

		LocalFile.KoroneikiContactAPI._createContact(table = '''| Email Address | koroneiki.contact1@lrcustomer.com.broken |
	| First Name    | Koroneiki                                |
	| Language      | English                                  |
	| Last Name     | Contact1                                 |
	| Middle Name   | User                                     |''');

		LocalFile.KoroneikiAccountAPI._assignCustomerContacts(
			accountName = "Koroneiki Automotive",
			table = '''| koroneiki.contact1@lrcustomer.com.broken |''');

		LocalFile.KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		LocalFile.KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Koroneiki Automotive",
			productName = "Commerce Connector to PunchOut2Go Production",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		LocalFile.KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		LocalFile.KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - Commerce");

		LocalFile.KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - Commerce Connector to PunchOut2Go");

		LocalFile.KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - Commerce Connector to Salesforce");

		LocalFile.KoroneikiContactAPI._viewContactViaEmailAddress(
			contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken",
			table = '''| Email Address            | koroneiki.contact1@lrcustomer.com.broken     |
	| Entitlement Nested Field | Customer                                     |
	| Entitlement Nested Field | Customer - Commerce Connector to PunchOut2Go |
	| First Name               | Koroneiki                                    |
	| Language                 | English                                      |
	| Last Name                | Contact1                                     |
	| Middle Name              | User                                         |''');

		LocalFile.KoroneikiContactAPI._viewContactEntitlementViaNestedField(
			contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken",
			entitlementDefinitionName = "Customer");

		LocalFile.KoroneikiContactAPI._viewContactEntitlementViaNestedField(
			contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken",
			entitlementDefinitionName = "Customer - Commerce Connector to PunchOut2Go");

		LocalFile.KoroneikiContactAPI._viewNoContactEntitlementViaNestedField(
			contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken",
			entitlementDefinitionName = "Customer - Commerce Connector to Salesforce");
	}

	test Createcustomercommerceconnectortosalesforceentitlement {
		LocalFile.KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORAUTO                              | |
