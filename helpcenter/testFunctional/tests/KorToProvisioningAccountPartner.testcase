definition {

	property testray.main.component.name = "Support QA";
	property type = "provisioning.integration";

	setUp {
		Passwords.getPasswords();

		OSBAdminRabbitMQ.generateStaticVariables();

		OSBAdminRabbitMQ.generateProvisioningCompanyName();

		OSBAdminRabbitMQ.generateProvisioningProjectName();

		JSONOkta.createOktaUser(table = '''| Screen Name   | pro.koroneiki1                       |
	| Email Address | pro.koroneiki1@lrcustomer.com.broken |
	| First Name    | PRO                                  |
	| Last Name     | Koroneiki1                           |''');

		JSONOkta.createOktaUser(table = '''| Screen Name   | pro.koroneiki2                       |
	| Email Address | pro.koroneiki2@lrcustomer.com.broken |
	| First Name    | PRO                                  |
	| Last Name     | Koroneiki2                           |''');
	}

	tearDown {
		ZendeskUserAPI._getDefaultUserId(organizationName = "Korpro - ${staticProjectName}");

		ZendeskUserAPI._renameFirstDefaultUserIdVariable();

		ZendeskUserAPI._getDefaultUserId(organizationName = "Vchild - ${staticProjectName}");

		ZendeskUserAPI._renameSecondDefaultUserIdVariable();

		ZendeskUserAPI._getDefaultUserId(organizationName = "Pchild - ${staticProjectName}");

		ZendeskUserAPI._renameThirdDefaultUserIdVariable();

		ZendeskUserAPI._getDefaultUserId(organizationName = "Onepro - ${staticProjectName}");

		ZendeskUserAPI._renameFourthDefaultUserIdVariable();

		ZendeskUserAPI._getDefaultUserId(organizationName = "Prokor - ${staticCompanyName}");

		ZendeskUserAPI._renameFifthDefaultUserIdVariable();

		ZendeskUserAPI._getDefaultUserId(organizationName = "Korpar - ${staticProjectName}");

		ZendeskUserAPI._renameSixthDefaultUserIdVariable();

		KoroneikiTeamAPI._tearDownTeams(table = '''| Koroneiki Partner |
	| Updated Partner   |''');

		KoroneikiAccountAPI._tearDownAccounts(table = '''| Korpar - ${staticProjectName} |''');

		KoroneikiAccountAPI._tearDownAccountsViaAccountFieldNameAndValue(
			fieldName = "Code",
			table = '''| KORPARKORPAR |''');

		OSBAdminProject.tearDownProjects(table = '''| KORPARKORPAR |
	| VCHILDVCHILD |
	| PCHILDPCHILD |
	| PROKORKORPRO |
	| ONEPROONEPRO |
	| PROKOR       |''');

		KoroneikiAccountAPI._tearDownAccounts(table = '''| Vchild - ${staticProjectName} |
	| Pchild - ${staticProjectName} |
	| Korpro - ${staticProjectName} |
	| Onepro - ${staticProjectName} |
	| Prokor - ${staticCompanyName} |''');

		KoroneikiAccountAPI._tearDownAccountsViaAccountFieldNameAndValue(
			fieldName = "Code",
			table = '''| VCHILDVCHILD |
	| PCHILDPCHILD |
	| PROKORKORPRO |
	| ONEPROONEPRO |
	| PROKOR       |''');

		JSONUser.tearDownUsers(table = '''| pro.koroneiki1@lrcustomer.com.broken |
	| pro.koroneiki2@lrcustomer.com.broken |''');

		JSONUser.tearDownUsersViaSupport(table = '''| pro.koroneiki1@lrcustomer.com.broken |
	| pro.koroneiki2@lrcustomer.com.broken |''');

		JSONUser.tearDownUsersViaKoroneiki(table = '''| pro.koroneiki1@lrcustomer.com.broken |
	| pro.koroneiki2@lrcustomer.com.broken |''');

		KoroneikiContactAPI._tearDownContacts(table = '''| pro.koroneiki1@lrcustomer.com.broken |
	| pro.koroneiki2@lrcustomer.com.broken |''');

		JSONOkta.tearDownUsers(table = '''| pro.koroneiki1@lrcustomer.com.broken |
	| pro.koroneiki2@lrcustomer.com.broken |''');

		ZendeskTicketAPI._tearDownTicketsByKeywords(table = '''| New Subscription(s) for Korpro - ${staticProjectName} |
	| New Subscription(s) for Prokor - ${staticCompanyName} |''');

		ZendeskUserAPI._getMultipleUserIdsByEmailAddress(table = '''| pro.koroneiki1@lrcustomer.com.broken |
	| pro.koroneiki2@lrcustomer.com.broken |''');

		ZendeskUserAPI._tearDownUsersByIdList(userIds = ${staticUserIdList});

		ZendeskOrganizationAPI._getMultipleOrganizationExternalIdsByOrganizationNameIfStillPresent(table = '''| Korpar - ${staticProjectName} |
	| Korpro - ${staticProjectName} |
	| Vchild - ${staticProjectName} |
	| Pchild - ${staticProjectName} |
	| Onepro - ${staticProjectName} |
	| Prokor - ${staticCompanyName} |''');

		ZendeskOrganizationAPI._tearDownOrganizationsByExternalIdList(organizationExternalIds = ${staticOrganizationExternalIdList});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId1});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId2});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId3});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId4});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId5});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId6});
	}


	test Addpartner {
	property help.center.acceptance = "true";
		OSBAdminRabbitMQ.publishCreateProjectWithNoPartnerMessage(
			routingKey = "dossiera.provisioning.create",
			table = '''| Account Name                           | Prokor - ${staticCompanyName}              |
	| Address City                           | Diamond Bar                                |
	| Address Country                        | United States                              |
	| Address Postal Code                    | 91765                                      |
	| Address Region                         | California                                 |
	| Address Street                         | 456 Fake Street                            |
	| Contact Email Address                  | pro.koroneiki1@lrcustomer.com.broken       |
	| Contact First Name                     | PRO                                        |
	| Contact Last Name                      | Koroneiki1                                 |
	| Dossiera Account Key                   | ${staticDossieraAccountKey}                |
	| Dossiera Address Key 1                 | ${staticDossieraAddressKey1}               |
	| Dossiera Address Key 2                 | ${staticDossieraAddressKey2}               |
	| Dossiera Contact Key                   | ${staticDossieraContactKey}                |
	| Dossiera Project Key                   | ${staticDossieraProjectKey}                |
	| End Day                                | ${staticEndDay}                            |
	| End Month                              | ${staticEndMonth}                          |
	| End Year                               | ${staticEndYear}                           |
	| Industry                               | Automotive                                 |
	| Owner Email Address                    | pro.koroneiki2@lrcustomer.com.broken       |
	| Owner First Name                       | PRO                                        |
	| Owner Last Name                        | Koroneiki2                                 |
	| Partner First Line Support             | false                                      |
	| Product Type                           | New                                        |
	| Product Name                           | Liferay Digital Enterprise - Prod Sizing 4 |
	| Project Name                           | Korpro - ${staticProjectName}              |
	| Renewal                                | false                                      |
	| Salesforce Opportunity Key             | ${staticSalesforceOpportunityKey}          |
	| Salesforce Opportunity Line Item Key 1 | ${staticSalesforceOpportunityLineItemKey1} |
	| Salesforce Opportunity Line Item Key 2 | ${staticSalesforceOpportunityLineItemKey2} |
	| Salesforce Opportunity Sold By         | Liferay US                                 |
	| Salesforce Opportunity Stage Name      | Closed Won                                 |
	| Salesforce Opportunity Territory       | United States                              |
	| Salesforce Opportunity Type            | New Business                               |
	| Salesforce Owner User Key              | ${staticSalesforceOwnerUserKey}            |
	| Salesforce Project Key                 | ${staticSalesforceProjectKey}              |
	| Start Day                              | ${staticStartDay}                          |
	| Start Month                            | ${staticStartMonth}                        |
	| Start Year                             | ${staticStartYear}                         |
	| Subscription Level                     | Platinum                                   |
	| Version Number                         | 7.1                                        |''');

		KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORPARKORPAR                                   | |
	| Contact Email Address | pro.koroneiki2@lrcustomer.com.broken           | |
	| Description           | Test provisioning partner account on koroneiki | |
	| Fax Number            | 555-555-9012                                   | |
	| Name                  | Korpar - ${staticProjectName}                  | |
	| Profile Email Address | pro.koroneiki2@lrcustomer.com.broken           | |
	| Region                | United States                                  | |
	| Status                | Active                                         | |
	| Tier                  | T4                                             | |
	| Website               | www.koroneikipartner.com                       | |''');

		KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korpar - ${staticProjectName}",
			productName = "Service Partnership",
			table = '''| Perpetual   | true     | |
	| Quantity    | 1        | |
	| Status      | Approved | |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Partner");

		OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		Provisioning.gotoAccounts();

		Provisioning.searchAccounts(keyword = "Korpro");

		Provisioning.clickAccount(accountName = "Korpro - ${staticProjectName}");

		Provisioning.clickTab(tabName = "Details");

		ProvisioningAccount.editAccountDetails(table = '''| Partner/Reseller/SI | Select Entity | Korpar - ${staticProjectName} | |
	| First Line Support  | Select Entity | Korpar - ${staticProjectName} | |''');

		ProvisioningAccount._viewAccountDetails(table = '''| Name           | Korpro - ${staticProjectName} |
	| Code           | PROKORKORPRO                  |
	| State          | ACTIVE                        |
	| Support Region | United States                 |
	| Country        | United States                 |
	| SLA            | Platinum                      |
	| Support Seats  | 1 / 3 Filled                  |
	| Tier           | T4                            |
	| FLS Partner    | Korpar - ${staticProjectName} |''');

		ProvisioningAccount._viewAccountDetailsViaDetailsTab(table = '''| Account Name        | Korpro - ${staticProjectName} | |
	| State               | ACTIVE                        | |
	| Code                | PROKORKORPRO                  | |
	| Tier                | T4                            | |
	| Data Region         | United States                 | |
	| Partner/Reseller/SI | Korpar - ${staticProjectName} |	|
	| First Line Support  | Korpar - ${staticProjectName} |	|
	| Street 1            | 456 Fake Street               | |
	| Country             | United States                 | |
	| City                | Diamond Bar                   | |
	| State/Province      | California                    | |
	| Postal Code         | 91765                         | |
	| Primary             | true                          | |
	| Dossiera Project    | ${staticDossieraProjectKey}   | |
	| Salesforce Project  | ${staticSalesforceProjectKey} | |''');

		KoroneikiAccountAPI._viewTeamRole(
			accountName = "Korpro - ${staticProjectName}",
			teamName = "Korpar - ${staticProjectName}",
			teamRoleName = "Partner");

		KoroneikiAccountAPI._viewTeamRole(
			accountName = "Korpro - ${staticProjectName}",
			teamName = "Korpar - ${staticProjectName}",
			teamRoleName = "First Line Support");

		Provisioning.gotoAccounts();

		Provisioning.searchAccounts(keyword = "Korpro");

		Provisioning.clickAccount(accountName = "Korpro - ${staticProjectName}");

		ProvisioningAccount.clickPartnerLinkViaAccountHeader();

		ProvisioningTeam._viewTeamDetails(table = '''| Name | Korpar - ${staticProjectName} |''');

		Provisioning.gotoAccounts();

		Provisioning.searchAccounts(keyword = "Korpar");

		Provisioning.removeAdvancedSearchFilters(table = '''| Subscription State: Active      |
	| Subscription State: Cancelled   |
	| Subscription State: Expired     |
	| Subscription State: Unactivated |''');

		Provisioning.clickAccount(accountName = "Korpar - ${staticProjectName}");

		Provisioning.clickTab(tabName = "Teams");

		ProvisioningAccount._viewAccountTeam(
			table = '''| Name                         | Korpar - ${staticProjectName} |
	| Partner/Reseller/SI Accounts | 1                             |
	| First Line Support Accounts  | 1                             |''',
			teamName = "Korpar - ${staticProjectName}");

		ProvisioningAccount.clickTeamLink(teamName = "Korpar - ${staticProjectName}");

		Provisioning.clickTab(tabName = "Partner/Reseller/SI Accounts");

		ProvisioningTeam._viewTeamAccount(
			accountName = "Korpro - ${staticProjectName}",
			table = '''| Account Name  | Korpro - ${staticProjectName} |
	| Code          | PROKORKORPRO                  |
	| Region        | United States                 |
	| SLA           | Platinum                      |
	| Tier          | T4                            |
	| Account State | ACTIVE                        |''');

		Provisioning.clickTab(tabName = "First Line Support Accounts");

		ProvisioningTeam._viewTeamAccount(
			accountName = "Korpro - ${staticProjectName}",
			table = '''| Account Name  | Korpro - ${staticProjectName} |
	| Code          | PROKORKORPRO                  |
	| Region        | United States                 |
	| SLA           | Platinum                      |
	| Tier          | T4                            |
	| Account State | ACTIVE                        |''');

		Provisioning.gotoAccounts();

		Provisioning.searchAccounts(keyword = "Korpro");

		Provisioning._viewAccountViaIndex(
			accountName = "Korpro - ${staticProjectName}",
			table = '''| Name    | Korpro - ${staticProjectName} |
	| Code    | PROKORKORPRO                  |
	| Partner | Korpar - ${staticProjectName} |
	| Region  | United States                 |
	| SLA     | Platinum                      |
	| Tier    | T4                            |
	| State   | ACTIVE                        |''');

		Provisioning.clickAccount(accountName = "Korpro - ${staticProjectName}");

		Provisioning.clickTab(tabName = "History");

		KoroneikiAccountAPI._generateAccountId(accountName = "Korpro - ${staticProjectName}");

		ProvisioningAccount.viewAccountHistoryEntryByKeyword(
			fieldName = "contactEmailAddress",
			keyword = "Auto > Added Account",
			table = '''| Update Description          | Auto > Added Account                 |
	| Update Field Name           | contactEmailAddress                  |
	| Update Field Original Value | N/A                                  |
	| Update Field New Value      | pro.koroneiki2@lrcustomer.com.broken |''');

		ProvisioningAccount.viewAccountHistoryEntryByKeyword(
			fieldName = "internal",
			keyword = "Auto > Added Account",
			table = '''| Update Description          | Auto > Added Account |
	| Update Field Name           | internal             |
	| Update Field Original Value | N/A                  |
	| Update Field New Value      | false                |''');

		ProvisioningAccount.viewAccountHistoryEntryByKeyword(
			fieldName = "code",
			keyword = "Auto > Added Account",
			table = '''| Update Description          | Auto > Added Account |
	| Update Field Name           | code                 |
	| Update Field Original Value | N/A                  |
	| Update Field New Value      | PROKORKORPRO         |''');

		ProvisioningAccount.viewAccountHistoryEntryByKeyword(
			fieldName = "region",
			keyword = "Auto > Added Account",
			table = '''| Update Description          | Auto > Added Account |
	| Update Field Name           | region               |
	| Update Field Original Value | N/A                  |
	| Update Field New Value      | United States        |''');

		KoroneikiAccountAPI._generateAccountId(accountName = "Prokor - ${staticCompanyName}");

		ProvisioningAccount.viewAccountHistoryEntryByKeyword(
			fieldName = "parentAccountId",
			keyword = "Auto > Added Account",
			table = '''| Update Description          | Auto > Added Account |
	| Update Field Name           | parentAccountId      |
	| Update Field Original Value | N/A                  |
	| Update Field New Value      | ${staticAccountId}   |''');

		KoroneikiAccountAPI._generateAccountId(accountName = "Korpro - ${staticProjectName}");

		ProvisioningAccount.viewAccountHistoryEntryByKeyword(
			fieldName = "accountId",
			keyword = "Auto > Added Account",
			table = '''| Update Description          | Auto > Added Account |
	| Update Field Name           | accountId            |
	| Update Field Original Value | N/A                  |
	| Update Field New Value      | ${staticAccountId}   |''');

		ProvisioningAccount.viewAccountHistoryEntryByKeyword(
			fieldName = "name",
			keyword = "Auto > Added Account",
			table = '''| Update Description          | Auto > Added Account          |
	| Update Field Name           | name                          |
	| Update Field Original Value | N/A                           |
	| Update Field New Value      | Korpro - ${staticProjectName} |''');

		ProvisioningAccount.viewAccountHistoryEntryByKeyword(
			fieldName = "status",
			keyword = "Auto > Added Account",
			table = '''| Update Description          | Auto > Added Account |
	| Update Field Name           | status               |
	| Update Field Original Value | N/A                  |
	| Update Field New Value      | Active               |''');

		ProvisioningAccount.viewAccountHistoryEntryByKeyword(
			fieldName = "tier",
			keyword = "Auto > Added Account",
			table = '''| Update Description          | Auto > Added Account |
	| Update Field Name           | tier                 |
	| Update Field Original Value | N/A                  |
	| Update Field New Value      | T4                   |''');

		ProvisioningAccount.viewAccountHistoryEntryByKeywordAndPosition(
			fieldName = "Team Role",
			keyword = "Test Test > Assigned Team",
			positionValue = 1,
			table = '''| Update Description          | Test Test > Assigned Team > Korpar - ${staticProjectName} |
	| Update Field Name           | Team Role                                                 |
	| Update Field Original Value | N/A                                                       |
	| Update Field New Value      | Partner                                                   |''');

		ProvisioningAccount.viewAccountHistoryEntryByKeywordAndPosition(
			fieldName = "Team Role",
			keyword = "Test Test > Assigned Team",
			positionValue = 2,
			table = '''| Update Description          | Test Test > Assigned Team > Korpar - ${staticProjectName} |
	| Update Field Name           | Team Role                                                 |
	| Update Field Original Value | N/A                                                       |
	| Update Field New Value      | First Line Support                                        |''');
	}

	test AddpartnerwithBasicResellerPartnership {
		OSBAdminRabbitMQ.publishCreateProjectWithNoPartnerMessage(
			routingKey = "dossiera.provisioning.create",
			table = '''| Account Name                           | Prokor - ${staticCompanyName}              |
	| Address City                           | Diamond Bar                                |
	| Address Country                        | United States                              |
	| Address Postal Code                    | 91765                                      |
	| Address Region                         | California                                 |
	| Address Street                         | 456 Fake Street                            |
	| Contact Email Address                  | pro.koroneiki1@lrcustomer.com.broken       |
	| Contact First Name                     | PRO                                        |
	| Contact Last Name                      | Koroneiki1                                 |
	| Dossiera Account Key                   | ${staticDossieraAccountKey}                |
	| Dossiera Address Key 1                 | ${staticDossieraAddressKey1}               |
	| Dossiera Address Key 2                 | ${staticDossieraAddressKey2}               |
	| Dossiera Contact Key                   | ${staticDossieraContactKey}                |
	| Dossiera Project Key                   | ${staticDossieraProjectKey}                |
	| End Day                                | ${staticEndDay}                            |
	| End Month                              | ${staticEndMonth}                          |
	| End Year                               | ${staticEndYear}                           |
	| Industry                               | Automotive                                 |
	| Owner Email Address                    | pro.koroneiki2@lrcustomer.com.broken       |
	| Owner First Name                       | PRO                                        |
	| Owner Last Name                        | Koroneiki2                                 |
	| Partner First Line Support             | false                                      |
	| Product Type                           | New                                        |
	| Product Name                           | Liferay Digital Enterprise - Prod Sizing 4 |
	| Project Name                           | Korpro - ${staticProjectName}              |
	| Renewal                                | false                                      |
	| Salesforce Opportunity Key             | ${staticSalesforceOpportunityKey}          |
	| Salesforce Opportunity Line Item Key 1 | ${staticSalesforceOpportunityLineItemKey1} |
	| Salesforce Opportunity Line Item Key 2 | ${staticSalesforceOpportunityLineItemKey2} |
	| Salesforce Opportunity Sold By         | Liferay US                                 |
	| Salesforce Opportunity Stage Name      | Closed Won                                 |
	| Salesforce Opportunity Territory       | United States                              |
	| Salesforce Opportunity Type            | New Business                               |
	| Salesforce Owner User Key              | ${staticSalesforceOwnerUserKey}            |
	| Salesforce Project Key                 | ${staticSalesforceProjectKey}              |
	| Start Day                              | ${staticStartDay}                          |
	| Start Month                            | ${staticStartMonth}                        |
	| Start Year                             | ${staticStartYear}                         |
	| Subscription Level                     | Platinum                                   |
	| Version Number                         | 7.1                                        |''');

		KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORPARKORPAR                                   | |
	| Contact Email Address | pro.koroneiki2@lrcustomer.com.broken           | |
	| Description           | Test provisioning partner account on koroneiki | |
	| Fax Number            | 555-555-9012                                   | |
	| Name                  | Korpar - ${staticProjectName}                  | |
	| Profile Email Address | pro.koroneiki2@lrcustomer.com.broken           | |
	| Region                | United States                                  | |
	| Status                | Active                                         | |
	| Tier                  | T4                                             | |
	| Website               | www.koroneikipartner.com                       | |''');

		KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korpar - ${staticProjectName}",
			productName = "Basic Reseller Partnership",
			table = '''| Perpetual   | true     | |
	| Quantity    | 1        | |
	| Status      | Approved | |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Partner");

		OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		Provisioning.gotoAccounts();

		Provisioning.searchAccounts(keyword = "Korpro");

		Provisioning.clickAccount(accountName = "Korpro - ${staticProjectName}");

		Provisioning.clickTab(tabName = "Details");

		ProvisioningAccount.editAccountDetails(table = '''| Partner/Reseller/SI | Select Entity | Korpar - ${staticProjectName} | |
	| First Line Support  | Select Entity | Korpar - ${staticProjectName} | |''');

		ProvisioningAccount._viewAccountDetails(table = '''| Name           | Korpro - ${staticProjectName} |
	| Code           | PROKORKORPRO                  |
	| State          | ACTIVE                        |
	| Support Region | United States                 |
	| Country        | United States                 |
	| SLA            | Platinum                      |
	| Support Seats  | 1 / 3 Filled                  |
	| Tier           | T4                            |
	| FLS Partner    | Korpar - ${staticProjectName} |''');

		ProvisioningAccount._viewAccountDetailsViaDetailsTab(table = '''| Account Name        | Korpro - ${staticProjectName} | |
	| State               | ACTIVE                        | |
	| Code                | PROKORKORPRO                  | |
	| Tier                | T4                            | |
	| Data Region         | United States                 | |
	| Partner/Reseller/SI | Korpar - ${staticProjectName} |	|
	| First Line Support  | Korpar - ${staticProjectName} |	|
	| Street 1            | 456 Fake Street               | |
	| Country             | United States                 | |
	| City                | Diamond Bar                   | |
	| State/Province      | California                    | |
	| Postal Code         | 91765                         | |
	| Primary             | true                          | |
	| Dossiera Project    | ${staticDossieraProjectKey}   | |
	| Salesforce Project  | ${staticSalesforceProjectKey} | |''');

		KoroneikiAccountAPI._viewTeamRole(
			accountName = "Korpro - ${staticProjectName}",
			teamName = "Korpar - ${staticProjectName}",
			teamRoleName = "Partner");

		KoroneikiAccountAPI._viewTeamRole(
			accountName = "Korpro - ${staticProjectName}",
			teamName = "Korpar - ${staticProjectName}",
			teamRoleName = "First Line Support");

		Provisioning.gotoAccounts();

		Provisioning.searchAccounts(keyword = "Korpro");

		Provisioning._viewAccountViaIndex(
			accountName = "Korpro - ${staticProjectName}",
			table = '''| Name    | Korpro - ${staticProjectName} |
	| Code    | PROKORKORPRO                  |
	| Partner | Korpar - ${staticProjectName} |
	| Region  | United States                 |
	| SLA     | Platinum                      |
	| Tier    | T4                            |
	| State   | ACTIVE                        |''');
	}

	test AddpartnerwithDistributionPartnership {
		OSBAdminRabbitMQ.publishCreateProjectWithNoPartnerMessage(
			routingKey = "dossiera.provisioning.create",
			table = '''| Account Name                           | Prokor - ${staticCompanyName}              |
	| Address City                           | Diamond Bar                                |
	| Address Country                        | United States                              |
	| Address Postal Code                    | 91765                                      |
	| Address Region                         | California                                 |
	| Address Street                         | 456 Fake Street                            |
	| Contact Email Address                  | pro.koroneiki1@lrcustomer.com.broken       |
	| Contact First Name                     | PRO                                        |
	| Contact Last Name                      | Koroneiki1                                 |
	| Dossiera Account Key                   | ${staticDossieraAccountKey}                |
	| Dossiera Address Key 1                 | ${staticDossieraAddressKey1}               |
	| Dossiera Address Key 2                 | ${staticDossieraAddressKey2}               |
	| Dossiera Contact Key                   | ${staticDossieraContactKey}                |
	| Dossiera Project Key                   | ${staticDossieraProjectKey}                |
	| End Day                                | ${staticEndDay}                            |
	| End Month                              | ${staticEndMonth}                          |
	| End Year                               | ${staticEndYear}                           |
	| Industry                               | Automotive                                 |
	| Owner Email Address                    | pro.koroneiki2@lrcustomer.com.broken       |
	| Owner First Name                       | PRO                                        |
	| Owner Last Name                        | Koroneiki2                                 |
	| Partner First Line Support             | false                                      |
	| Product Type                           | New                                        |
	| Product Name                           | Liferay Digital Enterprise - Prod Sizing 4 |
	| Project Name                           | Korpro - ${staticProjectName}              |
	| Renewal                                | false                                      |
	| Salesforce Opportunity Key             | ${staticSalesforceOpportunityKey}          |
	| Salesforce Opportunity Line Item Key 1 | ${staticSalesforceOpportunityLineItemKey1} |
	| Salesforce Opportunity Line Item Key 2 | ${staticSalesforceOpportunityLineItemKey2} |
	| Salesforce Opportunity Sold By         | Liferay US                                 |
	| Salesforce Opportunity Stage Name      | Closed Won                                 |
