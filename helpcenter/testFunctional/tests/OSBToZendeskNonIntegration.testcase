definition {

	property testray.main.component.name = "Support QA";
	property type = "zendesk.integration";

	setUp {
		OSBAdminRabbitMQ.generateProvisioningProjectName();

		JSONOkta.createOktaUser(table = '''| Screen Name   | osb.customer1                       |
	| Email Address | osb.customer1@lrcustomer.com.broken |
	| First Name    | OSB                                 |
	| Last Name     | Customer1                           |''');

		JSONOkta.createOktaUser(table = '''| Screen Name   | osb.customer2                       |
	| Email Address | osb.customer2@lrcustomer.com.broken |
	| First Name    | OSB                                 |
	| Last Name     | Customer2                           |''');

		KoroneikiAccountAPI._createAccount(table = '''| Code     | OSBZENOSBZEN                  | |
	| Language | English                       | |
	| Name     | Osbzen - ${staticProjectName} | |
	| Region   | United States                 | |
	| Status   | Active                        | |
	| Tier     | T1                            | |''');

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Osbzen - ${staticProjectName}",
			contactEmailAddress = "osb.customer1@lrcustomer.com.broken",
			table = '''| Support Requester |''');

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Osbzen - ${staticProjectName}",
			contactEmailAddress = "osb.customer2@lrcustomer.com.broken",
			table = '''| Support User |''');

		ZendeskOrganizationAPI._viewOrganizationNoSyncFromOsb(organizationName = "Osbzen - ${staticProjectName}");

		ZendeskUserAPI._viewUserNoSyncFromOsb(userEmailAddress = "osb.customer1@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserNoSyncFromOsb(userEmailAddress = "osb.customer2@lrcustomer.com.broken");
	}

	tearDown {
		ZendeskUserAPI._getDefaultUserId(organizationName = "Osbzen - ${staticProjectName}");

		OSBAdminProject.tearDownProjects(table = '''| OSBZENOSBZEN |''');

		KoroneikiAccountAPI._tearDownAccounts(table = '''| Osbzen - ${staticProjectName} |''');

		KoroneikiAccountAPI._tearDownAccountsViaAccountFieldNameAndValue(
			fieldName = "Code",
			table = '''| OSBZENOSBZEN |''');

		JSONUser.tearDownUsersViaSupport(table = '''| osb.customer1@lrcustomer.com.broken |
	| osb.customer2@lrcustomer.com.broken |''');

		JSONUser.tearDownUsersViaKoroneiki(table = '''| osb.customer1@lrcustomer.com.broken |
	| osb.customer2@lrcustomer.com.broken |''');

		KoroneikiContactAPI._tearDownContacts(table = '''| osb.customer1@lrcustomer.com.broken |
	| osb.customer2@lrcustomer.com.broken |''');

		JSONOkta.tearDownUsers(table = '''| osb.customer1@lrcustomer.com.broken |
	| osb.customer2@lrcustomer.com.broken |''');

		ZendeskUserAPI._getMultipleUserIdsByEmailAddress(table = '''| osb.customer1@lrcustomer.com.broken |
	| osb.customer2@lrcustomer.com.broken |''');

		ZendeskUserAPI._tearDownUsersByIdList(userIds = ${staticUserIdList});

		ZendeskOrganizationAPI._getMultipleOrganizationExternalIdsByOrganizationNameIfStillPresent(table = '''| Osbzen - ${staticProjectName} |''');

		ZendeskOrganizationAPI._tearDownOrganizationsByExternalIdList(organizationExternalIds = ${staticOrganizationExternalIdList});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId});
	}

	test Viewnoprojectandusersyncaftercustomerremoval {
		KoroneikiAccountAPI._removeCustomerContacts(
			accountName = "Osbzen - ${staticProjectName}",
			table = '''| osb.customer1@lrcustomer.com.broken |''');

		ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		ZendeskOrganizationAPI._viewOrganizationNoSyncFromOsb(organizationName = "Osbzen - ${staticProjectName}");

		ZendeskUserAPI._viewUserNoSyncFromOsb(userEmailAddress = "osb.customer1@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserNoSyncFromOsb(userEmailAddress = "osb.customer2@lrcustomer.com.broken");
	}

	test Viewnoprojectandusersyncafterroleupdates {
		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Osbzen - ${staticProjectName}",
			contactEmailAddress = "osb.customer1@lrcustomer.com.broken",
			table = '''| Support User |''');

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Osbzen - ${staticProjectName}",
			contactEmailAddress = "osb.customer2@lrcustomer.com.broken",
			table = '''| Support Requester |''');

		KoroneikiAccountAPI._removeContactRolesFromContact(
			accountName = "Osbzen - ${staticProjectName}",
			contactEmailAddress = "osb.customer1@lrcustomer.com.broken",
			table = '''| Support Requester |''');

		KoroneikiAccountAPI._removeContactRolesFromContact(
			accountName = "Osbzen - ${staticProjectName}",
			contactEmailAddress = "osb.customer2@lrcustomer.com.broken",
			table = '''| Support User |''');

		ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		ZendeskOrganizationAPI._viewOrganizationNoSyncFromOsb(organizationName = "Osbzen - ${staticProjectName}");

		ZendeskUserAPI._viewUserNoSyncFromOsb(userEmailAddress = "osb.customer1@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserNoSyncFromOsb(userEmailAddress = "osb.customer2@lrcustomer.com.broken");
	}

	test Viewnoprojectandusersyncafterwatcherremoval {
		KoroneikiAccountAPI._removeCustomerContacts(
			accountName = "Osbzen - ${staticProjectName}",
			table = '''| osb.customer2@lrcustomer.com.broken |''');

		ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		ZendeskOrganizationAPI._viewOrganizationNoSyncFromOsb(organizationName = "Osbzen - ${staticProjectName}");

		ZendeskUserAPI._viewUserNoSyncFromOsb(userEmailAddress = "osb.customer1@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserNoSyncFromOsb(userEmailAddress = "osb.customer2@lrcustomer.com.broken");
	}

}