	| Region      | Brazil     | |
	| Data Region | Brazil     | |''');

		LocalFile.KoroneikiProductPurchaseAPI._viewProductPurchase(
			accountName = "Provis - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| Quantity | 1        | |
	| Status   | Approved | |''');

		LocalFile.KoroneikiProductPurchaseAPI._viewProductPurchase(
