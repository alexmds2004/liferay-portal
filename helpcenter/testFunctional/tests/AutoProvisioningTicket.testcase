definition {

	property testray.main.component.name = "Support QA";
	property type = "auto.provisioning";

	setUp {
		LocalFile.Passwords.getPasswords();

		LocalFile.JSONOkta.createOktaUser(table = '''| Screen Name   | usr.provisioning1                       |
	| Email Address | usr.provisioning1@lrcustomer.com.broken |
	| First Name    | USR                                     |
	| Last Name     | Provisioning1                           |''');
	}

	tearDown {
		LocalFile.ZendeskUserAPI._getDefaultUserId(organizationName = "Provis - ${staticProjectName}");

		LocalFile.ZendeskUserAPI._renameFirstDefaultUserIdVariable();

		LocalFile.ZendeskUserAPI._getDefaultUserId(organizationName = "Propar - ${staticCompanyName}");

		LocalFile.ZendeskUserAPI._renameSecondDefaultUserIdVariable();

		LocalFile.OSBAdminProject.tearDownProjects(table = '''| PROPAR       |
	| VISPROPROVIS |''');

		LocalFile.KoroneikiAccountAPI._tearDownAccounts(table = '''| Propar - ${staticCompanyName} |
	| Provis - ${staticProjectName} |
	| Vispro - ${staticCompanyName} |''');

		LocalFile.KoroneikiAccountAPI._tearDownAccountsViaAccountFieldNameAndValue(
			fieldName = "Code",
			table = '''| PROPAR       |
	| VISPROPROVIS |
	| VISPRO       |''');

		LocalFile.KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		LocalFile.JSONUser.tearDownUsers(table = '''| usr.provisioning1@lrcustomer.com.broken |''');

		LocalFile.JSONUser.tearDownUsersViaSupport(table = '''| usr.provisioning1@lrcustomer.com.broken |''');

		LocalFile.JSONUser.tearDownUsersViaKoroneiki(table = '''| usr.provisioning1@lrcustomer.com.broken |''');

		LocalFile.KoroneikiContactAPI._tearDownContacts(table = '''| usr.provisioning1@lrcustomer.com.broken |''');

		LocalFile.JSONOkta.tearDownUsers(table = '''| usr.provisioning1@lrcustomer.com.broken |''');

		LocalFile.ZendeskTicketAPI._tearDownTicketsByKeywords(table = '''| New Subscription(s) for Propar - ${staticCompanyName} |
	| New Subscription(s) for Provis - ${staticProjectName} |''');

		LocalFile.ZendeskUserAPI._getMultipleUserIdsByEmailAddress(table = '''| usr.provisioning1@lrcustomer.com.broken |''');

		LocalFile.ZendeskUserAPI._tearDownUsersByIdList(userIds = ${staticUserIdList});

		LocalFile.ZendeskOrganizationAPI._getMultipleOrganizationExternalIdsByOrganizationNameIfStillPresent(table = '''| Propar - ${staticCompanyName} |
	| Provis - ${staticProjectName} |''');

		LocalFile.ZendeskOrganizationAPI._tearDownOrganizationsByExternalIdList(organizationExternalIds = ${staticOrganizationExternalIdList});

		LocalFile.ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId1});

		LocalFile.ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId2});
	}

	test CreateprojectforAustraliaSupportRegionandviewticket {
		LocalFile.OSBAdminRabbitMQ.generateStaticVariables();

		LocalFile.OSBAdminRabbitMQ.generateProvisioningCompanyName();

		LocalFile.OSBAdminRabbitMQ.generateProvisioningProjectName();

		LocalFile.OSBAdmin.loginToSupport(
			userEmailAddress = ${staticSupportAdminEmailAdress},
			userPassword = ${staticSupportAdminPassword});

		LocalFile.OSBAdminRabbitMQ.publishCreatePartnerAccountMessage(
			routingKey = "dossiera.provisioning.create",
			table = '''| Account Name                           | Propar - ${staticCompanyName}              |
	| Address City                           | Diamond Bar                                |
	| Address Country                        | United States                              |
	| Address Postal Code                    | 91765                                      |
	| Address Region                         | California                                 |
	| Address Street                         | 456 Fake Street                            |
	| Dossiera Account Key                   | abcdefgh1234567890                         |
	| Dossiera Address Key 1                 | ${staticDossieraAddressKey1}               |
	| End Day                                | ${staticEndDay}                            |
	| End Month                              | ${staticEndMonth}                          |
	| End Year                               | ${staticEndYear}                           |
	| Industry                               | Professional Services (Technical/Web/IT)   |
	| Owner Email Address                    | usr.provisioning1@lrcustomer.com.broken    |
	| Owner First Name                       | USR                                        |
	| Owner Last Name                        | Provisioning1                              |
	| Partner First Line Support             | false                                      |
	| Product Name                           | Service Partnership                        |
	| Product Type                           | New                                        |
	| Renewal                                | false                                      |
	| Salesforce Opportunity Key             | 000000a1b2c3d4e5f6e7f                      |
	| Salesforce Opportunity Line Item Key 1 | ${staticSalesforceOpportunityLineItemKey1} |
	| Salesforce Opportunity Sold By         | Liferay US                                 |
	| Salesforce Opportunity Stage Name      | Closed Won                                 |
	| Salesforce Opportunity Territory       | United States                              |
	| Salesforce Opportunity Type            | New Business                               |
	| Salesforce Owner User Key              | ${staticSalesforceOwnerUserKey}            |
	| Start Day                              | ${staticStartDay}                          |
	| Start Month                            | ${staticStartMonth}                        |
	| Start Year                             | ${staticStartYear}                         |''');

		LocalFile.KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Partner");

		LocalFile.OSBAdminRabbitMQ.publishCreateProjectMessage(
			routingKey = "dossiera.provisioning.create",
			table = '''| Account Name                           | Vispro - ${staticCompanyName}              |
	| Address City                           | Sydney                                     |
	| Address Country                        | Australia                                  |
	| Address Postal Code                    | 2000                                       |
	| Address Region                         | New South Wales                            |
	| Address Street                         | 227 Elizabeth Street                       |
	| Contact Email Address                  | usr.provisioning1@lrcustomer.com.broken    |
	| Contact First Name                     | USR                                        |
	| Contact Last Name                      | Provisioning1                              |
	| Dossiera Account Key                   | ${staticDossieraAccountKey}                |
	| Dossiera Address Key 1                 | ${staticDossieraAddressKey1}               |
	| Dossiera Address Key 2                 | ${staticDossieraAddressKey2}               |
	| Dossiera Contact Key                   | ${staticDossieraContactKey}                |
	| Dossiera Project Key                   | ${staticDossieraProjectKey}                |
	| End Day                                | ${staticEndDay}                            |
	| End Month                              | ${staticEndMonth}                          |
	| End Year                               | ${staticEndYear}                           |
	| Industry                               | Engineering                                |
	| Owner Email Address                    | usr.provisioning1@lrcustomer.com.broken    |
	| Owner First Name                       | USR                                        |
	| Owner Last Name                        | Provisioning1                              |
	| Partner First Line Support             | false                                      |
	| Partner Dossiera Key                   | abcdefgh1234567890                         |
	| Partner Name                           | Propar - ${staticCompanyName}              |
	| Partner Support Level                  | Platinum                                   |
	| Product Type                           | New                                        |
	| Product Name                           | Liferay Digital Enterprise - Prod Sizing 4 |
	| Project Name                           | Provis - ${staticProjectName}              |
	| Renewal                                | false                                      |
	| Salesforce Opportunity Key             | ${staticSalesforceOpportunityKey}          |
	| Salesforce Opportunity Line Item Key 1 | ${staticSalesforceOpportunityLineItemKey1} |
	| Salesforce Opportunity Line Item Key 2 | ${staticSalesforceOpportunityLineItemKey2} |
	| Salesforce Opportunity Sold By         | Liferay Australia                          |
	| Salesforce Opportunity Stage Name      | Closed Won                                 |
	| Salesforce Opportunity Territory       | Australia                                  |
	| Salesforce Opportunity Type            | New Business                               |
	| Salesforce Owner User Key              | ${staticSalesforceOwnerUserKey}            |
	| Salesforce Project Key                 | ${staticSalesforceProjectKey}              |
	| Start Day                              | ${staticStartDay}                          |
	| Start Month                            | ${staticStartMonth}                        |
	| Start Year                             | ${staticStartYear}                         |
	| Subscription Level                     | Platinum                                   |
	| Version Number                         | 7.1                                        |''');

		LocalFile.OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		LocalFile.Provisioning.gotoAccounts();

		LocalFile.Provisioning.searchAccounts(keyword = "Provis");

		LocalFile.Provisioning.clickAccount(accountName = "Provis - ${staticProjectName}");

		LocalFile.ProvisioningAccount.clickSyncToZendeskButton();

		LocalFile.JSONOSBAccount.viewSupportOrganizationSync(accountCode = "VISPROPROVIS");

		LocalFile.ZendeskTicketAPI._viewTicketSyncByKeywords(keywords = "New Subscription(s) for Provis - ${staticProjectName}");

		LocalFile.ZendeskTicketAPI._viewTicketSupportRegion(
			keywords = "New Subscription(s) for Provis - ${staticProjectName}",
			supportRegion = "provisioning_australia");

		LocalFile.ZendeskTicketAPI._viewTicketPrimaryAddressCountry(
			keywords = "New Subscription(s) for Provis - ${staticProjectName}",
			primaryAddressCountry = "Australia");

		LocalFile.OSBAdmin.gotoOSBAdmin();

		LocalFile.OSBAdminProject.view(
			projectName = "Provis - ${staticProjectName}",
			table = '''| Koroneiki Account Key | Obtain from project name      |
	| Project Name          | Provis - ${staticProjectName} |
	| Code                  | VISPROPROVIS                  |
	| Partner               | Propar - ${staticCompanyName} |
	| Addresses             | 227 Elizabeth Street          |
	| Addresses             | Australia                     |
	| Addresses             | New South Wales               |
	| Addresses             | Sydney                        |
	| Addresses             | 2000                          |
	| Addresses             | Primary                       |
	| Tier                  | T4                            |
	| Language              | English                       |''');

		LocalFile.KoroneikiAccountAPI._viewAccount(
			accountName = "Provis - ${staticProjectName}",
			table = '''| Language    | English   | |
	| Region      | Australia | |
	| Data Region | Japan     | |''');

		LocalFile.KoroneikiProductPurchaseAPI._viewProductPurchase(
			accountName = "Provis - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| Quantity | 1        | |
	| Status   | Approved | |''');

		LocalFile.KoroneikiProductPurchaseAPI._viewProductPurchase(
			accountName = "Provis - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| Quantity | 1        | |
	| Status   | Approved | |''');

		LocalFile.KoroneikiAccountAPI._viewContactRole(
			accountName = "Provis - ${staticProjectName}",
			contactEmailAddress = "usr.provisioning1@lrcustomer.com.broken",
			contactRoleName = "Support Administrator");

		LocalFile.KoroneikiAccountAPI._viewContactRole(
			accountName = "Provis - ${staticProjectName}",
			contactEmailAddress = "usr.provisioning1@lrcustomer.com.broken",
			contactRoleName = "Liferay Sales");

		LocalFile.KoroneikiAccountAPI._viewContactRole(
			accountName = "Provis - ${staticProjectName}",
			contactEmailAddress = "usr.provisioning1@lrcustomer.com.broken",
			contactRoleName = "Secondary Contact");
	}

	test CreateprojectforBrazilSupportRegionandviewticket {
		LocalFile.OSBAdminRabbitMQ.generateStaticVariables();

		LocalFile.OSBAdminRabbitMQ.generateProvisioningCompanyName();

		LocalFile.OSBAdminRabbitMQ.generateProvisioningProjectName();

		LocalFile.OSBAdmin.loginToSupport(
			userEmailAddress = ${staticSupportAdminEmailAdress},
			userPassword = ${staticSupportAdminPassword});

		LocalFile.OSBAdminRabbitMQ.publishCreatePartnerAccountMessage(
			routingKey = "dossiera.provisioning.create",
			table = '''| Account Name                           | Propar - ${staticCompanyName}              |
	| Address City                           | Diamond Bar                                |
	| Address Country                        | United States                              |
	| Address Postal Code                    | 91765                                      |
	| Address Region                         | California                                 |
	| Address Street                         | 456 Fake Street                            |
	| Dossiera Account Key                   | abcdefgh1234567890                         |
	| Dossiera Address Key 1                 | ${staticDossieraAddressKey1}               |
