		ProjectDetails.gotoProjectDetailsPage();

		ProjectDetails.searchKeyword(keyword = "Korone");

		ProjectDetails.gotoProject(projectName = "Korone - ${staticProjectName}");

		ProjectDetails.viewDetails(table = '''| Project Code    | KORONEKORONE          |
	| State           | ACTIVE                |
	| Level           | Platinum Subscription |
	| Support Region  | United States         |
	| Tier            | T4                    |''');

		ProjectDetails.gotoHistory();

		KoroneikiAccountAPI._generateAccountId(accountName = "Korone - ${staticProjectName}");

		ProjectDetails.viewHistoryEntryByKeyword(
			fieldName = "name",
			keyword = "Added Account",
			table = '''| Updater Name                | Koroneiki User                |
	| Update Summary              | Added Account                 |
	| Update Date                 | Today                         |
	| Update Field Name           | name                          |
	| Update Field Original Value | N/A                           |
	| Update Field New Value      | Korone - ${staticProjectName} |''');

		ProjectDetails.viewHistoryEntryByKeyword(
			fieldName = "name",
			keyword = "Added Team",
			table = '''| Updater Name                | Koroneiki User                |
	| Update Summary              | Added Team                    |
	| Update Date                 | Today                         |
	| Update Field Name           | name                          |
	| Update Field Original Value | N/A                           |
	| Update Field New Value      | Korone - ${staticProjectName} |''');

		ProjectDetails.viewHistoryEntryByKeywords(
			fieldName = "entityId",
			keyword1 = "Added External Link",
			keyword2 = "Koroneiki User",
			table = '''| Updater Name                | Koroneiki User      |
	| Update Summary              | Added External Link |
	| Update Date                 | Today               |
	| Update Field Name           | entityId            |
	| Update Field Original Value | N/A                 |
	| Update Field New Value      | 1234                |''');

		ProjectDetails.viewHistoryEntryByKeywords(
			fieldName = "classPK",
			keyword1 = "Added External Link",
			keyword2 = "Koroneiki User",
			table = '''| Updater Name                | Koroneiki User      |
	| Update Summary              | Added External Link |
	| Update Date                 | Today               |
	| Update Field Name           | classPK             |
	| Update Field Original Value | N/A                 |
	| Update Field New Value      | ${staticAccountId}  |''');

		ProjectDetails.viewHistoryEntryByKeywords(
			fieldName = "entityName",
			keyword1 = "Added External Link",
			keyword2 = "Koroneiki User",
			table = '''| Updater Name                | Koroneiki User       |
	| Update Summary              | Added External Link  |
	| Update Date                 | Today                |
	| Update Field Name           | entityName           |
	| Update Field Original Value | N/A                  |
	| Update Field New Value      | KoroneikiCorporation |''');

		ProjectDetails.viewHistoryEntryByKeywords(
			fieldName = "domain",
			keyword1 = "Added External Link",
			keyword2 = "Koroneiki User",
			table = '''| Updater Name                | Koroneiki User       |
	| Update Summary              | Added External Link  |
	| Update Date                 | Today                |
	| Update Field Name           | domain               |
	| Update Field Original Value | N/A                  |
	| Update Field New Value      | koroneikicorporation |''');
	}

	test Createaccountwithpartner {
		OSBAdminRabbitMQ.generateProvisioningProjectName();

		KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORONEKORONE                         | |
	| Contact Email Address | osb.koroneiki1@lrcustomer.com.broken | |
	| Description           | Test osb account on koroneiki        | |
	| Fax Number            | 555-555-1234                         | |
	| Language              | English                              | |
	| Name                  | Korone - ${staticProjectName}        | |
	| Phone Number          | 555-555-5678                         | |
	| Profile Email Address | osb.koroneiki1@lrcustomer.com.broken | |
	| Region                | United States                        | |
	| Status                | Active                               | |
	| Tier                  | T4                                   | |
	| Website               | www.koroneikicorporation.com         | |''');

		KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korone - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | true                     | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korone - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | true                     | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		JSONOSBAccount.viewSupportOrganizationSync(accountCode = "KORONEKORONE");

		KoroneikiAccountAPI._createAccountTeam(
			accountName = "Korone - ${staticProjectName}",
			teamName = "Koroneiki Partner");

		KoroneikiAccountAPI._assignTeamRolesToTeam(
			accountName = "Korone - ${staticProjectName}",
			table = '''| Partner |''',
			teamName = "Koroneiki Partner");

		OSBAdmin.loginToSupport(
			userEmailAddress = ${staticSupportAdminEmailAdress},
			userPassword = ${staticSupportAdminPassword});

		OSBAdmin.gotoOSBAdmin();

		OSBAdminProject.view(
			projectName = "Korone - ${staticProjectName}",
			table = '''| Koroneiki Account Key | Obtain from project name      |
	| Project Name          | Korone - ${staticProjectName} |
	| Code                  | KORONEKORONE                  |
	| Partner               | Koroneiki Partner             |
	| Tier                  | T4                            |
	| Description           | Test osb account on koroneiki |''');

		ProjectDetails.gotoProjectDetailsPage();

		ProjectDetails.searchKeyword(keyword = "Korone");

		ProjectDetails.gotoProject(projectName = "Korone - ${staticProjectName}");

		ProjectDetails.viewDetails(table = '''| Project Code    | KORONEKORONE          |
	| State           | ACTIVE                |
	| Level           | Platinum Subscription |
	| Support Region  | United States         |
	| Partner         | Koroneiki Partner     |
	| Tier            | T4                    |''');

		ProjectDetails.gotoHistory();

		KoroneikiAccountAPI._generateAccountId(accountName = "Korone - ${staticProjectName}");

		ProjectDetails.viewHistoryEntryByKeyword(
			fieldName = "contactEmailAddress",
			keyword = "Added Account",
			table = '''| Updater Name                | Koroneiki QA Service Producer        |
	| Update Summary              | Added Account                        |
	| Update Date                 | Today                                |
	| Update Field Name           | contactEmailAddress                  |
	| Update Field Original Value | N/A                                  |
	| Update Field New Value      | osb.koroneiki1@lrcustomer.com.broken |''');

		ProjectDetails.viewHistoryEntryByKeyword(
			fieldName = "internal",
			keyword = "Added Account",
			table = '''| Updater Name                | Koroneiki QA Service Producer |
	| Update Summary              | Added Account                 |
	| Update Date                 | Today                         |
	| Update Field Name           | internal                      |
	| Update Field Original Value | N/A                           |
	| Update Field New Value      | false                         |''');

		ProjectDetails.viewHistoryEntryByKeyword(
			fieldName = "code",
			keyword = "Added Account",
			table = '''| Updater Name                | Koroneiki QA Service Producer |
	| Update Summary              | Added Account                 |
	| Update Date                 | Today                         |
	| Update Field Name           | code                          |
	| Update Field Original Value | N/A                           |
	| Update Field New Value      | KORONEKORONE                  |''');

		ProjectDetails.viewHistoryEntryByKeyword(
			fieldName = "region",
			keyword = "Added Account",
			table = '''| Updater Name                | Koroneiki QA Service Producer |
	| Update Summary              | Added Account                 |
	| Update Date                 | Today                         |
	| Update Field Name           | region                        |
	| Update Field Original Value | N/A                           |
	| Update Field New Value      | United States                 |''');

