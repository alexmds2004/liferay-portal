definition {

	property testray.main.component.name = "Support QA";
	property type = "koroneiki";

	tearDown {
		KoroneikiTeamRoleAPI._tearDownTeamRoles(table = '''| Default Account Role  |
	| Default Regular Role  |
	| Optional Account Role |
	| Optional Regular Role |''');
	}

	test Createandviewaccountteamrole {
		KoroneikiTeamRoleAPI._createTeamRole(table = '''| Description | This is the default role for accounts |
	| Name        | Default Account Role                  |
	| Type        | Account                               |''');

		KoroneikiTeamRoleAPI._viewTeamRole(
			table = '''| Description | This is the default role for accounts |
	| Name        | Default Account Role                  |
	| Type        | Account                               |''',
			teamRoleName = "Default Account Role");
	}

	test Createandviewmultipleaccountteamroles {
		KoroneikiTeamRoleAPI._createTeamRole(table = '''| Description | This is the default role for accounts |
	| Name        | Default Account Role                  |
	| Type        | Account                               |''');

		KoroneikiTeamRoleAPI._createTeamRole(table = '''| Description | This is the optional role for accounts |
	| Name        | Optional Account Role                  |
	| Type        | Account                                |''');

		KoroneikiTeamRoleAPI._viewTeamRole(
			table = '''| Description | This is the default role for accounts |
	| Name        | Default Account Role                  |
	| Type        | Account                               |''',
			teamRoleName = "Default Account Role");

		KoroneikiTeamRoleAPI._viewTeamRole(
			table = '''| Description | This is the optional role for accounts |
	| Name        | Optional Account Role                  |
	| Type        | Account                                |''',
			teamRoleName = "Optional Account Role");
	}

	test Createandviewmultipleregularteamroles {
		KoroneikiTeamRoleAPI._createTeamRole(table = '''| Description | This is the default role for regulars |
	| Name        | Default Regular Role                  |
	| Type        | Regular                               |''');

		KoroneikiTeamRoleAPI._createTeamRole(table = '''| Description | This is the optional role for regulars |
	| Name        | Optional Regular Role                  |
	| Type        | Regular                                |''');

		KoroneikiTeamRoleAPI._viewTeamRole(
			table = '''| Description | This is the default role for regulars |
	| Name        | Default Regular Role                  |
	| Type        | Regular                               |''',
			teamRoleName = "Default Regular Role");

		KoroneikiTeamRoleAPI._viewTeamRole(
			table = '''| Description | This is the optional role for regulars |
	| Name        | Optional Regular Role                  |
	| Type        | Regular                                |''',
			teamRoleName = "Optional Regular Role");
	}

	test Createandviewregularteamrole {
		KoroneikiTeamRoleAPI._createTeamRole(table = '''| Description | This is the default role for regulars |
	| Name        | Default Regular Role                  |
	| Type        | Regular                               |''');

		KoroneikiTeamRoleAPI._viewTeamRole(
			table = '''| Description | This is the default role for regulars |
	| Name        | Default Regular Role                  |
	| Type        | Regular                               |''',
			teamRoleName = "Default Regular Role");
	}

	test Deleteaccountteamroleandview {
		KoroneikiTeamRoleAPI._createTeamRole(table = '''| Description | This is the default role for accounts |
	| Name        | Default Account Role                  |
	| Type        | Account                               |''');

		KoroneikiTeamRoleAPI._deleteTeamRole(teamRoleName = "Default Account Role");

		KoroneikiTeamRoleAPI._viewNoTeamRole(teamRoleName = "Default Account Role");
	}

	test Deleteregularteamroleandview {
		KoroneikiTeamRoleAPI._createTeamRole(table = '''| Description | This is the default role for regulars |
	| Name        | Default Regular Role                  |
	| Type        | Regular                               |''');

		KoroneikiTeamRoleAPI._deleteTeamRole(teamRoleName = "Default Regular Role");

		KoroneikiTeamRoleAPI._viewNoTeamRole(teamRoleName = "Default Regular Role");
	}

	test Updateandviewaccountteamrole {
		KoroneikiTeamRoleAPI._createTeamRole(table = '''| Description | This is the default role for accounts |
	| Name        | Default Account Role                  |
	| Type        | Account                               |''');

		KoroneikiTeamRoleAPI._updateTeamRole(
			table = '''| Description | This is the optional role for accounts |
	| Name        | Optional Account Role                  |
	| Type        | Account                                |''',
			teamRoleName = "Default Account Role");

		KoroneikiTeamRoleAPI._viewTeamRole(
			table = '''| Description | This is the optional role for accounts |
	| Name        | Optional Account Role                  |
	| Type        | Account                                |''',
			teamRoleName = "Optional Account Role");

		KoroneikiTeamRoleAPI._viewNoTeamRole(teamRoleName = "Default Account Role");
	}

	test Updateandviewregularteamrole {
		KoroneikiTeamRoleAPI._createTeamRole(table = '''| Description | This is the default role for regulars |
	| Name        | Default Regular Role                  |
	| Type        | Regular                               |''');

		KoroneikiTeamRoleAPI._updateTeamRole(
			table = '''| Description | This is the optional role for regulars |
	| Name        | Optional Regular Role                  |
	| Type        | Regular                                |''',
			teamRoleName = "Default Regular Role");

		KoroneikiTeamRoleAPI._viewTeamRole(
			table = '''| Description | This is the optional role for regulars |
	| Name        | Optional Regular Role                  |
	| Type        | Regular                                |''',
			teamRoleName = "Optional Regular Role");

		KoroneikiTeamRoleAPI._viewNoTeamRole(teamRoleName = "Default Regular Role");
	}

	test Updatenoteamroletypeandview {
		KoroneikiTeamRoleAPI._createTeamRole(table = '''| Description | This is the default role for accounts |
	| Name        | Default Account Role                  |
	| Type        | Account                               |''');

		KoroneikiTeamRoleAPI._createTeamRole(table = '''| Description | This is the default role for accounts |
	| Name        | Default Regular Role                     |
	| Type        | Regular                                  |''');

		KoroneikiTeamRoleAPI._updateTeamRole(
			table = '''| Description | This is the optional role for accounts |
	| Name        | Optional Account Role                  |
	| Type        | Regular                                   |''',
			teamRoleName = "Default Account Role");

		KoroneikiTeamRoleAPI._updateTeamRole(
			table = '''| Description | This is the optional role for regulars |
	| Name        | Optional Regular Role                  |
	| Type        | Account                             |''',
			teamRoleName = "Default Regular Role");

		KoroneikiTeamRoleAPI._viewTeamRole(
			table = '''| Description | This is the optional role for accounts |
	| Name        | Optional Account Role                  |
	| Type        | Account                                |''',
			teamRoleName = "Optional Account Role");

		KoroneikiTeamRoleAPI._viewTeamRole(
			table = '''| Description | This is the optional role for regulars |
	| Name        | Optional Regular Role                  |
	| Type        | Regular                                |''',
			teamRoleName = "Optional Regular Role");
	}

	test Viewteamroleauditentries {
		KoroneikiTeamRoleAPI._createTeamRole(table = '''| Description | This is the default role for accounts |
	| Name        | Default Account Role                  |
	| Type        | Account                               |''');

		KoroneikiTeamRoleAPI._updateTeamRole(
			table = '''| Description | This is the optional role for accounts |
	| Name        | Optional Account Role                  |
	| Type        | Account                                |''',
			teamRoleName = "Default Account Role");

		KoroneikiTeamRoleAPI._viewTeamRoleAuditEntry(
			action = "Add",
			agentName = "Koroneiki QA Service Producer",
			field = "Name",
			newValue = "Default Account Role",
			oldValue = "",
			teamRoleName = "Optional Account Role");

		KoroneikiTeamRoleAPI._viewTeamRoleAuditEntry(
			action = "Update",
			agentName = "Koroneiki QA Service Producer",
			field = "Name",
			newValue = "Optional Account Role",
			oldValue = "Default Account Role",
			teamRoleName = "Optional Account Role");

		KoroneikiTeamRoleAPI._viewTeamRoleAuditEntryViaAuditEntryKey(
			action = "Add",
			agentName = "Koroneiki QA Service Producer",
			field = "Name",
			newValue = "Default Account Role",
			oldValue = "",
			teamRoleName = "Optional Account Role");

		KoroneikiTeamRoleAPI._viewTeamRoleAuditEntryViaAuditEntryKey(
			action = "Update",
			agentName = "Koroneiki QA Service Producer",
			field = "Name",
			newValue = "Optional Account Role",
			oldValue = "Default Account Role",
			teamRoleName = "Optional Account Role");
	}

	test Viewteamroleauditentriesexecutedbyadminandagent {
		KoroneikiTeamRoleAPI._createTeamRole(table = '''| Description | This is the default role for accounts |
	| Name        | Default Account Role                  |
	| Type        | Account                               |''');

		KoroneikiTeamRoleAPI._updateTeamRole(
			table = '''| Agent Name  | Koroneiki User                        |
	| Description | This is the optional role for accounts |
	| Name        | Optional Account Role                  |
	| Type        | Account                                |''',
			teamRoleName = "Default Account Role");

		KoroneikiTeamRoleAPI._viewTeamRoleAuditEntry(
			action = "Add",
			agentName = "Koroneiki QA Service Producer",
			field = "Name",
			newValue = "Default Account Role",
			oldValue = "",
			teamRoleName = "Optional Account Role");

		KoroneikiTeamRoleAPI._viewTeamRoleAuditEntry(
			action = "Update",
			agentName = "Koroneiki User",
			field = "Name",
			newValue = "Optional Account Role",
			oldValue = "Default Account Role",
			teamRoleName = "Optional Account Role");

		KoroneikiTeamRoleAPI._viewTeamRoleAuditEntryViaAuditEntryKey(
			action = "Add",
			agentName = "Koroneiki QA Service Producer",
			field = "Name",
			newValue = "Default Account Role",
			oldValue = "",
			teamRoleName = "Optional Account Role");

		KoroneikiTeamRoleAPI._viewTeamRoleAuditEntryViaAuditEntryKey(
			action = "Update",
			agentName = "Koroneiki User",
			field = "Name",
			newValue = "Optional Account Role",
			oldValue = "Default Account Role",
			teamRoleName = "Optional Account Role");
	}

	test Viewteamroleauditentriesexecutedbyagent {
		KoroneikiTeamRoleAPI._createTeamRole(table = '''| Agent Name  | Koroneiki User                        |
	| Description | This is the default role for accounts |
	| Name        | Default Account Role                  |
	| Type        | Account                               |''');

		KoroneikiTeamRoleAPI._updateTeamRole(
			table = '''| Agent Name  | Koroneiki User                        |
	| Description | This is the optional role for accounts |
	| Name        | Optional Account Role                  |
	| Type        | Account                                |''',
			teamRoleName = "Default Account Role");

		KoroneikiTeamRoleAPI._viewTeamRoleAuditEntry(
			action = "Add",
			agentName = "Koroneiki User",
			field = "Name",
			newValue = "Default Account Role",
			oldValue = "",
			teamRoleName = "Optional Account Role");

		KoroneikiTeamRoleAPI._viewTeamRoleAuditEntry(
			action = "Update",
			agentName = "Koroneiki User",
			field = "Name",
			newValue = "Optional Account Role",
			oldValue = "Default Account Role",
			teamRoleName = "Optional Account Role");

		KoroneikiTeamRoleAPI._viewTeamRoleAuditEntryViaAuditEntryKey(
			action = "Add",
			agentName = "Koroneiki User",
			field = "Name",
			newValue = "Default Account Role",
			oldValue = "",
			teamRoleName = "Optional Account Role");

		KoroneikiTeamRoleAPI._viewTeamRoleAuditEntryViaAuditEntryKey(
			action = "Update",
			agentName = "Koroneiki User",
			field = "Name",
			newValue = "Optional Account Role",
			oldValue = "Default Account Role",
			teamRoleName = "Optional Account Role");
	}

}