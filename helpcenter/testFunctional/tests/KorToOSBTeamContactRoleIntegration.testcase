			keyword2 = "OSB Devlopr Team Liferay Team Role",
			keyword3 = "OSB Koroneiki2",
			positionValue = 1,
			table = '''| Updater Name                | Koroneiki QA Service Producer      |
	| Update Summary              | Updated Team                       |
	| Update Description          | OSB Devlopr Team Liferay Team Role |
	| Update Date                 | Today                              |
	| Update Field Name           | Contact                            |
	| Update Field Original Value | N/A                                |
	| Update Field New Value      | OSB Koroneiki2                     |''');

		LocalFile.ProjectDetails.viewHistoryEntryByThreeKeywordsAndPosition(
			fieldName = "Contact",
			keyword1 = "Updated Team",
			keyword2 = "OSB Devlopr Team Liferay Team Role",
			keyword3 = "OSB Koroneiki1",
			positionValue = 2,
			table = '''| Updater Name                | Koroneiki QA Service Producer      |
	| Update Summary              | Updated Team                       |
	| Update Description          | OSB Devlopr Team Liferay Team Role |
	| Update Date                 | Today                              |
	| Update Field Name           | Contact                            |
	| Update Field Original Value | OSB Koroneiki1                     |
	| Update Field New Value      | N/A                                |''');

		LocalFile.ProjectDetails.viewHistoryEntryByThreeKeywordsAndPosition(
			fieldName = "Contact",
			keyword1 = "Updated Team",
			keyword2 = "OSB Devlopr Team Liferay Team Role",
			keyword3 = "OSB Koroneiki2",
			positionValue = 2,
			table = '''| Updater Name                | Koroneiki QA Service Producer      |
	| Update Summary              | Updated Team                       |
	| Update Description          | OSB Devlopr Team Liferay Team Role |
	| Update Date                 | Today                              |
	| Update Field Name           | Contact                            |
	| Update Field Original Value | OSB Koroneiki2                     |
