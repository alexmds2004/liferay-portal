			productName = "DXP Production");

		LocalFile.KoroneikiProductPurchaseAPI._generateProductPurchaseKey(
			accountName = "Procst - ${staticProjectName}",
			productName = "DXP Production");

		LocalFile.ProvisioningLicenseAPI.createLicenseViaSessionId(
			accountName = "Procst - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| Name               | Procst - ${staticProjectName} License1 Name        |
	| Description        | Procst - ${staticProjectName} License1 Description |
	| Active             | true                                               |
	| Expiration Date    | ${staticEndDate}                                   |
	| License Entry Type | production                                         |
	| Max Cluster Nodes  | 0                                                  |
	| Product Version    | 7.4                                                |
	| Start Date         | ${staticStartDate}                                 |''');

		LocalFile.ProvisioningLicenseAPI._viewLicense(
			accountName = "Procst - ${staticProjectName}",
			licenseName = "Procst - ${staticProjectName} License1 Name",
			table = '''| Name                  | Procst - ${staticProjectName} License1 Name        |
	| Complimentary         | false                                              |
	| Description           | Procst - ${staticProjectName} License1 Description |
	| Host Name             | localhost                                          |
	| IP Addresses          | 123.45.67.89                                       |
	| MAC Addresses         | 0A-1B-2C-3D-4E-5F                                  |
	| Instance Size         | 1                                                  |
	| Maximum Cluster Nodes | 0                                                  |
	| Product Name          | DXP Production                                     |''');

		LocalFile.KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		LocalFile.ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		LocalFile.JSONOkta.viewOktaUserGroupMembership(
			groupName = "Customer",
			userEmailAddress = ${staticEmailValue1});

		LocalFile.OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		LocalFile.Provisioning.gotoAccounts();

		LocalFile.Provisioning.searchAccounts(keyword = "Procst - ${staticProjectName}");

		LocalFile.Provisioning.clickAccount(accountName = "Procst - ${staticProjectName}");

		LocalFile.ProvisioningAccount.clickSyncToCustomerPortalButton();

		LocalFile.Okta.logoutOfDevDomain();

		LocalFile.CustomerLogin.loginToCustomer(
			userEmailAddress = ${staticEmailValue1},
			userPassword = ${staticOktaUserPassword});

		LocalFile.CustomerProjects.clickCustomerProject(projectName = "Procst - ${staticProjectName}");

		LocalFile.CustomerProjects._clickStartProjectSetup();

		LocalFile.CustomerProjects._clickSkipInviteTeamMember();

		LocalFile.CustomerProjectNavigation.chooseSubscriptionAtActivationTab(subscription = "DXP");

		LocalFile.CustomerProjectActivationKeys.seachActivationKey(keyword = "Procst - ${staticProjectName}");

		LocalFile.CustomerProjectActivationKeys.viewActivatonKey(
			key_licenseKeyword = "Procst - ${staticProjectName} License1 Name",
			table = '''| Environment Name         | Procst - ${staticProjectName} License1 Name        |
	| Description              | Procst - ${staticProjectName} License1 Description |
	| Key Type                 | On-Premise                                         |
	| Host Name / Cluster Size | localhost                                          |
	| Environment Type         | DXP Production                                     |
	| Status                   | Activated                                          |''');
	}

	test ViewPortalProductionlicenseoncustomer {
		LocalFile.KoroneikiAccountAPI._createAccount(table = '''| Account Field and Value | liferayVersion                       | DXP 7.4 |
	| Code                    | CSTPROPROCST                         |         |
	| Contact Email Address   | lic.koroneiki1@lrcustomer.com.broken |         |
	| Description             | Test osb account on koroneiki        |         |
	| Fax Number              | 555-555-1234                         |         |
	| Name                    | Procst - ${staticProjectName}        |         |
	| Phone Number            | 555-555-5678                         |         |
	| Profile Email Address   | lic.koroneiki1@lrcustomer.com.broken |         |
