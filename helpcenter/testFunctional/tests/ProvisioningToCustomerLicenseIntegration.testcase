definition {

	property testray.main.component.name = "Support QA";
	property type = "customer.integration";

	setUp {
		Passwords.getPasswords();

		Sites.getLinks();

		OSBAdminRabbitMQ.generateStaticVariables();

		KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		KoroneikiProductPurchaseAPI.generateStaticFullFutureStartAndEndDate();

		KoroneikiProductPurchaseAPI.generateStaticFutureStartAndEndDate();

		KoroneikiProductPurchaseAPI.generateStaticFullStartAndEndDate();

		KoroneikiProductPurchaseAPI.generateStaticFullNonAbbreviatedStartAndEndDate();

		KoroneikiProductPurchaseAPI.generateStaticFullNonAbbreviatedFutureStartAndEndDate();

		KoroneikiProductPurchaseAPI.generateStaticEndDates();

		KoroneikiProductPurchaseAPI.generateStaticStartDates();

		KoroneikiProductPurchaseAPI.generateStaticYyyyMmDdFutureStartAndEndDate();

		OSBAdminRabbitMQ.generateProvisioningCompanyName();

		OSBAdminRabbitMQ.generateProvisioningProjectName();

		Data.generateSupportUser();

		Data._renameFirstSupportUserVariables();

		JSONOkta.createOktaUser(table = '''| Screen Name   | ${staticScreenNameValue1}       |
	| Email Address | ${staticEmailValue1}            |
	| First Name    | ${staticContactFirstNameValue1} |
	| Last Name     | ${staticContactLastNameValue1}  |''');

		Data.generateSupportUser();

		Data._renameSecondSupportUserVariables();

		JSONOkta.createOktaUser(table = '''| Screen Name   | ${staticScreenNameValue2}       |
	| Email Address | ${staticEmailValue2}            |
	| First Name    | ${staticContactFirstNameValue2} |
	| Last Name     | ${staticContactLastNameValue2}  |''');
	}

	tearDown {
		ZendeskUserAPI._getDefaultUserId(organizationName = "Procst - ${staticProjectName}");

		ZendeskUserAPI._renameFirstDefaultUserIdVariable();

		ZendeskUserAPI._getDefaultUserId(organizationName = "Cstpro - ${staticCompanyName}");

		ZendeskUserAPI._renameSecondDefaultUserIdVariable();

		KoroneikiProductConsumptionAPI._tearDownProductConsumptionList(
			accountName = "Procst - ${staticProjectName}",
			table = '''| DXP Production                    |
	| Portal Production                 |
	| Commerce Subscription Development |
	| Platinum Subscription             |''');

		KoroneikiProductConsumptionAPI._tearDownProductConsumptions(
			accountName = "Procst - ${staticProjectName}",
			table = '''| DXP Production                    |
	| Portal Production                 |
	| Commerce Subscription Development |
	| Platinum Subscription             |''');

		ZendeskUserAPI._getDefaultUserId(organizationName = "Procst - ${staticProjectName}");

		KoroneikiProductConsumptionAPI._tearDownProductConsumptionList(
			accountName = "Procst - ${staticProjectName}",
			table = '''| DXP Production                    |
	| Portal Production                 |
	| Commerce Subscription Development |
	| Platinum Subscription             |''');

		OSBAdminProject.tearDownProjects(table = '''| CSTPROPROCST |
	| CSTPRO       |''');

		KoroneikiAccountAPI._tearDownAccounts(table = '''| Procst - ${staticProjectName} |
	| Cstpro - ${staticCompanyName} |''');

		KoroneikiAccountAPI._tearDownAccountsViaAccountFieldNameAndValue(
			fieldName = "Code",
			table = '''| CSTPROPROCST |
	| CSTPRO       |''');

		JSONUser.tearDownUsers(table = '''| ${staticEmailValue1} |
	| ${staticEmailValue2} |''');

		JSONUser.tearDownUsersViaSupport(table = '''| ${staticEmailValue1} |
	| ${staticEmailValue2} |''');

		JSONUser.tearDownUsersViaKoroneiki(table = '''| ${staticEmailValue1} |
	| ${staticEmailValue2} |''');

		KoroneikiContactAPI._tearDownContacts(table = '''| ${staticEmailValue1} |
	| ${staticEmailValue2} |''');

		JSONOkta.tearDownUsers(table = '''| ${staticEmailValue1} |
	| ${staticEmailValue2} |''');

		ZendeskTicketAPI._tearDownTicketsByKeywords(table = '''| New Subscription(s) for Procst - ${staticProjectName} |
	| New Subscription(s) for Cstpro - ${staticCompanyName} |''');

		ZendeskUserAPI._getMultipleUserIdsByEmailAddress(table = '''| ${staticEmailValue1} |
	| ${staticEmailValue2} |''');

		ZendeskUserAPI._tearDownUsersByIdList(userIds = ${staticUserIdList});

		ZendeskOrganizationAPI._getMultipleOrganizationExternalIdsByOrganizationNameIfStillPresent(table = '''| Procst - ${staticProjectName} |
	| Cstpro - ${staticCompanyName} |''');

		ZendeskOrganizationAPI._tearDownOrganizationsByExternalIdList(organizationExternalIds = ${staticOrganizationExternalIdList});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId1});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId2});
	}

	test DownloadCommerceactivationkeyoncustomer {
		KoroneikiAccountAPI._createAccount(table = '''| Account Field and Value | liferayVersion                       | DXP 7.2 |
	| Code                    | CSTPROPROCST                         |         |
	| Contact Email Address   | lic.koroneiki1@lrcustomer.com.broken |         |
	| Description             | Test osb account on koroneiki        |         |
	| Fax Number              | 555-555-1234                         |         |
	| Name                    | Procst - ${staticProjectName}        |         |
	| Phone Number            | 555-555-5678                         |         |
	| Profile Email Address   | lic.koroneiki1@lrcustomer.com.broken |         |
	| Region                  | United States                        |         |
	| Status                  | Active                               |         |
	| Tier                    | T4                                   |         |
	| Website                 | www.koroneikicorporation.com         |         |''');

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Procst - ${staticProjectName}",
			contactEmailAddress = ${staticEmailValue1},
			table = '''| Support Administrator |''');

		Okta._loginToDevDomain(
			userEmailAddress = ${staticEmailValue1},
			userPassword = ${staticOktaUserPassword});

		Okta._getOktaSessionIdDevPage();

		KoroneikiAccountAPI._generateAccountKey(accountName = "Procst - ${staticProjectName}");

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Procst - ${staticProjectName}",
			productName = "Commerce Subscription Development",
			table = '''| End Date                | ${staticEndDate}         |   |
	| Original End Date       | ${staticOriginalEndDate} |   |
	| Perpetual               | false                    |   |
	| Product Field and Value | sizing                   | 1 |
	| Product Field and Value | licenses                 | 1 |
	| Product Field and Value | version                  | 7 |
	| Quantity                | 1                        |   |
	| Start Date              | ${staticStartDate}       |   |
	| Status                  | Approved                 |   |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Procst - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiProductPurchaseAPI._generateProductPurchaseId(
			accountName = "Procst - ${staticProjectName}",
			productName = "Commerce Subscription Development");

		KoroneikiProductPurchaseAPI._generateProductPurchaseKey(
			accountName = "Procst - ${staticProjectName}",
			productName = "Commerce Subscription Development");

		ProvisioningLicenseAPI.createLicenseViaSessionId(
			accountName = "Procst - ${staticProjectName}",
			productName = "Commerce Subscription Development",
			table = '''| Name               | Procst - ${staticProjectName} License1 Name        |
	| Description        | Procst - ${staticProjectName} License1 Description |
	| Active             | true                                               |
	| Expiration Date    | ${staticEndDate}                                   |
	| License Entry Type | developer                                          |
	| Max Cluster Nodes  | 0                                                  |
	| Product Version    | 7.2                                                |
	| Start Date         | ${staticStartDate}                                 |''');

		ProvisioningLicenseAPI._viewLicense(
			accountName = "Procst - ${staticProjectName}",
			licenseName = "Procst - ${staticProjectName} License1 Name",
			table = '''| Name                  | Procst - ${staticProjectName} License1 Name        |
	| Complimentary         | false                                              |
	| Description           | Procst - ${staticProjectName} License1 Description |
	| Host Name             | localhost                                          |
	| IP Addresses          | 123.45.67.89                                       |
	| MAC Addresses         | 0A-1B-2C-3D-4E-5F                                  |
	| Instance Size         | 1                                                  |
	| Maximum Cluster Nodes | 0                                                  |
	| Product Name          | Commerce Subscription Development                  |''');

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		JSONOkta.viewOktaUserGroupMembership(
			groupName = "Customer",
			userEmailAddress = ${staticEmailValue1});

		OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		Provisioning.gotoAccounts();

		Provisioning.searchAccounts(keyword = "Procst - ${staticProjectName}");

		Provisioning.clickAccount(accountName = "Procst - ${staticProjectName}");

		ProvisioningAccount.clickSyncToCustomerPortalButton();

		Okta.logoutOfDevDomain();

		CustomerLogin.loginToCustomer(
			userEmailAddress = ${staticEmailValue1},
			userPassword = ${staticOktaUserPassword});

		CustomerProjects.clickCustomerProject(projectName = "Procst - ${staticProjectName}");

		CustomerProjects._clickStartProjectSetup();

		CustomerProjects._clickSkipInviteTeamMember();

		CustomerProjectNavigation.chooseSubscriptionAtActivationTab(subscription = "Commerce");

		CustomerProjectActivationKeys.populateActivationKeyDownloadDropdown(table = '''| Subscription      | Development                             |
	| Subscription Term | staticFullStartDate - staticFullEndDate |''');
	}

	test ViewDXPProductionlicenseoncustomer {
		KoroneikiAccountAPI._createAccount(table = '''| Account Field and Value | liferayVersion                       | DXP 7.4 |
	| Code                    | CSTPROPROCST                         |         |
	| Contact Email Address   | lic.koroneiki1@lrcustomer.com.broken |         |
	| Description             | Test osb account on koroneiki        |         |
	| Fax Number              | 555-555-1234                         |         |
	| Name                    | Procst - ${staticProjectName}        |         |
	| Phone Number            | 555-555-5678                         |         |
	| Profile Email Address   | lic.koroneiki1@lrcustomer.com.broken |         |
	| Region                  | United States                        |         |
	| Status                  | Active                               |         |
	| Tier                    | T4                                   |         |
	| Website                 | www.koroneikicorporation.com         |         |''');

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Procst - ${staticProjectName}",
			contactEmailAddress = ${staticEmailValue1},
			table = '''| Support Administrator |''');

		Okta._loginToDevDomain(
			userEmailAddress = ${staticEmailValue1},
			userPassword = ${staticOktaUserPassword});

		Okta._getOktaSessionIdDevPage();

		KoroneikiAccountAPI._generateAccountKey(accountName = "Procst - ${staticProjectName}");

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Procst - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| End Date                | ${staticEndDate}         |   |
	| Original End Date       | ${staticOriginalEndDate} |   |
	| Perpetual               | false                    |   |
	| Product Field and Value | sizing                   | 1 |
	| Product Field and Value | licenses                 | 1 |
	| Product Field and Value | version                  | 7 |
	| Quantity                | 1                        |   |
	| Start Date              | ${staticStartDate}       |   |
	| Status                  | Approved                 |   |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Procst - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiProductPurchaseAPI._generateProductPurchaseId(
			accountName = "Procst - ${staticProjectName}",
			productName = "DXP Production");

		KoroneikiProductPurchaseAPI._generateProductPurchaseKey(
			accountName = "Procst - ${staticProjectName}",
			productName = "DXP Production");

		ProvisioningLicenseAPI.createLicenseViaSessionId(
			accountName = "Procst - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| Name               | Procst - ${staticProjectName} License1 Name        |
	| Description        | Procst - ${staticProjectName} License1 Description |
	| Active             | true                                               |
	| Expiration Date    | ${staticEndDate}                                   |
	| License Entry Type | production                                         |
	| Max Cluster Nodes  | 0                                                  |
	| Product Version    | 7.4                                                |
	| Start Date         | ${staticStartDate}                                 |''');

		ProvisioningLicenseAPI._viewLicense(
			accountName = "Procst - ${staticProjectName}",
			licenseName = "Procst - ${staticProjectName} License1 Name",
			table = '''| Name                  | Procst - ${staticProjectName} License1 Name        |
	| Complimentary         | false                                              |
	| Description           | Procst - ${staticProjectName} License1 Description |
	| Host Name             | localhost                                          |
	| IP Addresses          | 123.45.67.89                                       |
	| MAC Addresses         | 0A-1B-2C-3D-4E-5F                                  |
	| Instance Size         | 1                                                  |
	| Maximum Cluster Nodes | 0                                                  |
	| Product Name          | DXP Production                                     |''');

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		JSONOkta.viewOktaUserGroupMembership(
			groupName = "Customer",
			userEmailAddress = ${staticEmailValue1});

		OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		Provisioning.gotoAccounts();

		Provisioning.searchAccounts(keyword = "Procst - ${staticProjectName}");

		Provisioning.clickAccount(accountName = "Procst - ${staticProjectName}");

		ProvisioningAccount.clickSyncToCustomerPortalButton();

		Okta.logoutOfDevDomain();

		CustomerLogin.loginToCustomer(
			userEmailAddress = ${staticEmailValue1},
			userPassword = ${staticOktaUserPassword});

		CustomerProjects.clickCustomerProject(projectName = "Procst - ${staticProjectName}");

		CustomerProjects._clickStartProjectSetup();

		CustomerProjects._clickSkipInviteTeamMember();

		CustomerProjectNavigation.chooseSubscriptionAtActivationTab(subscription = "DXP");

		CustomerProjectActivationKeys.seachActivationKey(keyword = "Procst - ${staticProjectName}");

		CustomerProjectActivationKeys.viewActivatonKey(
			key_licenseKeyword = "Procst - ${staticProjectName} License1 Name",
			table = '''| Environment Name         | Procst - ${staticProjectName} License1 Name        |
	| Description              | Procst - ${staticProjectName} License1 Description |
	| Key Type                 | On-Premise                                         |
	| Host Name / Cluster Size | localhost                                          |
	| Environment Type         | DXP Production                                     |
	| Status                   | Activated                                          |''');
	}

	test ViewPortalProductionlicenseoncustomer {
		KoroneikiAccountAPI._createAccount(table = '''| Account Field and Value | liferayVersion                       | DXP 7.4 |
	| Code                    | CSTPROPROCST                         |         |
	| Contact Email Address   | lic.koroneiki1@lrcustomer.com.broken |         |
	| Description             | Test osb account on koroneiki        |         |
	| Fax Number              | 555-555-1234                         |         |
	| Name                    | Procst - ${staticProjectName}        |         |
	| Phone Number            | 555-555-5678                         |         |
	| Profile Email Address   | lic.koroneiki1@lrcustomer.com.broken |         |
	| Region                  | United States                        |         |
	| Status                  | Active                               |         |
	| Tier                    | T4                                   |         |
	| Website                 | www.koroneikicorporation.com         |         |''');

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Procst - ${staticProjectName}",
			contactEmailAddress = ${staticEmailValue1},
			table = '''| Support Administrator |''');

		Okta._loginToDevDomain(
			userEmailAddress = ${staticEmailValue1},
			userPassword = ${staticOktaUserPassword});

		Okta._getOktaSessionIdDevPage();

		KoroneikiAccountAPI._generateAccountKey(accountName = "Procst - ${staticProjectName}");

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Procst - ${staticProjectName}",
			productName = "Portal Production",
			table = '''| End Date                | ${staticEndDate}         |   |
	| Original End Date       | ${staticOriginalEndDate} |   |
	| Perpetual               | false                    |   |
	| Product Field and Value | sizing                   | 1 |
	| Product Field and Value | licenses                 | 1 |
	| Product Field and Value | version                  | 7 |
	| Quantity                | 1                        |   |
	| Start Date              | ${staticStartDate}       |   |
	| Status                  | Approved                 |   |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Procst - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiProductPurchaseAPI._generateProductPurchaseId(
			accountName = "Procst - ${staticProjectName}",
			productName = "Portal Production");

		KoroneikiProductPurchaseAPI._generateProductPurchaseKey(
			accountName = "Procst - ${staticProjectName}",
			productName = "Portal Production");

		ProvisioningLicenseAPI.createLicenseViaSessionId(
			accountName = "Procst - ${staticProjectName}",
			productName = "Portal Production",
			table = '''| Name               | Procst - ${staticProjectName} License1 Name        |
	| Description        | Procst - ${staticProjectName} License1 Description |
	| Active             | true                                               |
	| Expiration Date    | ${staticEndDate}                                   |
	| License Entry Type | production                                         |
	| Max Cluster Nodes  | 0                                                  |
	| Product Version    | 7.4                                                |
	| Start Date         | ${staticStartDate}                                 |''');

		ProvisioningLicenseAPI._viewLicense(
			accountName = "Procst - ${staticProjectName}",
			licenseName = "Procst - ${staticProjectName} License1 Name",
			table = '''| Name                  | Procst - ${staticProjectName} License1 Name        |
	| Complimentary         | false                                              |
	| Description           | Procst - ${staticProjectName} License1 Description |
	| Host Name             | localhost                                          |
	| IP Addresses          | 123.45.67.89                                       |
	| MAC Addresses         | 0A-1B-2C-3D-4E-5F                                  |
	| Instance Size         | 1                                                  |
	| Maximum Cluster Nodes | 0                                                  |
	| Product Name          | Portal Production                                  |''');

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		JSONOkta.viewOktaUserGroupMembership(
			groupName = "Customer",
