definition {

	property testray.main.component.name = "Support QA";
	property type = "provisioning.integration";

	setUp {
		LocalFile.Passwords.getPasswords();

		LocalFile.OSBAdminRabbitMQ.generateStaticVariables();

		LocalFile.OSBAdminRabbitMQ.generateProvisioningCompanyName();

		LocalFile.OSBAdminRabbitMQ.generateProvisioningProjectName();

		LocalFile.JSONOkta.createOktaUser(table = '''| Screen Name   | pro.koroneiki1                       |
	| Email Address | pro.koroneiki1@lrcustomer.com.broken |
	| First Name    | PRO                                  |
	| Last Name     | Koroneiki1                           |''');

		LocalFile.JSONOkta.createOktaUser(table = '''| Screen Name   | pro.koroneiki2                       |
	| Email Address | pro.koroneiki2@lrcustomer.com.broken |
	| First Name    | PRO                                  |
	| Last Name     | Koroneiki2                           |''');

		LocalFile.JSONOkta.createOktaUser(table = '''| Screen Name   | pro.koroneiki3                       |
	| Email Address | pro.koroneiki3@lrcustomer.com.broken |
	| First Name    | PRO                                  |
	| Last Name     | Koroneiki3                           |''');

		LocalFile.JSONOkta.createOktaUser(table = '''| Screen Name   | pro.koroneiki4                       |
	| Email Address | pro.koroneiki4@lrcustomer.com.broken |
	| First Name    | PRO                                  |
	| Last Name     | Koroneiki4                           |''');
	}

	tearDown {
		LocalFile.ZendeskUserAPI._getDefaultUserId(organizationName = "Korpro - ${staticProjectName}");

		LocalFile.ZendeskUserAPI._renameFirstDefaultUserIdVariable();

		LocalFile.ZendeskUserAPI._getDefaultUserId(organizationName = "Onepro - ${staticProjectName}");

		LocalFile.ZendeskUserAPI._renameSecondDefaultUserIdVariable();

		LocalFile.ZendeskUserAPI._getDefaultUserId(organizationName = "Prokor - ${staticCompanyName}");

		LocalFile.ZendeskUserAPI._renameThirdDefaultUserIdVariable();

		LocalFile.ZendeskUserAPI._getDefaultUserId(organizationName = "Proone - ${staticCompanyName}");

		LocalFile.ZendeskUserAPI._renameFourthDefaultUserIdVariable();

		LocalFile.OSBAdminProject.tearDownProjects(table = '''| PROKORKORPRO |
	| PROONEONEPRO |
	| PROKORONEPRO |
	| PROKOR       |
	| PROONE       |''');

		LocalFile.KoroneikiAccountAPI._tearDownAccounts(table = '''| Korpro - ${staticProjectName} |
	| Onepro - ${staticProjectName} |
	| Prokor - ${staticCompanyName} |
	| Proone - ${staticCompanyName} |''');

		LocalFile.KoroneikiAccountAPI._tearDownAccountsViaAccountFieldNameAndValue(
			fieldName = "Code",
			table = '''| PROKORKORPRO |
	| PROONEONEPRO |
	| PROKORONEPRO |
	| PROKOR       |
	| PROONE       |''');

		LocalFile.KoroneikiProductAPI._tearDownProducts(table = '''| A Liferay DXP Product    |
	| A Liferay Portal Product |
	| Random Subscription      |
	| Nonexistent Subscription |''');

		LocalFile.JSONUser.tearDownUsers(table = '''| pro.koroneiki1@lrcustomer.com.broken |
	| pro.koroneiki2@lrcustomer.com.broken |
	| pro.koroneiki3@lrcustomer.com.broken |
	| pro.koroneiki4@lrcustomer.com.broken |''');

		LocalFile.JSONUser.tearDownUsersViaSupport(table = '''| pro.koroneiki1@lrcustomer.com.broken |
	| pro.koroneiki2@lrcustomer.com.broken |
	| pro.koroneiki3@lrcustomer.com.broken |
	| pro.koroneiki4@lrcustomer.com.broken |''');

		LocalFile.JSONUser.tearDownUsersViaKoroneiki(table = '''| pro.koroneiki1@lrcustomer.com.broken |
	| pro.koroneiki2@lrcustomer.com.broken |
	| pro.koroneiki3@lrcustomer.com.broken |
	| pro.koroneiki4@lrcustomer.com.broken |''');

		LocalFile.KoroneikiContactAPI._tearDownContacts(table = '''| pro.koroneiki1@lrcustomer.com.broken |
	| pro.koroneiki2@lrcustomer.com.broken |
	| pro.koroneiki3@lrcustomer.com.broken |
	| pro.koroneiki4@lrcustomer.com.broken |''');

		LocalFile.JSONOkta.tearDownUsers(table = '''| pro.koroneiki1@lrcustomer.com.broken |
	| pro.koroneiki2@lrcustomer.com.broken |
	| pro.koroneiki3@lrcustomer.com.broken |
	| pro.koroneiki4@lrcustomer.com.broken |''');

		LocalFile.ZendeskTicketAPI._tearDownTicketsByKeywords(table = '''| New Subscription(s) for Korpro - ${staticProjectName} |
	| New Subscription(s) for Onepro - ${staticProjectName} |
	| New Subscription(s) for Prokor - ${staticCompanyName} |
	| New Subscription(s) for Proone - ${staticCompanyName} |''');

		LocalFile.ZendeskUserAPI._getMultipleUserIdsByEmailAddress(table = '''| pro.koroneiki1@lrcustomer.com.broken |
	| pro.koroneiki2@lrcustomer.com.broken |
	| pro.koroneiki3@lrcustomer.com.broken |
	| pro.koroneiki4@lrcustomer.com.broken |''');

		LocalFile.ZendeskUserAPI._tearDownUsersByIdList(userIds = ${staticUserIdList});

		LocalFile.ZendeskOrganizationAPI._getMultipleOrganizationExternalIdsByOrganizationNameIfStillPresent(table = '''| Korpro - ${staticProjectName} |
	| Onepro - ${staticProjectName} |
	| Prokor - ${staticCompanyName} |
	| Proone - ${staticCompanyName} |''');

		LocalFile.ZendeskOrganizationAPI._tearDownOrganizationsByExternalIdList(organizationExternalIds = ${staticOrganizationExternalIdList});

		LocalFile.ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId1});

		LocalFile.ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId2});

		LocalFile.ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId3});

		LocalFile.ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId4});
	}

	@help.center.acceptance = "true"
	test Createentities {
		LocalFile.OSBAdminRabbitMQ.publishCreateProjectWithNoPartnerMessage(
			routingKey = "dossiera.provisioning.create",
			table = '''| Account Name                           | Prokor - ${staticCompanyName}              |
	| Address City                           | Diamond Bar                                |
	| Address Country                        | United States                              |
	| Address Postal Code                    | 91765                                      |
	| Address Region                         | California                                 |
	| Address Street                         | 456 Fake Street                            |
	| Contact Email Address                  | pro.koroneiki1@lrcustomer.com.broken       |
	| Contact First Name                     | PRO                                        |
	| Contact Last Name                      | Koroneiki1                                 |
	| Dossiera Account Key                   | ${staticDossieraAccountKey}                |
	| Dossiera Address Key 1                 | ${staticDossieraAddressKey1}               |
	| Dossiera Address Key 2                 | ${staticDossieraAddressKey2}               |
	| Dossiera Contact Key                   | ${staticDossieraContactKey}                |
	| Dossiera Project Key                   | ${staticDossieraProjectKey}                |
	| End Day                                | ${staticEndDay}                            |
	| End Month                              | ${staticEndMonth}                          |
	| End Year                               | ${staticEndYear}                           |
	| Industry                               | Automotive                                 |
	| Owner Email Address                    | pro.koroneiki2@lrcustomer.com.broken       |
	| Owner First Name                       | PRO                                        |
	| Owner Last Name                        | Koroneiki2                                 |
	| Partner First Line Support             | false                                      |
	| Product Type                           | New                                        |
	| Product Name                           | Liferay Digital Enterprise - Prod Sizing 4 |
	| Project Name                           | Korpro - ${staticProjectName}              |
	| Renewal                                | false                                      |
	| Salesforce Opportunity Key             | ${staticSalesforceOpportunityKey}          |
	| Salesforce Opportunity Line Item Key 1 | ${staticSalesforceOpportunityLineItemKey1} |
	| Salesforce Opportunity Line Item Key 2 | ${staticSalesforceOpportunityLineItemKey2} |
	| Salesforce Opportunity Sold By         | Liferay US                                 |
	| Salesforce Opportunity Stage Name      | Closed Won                                 |
	| Salesforce Opportunity Territory       | United States                              |
	| Salesforce Opportunity Type            | New Business                               |
	| Salesforce Owner User Key              | ${staticSalesforceOwnerUserKey}            |
	| Salesforce Project Key                 | ${staticSalesforceProjectKey}              |
	| Start Day                              | ${staticStartDay}                          |
	| Start Month                            | ${staticStartMonth}                        |
	| Start Year                             | ${staticStartYear}                         |
	| Subscription Level                     | Platinum                                   |
	| Version Number                         | 7.1                                        |''');

		LocalFile.KoroneikiAccountAPI._viewAccount(
			accountName = "Korpro - ${staticProjectName}",
			table = '''| Account Field and Value | liferayVersion                       | DXP 7.1 | |
	| Code                    | PROKORKORPRO                         |         | |
	| Parent Account Name     | Prokor - ${staticCompanyName}        |         | |
	| Contact Email Address   | pro.koroneiki2@lrcustomer.com.broken |         | |
	| Name                    | Korpro - ${staticProjectName}        |         | |
	| Region                  | United States                        |         | |
	| Language                | English                              |         | |
	| Status                  | Active                               |         | |''');

		LocalFile.KoroneikiPostalAddressAPI._viewPostalAddress(
			accountName = "Korpro - ${staticProjectName}",
			streetAddressLine1 = "456 Fake Street",
			table = '''| Country               | United States   |
	| Locality              | Diamond Bar     |
	| Region                | California      |
	| Postal Code           | 91765           |
	| Street Address Line 1 | 456 Fake Street |''');

		LocalFile.KoroneikiAccountAPI._viewAccountExternalLinkViaIdAndDomain(
			accountName = "Korpro - ${staticProjectName}",
			domain = "salesforce",
			entityId = ${staticDossieraAccountKey},
			table = '''| Domain      | salesforce                  |
	| Entity Id   | ${staticDossieraAccountKey} |
	| Entity Name | account                     |''');

		LocalFile.KoroneikiAccountAPI._viewAccountExternalLinkViaIdAndDomain(
			accountName = "Korpro - ${staticProjectName}",
			domain = "dossiera",
			entityId = ${staticDossieraProjectKey},
			table = '''| Domain      | dossiera                    |
	| Entity Id   | ${staticDossieraProjectKey} |
	| Entity Name | project                     |''');

		LocalFile.KoroneikiAccountAPI._viewAccountExternalLink(
			accountName = "Korpro - ${staticProjectName}",
			entityId = ${staticSalesforceProjectKey},
			table = '''| Domain      | salesforce                    |
	| Entity Id   | ${staticSalesforceProjectKey} |
	| Entity Name | project                       |''');

		LocalFile.KoroneikiAccountAPI._viewAccountExternalLinkViaIdAndDomain(
			accountName = "Prokor - ${staticCompanyName}",
			domain = "salesforce",
			entityId = ${staticDossieraAccountKey},
			table = '''| Domain      | salesforce                  |
	| Entity Id   | ${staticDossieraAccountKey} |
	| Entity Name | account                     |''');

		LocalFile.KoroneikiAccountAPI._viewAccountExternalLinkViaIdAndDomain(
			accountName = "Prokor - ${staticCompanyName}",
			domain = "dossiera",
			entityId = ${staticDossieraAccountKey},
			table = '''| Domain      | dossiera                    |
	| Entity Id   | ${staticDossieraAccountKey} |
	| Entity Name | account                     |''');

		LocalFile.KoroneikiProductPurchaseAPI._viewProductPurchaseExternalLink(
			accountName = "Korpro - ${staticProjectName}",
			entityId = ${staticSalesforceOpportunityKey},
			productName = "DXP Production",
			table = '''| Domain      | salesforce                        |
	| Entity Id   | ${staticSalesforceOpportunityKey} |
	| Entity Name | opportunity                       |''');

		LocalFile.KoroneikiProductPurchaseAPI._viewProductPurchaseExternalLink(
			accountName = "Korpro - ${staticProjectName}",
			entityId = ${staticSalesforceOpportunityKey},
			productName = "Platinum Subscription",
			table = '''| Domain      | salesforce                        |
	| Entity Id   | ${staticSalesforceOpportunityKey} |
	| Entity Name | opportunity                       |''');

		LocalFile.KoroneikiContactAPI._viewContactViaEmailAddress(
			contactEmailAddress = "pro.koroneiki1@lrcustomer.com.broken",
			table = '''| Email Address | pro.koroneiki1@lrcustomer.com.broken |
	| First Name    | PRO                                  |
	| Last Name     | Koroneiki1                           |''');

		LocalFile.KoroneikiContactAPI._viewContactViaEmailAddress(
			contactEmailAddress = "pro.koroneiki2@lrcustomer.com.broken",
			table = '''| Email Address | pro.koroneiki2@lrcustomer.com.broken |
	| First Name    | PRO                                  |
	| Last Name     | Koroneiki2                           |''');

		LocalFile.KoroneikiAccountAPI._viewContactRole(
			accountName = "Korpro - ${staticProjectName}",
			contactEmailAddress = "pro.koroneiki1@lrcustomer.com.broken",
			contactRoleName = "Support Administrator");

		LocalFile.KoroneikiAccountAPI._viewContactRole(
			accountName = "Korpro - ${staticProjectName}",
			contactEmailAddress = "pro.koroneiki2@lrcustomer.com.broken",
			contactRoleName = "Liferay Sales");

		LocalFile.KoroneikiAccountAPI._viewContactRole(
			accountName = "Korpro - ${staticProjectName}",
			contactEmailAddress = "pro.koroneiki2@lrcustomer.com.broken",
			contactRoleName = "Secondary Contact");

		LocalFile.KoroneikiProductPurchaseAPI._viewProductPurchase(
			accountName = "Korpro - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| Quantity | 1        | |
	| Status   | Approved | |''');

		LocalFile.KoroneikiProductPurchaseAPI._viewProductPurchase(
			accountName = "Korpro - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| Quantity | 1        | |
	| Status   | Approved | |''');

		LocalFile.KoroneikiContactAPI._viewContactUuidAndUserUuidComparison(contactEmailAddress = "pro.koroneiki1@lrcustomer.com.broken");

		LocalFile.KoroneikiContactAPI._viewContactUuidAndUserUuidComparison(contactEmailAddress = "pro.koroneiki2@lrcustomer.com.broken");
	}

	test SendaLXCSubscriptionEngageSitemessagebyRabbitMQ {
		LocalFile.OSBAdminRabbitMQ.publishCreateProjectWithNoPartnerMessage(
			routingKey = "dossiera.provisioning.create",
			table = '''| Account Name                           | Prokor - ${staticCompanyName}              |
	| Address City                           | Diamond Bar                                |
	| Address Country                        | United States                              |
	| Address Postal Code                    | 91765                                      |
	| Address Region                         | California                                 |
	| Address Street                         | 456 Fake Street                            |
