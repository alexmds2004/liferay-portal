	test SendanLXCBusinessPlanandaddonmessagebyRabbitMQ {
		LocalFile.OSBAdminRabbitMQ.publishCreateProjectWithMultipleContactsAndProductsAndNoPartnerMessage(
			routingKey = "dossiera.provisioning.create",
			table = '''| Account Name                           | Prokor - ${staticCompanyName}              |
	| Address City                           | Diamond Bar                                |
	| Address Country                        | United States                              |
	| Address Postal Code                    | 91765                                      |
	| Address Region                         | California                                 |
	| Address Street                         | 456 Fake Street                            |
	| Contact Email Address 1                | pro.koroneiki1@lrcustomer.com.broken       |
	| Contact First Name 1                   | PRO                                        |
	| Contact Last Name 1                    | Koroneiki1                                 |
	| Contact Email Address 2                | pro.koroneiki2@lrcustomer.com.broken       |
	| Contact First Name 2                   | PRO                                        |
	| Contact Last Name 2                    | Koroneiki2                                 |
	| Dossiera Account Key                   | ${staticDossieraAccountKey}                |
	| Dossiera Address Key 1                 | ${staticDossieraAddressKey1}               |
	| Dossiera Address Key 2                 | ${staticDossieraAddressKey2}               |
	| Dossiera Contact Key 1                 | ${staticDossieraContactKey1}               |
	| Dossiera Contact Key 2                 | ${staticDossieraContactKey2}               |
	| Dossiera Project Key                   | ${staticDossieraProjectKey}                |
	| End Day                                | ${staticEndDay}                            |
	| End Month                              | ${staticEndMonth}                          |
	| End Year                               | ${staticEndYear}                           |
	| Industry                               | Automotive                                 |
	| Owner Email Address                    | pro.koroneiki3@lrcustomer.com.broken       |
	| Owner First Name                       | PRO                                        |
	| Owner Last Name                        | Koroneiki3                                 |
	| Partner First Line Support             | false                                      |
	| Product Type                           | New                                        |
	| Product Name 1                         | LXC - Business Plan                        |
	| Product Name 2                         | LXC - Entitlements for up to 100 MALUs     |
	| Project Name                           | Korpro - ${staticProjectName}              |
	| Renewal                                | false                                      |
	| Salesforce Opportunity Key             | ${staticSalesforceOpportunityKey}          |
	| Salesforce Opportunity Line Item Key 1 | ${staticSalesforceOpportunityLineItemKey1} |
	| Salesforce Opportunity Line Item Key 2 | ${staticSalesforceOpportunityLineItemKey2} |
	| Salesforce Opportunity Sold By         | Liferay US                                 |
	| Salesforce Opportunity Stage Name      | Closed Won                                 |
	| Salesforce Opportunity Territory       | United States                              |
	| Salesforce Opportunity Type            | New Business                               |
	| Salesforce Owner User Key              | ${staticSalesforceOwnerUserKey}            |
	| Salesforce Project Key                 | ${staticSalesforceProjectKey}              |
	| Start Day                              | ${staticStartDay}                          |
	| Start Month                            | ${staticStartMonth}                        |
	| Start Year                             | ${staticStartYear}                         |
	| Subscription Level 1                   | LXC Subscription - Premium                 |
	| Subscription Level 2                   | LXC Subscription - Premium                 |
	| Version Number                         | 7.1                                        |''');

		LocalFile.KoroneikiAccountAPI._viewAccount(
			accountName = "Korpro - ${staticProjectName}",
			table = '''| Account Field and Value | liferayVersion                       | DXP 7.1 | |
	| Code                    | PROKORKORPRO                         |         | |
	| Parent Account Name     | Prokor - ${staticCompanyName}        |         | |
	| Contact Email Address   | pro.koroneiki3@lrcustomer.com.broken |         | |
	| Name                    | Korpro - ${staticProjectName}        |         | |
	| Region                  | United States                        |         | |
	| Status                  | Active                               |         | |''');

		LocalFile.KoroneikiPostalAddressAPI._viewPostalAddress(
			accountName = "Korpro - ${staticProjectName}",
			streetAddressLine1 = "456 Fake Street",
			table = '''| Country               | United States   |
	| Locality              | Diamond Bar     |
	| Region                | California      |
	| Postal Code           | 91765           |
