definition {

	property testray.main.component.name = "Support QA";
	property type = "osb.integration";

	setUp {
		LocalFile.Passwords.getPasswords();
	}

	tearDown {
		LocalFile.ZendeskUserAPI._getDefaultUserId(organizationName = "Korone - ${staticProjectName}");

		LocalFile.ZendeskUserAPI._renameFirstDefaultUserIdVariable();

		LocalFile.ZendeskUserAPI._getDefaultUserId(organizationName = "Kchild - ${staticProjectName}");

		LocalFile.ZendeskUserAPI._renameSecondDefaultUserIdVariable();

		LocalFile.ZendeskUserAPI._getDefaultUserId(organizationName = "Oneiki - ${staticProjectName}");

		LocalFile.ZendeskUserAPI._renameThirdDefaultUserIdVariable();

		LocalFile.OSBAdminProject.tearDownProjects(table = '''| KCHILDKCHILD |
	| KORONEKORONE |
	| ONEIKIONEIKI |''');

		LocalFile.KoroneikiAccountAPI._tearDownAccounts(table = '''| Kchild - ${staticProjectName} |
	| Korone - ${staticProjectName} |
	| Oneiki - ${staticProjectName} |''');

		LocalFile.KoroneikiAccountAPI._tearDownAccountsViaAccountFieldNameAndValue(
			fieldName = "Code",
			table = '''| KCHILDKCHILD |
	| KORONEKORONE |
	| ONEIKIONEIKI |''');

		LocalFile.KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		LocalFile.KoroneikiContactAPI._tearDownContacts(table = '''| osb.koroneiki1@lrcustomer.com.broken |
	| osb.koroneiki2@lrcustomer.com.broken |
	| bso.koroneiki3@lrcustomer.com.broken |
	| bso.koroneiki4@lrcustomer.com.broken |''');

		LocalFile.KoroneikiContactRoleAPI._tearDownContactRoles(table = '''| Liferay Account Role     |
	| Liferay Optional Role    |
	| NonLiferay Account Role  |
	| NonLiferay Optional Role |''');

		LocalFile.ZendeskOrganizationAPI._getMultipleOrganizationExternalIdsByOrganizationNameIfStillPresent(table = '''| Kchild - ${staticProjectName} |
	| Korone - ${staticProjectName} |
	| Oneiki - ${staticProjectName} |''');

		LocalFile.ZendeskOrganizationAPI._tearDownOrganizationsByExternalIdList(organizationExternalIds = ${staticOrganizationExternalIdList});

		LocalFile.ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId1});

		LocalFile.ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId2});

		LocalFile.ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId3});
	}

	test Createnonexistentworkercontactswithexistentandnonexistentroles {
		LocalFile.OSBAdminRabbitMQ.generateProvisioningProjectName();

		LocalFile.KoroneikiContactRoleAPI._createContactRoleNestedFieldForNonExistentContactRole(table = '''| Description | This is the Liferay role for accounts |
	| Name        | Liferay Account Role                  |
	| Type        | Account Worker                        |''');

		LocalFile.KoroneikiContactRoleAPI._renameFirstContactRoleNestedFieldVariable();

		LocalFile.KoroneikiContactRoleAPI._createContactRoleNestedFieldForNonExistentContactRole(table = '''| Description | This is the NonLiferay role for accounts |
	| Name        | NonLiferay Account Role                  |
	| Type        | Account Worker                           |''');

		LocalFile.KoroneikiContactRoleAPI._renameSecondContactRoleNestedFieldVariable();

		LocalFile.KoroneikiContactRoleAPI._createContactRole(table = '''| Description | This is the optional Liferay role for accounts |
	| Name        | Liferay Optional Role                          |
	| Type        | Account Worker                                 |''');

		LocalFile.KoroneikiContactRoleAPI._createContactRoleNestedField(contactRoleName = "Liferay Optional Role");

		LocalFile.KoroneikiContactRoleAPI._renameThirdContactRoleNestedFieldVariable();

		LocalFile.KoroneikiContactRoleAPI._createContactRole(table = '''| Description | This is the optional NonLiferay role for accounts |
	| Name        | NonLiferay Optional Role                          |
	| Type        | Account Worker                                    |''');

		LocalFile.KoroneikiContactRoleAPI._createContactRoleNestedField(contactRoleName = "NonLiferay Optional Role");

		LocalFile.KoroneikiContactRoleAPI._renameFourthContactRoleNestedFieldVariable();

		LocalFile.KoroneikiContactAPI._createWorkerContactNestedFieldForNonexistentContactWithContactRoleNestedField(
			contactRolesNestedField = "${staticContactRolesNestedField1},${staticContactRolesNestedField3}",
			table = '''| Email Address | osb.koroneiki1@lrcustomer.com.broken |
	| First Name    | OSB                                  |
	| Language      | English                              |
	| Last Name     | Koroneiki1                           |''');

		LocalFile.KoroneikiContactAPI._renameFirstContactNestedFieldVariable();

		LocalFile.KoroneikiContactAPI._createWorkerContactNestedFieldForNonexistentContactWithContactRoleNestedField(
			contactRolesNestedField = "${staticContactRolesNestedField2},${staticContactRolesNestedField4}",
			table = '''| Email Address | osb.koroneiki2@lrcustomer.com.broken |
	| First Name    | OSB                                  |
	| Language      | English                              |
	| Last Name     | Koroneiki2                           |''');

		LocalFile.KoroneikiContactAPI._renameSecondContactNestedFieldVariable();

		LocalFile.KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORONEKORONE                                                | |
	| Contact Email Address | osb.koroneiki1@lrcustomer.com.broken                        | |
	| Contact Nested Field  | ${staticContactsNestedField1},${staticContactsNestedField2} | |
	| Description           | Test osb account on koroneiki                               | |
	| Fax Number            | 555-555-1234                                                | |
	| Name                  | Korone - ${staticProjectName}                               | |
	| Phone Number          | 555-555-5678                                                | |
	| Profile Email Address | osb.koroneiki1@lrcustomer.com.broken                        | |
	| Region                | United States                                               | |
	| Status                | Active                                                      | |
	| Tier                  | T4                                                          | |
	| Website               | www.koroneikicorporation.com                                | |''');

		LocalFile.KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		LocalFile.KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korone - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | true                     | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		LocalFile.KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korone - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | true                     | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		LocalFile.KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		LocalFile.OSBAdmin.loginToSupport(
			userEmailAddress = ${staticSupportAdminEmailAdress},
			userPassword = ${staticSupportAdminPassword});

		LocalFile.ProjectDetails.gotoProjectDetailsPage();

		LocalFile.ProjectDetails.searchKeyword(keyword = "Korone");

		LocalFile.ProjectDetails.gotoProject(projectName = "Korone - ${staticProjectName}");

		LocalFile.ProjectDetails.gotoHistory();

		LocalFile.ProjectDetails.viewHistoryEntryByThreeKeywords(
			fieldName = "Contact Role",
			keyword1 = "Assigned Contact",
			keyword2 = "OSB Koroneiki1",
			keyword3 = "Member",
			table = '''| Updater Name                | Koroneiki QA Service Producer |
	| Update Summary              | Assigned Contact              |
	| Update Description          | OSB Koroneiki1                |
	| Update Date                 | Today                         |
	| Update Field Name           | Contact Role                  |
	| Update Field Original Value | N/A                           |
	| Update Field New Value      | Member                        |''');

		LocalFile.ProjectDetails.viewHistoryEntryByThreeKeywords(
			fieldName = "Contact Role",
			keyword1 = "Assigned Contact",
			keyword2 = "OSB Koroneiki2",
			keyword3 = "Member",
			table = '''| Updater Name                | Koroneiki QA Service Producer |
	| Update Summary              | Assigned Contact              |
	| Update Description          | OSB Koroneiki2                |
	| Update Date                 | Today                         |
	| Update Field Name           | Contact Role                  |
	| Update Field Original Value | N/A                           |
	| Update Field New Value      | Member                        |''');

		LocalFile.ProjectDetails.viewHistoryEntryByThreeKeywords(
			fieldName = "Contact Role",
			keyword1 = "Assigned Contact",
			keyword2 = "OSB Koroneiki1",
			keyword3 = "Liferay Account Role",
			table = '''| Updater Name                | Koroneiki QA Service Producer |
	| Update Summary              | Assigned Contact              |
	| Update Description          | OSB Koroneiki1                |
	| Update Date                 | Today                         |
	| Update Field Name           | Contact Role                  |
	| Update Field Original Value | N/A                           |
	| Update Field New Value      | Liferay Account Role          |''');

		LocalFile.ProjectDetails.viewHistoryEntryByThreeKeywords(
			fieldName = "Contact Role",
			keyword1 = "Assigned Contact",
			keyword2 = "OSB Koroneiki1",
			keyword3 = "Liferay Optional Role",
			table = '''| Updater Name                | Koroneiki QA Service Producer |
	| Update Summary              | Assigned Contact              |
	| Update Description          | OSB Koroneiki1                |
	| Update Date                 | Today                         |
	| Update Field Name           | Contact Role                  |
	| Update Field Original Value | N/A                           |
	| Update Field New Value      | Liferay Optional Role         |''');

		LocalFile.ProjectDetails.viewHistoryEntryByThreeKeywords(
			fieldName = "Contact Role",
			keyword1 = "Assigned Contact",
			keyword2 = "OSB Koroneiki2",
			keyword3 = "NonLiferay Account Role",
			table = '''| Updater Name                | Koroneiki QA Service Producer |
	| Update Summary              | Assigned Contact              |
	| Update Description          | OSB Koroneiki2                |
	| Update Date                 | Today                         |
	| Update Field Name           | Contact Role                  |
	| Update Field Original Value | N/A                           |
	| Update Field New Value      | NonLiferay Account Role       |''');

		LocalFile.ProjectDetails.viewHistoryEntryByThreeKeywords(
			fieldName = "Contact Role",
			keyword1 = "Assigned Contact",
			keyword2 = "OSB Koroneiki2",
			keyword3 = "NonLiferay Optional Role",
			table = '''| Updater Name                | Koroneiki QA Service Producer |
	| Update Summary              | Assigned Contact              |
	| Update Description          | OSB Koroneiki2                |
	| Update Date                 | Today                         |
	| Update Field Name           | Contact Role                  |
	| Update Field Original Value | N/A                           |
	| Update Field New Value      | NonLiferay Optional Role      |''');
	}

