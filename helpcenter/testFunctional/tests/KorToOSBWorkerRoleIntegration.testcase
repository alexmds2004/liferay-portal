	test Createnonexistentworkercontactswithnonexistentrolesvianestedfields {
		LocalFile.OSBAdminRabbitMQ.generateProvisioningProjectName();

		LocalFile.KoroneikiContactRoleAPI._createContactRoleNestedFieldForNonExistentContactRole(table = '''| Description | This is the Liferay role for accounts |
	| Name        | Liferay Account Role                  |
	| Type        | Account Worker                        |''');

		LocalFile.KoroneikiContactRoleAPI._renameFirstContactRoleNestedFieldVariable();

		LocalFile.KoroneikiContactRoleAPI._createContactRoleNestedFieldForNonExistentContactRole(table = '''| Description | This is the NonLiferay role for accounts |
	| Name        | NonLiferay Account Role                  |
	| Type        | Account Worker                           |''');

		LocalFile.KoroneikiContactRoleAPI._renameSecondContactRoleNestedFieldVariable();

		LocalFile.KoroneikiContactAPI._createWorkerContactNestedFieldForNonexistentContactWithContactRoleNestedField(
			contactRolesNestedField = ${staticContactRolesNestedField1},
			table = '''| Email Address | osb.koroneiki1@lrcustomer.com.broken |
	| First Name    | OSB                                  |
	| Language      | English                              |
	| Last Name     | Koroneiki1                           |''');

