		KoroneikiTeamAPI._assignContacts(
			table = '''| usr.koroneiki1@lrcustomer.com.broken |''',
			teamName = "User Site Partner");

		KoroneikiContactRoleAPI._createContactRole(table = '''| Description | This is the default user customer role for accounts |
	| Name        | Liferay User Customer Role                          |
	| Type        | Account Customer                                    |''');

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Korusr - ${staticProjectName}",
			contactEmailAddress = "usr.koroneiki1@lrcustomer.com.broken",
			table = '''| Liferay User Customer Role |''');

		JSONOkta.updateOktaUser(
			table = '''| Screen Name   | rsu.koroneiki6                       |
	| Email Address | rsu.koroneiki6@lrcustomer.com.broken |
