definition {

	property testray.main.component.name = "Support QA";
	property type = "provisioning.user.integration";

	setUp {
		Passwords.getPasswords();

		OSBAdminRabbitMQ.generateStaticVariables();

		OSBAdminRabbitMQ.generateProvisioningCompanyName();

		OSBAdminRabbitMQ.generateProvisioningProjectName();

		JSONOkta.createOktaUser(table = '''| Screen Name   | usr.koroneiki1                       |
	| Email Address | usr.koroneiki1@lrcustomer.com.broken |
	| First Name    | USR                                  |
	| Last Name     | Koroneiki1                           |''');

		JSONOkta.createOktaUser(table = '''| Screen Name   | usr.koroneiki2                       |
	| Email Address | usr.koroneiki2@lrcustomer.com.broken |
	| First Name    | USR                                  |
	| Last Name     | Koroneiki2                           |''');

		JSONOkta.createOktaUser(table = '''| Screen Name   | usr.koroneiki3                       |
	| Email Address | usr.koroneiki3@lrcustomer.com.broken |
	| First Name    | USR                                  |
	| Last Name     | Koroneiki3                           |''');

		JSONOkta.createOktaUser(table = '''| Screen Name   | usr.koroneiki4                       |
	| Email Address | usr.koroneiki4@lrcustomer.com.broken |
	| First Name    | USR                                  |
	| Last Name     | Koroneiki4                           |''');
	}

	tearDown {
		ZendeskUserAPI._getDefaultUserId(organizationName = "Korusr - ${staticProjectName}");

		ZendeskUserAPI._renameFirstDefaultUserIdVariable();

		ZendeskUserAPI._getDefaultUserId(organizationName = "Oneusr - ${staticProjectName}");

		ZendeskUserAPI._renameSecondDefaultUserIdVariable();

		ZendeskUserAPI._getDefaultUserId(organizationName = "Usrkor - ${staticCompanyName}");

		ZendeskUserAPI._renameThirdDefaultUserIdVariable();

		ZendeskUserAPI._getDefaultUserId(organizationName = "Usrpar - ${staticCompanyName}");

		ZendeskUserAPI._renameFourthDefaultUserIdVariable();

		KoroneikiContactAPI._tearDownContactEntitlementDefinitions(table = '''| Liferay User Customer Role |''');

		KoroneikiTeamAPI._tearDownTeams(table = '''| User Site Partner |
	| Changed Partner   |
	| Provisio Usr Team |
	| Changed Prov Team |''');

		OSBAdminProject.tearDownProjects(table = '''| USRKORKORUSR |
	| ONEUSRONEUSR |
	| USRKOR       |''');

		KoroneikiAccountAPI._tearDownAccounts(table = '''| Usrpar - ${staticCompanyName} |''');

		KoroneikiAccountAPI._tearDownAccountsViaAccountFieldNameAndValue(
			fieldName = "Code",
			table = '''| USRPAR |''');

		KoroneikiAccountAPI._tearDownAccounts(table = '''| Korusr - ${staticProjectName} |
	| Oneusr - ${staticProjectName} |
	| Usrkor - ${staticCompanyName} |''');

		KoroneikiAccountAPI._tearDownAccountsViaAccountFieldNameAndValue(
			fieldName = "Code",
			table = '''| USRKORKORUSR |
	| ONEUSRONEUSR |
	| USRKOR       |''');

		JSONUser.tearDownUsers(table = '''| usr.koroneiki1@lrcustomer.com.broken |
	| usr.koroneiki2@lrcustomer.com.broken |
	| usr.koroneiki3@lrcustomer.com.broken |
	| usr.koroneiki4@lrcustomer.com.broken |
	| usr.koroneiki5@lrcustomer.com.broken |
	| rsu.koroneiki6@lrcustomer.com.broken |''');

		JSONUser.tearDownUsersViaSupport(table = '''| usr.koroneiki1@lrcustomer.com.broken |
	| usr.koroneiki2@lrcustomer.com.broken |
	| usr.koroneiki3@lrcustomer.com.broken |
	| usr.koroneiki4@lrcustomer.com.broken |
	| usr.koroneiki5@lrcustomer.com.broken |
	| rsu.koroneiki6@lrcustomer.com.broken |''');

		JSONUser.tearDownUsersViaKoroneiki(table = '''| usr.koroneiki1@lrcustomer.com.broken |
	| usr.koroneiki2@lrcustomer.com.broken |
	| usr.koroneiki3@lrcustomer.com.broken |
	| usr.koroneiki4@lrcustomer.com.broken |
	| usr.koroneiki5@lrcustomer.com.broken |
	| rsu.koroneiki6@lrcustomer.com.broken |''');

		KoroneikiContactAPI._tearDownContacts(table = '''| usr.koroneiki1@lrcustomer.com.broken |
	| usr.koroneiki2@lrcustomer.com.broken |
	| usr.koroneiki3@lrcustomer.com.broken |
	| usr.koroneiki4@lrcustomer.com.broken |
	| usr.koroneiki5@lrcustomer.com.broken |
	| rsu.koroneiki6@lrcustomer.com.broken |''');

		JSONOkta.tearDownUsers(table = '''| usr.koroneiki1@lrcustomer.com.broken |
	| usr.koroneiki2@lrcustomer.com.broken |
	| usr.koroneiki3@lrcustomer.com.broken |
	| usr.koroneiki4@lrcustomer.com.broken |
	| usr.koroneiki5@lrcustomer.com.broken |
	| rsu.koroneiki6@lrcustomer.com.broken |''');

		KoroneikiContactRoleAPI._tearDownContactRoles(table = '''| Liferay User Customer Role |
	| Second User Customer Role  |
	| Liferay User Worker Role   |''');

		ZendeskTicketAPI._tearDownTicketsByKeywords(table = '''| New Subscription(s) for Korusr - ${staticProjectName} |
	| New Subscription(s) for Usrkor - ${staticCompanyName} |
	| New Subscription(s) for Usrpar - ${staticCompanyName} |''');

		ZendeskUserAPI._getMultipleUserIdsByEmailAddress(table = '''| usr.koroneiki1@lrcustomer.com.broken |
	| usr.koroneiki2@lrcustomer.com.broken |
	| usr.koroneiki3@lrcustomer.com.broken |
	| usr.koroneiki4@lrcustomer.com.broken |
	| usr.koroneiki5@lrcustomer.com.broken |
	| rsu.koroneiki6@lrcustomer.com.broken |''');

		ZendeskUserAPI._tearDownUsersByIdList(userIds = ${staticUserIdList});

		ZendeskOrganizationAPI._getMultipleOrganizationExternalIdsByOrganizationNameIfStillPresent(table = '''| Usrpar - ${staticCompanyName} |
	| Korusr - ${staticProjectName} |
	| Oneusr - ${staticProjectName} |
	| Usrkor - ${staticCompanyName} |''');

		ZendeskOrganizationAPI._tearDownOrganizationsByExternalIdList(organizationExternalIds = ${staticOrganizationExternalIdList});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId1});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId2});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId3});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId4});
	}

	test Searchuser {
		OSBAdminRabbitMQ.publishCreateProjectWithNoPartnerMessage(
			routingKey = "dossiera.provisioning.create",
			table = '''| Account Name                           | Usrkor - ${staticCompanyName}              |
	| Address City                           | Diamond Bar                                |
	| Address Country                        | United States                              |
	| Address Postal Code                    | 91765                                      |
	| Address Region                         | California                                 |
	| Address Street                         | 456 Fake Street                            |
	| Contact Email Address                  | usr.koroneiki1@lrcustomer.com.broken       |
	| Contact First Name                     | USR                                        |
	| Contact Last Name                      | Koroneiki1                                 |
	| Dossiera Account Key                   | ${staticDossieraAccountKey}                |
	| Dossiera Address Key 1                 | ${staticDossieraAddressKey1}               |
	| Dossiera Address Key 2                 | ${staticDossieraAddressKey2}               |
	| Dossiera Contact Key                   | ${staticDossieraContactKey}                |
	| Dossiera Project Key                   | ${staticDossieraProjectKey}                |
	| End Day                                | ${staticEndDay}                            |
	| End Month                              | ${staticEndMonth}                          |
	| End Year                               | ${staticEndYear}                           |
	| Industry                               | Automotive                                 |
	| Owner Email Address                    | usr.koroneiki4@lrcustomer.com.broken       |
	| Owner First Name                       | USR                                        |
	| Owner Last Name                        | Koroneiki4                                 |
	| Partner First Line Support             | false                                      |
	| Product Type                           | New                                        |
	| Product Name                           | Liferay Digital Enterprise - Prod Sizing 4 |
	| Project Name                           | Korusr - ${staticProjectName}              |
	| Renewal                                | false                                      |
	| Salesforce Opportunity Key             | ${staticSalesforceOpportunityKey}          |
	| Salesforce Opportunity Line Item Key 1 | ${staticSalesforceOpportunityLineItemKey1} |
	| Salesforce Opportunity Line Item Key 2 | ${staticSalesforceOpportunityLineItemKey2} |
	| Salesforce Opportunity Sold By         | Liferay US                                 |
	| Salesforce Opportunity Stage Name      | Closed Won                                 |
	| Salesforce Opportunity Territory       | United States                              |
	| Salesforce Opportunity Type            | New Business                               |
	| Salesforce Owner User Key              | ${staticSalesforceOwnerUserKey}            |
	| Salesforce Project Key                 | ${staticSalesforceProjectKey}              |
	| Start Day                              | ${staticStartDay}                          |
	| Start Month                            | ${staticStartMonth}                        |
	| Start Year                             | ${staticStartYear}                         |
	| Subscription Level                     | Platinum                                   |
	| Version Number                         | 7.1                                        |''');

		KoroneikiAccountAPI._createAccountTeam(
			accountName = "Korusr - ${staticProjectName}",
			teamName = "User Site Partner");

		KoroneikiAccountAPI._assignTeamRolesToTeam(
			accountName = "Korusr - ${staticProjectName}",
			table = '''| Partner |''',
			teamName = "User Site Partner");

		KoroneikiTeamAPI._assignContacts(
			table = '''| usr.koroneiki1@lrcustomer.com.broken |''',
			teamName = "User Site Partner");

		KoroneikiContactRoleAPI._createContactRole(table = '''| Description | This is the default user customer role for accounts |
	| Name        | Liferay User Customer Role                          |
	| Type        | Account Customer                                    |''');

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Korusr - ${staticProjectName}",
			contactEmailAddress = "usr.koroneiki1@lrcustomer.com.broken",
			table = '''| Liferay User Customer Role |''');

		OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		Provisioning.gotoUsers();

		Provisioning.searchUsers(keyword = "usr.koroneiki1@lrcustomer.com.broken");

		Provisioning._viewUserViaIndex(
			table = '''| Name               | USR Koroneiki1                       |
	| Email Address      | usr.koroneiki1@lrcustomer.com.broken |
	| Number of Accounts | 1                                    |
	| Status             | VERIFIED                             |''',
			userName = "USR Koroneiki1");

		Provisioning.gotoUsers();

		Provisioning.searchUsers(keyword = "Koroneiki1");

		Provisioning._viewUserViaIndex(
			table = '''| Name               | USR Koroneiki1                       |
	| Email Address      | usr.koroneiki1@lrcustomer.com.broken |
	| Number of Accounts | 1                                    |
	| Status             | VERIFIED                             |''',
			userName = "USR Koroneiki1");
	}

	test Viewdeleteduser {
		OSBAdminRabbitMQ.publishCreateProjectWithNoPartnerMessage(
			routingKey = "dossiera.provisioning.create",
			table = '''| Account Name                           | Usrkor - ${staticCompanyName}              |
	| Address City                           | Diamond Bar                                |
	| Address Country                        | United States                              |
	| Address Postal Code                    | 91765                                      |
	| Address Region                         | California                                 |
	| Address Street                         | 456 Fake Street                            |
	| Contact Email Address                  | usr.koroneiki1@lrcustomer.com.broken       |
	| Contact First Name                     | USR                                        |
	| Contact Last Name                      | Koroneiki1                                 |
	| Dossiera Account Key                   | ${staticDossieraAccountKey}                |
	| Dossiera Address Key 1                 | ${staticDossieraAddressKey1}               |
	| Dossiera Address Key 2                 | ${staticDossieraAddressKey2}               |
	| Dossiera Contact Key                   | ${staticDossieraContactKey}                |
	| Dossiera Project Key                   | ${staticDossieraProjectKey}                |
	| End Day                                | ${staticEndDay}                            |
	| End Month                              | ${staticEndMonth}                          |
	| End Year                               | ${staticEndYear}                           |
	| Industry                               | Automotive                                 |
	| Owner Email Address                    | usr.koroneiki4@lrcustomer.com.broken       |
	| Owner First Name                       | USR                                        |
	| Owner Last Name                        | Koroneiki4                                 |
	| Partner First Line Support             | false                                      |
	| Product Type                           | New                                        |
	| Product Name                           | Liferay Digital Enterprise - Prod Sizing 4 |
	| Project Name                           | Korusr - ${staticProjectName}              |
	| Renewal                                | false                                      |
	| Salesforce Opportunity Key             | ${staticSalesforceOpportunityKey}          |
	| Salesforce Opportunity Line Item Key 1 | ${staticSalesforceOpportunityLineItemKey1} |
	| Salesforce Opportunity Line Item Key 2 | ${staticSalesforceOpportunityLineItemKey2} |
	| Salesforce Opportunity Sold By         | Liferay US                                 |
	| Salesforce Opportunity Stage Name      | Closed Won                                 |
	| Salesforce Opportunity Territory       | United States                              |
	| Salesforce Opportunity Type            | New Business                               |
	| Salesforce Owner User Key              | ${staticSalesforceOwnerUserKey}            |
	| Salesforce Project Key                 | ${staticSalesforceProjectKey}              |
	| Start Day                              | ${staticStartDay}                          |
	| Start Month                            | ${staticStartMonth}                        |
	| Start Year                             | ${staticStartYear}                         |
	| Subscription Level                     | Platinum                                   |
	| Version Number                         | 7.1                                        |''');

		KoroneikiAccountAPI._createAccountTeam(
			accountName = "Korusr - ${staticProjectName}",
			teamName = "User Site Partner");

		KoroneikiAccountAPI._assignTeamRolesToTeam(
			accountName = "Korusr - ${staticProjectName}",
			table = '''| Partner |''',
			teamName = "User Site Partner");

		KoroneikiTeamAPI._assignContacts(
			table = '''| usr.koroneiki1@lrcustomer.com.broken |''',
			teamName = "User Site Partner");

		KoroneikiContactRoleAPI._createContactRole(table = '''| Description | This is the default user customer role for accounts |
	| Name        | Liferay User Customer Role                          |
	| Type        | Account Customer                                    |''');

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Korusr - ${staticProjectName}",
			contactEmailAddress = "usr.koroneiki1@lrcustomer.com.broken",
			table = '''| Liferay User Customer Role |''');

		KoroneikiContactAPI._deleteContactViaEmailAddress(contactEmailAddress = "usr.koroneiki1@lrcustomer.com.broken");

		OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		Provisioning.gotoUsers();

		Provisioning.searchUsers(keyword = "usr.koroneiki1");

		Provisioning._viewNoUserViaIndex(userName = "USR Koroneiki1");
	}

	test Viewenabledsyncwithoktabuttonforanonpartnerandnoncustomeruser {
		OSBAdminRabbitMQ.publishCreatePartnerAccountMessage(
			routingKey = "dossiera.provisioning.create",
			table = '''| Account Name                           | Usrpar - ${staticCompanyName}              |
	| Address City                           | Diamond Bar                                |
	| Address Country                        | United States                              |
	| Address Postal Code                    | 91765                                      |
	| Address Region                         | California                                 |
	| Address Street                         | 456 Fake Street                            |
	| Dossiera Account Key                   | efghabcd6789012345                         |
	| Dossiera Address Key 1                 | ${staticDossieraAddressKey1}               |
	| End Day                                | ${staticEndDay}                            |
	| End Month                              | ${staticEndMonth}                          |
	| End Year                               | ${staticEndYear}                           |
	| Industry                               | Professional Services (Technical/Web/IT)   |
	| Owner Email Address                    | usr.koroneiki2@lrcustomer.com.broken       |
	| Owner First Name                       | USR                                        |
	| Owner Last Name                        | Koroneiki2                                 |
	| Partner First Line Support             | false                                      |
	| Product Name                           | Service Partnership                        |
	| Product Type                           | New                                        |
	| Renewal                                | false                                      |
	| Salesforce Opportunity Key             | 000000f6e7fa1b2c3d4e5                      |
	| Salesforce Opportunity Line Item Key 1 | ${staticSalesforceOpportunityLineItemKey1} |
	| Salesforce Opportunity Sold By         | Liferay US                                 |
	| Salesforce Opportunity Stage Name      | Closed Won                                 |
	| Salesforce Opportunity Territory       | United States                              |
	| Salesforce Opportunity Type            | New Business                               |
	| Salesforce Owner User Key              | ${staticSalesforceOwnerUserKey}            |
	| Start Day                              | ${staticStartDay}                          |
	| Start Month                            | ${staticStartMonth}                        |
	| Start Year                             | ${staticStartYear}                         |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Partner");

		OSBAdminRabbitMQ.publishCreateProjectWithNoPartnerMessage(
			routingKey = "dossiera.provisioning.create",
			table = '''| Account Name                           | Usrkor - ${staticCompanyName}              |
	| Address City                           | Diamond Bar                                |
	| Address Country                        | United States                              |
	| Address Postal Code                    | 91765                                      |
	| Address Region                         | California                                 |
	| Address Street                         | 456 Fake Street                            |
	| Contact Email Address                  | usr.koroneiki1@lrcustomer.com.broken       |
	| Contact First Name                     | USR                                        |
	| Contact Last Name                      | Koroneiki1                                 |
	| Dossiera Account Key                   | ${staticDossieraAccountKey}                |
	| Dossiera Address Key 1                 | ${staticDossieraAddressKey1}               |
	| Dossiera Address Key 2                 | ${staticDossieraAddressKey2}               |
	| Dossiera Contact Key                   | ${staticDossieraContactKey}                |
	| Dossiera Project Key                   | ${staticDossieraProjectKey}                |
	| End Day                                | ${staticEndDay}                            |
	| End Month                              | ${staticEndMonth}                          |
	| End Year                               | ${staticEndYear}                           |
	| Industry                               | Automotive                                 |
	| Owner Email Address                    | usr.koroneiki4@lrcustomer.com.broken       |
	| Owner First Name                       | USR                                        |
	| Owner Last Name                        | Koroneiki4                                 |
	| Partner First Line Support             | false                                      |
	| Product Type                           | New                                        |
	| Product Name                           | Liferay Digital Enterprise - Prod Sizing 4 |
	| Project Name                           | Korusr - ${staticProjectName}              |
	| Renewal                                | false                                      |
	| Salesforce Opportunity Key             | ${staticSalesforceOpportunityKey}          |
	| Salesforce Opportunity Line Item Key 1 | ${staticSalesforceOpportunityLineItemKey1} |
	| Salesforce Opportunity Line Item Key 2 | ${staticSalesforceOpportunityLineItemKey2} |
	| Salesforce Opportunity Sold By         | Liferay US                                 |
	| Salesforce Opportunity Stage Name      | Closed Won                                 |
	| Salesforce Opportunity Territory       | United States                              |
	| Salesforce Opportunity Type            | New Business                               |
	| Salesforce Owner User Key              | ${staticSalesforceOwnerUserKey}            |
	| Salesforce Project Key                 | ${staticSalesforceProjectKey}              |
	| Start Day                              | ${staticStartDay}                          |
	| Start Month                            | ${staticStartMonth}                        |
	| Start Year                             | ${staticStartYear}                         |
	| Subscription Level                     | Platinum                                   |
	| Version Number                         | 7.1                                        |''');

		KoroneikiAccountAPI._removeContactRolesFromContact(
			accountName = "Korusr - ${staticProjectName}",
			contactEmailAddress = "usr.koroneiki1@lrcustomer.com.broken",
			table = '''| Support Administrator |''');

		KoroneikiAccountAPI._removeContactRolesFromContact(
			accountName = "Usrpar - ${staticCompanyName}",
			contactEmailAddress = "usr.koroneiki2@lrcustomer.com.broken",
			table = '''| Liferay Sales |''');

		KoroneikiAccountAPI._removeContactRolesFromContact(
			accountName = "Usrpar - ${staticCompanyName}",
			contactEmailAddress = "usr.koroneiki2@lrcustomer.com.broken",
			table = '''| Secondary Contact |''');

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		Provisioning.gotoUsers();

		Provisioning.searchUsers(keyword = "usr.koroneiki1");

		Provisioning._viewUserViaIndex(
			table = '''| Name               | USR Koroneiki1                       |
	| Email Address      | usr.koroneiki1@lrcustomer.com.broken |
	| Number of Accounts | 0                                    |
	| Status             | VERIFIED                             |''',
			userName = "USR Koroneiki1");

		Provisioning.clickUser(userName = "USR Koroneiki1");

		ProvisioningUser._viewUserDetails(table = '''| Name               | USR Koroneiki1                       |
	| Email Address      | usr.koroneiki1@lrcustomer.com.broken |
	| Number of Accounts | 0                                    |
	| Status             | VERIFIED                             |''');

		ProvisioningUser.viewEnabledSyncWithOktaButton();

		Provisioning.gotoUsers();

		Provisioning.searchUsers(keyword = "usr.koroneiki2");

		Provisioning._viewUserViaIndex(
			table = '''| Name               | USR Koroneiki2                       |
	| Email Address      | usr.koroneiki2@lrcustomer.com.broken |
	| Number of Accounts | 0                                    |
	| Status             | VERIFIED                             |''',
			userName = "USR Koroneiki2");

		Provisioning.clickUser(userName = "USR Koroneiki2");

		ProvisioningUser._viewUserDetails(table = '''| Name               | USR Koroneiki2                       |
	| Email Address      | usr.koroneiki2@lrcustomer.com.broken |
	| Number of Accounts | 0                                    |
	| Status             | VERIFIED                             |''');

		ProvisioningUser.viewEnabledSyncWithOktaButton();
	}

	test Viewoktaupdateduser {
		OSBAdminRabbitMQ.publishCreateProjectWithNoPartnerMessage(
			routingKey = "dossiera.provisioning.create",
			table = '''| Account Name                           | Usrkor - ${staticCompanyName}              |
	| Address City                           | Diamond Bar                                |
	| Address Country                        | United States                              |
	| Address Postal Code                    | 91765                                      |
	| Address Region                         | California                                 |
	| Address Street                         | 456 Fake Street                            |
