definition {

	property testray.main.component.name = "Support QA";
	property type = "customer.integration";

	setUp {
		LocalFile.Passwords.getPasswords();
	}

	tearDown {
		LocalFile.ProvisioningLicenseAPI._deactivateLicense(
			accountName = "Cstpro - ${staticProjectName}",
			licenseName = "Activation Key Name");

		LocalFile.ZendeskUserAPI._getDefaultUserId(organizationName = "Cstpro - ${staticProjectName}");

		LocalFile.KoroneikiProductConsumptionAPI._tearDownProductConsumptionList(
			accountName = "Cstpro - ${staticProjectName}",
			table = '''| DXP Production                    |
	| Portal Production                 |
	| Commerce Subscription Development |''');

		LocalFile.KoroneikiProductConsumptionAPI._tearDownProductConsumptions(
			accountName = "Cstpro - ${staticProjectName}",
			table = '''| DXP OEM                           |
	| DXP Limited                       |
	| DXP Non-Production                |
	| Portal Per User                   |
	| Commerce Subscription Development |''');

		LocalFile.OSBAdminProject.tearDownProjects(table = '''| CSTPROPROCST |''');

		LocalFile.KoroneikiAccountAPI._tearDownAccounts(table = '''| Cstpro - ${staticProjectName} |''');

		LocalFile.KoroneikiAccountAPI._tearDownAccountsViaAccountFieldNameAndValue(
			fieldName = "Code",
			table = '''| CSTPROPROCST |''');

		LocalFile.ZendeskOrganizationAPI._getMultipleOrganizationExternalIdsByOrganizationNameIfStillPresent(table = '''| Cstpro - ${staticProjectName} |''');

		LocalFile.ZendeskOrganizationAPI._tearDownOrganizationsByExternalIdList(organizationExternalIds = ${staticOrganizationExternalIdList});

		LocalFile.ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId});

		LocalFile.Downloads.teardownDownloadedListedFiles(list = ${staticDownloadedListName});
	}

	test ViewCommerceDevelopmentlicenseoncustomer {
		LocalFile.OSBAdminRabbitMQ.generateProvisioningProjectName();

		LocalFile.KoroneikiAccountAPI._createAccount(table = '''| Code                  | CstproCstpro                         | |
	| Contact Email Address | lic.koroneiki1@lrcustomer.com.broken | |
	| Description           | Test osb account on koroneiki        | |
	| Fax Number            | 555-555-1234                         | |
	| Name                  | Cstpro - ${staticProjectName}        | |
	| Phone Number          | 555-555-5678                         | |
	| Profile Email Address | lic.koroneiki1@lrcustomer.com.broken | |
	| Region                | United States                        | |
	| Status                | Active                               | |
	| Tier                  | T4                                   | |
	| Website               | www.koroneikicorporation.com         | |''');

		LocalFile.KoroneikiAccountAPI._generateAccountKey(accountName = "Cstpro - ${staticProjectName}");

		LocalFile.KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		LocalFile.KoroneikiProductPurchaseAPI.generateStaticFullStartAndEndDate();

		LocalFile.KoroneikiProductPurchaseAPI.generateStaticFutureStartAndEndDate();

		LocalFile.KoroneikiProductPurchaseAPI.generateStaticFullFutureStartAndEndDate();

		LocalFile.KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Cstpro - ${staticProjectName}",
			productName = "Commerce Subscription Development",
			table = '''| End Date                | ${staticEndDate}         |   |
	| Original End Date       | ${staticOriginalEndDate} |   |
	| Perpetual               | false                    |   |
	| Product Field and Value | sizing                   | 1 |
	| Product Field and Value | licenses                 | 1 |
	| Product Field and Value | version                  | 0 |
	| Quantity                | 1                        |   |
	| Start Date              | ${staticStartDate}       |   |
	| Status                  | Approved                 |   |''');

		LocalFile.KoroneikiProductPurchaseAPI._generateProductPurchaseId(
			accountName = "Cstpro - ${staticProjectName}",
			productName = "Commerce Subscription Development");

		LocalFile.KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Cstpro - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		LocalFile.CustomerLogin.loginToCustomer(
			userEmailAddress = ${staticCustomerAdminEmailAddress},
			userPassword = ${staticCustomerAdminPassword});

		LocalFile.CustomerProjects.searchCustomerProject(keyword = "FIFA");

		LocalFile.CustomerProjects.clickCustomerProject(projectName = "2022 FIFA World Cup Qatar - FAN ID");

		LocalFile.CustomerProjectNavigation.chooseSubscriptionAtActivationTab(subscription = "DXP");

		LocalFile.CustomerProjectActivationKeys.clickGenerateActivationKeyButton();

		LocalFile.CustomerProjectActivationKeys.populateActivationKeyForm(table = '''| Version          | Select       | 1                           |
	| Key Type         | Select       | Commerce                    |
	| Subscription     | Radio Button | Jun 30, 2021 - Mar 30, 2023 |''');

		LocalFile.CustomerProjectActivationKeys.clickActivationKeyFormNextButton();

		LocalFile.CustomerProjectActivationKeys.populateActivationKeyForm(table = '''| Environment Name | Input | Activation Key Name        |
	| Description      | Input | Activation Key Description |
	| Host Name        | Input | localhost                  |
	| IP Address       | Input | 123.45.67.89               |
	| MAC Address      | Input | 0A-1B-2C-3D-4E-5F          |''');

		LocalFile.CustomerProjectActivationKeys.clickActivationKeyFormGenerateButton();

		LocalFile.OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		LocalFile.Provisioning.gotoLicenses();

		LocalFile.Provisioning.searchLicenses(keyword = ${staticAccountKey});

		LocalFile.Provisioning._viewLicenseViaIndex(
			licenseKeyword = "Cstpro - ${staticProjectName}",
			table = '''| Name          | Activation Key Name               |
	| Description   | Activation Key Description        |
	| Account       | Cstpro - ${staticProjectName}     |
	| Product       | Commerce Subscription Development |
	| Type          | Developer                         |
	| Status        | ACTIVE                            |
	| Complimentary | false                             |''');

		LocalFile.Provisioning.clickLicense(licenseKeyword = "Cstpro - ${staticProjectName}");

		LocalFile.ProvisioningLicense.viewLicense(table = '''| Header              | Cstpro - ${staticProjectName}     | |
	| Product             | Commerce Subscription Development | |
	| Version             | 1                                 | |
	| Type                | Developer                         | |
	| Owner               | Cstpro - ${staticProjectName}     | |
	| Description         | Activation Key Description        | |
	| Maximum Connections | 5                                 | |
	| Complimentary       | No                                | |
	| Status              | ACTIVE                            | |
	| Created By          | Test Test                         | |''');
	}

	test ViewDXPProductionlicensecreatedincustomeronprovisoning {
		LocalFile.OSBAdminRabbitMQ.generateProvisioningProjectName();

		LocalFile.KoroneikiAccountAPI._createAccount(table = '''| Code                  | CSTPROPROCST                         | |
	| Contact Email Address | lic.koroneiki1@lrcustomer.com.broken | |
	| Description           | Test osb account on koroneiki        | |
	| Fax Number            | 555-555-1234                         | |
	| Name                  | Cstpro - ${staticProjectName}        | |
	| Phone Number          | 555-555-5678                         | |
	| Profile Email Address | lic.koroneiki1@lrcustomer.com.broken | |
	| Region                | United States                        | |
	| Status                | Active                               | |
	| Tier                  | T4                                   | |
	| Website               | www.koroneikicorporation.com         | |''');

		LocalFile.KoroneikiAccountAPI._generateAccountKey(accountName = "Cstpro - ${staticProjectName}");

		LocalFile.KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		LocalFile.KoroneikiProductPurchaseAPI.generateStaticFullStartAndEndDate();

		LocalFile.KoroneikiProductPurchaseAPI.generateStaticFutureStartAndEndDate();

		LocalFile.KoroneikiProductPurchaseAPI.generateStaticFullFutureStartAndEndDate();

		LocalFile.KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Cstpro - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| End Date                | ${staticEndDate}         |   |
	| Original End Date       | ${staticOriginalEndDate} |   |
	| Perpetual               | false                    |   |
	| Product Field and Value | sizing                   | 1 |
	| Product Field and Value | licenses                 | 1 |
	| Product Field and Value | version                  | 7 |
	| Quantity                | 1                        |   |
	| Start Date              | ${staticStartDate}       |   |
	| Status                  | Approved                 |   |''');

		LocalFile.KoroneikiProductPurchaseAPI._generateProductPurchaseId(
			accountName = "Cstpro - ${staticProjectName}",
			productName = "DXP Production");

		LocalFile.KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Cstpro - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		LocalFile.CustomerLogin.loginToCustomer(
			userEmailAddress = ${staticCustomerAdminEmailAddress},
			userPassword = ${staticCustomerAdminPassword});

		LocalFile.CustomerProjects.searchCustomerProject(keyword = "Cstpro");

		LocalFile.CustomerProjects.clickCustomerProject(projectName = "Cstpro - ${staticProjectName}");

		LocalFile.CustomerProjectNavigation.chooseSubscriptionAtActivationTab(subscription = "DXP");

		LocalFile.CustomerProjectActivationKeys.clickGenerateActivationKeyButton();

		LocalFile.CustomerProjectActivationKeys.populateActivationKeyForm(table = '''| Version          | Select       | 7.4                         |
	| Key Type         | Select       | Production                  |
	| Subscription     | Radio Button | Jun 30, 2021 - Mar 30, 2023 |''');

		LocalFile.CustomerProjectActivationKeys.clickActivationKeyFormNextButton();

		LocalFile.CustomerProjectActivationKeys.populateActivationKeyForm(table = '''| Environment Name | Input | Activation Key Name        |
	| Description      | Input | Activation Key Description |
	| Host Name        | Input | localhost                  |
	| IP Address       | Input | 123.45.67.89               |
	| MAC Address      | Input | 0A-1B-2C-3D-4E-5F          |''');

		LocalFile.CustomerProjectActivationKeys.clickActivationKeyFormGenerateButton();

		LocalFile.OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		LocalFile.Provisioning.gotoLicenses();

		LocalFile.Provisioning.searchLicenses(keyword = "Activation Key Name");

		LocalFile.Provisioning._viewLicenseViaIndex(
			licenseKeyword = "Activation Key Name",
			table = '''| Name          | Activation Key Name            |
	| Description   | Activation Key Description     |
	| Account       | Cstpro - ${staticProjectName}  |
	| Product       | DXP Production                 |
	| Type          | Production                     |
	| Details       | Host Name: localhost           |
	| Details       | IP Address: 123.45.67.89       |
	| Details       | MAC Address: 0A-1B-2C-3D-4E-5F |
	| Status        | ACTIVE                         |
	| Complimentary | false                          |''');

		LocalFile.Provisioning.clickLicense(licenseKeyword = "Activation Key Name");

		LocalFile.ProvisioningLicense.viewLicense(table = '''| Header        | Cstpro - ${staticProjectName} | |
	| Product       | DXP Production                | |
	| Version       | 7.4                           | |
	| Type          | Production                    | |
	| Host Name     | localhost                     | |
	| IP Addresses  | 123.45.67.89                  | |
	| MAC Addresses | 0A-1B-2C-3D-4E-5F             | |
	| Owner         | Cstpro - ${staticProjectName} | |
	| Description   | Activation Key Description    | |
	| Complimentary | No                            | |
	| Status        | ACTIVE                        | |
	| Created By    | Test Test                     | |''');
	}

	test ViewPortalProductionlicenseoncustomer {
		LocalFile.OSBAdminRabbitMQ.generateProvisioningProjectName();

		LocalFile.KoroneikiAccountAPI._createAccount(table = '''| Code                  | CSTPROPROCST                         | |
	| Contact Email Address | lic.koroneiki1@lrcustomer.com.broken | |
	| Description           | Test osb account on koroneiki        | |
	| Fax Number            | 555-555-1234                         | |
	| Name                  | Cstpro - ${staticProjectName}        | |
	| Phone Number          | 555-555-5678                         | |
	| Profile Email Address | lic.koroneiki1@lrcustomer.com.broken | |
	| Region                | United States                        | |
	| Status                | Active                               | |
	| Tier                  | T4                                   | |
	| Website               | www.koroneikicorporation.com         | |''');

		LocalFile.KoroneikiAccountAPI._generateAccountKey(accountName = "Cstpro - ${staticProjectName}");

		LocalFile.KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		LocalFile.KoroneikiProductPurchaseAPI.generateStaticFullStartAndEndDate();

		LocalFile.KoroneikiProductPurchaseAPI.generateStaticFutureStartAndEndDate();

		LocalFile.KoroneikiProductPurchaseAPI.generateStaticFullFutureStartAndEndDate();

		LocalFile.KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Cstpro - ${staticProjectName}",
			productName = "Portal Production",
			table = '''| End Date                | ${staticEndDate}         |   |
	| Original End Date       | ${staticOriginalEndDate} |   |
	| Perpetual               | false                    |   |
	| Product Field and Value | sizing                   | 1 |
	| Product Field and Value | licenses                 | 1 |
	| Product Field and Value | version                  | 6 |
	| Quantity                | 1                        |   |
	| Start Date              | ${staticStartDate}       |   |
	| Status                  | Approved                 |   |''');

		LocalFile.KoroneikiProductPurchaseAPI._generateProductPurchaseId(
			accountName = "Cstpro - ${staticProjectName}",
			productName = "DXP Production");

		LocalFile.KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Cstpro - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		LocalFile.CustomerLogin.loginToCustomer(
			userEmailAddress = ${staticCustomerAdminEmailAddress},
			userPassword = ${staticCustomerAdminPassword});

		LocalFile.CustomerProjects.searchCustomerProject(keyword = "Cstpro");

		LocalFile.CustomerProjects.clickCustomerProject(projectName = "Cstpro - ${staticProjectName}");

		LocalFile.CustomerProjectNavigation.chooseSubscriptionAtActivationTab(subscription = "DXP");

		LocalFile.CustomerProjectActivationKeys.clickGenerateActivationKeyButton();

		LocalFile.CustomerProjectActivationKeys.populateActivationKeyForm(table = '''| Version          | Select       | 6.1 GA1                     |
	| Key Type         | Select       | Production                  |
	| Subscription     | Radio Button | Oct 30, 2022 - Oct 30, 2023 |''');

		LocalFile.CustomerProjectActivationKeys.clickActivationKeyFormNextButton();

		LocalFile.CustomerProjectActivationKeys.populateActivationKeyForm(table = '''| Environment Name | Input  | Activation Key Name        |
	| Description      | Input  | Activation Key Description |
	| Host Name        | Input  | localhost                  |
	| IP Address       | Input  | 123.45.67.89               |
	| MAC Address      | Input  | 0A-1B-2C-3D-4E-5F          |''');

		LocalFile.CustomerProjectActivationKeys.clickActivationKeyFormGenerateButton();

		LocalFile.OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		LocalFile.Provisioning.gotoLicenses();

		LocalFile.Provisioning.searchLicenses(keyword = ${staticAccountKey});

		LocalFile.Provisioning._viewLicenseViaIndex(
			licenseKeyword = "Cstpro - ${staticProjectName} License1 Name",
			table = '''| Name          | Activation Key Name            |
	| Description   | Activation Key Description     |
	| Account       | Cstpro - ${staticProjectName}  |
	| Product       | Portal Production              |
	| Type          | Production                     |
	| Details       | Host Name: localhost           |
	| Details       | IP Address: 123.45.67.89       |
	| Details       | MAC Address: 0A-1B-2C-3D-4E-5F |
	| Status        | ACTIVE                         |
	| Complimentary | false                          |''');

		LocalFile.Provisioning.clickLicense(licenseKeyword = "Cstpro - ${staticProjectName}");

		LocalFile.ProvisioningLicense.viewLicense(table = '''| Header        | Cstpro - ${staticProjectName} | |
	| Product       | Portal Production             | |
	| Version       | 6.1 GA1                       | |
	| Type          | Production                    | |
	| Host Name     | localhost                     | |
	| IP Addresses  | 123.45.67.89                  | |
	| MAC Addresses | 0A-1B-2C-3D-4E-5F             | |
	| Owner         | Cstpro - ${staticProjectName} | |
	| Description   | Activation Key Description    | |
	| Complimentary | No                            | |
	| Status        | ACTIVE                        | |
	| Created By    | Test Test                     | |''');
	}

}