definition {

	property testray.main.component.name = "Support QA";
	property type = "osb.integration";

	setUp {
		LocalFile.Passwords.getPasswords();
	}

	tearDown {
		LocalFile.ZendeskUserAPI._getDefaultUserId(organizationName = "Korone - ${staticProjectName}");

		LocalFile.ZendeskUserAPI._renameFirstDefaultUserIdVariable();

		LocalFile.ZendeskUserAPI._getDefaultUserId(organizationName = "Oneiki - ${staticProjectName}");

		LocalFile.ZendeskUserAPI._renameSecondDefaultUserIdVariable();

		LocalFile.KoroneikiTeamAPI._tearDownTeams(table = '''| OSB Devlopr Team |
	| OSB Mktng Team   |''');

		LocalFile.KoroneikiTeamRoleAPI._tearDownTeamRoles(table = '''| Liferay Account Role  |
	| NonLiferay Accnt Role |''');

		LocalFile.OSBAdminProject.tearDownProjects(table = '''| KORONEKORONE |
	| ONEIKIONEIKI |''');

		LocalFile.KoroneikiAccountAPI._tearDownAccounts(table = '''| Korone - ${staticProjectName} |
	| Oneiki - ${staticProjectName} |''');

		LocalFile.KoroneikiAccountAPI._tearDownAccountsViaAccountFieldNameAndValue(
			fieldName = "Code",
			table = '''| KORONEKORONE |
	| ONEIKIONEIKI |''');

		LocalFile.KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		LocalFile.ZendeskOrganizationAPI._getMultipleOrganizationExternalIdsByOrganizationNameIfStillPresent(table = '''| Korone - ${staticProjectName} |
	| Oneiki - ${staticProjectName} |''');

		LocalFile.ZendeskOrganizationAPI._tearDownOrganizationsByExternalIdList(organizationExternalIds = ${staticOrganizationExternalIdList});

		LocalFile.ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId1});

		LocalFile.ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId2});
	}

	property help.center.acceptance = "true";
	test Createteamrole {
		LocalFile.OSBAdminRabbitMQ.generateProvisioningProjectName();

		LocalFile.KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORONEKORONE                         | |
	| Contact Email Address | osb.koroneiki1@lrcustomer.com.broken | |
	| Description           | Test osb account on koroneiki        | |
	| Fax Number            | 555-555-1234                         | |
	| Name                  | Korone - ${staticProjectName}        | |
	| Phone Number          | 555-555-5678                         | |
	| Profile Email Address | osb.koroneiki1@lrcustomer.com.broken | |
	| Region                | United States                        | |
	| Status                | Active                               | |
	| Tier                  | T4                                   | |
	| Website               | www.koroneikicorporation.com         | |''');

		LocalFile.KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		LocalFile.KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korone - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | true                     | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		LocalFile.KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korone - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | true                     | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		LocalFile.KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		LocalFile.KoroneikiAccountAPI._createAccountTeam(
			accountName = "Korone - ${staticProjectName}",
			teamName = "OSB Devlopr Team");

		LocalFile.KoroneikiTeamRoleAPI._createTeamRole(table = '''| Description | This is the default role for accounts |
	| Name        | Liferay Account Role                  |
	| Type        | Account                               |''');

		LocalFile.KoroneikiAccountAPI._assignTeamRolesToTeam(
			accountName = "Korone - ${staticProjectName}",
			table = '''| Liferay Account Role |''',
			teamName = "OSB Devlopr Team");

		LocalFile.OSBAdmin.loginToSupport(
			userEmailAddress = ${staticSupportAdminEmailAdress},
			userPassword = ${staticSupportAdminPassword});

		LocalFile.ProjectDetails.gotoProjectDetailsPage();

		LocalFile.ProjectDetails.searchKeyword(keyword = "Korone");

		LocalFile.ProjectDetails.gotoProject(projectName = "Korone - ${staticProjectName}");

		LocalFile.ProjectDetails.gotoHistory();

		LocalFile.ProjectDetails.viewHistoryEntryByKeywords(
			fieldName = "Team Role",
			keyword1 = "Assigned Team",
			keyword2 = "OSB Devlopr Team",
			table = '''| Updater Name                | Koroneiki QA Service Producer |
	| Update Summary              | Assigned Team                 |
	| Update Description          | OSB Devlopr Team              |
	| Update Date                 | Today                         |
	| Update Field Name           | Team Role                     |
	| Update Field Original Value | N/A                           |
	| Update Field New Value      | Liferay Account Role          |''');
	}

	test Createteamroleexecutedbyagent {
		LocalFile.OSBAdminRabbitMQ.generateProvisioningProjectName();

		LocalFile.KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORONEKORONE                         | |
	| Contact Email Address | osb.koroneiki1@lrcustomer.com.broken | |
	| Description           | Test osb account on koroneiki        | |
	| Fax Number            | 555-555-1234                         | |
	| Name                  | Korone - ${staticProjectName}        | |
	| Phone Number          | 555-555-5678                         | |
	| Profile Email Address | osb.koroneiki1@lrcustomer.com.broken | |
	| Region                | United States                        | |
	| Status                | Active                               | |
	| Tier                  | T4                                   | |
	| Website               | www.koroneikicorporation.com         | |''');

		LocalFile.KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		LocalFile.KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korone - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | true                     | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		LocalFile.KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korone - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | true                     | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		LocalFile.KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		LocalFile.KoroneikiAccountAPI._createAccountTeam(
			accountName = "Korone - ${staticProjectName}",
			teamName = "OSB Devlopr Team");

		LocalFile.KoroneikiTeamRoleAPI._createTeamRole(table = '''| Description | This is the default role for accounts |
	| Name        | Liferay Account Role                  |
	| Type        | Account                               |''');

		LocalFile.KoroneikiAccountAPI._assignTeamRolesToTeamExecutedByAgent(
			accountName = "Korone - ${staticProjectName}",
			agentName = "Koroneiki User",
			table = '''| Liferay Account Role |''',
			teamName = "OSB Devlopr Team");

		LocalFile.OSBAdmin.loginToSupport(
			userEmailAddress = ${staticSupportAdminEmailAdress},
			userPassword = ${staticSupportAdminPassword});

		LocalFile.ProjectDetails.gotoProjectDetailsPage();

		LocalFile.ProjectDetails.searchKeyword(keyword = "Korone");

		LocalFile.ProjectDetails.gotoProject(projectName = "Korone - ${staticProjectName}");

		LocalFile.ProjectDetails.gotoHistory();

		LocalFile.ProjectDetails.viewHistoryEntryByKeywords(
			fieldName = "Team Role",
			keyword1 = "Assigned Team",
			keyword2 = "OSB Devlopr Team",
			table = '''| Updater Name                | Koroneiki User       |
	| Update Summary              | Assigned Team        |
	| Update Description          | OSB Devlopr Team     |
	| Update Date                 | Today                |
	| Update Field Name           | Team Role            |
	| Update Field Original Value | N/A                  |
	| Update Field New Value      | Liferay Account Role |''');
	}

	test Removeteamrole {
		LocalFile.OSBAdminRabbitMQ.generateProvisioningProjectName();

		LocalFile.KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORONEKORONE                         | |
	| Contact Email Address | osb.koroneiki1@lrcustomer.com.broken | |
	| Description           | Test osb account on koroneiki        | |
	| Fax Number            | 555-555-1234                         | |
	| Name                  | Korone - ${staticProjectName}        | |
	| Phone Number          | 555-555-5678                         | |
	| Profile Email Address | osb.koroneiki1@lrcustomer.com.broken | |
	| Region                | United States                        | |
	| Status                | Active                               | |
	| Tier                  | T4                                   | |
	| Website               | www.koroneikicorporation.com         | |''');

		LocalFile.KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		LocalFile.KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korone - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | true                     | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		LocalFile.KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korone - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | true                     | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		LocalFile.KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		LocalFile.KoroneikiAccountAPI._createAccountTeam(
			accountName = "Korone - ${staticProjectName}",
			teamName = "OSB Devlopr Team");

		LocalFile.KoroneikiTeamRoleAPI._createTeamRole(table = '''| Description | This is the default role for accounts |
	| Name        | Liferay Account Role                  |
	| Type        | Account                               |''');

		LocalFile.KoroneikiAccountAPI._assignTeamRolesToTeam(
			accountName = "Korone - ${staticProjectName}",
			table = '''| Liferay Account Role |''',
			teamName = "OSB Devlopr Team");

		LocalFile.KoroneikiAccountAPI._removeTeamRolesFromTeam(
			accountName = "Korone - ${staticProjectName}",
			table = '''| Liferay Account Role |''',
			teamName = "OSB Devlopr Team");

		LocalFile.OSBAdmin.loginToSupport(
			userEmailAddress = ${staticSupportAdminEmailAdress},
			userPassword = ${staticSupportAdminPassword});

		LocalFile.ProjectDetails.gotoProjectDetailsPage();

		LocalFile.ProjectDetails.searchKeyword(keyword = "Korone");

		LocalFile.ProjectDetails.gotoProject(projectName = "Korone - ${staticProjectName}");

		LocalFile.ProjectDetails.gotoHistory();

		LocalFile.ProjectDetails.viewHistoryEntryByKeywords(
			fieldName = "Team Role",
			keyword1 = "Assigned Team",
			keyword2 = "OSB Devlopr Team",
			table = '''| Updater Name                | Koroneiki QA Service Producer |
	| Update Summary              | Assigned Team                 |
	| Update Description          | OSB Devlopr Team              |
	| Update Date                 | Today                         |
	| Update Field Name           | Team Role                     |
	| Update Field Original Value | N/A                           |
	| Update Field New Value      | Liferay Account Role          |''');

		LocalFile.ProjectDetails.viewHistoryEntryByKeywords(
			fieldName = "Team Role",
			keyword1 = "Unassigned Team",
			keyword2 = "OSB Devlopr Team",
			table = '''| Updater Name                | Koroneiki QA Service Producer |
	| Update Summary              | Unassigned Team               |
	| Update Description          | OSB Devlopr Team              |
	| Update Date                 | Today                         |
	| Update Field Name           | Team Role                     |
	| Update Field Original Value | Liferay Account Role          |
	| Update Field New Value      | N/A                           |''');
	}

	test Removeteamroleexecutedbyagent {
		LocalFile.OSBAdminRabbitMQ.generateProvisioningProjectName();

		LocalFile.KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORONEKORONE                         | |
	| Contact Email Address | osb.koroneiki1@lrcustomer.com.broken | |
