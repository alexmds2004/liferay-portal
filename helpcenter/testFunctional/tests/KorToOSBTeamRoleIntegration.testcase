definition {

	property testray.main.component.name = "Support QA";
	property type = "osb.integration";

	setUp {
		Passwords.getPasswords();
	}

	tearDown {
		ZendeskUserAPI._getDefaultUserId(organizationName = "Korone - ${staticProjectName}");

		ZendeskUserAPI._renameFirstDefaultUserIdVariable();

		ZendeskUserAPI._getDefaultUserId(organizationName = "Oneiki - ${staticProjectName}");

		ZendeskUserAPI._renameSecondDefaultUserIdVariable();

		KoroneikiTeamAPI._tearDownTeams(table = '''| OSB Devlopr Team |
	| OSB Mktng Team   |''');

		KoroneikiTeamRoleAPI._tearDownTeamRoles(table = '''| Liferay Account Role  |
	| NonLiferay Accnt Role |''');

		OSBAdminProject.tearDownProjects(table = '''| KORONEKORONE |
	| ONEIKIONEIKI |''');

		KoroneikiAccountAPI._tearDownAccounts(table = '''| Korone - ${staticProjectName} |
	| Oneiki - ${staticProjectName} |''');

		KoroneikiAccountAPI._tearDownAccountsViaAccountFieldNameAndValue(
			fieldName = "Code",
			table = '''| KORONEKORONE |
	| ONEIKIONEIKI |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		ZendeskOrganizationAPI._getMultipleOrganizationExternalIdsByOrganizationNameIfStillPresent(table = '''| Korone - ${staticProjectName} |
	| Oneiki - ${staticProjectName} |''');

		ZendeskOrganizationAPI._tearDownOrganizationsByExternalIdList(organizationExternalIds = ${staticOrganizationExternalIdList});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId1});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId2});
	}

	test Createteamrole {
		property help.center.acceptance = "true";

		OSBAdminRabbitMQ.generateProvisioningProjectName();

		KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORONEKORONE                         | |
	| Contact Email Address | osb.koroneiki1@lrcustomer.com.broken | |
	| Description           | Test osb account on koroneiki        | |
	| Fax Number            | 555-555-1234                         | |
	| Name                  | Korone - ${staticProjectName}        | |
	| Phone Number          | 555-555-5678                         | |
	| Profile Email Address | osb.koroneiki1@lrcustomer.com.broken | |
	| Region                | United States                        | |
	| Status                | Active                               | |
	| Tier                  | T4                                   | |
	| Website               | www.koroneikicorporation.com         | |''');

		KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korone - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | true                     | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korone - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | true                     | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		KoroneikiAccountAPI._createAccountTeam(
			accountName = "Korone - ${staticProjectName}",
			teamName = "OSB Devlopr Team");

		KoroneikiTeamRoleAPI._createTeamRole(table = '''| Description | This is the default role for accounts |
	| Name        | Liferay Account Role                  |
	| Type        | Account                               |''');

		KoroneikiAccountAPI._assignTeamRolesToTeam(
			accountName = "Korone - ${staticProjectName}",
			table = '''| Liferay Account Role |''',
			teamName = "OSB Devlopr Team");

		OSBAdmin.loginToSupport(
			userEmailAddress = ${staticSupportAdminEmailAdress},
			userPassword = ${staticSupportAdminPassword});

		ProjectDetails.gotoProjectDetailsPage();

		ProjectDetails.searchKeyword(keyword = "Korone");

		ProjectDetails.gotoProject(projectName = "Korone - ${staticProjectName}");

		ProjectDetails.gotoHistory();

		ProjectDetails.viewHistoryEntryByKeywords(
			fieldName = "Team Role",
			keyword1 = "Assigned Team",
			keyword2 = "OSB Devlopr Team",
			table = '''| Updater Name                | Koroneiki QA Service Producer |
	| Update Summary              | Assigned Team                 |
	| Update Description          | OSB Devlopr Team              |
	| Update Date                 | Today                         |
	| Update Field Name           | Team Role                     |
	| Update Field Original Value | N/A                           |
	| Update Field New Value      | Liferay Account Role          |''');
	}

	test Createteamroleexecutedbyagent {
		OSBAdminRabbitMQ.generateProvisioningProjectName();

		KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORONEKORONE                         | |
	| Contact Email Address | osb.koroneiki1@lrcustomer.com.broken | |
	| Description           | Test osb account on koroneiki        | |
	| Fax Number            | 555-555-1234                         | |
	| Name                  | Korone - ${staticProjectName}        | |
	| Phone Number          | 555-555-5678                         | |
	| Profile Email Address | osb.koroneiki1@lrcustomer.com.broken | |
	| Region                | United States                        | |
	| Status                | Active                               | |
	| Tier                  | T4                                   | |
	| Website               | www.koroneikicorporation.com         | |''');

		KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korone - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | true                     | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korone - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | true                     | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		KoroneikiAccountAPI._createAccountTeam(
			accountName = "Korone - ${staticProjectName}",
			teamName = "OSB Devlopr Team");

		KoroneikiTeamRoleAPI._createTeamRole(table = '''| Description | This is the default role for accounts |
	| Name        | Liferay Account Role                  |
	| Type        | Account                               |''');

		KoroneikiAccountAPI._assignTeamRolesToTeamExecutedByAgent(
			accountName = "Korone - ${staticProjectName}",
			agentName = "Koroneiki User",
			table = '''| Liferay Account Role |''',
			teamName = "OSB Devlopr Team");

		OSBAdmin.loginToSupport(
			userEmailAddress = ${staticSupportAdminEmailAdress},
			userPassword = ${staticSupportAdminPassword});

		ProjectDetails.gotoProjectDetailsPage();

		ProjectDetails.searchKeyword(keyword = "Korone");

		ProjectDetails.gotoProject(projectName = "Korone - ${staticProjectName}");

		ProjectDetails.gotoHistory();

		ProjectDetails.viewHistoryEntryByKeywords(
			fieldName = "Team Role",
			keyword1 = "Assigned Team",
			keyword2 = "OSB Devlopr Team",
			table = '''| Updater Name                | Koroneiki User       |
	| Update Summary              | Assigned Team        |
	| Update Description          | OSB Devlopr Team     |
	| Update Date                 | Today                |
	| Update Field Name           | Team Role            |
	| Update Field Original Value | N/A                  |
	| Update Field New Value      | Liferay Account Role |''');
	}

	test Removeteamrole {
		OSBAdminRabbitMQ.generateProvisioningProjectName();

		KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORONEKORONE                         | |
	| Contact Email Address | osb.koroneiki1@lrcustomer.com.broken | |
	| Description           | Test osb account on koroneiki        | |
	| Fax Number            | 555-555-1234                         | |
	| Name                  | Korone - ${staticProjectName}        | |
	| Phone Number          | 555-555-5678                         | |
	| Profile Email Address | osb.koroneiki1@lrcustomer.com.broken | |
	| Region                | United States                        | |
	| Status                | Active                               | |
	| Tier                  | T4                                   | |
	| Website               | www.koroneikicorporation.com         | |''');

		KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korone - ${staticProjectName}",
			productName = "DXP Production",
