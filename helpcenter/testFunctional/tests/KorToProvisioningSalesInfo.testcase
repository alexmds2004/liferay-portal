		LocalFile.ProvisioningAccount.clickSidePanelTab(tabName = "Sales Info");

		LocalFile.ProvisioningAccount.clickSalesInfoActionButton(
			action = "Edit",
			salesInfoContent = "Account Sales Info Content");

		LocalFile.ProvisioningAccount.cancelSalesInfoNoteEdit(
			contentEdit = "Account Sales Info Edited Content",
			salesInfoContent = "Account Sales Info Content");

		LocalFile.ProvisioningAccount._viewAccountSalesInfo(
