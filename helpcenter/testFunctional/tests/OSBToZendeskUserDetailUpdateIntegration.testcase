definition {

	property testray.main.component.name = "Support QA";
	property type = "zendesk.integration";

	setUp {
		Passwords.getPasswords();

		OSBAdminRabbitMQ.generateProvisioningProjectName();

		JSONOkta.createOktaUser(table = '''| Screen Name   | osb.customer1                       |
	| Email Address | osb.customer1@lrcustomer.com.broken |
	| First Name    | OSB                                 |
	| Last Name     | Customer1                           |''');

		JSONOkta.createOktaUser(table = '''| Screen Name   | osb.customer2                       |
	| Email Address | osb.customer2@lrcustomer.com.broken |
	| First Name    | OSB                                 |
	| Last Name     | Customer2                           |''');

		KoroneikiAccountAPI._createAccount(table = '''| Code     | OSBZENOSBZEN                  | |
	| Language | English                       | |
	| Name     | Osbzen - ${staticProjectName} | |
	| Region   | United States                 | |
	| Status   | Active                        | |
	| Tier     | T1                            | |''');

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Osbzen - ${staticProjectName}",
			contactEmailAddress = "osb.customer1@lrcustomer.com.broken",
			table = '''| Support Requester |''');

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Osbzen - ${staticProjectName}",
			contactEmailAddress = "osb.customer2@lrcustomer.com.broken",
			table = '''| Support User |''');

		KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Osbzen - ${staticProjectName}",
			productName = "Portal Production",
			table = '''| End Date                | ${staticEndDate}         |   |
	| Original End Date       | ${staticOriginalEndDate} |   |
	| Perpetual               | false                    |   |
	| Product Field and Value | sizing                   | 1 |
	| Product Field and Value | licenses                 | 1 |
	| Product Field and Value | version                  | 6 |
	| Quantity                | 1                        |   |
	| Start Date              | ${staticStartDate}       |   |
	| Status                  | Approved                 |   |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Osbzen - ${staticProjectName}",
			productName = "Gold Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Gold Subscription");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - Portal");

		JSONOSBAccount.viewSupportOrganizationSync(accountCode = "OSBZENOSBZEN");

		ZendeskOrganizationAPI._viewOrganizationSyncFromOsb(organizationName = "Osbzen - ${staticProjectName}");

		ZendeskUserAPI._viewUserSyncFromOsb(userEmailAddress = "osb.customer1@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserSyncFromOsb(userEmailAddress = "osb.customer2@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserSyncFromOsbViaSearchByExternalIdApi(userEmailAddress = "osb.customer1@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserSyncFromOsbViaSearchByExternalIdApi(userEmailAddress = "osb.customer2@lrcustomer.com.broken");
	}

	tearDown {
		ZendeskUserAPI._getDefaultUserId(organizationName = "Osbzen - ${staticProjectName}");

		OSBAdminProject.tearDownProjects(table = '''| OSBZENOSBZEN |''');

		KoroneikiAccountAPI._tearDownAccounts(table = '''| Osbzen - ${staticProjectName} |''');

		KoroneikiAccountAPI._tearDownAccountsViaAccountFieldNameAndValue(
			fieldName = "Code",
			table = '''| OSBZENOSBZEN |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Gold Subscription");

		JSONUser.tearDownUsersViaSupport(table = '''| edit.user1@lrcustomer.com.broken    |
	| edit.user2@lrcustomer.com.broken    |
	| osb.customer1@lrcustomer.com.broken |
	| osb.customer2@lrcustomer.com.broken |''');

		JSONUser.tearDownUsersViaKoroneiki(table = '''| edit.user1@lrcustomer.com.broken    |
	| edit.user2@lrcustomer.com.broken    |
	| osb.customer1@lrcustomer.com.broken |
	| osb.customer2@lrcustomer.com.broken |''');

		KoroneikiContactAPI._tearDownContacts(table = '''| edit.user1@lrcustomer.com.broken    |
	| edit.user2@lrcustomer.com.broken    |
	| osb.customer1@lrcustomer.com.broken |
	| osb.customer2@lrcustomer.com.broken |''');

		JSONOkta.tearDownUsers(table = '''| edit.user1@lrcustomer.com.broken    |
	| edit.user2@lrcustomer.com.broken    |
	| osb.customer1@lrcustomer.com.broken |
	| osb.customer2@lrcustomer.com.broken |''');

		ZendeskUserAPI._getMultipleUserIdsByEmailAddress(table = '''| edit.user1@lrcustomer.com.broken    |
	| edit.user2@lrcustomer.com.broken    |
	| osb.customer1@lrcustomer.com.broken |
	| osb.customer2@lrcustomer.com.broken |''');

		ZendeskUserAPI._tearDownUsersByIdList(userIds = ${staticUserIdList});

		ZendeskOrganizationAPI._getMultipleOrganizationExternalIdsByOrganizationNameIfStillPresent(table = '''| Osbzen - ${staticProjectName} |''');

		ZendeskOrganizationAPI._tearDownOrganizationsByExternalIdList(organizationExternalIds = ${staticOrganizationExternalIdList});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId1});
	}

	test Viewupdateduserlogin {
		JSONOkta.updateOktaUser(
			table = '''| Screen Name   | edit.user1                       |
	| Email Address | edit.user1@lrcustomer.com.broken |
	| First Name    | Edit                             |
	| Last Name     | User1                            |''',
			userOriginalEmailAddress = "osb.customer1@lrcustomer.com.broken");

		JSONOkta.updateOktaUser(
			table = '''| Screen Name   | edit.user2                       |
	| Email Address | edit.user2@lrcustomer.com.broken |
	| First Name    | Edit                             |
	| Last Name     | User2                            |''',
			userOriginalEmailAddress = "osb.customer2@lrcustomer.com.broken");

		ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		ZendeskUserAPI._viewUserSyncFromOsb(userEmailAddress = "edit.user1@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserSyncFromOsb(userEmailAddress = "edit.user2@lrcustomer.com.broken");

		ZendeskUserAPI._updateUserPasswordByEmailAddress(
			userEmailAddress = "edit.user1@lrcustomer.com.broken",
			userPassword = ${staticZendeskAdminPassword});

		ZendeskUserAPI._updateUserPasswordByEmailAddress(
			userEmailAddress = "edit.user2@lrcustomer.com.broken",
			userPassword = ${staticZendeskAdminPassword});

		ZendeskHomepage.login(
			userEmailAddress = "edit.user1@lrcustomer.com.broken",
			userPassword = ${staticZendeskAdminPassword});

		ZendeskHomepage.viewHomepageWithKBPermissions();

		ZendeskHomepage.logoutAndLogin(
			userEmailAddress = "edit.user2@lrcustomer.com.broken",
			userPassword = ${staticZendeskAdminPassword});

		ZendeskHomepage.viewHomepageWithKBPermissions();
	}

	test Viewuseremailupdates {
		JSONOkta.updateOktaUser(
			table = '''| Email Address | edit.user1@lrcustomer.com.broken |''',
			userOriginalEmailAddress = "osb.customer1@lrcustomer.com.broken");

		JSONOkta.updateOktaUser(
			table = '''| Email Address | edit.user2@lrcustomer.com.broken |''',
			userOriginalEmailAddress = "osb.customer2@lrcustomer.com.broken");

		ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		ZendeskUserAPI._viewUserSyncFromOsb(userEmailAddress = "edit.user1@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserSyncFromOsb(userEmailAddress = "edit.user2@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserOrganizationIdSync(
			organizationName = "Osbzen - ${staticProjectName}",
			userEmailAddress = "edit.user1@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserOrganizationIdSync(
			organizationName = "Osbzen - ${staticProjectName}",
			userEmailAddress = "edit.user2@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserOrganizationSubscriptionSync(
			organizationName = "Osbzen - ${staticProjectName}",
			userEmailAddress = "edit.user1@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserOrganizationSubscriptionSync(
			organizationName = "Osbzen - ${staticProjectName}",
			userEmailAddress = "edit.user2@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserTagSync(
			tag = "osb_kb",
			userEmailAddress = "edit.user1@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserTagSync(
			tag = "osb_kb",
			userEmailAddress = "edit.user2@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserTagSync(
			tag = "osb_customer",
			userEmailAddress = "edit.user1@lrcustomer.com.broken");

		ZendeskUserAPI._viewNoUserTagSync(
			tag = "osb_customer",
			userEmailAddress = "edit.user2@lrcustomer.com.broken");

		ZendeskUserAPI._viewNoUserWatcherTagSync(
			organizationName = "Osbzen - ${staticProjectName}",
			userEmailAddress = "edit.user1@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserWatcherTagSync(
			organizationName = "Osbzen - ${staticProjectName}",
			userEmailAddress = "edit.user2@lrcustomer.com.broken");

		ZendeskUserAPI._matchOsbUserUuIdWithZendeskUserId(userEmailAddress = "edit.user1@lrcustomer.com.broken");

		ZendeskUserAPI._matchOsbUserUuIdWithZendeskUserId(userEmailAddress = "edit.user2@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserNameByEmailAddress(
			userEmailAddress = "edit.user1@lrcustomer.com.broken",
			userName = "OSB Customer1");

		ZendeskUserAPI._viewUserNameByEmailAddress(
			userEmailAddress = "edit.user2@lrcustomer.com.broken",
			userName = "OSB Customer2");

		ZendeskUserAPI._viewUserNoSyncFromOsb(userEmailAddress = "osb.customer1@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserNoSyncFromOsb(userEmailAddress = "osb.customer2@lrcustomer.com.broken");
	}

	test Viewusernameupdates {
		JSONOkta.updateOktaUser(
			table = '''| First Name | Edit  |
	| Last Name  | User1 |''',
			userOriginalEmailAddress = "osb.customer1@lrcustomer.com.broken");

		JSONOkta.updateOktaUser(
			table = '''| First Name | Edit  |
	| Last Name  | User2 |''',
			userOriginalEmailAddress = "osb.customer2@lrcustomer.com.broken");

		ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		ZendeskUserAPI._viewUserSyncFromOsb(userEmailAddress = "osb.customer1@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserSyncFromOsb(userEmailAddress = "osb.customer2@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserOrganizationIdSync(
			organizationName = "Osbzen - ${staticProjectName}",
			userEmailAddress = "osb.customer1@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserOrganizationIdSync(
			organizationName = "Osbzen - ${staticProjectName}",
			userEmailAddress = "osb.customer2@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserOrganizationSubscriptionSync(
			organizationName = "Osbzen - ${staticProjectName}",
			userEmailAddress = "osb.customer1@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserOrganizationSubscriptionSync(
			organizationName = "Osbzen - ${staticProjectName}",
			userEmailAddress = "osb.customer2@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserTagSync(
			tag = "osb_kb",
			userEmailAddress = "osb.customer1@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserTagSync(
			tag = "osb_kb",
			userEmailAddress = "osb.customer2@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserTagSync(
			tag = "osb_customer",
			userEmailAddress = "osb.customer1@lrcustomer.com.broken");

		ZendeskUserAPI._viewNoUserTagSync(
			tag = "osb_customer",
			userEmailAddress = "osb.customer2@lrcustomer.com.broken");

		ZendeskUserAPI._viewNoUserWatcherTagSync(
			organizationName = "Osbzen - ${staticProjectName}",
			userEmailAddress = "osb.customer1@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserWatcherTagSync(
			organizationName = "Osbzen - ${staticProjectName}",
			userEmailAddress = "osb.customer2@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserNameByEmailAddress(
			userEmailAddress = "osb.customer1@lrcustomer.com.broken",
			userName = "Edit User1");

		ZendeskUserAPI._viewUserNameByEmailAddress(
			userEmailAddress = "osb.customer2@lrcustomer.com.broken",
			userName = "Edit User2");

		KoroneikiContactAPI._viewContactUuidAndUserUuidComparison(contactEmailAddress = "osb.customer1@lrcustomer.com.broken");

		KoroneikiContactAPI._viewContactUuidAndUserUuidComparison(contactEmailAddress = "osb.customer2@lrcustomer.com.broken");

		ZendeskUserAPI._matchOsbUserUuIdWithZendeskUserId(userEmailAddress = "osb.customer1@lrcustomer.com.broken");

		ZendeskUserAPI._matchOsbUserUuIdWithZendeskUserId(userEmailAddress = "osb.customer2@lrcustomer.com.broken");
	}

	test Viewuserupdates {
		JSONOkta.updateOktaUser(
			table = '''| Screen Name   | edit.user1                       |
	| Email Address | edit.user1@lrcustomer.com.broken |
	| First Name    | Edit                             |
	| Last Name     | User1                            |''',
			userOriginalEmailAddress = "osb.customer1@lrcustomer.com.broken");

		JSONOkta.updateOktaUser(
			table = '''| Screen Name   | edit.user2                       |
	| Email Address | edit.user2@lrcustomer.com.broken |
	| First Name    | Edit                             |
	| Last Name     | User2                            |''',
			userOriginalEmailAddress = "osb.customer2@lrcustomer.com.broken");

		ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		ZendeskUserAPI._viewUserSyncFromOsb(userEmailAddress = "edit.user1@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserSyncFromOsb(userEmailAddress = "edit.user2@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserOrganizationIdSync(
			organizationName = "Osbzen - ${staticProjectName}",
			userEmailAddress = "edit.user1@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserOrganizationIdSync(
			organizationName = "Osbzen - ${staticProjectName}",
			userEmailAddress = "edit.user2@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserOrganizationSubscriptionSync(
			organizationName = "Osbzen - ${staticProjectName}",
			userEmailAddress = "edit.user1@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserOrganizationSubscriptionSync(
			organizationName = "Osbzen - ${staticProjectName}",
			userEmailAddress = "edit.user2@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserTagSync(
			tag = "osb_kb",
			userEmailAddress = "edit.user1@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserTagSync(
			tag = "osb_kb",
			userEmailAddress = "edit.user2@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserTagSync(
			tag = "osb_customer",
			userEmailAddress = "edit.user1@lrcustomer.com.broken");

		ZendeskUserAPI._viewNoUserTagSync(
			tag = "osb_customer",
			userEmailAddress = "edit.user2@lrcustomer.com.broken");

		ZendeskUserAPI._viewNoUserWatcherTagSync(
			organizationName = "Osbzen - ${staticProjectName}",
			userEmailAddress = "edit.user1@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserWatcherTagSync(
			organizationName = "Osbzen - ${staticProjectName}",
			userEmailAddress = "edit.user2@lrcustomer.com.broken");

		ZendeskUserAPI._matchOsbUserUuIdWithZendeskUserId(userEmailAddress = "edit.user1@lrcustomer.com.broken");

		ZendeskUserAPI._matchOsbUserUuIdWithZendeskUserId(userEmailAddress = "edit.user2@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserNameByEmailAddress(
			userEmailAddress = "edit.user1@lrcustomer.com.broken",
			userName = "Edit User1");

		ZendeskUserAPI._viewUserNameByEmailAddress(
			userEmailAddress = "edit.user2@lrcustomer.com.broken",
			userName = "Edit User2");

		ZendeskUserAPI._viewUserNoSyncFromOsb(userEmailAddress = "osb.customer1@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserNoSyncFromOsb(userEmailAddress = "osb.customer2@lrcustomer.com.broken");
	}

}