	test Viewcommercedownloadsaspermissionedusers {
		OSBAdminRabbitMQ.generateProvisioningProjectName();

		JSONOkta.createOktaUser(table = '''| Screen Name   | dwn.customer1                       |
	| Email Address | dwn.customer1@lrcustomer.com.broken |
	| First Name    | DWN                                 |
	| Last Name     | Customer1                           |''');

		JSONOkta.createOktaUser(table = '''| Screen Name   | dwn.customer2                       |
	| Email Address | dwn.customer2@lrcustomer.com.broken |
	| First Name    | DWN                                 |
	| Last Name     | Customer2                           |''');

		KoroneikiAccountAPI._createAccount(table = '''| Code   | DWNZENDWNZEN                  | |
	| Name   | Dwnzen - ${staticProjectName} | |
	| Region | United States                 | |
	| Status | Active                        | |
	| Tier   | T1                            | |''');

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Dwnzen - ${staticProjectName}",
			contactEmailAddress = "dwn.customer1@lrcustomer.com.broken",
			table = '''| Support Requester |''');

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Dwnzen - ${staticProjectName}",
			contactEmailAddress = "dwn.customer2@lrcustomer.com.broken",
			table = '''| Support User |''');

		KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Dwnzen - ${staticProjectName}",
			productName = "Commerce Subscription Production",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Dwnzen - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - Commerce");

		JSONUser.viewSupportUserSync(userEmailAddress = "dwn.customer1@lrcustomer.com.broken");

		JSONUser.viewSupportUserSync(userEmailAddress = "dwn.customer2@lrcustomer.com.broken");

		JSONUser.updateSupportPassword(
			userEmailAddress = "dwn.customer1@lrcustomer.com.broken",
			userPassword = ${staticSupportUserTestPassword});

		JSONUser.updateSupportPassword(
			userEmailAddress = "dwn.customer2@lrcustomer.com.broken",
			userPassword = ${staticSupportUserTestPassword});

		JSONUser.assignUserToSupportGroup(
			groupName = "Help Center",
			userEmailAddress = "dwn.customer1@lrcustomer.com.broken");

		JSONUser.assignUserToSupportGroup(
			groupName = "Help Center",
			userEmailAddress = "dwn.customer2@lrcustomer.com.broken");

		OSBAdmin.logoutAndLoginToSupport(
			userEmailAddress = "dwn.customer1@lrcustomer.com.broken",
			userPassword = ${staticSupportUserTestPassword});

		Downloads.gotoDownloadsPage();

		Downloads.setSearchFilters(
			fileType = "Product",
			productName = "Commerce");

		Downloads.viewDownloadHeader(downloadName = "Liferay Commerce 2.1.3");

		Downloads.viewDownloadHeader(downloadName = "Liferay Commerce 2.2.0");

		OSBAdmin.logoutAndLoginToSupport(
			userEmailAddress = "dwn.customer2@lrcustomer.com.broken",
			userPassword = ${staticSupportUserTestPassword});

		Downloads.gotoDownloadsPage();

		Downloads.setSearchFilters(
			fileType = "Product",
			productName = "Commerce");

		Downloads.viewDownloadHeader(downloadName = "Liferay Commerce 2.1.3");

		Downloads.viewDownloadHeader(downloadName = "Liferay Commerce 2.2.0");
	}

	test Viewdxpdownloadsaspermissionedusers {
		property help.center.acceptance = "true";
		OSBAdminRabbitMQ.generateProvisioningProjectName();

		JSONOkta.createOktaUser(table = '''| Screen Name   | dwn.customer1                       |
	| Email Address | dwn.customer1@lrcustomer.com.broken |
	| First Name    | DWN                                 |
	| Last Name     | Customer1                           |''');

