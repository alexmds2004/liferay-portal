		LocalFile.Downloads.viewDownloadHeader(downloadName = "Liferay DXP 7.2 Fix Pack 2");

		LocalFile.Downloads.viewDownloadHeader(downloadName = "Liferay DXP 7.2 Fix Pack 1");

