definition {

	property testray.main.component.name = "Support QA";
	property type = "customer.portal";

	setUp {
		Passwords.getPasswords();
	}

	tearDown {
		ZendeskUserAPI._getDefaultUserId(organizationName = "Dwnzen - ${staticProjectName}");

		OSBAdminProject.tearDownProjects(table = '''| DWNZENDWNZEN |''');

		KoroneikiAccountAPI._tearDownAccounts(table = '''| Dwnzen - ${staticProjectName} |''');

		KoroneikiAccountAPI._tearDownAccountsViaAccountFieldNameAndValue(
			fieldName = "Code",
			table = '''| DWNZENDWNZEN |''');

		JSONUser.tearDownUsers(table = '''| dwn.customer1@lrcustomer.com.broken |
	| dwn.customer2@lrcustomer.com.broken |''');

		JSONUser.tearDownUsersViaSupport(table = '''| dwn.customer1@lrcustomer.com.broken |
	| dwn.customer2@lrcustomer.com.broken |''');

		JSONUser.tearDownUsersViaKoroneiki(table = '''| dwn.customer1@lrcustomer.com.broken |
	| dwn.customer2@lrcustomer.com.broken |''');

		KoroneikiContactAPI._tearDownContacts(table = '''| dwn.customer1@lrcustomer.com.broken |
	| dwn.customer2@lrcustomer.com.broken |''');

		JSONOkta.tearDownUsers(table = '''| dwn.customer1@lrcustomer.com.broken |
	| dwn.customer2@lrcustomer.com.broken |''');

		ZendeskUserAPI._getMultipleUserIdsByEmailAddress(table = '''| dwn.customer1@lrcustomer.com.broken |
	| dwn.customer2@lrcustomer.com.broken |''');

		ZendeskUserAPI._tearDownUsersByIdList(userIds = ${staticUserIdList});

		ZendeskOrganizationAPI._getMultipleOrganizationExternalIdsByOrganizationNameIfStillPresent(table = '''| Dwnzen - ${staticProjectName} |''');

		ZendeskOrganizationAPI._tearDownOrganizationsByExternalIdList(organizationExternalIds = ${staticOrganizationExternalIdList});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId});
	}

	test AttempttoviewdownloadsasLXCBusinessPlancustomers {
		OSBAdminRabbitMQ.generateProvisioningProjectName();

		JSONOkta.createOktaUser(table = '''| Screen Name   | dwn.customer1                       |
	| Email Address | dwn.customer1@lrcustomer.com.broken |
	| First Name    | DWN                                 |
	| Last Name     | Customer1                           |''');

		JSONOkta.createOktaUser(table = '''| Screen Name   | dwn.customer2                       |
	| Email Address | dwn.customer2@lrcustomer.com.broken |
	| First Name    | DWN                                 |
	| Last Name     | Customer2                           |''');

		KoroneikiAccountAPI._createAccount(table = '''| Code   | DWNZENDWNZEN                  | |
	| Name   | Dwnzen - ${staticProjectName} | |
	| Region | United States                 | |
	| Status | Active                        | |
	| Tier   | T1                            | |''');

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Dwnzen - ${staticProjectName}",
			contactEmailAddress = "dwn.customer1@lrcustomer.com.broken",
			table = '''| Support Requester |''');

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Dwnzen - ${staticProjectName}",
			contactEmailAddress = "dwn.customer2@lrcustomer.com.broken",
			table = '''| Support User |''');

		KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Dwnzen - ${staticProjectName}",
			productName = "LXC - Business Plan",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Dwnzen - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		JSONUser.viewSupportUserSync(userEmailAddress = "dwn.customer1@lrcustomer.com.broken");

		JSONUser.viewSupportUserSync(userEmailAddress = "dwn.customer2@lrcustomer.com.broken");

		JSONUser.updateSupportPassword(
			userEmailAddress = "dwn.customer1@lrcustomer.com.broken",
			userPassword = ${staticSupportUserTestPassword});

		JSONUser.updateSupportPassword(
			userEmailAddress = "dwn.customer2@lrcustomer.com.broken",
			userPassword = ${staticSupportUserTestPassword});

		JSONUser.assignUserToSupportGroup(
			groupName = "Help Center",
			userEmailAddress = "dwn.customer1@lrcustomer.com.broken");

		JSONUser.assignUserToSupportGroup(
			groupName = "Help Center",
			userEmailAddress = "dwn.customer2@lrcustomer.com.broken");

		OSBAdmin.logoutAndLoginToSupport(
			userEmailAddress = "dwn.customer1@lrcustomer.com.broken",
			userPassword = ${staticSupportUserTestPassword});

		Downloads.viewNoDownloadsPage();
	}

	test AttempttoviewdownloadsasLXCEnterprisePlancustomers {
		OSBAdminRabbitMQ.generateProvisioningProjectName();

		JSONOkta.createOktaUser(table = '''| Screen Name   | dwn.customer1                       |
	| Email Address | dwn.customer1@lrcustomer.com.broken |
	| First Name    | DWN                                 |
	| Last Name     | Customer1                           |''');

		JSONOkta.createOktaUser(table = '''| Screen Name   | dwn.customer2                       |
	| Email Address | dwn.customer2@lrcustomer.com.broken |
	| First Name    | DWN                                 |
	| Last Name     | Customer2                           |''');

		KoroneikiAccountAPI._createAccount(table = '''| Code   | DWNZENDWNZEN                  | |
	| Name   | Dwnzen - ${staticProjectName} | |
	| Region | United States                 | |
	| Status | Active                        | |
	| Tier   | T1                            | |''');

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Dwnzen - ${staticProjectName}",
			contactEmailAddress = "dwn.customer1@lrcustomer.com.broken",
			table = '''| Support Requester |''');

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Dwnzen - ${staticProjectName}",
			contactEmailAddress = "dwn.customer2@lrcustomer.com.broken",
			table = '''| Support User |''');

		KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Dwnzen - ${staticProjectName}",
			productName = "LXC - Enterprise Plan",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Dwnzen - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		JSONUser.viewSupportUserSync(userEmailAddress = "dwn.customer1@lrcustomer.com.broken");

		JSONUser.viewSupportUserSync(userEmailAddress = "dwn.customer2@lrcustomer.com.broken");

		JSONUser.updateSupportPassword(
			userEmailAddress = "dwn.customer1@lrcustomer.com.broken",
			userPassword = ${staticSupportUserTestPassword});

		JSONUser.updateSupportPassword(
			userEmailAddress = "dwn.customer2@lrcustomer.com.broken",
			userPassword = ${staticSupportUserTestPassword});

		JSONUser.assignUserToSupportGroup(
			groupName = "Help Center",
			userEmailAddress = "dwn.customer1@lrcustomer.com.broken");

		JSONUser.assignUserToSupportGroup(
			groupName = "Help Center",
			userEmailAddress = "dwn.customer2@lrcustomer.com.broken");

		OSBAdmin.logoutAndLoginToSupport(
			userEmailAddress = "dwn.customer1@lrcustomer.com.broken",
			userPassword = ${staticSupportUserTestPassword});

		Downloads.viewNoDownloadsPage();
	}

	test AttempttoviewdownloadsasLXCProPlancustomers {
		OSBAdminRabbitMQ.generateProvisioningProjectName();

		JSONOkta.createOktaUser(table = '''| Screen Name   | dwn.customer1                       |
