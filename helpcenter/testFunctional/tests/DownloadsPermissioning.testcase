		Downloads.viewDownloadHeader(downloadName = "Liferay DXP 7.1 Fix Pack 14");

		Downloads.viewDownloadHeader(downloadName = "Liferay DXP 7.1 Fix Pack 13");

		Downloads.setSearchFilters(
			fileType = "Fix Packs",
			productName = "DXP 7.0");

		Downloads.viewDownloadHeader(downloadName = "Liferay DXP 7.0 Fix Pack 86");

		Downloads.viewDownloadHeader(downloadName = "Liferay DXP 7.0 Fix Pack 85");
	}

