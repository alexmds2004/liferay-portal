definition {

	property testray.main.component.name = "Support QA";
	property type = "customer.portal";

	setUp {
		LocalFile.Passwords.getPasswords();
	}

	tearDown {
		LocalFile.ZendeskUserAPI._getDefaultUserId(organizationName = "Dwnzen - ${staticProjectName}");

		LocalFile.OSBAdminProject.tearDownProjects(table = '''| DWNZENDWNZEN |''');

		LocalFile.KoroneikiAccountAPI._tearDownAccounts(table = '''| Dwnzen - ${staticProjectName} |''');

		LocalFile.KoroneikiAccountAPI._tearDownAccountsViaAccountFieldNameAndValue(
			fieldName = "Code",
			table = '''| DWNZENDWNZEN |''');

		LocalFile.JSONUser.tearDownUsers(table = '''| dwn.customer1@lrcustomer.com.broken |
	| dwn.customer2@lrcustomer.com.broken |''');

		LocalFile.JSONUser.tearDownUsersViaSupport(table = '''| dwn.customer1@lrcustomer.com.broken |
	| dwn.customer2@lrcustomer.com.broken |''');

		LocalFile.JSONUser.tearDownUsersViaKoroneiki(table = '''| dwn.customer1@lrcustomer.com.broken |
	| dwn.customer2@lrcustomer.com.broken |''');

		LocalFile.KoroneikiContactAPI._tearDownContacts(table = '''| dwn.customer1@lrcustomer.com.broken |
	| dwn.customer2@lrcustomer.com.broken |''');

		LocalFile.JSONOkta.tearDownUsers(table = '''| dwn.customer1@lrcustomer.com.broken |
	| dwn.customer2@lrcustomer.com.broken |''');

		LocalFile.ZendeskUserAPI._getMultipleUserIdsByEmailAddress(table = '''| dwn.customer1@lrcustomer.com.broken |
	| dwn.customer2@lrcustomer.com.broken |''');

		LocalFile.ZendeskUserAPI._tearDownUsersByIdList(userIds = ${staticUserIdList});

		LocalFile.ZendeskOrganizationAPI._getMultipleOrganizationExternalIdsByOrganizationNameIfStillPresent(table = '''| Dwnzen - ${staticProjectName} |''');

		LocalFile.ZendeskOrganizationAPI._tearDownOrganizationsByExternalIdList(organizationExternalIds = ${staticOrganizationExternalIdList});

		LocalFile.ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId});
	}

	test AttempttoviewdownloadsasLXCBusinessPlancustomers {
		LocalFile.OSBAdminRabbitMQ.generateProvisioningProjectName();

		LocalFile.JSONOkta.createOktaUser(table = '''| Screen Name   | dwn.customer1                       |
	| Email Address | dwn.customer1@lrcustomer.com.broken |
	| First Name    | DWN                                 |
	| Last Name     | Customer1                           |''');

		LocalFile.JSONOkta.createOktaUser(table = '''| Screen Name   | dwn.customer2                       |
	| Email Address | dwn.customer2@lrcustomer.com.broken |
	| First Name    | DWN                                 |
	| Last Name     | Customer2                           |''');

		LocalFile.KoroneikiAccountAPI._createAccount(table = '''| Code   | DWNZENDWNZEN                  | |
	| Name   | Dwnzen - ${staticProjectName} | |
	| Region | United States                 | |
	| Status | Active                        | |
	| Tier   | T1                            | |''');

		LocalFile.KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Dwnzen - ${staticProjectName}",
			contactEmailAddress = "dwn.customer1@lrcustomer.com.broken",
			table = '''| Support Requester |''');

		LocalFile.KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Dwnzen - ${staticProjectName}",
			contactEmailAddress = "dwn.customer2@lrcustomer.com.broken",
			table = '''| Support User |''');

		LocalFile.KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		LocalFile.KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Dwnzen - ${staticProjectName}",
			productName = "LXC - Business Plan",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		LocalFile.KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Dwnzen - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		LocalFile.KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		LocalFile.KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		LocalFile.JSONUser.viewSupportUserSync(userEmailAddress = "dwn.customer1@lrcustomer.com.broken");

		LocalFile.JSONUser.viewSupportUserSync(userEmailAddress = "dwn.customer2@lrcustomer.com.broken");

		LocalFile.JSONUser.updateSupportPassword(
			userEmailAddress = "dwn.customer1@lrcustomer.com.broken",
			userPassword = ${staticSupportUserTestPassword});

		LocalFile.JSONUser.updateSupportPassword(
			userEmailAddress = "dwn.customer2@lrcustomer.com.broken",
			userPassword = ${staticSupportUserTestPassword});

		LocalFile.JSONUser.assignUserToSupportGroup(
			groupName = "Help Center",
			userEmailAddress = "dwn.customer1@lrcustomer.com.broken");

		LocalFile.JSONUser.assignUserToSupportGroup(
			groupName = "Help Center",
			userEmailAddress = "dwn.customer2@lrcustomer.com.broken");

		LocalFile.OSBAdmin.logoutAndLoginToSupport(
			userEmailAddress = "dwn.customer1@lrcustomer.com.broken",
			userPassword = ${staticSupportUserTestPassword});

		LocalFile.Downloads.viewNoDownloadsPage();
	}

