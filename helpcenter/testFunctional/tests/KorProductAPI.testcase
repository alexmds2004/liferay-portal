definition {

	property testray.main.component.name = "Support QA";
	property type = "koroneiki";

	tearDown {
		LocalFile.KoroneikiProductAPI._tearDownProducts(table = '''| Liferay Digital Experience Platform |
	| Liferay Portal Six                  |
	| Liferay Version 7                   |
	| Liferay Version 6                   |''');
	}

	test Createandviewmultipleproducts {
		LocalFile.KoroneikiProductAPI._createProduct(table = '''| Name | Liferay Digital Experience Platform | |''');

		LocalFile.KoroneikiProductAPI._createProduct(table = '''| Name | Liferay Portal Six | |''');

		LocalFile.KoroneikiProductAPI._viewProduct(
			productName = "Liferay Digital Experience Platform",
			table = '''| Name | Liferay Digital Experience Platform | |''');

		LocalFile.KoroneikiProductAPI._viewProduct(
			productName = "Liferay Portal Six",
			table = '''| Name | Liferay Portal Six | |''');
	}

	test Createandviewproduct {
		LocalFile.KoroneikiProductAPI._createProduct(table = '''| Name | Liferay Digital Experience Platform | |''');

		LocalFile.KoroneikiProductAPI._viewProduct(
			productName = "Liferay Digital Experience Platform",
			table = '''| Name | Liferay Digital Experience Platform | |''');
	}

	test Createandviewproductexternallink {
		LocalFile.KoroneikiProductAPI._createProduct(table = '''| Name | Liferay Digital Experience Platform | |''');

		LocalFile.KoroneikiProductAPI._createProductExternalLink(
			productName = "Liferay Digital Experience Platform",
			table = '''| Domain      | liferaydxp |
	| Entity Id   | 1234       |
	| Entity Name | LiferayDXP |''');

		LocalFile.KoroneikiProductAPI._viewProduct(
			productName = "Liferay Digital Experience Platform",
			table = '''| External Link Nested Field | liferaydxp                               | |
	| Name                       | Liferay Digital Experience Platform      | |''');

		LocalFile.KoroneikiProductAPI._viewProductExternalLink(
			entityId = 1234,
			productName = "Liferay Digital Experience Platform",
			table = '''| Domain      | liferaydxp |
	| Entity Id   | 1234       |
	| Entity Name | LiferayDXP |''');

		LocalFile.KoroneikiProductAPI._viewProductExternalLinkViaExternalLinkKey(
			entityId = 1234,
			productName = "Liferay Digital Experience Platform",
			table = '''| Domain      | liferaydxp |
	| Entity Id   | 1234       |
	| Entity Name | LiferayDXP |''');

		LocalFile.KoroneikiProductAPI._viewProductViaExternalLink(
			domain = "liferaydxp",
			entityId = 1234,
			entityName = "LiferayDXP",
			productName = "Liferay Digital Experience Platform");
	}

	test Createandviewproductwithproperties {
		LocalFile.KoroneikiProductAPI._createProduct(table = '''| Name                    | Liferay Digital Experience Platform |                |
	| Product Field and Value | additionalProp1                     | propertyValue1 |
	| Product Field and Value | additionalProp2                     | propertyValue2 |
	| Product Field and Value | additionalProp3                     | propertyValue3 |''');

		LocalFile.KoroneikiProductAPI._viewProduct(
			productName = "Liferay Digital Experience Platform",
			table = '''| Name                    | Liferay Digital Experience Platform |                |
	| Product Field and Value | additionalProp1                     | propertyValue1 |
	| Product Field and Value | additionalProp2                     | propertyValue2 |
	| Product Field and Value | additionalProp3                     | propertyValue3 |''');
	}

	test Removemultipleproductsandview {
		LocalFile.KoroneikiProductAPI._createProduct(table = '''| Name | Liferay Digital Experience Platform | |''');

		LocalFile.KoroneikiProductAPI._createProduct(table = '''| Name | Liferay Portal Six | |''');

		LocalFile.KoroneikiProductAPI._deleteProduct(productName = "Liferay Digital Experience Platform");

		LocalFile.KoroneikiProductAPI._deleteProduct(productName = "Liferay Portal Six");

		LocalFile.KoroneikiProductAPI._viewNoProduct(productName = "Liferay Digital Experience Platform");

		LocalFile.KoroneikiProductAPI._viewNoProduct(productName = "Liferay Portal Six");
	}

	test Removeproductandview {
		LocalFile.KoroneikiProductAPI._createProduct(table = '''| Name | Liferay Digital Experience Platform | |''');

		LocalFile.KoroneikiProductAPI._deleteProduct(productName = "Liferay Digital Experience Platform");

		LocalFile.KoroneikiProductAPI._viewNoProduct(productName = "Liferay Digital Experience Platform");
	}

	test Removeproductexternallinkandview {
		LocalFile.KoroneikiProductAPI._createProduct(table = '''| Name | Liferay Digital Experience Platform | |''');

		LocalFile.KoroneikiProductAPI._createProductExternalLink(
			productName = "Liferay Digital Experience Platform",
			table = '''| Domain      | liferaydxp |
	| Entity Id   | 1234       |
	| Entity Name | LiferayDXP |''');

		LocalFile.KoroneikiProductAPI._deleteProductExternalLink(
			entityId = 1234,
			productName = "Liferay Digital Experience Platform");

		LocalFile.KoroneikiProductAPI._viewNoProductExternalLink(
			entityId = 1234,
			productName = "Liferay Digital Experience Platform");
	}

	test Removeproductwithpropertiesandview {
		LocalFile.KoroneikiProductAPI._createProduct(table = '''| Name                    | Liferay Digital Experience Platform |                |
	| Product Field and Value | additionalProp1                     | propertyValue1 |
	| Product Field and Value | additionalProp2                     | propertyValue2 |
	| Product Field and Value | additionalProp3                     | propertyValue3 |''');

		LocalFile.KoroneikiProductAPI._deleteProduct(productName = "Liferay Digital Experience Platform");

		LocalFile.KoroneikiProductAPI._viewNoProduct(productName = "Liferay Digital Experience Platform");
	}

	test Updateandviewmultipleproducts {
		LocalFile.KoroneikiProductAPI._createProduct(table = '''| Name | Liferay Digital Experience Platform | |''');

		LocalFile.KoroneikiProductAPI._createProduct(table = '''| Name | Liferay Portal Six | |''');

		LocalFile.KoroneikiProductAPI.updateProduct(
			productName = "Liferay Digital Experience Platform",
			table = '''| Name | Liferay Version 7 | |''');

		LocalFile.KoroneikiProductAPI.updateProduct(
			productName = "Liferay Portal Six",
			table = '''| Name | Liferay Version 6 | |''');

		LocalFile.KoroneikiProductAPI._viewProduct(
			productName = "Liferay Version 7",
			table = '''| Name | Liferay Version 7 | |''');

		LocalFile.KoroneikiProductAPI._viewProduct(
			productName = "Liferay Version 6",
			table = '''| Name | Liferay Version 6 | |''');

		LocalFile.KoroneikiProductAPI._viewNoProduct(productName = "Liferay Digital Experience Platform");

		LocalFile.KoroneikiProductAPI._viewNoProduct(productName = "Liferay Portal Six");
	}

	test Updateandviewproduct {
		LocalFile.KoroneikiProductAPI._createProduct(table = '''| Name | Liferay Digital Experience Platform | |''');

		LocalFile.KoroneikiProductAPI.updateProduct(
			productName = "Liferay Digital Experience Platform",
			table = '''| Name | Liferay Portal Six | |''');

		LocalFile.KoroneikiProductAPI._viewProduct(
			productName = "Liferay Portal Six",
			table = '''| Name | Liferay Portal Six | |''');

		LocalFile.KoroneikiProductAPI._viewNoProduct(productName = "Liferay Digital Experience Platform");
	}

	test Updateandviewproductwithproperties {
		LocalFile.KoroneikiProductAPI._createProduct(table = '''| Name                    | Liferay Digital Experience Platform |                |
	| Product Field and Value | additionalProp1                     | propertyValue1 |
	| Product Field and Value | additionalProp2                     | propertyValue2 |
	| Product Field and Value | additionalProp3                     | propertyValue3 |''');

		LocalFile.KoroneikiProductAPI.updateProduct(
			productName = "Liferay Digital Experience Platform",
			table = '''| Name                    | Liferay Portal Six |                |
	| Product Field and Value | additionalProp4    | propertyValue4 |
	| Product Field and Value | additionalProp5    | propertyValue5 |
	| Product Field and Value | additionalProp6    | propertyValue6 |''');

		LocalFile.KoroneikiProductAPI._viewProduct(
			productName = "Liferay Portal Six",
			table = '''| Name                    | Liferay Portal Six  |                |
	| Product Field and Value | additionalProp4     | propertyValue4 |
	| Product Field and Value | additionalProp5     | propertyValue5 |
	| Product Field and Value | additionalProp6     | propertyValue6 |''');

		LocalFile.KoroneikiProductAPI._viewNoProduct(productName = "Liferay Digital Experience Platform");
	}

}