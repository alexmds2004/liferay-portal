definition {

	property testray.main.component.name = "Support QA";
	property type = "provisioning.security";

	setUp {
		LocalFile.Passwords.getPasswords();

		LocalFile.JSONUser.createViaProvisioning(table = '''| Screen Name   | licensing.watcher                    |
	| Email Address | licensing.watcher@liferay.com.broken |
	| First Name    | Licensing                            |
	| Last Name     | Watcher                              |''');

		LocalFile.JSONUser.assignUserToProvisioningRole(
			roleName = "Provisioning Watcher",
			userEmailAddress = "licensing.watcher@liferay.com.broken");
	}

	tearDown {
		LocalFile.ZendeskUserAPI._getDefaultUserId(organizationName = "Perlic - ${staticProjectName}");

		LocalFile.KoroneikiProductConsumptionAPI._tearDownProductConsumptionList(
			accountName = "Perlic - ${staticProjectName}",
			table = '''| DXP Production |''');

		LocalFile.OSBAdminProject.tearDownProjects(table = '''| PERLICPERLIC |''');

		LocalFile.KoroneikiAccountAPI._tearDownAccounts(table = '''| Perlic - ${staticProjectName} |''');

		LocalFile.KoroneikiAccountAPI._tearDownAccountsViaAccountFieldNameAndValue(
			fieldName = "Code",
			table = '''| PERLICPERLIC |''');

		LocalFile.ZendeskOrganizationAPI._getMultipleOrganizationExternalIdsByOrganizationNameIfStillPresent(table = '''| Perlic - ${staticProjectName} |''');

		LocalFile.ZendeskOrganizationAPI._tearDownOrganizationsByExternalIdList(organizationExternalIds = ${staticOrganizationExternalIdList});

		LocalFile.ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId});

		LocalFile.JSONUser.tearDownUsersViaProvisioning(table = '''| licensing.watcher@liferay.com.broken |''');

		LocalFile.Downloads.teardownDownloadedListedFiles(list = ${staticDownloadedListName});
	}

	test DownloadDXPlicense {
		LocalFile.OSBAdminRabbitMQ.generateProvisioningProjectName();

		LocalFile.KoroneikiAccountAPI._createAccount(table = '''| Code                  | PERLICPERLIC                         | |
	| Contact Email Address | lic.koroneiki1@lrcustomer.com.broken | |
	| Description           | Test osb account on koroneiki        | |
	| Fax Number            | 555-555-1234                         | |
	| Name                  | Perlic - ${staticProjectName}        | |
	| Phone Number          | 555-555-5678                         | |
	| Profile Email Address | lic.koroneiki1@lrcustomer.com.broken | |
	| Region                | United States                        | |
	| Status                | Active                               | |
	| Tier                  | T4                                   | |
	| Website               | www.koroneikicorporation.com         | |''');

		LocalFile.KoroneikiAccountAPI._generateAccountKey(accountName = "Perlic - ${staticProjectName}");

		LocalFile.KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		LocalFile.KoroneikiProductPurchaseAPI.generateStaticFullStartAndEndDate();

		LocalFile.KoroneikiProductPurchaseAPI.generateStaticFutureStartAndEndDate();

		LocalFile.KoroneikiProductPurchaseAPI.generateStaticFullFutureStartAndEndDate();

		LocalFile.KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Perlic - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| End Date                | ${staticEndDate}         |   |
	| Original End Date       | ${staticOriginalEndDate} |   |
	| Perpetual               | false                    |   |
	| Product Field and Value | sizing                   | 1 |
	| Product Field and Value | licenses                 | 1 |
	| Product Field and Value | version                  | 7 |
	| Quantity                | 1                        |   |
	| Start Date              | ${staticStartDate}       |   |
	| Status                  | Approved                 |   |''');

		LocalFile.KoroneikiProductPurchaseAPI._generateProductPurchaseId(
			accountName = "Perlic - ${staticProjectName}",
			productName = "DXP Production");

		LocalFile.KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Perlic - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		LocalFile.OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		LocalFile.Provisioning.gotoLicenses();

		LocalFile.Provisioning.clickGenerateLicenseButton();

		LocalFile.ProvisioningLicense.populateGenerateLicenseForm(table = '''| Account | Select Entity | Perlic - ${staticProjectName} | |
	| Product | Select        | DXP Production                | |
	| Version | Select        | 7.2                           | |
	| Type    | Select        | DXP Production                | |''');

		LocalFile.ProvisioningLicense.clickChooseProductPurchaseButton(positionValue = 1);

		LocalFile.ProvisioningLicense.populateGenerateLicenseForm(table = '''| Host Name     | Input    | localhost         | |
	| IP Addresses  | Textarea | 123.45.67.89      | |
	| MAC Addresses | Textarea | 0A-1B-2C-3D-4E-5F | |''');

		LocalFile.ProvisioningLicense.clickGenerateLicenseButton();

		LocalFile.ProvisioningLicense.viewLicense(table = '''| Header  | Perlic - ${staticProjectName} | |
	| Product | DXP Production                | |''');

		LocalFile.OSBAdmin.logoutAndLoginToProvisioning(
			userEmailAddress = "licensing.watcher@liferay.com.broken",
			userPassword = ${staticProvisioningQaUserPassword});

		LocalFile.UserAccount.updatePasswordUponLogin(userPassword = "test");

		LocalFile.Provisioning.gotoLicenses();

		LocalFile.Provisioning.searchLicenses(keyword = ${staticAccountKey});

		LocalFile.Provisioning.clickLicense(licenseKeyword = "Perlic - ${staticProjectName}");

		LocalFile.ProvisioningLicense.downloadLicense(positionValue = 1);

		LocalFile.ProvisioningLicense.assertDownloadedLicensePresent(
			fileType = "xml",
			table = '''| License Type | activation-key                |
	| Product      | DXP Production                |
	| Version      | 7.2                           |
	| License Name | Perlic - ${staticProjectName} |''');
	}

	test DownloadDXPsinglelicenseaggregate {
		LocalFile.OSBAdminRabbitMQ.generateProvisioningProjectName();

		LocalFile.KoroneikiAccountAPI._createAccount(table = '''| Code                  | PERLICPERLIC                         | |
	| Contact Email Address | lic.koroneiki1@lrcustomer.com.broken | |
	| Description           | Test osb account on koroneiki        | |
	| Fax Number            | 555-555-1234                         | |
	| Name                  | Perlic - ${staticProjectName}        | |
	| Phone Number          | 555-555-5678                         | |
	| Profile Email Address | lic.koroneiki1@lrcustomer.com.broken | |
	| Region                | United States                        | |
	| Status                | Active                               | |
	| Tier                  | T4                                   | |
	| Website               | www.koroneikicorporation.com         | |''');

		LocalFile.KoroneikiAccountAPI._generateAccountKey(accountName = "Perlic - ${staticProjectName}");

		LocalFile.KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		LocalFile.KoroneikiProductPurchaseAPI.generateStaticFullStartAndEndDate();

		LocalFile.KoroneikiProductPurchaseAPI.generateStaticFutureStartAndEndDate();

		LocalFile.KoroneikiProductPurchaseAPI.generateStaticFullFutureStartAndEndDate();

		LocalFile.KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Perlic - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| End Date                | ${staticEndDate}         |   |
	| Original End Date       | ${staticOriginalEndDate} |   |
	| Perpetual               | false                    |   |
	| Product Field and Value | sizing                   | 1 |
	| Product Field and Value | licenses                 | 1 |
	| Product Field and Value | version                  | 7 |
	| Quantity                | 1                        |   |
	| Start Date              | ${staticStartDate}       |   |
	| Status                  | Approved                 |   |''');

		LocalFile.KoroneikiProductPurchaseAPI._generateProductPurchaseId(
			accountName = "Perlic - ${staticProjectName}",
			productName = "DXP Production");

		LocalFile.KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Perlic - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		LocalFile.OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		LocalFile.Provisioning.gotoLicenses();

		LocalFile.Provisioning.clickGenerateLicenseButton();

		LocalFile.ProvisioningLicense.populateGenerateLicenseForm(table = '''| Account | Select Entity | Perlic - ${staticProjectName} | |
	| Product | Select        | DXP Production                | |
	| Version | Select        | 7.2                           | |
	| Type    | Select        | DXP Production                | |''');

		LocalFile.ProvisioningLicense.clickChooseProductPurchaseButton(positionValue = 1);

		LocalFile.ProvisioningLicense.populateGenerateLicenseForm(table = '''| Host Name     | Input    | localhost         | |
	| IP Addresses  | Textarea | 123.45.67.89      | |
	| MAC Addresses | Textarea | 0A-1B-2C-3D-4E-5F | |''');

		LocalFile.ProvisioningLicense.clickGenerateLicenseButton();

		LocalFile.ProvisioningLicense.viewLicense(table = '''| Header  | Perlic - ${staticProjectName} | |
	| Product | DXP Production                | |''');

		LocalFile.ProvisioningLicense.getLicenseKeyIdViaLicenseDetails();

		LocalFile.OSBAdmin.logoutAndLoginToProvisioning(
			userEmailAddress = "licensing.watcher@liferay.com.broken",
			userPassword = ${staticProvisioningQaUserPassword});

		LocalFile.UserAccount.updatePasswordUponLogin(userPassword = "test");

		LocalFile.Provisioning.gotoAccounts();

		LocalFile.Provisioning.searchAccounts(keyword = "Perlic");

		LocalFile.Provisioning.clickAccount(accountName = "Perlic - ${staticProjectName}");

		LocalFile.Provisioning.clickTab(tabName = "Licenses");

		LocalFile.ProvisioningAccount.selectLicensesViaLicensesTab(table = '''| Perlic - ${staticProjectName} |''');

		LocalFile.ProvisioningAccount.clickLicensesActionDropdownButton(action = "Download");

		LocalFile.ProvisioningLicense.downloadLicenseViaDownloadLicensePage(table = '''| ${staticLicenseKeyId} |''');

		LocalFile.ProvisioningLicense.assertDownloadedLicensePresent(
			fileType = "xml",
			table = '''| License Type | activation-key                |
	| Product      | DXP Production                |
	| Version      | 7.2                           |
	| License Name | Perlic - ${staticProjectName} |''');
	}

	test DownloadnewDXPaggregatelicense {
		LocalFile.OSBAdminRabbitMQ.generateProvisioningProjectName();

		LocalFile.KoroneikiAccountAPI._createAccount(table = '''| Code                  | PERLICPERLIC                         | |
	| Contact Email Address | lic.koroneiki1@lrcustomer.com.broken | |
	| Description           | Test osb account on koroneiki        | |
	| Fax Number            | 555-555-1234                         | |
	| Name                  | Perlic - ${staticProjectName}        | |	
	| Phone Number          | 555-555-5678                         | |
	| Profile Email Address | lic.koroneiki1@lrcustomer.com.broken | |
	| Region                | United States                        | |
	| Status                | Active                               | |
	| Tier                  | T4                                   | |
	| Website               | www.koroneikicorporation.com         | |''');

		LocalFile.KoroneikiAccountAPI._generateAccountKey(accountName = "Perlic - ${staticProjectName}");

		LocalFile.KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		LocalFile.KoroneikiProductPurchaseAPI.generateStaticFullStartAndEndDate();

		LocalFile.KoroneikiProductPurchaseAPI.generateStaticFutureStartAndEndDate();

		LocalFile.KoroneikiProductPurchaseAPI.generateStaticFullFutureStartAndEndDate();

		LocalFile.KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Perlic - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| End Date                | ${staticEndDate}         |   |
	| Original End Date       | ${staticOriginalEndDate} |   |
	| Perpetual               | false                    |   |
	| Product Field and Value | sizing                   | 2 |
	| Product Field and Value | licenses                 | 2 |
	| Product Field and Value | version                  | 7 |
	| Quantity                | 2                        |   |
	| Start Date              | ${staticStartDate}       |   |
	| Status                  | Approved                 |   |''');

		LocalFile.KoroneikiProductPurchaseAPI._generateProductPurchaseId(
			accountName = "Perlic - ${staticProjectName}",
			productName = "DXP Production");

		LocalFile.KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Perlic - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		LocalFile.OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		LocalFile.Provisioning.gotoLicenses();

		LocalFile.Provisioning.clickGenerateLicenseButton();

		LocalFile.ProvisioningLicense.populateGenerateLicenseForm(table = '''| Account | Select Entity | Perlic - ${staticProjectName} | |
	| Product | Select        | DXP Production                | |
	| Version | Select        | 7.2                           | |
	| Type    | Select        | DXP Production                | |''');

		LocalFile.ProvisioningLicense.clickChooseProductPurchaseButton(positionValue = 1);

		LocalFile.ProvisioningLicense.populateGenerateLicenseForm(table = '''| Name          | Input    | Perlic - ${staticProjectName} License1 Name        | |
	| Description   | Input    | Perlic - ${staticProjectName} License1 Description | |
	| Host Name     | Input    | localhost                                          | |
	| IP Addresses  | Textarea | 123.45.67.89                                       | |
	| MAC Addresses | Textarea | 0A-1B-2C-3D-4E-5F                                  | |''');

		LocalFile.ProvisioningLicense.clickGenerateLicenseButton();

		LocalFile.ProvisioningLicense.viewLicense(table = '''| Header  | Perlic - ${staticProjectName} | |
	| Product | DXP Production                | |''');

		LocalFile.ProvisioningLicense.getLicenseKeyIdViaLicenseDetails();

		LocalFile.ProvisioningLicense._renameFirstLicenseKeyIdVariable();

		LocalFile.Provisioning.gotoLicenses();

		LocalFile.Provisioning.searchLicenses(keyword = ${staticAccountKey});

		LocalFile.Provisioning.clickGenerateLicenseButton();

		LocalFile.ProvisioningLicense.populateGenerateLicenseForm(table = '''| Account | Select Entity | Perlic - ${staticProjectName} | |
	| Product | Select        | DXP Production                | |
	| Version | Select        | 7.2                           | |
	| Type    | Select        | DXP Production                | |''');

		LocalFile.ProvisioningLicense.clickChooseProductPurchaseButton(positionValue = 1);

		LocalFile.ProvisioningLicense.populateGenerateLicenseForm(table = '''| Name          | Input    | Perlic - ${staticProjectName} License2 Name        | |
	| Description   | Input    | Perlic - ${staticProjectName} License2 Description | |
	| Host Name     | Input    | localhost                                          | |
	| IP Addresses  | Textarea | 123.45.67.89                                       | |
	| MAC Addresses | Textarea | 0A-1B-2C-3D-4E-5F                                  | |''');

		LocalFile.ProvisioningLicense.clickGenerateLicenseButton();

		LocalFile.ProvisioningLicense.viewLicense(table = '''| Header  | Perlic - ${staticProjectName} | |
	| Product | DXP Production                | |''');

		LocalFile.ProvisioningLicense.getLicenseKeyIdViaLicenseDetails();

		LocalFile.ProvisioningLicense._renameSecondLicenseKeyIdVariable();

		LocalFile.OSBAdmin.logoutAndLoginToProvisioning(
			userEmailAddress = "licensing.watcher@liferay.com.broken",
			userPassword = ${staticProvisioningQaUserPassword});

		LocalFile.UserAccount.updatePasswordUponLogin(userPassword = "test");

		LocalFile.Provisioning.gotoAccounts();

		LocalFile.Provisioning.searchAccounts(keyword = "Perlic");

		LocalFile.Provisioning.clickAccount(accountName = "Perlic - ${staticProjectName}");

		LocalFile.Provisioning.clickTab(tabName = "Licenses");

		LocalFile.ProvisioningAccount.selectLicensesViaLicensesTab(table = '''| Perlic - ${staticProjectName} License1 Name |
	| Perlic - ${staticProjectName} License2 Name |''');

		LocalFile.ProvisioningAccount.clickLicensesActionDropdownButton(action = "Download");

		LocalFile.ProvisioningLicense.downloadLicenseViaDownloadLicensePage(table = '''| ${staticLicenseKeyId2} |
	| ${staticLicenseKeyId1} |''');

		LocalFile.ProvisioningLicense.assertDownloadedLicensePresent(
			fileType = "xml",
			table = '''| License Type | activation-key                              |
	| Product      | DXP Production                              |
	| Version      | 7.2                                         |
	| License Name | Perlic - ${staticProjectName} License2 Name |''');
	}

	test GeneratenewDXPaggregatelicense {
		LocalFile.OSBAdminRabbitMQ.generateProvisioningProjectName();

		LocalFile.KoroneikiAccountAPI._createAccount(table = '''| Code                  | PERLICPERLIC                         | |
	| Contact Email Address | lic.koroneiki1@lrcustomer.com.broken | |
	| Description           | Test osb account on koroneiki        | |
	| Fax Number            | 555-555-1234                         | |
	| Name                  | Perlic - ${staticProjectName}        | |
	| Phone Number          | 555-555-5678                         | |
	| Profile Email Address | lic.koroneiki1@lrcustomer.com.broken | |
	| Region                | United States                        | |
	| Status                | Active                               | |
	| Tier                  | T4                                   | |
	| Website               | www.koroneikicorporation.com         | |''');

		LocalFile.KoroneikiAccountAPI._generateAccountKey(accountName = "Perlic - ${staticProjectName}");

		LocalFile.KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

