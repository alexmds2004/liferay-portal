		LocalFile.Provisioning.clickTab(tabName = "Licenses");

		LocalFile.ProvisioningAccount.selectLicensesViaLicensesTab(table = '''| Perlic - ${staticProjectName} License1 Name |
	| Perlic - ${staticProjectName} License2 Name |''');

