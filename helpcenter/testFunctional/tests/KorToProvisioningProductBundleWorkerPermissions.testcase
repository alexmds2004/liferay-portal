definition {

	property testray.main.component.name = "Support QA";
	property type = "provisioning.security";

	setUp {
		LocalFile.Passwords.getPasswords();

		LocalFile.JSONUser.createViaProvisioning(table = '''| Screen Name   | provisioning.worker                    |
	| Email Address | provisioning.worker@liferay.com.broken |
	| First Name    | Provisioning                           |
	| Last Name     | Worker                                 |''');

		LocalFile.JSONUser.assignUserToProvisioningRole(
			roleName = "Provisioning Worker",
			userEmailAddress = "provisioning.worker@liferay.com.broken");
	}

	tearDown {
		LocalFile.OSBAdmin.logoutAndLoginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		LocalFile.Provisioning.gotoProductBundles();

		LocalFile.Provisioning.tearDownProductBundles(table = '''| Visible Products |''');

		LocalFile.KoroneikiProductAPI._tearDownProducts(table = '''| A Visible Product        |
	| A Visible Second Product |''');

		LocalFile.JSONUser.tearDownUsersViaProvisioning(table = '''| provisioning.worker@liferay.com.broken |''');
	}

	test Viewnonewproductbundlebutton {
		LocalFile.OSBAdmin.loginToProvisioning(
			userEmailAddress = "provisioning.worker@liferay.com.broken",
			userPassword = ${staticProvisioningQaUserPassword});

		LocalFile.UserAccount.updatePasswordUponLogin(userPassword = "test");

		LocalFile.Provisioning.gotoProductBundles();

		LocalFile.Provisioning.viewNoNewProductBundleButton();
	}

	test Viewproductbundle {
		LocalFile.KoroneikiProductAPI._createProduct(table = '''| Name | A Visible Product | |''');

		LocalFile.KoroneikiProductAPI._createProduct(table = '''| Name | A Visible Second Product | |''');

		LocalFile.OSBAdmin.logoutAndLoginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		LocalFile.Provisioning.gotoProductBundles();

		LocalFile.Provisioning.clickNewProductBundleButton();

		LocalFile.ProvisioningProductBundle.populateProductBundleFormAndSave(table = '''| Name        | Input | Visible Products         |
	| Add Product |       | A Visible Product        |
	| Add Product |       | A Visible Second Product |''');

		LocalFile.OSBAdmin.logoutAndLoginToProvisioning(
			userEmailAddress = "provisioning.worker@liferay.com.broken",
			userPassword = ${staticProvisioningQaUserPassword});

		LocalFile.UserAccount.updatePasswordUponLogin(userPassword = "test");

		LocalFile.Provisioning.gotoProductBundles();

		LocalFile.Provisioning._viewProductBundleNonLinkViaIndex(
			productBundleName = "Visible Products",
			table = '''| Name | Visible Products |''');

		LocalFile.Provisioning.viewNoProductBundleDeleteButton(productBundleName = "Visible Products");
	}

}