			table = '''| Delete | true |''');

		KoroneikiContactRoleAPI._unsetContactRolePermissions(
			contactRoleName = "Default Account Customer Role",
			table = '''| Delete | true |''');

		KoroneikiContactRoleAPIPermissionCheck._deleteContactRoleAttempt(contactRoleName = "Default Account Customer Role");

		KoroneikiContactRoleAPI._viewContactRole(
			contactRoleName = "Default Account Customer Role",
			table = '''| Description | This is the default customer role for accounts |
	| Name        | Default Account Customer Role                  |
	| Type        | Account Customer                               |''');

		KoroneikiContactRoleAPIPermissionCheck._viewNoContactRole(contactRoleName = "Default Account Customer Role");
	}

