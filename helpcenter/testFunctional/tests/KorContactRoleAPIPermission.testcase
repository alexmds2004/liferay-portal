definition {

	property testray.main.component.name = "Support QA";
	property type = "koroneiki";

	tearDown {
		KoroneikiContactRoleAPI._tearDownContactRolePermissions(contactRoleName = "Default Account Customer Role");

		KoroneikiContactRoleAPI._tearDownContactRolePermissions(contactRoleName = "Optional Account Customer Role");

		KoroneikiContactRoleAPI._tearDownContactRoles(table = '''| Default Account Customer Role  |
	| Optional Account Customer Role |''');
	}

	test Createcontactroleattemptbynonpermissioneduser {
		KoroneikiContactRoleAPIPermissionCheck._createContactRoleAttempt(table = '''| Description | This is the default customer role for accounts |
	| Name        | Default Account Customer Role                  |
	| Type        | Account Customer                               |''');

		KoroneikiContactRoleAPI._viewNoContactRole(contactRoleName = "Default Account Customer Role");
	}

	test Deletecontactroleaspermissioneduser {
		KoroneikiContactRoleAPI._createContactRole(table = '''| Description | This is the default customer role for accounts |
	| Name        | Default Account Customer Role                  |
	| Type        | Account Customer                               |''');

		KoroneikiContactRoleAPI._setContactRolePermissions(
			contactRoleName = "Default Account Customer Role",
			table = '''| Delete | true |''');

		KoroneikiContactRoleAPIPermissionCheck._deleteContactRole(contactRoleName = "Default Account Customer Role");

		KoroneikiContactRoleAPI._viewNoContactRole(contactRoleName = "Default Account Customer Role");
	}

	test Deletecontactroleattemptbynewlynonpermissioneduser {
