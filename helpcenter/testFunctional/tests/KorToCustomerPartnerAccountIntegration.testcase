definition {

	property testray.main.component.name = "Support QA";
	property type = "customer.integration";

	setUp {
		LocalFile.Passwords.getPasswords();

		LocalFile.KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		LocalFile.KoroneikiProductPurchaseAPI.generateStaticPastStartAndEndDate();

		LocalFile.KoroneikiProductPurchaseAPI.generateStaticFutureStartAndEndDate();

		LocalFile.OSBAdminRabbitMQ.generateProvisioningCompanyName();

		LocalFile.OSBAdminRabbitMQ.generateProvisioningProjectName();

		LocalFile.JSONOkta.createOktaUser(table = '''| Screen Name   | cstm.partner1                      |
	| Email Address | cstm.partner1@lrpartner.com.broken |
	| First Name    | CSTM                               |
	| Last Name     | Partner1                           |''');

		LocalFile.JSONOkta.createOktaUser(table = '''| Screen Name   | cstm.partner2                      |
	| Email Address | cstm.partner2@lrpartner.com.broken |
	| First Name    | CSTM                               |
	| Last Name     | Partner2                           |''');

		LocalFile.KoroneikiAccountAPI._createAccount(table = '''| Code   | CSTPARCSTPAR                  | |
	| Name   | Cstpar - ${staticProjectName} | |
	| Region | United States                 | |
	| Status | Active                        | |
	| Tier   | T1                            | |''');

		LocalFile.KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Cstpar - ${staticProjectName}",
			productName = "Service Partnership",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		LocalFile.KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Cstpar - ${staticProjectName}",
			contactEmailAddress = "cstm.partner1@lrpartner.com.broken",
			table = '''| Partner Member |''');

		LocalFile.KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Cstpar - ${staticProjectName}",
			contactEmailAddress = "cstm.partner2@lrpartner.com.broken",
			table = '''| Partner Manager |''');

		LocalFile.KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Partner");

		LocalFile.KoroneikiAccountAPI._createAssignedTeamNestedField(
			accountName = "Osbzen - ${staticProjectName}",
			teamName = "Cstpar - ${staticProjectName}");
	}

	tearDown {
		LocalFile.ZendeskUserAPI._getDefaultUserId(organizationName = "Korcst - ${staticProjectName}");

		LocalFile.ZendeskUserAPI._renameFirstDefaultUserIdVariable();

		LocalFile.ZendeskUserAPI._getDefaultUserId(organizationName = "Cstpar - ${staticProjectName}");

		LocalFile.ZendeskUserAPI._renameSecondDefaultUserIdVariable();

		LocalFile.KoroneikiTeamAPI._tearDownTeams(table = '''| CSTM Partner1  |
	| CSTM Partner2  |''');

		LocalFile.OSBAdminProject.tearDownProjects(table = '''| CSTPARCSTPAR |
	| KORCSTKORCST |''');

		LocalFile.KoroneikiAccountAPI._tearDownAccounts(table = '''| Cstpar - ${staticProjectName} |''');

		LocalFile.KoroneikiAccountAPI._tearDownAccountsViaAccountFieldNameAndValue(
			fieldName = "Code",
			table = '''| CSTPARCSTPAR |
	| KORCSTKORCST |''');

		LocalFile.KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Gold Subscription");

		LocalFile.JSONUser.tearDownUsers(table = '''| cstm.partner1@lrpartner.com.broken   |
	| cstm.partner2@lrpartner.com.broken   |''');

		LocalFile.JSONUser.tearDownUsersViaSupport(table = '''| cstm.partner1@lrpartner.com.broken   |
	| cstm.partner2@lrpartner.com.broken   |''');

		LocalFile.JSONUser.tearDownUsersViaKoroneiki(table = '''| cstm.partner1@lrpartner.com.broken   |
	| cstm.partner2@lrpartner.com.broken   |''');

		LocalFile.KoroneikiContactAPI._tearDownContacts(table = '''| cstm.partner1@lrpartner.com.broken   |
	| cstm.partner2@lrpartner.com.broken   |''');

		LocalFile.JSONOkta.tearDownUsers(table = '''| cstm.partner1@lrpartner.com.broken   |
	| cstm.partner2@lrpartner.com.broken   |''');
	}

	test ViewpartnerfirstlinesupportandcustomeronCustomer {
		LocalFile.KoroneikiAccountAPI._createAccount(table = '''| Assigned Team Nested Field | ${staticAssignedTeamNestedField} | |
	| Code                       | KORCSTKORCST                     | |
	| Language                   | English                          | |
	| Name                       | Korcst - ${staticProjectName}    | |
	| Region                     | United States                    | |
	| Status                     | Active                           | |
	| Tier                       | T1                               | |''');

		LocalFile.KoroneikiAccountAPI._assignTeamRolesToTeam(
			accountName = "Korcst - ${staticProjectName}",
			table = '''| Partner |''',
			teamName = "Cstpar - ${staticProjectName}");

		LocalFile.KoroneikiAccountAPI._assignTeamRolesToTeam(
			accountName = "Korcst - ${staticProjectName}",
			table = '''| First Line Support |''',
			teamName = "Cstpar - ${staticProjectName}");

		LocalFile.KoroneikiAccountAPI._createAccountPostalAddress(
			accountName = "Korcst - ${staticProjectName}",
			table = '''| Country               | United States   |
	| Locality              | Diamond Bar     |
	| Region                | California      |
	| Type                  | Business        |
	| Mailing               | True            |
	| Postal Code           | 91765           |
	| Primary               | True            |
	| Street Address Line 1 | 123 Main Street |''');

		LocalFile.KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korcst - ${staticProjectName}",
			productName = "Portal Production",
			table = '''| End Date                | ${staticEndDate}         |   |
	| Original End Date       | ${staticOriginalEndDate} |   |
	| Perpetual               | false                    |   |
	| Product Field and Value | sizing                   | 1 |
	| Product Field and Value | licenses                 | 1 |
	| Product Field and Value | version                  | 6 |
	| Quantity                | 1                        |   |
	| Start Date              | ${staticStartDate}       |   |
	| Status                  | Approved                 |   |''');

		LocalFile.KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korcst - ${staticProjectName}",
			productName = "Gold Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		LocalFile.KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Gold Subscription");

		LocalFile.CustomerLogin.loginToCustomer(
			userEmailAddress = ${staticCustomerAdminEmailAddress},
			userPassword = ${staticCustomerAdminPassword});
	}

}