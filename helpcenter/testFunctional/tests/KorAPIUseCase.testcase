definition {

	property testray.main.component.name = "Support QA";
	property type = "koroneiki";

	tearDown {
		KoroneikiProductConsumptionAPI._tearDownProductConsumptions(
			accountName = "Koroneiki Automotive",
			table = '''| Liferay Digital Experience Platform |
	| Liferay Portal Six                  |
	| Liferay Version 7                   |
	| Liferay Version 6                   |''');

		KoroneikiProductConsumptionAPI._tearDownProductConsumptions(
			accountName = "Koroneiki Engineering",
			table = '''| Liferay Digital Experience Platform |
	| Liferay Portal Six                  |
	| Liferay Version 7                   |
	| Liferay Version 6                   |''');

		KoroneikiProductConsumptionAPI._tearDownProductConsumptions(
			accountName = "Koroneiki Auto Subsidiary",
			table = '''| Liferay Digital Experience Platform |
	| Liferay Portal Six                  |
	| Liferay Version 7                   |
	| Liferay Version 6                   |''');

		KoroneikiProductConsumptionAPI._tearDownProductConsumptions(
			accountName = "Koroneiki Engr Subsidiary",
			table = '''| Liferay Digital Experience Platform |
	| Liferay Portal Six                  |
	| Liferay Version 7                   |
	| Liferay Version 6                   |''');

		KoroneikiAccountAPI._tearDownAccounts(table = '''| Koroneiki Auto Subsidiary |
	| Koroneiki Engr Subsidiary |
	| Koroneiki Automotive      |
	| Koroneiki Engineering     |''');

		KoroneikiContactAPI._tearDownContacts(table = '''| koroneiki.contact1@lrcustomer.com.broken |
	| koroneiki.contact2@lrcustomer.com.broken |
	| koroneiki.contact3@lrcustomer.com.broken |
	| koroneiki.contact4@lrcustomer.com.broken |''');

		KoroneikiTeamRoleAPI._tearDownTeamRoles(table = '''| Default Account Role  |
	| Optional Account Role |''');

		KoroneikiContactRoleAPI._tearDownContactRoles(table = '''| Default Account Role  |
	| Default Team Role     |
	| Optional Account Role |
	| Optional Team Role    |''');

		KoroneikiTeamAPI._tearDownTeams(table = '''| Development Team |
	| Marketing Team   |
	| Engineering Team |
	| Sales Team       |''');

		KoroneikiProductAPI._tearDownProducts(table = '''| Liferay Digital Experience Platform |
	| Liferay Portal Six                  |
	| Liferay Version 7                   |
	| Liferay Version 6                   |''');
	}


	test Entitycreationusecase {
	property help.center.acceptance = "true";
