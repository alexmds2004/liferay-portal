definition {

	property testray.main.component.name = "Support QA";
	property type = "sites";

	setUp {
		LocalFile.Sites.getLinks();
	}

	@help.center.smoke = "true"
	test CustomerSite {
		LocalFile.Sites.viewSitePageLink(pageLink = ${customerURL});
	}

	@help.center.smoke = "true"
	test IssuesZenSite {
		LocalFile.Sites.viewSitePageLink(pageLink = ${issuesZenURL});
	}

	@help.center.smoke = "true"
	test KoroneikiSite {
		LocalFile.Sites.viewSitePageLink(pageLink = ${koroneikiURL});
	}

	@help.center.smoke = "true"
	test OktaSite {
		LocalFile.Sites.viewSitePageLink(pageLink = ${oktaURL});
	}

	@help.center.smoke = "true"
	test ProvisioningSite {
		LocalFile.Sites.viewSitePageLink(pageLink = ${provisioningURL});
	}

	@help.center.smoke = "true"
	test RabbitMQSite {
		LocalFile.Sites.viewSitePageLink(pageLink = ${rabbitmqURL});
	}

	@help.center.smoke = "true"
	test ZendeskSite {
		LocalFile.Sites.viewSitePageLink(pageLink = ${zendeskURL});
	}

}