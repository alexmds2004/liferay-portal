	test ViewadvancedsearchresultsforDXPlicenseviaenterkey {
		OSBAdminRabbitMQ.generateProvisioningProjectName();

		KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORLICKORLIC                         | |
	| Contact Email Address | lic.koroneiki1@lrcustomer.com.broken | |
	| Description           | Test osb account on koroneiki        | |
	| Fax Number            | 555-555-1234                         | |
	| Name                  | Korlic - ${staticProjectName}        | |
	| Phone Number          | 555-555-5678                         | |
	| Profile Email Address | lic.koroneiki1@lrcustomer.com.broken | |
	| Region                | United States                        | |
	| Status                | Active                               | |
	| Tier                  | T4                                   | |
	| Website               | www.koroneikicorporation.com         | |''');

		KoroneikiAccountAPI._generateAccountKey(accountName = "Korlic - ${staticProjectName}");

		KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		KoroneikiProductPurchaseAPI.generateStaticFullStartAndEndDate();

		KoroneikiProductPurchaseAPI.generateStaticFutureStartAndEndDate();

		KoroneikiProductPurchaseAPI.generateStaticFullFutureStartAndEndDate();

		KoroneikiProductPurchaseAPI.generateStaticYyyyMmDdPastStartAndEndDate();

		KoroneikiProductPurchaseAPI.generateStaticYyyyMmDdFutureStartAndEndDate();

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korlic - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| End Date                | ${staticEndDate}         |   |
	| Original End Date       | ${staticOriginalEndDate} |   |
	| Perpetual               | false                    |   |
	| Product Field and Value | sizing                   | 1 |
	| Product Field and Value | licenses                 | 1 |
	| Product Field and Value | version                  | 7 |
	| Quantity                | 1                        |   |
	| Start Date              | ${staticStartDate}       |   |
	| Status                  | Approved                 |   |''');

		KoroneikiProductPurchaseAPI._generateProductPurchaseId(
			accountName = "Korlic - ${staticProjectName}",
			productName = "DXP Production");

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korlic - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		Provisioning.gotoLicenses();

		Provisioning.clickGenerateLicenseButton();

		ProvisioningLicense.populateGenerateLicenseForm(table = '''| Account | Select Entity | Korlic - ${staticProjectName} | |
	| Product | Select        | DXP Production                | |
	| Version | Select        | 7.2                           | |
	| Type    | Select        | DXP Production                | |''');

		ProvisioningLicense.clickChooseProductPurchaseButton(positionValue = 1);

		ProvisioningLicense.populateGenerateLicenseForm(table = '''| Host Name     | Input    | localhost         | |
	| IP Addresses  | Textarea | 123.45.67.89      | |
	| MAC Addresses | Textarea | 0A-1B-2C-3D-4E-5F | |''');

		ProvisioningLicense.clickGenerateLicenseButton();

		ProvisioningLicense.viewLicense(table = '''| Header  | Korlic - ${staticProjectName} | |
	| Product | DXP Production                | |''');

		ProvisioningLicense.getLicenseKeyIdViaLicenseDetails();

		Provisioning.gotoLicenses();

		Provisioning.expandLicenseAdvancedSearchForm();

		Provisioning.populateAdvancedSearchFormAndSearchViaEnterKey(table = '''| Match                   |                | Radio Button | All                              |
	| Account Key             |                | Input        | ${staticAccountKey}              |
	| Product Purchase Key    |                | Input        | KOR-${staticProductPurchaseId}   |
	| Account Name            |                | Input        | Korlic - ${staticProjectName}    |
	| Owner                   |                | Input        | Korlic - ${staticProjectName}    |
	| Host Name               |                | Input        | localhost                        |
	| IP Address              |                | Input        | 123.45.67.89                     |
	| MAC Address             |                | Input        | 0A-1B-2C-3D-4E-5F                |
	| Created By              |                | Input        | test@liferay.com                 |
	| Last Edited By          |                | Input        | test@liferay.com                 |
	| Active                  | Yes            | Checkbox     | true                             |
	| General Details         |                | Panel        | Collapse                         |
	| License Type            |                | Panel        | Expand                           |
	| License Type            | DXP Production | Checkbox     | true                             |
	| License Type            |                | Panel        | Collapse                         |
	| Product                 |                | Panel        | Expand                           |
	| Product                 | DXP Production | Checkbox     | true                             |
	| Product                 |                | Panel        | Collapse                         |
	| Product Version         |                | Panel        | Expand                           |
	| Product Version         | 7.2            | Checkbox     | true                             |
	| Product Version         |                | Panel        | Collapse                         |
	| Dates                   |                | Panel        | Expand                           |
	| Created Between After   |                | Input        | ${staticYyyyMmDdPastEndDate}     |
	| Created Between Before  |                | Input        | ${staticYyyyMmDdFutureStartDate} |
	| Modified Between After  |                | Input        | ${staticYyyyMmDdPastEndDate}     |
	| Modified Between Before |                | Input        | ${staticYyyyMmDdFutureStartDate} |
	| Started Between After   |                | Input        | ${staticYyyyMmDdPastEndDate}     |
	| Started Between Before  |                | Input        | ${staticYyyyMmDdFutureStartDate} |
	| Dates                   |                | Panel        | Collapse                         |''');

		Provisioning._viewLicenseViaIndex(
			licenseKeyword = "Korlic - ${staticProjectName}",
			table = '''| Name        	| Korlic - ${staticProjectName}  |
	| Description 	| Korlic - ${staticProjectName}  |
	| Account     	| Korlic - ${staticProjectName}  |
	| Product     	| DXP Production                 |
	| Type        	| Production                     |
	| Details     	| Host Name: localhost           |
	| Details     	| IP Address: 123.45.67.89       |
	| Details     	| MAC Address: 0A-1B-2C-3D-4E-5F |
	| Status        | ACTIVE                         |
	| Complimentary | false                          |''');

		Provisioning.viewSearchInfoMessage(table = '''| Label | Account Key: ${staticAccountKey}                     |
	| Label | Product Purchase Key: KOR-${staticProductPurchaseId} |
	| Label | Account Name: Korlic - ${staticProjectName}          |
	| Label | Owner: Korlic - ${staticProjectName}                 |
	| Label | Host Name: localhost                                 |
	| Label | IP Address: 123.45.67.89                             |
	| Label | MAC Address: 0A-1B-2C-3D-4E-5F                       |
	| Label | Created By: test@liferay.com                         |
	| Label | Last Edited By: test@liferay.com                     |
	| Label | Active: Yes                                          |
	| Label | License Type: DXP Production                         |
	| Label | Product: DXP Production                              |
	| Label | Product Version: 7.2                                 |
	| Label | Created Before: ${staticYyyyMmDdFutureStartDate}     |
	| Label | Created After: ${staticYyyyMmDdPastEndDate}          |
	| Label | Modified Before: ${staticYyyyMmDdFutureStartDate}    |
	| Label | Modified After: ${staticYyyyMmDdPastEndDate}         |
	| Label | Started Before: ${staticYyyyMmDdFutureStartDate}     |
	| Label | Started After: ${staticYyyyMmDdPastEndDate}          |''');
	}

