definition {

	property testray.main.component.name = "Support QA";
	property type = "koroneiki";

	tearDown {
		KoroneikiProductConsumptionAPI._tearDownProductConsumptions(
			accountName = "Koroneiki Automotive",
			table = '''| Liferay Digital Experience Platform |''');

		KoroneikiProductAPI._tearDownProducts(table = '''| Liferay Digital Experience Platform |''');

		KoroneikiAccountAPI._tearDownAccounts(table = '''| Koroneiki Automotive |''');

		KoroneikiContactAPI._tearDownContacts(table = '''| koroneiki.contact1@lrcustomer.com.broken |''');
	}

	test Viewproductconsumptionviaaccountcontactattempt {
		KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORAUTO                              | |
	| Description           | Test automotive account on koroneiki | |
	| Fax Number            | 555-555-1234                         | |
	| Name                  | Koroneiki Automotive                 | |
	| Phone Number          | 555-555-5678                         | |
	| Region                | United States                        | |
	| Status                | Active                               | |
	| Tier                  | T4                                   | |
	| Website               | www.koroneikiautomotive.com          | |''');

		KoroneikiContactAPI._createContact(table = '''| Email Address | koroneiki.contact1@lrcustomer.com.broken |
	| First Name    | Koroneiki                                |
	| Language      | English                                  |
	| Last Name     | Contact1                                 |
	| Middle Name   | User                                     |''');

		KoroneikiAccountAPI._assignWorkerContacts(
			accountName = "Koroneiki Automotive",
			table = '''| koroneiki.contact1@lrcustomer.com.broken |''');

		KoroneikiProductAPI._createProduct(table = '''| Name | Liferay Digital Experience Platform | |''');

		KoroneikiAccountAPI._createAccountProductConsumption(
			accountName = "Koroneiki Automotive",
			productName = "Liferay Digital Experience Platform",
			table = '''| Product Field and Value | additionalProp1 | propertyValue1 |
	| Product Field and Value | additionalProp2 | propertyValue2 |
	| Product Field and Value | additionalProp3 | propertyValue3 |''');

		KoroneikiContactAPI._viewContactProductConsumption(
			accountName = "Koroneiki Automotive",
			contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken",
			productName = "Liferay Digital Experience Platform",
			table = '''| Product Field and Value | additionalProp1 | propertyValue1 |
	| Product Field and Value | additionalProp2 | propertyValue2 |
	| Product Field and Value | additionalProp3 | propertyValue3 |''');

		KoroneikiContactAPIPermissionCheck._viewNoContactProductConsumption(
			accountName = "Koroneiki Automotive",
			contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken",
			productName = "Liferay Digital Experience Platform");
	}

}