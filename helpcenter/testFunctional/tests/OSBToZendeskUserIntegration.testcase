definition {

	property testray.main.component.name = "Support QA";
	property type = "zendesk.integration";

	setUp {
		LocalFile.Passwords.getPasswords();

		LocalFile.OSBAdminRabbitMQ.generateProvisioningProjectName();

		LocalFile.JSONOkta.createOktaUser(table = '''| Screen Name   | osb.customer1                       |
	| Email Address | osb.customer1@lrcustomer.com.broken |
	| First Name    | OSB                                 |
	| Last Name     | Customer1                           |''');

		LocalFile.JSONOkta.createOktaUser(table = '''| Screen Name   | osb.customer2                       |
	| Email Address | osb.customer2@lrcustomer.com.broken |
	| First Name    | OSB                                 |
	| Last Name     | Customer2                           |''');

		LocalFile.JSONOkta.createOktaUser(table = '''| Screen Name   | osb.customer3                       |
	| Email Address | osb.customer3@lrcustomer.com.broken |
	| First Name    | OSB                                 |
	| Last Name     | Customer3                           |''');

		LocalFile.KoroneikiAccountAPI._createAccount(table = '''| Code     | OSBZENOSBZEN                  | |
	| Language | English                       | |
	| Name     | Osbzen - ${staticProjectName} | |
	| Region   | United States                 | |
	| Status   | Active                        | |
	| Tier     | T1                            | |''');

		LocalFile.KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Osbzen - ${staticProjectName}",
			contactEmailAddress = "osb.customer1@lrcustomer.com.broken",
			table = '''| Support Requester |''');

		LocalFile.KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Osbzen - ${staticProjectName}",
			contactEmailAddress = "osb.customer2@lrcustomer.com.broken",
			table = '''| Support User |''');

		LocalFile.KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		LocalFile.KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Osbzen - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| End Date                | ${staticEndDate}         |   |
	| Original End Date       | ${staticOriginalEndDate} |   |
	| Perpetual               | false                    |   |
	| Product Field and Value | sizing                   | 1 |
	| Product Field and Value | licenses                 | 1 |
	| Product Field and Value | version                  | 7 |
	| Quantity                | 1                        |   |
	| Start Date              | ${staticStartDate}       |   |
	| Status                  | Approved                 |   |''');

		LocalFile.KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Osbzen - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		LocalFile.KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		LocalFile.JSONOSBAccount.viewSupportOrganizationSync(accountCode = "OSBZENOSBZEN");

		LocalFile.ZendeskOrganizationAPI._viewOrganizationSyncFromOsb(organizationName = "Osbzen - ${staticProjectName}");

		LocalFile.ZendeskUserAPI._viewUserSyncFromOsb(userEmailAddress = "osb.customer1@lrcustomer.com.broken");

		LocalFile.ZendeskUserAPI._viewUserSyncFromOsb(userEmailAddress = "osb.customer2@lrcustomer.com.broken");
	}

	tearDown {
		LocalFile.ZendeskUserAPI._getDefaultUserId(organizationName = "Osbzen - ${staticProjectName}");

		LocalFile.OSBAdminProject.tearDownProjects(table = '''| OSBZENOSBZEN |''');

		LocalFile.KoroneikiAccountAPI._tearDownAccounts(table = '''| Osbzen - ${staticProjectName} |''');

		LocalFile.KoroneikiAccountAPI._tearDownAccountsViaAccountFieldNameAndValue(
			fieldName = "Code",
			table = '''| OSBZENOSBZEN |''');

		LocalFile.KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		LocalFile.JSONUser.tearDownUsers(table = '''| osb.customer1@lrcustomer.com.broken |
	| osb.customer2@lrcustomer.com.broken |
	| osb.customer3@lrcustomer.com.broken |
	| osb.customer4@lrcustomer.com.broken |''');

		LocalFile.JSONUser.tearDownUsersViaSupport(table = '''| osb.customer1@lrcustomer.com.broken |
	| osb.customer2@lrcustomer.com.broken |
	| osb.customer3@lrcustomer.com.broken |
	| osb.customer4@lrcustomer.com.broken |''');

		LocalFile.JSONUser.tearDownUsersViaKoroneiki(table = '''| osb.customer1@lrcustomer.com.broken |
	| osb.customer2@lrcustomer.com.broken |
	| osb.customer3@lrcustomer.com.broken |
	| osb.customer4@lrcustomer.com.broken |''');

		LocalFile.KoroneikiContactAPI._tearDownContacts(table = '''| osb.customer1@lrcustomer.com.broken |
	| osb.customer2@lrcustomer.com.broken |
	| osb.customer3@lrcustomer.com.broken |
	| osb.customer4@lrcustomer.com.broken |''');

		LocalFile.JSONOkta.tearDownUsers(table = '''| osb.customer1@lrcustomer.com.broken |
	| osb.customer2@lrcustomer.com.broken |
	| osb.customer3@lrcustomer.com.broken |
	| osb.customer4@lrcustomer.com.broken |''');

		LocalFile.ZendeskUserAPI._getMultipleUserIdsByEmailAddress(table = '''| osb.customer1@lrcustomer.com.broken |
	| osb.customer2@lrcustomer.com.broken |
	| osb.customer3@lrcustomer.com.broken |
	| osb.customer4@lrcustomer.com.broken |''');

		LocalFile.ZendeskUserAPI._tearDownUsersByIdList(userIds = ${staticUserIdList});

		LocalFile.ZendeskOrganizationAPI._getMultipleOrganizationExternalIdsByOrganizationNameIfStillPresent(table = '''| Osbzen - ${staticProjectName} |''');

		LocalFile.ZendeskOrganizationAPI._tearDownOrganizationsByExternalIdList(organizationExternalIds = ${staticOrganizationExternalIdList});

		LocalFile.ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId});
	}

	test Addnewnonoktauserviaprovisioningafterzendesksync {
		LocalFile.OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		LocalFile.Provisioning.gotoAccounts();

		LocalFile.Provisioning.searchAccounts(keyword = "Osbzen");

		LocalFile.Provisioning.clickAccount(accountName = "Osbzen - ${staticProjectName}");

		LocalFile.Provisioning.clickTab(tabName = "Contacts");

		LocalFile.ProvisioningAccount.clickAssignContactButton();

		LocalFile.ProvisioningAccount.populateAssignContactFormAndSave(table = '''| Email Address | osb.customer4@lrcustomer.com.broken |
	| Assign Role   | Support User                        |''');

		LocalFile.ProvisioningAccount.viewInfoMessageForNonCreatedUserOnOktaViaActiveAccount();

		LocalFile.ProvisioningAccount.populateAssignContactOktaFormAndSave(table = '''| First Name | OSB                                 |
	| Last Name  | Customer4                           |
	| Email      | osb.customer4@lrcustomer.com.broken |
	| Roles      | Support User                        |''');

		LocalFile.ProvisioningAccount._viewAccountContact(
			emailAddress = "osb.customer1@lrcustomer.com.broken",
			table = '''| Name          | OSB Customer1                       |
	| Email Address | osb.customer1@lrcustomer.com.broken |
	| Role          | Support Requester                   |
	| User Status   | VERIFIED                            |''');

		LocalFile.ProvisioningAccount._viewAccountContact(
			emailAddress = "osb.customer2@lrcustomer.com.broken",
			table = '''| Name          | OSB Customer2                       |
	| Email Address | osb.customer2@lrcustomer.com.broken |
	| Role          | Support User                        |
	| User Status   | VERIFIED                            |''');

		LocalFile.ProvisioningAccount._viewAccountContact(
			emailAddress = "osb.customer4@lrcustomer.com.broken",
			table = '''| Name          | OSB Customer4                       |
	| Email Address | osb.customer4@lrcustomer.com.broken |
	| Role          | Support User                        |
	| User Status   | UNVERIFIED                          |''');

		LocalFile.KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		LocalFile.JSONOSBAccount.viewSupportOrganizationSync(accountCode = "OSBZENOSBZEN");

		LocalFile.ZendeskOrganizationAPI._viewOrganizationSyncFromOsb(organizationName = "Osbzen - ${staticProjectName}");

		LocalFile.Provisioning.gotoAccounts();

		LocalFile.Provisioning.searchAccounts(keyword = "Osbzen");

		LocalFile.Provisioning.clickAccount(accountName = "Osbzen - ${staticProjectName}");

		LocalFile.ProvisioningAccount.clickSyncToZendeskButton();

		LocalFile.ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		LocalFile.ZendeskUserAPI._viewUserOrganizationIdSync(
			organizationName = "Osbzen - ${staticProjectName}",
			userEmailAddress = "osb.customer1@lrcustomer.com.broken");

		LocalFile.ZendeskUserAPI._viewUserOrganizationIdSync(
			organizationName = "Osbzen - ${staticProjectName}",
			userEmailAddress = "osb.customer2@lrcustomer.com.broken");

		LocalFile.ZendeskUserAPI._viewUserSyncFromOsb(userEmailAddress = "osb.customer4@lrcustomer.com.broken");

		LocalFile.ZendeskUserAPI._viewUserOrganizationSubscriptionSync(
			organizationName = "Osbzen - ${staticProjectName}",
			userEmailAddress = "osb.customer1@lrcustomer.com.broken");

		LocalFile.ZendeskUserAPI._viewUserOrganizationSubscriptionSync(
			organizationName = "Osbzen - ${staticProjectName}",
			userEmailAddress = "osb.customer2@lrcustomer.com.broken");

		LocalFile.ZendeskUserAPI._viewUserOrganizationSubscriptionSync(
			organizationName = "Osbzen - ${staticProjectName}",
			userEmailAddress = "osb.customer4@lrcustomer.com.broken");

		LocalFile.ZendeskUserAPI._viewUserTagSync(
			tag = "osb_kb",
			userEmailAddress = "osb.customer1@lrcustomer.com.broken");

		LocalFile.ZendeskUserAPI._viewUserTagSync(
			tag = "osb_kb",
			userEmailAddress = "osb.customer2@lrcustomer.com.broken");

		LocalFile.ZendeskUserAPI._viewUserTagSync(
			tag = "osb_kb",
			userEmailAddress = "osb.customer4@lrcustomer.com.broken");

		LocalFile.ZendeskUserAPI._viewUserTagSync(
			tag = "osb_customer",
			userEmailAddress = "osb.customer1@lrcustomer.com.broken");

		LocalFile.ZendeskUserAPI._viewNoUserTagSync(
			tag = "osb_customer",
			userEmailAddress = "osb.customer2@lrcustomer.com.broken");

		LocalFile.ZendeskUserAPI._viewNoUserTagSync(
			tag = "osb_customer",
			userEmailAddress = "osb.customer4@lrcustomer.com.broken");

		LocalFile.ZendeskUserAPI._viewNoUserWatcherTagSync(
			organizationName = "Osbzen - ${staticProjectName}",
			userEmailAddress = "osb.customer1@lrcustomer.com.broken");

		LocalFile.ZendeskUserAPI._viewUserWatcherTagSync(
			organizationName = "Osbzen - ${staticProjectName}",
			userEmailAddress = "osb.customer2@lrcustomer.com.broken");

		LocalFile.ZendeskUserAPI._viewUserWatcherTagSync(
			organizationName = "Osbzen - ${staticProjectName}",
			userEmailAddress = "osb.customer4@lrcustomer.com.broken");

		LocalFile.ZendeskUserAPI._matchOsbUserUuIdWithZendeskUserId(userEmailAddress = "osb.customer1@lrcustomer.com.broken");

		LocalFile.ZendeskUserAPI._matchOsbUserUuIdWithZendeskUserId(userEmailAddress = "osb.customer2@lrcustomer.com.broken");

		LocalFile.ZendeskUserAPI._matchOsbUserUuIdWithZendeskUserId(userEmailAddress = "osb.customer4@lrcustomer.com.broken");
	}

	test Addnewnonoktauserviaprovisioningapiafterzendesksync {
		LocalFile.ProvisioningContactAPI._assignContactRolesToContact(
			accountName = "Osbzen - ${staticProjectName}",
			table = '''| Support User |''',
			userEmailAddress = "osb.customer4@lrcustomer.com.broken");

		LocalFile.KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		LocalFile.JSONOSBAccount.viewSupportOrganizationSync(accountCode = "OSBZENOSBZEN");

		LocalFile.ZendeskOrganizationAPI._viewOrganizationSyncFromOsb(organizationName = "Osbzen - ${staticProjectName}");

		LocalFile.OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		LocalFile.Provisioning.gotoAccounts();

		LocalFile.Provisioning.searchAccounts(keyword = "Osbzen");

		LocalFile.Provisioning.clickAccount(accountName = "Osbzen - ${staticProjectName}");

		LocalFile.ProvisioningAccount.clickSyncToZendeskButton();

		LocalFile.ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		LocalFile.ZendeskUserAPI._viewUserOrganizationIdSync(
			organizationName = "Osbzen - ${staticProjectName}",
			userEmailAddress = "osb.customer1@lrcustomer.com.broken");

		LocalFile.ZendeskUserAPI._viewUserOrganizationIdSync(
			organizationName = "Osbzen - ${staticProjectName}",
			userEmailAddress = "osb.customer2@lrcustomer.com.broken");

		LocalFile.ZendeskUserAPI._viewUserSyncFromOsb(userEmailAddress = "osb.customer4@lrcustomer.com.broken");

		LocalFile.ZendeskUserAPI._viewUserOrganizationSubscriptionSync(
			organizationName = "Osbzen - ${staticProjectName}",
			userEmailAddress = "osb.customer1@lrcustomer.com.broken");

		LocalFile.ZendeskUserAPI._viewUserOrganizationSubscriptionSync(
			organizationName = "Osbzen - ${staticProjectName}",
			userEmailAddress = "osb.customer2@lrcustomer.com.broken");

		LocalFile.ZendeskUserAPI._viewUserOrganizationSubscriptionSync(
			organizationName = "Osbzen - ${staticProjectName}",
			userEmailAddress = "osb.customer4@lrcustomer.com.broken");

		LocalFile.ZendeskUserAPI._viewUserTagSync(
			tag = "osb_kb",
			userEmailAddress = "osb.customer1@lrcustomer.com.broken");

		LocalFile.ZendeskUserAPI._viewUserTagSync(
			tag = "osb_kb",
			userEmailAddress = "osb.customer2@lrcustomer.com.broken");

		LocalFile.ZendeskUserAPI._viewUserTagSync(
			tag = "osb_kb",
			userEmailAddress = "osb.customer4@lrcustomer.com.broken");

		LocalFile.ZendeskUserAPI._viewUserTagSync(
			tag = "osb_customer",
			userEmailAddress = "osb.customer1@lrcustomer.com.broken");

		LocalFile.ZendeskUserAPI._viewNoUserTagSync(
			tag = "osb_customer",
			userEmailAddress = "osb.customer2@lrcustomer.com.broken");

		LocalFile.ZendeskUserAPI._viewNoUserTagSync(
			tag = "osb_customer",
			userEmailAddress = "osb.customer4@lrcustomer.com.broken");

		LocalFile.ZendeskUserAPI._viewNoUserWatcherTagSync(
			organizationName = "Osbzen - ${staticProjectName}",
			userEmailAddress = "osb.customer1@lrcustomer.com.broken");

		LocalFile.ZendeskUserAPI._viewUserWatcherTagSync(
			organizationName = "Osbzen - ${staticProjectName}",
			userEmailAddress = "osb.customer2@lrcustomer.com.broken");

		LocalFile.ZendeskUserAPI._viewUserWatcherTagSync(
			organizationName = "Osbzen - ${staticProjectName}",
			userEmailAddress = "osb.customer4@lrcustomer.com.broken");

		LocalFile.ZendeskUserAPI._matchOsbUserUuIdWithZendeskUserId(userEmailAddress = "osb.customer1@lrcustomer.com.broken");

		LocalFile.ZendeskUserAPI._matchOsbUserUuIdWithZendeskUserId(userEmailAddress = "osb.customer2@lrcustomer.com.broken");

		LocalFile.ZendeskUserAPI._matchOsbUserUuIdWithZendeskUserId(userEmailAddress = "osb.customer4@lrcustomer.com.broken");
	}

	test Addnewuserviaprovisioningafterzendesksync {
		LocalFile.OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		LocalFile.Provisioning.gotoAccounts();

		LocalFile.Provisioning.searchAccounts(keyword = "Osbzen");

		LocalFile.Provisioning.clickAccount(accountName = "Osbzen - ${staticProjectName}");

		LocalFile.Provisioning.clickTab(tabName = "Contacts");

		LocalFile.ProvisioningAccount.clickAssignContactButton();

		LocalFile.ProvisioningAccount.populateAssignContactFormAndSave(table = '''| Email Address | osb.customer3@lrcustomer.com.broken |
	| Assign Role   | Support User                        |''');

		LocalFile.ProvisioningAccount._viewAccountContact(
			emailAddress = "osb.customer1@lrcustomer.com.broken",
			table = '''| Name          | OSB Customer1                       |
	| Email Address | osb.customer1@lrcustomer.com.broken |
	| Role          | Support Requester                   |
	| User Status   | VERIFIED                            |''');

		LocalFile.ProvisioningAccount._viewAccountContact(
			emailAddress = "osb.customer2@lrcustomer.com.broken",
			table = '''| Name          | OSB Customer2                       |
	| Email Address | osb.customer2@lrcustomer.com.broken |
	| Role          | Support User                        |
	| User Status   | VERIFIED                            |''');

		LocalFile.ProvisioningAccount._viewAccountContact(
			emailAddress = "osb.customer3@lrcustomer.com.broken",
			table = '''| Name          | OSB Customer3                       |
	| Email Address | osb.customer3@lrcustomer.com.broken |
	| Role          | Support User                        |
	| User Status   | VERIFIED                            |''');

		LocalFile.ProvisioningAccount.clickSyncToZendeskButton();

		LocalFile.KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		LocalFile.ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

