	test Updatezendeskuserverificationafterloginonokta {
		OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		Provisioning.gotoAccounts();

		Provisioning.searchAccounts(keyword = "Osbzen");

		Provisioning.clickAccount(accountName = "Osbzen - ${staticProjectName}");

		ProvisioningAccount.clickSyncToZendeskButton();

		Provisioning.clickTab(tabName = "Contacts");

		ProvisioningAccount.clickAssignContactButton();

		ProvisioningAccount.populateAssignContactFormAndSave(table = '''| Email Address | osb.customer3@lrcustomer.com.broken |
	| Assign Role   | Support User                        |''');

		ProvisioningAccount.clickSyncToZendeskButton();

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		ZendeskUserAPI._viewUserVerificationByEmailAddress(
			userEmailAddress = "osb.customer3@lrcustomer.com.broken",
			userVerified = "false");

		Okta._loginToDevDomain(
			userEmailAddress = "osb.customer3@lrcustomer.com.broken",
			userPassword = ${staticOktaUserPassword});

		ZendeskUserAPI._updateUserPasswordByEmailAddress(
			userEmailAddress = "osb.customer3@lrcustomer.com.broken",
			userPassword = ${staticZendeskAdminPassword});

		ZendeskHomepage.login(
			userEmailAddress = "osb.customer3@lrcustomer.com.broken",
			userPassword = ${staticZendeskAdminPassword});

		ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		ZendeskUserAPI._viewUserVerificationByEmailAddress(
			userEmailAddress = "osb.customer3@lrcustomer.com.broken",
			userVerified = "true");
	}

