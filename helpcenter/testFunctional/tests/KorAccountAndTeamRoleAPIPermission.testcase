definition {

	property testray.main.component.name = "Support QA";
	property type = "koroneiki";

	tearDown {
		KoroneikiAccountAPI._tearDownAccountPermissions(accountName = "Koroneiki Automotive");

		KoroneikiTeamAPI._tearDownTeams(table = '''| Development Team |''');

		KoroneikiTeamRoleAPI._tearDownTeamRoles(table = '''| Default Account Role |''');

		KoroneikiAccountAPI._tearDownAccounts(table = '''| Koroneiki Automotive |''');
	}

	test Assignteamroletoteamattempt {
		KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORAUTO                                  | |
	| Contact Email Address | koroneiki.contact1@lrcustomer.com.broken | |
	| Description           | Test automotive account on koroneiki     | |
	| Fax Number            | 555-555-1234                             | |
	| Name                  | Koroneiki Automotive                     | |
	| Phone Number          | 555-555-5678                             | |
	| Profile Email Address | koroneiki.contact1@lrcustomer.com.broken | |
	| Region                | United States                            | |
	| Status                | Active                                   | |
	| Tier                  | T4                                       | |
	| Website               | www.koroneikiautomotive.com              | |''');

		KoroneikiAccountAPI._createAccountTeam(
			accountName = "Koroneiki Automotive",
			teamName = "Development Team");

		KoroneikiTeamRoleAPI._createTeamRole(table = '''| Description | This is the default role for accounts |
	| Name        | Default Account Role                  |
	| Type        | Account                               |''');

		KoroneikiAccountAPIPermissionCheck._assignTeamRolesToTeamAttempt(
			accountName = "Koroneiki Automotive",
			table = '''| Default Account Role |''',
			teamName = "Development Team");

		KoroneikiAccountAPI._viewNoTeamRole(
			accountName = "Koroneiki Automotive",
			teamName = "Development Team",
			teamRoleName = "Default Account Role");

		KoroneikiTeamAPI._viewNoTeamAssignedAccount(
			accountName = "Koroneiki Automotive",
			teamName = "Development Team");
	}

	test Assignteamroletoteamattemptbynewlynonpermissioneduser {
		KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORAUTO                                  | |
	| Contact Email Address | koroneiki.contact1@lrcustomer.com.broken | |
	| Description           | Test automotive account on koroneiki     | |
	| Fax Number            | 555-555-1234                             | |
	| Name                  | Koroneiki Automotive                     | |
	| Phone Number          | 555-555-5678                             | |
	| Profile Email Address | koroneiki.contact1@lrcustomer.com.broken | |
	| Region                | United States                            | |
	| Status                | Active                                   | |
	| Tier                  | T4                                       | |
	| Website               | www.koroneikiautomotive.com              | |''');

		KoroneikiAccountAPI._createAccountTeam(
			accountName = "Koroneiki Automotive",
			teamName = "Development Team");

		KoroneikiTeamRoleAPI._createTeamRole(table = '''| Description | This is the default role for accounts |
	| Name        | Default Account Role                  |
	| Type        | Account                               |''');

		KoroneikiAccountAPI._setAccountPermissions(
			accountName = "Koroneiki Automotive",
			table = '''| Assign Team | true |''');

		KoroneikiTeamAPI._setTeamPermissions(
			table = '''| View | true |''',
			teamName = "Development Team");

		KoroneikiTeamRoleAPI._setTeamRolePermissions(
			table = '''| Assign Team | true |''',
			teamRoleName = "Default Account Role");

		KoroneikiAccountAPI._unsetAccountPermissions(
			accountName = "Koroneiki Automotive",
			table = '''| Assign Team | true |''');

		KoroneikiTeamAPI._unsetTeamPermissions(
			table = '''| View | true |''',
			teamName = "Development Team");

		KoroneikiTeamRoleAPI._unsetTeamRolePermissions(
			table = '''| Assign Team | true |''',
			teamRoleName = "Default Account Role");

		KoroneikiAccountAPIPermissionCheck._assignTeamRolesToTeamAttempt(
			accountName = "Koroneiki Automotive",
			table = '''| Default Account Role |''',
			teamName = "Development Team");

		KoroneikiAccountAPI._viewNoTeamRole(
			accountName = "Koroneiki Automotive",
			teamName = "Development Team",
			teamRoleName = "Default Account Role");

		KoroneikiTeamAPI._viewNoTeamAssignedAccount(
			accountName = "Koroneiki Automotive",
			teamName = "Development Team");
	}

