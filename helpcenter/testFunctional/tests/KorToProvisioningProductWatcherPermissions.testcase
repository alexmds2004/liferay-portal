definition {

	property testray.main.component.name = "Support QA";
	property type = "provisioning.security";

	setUp {
		LocalFile.Passwords.getPasswords();

		LocalFile.JSONUser.createViaProvisioning(table = '''| Screen Name   | provisioning.watcher                    |
	| Email Address | provisioning.watcher@liferay.com.broken |
	| First Name    | Provisioning                            |
	| Last Name     | Watcher                                 |''');

		LocalFile.JSONUser.assignUserToProvisioningRole(
			roleName = "Provisioning Watcher",
			userEmailAddress = "provisioning.watcher@liferay.com.broken");
	}

	tearDown {
		LocalFile.KoroneikiProductAPI._tearDownProducts(table = '''| A Visible DXP Product |''');

		LocalFile.JSONUser.tearDownUsersViaProvisioning(table = '''| provisioning.watcher@liferay.com.broken |''');
	}

	test Viewnonewproductbutton {
		LocalFile.OSBAdmin.loginToProvisioning(
			userEmailAddress = "provisioning.watcher@liferay.com.broken",
			userPassword = ${staticProvisioningQaUserPassword});

		LocalFile.UserAccount.updatePasswordUponLogin(userPassword = "test");

		LocalFile.Provisioning.gotoProducts();

		LocalFile.Provisioning.viewNoNewProductButton();
	}

	test Viewproduct {
		LocalFile.KoroneikiProductAPI._createProduct(table = '''| Name | A Visible DXP Product | |''');

		LocalFile.OSBAdmin.loginToProvisioning(
			userEmailAddress = "provisioning.watcher@liferay.com.broken",
			userPassword = ${staticProvisioningQaUserPassword});

		LocalFile.UserAccount.updatePasswordUponLogin(userPassword = "test");

		LocalFile.Provisioning.gotoProducts();

		LocalFile.Provisioning.searchProducts(keyword = "A");

		LocalFile.Provisioning._viewProductNonLinkViaIndex(
			productName = "A Visible DXP Product",
			table = '''| Name | A Visible DXP Product |''');

		LocalFile.Provisioning.viewNoProductDeleteButton(productName = "A Visible DXP Product");
	}

}