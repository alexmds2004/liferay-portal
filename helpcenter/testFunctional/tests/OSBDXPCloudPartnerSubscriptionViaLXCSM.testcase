definition {

	property testray.main.component.name = "Support QA";
	property type = "osb.integration";

	setUp {
		Passwords.getPasswords();

		OSBAdminRabbitMQ.generateProvisioningProjectName();

		OSBAdminRabbitMQ.generateProvisioningCompanyName();

		JSONOkta.createOktaUser(table = '''| Screen Name   | lxcsm.customer1                       |
	| Email Address | lxcsm.customer1@lrcustomer.com.broken |
	| First Name    | LXCSM                                 |
	| Last Name     | Customer1                             |''');

		JSONOkta.createOktaUser(table = '''| Screen Name   | lxcsm.partner1                      |
	| Email Address | lxcsm.partner1@lrpartner.com.broken |
	| First Name    | LXCSM                               |
	| Last Name     | Partner1                            |''');

		KoroneikiAccountAPI._createAccount(table = '''| Name   | Lxcpar - ${staticCompanyName} | |
	| Code   | LXCPARLXCPAR                  | |
	| Status | Active                        | |''');

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Lxcpar - ${staticCompanyName}",
			contactEmailAddress = "lxcsm.partner1@lrpartner.com.broken",
			table = '''| Partner Manager |''');

		KoroneikiProductPurchaseAPI._setProjectDetailsNonAbbreviatedDateMethod();

		KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		KoroneikiProductPurchaseAPI.generateStaticPastStartAndEndDate();

		KoroneikiProductPurchaseAPI.generateStaticFullNonAbbreviatedStartAndEndDate();

		KoroneikiProductPurchaseAPI.generateStaticFullNonAbbreviatedFutureStartAndEndDate();

		KoroneikiProductPurchaseAPI.generateStaticFullNonAbbreviatedPastStartAndEndDate();

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Lxcpar - ${staticCompanyName}",
			productName = "Service Partnership",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiAccountAPI._createAssignedTeamNestedField(
			accountName = "Lxczen - ${staticProjectName}",
			teamName = "Lxcpar - ${staticCompanyName}");

		KoroneikiAccountAPI._createAccount(table = '''| Assigned Team Nested Field | ${staticAssignedTeamNestedField} | |
	| Code                       | LXCZENLXCZEN                     | |
	| Name                       | Lxczen - ${staticProjectName}    | |
	| Region                     | United States                    | |
	| Status                     | Active                           | |
	| Tier                       | T1                               | |''');

		KoroneikiAccountAPI._assignTeamRolesToTeam(
			accountName = "Lxczen - ${staticProjectName}",
			table = '''| Partner |''',
			teamName = "Lxcpar - ${staticCompanyName}");

		KoroneikiAccountAPI._assignTeamRolesToTeam(
			accountName = "Lxczen - ${staticProjectName}",
			table = '''| First Line Support |''',
			teamName = "Lxcpar - ${staticCompanyName}");

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Lxczen - ${staticProjectName}",
			contactEmailAddress = "lxcsm.customer1@lrcustomer.com.broken",
			table = '''| Support Requester |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Lxczen - ${staticProjectName}",
			productName = "LXC SM Subscription HA Production",
			table = '''| End Date                | ${staticEndDate}         |   |
	| Original End Date       | ${staticOriginalEndDate} |   |
	| Perpetual               | false                    |   |
	| Product Field and Value | sizing                   | 1 |
	| Quantity                | 1                        |   |
	| Start Date              | ${staticStartDate}       |   |
	| Status                  | Approved                 |   |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Lxczen - ${staticProjectName}",
			productName = "Premium Subscription",
			table = '''| End Date                | ${staticEndDate}         |   |
	| Original End Date       | ${staticOriginalEndDate} |   |
	| Perpetual               | false                    |   |
	| Product Field and Value | sizing                   | 1 |
	| Quantity                | 1                        |   |
	| Start Date              | ${staticStartDate}       |   |
	| Status                  | Approved                 |   |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Premium Subscription");

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Partner");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Partner");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - LXC SM");

		JSONOSBAccount.viewSupportOrganizationSync(accountCode = "LXCZENLXCZEN");
	}

	tearDown {
		ZendeskUserAPI._getDefaultUserId(organizationName = "Lxcpar - ${staticCompanyName}");

		ZendeskUserAPI._renameFirstDefaultUserIdVariable();

		ZendeskUserAPI._getDefaultUserId(organizationName = "Lxczen - ${staticProjectName}");

		ZendeskUserAPI._renameSecondDefaultUserIdVariable();

		OSBAdminProject.tearDownProjects(table = '''| LXCZENLXCZEN |
	| LXCPARLXCPAR |''');

		KoroneikiAccountAPI._tearDownAccounts(table = '''| Lxcpar - ${staticCompanyName} |
	| Lxczen - ${staticProjectName} |''');

		KoroneikiAccountAPI._tearDownAccountsViaAccountFieldNameAndValue(
			fieldName = "Code",
			table = '''| LXCZENLXCZEN |
	| LXCPARLXCPAR |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Gold Subscription");

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Premium Subscription");

		JSONUser.tearDownUsersViaSupport(table = '''| lxcsm.customer1@lrcustomer.com.broken |
	| lxcsm.partner1@lrpartner.com.broken   |''');

		JSONUser.tearDownUsersViaKoroneiki(table = '''| lxcsm.customer1@lrcustomer.com.broken |
	| lxcsm.partner1@lrpartner.com.broken   |''');

		KoroneikiProductConsumptionAPI._tearDownProductConsumptions(
			accountName = "Lxczen - ${staticCompanyName}",
			table = '''| DXP Production                      |
	| Premium Subscription                |
	| LXC SM Subscription HA Production |''');

		KoroneikiContactAPI._tearDownContacts(table = '''| lxcsm.customer1@lrcustomer.com.broken |
	| lxcsm.partner1@lrpartner.com.broken   |''');

		JSONOkta.tearDownUsers(table = '''| lxcsm.customer1@lrcustomer.com.broken |
	| lxcsm.partner1@lrpartner.com.broken   |''');

		ZendeskUserAPI._getMultipleUserIdsByEmailAddress(table = '''| lxcsm.customer1@lrcustomer.com.broken |
	| lxcsm.partner1@lrpartner.com.broken   |''');

		ZendeskUserAPI._tearDownUsersByIdList(userIds = ${staticUserIdList});

		ZendeskOrganizationAPI._getMultipleOrganizationExternalIdsByOrganizationNameIfStillPresent(table = '''| Lxcpar - ${staticCompanyName} |
	| Lxczen - ${staticProjectName} |''');

		ZendeskOrganizationAPI._tearDownOrganizationsByExternalIdList(organizationExternalIds = ${staticOrganizationExternalIdList});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId1});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId2});

		OSBAdmin.logoutAndLoginToSupport(
			userEmailAddress = ${staticSupportAdminEmailAdress},
			userPassword = ${staticSupportAdminPassword});

		DXPCloud.tearDownDXPCloudSubscriptionUsers(table = '''| lxcsm.customer1@lrcustomer.com.broken |
	| lxcsm.partner1@lrpartner.com.broken   |''');
	}

	test Addandremovepartnerusermanually {
		DXPCloud.viewNoSubscribedUser(userEmailAddress = "lxcsm.partner1@lrpartner.com.broken");

		OSBAdmin.loginToSupport(
			userEmailAddress = ${staticSupportAdminEmailAdress},
			userPassword = ${staticSupportAdminPassword});

		DXPCloud.addDXPCloudSubscriptionUserManually(userEmailAddress = "lxcsm.partner1@lrpartner.com.broken");

		DXPCloud.viewSubscribedUser(userEmailAddress = "lxcsm.partner1@lrpartner.com.broken");

		DXPCloud.viewSubscribedUser(userEmailAddress = "lxcsm.customer1@lrcustomer.com.broken");

		DXPCloud.removeDXPCloudSubscriptionUserManually(userEmailAddress = "lxcsm.partner1@lrpartner.com.broken");

		DXPCloud.viewNoSubscribedUser(userEmailAddress = "lxcsm.partner1@lrpartner.com.broken");

		DXPCloud.viewSubscribedUser(userEmailAddress = "lxcsm.customer1@lrcustomer.com.broken");
	}

	test ExpireLXCSMsubscriptionandcheckpartnersubscriptionstatus {
		OSBAdmin.loginToSupport(
			userEmailAddress = ${staticSupportAdminEmailAdress},
			userPassword = ${staticSupportAdminPassword});

		DXPCloud.addDXPCloudSubscriptionUserManually(userEmailAddress = "lxcsm.partner1@lrpartner.com.broken");

		DXPCloud.viewSubscribedUser(userEmailAddress = "lxcsm.partner1@lrpartner.com.broken");

		DXPCloud.viewSubscribedUser(userEmailAddress = "lxcsm.customer1@lrcustomer.com.broken");

		KoroneikiProductPurchaseAPI._updateProductPurchase(
			accountName = "Lxczen - ${staticProjectName}",
			productName = "LXC SM Subscription HA Production",
			table = '''| End Date          | ${staticPastEndDate}         | |
	| Original End Date | ${staticPastOriginalEndDate} | |
	| Perpetual         | false                        | |
	| Start Date        | ${staticPastStartDate}       | |
	| Status            | Approved                     | |''');

		KoroneikiProductPurchaseAPI._updateProductPurchase(
			accountName = "Lxczen - ${staticProjectName}",
			productName = "Premium Subscription",
			table = '''| End Date          | ${staticPastEndDate}         | |
	| Original End Date | ${staticPastOriginalEndDate} | |
	| Perpetual         | false                        | |
	| Start Date        | ${staticPastStartDate}       | |
	| Status            | Approved                     | |''');

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - LXC SM");

		DXPCloud.viewSubscribedUser(userEmailAddress = "lxcsm.partner1@lrpartner.com.broken");

		DXPCloud.viewNoSubscribedUser(userEmailAddress = "lxcsm.customer1@lrcustomer.com.broken");
	}

	test RemoveDXPsubscriptionandcheckpartnersubscriptionstatus {
		OSBAdmin.loginToSupport(
			userEmailAddress = ${staticSupportAdminEmailAdress},
			userPassword = ${staticSupportAdminPassword});

		DXPCloud.addDXPCloudSubscriptionUserManually(userEmailAddress = "lxcsm.partner1@lrpartner.com.broken");

		DXPCloud.viewSubscribedUser(userEmailAddress = "lxcsm.partner1@lrpartner.com.broken");

		DXPCloud.viewSubscribedUser(userEmailAddress = "lxcsm.customer1@lrcustomer.com.broken");

		KoroneikiProductPurchaseAPI._deleteProductPurchase(
			accountName = "Lxczen - ${staticProjectName}",
			productName = "LXC SM Subscription HA Production");

		KoroneikiProductPurchaseAPI._deleteProductPurchase(
			accountName = "Lxczen - ${staticProjectName}",
			productName = "Premium Subscription");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - LXC SM");

		DXPCloud.viewSubscribedUser(userEmailAddress = "lxcsm.partner1@lrpartner.com.broken");

		DXPCloud.viewNoSubscribedUser(userEmailAddress = "lxcsm.customer1@lrcustomer.com.broken");
	}

}