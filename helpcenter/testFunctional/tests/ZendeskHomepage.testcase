definition {

	property testray.main.component.name = "Support QA";
	property type = "zendesk.frontend";

	setUp {
		LocalFile.Passwords.getPasswords();
	}

	tearDown {
		LocalFile.ZendeskUserAPI._tearDownUsersByExternalIdTable(table = '''| Enduser1 |''');

		LocalFile.ZendeskOrganizationAPI._tearDownOrganizationsByExternalIdTable(table = '''| 12341234 |''');
	}

	property help.center.acceptance = "true";
	test ViewHomepageasCustomer {
		LocalFile.ZendeskOrganizationAPI._createOrganization(table = '''| Status           | Approved                   |
	| Name             | Frontend Org Name 1        |
	| Tags             | liferay_dxp,liferay_portal |
	| Shared Tickets   | true                       |
	| Shared Comments  | true                       |
	| SLA              | Gold                       |
	| Tier             | T4                         |
	| Support Region   | US                         |
	| Support Language | English                    |
	| External ID      | 12341234                   |''');

		LocalFile.ZendeskUserAPI._createUser(table = '''| Name         | Zendesk Enduser1                    |
	| Tags         | osb_customer                        |
	| Password     | ${staticZendeskAdminPassword}       |
	| Role         | End-user                            |
	| Access       | Organization                        |
	| Email        | zendesk.enduser1@zendesk.com.broken |
	| Phone Number | +1 (555) 555-5555                   |
	| Organization | Frontend Org Name 1                 |
	| Language     | English                             |
	| Time Zone    | Pacific Time (US & Canada)          |
	| External ID  | Enduser1                            |''');

		LocalFile.ZendeskHomepage.login(
			userEmailAddress = "zendesk.enduser1@zendesk.com.broken",
			userPassword = ${staticZendeskAdminPassword});

		LocalFile.ZendeskHomepage.acceptAllCookies();

		LocalFile.ZendeskHomepage.viewHomepageWithoutKBUserPermissions();
	}

	test ViewHomepageasCustomerwithKBpermissions {
		LocalFile.ZendeskOrganizationAPI._createOrganization(table = '''| Status           | Approved                   |
	| Name             | Frontend Org Name 1        |
	| Tags             | liferay_dxp,liferay_portal |
	| Shared Tickets   | true                       |
	| Shared Comments  | true                       |
	| SLA              | Gold                       |
	| Tier             | T4                         |
	| Support Region   | US                         |
	| Support Language | English                    |
	| External ID      | 12341234                   |''');

		LocalFile.ZendeskUserAPI._createUser(table = '''| Name         | Zendesk Enduser1                    |
	| Tags         | osb_customer,osb_kb                 |
	| Password     | ${staticZendeskAdminPassword}       |
	| Role         | End-user                            |
	| Access       | Organization                        |
	| Email        | zendesk.enduser1@zendesk.com.broken |
	| Phone Number | +1 (555) 555-5555                   |
	| Organization | Frontend Org Name 1                 |
	| Language     | English                             |
	| Time Zone    | Pacific Time (US & Canada)          |
	| External ID  | Enduser1                            |''');

		LocalFile.ZendeskHomepage.login(
			userEmailAddress = "zendesk.enduser1@zendesk.com.broken",
			userPassword = ${staticZendeskAdminPassword});

		LocalFile.ZendeskHomepage.acceptAllCookies();

		LocalFile.ZendeskHomepage.viewHomepageWithKBPermissions();

		LocalFile.ZendeskHomepage.viewCurrentLanguage(currentLanguage = "English (US)");

		LocalFile.ZendeskHomepage.viewNoDeveloperServicesLink();
	}

	test ViewHomepageasDeveloperServicesuser {
		LocalFile.ZendeskOrganizationAPI._createOrganization(table = '''| Status           | Approved                   |
	| Name             | Frontend Org Name 1        |
	| Tags             | developer_services         |
	| Shared Tickets   | true                       |
	| Shared Comments  | true                       |
	| SLA              | Gold                       |
	| Tier             | T4                         |
	| Support Region   | US                         |
	| Support Language | English                    |
	| External ID      | 12341234                   |''');

		LocalFile.ZendeskUserAPI._createUser(table = '''| Name         | Zendesk Enduser1                    |
	| Tags         | osb_customer,osb_kb                 |
	| Password     | ${staticZendeskAdminPassword}       |
	| Role         | End-user                            |
	| Access       | Organization                        |
	| Email        | zendesk.enduser1@zendesk.com.broken |
	| Phone Number | +1 (555) 555-5555                   |
	| Organization | Frontend Org Name 1                 |
	| Language     | English                             |
	| Time Zone    | Pacific Time (US & Canada)          |
	| External ID  | Enduser1                            |''');

		LocalFile.ZendeskHomepage.login(
			userEmailAddress = "zendesk.enduser1@zendesk.com.broken",
			userPassword = ${staticZendeskAdminPassword});

		LocalFile.ZendeskHomepage.acceptAllCookies();

		LocalFile.ZendeskHomepage.viewDeveloperServicesLink();
	}

	property help.center.acceptance = "true";
	test ViewHomepageasGuest {
		LocalFile.ZendeskHomepage.gotoPageURL(zendeskPageUrl = "/hc/en-us");

		LocalFile.ZendeskHomepage.acceptAllCookies();

		LocalFile.ZendeskHomepage.viewHomepageAsGuest();
	}

	property help.center.acceptance = "true";
	test ViewHomepageasKBUser {
		LocalFile.ZendeskOrganizationAPI._createOrganization(table = '''| Status           | Approved                   |
	| Name             | Frontend Org Name 1        |
	| Tags             | liferay_dxp,liferay_portal |
	| Shared Tickets   | true                       |
	| Shared Comments  | true                       |
	| SLA              | Gold                       |
	| Tier             | T4                         |
	| Support Region   | US                         |
	| Support Language | English                    |
	| External ID      | 12341234                   |''');

		LocalFile.ZendeskUserAPI._createUser(table = '''| Name         | Zendesk Enduser1                    |
	| Tags         | osb_kb                              |
	| Password     | ${staticZendeskAdminPassword}       |
	| Role         | End-user                            |
	| Access       | Organization                        |
	| Email        | zendesk.enduser1@zendesk.com.broken |
	| Phone Number | +1 (555) 555-5555                   |
	| Organization | Frontend Org Name 1                 |
	| Language     | English                             |
	| Time Zone    | Pacific Time (US & Canada)          |
	| External ID  | Enduser1                            |''');

		LocalFile.ZendeskHomepage.login(
			userEmailAddress = "zendesk.enduser1@zendesk.com.broken",
			userPassword = ${staticZendeskAdminPassword});

		LocalFile.ZendeskHomepage.acceptAllCookies();

		LocalFile.ZendeskHomepage.viewHomepageWithKBPermissions();

		LocalFile.ZendeskHomepage.viewCurrentLanguage(currentLanguage = "English (US)");

		LocalFile.ZendeskHomepage.viewNoDeveloperServicesLink();
	}

	property help.center.acceptance = "true";
	test ViewHomepageasPartner {
		LocalFile.ZendeskOrganizationAPI._createOrganization(table = '''| Status           | Approved                   |
	| Name             | Frontend Org Name 1        |
	| Tags             | liferay_dxp,liferay_portal |
	| Shared Tickets   | true                       |
	| Shared Comments  | true                       |
	| SLA              | Gold                       |
	| Tier             | T4                         |
	| Support Region   | US                         |
	| Support Language | English                    |
	| External ID      | 12341234                   |''');

		LocalFile.ZendeskUserAPI._createUser(table = '''| Name         | Zendesk Enduser1                    |
	| Tags         | osb_partner                         |
	| Password     | ${staticZendeskAdminPassword}       |
	| Role         | End-user                            |
	| Access       | Organization                        |
	| Email        | zendesk.enduser1@zendesk.com.broken |
	| Phone Number | +1 (555) 555-5555                   |
	| Organization | Frontend Org Name 1                 |
	| Language     | English                             |
	| Time Zone    | Pacific Time (US & Canada)          |
	| External ID  | Enduser1                            |''');

		LocalFile.ZendeskHomepage.login(
			userEmailAddress = "zendesk.enduser1@zendesk.com.broken",
			userPassword = ${staticZendeskAdminPassword});

		LocalFile.ZendeskHomepage.acceptAllCookies();

		LocalFile.ZendeskHomepage.viewHomepageWithoutKBUserPermissions();
	}

	test ViewHomepageasPartnerwithKBpermissions {
		LocalFile.ZendeskOrganizationAPI._createOrganization(table = '''| Status           | Approved                   |
	| Name             | Frontend Org Name 1        |
	| Tags             | liferay_dxp,liferay_portal |
	| Shared Tickets   | true                       |
	| Shared Comments  | true                       |
	| SLA              | Gold                       |
	| Tier             | T4                         |
	| Support Region   | US                         |
	| Support Language | English                    |
	| External ID      | 12341234                   |''');

		LocalFile.ZendeskUserAPI._createUser(table = '''| Name         | Zendesk Enduser1                    |
	| Tags         | osb_partner,osb_kb                  |
	| Password     | ${staticZendeskAdminPassword}       |
	| Role         | End-user                            |
	| Access       | Organization                        |
	| Email        | zendesk.enduser1@zendesk.com.broken |
	| Phone Number | +1 (555) 555-5555                   |
	| Organization | Frontend Org Name 1                 |
	| Language     | English                             |
	| Time Zone    | Pacific Time (US & Canada)          |
	| External ID  | Enduser1                            |''');

		LocalFile.ZendeskHomepage.login(
			userEmailAddress = "zendesk.enduser1@zendesk.com.broken",
			userPassword = ${staticZendeskAdminPassword});

		LocalFile.ZendeskHomepage.acceptAllCookies();

		LocalFile.ZendeskHomepage.viewHomepageWithKBPermissions();

		LocalFile.ZendeskHomepage.viewCurrentLanguage(currentLanguage = "English (US)");

		LocalFile.ZendeskHomepage.viewNoDeveloperServicesLink();
	}

	test ViewHomepageasT4User {
		LocalFile.ZendeskOrganizationAPI._createOrganization(table = '''| Status           | Approved                   |
	| Name             | Frontend Org Name 1        |
	| Tags             | liferay_dxp,liferay_portal |
	| Shared Tickets   | true                       |
	| Shared Comments  | true                       |
	| SLA              | Gold                       |
	| Tier             | T4                         |
	| Support Region   | US                         |
	| Support Language | English                    |
	| External ID      | 12341234                   |''');

		LocalFile.ZendeskUserAPI._createUser(table = '''| Name             | Zendesk Enduser1                    |
	| Password         | ${staticZendeskAdminPassword}       |
	| Role             | End-user                            |
	| Access           | Organization                        |
	| Email            | zendesk.enduser1@zendesk.com.broken |
	| Phone Number     | +1 (555) 555-5555                   |
	| Organization     | Frontend Org Name 1                 |
	| Language         | English                             |
	| Time Zone        | Pacific Time (US & Canada)          |
	| External ID      | Enduser1                            |''');

		LocalFile.ZendeskHomepage.login(
			userEmailAddress = "zendesk.enduser1@zendesk.com.broken",
			userPassword = ${staticZendeskAdminPassword});

		LocalFile.ZendeskHomepage.acceptAllCookies();

		LocalFile.ZendeskHomepage.viewHomepageWithoutKBUserPermissions();
	}

}