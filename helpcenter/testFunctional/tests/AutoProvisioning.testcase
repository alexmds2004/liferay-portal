definition {

	property testray.main.component.name = "Support QA";
	property type = "auto.provisioning";

	setUp {
		Passwords.getPasswords();

		JSONOkta.createOktaUser(table = '''| Screen Name   | usr.provisioning1                       |
	| Email Address | usr.provisioning1@lrcustomer.com.broken |
	| First Name    | USR                                     |
	| Last Name     | Provisioning1                           |''');
	}

	tearDown {
		ZendeskUserAPI._getDefaultUserId(organizationName = "Provis - ${staticProjectName}");

		ZendeskUserAPI._renameFirstDefaultUserIdVariable();

		ZendeskUserAPI._getDefaultUserId(organizationName = "Propar - ${staticCompanyName}");

		ZendeskUserAPI._renameSecondDefaultUserIdVariable();

		OSBAdminProject.tearDownProjects(table = '''| PROPAR       |
	| VISPROPROVIS |''');

		KoroneikiAccountAPI._tearDownAccounts(table = '''| Propar - ${staticCompanyName} |
	| Provis - ${staticProjectName} |
	| Vispro - ${staticCompanyName} |''');

		KoroneikiAccountAPI._tearDownAccountsViaAccountFieldNameAndValue(
			fieldName = "Code",
			table = '''| PROPAR       |
	| VISPROPROVIS |
	| VISPRO       |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		JSONUser.tearDownUsers(table = '''| usr.provisioning1@lrcustomer.com.broken |
	| usr.provisioning2@lrcustomer.com.broken |''');

		JSONUser.tearDownUsersViaSupport(table = '''| usr.provisioning1@lrcustomer.com.broken |
	| usr.provisioning2@lrcustomer.com.broken |''');

		JSONUser.tearDownUsersViaKoroneiki(table = '''| usr.provisioning1@lrcustomer.com.broken |
	| usr.provisioning2@lrcustomer.com.broken |''');

		KoroneikiContactAPI._tearDownContacts(table = '''| usr.provisioning1@lrcustomer.com.broken |
	| usr.provisioning2@lrcustomer.com.broken |''');

		JSONOkta.tearDownUsers(table = '''| usr.provisioning1@lrcustomer.com.broken |
	| usr.provisioning2@lrcustomer.com.broken |''');

		ZendeskTicketAPI._tearDownTicketsByKeywords(table = '''| New Subscription(s) for Propar - ${staticCompanyName} |
	| New Subscription(s) for Provis - ${staticProjectName} |''');

		ZendeskUserAPI._getMultipleUserIdsByEmailAddress(table = '''| usr.provisioning1@lrcustomer.com.broken |
	| usr.provisioning2@lrcustomer.com.broken |''');

		ZendeskUserAPI._tearDownUsersByIdList(userIds = ${staticUserIdList});

		ZendeskOrganizationAPI._getMultipleOrganizationExternalIdsByOrganizationNameIfStillPresent(table = '''| Propar - ${staticCompanyName} |
	| Provis - ${staticProjectName} |''');

		ZendeskOrganizationAPI._tearDownOrganizationsByExternalIdList(organizationExternalIds = ${staticOrganizationExternalIdList});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId1});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId2});
	}

	test Createflexproject {
		OSBAdminRabbitMQ.generateStaticVariables();

		OSBAdminRabbitMQ.generateProvisioningCompanyName();

		OSBAdminRabbitMQ.generateProvisioningProjectName();

		OSBAdmin.loginToSupport(
			userEmailAddress = ${staticSupportAdminEmailAdress},
			userPassword = ${staticSupportAdminPassword});

		OSBAdminRabbitMQ.publishCreatePartnerAccountMessage(
			routingKey = "dossiera.provisioning.create",
			table = '''| Account Name                           | Propar - ${staticCompanyName}              |
	| Address City                           | Diamond Bar                                |
	| Address Country                        | United States                              |
	| Address Postal Code                    | 91765                                      |
	| Address Region                         | California                                 |
	| Address Street                         | 456 Fake Street                            |
	| Dossiera Account Key                   | abcdefgh1234567890                         |
	| Dossiera Address Key 1                 | ${staticDossieraAddressKey1}               |
	| End Day                                | ${staticEndDay}                            |
	| End Month                              | ${staticEndMonth}                          |
	| End Year                               | ${staticEndYear}                           |
	| Industry                               | Professional Services (Technical/Web/IT)   |
	| Owner Email Address                    | usr.provisioning1@lrcustomer.com.broken    |
	| Owner First Name                       | USR                                        |
	| Owner Last Name                        | Provisioning1                              |
	| Partner First Line Support             | false                                      |
	| Product Name                           | Service Partnership                        |
	| Product Type                           | New                                        |
	| Renewal                                | false                                      |
	| Salesforce Opportunity Key             | 000000a1b2c3d4e5f6e7f                      |
	| Salesforce Opportunity Line Item Key 1 | ${staticSalesforceOpportunityLineItemKey1} |
	| Salesforce Opportunity Sold By         | Liferay US                                 |
	| Salesforce Opportunity Stage Name      | Closed Won                                 |
	| Salesforce Opportunity Territory       | United States                              |
	| Salesforce Opportunity Type            | New Business                               |
	| Salesforce Owner User Key              | ${staticSalesforceOwnerUserKey}            |
	| Start Day                              | ${staticStartDay}                          |
	| Start Month                            | ${staticStartMonth}                        |
	| Start Year                             | ${staticStartYear}                         |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Partner");

		OSBAdminRabbitMQ.publishCreateProjectMessage(
			routingKey = "dossiera.provisioning.create",
			table = '''| Account Name                           | Vispro - ${staticCompanyName}              |
	| Address City                           | Diamond Bar                                |
	| Address Country                        | United States                              |
	| Address Postal Code                    | 91765                                      |
	| Address Region                         | California                                 |
	| Address Street                         | 456 Fake Street                            |
	| Contact Email Address                  | usr.provisioning1@lrcustomer.com.broken    |
	| Contact First Name                     | USR                                        |
	| Contact Last Name                      | Provisioning1                              |
	| Dossiera Account Key                   | ${staticDossieraAccountKey}                |
	| Dossiera Address Key 1                 | ${staticDossieraAddressKey1}               |
	| Dossiera Address Key 2                 | ${staticDossieraAddressKey2}               |
	| Dossiera Contact Key                   | ${staticDossieraContactKey}                |
	| Dossiera Project Key                   | ${staticDossieraProjectKey}                |
	| End Day                                | ${staticEndDay}                            |
	| End Month                              | ${staticEndMonth}                          |
	| End Year                               | ${staticEndYear}                           |
	| Industry                               | Engineering                                |
	| Owner Email Address                    | usr.provisioning1@lrcustomer.com.broken    |
	| Owner First Name                       | USR                                        |
	| Owner Last Name                        | Provisioning1                              |
	| Partner First Line Support             | false                                      |
	| Partner Dossiera Key                   | abcdefgh1234567890                         |
	| Partner Name                           | Propar - ${staticCompanyName}              |
	| Partner Support Level                  | Platinum                                   |
	| Product Type                           | New                                        |
	| Product Name                           | Liferay Digital Enterprise - Flex Sizing 4 |
	| Project Name                           | Provis - ${staticProjectName}              |
	| Renewal                                | false                                      |
	| Salesforce Opportunity Key             | ${staticSalesforceOpportunityKey}          |
	| Salesforce Opportunity Line Item Key 1 | ${staticSalesforceOpportunityLineItemKey1} |
	| Salesforce Opportunity Line Item Key 2 | ${staticSalesforceOpportunityLineItemKey2} |
	| Salesforce Opportunity Sold By         | Liferay US                                 |
	| Salesforce Opportunity Stage Name      | Closed Won                                 |
	| Salesforce Opportunity Territory       | United States                              |
	| Salesforce Opportunity Type            | New Business                               |
	| Salesforce Owner User Key              | ${staticSalesforceOwnerUserKey}            |
	| Salesforce Project Key                 | ${staticSalesforceProjectKey}              |
	| Start Day                              | ${staticStartDay}                          |
	| Start Month                            | ${staticStartMonth}                        |
	| Start Year                             | ${staticStartYear}                         |
	| Subscription Level                     | Platinum                                   |
	| Version Number                         | 7.1                                        |''');

		OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		Provisioning.gotoAccounts();

		Provisioning.searchAccounts(keyword = "Provis");

		Provisioning.clickAccount(accountName = "Provis - ${staticProjectName}");

		ProvisioningAccount.clickSyncToZendeskButton();

		JSONOSBAccount.viewSupportOrganizationSync(accountCode = "VISPROPROVIS");

		OSBAdmin.gotoOSBAdmin();

		OSBAdminProject.view(
			projectName = "Provis - ${staticProjectName}",
			table = '''| Koroneiki Account Key | Obtain from project name      |
	| Project Name          | Provis - ${staticProjectName} |
	| Code                  | VISPROPROVIS                  |
	| Partner               | Propar - ${staticCompanyName} |
	| Addresses             | 456 Fake Street               |
	| Addresses             | United States                 |
	| Addresses             | California                    |
	| Addresses             | Diamond Bar                   |
	| Addresses             | 91765                         |
	| Addresses             | Primary                       |
	| Tier                  | T4                            |
	| Language              | English                       |''');

		KoroneikiProductPurchaseAPI._viewProductPurchase(
			accountName = "Provis - ${staticProjectName}",
			productName = "DXP Flex",
			table = '''| Quantity | 1        | |
	| Status   | Approved | |''');

		KoroneikiProductPurchaseAPI._viewProductPurchase(
			accountName = "Provis - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| Quantity | 1        | |
	| Status   | Approved | |''');

		KoroneikiAccountAPI._viewContactRole(
			accountName = "Provis - ${staticProjectName}",
			contactEmailAddress = "usr.provisioning1@lrcustomer.com.broken",
			contactRoleName = "Support Administrator");

		KoroneikiAccountAPI._viewContactRole(
			accountName = "Provis - ${staticProjectName}",
			contactEmailAddress = "usr.provisioning1@lrcustomer.com.broken",
			contactRoleName = "Liferay Sales");

		KoroneikiAccountAPI._viewContactRole(
			accountName = "Provis - ${staticProjectName}",
			contactEmailAddress = "usr.provisioning1@lrcustomer.com.broken",
			contactRoleName = "Secondary Contact");
	}

	test Createproject {
		property help.center.acceptance = "true";

		OSBAdminRabbitMQ.generateStaticVariables();

		OSBAdminRabbitMQ.generateProvisioningCompanyName();

		OSBAdminRabbitMQ.generateProvisioningProjectName();

		OSBAdmin.loginToSupport(
			userEmailAddress = ${staticSupportAdminEmailAdress},
			userPassword = ${staticSupportAdminPassword});

		OSBAdminRabbitMQ.publishCreatePartnerAccountMessage(
			routingKey = "dossiera.provisioning.create",
			table = '''| Account Name                           | Propar - ${staticCompanyName}              |
	| Address City                           | Diamond Bar                                |
	| Address Country                        | United States                              |
	| Address Postal Code                    | 91765                                      |
	| Address Region                         | California                                 |
	| Address Street                         | 456 Fake Street                            |
	| Dossiera Account Key                   | abcdefgh1234567890                         |
	| Dossiera Address Key 1                 | ${staticDossieraAddressKey1}               |
	| End Day                                | ${staticEndDay}                            |
	| End Month                              | ${staticEndMonth}                          |
	| End Year                               | ${staticEndYear}                           |
	| Industry                               | Professional Services (Technical/Web/IT)   |
	| Owner Email Address                    | usr.provisioning1@lrcustomer.com.broken    |
	| Owner First Name                       | USR                                        |
	| Owner Last Name                        | Provisioning1                              |
	| Partner First Line Support             | false                                      |
	| Product Name                           | Service Partnership                        |
	| Product Type                           | New                                        |
	| Renewal                                | false                                      |
	| Salesforce Opportunity Key             | 000000a1b2c3d4e5f6e7f                      |
	| Salesforce Opportunity Line Item Key 1 | ${staticSalesforceOpportunityLineItemKey1} |
	| Salesforce Opportunity Sold By         | Liferay US                                 |
	| Salesforce Opportunity Stage Name      | Closed Won                                 |
	| Salesforce Opportunity Territory       | United States                              |
	| Salesforce Opportunity Type            | New Business                               |
	| Salesforce Owner User Key              | ${staticSalesforceOwnerUserKey}            |
	| Start Day                              | ${staticStartDay}                          |
	| Start Month                            | ${staticStartMonth}                        |
	| Start Year                             | ${staticStartYear}                         |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Partner");

		OSBAdminRabbitMQ.publishCreateProjectMessage(
			routingKey = "dossiera.provisioning.create",
			table = '''| Account Name                           | Vispro - ${staticCompanyName}              |
	| Address City                           | Diamond Bar                                |
	| Address Country                        | United States                              |
	| Address Postal Code                    | 91765                                      |
	| Address Region                         | California                                 |
	| Address Street                         | 456 Fake Street                            |
	| Contact Email Address                  | usr.provisioning1@lrcustomer.com.broken    |
	| Contact First Name                     | USR                                        |
	| Contact Last Name                      | Provisioning1                              |
	| Dossiera Account Key                   | ${staticDossieraAccountKey}                |
	| Dossiera Address Key 1                 | ${staticDossieraAddressKey1}               |
	| Dossiera Address Key 2                 | ${staticDossieraAddressKey2}               |
	| Dossiera Contact Key                   | ${staticDossieraContactKey}                |
	| Dossiera Project Key                   | ${staticDossieraProjectKey}                |
	| End Day                                | ${staticEndDay}                            |
	| End Month                              | ${staticEndMonth}                          |
	| End Year                               | ${staticEndYear}                           |
	| Industry                               | Engineering                                |
	| Owner Email Address                    | usr.provisioning1@lrcustomer.com.broken    |
	| Owner First Name                       | USR                                        |
	| Owner Last Name                        | Provisioning1                              |
	| Partner First Line Support             | false                                      |
	| Partner Dossiera Key                   | abcdefgh1234567890                         |
	| Partner Name                           | Propar - ${staticCompanyName}              |
	| Partner Support Level                  | Platinum                                   |
	| Product Type                           | New                                        |
	| Product Name                           | Liferay Digital Enterprise - Prod Sizing 4 |
	| Project Name                           | Provis - ${staticProjectName}              |
	| Renewal                                | false                                      |
	| Salesforce Opportunity Key             | ${staticSalesforceOpportunityKey}          |
	| Salesforce Opportunity Line Item Key 1 | ${staticSalesforceOpportunityLineItemKey1} |
	| Salesforce Opportunity Line Item Key 2 | ${staticSalesforceOpportunityLineItemKey2} |
	| Salesforce Opportunity Sold By         | Liferay US                                 |
	| Salesforce Opportunity Stage Name      | Closed Won                                 |
	| Salesforce Opportunity Territory       | United States                              |
	| Salesforce Opportunity Type            | New Business                               |
	| Salesforce Owner User Key              | ${staticSalesforceOwnerUserKey}            |
	| Salesforce Project Key                 | ${staticSalesforceProjectKey}              |
	| Start Day                              | ${staticStartDay}                          |
	| Start Month                            | ${staticStartMonth}                        |
	| Start Year                             | ${staticStartYear}                         |
	| Subscription Level                     | Platinum                                   |
	| Version Number                         | 7.1                                        |''');

		OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		Provisioning.gotoAccounts();

		Provisioning.searchAccounts(keyword = "Provis");

		Provisioning.clickAccount(accountName = "Provis - ${staticProjectName}");

		ProvisioningAccount.clickSyncToZendeskButton();

		JSONOSBAccount.viewSupportOrganizationSync(accountCode = "VISPROPROVIS");

		OSBAdmin.gotoOSBAdmin();

		OSBAdminProject.view(
			projectName = "Provis - ${staticProjectName}",
			table = '''| Koroneiki Account Key | Obtain from project name      |
	| Project Name          | Provis - ${staticProjectName} |
	| Code                  | VISPROPROVIS                  |
	| Partner               | Propar - ${staticCompanyName} |
	| Addresses             | 456 Fake Street               |
	| Addresses             | United States                 |
	| Addresses             | California                    |
	| Addresses             | Diamond Bar                   |
	| Addresses             | 91765                         |
	| Addresses             | Primary                       |
	| Tier                  | T4                            |
	| Language              | English                       |''');

		KoroneikiProductPurchaseAPI._viewProductPurchase(
			accountName = "Provis - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| Quantity | 1        | |
	| Status   | Approved | |''');

		KoroneikiProductPurchaseAPI._viewProductPurchase(
			accountName = "Provis - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| Quantity | 1        | |
	| Status   | Approved | |''');

		KoroneikiAccountAPI._viewContactRole(
			accountName = "Provis - ${staticProjectName}",
			contactEmailAddress = "usr.provisioning1@lrcustomer.com.broken",
			contactRoleName = "Support Administrator");

		KoroneikiAccountAPI._viewContactRole(
			accountName = "Provis - ${staticProjectName}",
			contactEmailAddress = "usr.provisioning1@lrcustomer.com.broken",
			contactRoleName = "Liferay Sales");

		KoroneikiAccountAPI._viewContactRole(
			accountName = "Provis - ${staticProjectName}",
			contactEmailAddress = "usr.provisioning1@lrcustomer.com.broken",
			contactRoleName = "Secondary Contact");

		KoroneikiAccountAPI._viewTeamRole(
			accountName = "Provis - ${staticProjectName}",
			teamName = "Propar - ${staticCompanyName}",
			teamRoleName = "Partner");

		KoroneikiAccountAPI._viewNoTeamRole(
			accountName = "Provis - ${staticProjectName}",
			teamName = "Propar - ${staticCompanyName}",
			teamRoleName = "First Line Support");
	}

	test Createprojectwithanoktauserandviewviazendesk {
		OSBAdminRabbitMQ.generateStaticVariables();

		OSBAdminRabbitMQ.generateProvisioningCompanyName();

		OSBAdminRabbitMQ.generateProvisioningProjectName();

		OSBAdmin.loginToSupport(
			userEmailAddress = ${staticSupportAdminEmailAdress},
			userPassword = ${staticSupportAdminPassword});

		OSBAdminRabbitMQ.publishCreateProjectWithNoPartnerMessage(
			routingKey = "dossiera.provisioning.create",
			table = '''| Account Name                           | Vispro - ${staticCompanyName}              |
	| Address City                           | Diamond Bar                                |
	| Address Country                        | United States                              |
	| Address Postal Code                    | 91765                                      |
	| Address Region                         | California                                 |
	| Address Street                         | 456 Fake Street                            |
	| Contact Email Address                  | usr.provisioning1@lrcustomer.com.broken    |
	| Contact First Name                     | USR                                        |
	| Contact Last Name                      | Provisioning1                              |
	| Dossiera Account Key                   | ${staticDossieraAccountKey}                |
	| Dossiera Address Key 1                 | ${staticDossieraAddressKey1}               |
	| Dossiera Address Key 2                 | ${staticDossieraAddressKey2}               |
	| Dossiera Contact Key                   | ${staticDossieraContactKey}                |
	| Dossiera Project Key                   | ${staticDossieraProjectKey}                |
	| End Day                                | ${staticEndDay}                            |
	| End Month                              | ${staticEndMonth}                          |
	| End Year                               | ${staticEndYear}                           |
	| Industry                               | Engineering                                |
	| Owner Email Address                    | usr.provisioning1@lrcustomer.com.broken    |
	| Owner First Name                       | USR                                        |
	| Owner Last Name                        | Provisioning1                              |
	| Partner First Line Support             | false                                      |
	| Product Type                           | New                                        |
	| Product Name                           | Liferay Digital Enterprise - Prod Sizing 4 |
	| Project Name                           | Provis - ${staticProjectName}              |
	| Renewal                                | false                                      |
