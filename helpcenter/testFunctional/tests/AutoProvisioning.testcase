	| Salesforce Opportunity Line Item Key 1 | ${staticSalesforceOpportunityLineItemKey1} |
	| Salesforce Opportunity Line Item Key 2 | ${staticSalesforceOpportunityLineItemKey2} |
	| Salesforce Opportunity Sold By         | Liferay US                                 |
	| Salesforce Opportunity Stage Name      | Closed Won                                 |
	| Salesforce Opportunity Territory       | United States                              |
	| Salesforce Opportunity Type            | New Business                               |
	| Salesforce Owner User Key              | ${staticSalesforceOwnerUserKey}            |
	| Salesforce Project Key                 | ${staticSalesforceProjectKey}              |
	| Start Day                              | ${staticStartDay}                          |
	| Start Month                            | ${staticStartMonth}                        |
	| Start Year                             | ${staticStartYear}                         |
	| Subscription Level                     | Platinum                                   |
	| Version Number                         | 7.1                                        |''');

		OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		Provisioning.gotoAccounts();

		Provisioning.searchAccounts(keyword = "Provis");

		Provisioning.clickAccount(accountName = "Provis - ${staticProjectName}");

		ProvisioningAccount.clickSyncToZendeskButton();

		JSONOSBAccount.viewSupportOrganizationSync(accountCode = "VISPROPROVIS");

		OSBAdmin.gotoOSBAdmin();

		OSBAdminProject.view(
			projectName = "Provis - ${staticProjectName}",
			table = '''| Koroneiki Account Key | Obtain from project name      |
	| Project Name          | Provis - ${staticProjectName} |
	| Code                  | VISPROPROVIS                  |
	| Addresses             | 456 Fake Street               |
	| Addresses             | United States                 |
	| Addresses             | California                    |
	| Addresses             | Diamond Bar                   |
	| Addresses             | 91765                         |
	| Addresses             | Primary                       |
	| Tier                  | T4                            |
	| Language              | English                       |''');

		KoroneikiProductPurchaseAPI._viewProductPurchase(
			accountName = "Provis - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| Quantity | 1        | |
	| Status   | Approved | |''');

		KoroneikiProductPurchaseAPI._viewProductPurchase(
			accountName = "Provis - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| Quantity | 1        | |
	| Status   | Approved | |''');

		Provisioning.gotoUsers();

		Provisioning.searchUsers(keyword = "usr.provisioning1");

		Provisioning._viewUserViaIndex(
			table = '''| Name               | USR Provisioning1                       |
	| Email Address      | usr.provisioning1@lrcustomer.com.broken |
	| Number of Accounts | 1                                       |
	| Status             | VERIFIED                                |''',
			userName = "USR Provisioning1");

		Provisioning.clickUser(userName = "USR Provisioning1");

		ProvisioningUser._viewUserDetails(table = '''| Name               | USR Provisioning1                       |
	| Email Address      | usr.provisioning1@lrcustomer.com.broken |
	| Number of Accounts | 1                                       |
	| Status             | VERIFIED                                |''');

		JSONOkta.viewOktaUser(userEmailAddress = "usr.provisioning1@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserOrganizationIdSync(
			organizationName = "Provis - ${staticProjectName}",
			userEmailAddress = "usr.provisioning1@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserOrganizationIdSync(
			organizationName = "Provis - ${staticProjectName}",
			userEmailAddress = "usr.provisioning1@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserOrganizationSubscriptionSync(
			organizationName = "Provis - ${staticProjectName}",
			userEmailAddress = "usr.provisioning1@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserOrganizationSubscriptionSync(
			organizationName = "Provis - ${staticProjectName}",
			userEmailAddress = "usr.provisioning1@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserTagSync(
			tag = "osb_kb",
			userEmailAddress = "usr.provisioning1@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserTagSync(
			tag = "osb_customer",
			userEmailAddress = "usr.provisioning1@lrcustomer.com.broken");

		ZendeskUserAPI._matchOsbUserUuIdWithZendeskUserId(userEmailAddress = "usr.provisioning1@lrcustomer.com.broken");
	}

	test Createprojectwithanonoktauserandviewviazendesk {
		OSBAdminRabbitMQ.generateStaticVariables();

		OSBAdminRabbitMQ.generateProvisioningCompanyName();

		OSBAdminRabbitMQ.generateProvisioningProjectName();

		OSBAdmin.loginToSupport(
			userEmailAddress = ${staticSupportAdminEmailAdress},
			userPassword = ${staticSupportAdminPassword});

		OSBAdminRabbitMQ.publishCreateProjectWithNoPartnerMessage(
			routingKey = "dossiera.provisioning.create",
			table = '''| Account Name                           | Vispro - ${staticCompanyName}              |
