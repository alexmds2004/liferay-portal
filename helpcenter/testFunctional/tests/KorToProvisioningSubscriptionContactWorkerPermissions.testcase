definition {

	property testray.main.component.name = "Support QA";
	property type = "provisioning.security";

	setUp {
		Passwords.getPasswords();

		OSBAdminRabbitMQ.generateStaticVariables();

		OSBAdminRabbitMQ.generateProvisioningCompanyName();

		OSBAdminRabbitMQ.generateProvisioningProjectName();

		JSONUser.createViaProvisioning(table = '''| Screen Name   | provisioning.contact.worker                    |
	| Email Address | provisioning.contact.worker@liferay.com.broken |
	| First Name    | Provisioning                                   |
	| Last Name     | Contact Worker                                 |''');

		JSONUser.assignUserToProvisioningRole(
			roleName = "Provisioning Contact Worker",
			userEmailAddress = "provisioning.contact.worker@liferay.com.broken");

		JSONOkta.createOktaUser(table = '''| Screen Name   | prm.koroneiki1                       |
	| Email Address | prm.koroneiki1@lrcustomer.com.broken |
	| First Name    | PRM                                  |
	| Last Name     | Koroneiki1                           |''');

		JSONOkta.createOktaUser(table = '''| Screen Name   | prm.koroneiki2                       |
	| Email Address | prm.koroneiki2@lrcustomer.com.broken |
	| First Name    | PRM                                  |
	| Last Name     | Koroneiki2                           |''');
	}

	tearDown {
		ZendeskUserAPI._getDefaultUserId(organizationName = "Permis - ${staticProjectName}");

		ZendeskUserAPI._renameFirstDefaultUserIdVariable();

		ZendeskUserAPI._getDefaultUserId(organizationName = "Misper - ${staticCompanyName}");

		ZendeskUserAPI._renameSecondDefaultUserIdVariable();

		KoroneikiProductConsumptionAPI._tearDownProductConsumptions(
			accountName = "Permis - ${staticProjectName}",
			table = '''| DXP Production        |
	| Portal Production     |
	| Platinum Subscription |''');

		OSBAdminProject.tearDownProjects(table = '''| MISPERPERMIS |
	| MISPER       |''');

		KoroneikiAccountAPI._tearDownAccounts(table = '''| Permis - ${staticProjectName} |
	| Misper - ${staticCompanyName} |''');

		KoroneikiAccountAPI._tearDownAccountsViaAccountFieldNameAndValue(
			fieldName = "Code",
			table = '''| MISPERPERMIS |
	| MISPER       |''');

		JSONUser.tearDownUsersViaSupport(table = '''| prm.koroneiki1@lrcustomer.com.broken |
	| prm.koroneiki2@lrcustomer.com.broken |''');

		JSONUser.tearDownUsersViaKoroneiki(table = '''| prm.koroneiki1@lrcustomer.com.broken |
	| prm.koroneiki2@lrcustomer.com.broken |''');

		KoroneikiContactAPI._tearDownContacts(table = '''| prm.koroneiki1@lrcustomer.com.broken |
	| prm.koroneiki2@lrcustomer.com.broken |''');

		JSONOkta.tearDownUsers(table = '''| prm.koroneiki1@lrcustomer.com.broken |
	| prm.koroneiki2@lrcustomer.com.broken |''');

		ZendeskTicketAPI._tearDownTicketsByKeywords(table = '''| New Subscription(s) for Permis - ${staticProjectName} |
	| New Subscription(s) for Misper - ${staticCompanyName} |''');

		ZendeskUserAPI._getMultipleUserIdsByEmailAddress(table = '''| prm.koroneiki1@lrcustomer.com.broken |
	| prm.koroneiki2@lrcustomer.com.broken |''');

		ZendeskUserAPI._tearDownUsersByIdList(userIds = ${staticUserIdList});

		ZendeskOrganizationAPI._getMultipleOrganizationExternalIdsByOrganizationNameIfStillPresent(table = '''| Permis - ${staticProjectName} |
	| Misper - ${staticCompanyName} |''');

		ZendeskOrganizationAPI._tearDownOrganizationsByExternalIdList(organizationExternalIds = ${staticOrganizationExternalIdList});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId1});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId2});

		JSONUser.tearDownUsersViaProvisioning(table = '''| provisioning.contact.worker@liferay.com.broken |''');
	}

	test Viewcancelledsubscription {
		OSBAdminRabbitMQ.publishCreateProjectWithNoPartnerMessage(
			routingKey = "dossiera.provisioning.create",
			table = '''| Account Name                           | Misper - ${staticCompanyName}              |
	| Address City                           | Diamond Bar                                |
	| Address Country                        | United States                              |
	| Address Postal Code                    | 91765                                      |
	| Address Region                         | California                                 |
	| Address Street                         | 456 Fake Street                            |
	| Contact Email Address                  | prm.koroneiki1@lrcustomer.com.broken       |
	| Contact First Name                     | PRM                                        |
	| Contact Last Name                      | Koroneiki1                                 |
	| Dossiera Account Key                   | ${staticDossieraAccountKey}                |
	| Dossiera Address Key 1                 | ${staticDossieraAddressKey1}               |
	| Dossiera Address Key 2                 | ${staticDossieraAddressKey2}               |
	| Dossiera Contact Key                   | ${staticDossieraContactKey}                |
	| Dossiera Project Key                   | ${staticDossieraProjectKey}                |
	| End Day                                | ${staticEndDay}                            |
	| End Month                              | ${staticEndMonth}                          |
	| End Year                               | ${staticEndYear}                           |
	| Industry                               | Automotive                                 |
	| Owner Email Address                    | prm.koroneiki2@lrcustomer.com.broken       |
	| Owner First Name                       | PRM                                        |
	| Owner Last Name                        | Koroneiki2                                 |
	| Partner First Line Support             | false                                      |
	| Product Type                           | New                                        |
	| Product Name                           | Liferay Digital Enterprise - Prod Sizing 4 |
	| Project Name                           | Permis - ${staticProjectName}              |
	| Renewal                                | false                                      |
	| Salesforce Opportunity Key             | ${staticSalesforceOpportunityKey}          |
	| Salesforce Opportunity Line Item Key 1 | ${staticSalesforceOpportunityLineItemKey1} |
	| Salesforce Opportunity Line Item Key 2 | ${staticSalesforceOpportunityLineItemKey2} |
	| Salesforce Opportunity Sold By         | Liferay US                                 |
	| Salesforce Opportunity Stage Name      | Closed Won                                 |
	| Salesforce Opportunity Territory       | United States                              |
	| Salesforce Opportunity Type            | New Business                               |
	| Salesforce Owner User Key              | ${staticSalesforceOwnerUserKey}            |
	| Salesforce Project Key                 | ${staticSalesforceProjectKey}              |
	| Start Day                              | ${staticStartDay}                          |
	| Start Month                            | ${staticStartMonth}                        |
	| Start Year                             | ${staticStartYear}                         |
	| Subscription Level                     | Platinum                                   |
	| Version Number                         | 7.1                                        |''');

		KoroneikiAccountAPI._createAccountProductConsumption(
			accountName = "Permis - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| Product Purchase        | true            |                |
	| Product Field and Value | additionalProp1 | propertyValue1 |
	| Product Field and Value | additionalProp2 | propertyValue2 |
	| Product Field and Value | additionalProp3 | propertyValue3 |''');

		KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		KoroneikiProductPurchaseAPI.generateStaticFullStartAndEndDate();

		KoroneikiProductPurchaseAPI._updateProductPurchase(
			accountName = "Permis - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Cancelled                | |''');

		KoroneikiProductPurchaseAPI._updateProductPurchase(
			accountName = "Permis - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Cancelled                | |''');

		OSBAdmin.loginToProvisioning(
			userEmailAddress = "provisioning.contact.worker@liferay.com.broken",
			userPassword = ${staticProvisioningQaUserPassword});

		UserAccount.updatePasswordUponLogin(userPassword = "test");

		Provisioning.gotoAccounts();

		Provisioning.searchAccounts(keyword = "Permis");

		Provisioning.clickAccount(accountName = "Permis - ${staticProjectName}");

		ProvisioningAccount._viewNoAccountProduct(productName = "DXP Production");

		ProvisioningAccount._viewNoAccountProduct(productName = "Platinum Subscription");

		ProvisioningAccount.viewProductTabCount(
			countValue = 0,
			tabName = "Active");

		ProvisioningAccount.viewProductTabCount(
			countValue = 0,
			tabName = "Future");

		ProvisioningAccount.viewProductTabCount(
			countValue = 0,
			tabName = "Complimentary");

		ProvisioningAccount.viewProductTabCount(
			countValue = 0,
			tabName = "Expired");

		ProvisioningAccount.viewProductTabCount(
			countValue = 2,
			tabName = "Cancelled");

		ProvisioningAccount.viewProductTabCount(
			countValue = 2,
			tabName = "All");

		ProvisioningAccount.clickProductTab(tabName = "Cancelled");

		ProvisioningAccount._viewAccountProduct(
			productName = "DXP Production",
			table = '''| Name                | DXP Production        |
	| Current Provisioned | 1                     |
	| Latest Purchased    | 1                     |
	| State               | CANCELLED             |''');

		ProvisioningAccount._viewAccountProductUnderSection(
			productName = "DXP Production",
			productSection = "Primary");

		ProvisioningAccount._viewAccountProduct(
			productName = "Platinum Subscription",
			table = '''| Name                | Platinum Subscription |
	| Current Provisioned | 0                     |
	| Latest Purchased    | 1                     |
	| State               | CANCELLED             |''');

		ProvisioningAccount._viewAccountProductUnderSection(
			productName = "Platinum Subscription",
			productSection = "Regular");

		ProvisioningAccount.selectProductsViaSubscriptionsTab(table = '''| DXP Production        |
	| Platinum Subscription |''');

		ProvisioningAccount.viewNoEditSubscriptionsButton();

		ProvisioningAccount.viewNoSubscriptionsActionDropdownButton();

		ProvisioningAccount.clickProductTab(tabName = "All");

		ProvisioningAccount._viewAccountProduct(
			productName = "DXP Production",
			table = '''| Name               | DXP Production        |
	| Provisioned        | 1                     |
	| Approved Purchased | 0                     |
	| State              | CANCELLED             |''');

		ProvisioningAccount._viewAccountProductUnderSection(
			productName = "DXP Production",
			productSection = "Primary");

		ProvisioningAccount._viewAccountProduct(
			productName = "Platinum Subscription",
			table = '''| Name               | Platinum Subscription |
	| Provisioned        | 0                     |
	| Approved Purchased | 0                     |
	| State              | CANCELLED             |''');

		ProvisioningAccount._viewAccountProductUnderSection(
			productName = "Platinum Subscription",
			productSection = "Regular");

		ProvisioningAccount.selectProductsViaSubscriptionsTab(table = '''| DXP Production        |
	| Platinum Subscription |''');

		ProvisioningAccount.viewNoEditSubscriptionsButton();

		ProvisioningAccount.viewNoSubscriptionsActionDropdownButton();

		ProvisioningAccount.clickSubscriptionLink(productName = "DXP Production");

		ProvisioningSubscription._viewSubscriptionDetails(table = '''| Name         | DXP Production        |
	| State        | CANCELLED             |
	| Grace Period | -                     |''');

		ProvisioningSubscription._viewSubscriptionTerm(
			startDateEndDate = "${staticFullStartDate} - ${staticFullOriginalEndDate}",
			table = '''| Start - End Date           | ${staticFullStartDate} - ${staticFullOriginalEndDate} |
	| Grace Period               | ${staticFullOriginalEndDate} - ${staticFullEndDate}   |
	| Provisioned                | 1                                                     |
	| Purchased                  | 1                                                     |
	| Salesforce Opportunity Key | ${staticSalesforceOpportunityKey}                     |
	| State                      | CANCELLED                                             |''');

		ProvisioningSubscription.viewNoSubscriptionTermActionDropdownButton(startDateEndDate = "${staticFullStartDate} - ${staticFullOriginalEndDate}");

		Provisioning.gotoAccounts();

		Provisioning.searchAccounts(keyword = "Permis");

		Provisioning.clickAccount(accountName = "Permis - ${staticProjectName}");

		ProvisioningAccount.clickProductTab(tabName = "Cancelled");

		ProvisioningAccount.clickSubscriptionLink(productName = "Platinum Subscription");

		ProvisioningSubscription._viewSubscriptionDetails(table = '''| Name         | Platinum Subscription                               |
	| State        | CANCELLED                                           |
	| Grace Period | -                                                   |''');

		ProvisioningSubscription._viewSubscriptionTerm(
			startDateEndDate = "${staticFullStartDate} - ${staticFullOriginalEndDate}",
			table = '''| Start - End Date           | ${staticFullStartDate} - ${staticFullOriginalEndDate} |
	| Grace Period               | ${staticFullOriginalEndDate} - ${staticFullEndDate}   |
	| Provisioned                | 0                                                     |
	| Purchased                  | 1                                                     |
	| Salesforce Opportunity Key | ${staticSalesforceOpportunityKey}                     |
	| State                      | CANCELLED                                             |''');

		ProvisioningSubscription.viewNoSubscriptionTermActionDropdownButton(startDateEndDate = "${staticFullStartDate} - ${staticFullOriginalEndDate}");
	}

	test Viewcomplimentarysubscription {
		OSBAdminRabbitMQ.publishCreateProjectWithNoPartnerMessage(
			routingKey = "dossiera.provisioning.create",
			table = '''| Account Name                           | Misper - ${staticCompanyName}              |
	| Address City                           | Diamond Bar                                |
	| Address Country                        | United States                              |
	| Address Postal Code                    | 91765                                      |
	| Address Region                         | California                                 |
	| Address Street                         | 456 Fake Street                            |
	| Contact Email Address                  | prm.koroneiki1@lrcustomer.com.broken       |
	| Contact First Name                     | PRM                                        |
	| Contact Last Name                      | Koroneiki1                                 |
	| Dossiera Account Key                   | ${staticDossieraAccountKey}                |
	| Dossiera Address Key 1                 | ${staticDossieraAddressKey1}               |
	| Dossiera Address Key 2                 | ${staticDossieraAddressKey2}               |
	| Dossiera Contact Key                   | ${staticDossieraContactKey}                |
	| Dossiera Project Key                   | ${staticDossieraProjectKey}                |
	| End Day                                | ${staticEndDay}                            |
	| End Month                              | ${staticEndMonth}                          |
	| End Year                               | ${staticEndYear}                           |
	| Industry                               | Automotive                                 |
	| Owner Email Address                    | prm.koroneiki2@lrcustomer.com.broken       |
	| Owner First Name                       | PRM                                        |
	| Owner Last Name                        | Koroneiki2                                 |
	| Partner First Line Support             | false                                      |
	| Product Type                           | New                                        |
	| Product Name                           | Liferay Digital Enterprise - Prod Sizing 4 |
	| Project Name                           | Permis - ${staticProjectName}              |
	| Renewal                                | false                                      |
	| Salesforce Opportunity Key             | ${staticSalesforceOpportunityKey}          |
	| Salesforce Opportunity Line Item Key 1 | ${staticSalesforceOpportunityLineItemKey1} |
	| Salesforce Opportunity Line Item Key 2 | ${staticSalesforceOpportunityLineItemKey2} |
	| Salesforce Opportunity Sold By         | Liferay US                                 |
	| Salesforce Opportunity Stage Name      | Closed Won                                 |
	| Salesforce Opportunity Territory       | United States                              |
	| Salesforce Opportunity Type            | New Business                               |
	| Salesforce Owner User Key              | ${staticSalesforceOwnerUserKey}            |
	| Salesforce Project Key                 | ${staticSalesforceProjectKey}              |
	| Start Day                              | ${staticStartDay}                          |
	| Start Month                            | ${staticStartMonth}                        |
	| Start Year                             | ${staticStartYear}                         |
	| Subscription Level                     | Platinum                                   |
	| Version Number                         | 7.1                                        |''');

		KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		KoroneikiProductPurchaseAPI.generateStaticFullStartAndEndDate();

		KoroneikiProductPurchaseAPI.generateStaticYyyyMmDdStartAndEndDate();

		OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		Provisioning.gotoLicenses();

		Provisioning.gotoLicenses();

		Provisioning.clickGenerateLicenseButton();

		ProvisioningLicense.populateGenerateLicenseForm(table = '''| Account         | Select Entity | Permis - ${staticProjectName}    | |
	| Product         | Select        | Portal Production                | |
	| Version         | Select        | 6.2 EE                           | |
	| Type            | Select        | Portal Production                | |
	| Start Date      | Input         | ${staticYyyyMmDdStartDate}       | |
	| Expiration Date | Input         | ${staticYyyyMmDdOriginalEndDate} | |
	| Instance Size   | Select        | 1                                | |''');

		ProvisioningLicense.clickChooseProductPurchaseButton(positionValue = 1);

		ProvisioningLicense.populateGenerateLicenseForm(table = '''| Host Name     | Input    | localhost         | |
	| IP Addresses  | Textarea | 123.45.67.89      | |
	| MAC Addresses | Textarea | 0A-1B-2C-3D-4E-5F | |''');

		ProvisioningLicense.clickGenerateLicenseButton();

		ProvisioningLicense.viewLicense(table = '''| Header  | Permis - ${staticProjectName} | |
	| Product | Portal Production             | |''');

		OSBAdmin.logoutAndLoginToProvisioning(
			userEmailAddress = "provisioning.contact.worker@liferay.com.broken",
			userPassword = ${staticProvisioningQaUserPassword});

		UserAccount.updatePasswordUponLogin(userPassword = "test");

		Provisioning.gotoAccounts();

		Provisioning.searchAccounts(keyword = "Permis");

		Provisioning.clickAccount(accountName = "Permis - ${staticProjectName}");

		ProvisioningAccount._viewNoAccountProduct(productName = "Portal Production");

		ProvisioningAccount.viewProductTabCount(
			countValue = 2,
			tabName = "Active");

		ProvisioningAccount.viewProductTabCount(
			countValue = 0,
			tabName = "Future");

		ProvisioningAccount.viewProductTabCount(
			countValue = 1,
			tabName = "Complimentary");

		ProvisioningAccount.viewProductTabCount(
			countValue = 0,
			tabName = "Expired");

		ProvisioningAccount.viewProductTabCount(
			countValue = 0,
			tabName = "Cancelled");

		ProvisioningAccount.viewProductTabCount(
			countValue = 3,
			tabName = "All");

		ProvisioningAccount.clickProductTab(tabName = "Future");

		ProvisioningAccount._viewNoAccountProduct(productName = "Portal Production");

		ProvisioningAccount.clickProductTab(tabName = "Complimentary");

		ProvisioningAccount._viewAccountProduct(
			productName = "Portal Production",
			table = '''| Name                | Portal Production |
	| Current Provisioned | 1                 |''');

		ProvisioningAccount.selectProductsViaSubscriptionsTab(table = '''| Portal Production |''');

		ProvisioningAccount.viewNoEditSubscriptionsButton();

		ProvisioningAccount.viewNoSubscriptionsActionDropdownButton();

		ProvisioningAccount.clickProductTab(tabName = "Expired");

		ProvisioningAccount._viewNoAccountProduct(productName = "Portal Production");

		ProvisioningAccount.clickProductTab(tabName = "Cancelled");

		ProvisioningAccount._viewNoAccountProduct(productName = "Portal Production");

		ProvisioningAccount.clickProductTab(tabName = "All");

		ProvisioningAccount._viewAccountProduct(
			productName = "Portal Production",
			table = '''| Name        | Portal Production |
	| Provisioned | 1                 |''');

		ProvisioningAccount.selectProductsViaSubscriptionsTab(table = '''| Portal Production |''');

		ProvisioningAccount.viewNoEditSubscriptionsButton();

		ProvisioningAccount.viewNoSubscriptionsActionDropdownButton();
	}

	test Viewfuturesubscription {
		OSBAdminRabbitMQ.publishCreateProjectWithNoPartnerMessage(
			routingKey = "dossiera.provisioning.create",
			table = '''| Account Name                           | Misper - ${staticCompanyName}              |
	| Address City                           | Diamond Bar                                |
	| Address Country                        | United States                              |
	| Address Postal Code                    | 91765                                      |
	| Address Region                         | California                                 |
	| Address Street                         | 456 Fake Street                            |
	| Contact Email Address                  | prm.koroneiki1@lrcustomer.com.broken       |
	| Contact First Name                     | PRM                                        |
	| Contact Last Name                      | Koroneiki1                                 |
	| Dossiera Account Key                   | ${staticDossieraAccountKey}                |
	| Dossiera Address Key 1                 | ${staticDossieraAddressKey1}               |
	| Dossiera Address Key 2                 | ${staticDossieraAddressKey2}               |
	| Dossiera Contact Key                   | ${staticDossieraContactKey}                |
	| Dossiera Project Key                   | ${staticDossieraProjectKey}                |
	| End Day                                | ${staticEndDay}                            |
	| End Month                              | ${staticEndMonth}                          |
	| End Year                               | ${staticEndYear}                           |
	| Industry                               | Automotive                                 |
	| Owner Email Address                    | prm.koroneiki2@lrcustomer.com.broken       |
	| Owner First Name                       | PRM                                        |
	| Owner Last Name                        | Koroneiki2                                 |
	| Partner First Line Support             | false                                      |
	| Product Type                           | New                                        |
	| Product Name                           | Liferay Digital Enterprise - Prod Sizing 4 |
	| Project Name                           | Permis - ${staticProjectName}              |
	| Renewal                                | false                                      |
	| Salesforce Opportunity Key             | ${staticSalesforceOpportunityKey}          |
	| Salesforce Opportunity Line Item Key 1 | ${staticSalesforceOpportunityLineItemKey1} |
	| Salesforce Opportunity Line Item Key 2 | ${staticSalesforceOpportunityLineItemKey2} |
	| Salesforce Opportunity Sold By         | Liferay US                                 |
	| Salesforce Opportunity Stage Name      | Closed Won                                 |
	| Salesforce Opportunity Territory       | United States                              |
	| Salesforce Opportunity Type            | New Business                               |
	| Salesforce Owner User Key              | ${staticSalesforceOwnerUserKey}            |
	| Salesforce Project Key                 | ${staticSalesforceProjectKey}              |
	| Start Day                              | ${staticStartDay}                          |
	| Start Month                            | ${staticStartMonth}                        |
	| Start Year                             | ${staticStartYear}                         |
	| Subscription Level                     | Platinum                                   |
	| Version Number                         | 7.1                                        |''');

		KoroneikiProductPurchaseAPI.generateStaticFutureStartAndEndDate();

		KoroneikiProductPurchaseAPI.generateStaticFullFutureStartAndEndDate();

		KoroneikiProductPurchaseAPI._updateProductPurchase(
			accountName = "Permis - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| End Date                | ${staticFutureEndDate}         | |
	| Original End Date       | ${staticFutureOriginalEndDate} | |
	| Perpetual               | false                          | |
	| Start Date              | ${staticFutureStartDate}       | |
	| Status                  | Approved                       | |''');

		KoroneikiProductPurchaseAPI._updateProductPurchase(
			accountName = "Permis - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticFutureEndDate}         | |
	| Original End Date       | ${staticFutureOriginalEndDate} | |
	| Perpetual               | false                          | |
	| Start Date              | ${staticFutureStartDate}       | |
	| Status                  | Approved                       | |''');

		KoroneikiAccountAPI._createAccountProductConsumption(
			accountName = "Permis - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| Product Purchase        | true            |                |
	| Product Field and Value | additionalProp1 | propertyValue1 |
	| Product Field and Value | additionalProp2 | propertyValue2 |
	| Product Field and Value | additionalProp3 | propertyValue3 |''');

		OSBAdmin.loginToProvisioning(
			userEmailAddress = "provisioning.contact.worker@liferay.com.broken",
			userPassword = ${staticProvisioningQaUserPassword});

		UserAccount.updatePasswordUponLogin(userPassword = "test");

		Provisioning.gotoAccounts();

		Provisioning.searchAccounts(keyword = "Permis");

		Provisioning.clickAccount(accountName = "Permis - ${staticProjectName}");

		ProvisioningAccount._viewNoAccountProduct(productName = "DXP Production");

		ProvisioningAccount._viewNoAccountProduct(productName = "Platinum Subscription");

		ProvisioningAccount.viewProductTabCount(
			countValue = 0,
			tabName = "Active");

		ProvisioningAccount.viewProductTabCount(
			countValue = 2,
			tabName = "Future");

		ProvisioningAccount.viewProductTabCount(
			countValue = 0,
			tabName = "Complimentary");

		ProvisioningAccount.viewProductTabCount(
			countValue = 0,
			tabName = "Expired");

		ProvisioningAccount.viewProductTabCount(
			countValue = 0,
			tabName = "Cancelled");

		ProvisioningAccount.viewProductTabCount(
			countValue = 2,
			tabName = "All");

		ProvisioningAccount.clickProductTab(tabName = "Future");

		ProvisioningAccount._viewAccountProduct(
			productName = "DXP Production",
			table = '''| Name                  | DXP Production                                                    |
	| Support Life          | ${staticFullFutureStartDate} - ${staticFullFutureOriginalEndDate} |
	| Grace Period End Date | ${staticFullFutureEndDate}                                        |
	| Current Provisioned   | 1                                                                 |
	| Latest Purchased      | 1                                                                 |
	| State                 | FUTURE                                                            |''');

		ProvisioningAccount._viewAccountProductUnderSection(
			productName = "DXP Production",
			productSection = "Primary");

		ProvisioningAccount._viewAccountProduct(
			productName = "Platinum Subscription",
			table = '''| Name                  | Platinum Subscription                                             |
	| Support Life          | ${staticFullFutureStartDate} - ${staticFullFutureOriginalEndDate} |
	| Grace Period End Date | ${staticFullFutureEndDate}                                        |
	| Current Provisioned   | 0                                                                 |
	| Latest Purchased      | 1                                                                 |
	| State                 | FUTURE                                                            |''');

		ProvisioningAccount._viewAccountProductUnderSection(
			productName = "Platinum Subscription",
			productSection = "Regular");

		ProvisioningAccount.selectProductsViaSubscriptionsTab(table = '''| DXP Production        |
	| Platinum Subscription |''');

		ProvisioningAccount.viewNoEditSubscriptionsButton();

		ProvisioningAccount.viewNoSubscriptionsActionDropdownButton();

		ProvisioningAccount.clickProductTab(tabName = "Complimentary");

		ProvisioningAccount._viewNoAccountProduct(productName = "DXP Production");

		ProvisioningAccount._viewNoAccountProduct(productName = "Platinum Subscription");

