definition {

	property testray.main.component.name = "Support QA";
	property type = "zendesk.api";

	test AssignHUPlatCriticalFLStickettoPlatinumCriticalCN {
		ZendeskTriggerAPI._viewTriggerPropertiesUnderAllConditions(
			table = '''| Update Type       | Is           | Change                      |
	| SLA               | Is           | Platinum                    |
	| Priority          | Greater than | Normal                      |
	| Group             | Is           |                             |
	| Support Region    | Is           | Hungary                     |
	| Current Tags      | Includes     | p1                          |
	| Current Tags      | Includes     | jira_escalated              |
	| Product           | Is not       | prd_liferay_analytics_cloud |
	| Product           | Is not       | prd_lxc_sm                  |
	| Within (schedule) | Is           | CN - Schedule               |''',
			triggerName = "Assign HU Plat Critical FLS ticket to Platinum Critical - CN");

		ZendeskTriggerAPI._viewNumberOfTriggerProperties(
			numberOfConditions = 10,
			triggerName = "Assign HU Plat Critical FLS ticket to Platinum Critical - CN");

		ZendeskTriggerAPI._viewTriggerAssignmentAction(
			entityName = "CSE - CN - Platinum Critical",
			entityType = "group",
			triggerName = "Assign HU Plat Critical FLS ticket to Platinum Critical - CN");
	}

