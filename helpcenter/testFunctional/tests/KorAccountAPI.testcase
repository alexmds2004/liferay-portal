	test Createandviewaccountexternallink {
		LocalFile.KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORAUTO                                  | |
	| Contact Email Address | koroneiki.contact1@lrcustomer.com.broken | |
	| Description           | Test automotive account on koroneiki     | |
	| Fax Number            | 555-555-1234                             | |
	| Name                  | Koroneiki Automotive                     | |
	| Phone Number          | 555-555-5678                             | |
	| Profile Email Address | koroneiki.contact1@lrcustomer.com.broken | |
	| Region                | United States                            | |
	| Status                | Active                                   | |
	| Tier                  | T4                                       | |
	| Website               | www.koroneikiautomotive.com              | |''');

		LocalFile.KoroneikiAccountAPI._createAccountExternalLink(
			accountName = "Koroneiki Automotive",
			table = '''| Domain      | koroneikiautomotive |
	| Entity Id   | 1234                |
	| Entity Name | KoroneikiAutomotive |''');

		LocalFile.KoroneikiAccountAPI._viewAccountExternalLink(
			accountName = "Koroneiki Automotive",
			entityId = 1234,
			table = '''| Domain      | koroneikiautomotive |
	| Entity Id   | 1234                |
	| Entity Name | KoroneikiAutomotive |''');

		LocalFile.KoroneikiAccountAPI._viewAccountExternalLinkViaExternalLinkKey(
			accountName = "Koroneiki Automotive",
			entityId = 1234,
			table = '''| Domain      | koroneikiautomotive |
	| Entity Id   | 1234                |
	| Entity Name | KoroneikiAutomotive |''');

		LocalFile.KoroneikiAccountAPI._viewAccount(
			accountName = "Koroneiki Automotive",
			table = '''| Code                       | KORAUTO                                  | |
	| Contact Email Address      | koroneiki.contact1@lrcustomer.com.broken | |
	| Description                | Test automotive account on koroneiki     | |
	| External Link Nested Field | koroneikiautomotive                      | |
	| Fax Number                 | 555-555-1234                             | |
	| Name                       | Koroneiki Automotive                     | |
	| Phone Number               | 555-555-5678                             | |
	| Profile Email Address      | koroneiki.contact1@lrcustomer.com.broken | |
	| Region                     | United States                            | |
	| Status                     | Active                                   | |
	| Tier                       | T4                                       | |
	| Website                    | www.koroneikiautomotive.com              | |''');

		LocalFile.KoroneikiAccountAPI._viewAccountViaExternalLink(
			accountName = "Koroneiki Automotive",
			domain = "koroneikiautomotive",
			entityId = 1234,
			entityName = "KoroneikiAutomotive",
			table = '''| Code                  | KORAUTO                                  | |
	| Contact Email Address | koroneiki.contact1@lrcustomer.com.broken | |
	| Description           | Test automotive account on koroneiki     | |
	| Fax Number            | 555-555-1234                             | |
	| Name                  | Koroneiki Automotive                     | |
	| Phone Number          | 555-555-5678                             | |
	| Profile Email Address | koroneiki.contact1@lrcustomer.com.broken | |
	| Region                | United States                            | |
	| Status                | Active                                   | |
	| Tier                  | T4                                       | |
	| Website               | www.koroneikiautomotive.com              | |''');
	}

	test Createandviewaccountswithduplicatenames {
		LocalFile.KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORAUTO1                                 | |
	| Contact Email Address | koroneiki.contact1@lrcustomer.com.broken | |
