	| Profile Email Address | koroneiki.contact1@lrcustomer.com.broken | |
	| Region                | United States                            | |
	| Status                | Active                                   | |
	| Tier                  | T4                                       | |
	| Website               | www.koroneikiautomotiveone.com           | |''');

		LocalFile.KoroneikiAccountAPI._viewAccountViaAccountFieldNameAndValue(
			fieldName = "Code",
			fieldValue = "KORAUTO2",
			table = '''| Code                  | KORAUTO2                                 | |
	| Contact Email Address | koroneiki.contact2@lrcustomer.com.broken | |
	| Description           | Test automotive account two on koroneiki | |
	| Fax Number            | 555-555-9012                             | |
	| Name                  | Koroneiki Clone Automotive               | |
	| Phone Number          | 555-555-3456                             | |
	| Profile Email Address | koroneiki.contact2@lrcustomer.com.broken | |
	| Region                | Japan                                    | |
	| Status                | Active                                   | |
	| Tier                  | T1                                       | |
	| Website               | www.koroneikiautomotivetwo.com           | |''');

		LocalFile.KoroneikiAccountAPI._viewAccountTeamViaFieldViaAccountFieldNameAndValue(
			fieldName = "Code",
			fieldValue = "KORAUTO1",
			teamName = "Koroneiki Clone Automotive");

		LocalFile.KoroneikiAccountAPI._viewAccountTeamViaFieldViaAccountFieldNameAndValue(
			fieldName = "Code",
			fieldValue = "KORAUTO2",
			teamName = "Koroneiki Clone Automotive");
	}

	test Createandviewaccountwithproperties {
