definition {

	property testray.main.component.name = "Support QA";
	property type = "koroneiki";

	tearDown {
		LocalFile.KoroneikiContactAPI._tearDownContactEntitlementDefinitions(table = '''| Entitlement Name  |
	| Entitlement Name1 |
	| Entitlement Name2 |''');

		LocalFile.KoroneikiAccountAPI._tearDownAccounts(table = '''| Koroneiki Automotive  |
	| Koroneiki Engineering |''');

		LocalFile.KoroneikiContactAPI._tearDownContacts(table = '''| koroneiki.contact1@lrcustomer.com.broken |
	| koroneiki.contact2@lrcustomer.com.broken |''');

		LocalFile.KoroneikiContactRoleAPI._tearDownContactRoles(table = '''| Default Account Customer Role  |
	| Optional Account Customer Role |''');

		LocalFile.KoroneikiProductAPI._tearDownProducts(table = '''| Liferay Digital Experience Platform |
	| Liferay Portal Six                  |''');
	}

	test Createcontactentitlement {
		LocalFile.KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORAUTO                              | |
	| Description           | Test automotive account on koroneiki | |
	| Fax Number            | 555-555-1234                         | |
	| Name                  | Koroneiki Automotive                 | |
	| Phone Number          | 555-555-5678                         | |
	| Region                | United States                        | |
	| Status                | Active                               | |
	| Tier                  | T4                                   | |
	| Website               | www.koroneikiautomotive.com          | |''');

		LocalFile.KoroneikiContactAPI._createContact(table = '''| Email Address | koroneiki.contact1@lrcustomer.com.broken |
	| First Name    | Koroneiki                                |
	| Language      | English                                  |
	| Last Name     | Contact1                                 |
	| Middle Name   | User                                     |''');

		LocalFile.KoroneikiContactRoleAPI._createContactRole(table = '''| Description | This is the default customer role for accounts |
	| Name        | Default Account Customer Role                  |
	| Type        | Account Customer                               |''');

		LocalFile.KoroneikiAccountAPI._assignCustomerContacts(
			accountName = "Koroneiki Automotive",
			table = '''| koroneiki.contact1@lrcustomer.com.broken |''');

		LocalFile.KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Koroneiki Automotive",
			contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken",
			table = '''| Default Account Customer Role |''');

		LocalFile.KoroneikiProductAPI._createProduct(table = '''| Name | Liferay Digital Experience Platform | |''');

		LocalFile.KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		LocalFile.KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Koroneiki Automotive",
			productName = "Liferay Digital Experience Platform",
			table = '''| End Date                | ${staticEndDate}   |                |
	| Perpetual               | true               |                |
	| Product Field and Value | additionalProp1    | propertyValue1 |
	| Product Field and Value | additionalProp2    | propertyValue2 |
	| Product Field and Value | additionalProp3    | propertyValue3 |
	| Quantity                | 1                  |                |
	| Start Date              | ${staticStartDate} |                |''');

		LocalFile.KoroneikiContactAPI._createContactEntitlementDefinition(
			contactRoleName = "Default Account Customer Role",
			contactRoleType = "Account Customer",
			productName = "Liferay Digital Experience Platform",
			table = '''| Description | Entitlement Description |
	| Name        | Entitlement Name        |
	| Status      | Approved                |''');

		LocalFile.KoroneikiContactAPI._viewContactEntitlementDefinition(
			entitlementDefinitionName = "Entitlement Name",
			table = '''| Description | Entitlement Description |
	| Name        | Entitlement Name        |
	| Status      | Approved                |''');

		LocalFile.KoroneikiContactAPI._viewContactEntitlementDefinitionViaEntitlementDefinitionKey(
			entitlementDefinitionName = "Entitlement Name",
			table = '''| Description | Entitlement Description |
	| Name        | Entitlement Name        |
	| Status      | Approved                |''');

		LocalFile.KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Entitlement Name");

		LocalFile.KoroneikiContactAPI._viewContactViaEmailAddress(
			contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken",
			table = '''| Email Address            | koroneiki.contact1@lrcustomer.com.broken |
	| Entitlement Nested Field | Entitlement Name                         |
	| First Name               | Koroneiki                                |
	| Language                 | English                                  |
	| Last Name                | Contact1                                 |
	| Middle Name              | User                                     |''');

		LocalFile.KoroneikiContactAPI._viewContactEntitlementViaNestedField(
			contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken",
			entitlementDefinitionName = "Entitlement Name");
	}

