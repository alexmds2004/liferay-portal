definition {

	property testray.main.component.name = "Support QA";
	property type = "provisioning.integration";

	setUp {
		Passwords.getPasswords();

		OSBAdminRabbitMQ.generateProvisioningCompanyName();

		OSBAdminRabbitMQ.generateProvisioningProjectName();

		Data.generateSupportUser();

		Data._renameFirstSupportUserVariables();

		JSONOkta.createOktaUser(table = '''| Screen Name   | ${staticScreenNameValue1}       |
	| Email Address | ${staticEmailValue1}            |
	| First Name    | ${staticContactFirstNameValue1} |
	| Last Name     | ${staticContactLastNameValue1}  |
	| Group         | Employees                       |''');

		Data.generateSupportUser();

		Data._renameSecondSupportUserVariables();

		JSONOkta.createOktaUser(table = '''| Screen Name   | ${staticScreenNameValue2}       |
	| Email Address | ${staticEmailValue2}            |
	| First Name    | ${staticContactFirstNameValue2} |
	| Last Name     | ${staticContactLastNameValue2}  |
	| Group         | Employees                       |''');
	}

	tearDown {
		ZendeskUserAPI._getDefaultUserId(organizationName = "Korpro - ${staticProjectName}");

		ZendeskUserAPI._renameFirstDefaultUserIdVariable();

		ZendeskUserAPI._getDefaultUserId(organizationName = "Prokor - ${staticCompanyName}");

		ZendeskUserAPI._renameSecondDefaultUserIdVariable();

		JSONUser.tearDownUsersViaSupport(table = '''| ${staticEmailValue1} |
	| ${staticEmailValue2} |''');

		KoroneikiContactAPI._tearDownContacts(table = '''| ${staticEmailValue1} |
	| ${staticEmailValue2} |''');

		JSONOkta.tearDownUsers(table = '''| ${staticEmailValue1} |
	| ${staticEmailValue2} |''');

		KoroneikiTeamAPI._tearDownTeams(table = '''| Koroneiki Partner |
	| Updated Partner   |''');

		OSBAdminProject.tearDownProjects(table = '''| PROKORKORPRO |
	| PROKOR       |''');

		KoroneikiAccountAPI._tearDownAccounts(table = '''| Korpro - ${staticProjectName} |
	| Prokor - ${staticCompanyName} |''');

		KoroneikiAccountAPI._tearDownAccountsViaAccountFieldNameAndValue(
			fieldName = "Code",
			table = '''| PROKORKORPRO |
	| PROKOR       |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Gold Subscription");

		ZendeskTicketAPI._tearDownTicketsByKeywords(table = '''| New Subscription(s) for Korpro - ${staticProjectName} |
	| New Subscription(s) for Prokor - ${staticCompanyName} |''');

		ZendeskUserAPI._getMultipleUserIdsByEmailAddress(table = '''| ${staticEmailValue1} |
	| ${staticEmailValue2} |''');

		ZendeskUserAPI._tearDownUsersByIdList(userIds = ${staticUserIdList});

		ZendeskOrganizationAPI._getMultipleOrganizationExternalIdsByOrganizationNameIfStillPresent(table = '''| Korpro - ${staticProjectName} |
	| Prokor - ${staticCompanyName} |''');

		ZendeskOrganizationAPI._tearDownOrganizationsByExternalIdList(organizationExternalIds = ${staticOrganizationExternalIdList});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId1});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId2});
	}

	test DeactivateLiferayemployee {
		KoroneikiContactAPI._viewContactSyncViaEmailAddress(contactEmailAddress = ${staticEmailValue1});

		KoroneikiContactAPI._viewAccountSyncViaUuid(
			accountName = "Liferay, Inc.",
			contactEmailAddress = ${staticEmailValue1});

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - DXP");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - Portal");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - Commerce");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Liferay Employee");

		JSONOkta.deactivateOktaUser(userEmailAddress = ${staticEmailValue1});

		KoroneikiContactAPI._viewNoAccountSyncViaUuid(
			accountName = "Liferay, Inc.",
			contactEmailAddress = ${staticEmailValue1});

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - DXP");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - Portal");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - Commerce");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Liferay Employee");

		OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		Provisioning.gotoAccounts();

		Provisioning.searchAccounts(keyword = "Liferay,");

		Provisioning.clickAccount(accountName = "Liferay, Inc.");

		Provisioning.clickTab(tabName = "Contacts");

		ProvisioningAccount.searchAndFilter(table = '''| Keyword | ${staticEmailValue1} |''');

		ProvisioningAccount._viewNoAccountContact(emailAddress = ${staticEmailValue1});

		Provisioning.gotoUsers();

		Provisioning.searchUsers(keyword = ${staticScreenNameValue1});

		Provisioning._viewUserViaIndex(
			table = '''| Name               | ${staticContactFirstNameValue1} ${staticContactLastNameValue1} |
	| Email Address      | ${staticEmailValue1}                                           |
	| Entitlements       |                                                                |
	| Number of Accounts | 0                                                              |
	| Status             | VERIFIED                                                       |''',
			userName = "${staticContactFirstNameValue1} ${staticContactLastNameValue1}");
	}

	test RemoveLiferayemployee {
		property help.center.acceptance = "true";

		KoroneikiContactAPI._viewContactSyncViaEmailAddress(contactEmailAddress = ${staticEmailValue1});

		KoroneikiContactAPI._viewAccountSyncViaUuid(
			accountName = "Liferay, Inc.",
			contactEmailAddress = ${staticEmailValue1});

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - DXP");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - Portal");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - Commerce");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Liferay Employee");

		JSONOkta.removeUserFromOktaGroup(
			groupName = "Employees",
			userEmailAddress = ${staticEmailValue1});

		KoroneikiContactAPI._viewNoAccountSyncViaUuid(
			accountName = "Liferay, Inc.",
			contactEmailAddress = ${staticEmailValue1});

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - DXP");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - Portal");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - Commerce");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Liferay Employee");

		OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		Provisioning.gotoAccounts();

		Provisioning.searchAccounts(keyword = "Liferay,");

		Provisioning.clickAccount(accountName = "Liferay, Inc.");

		Provisioning.clickTab(tabName = "Contacts");

		ProvisioningAccount.searchAndFilter(table = '''| Keyword | ${staticEmailValue1} |''');

		ProvisioningAccount._viewNoAccountContact(emailAddress = ${staticEmailValue1});

		Provisioning.gotoUsers();

		Provisioning.searchUsers(keyword = ${staticScreenNameValue1});

		Provisioning._viewUserViaIndex(
			table = '''| Name               | ${staticContactFirstNameValue1} ${staticContactLastNameValue1} |
	| Email Address      | ${staticEmailValue1}                                           |
	| Entitlements       |                                                                |
	| Number of Accounts | 0                                                              |
	| Status             | VERIFIED                                                       |''',
			userName = "${staticContactFirstNameValue1} ${staticContactLastNameValue1}");
	}

	test ViewemployeeaddedasaSupportRequestertoaProfessionalServicesManagedServicesaccount {
		KoroneikiContactAPI._viewContactSyncViaEmailAddress(contactEmailAddress = ${staticEmailValue1});

		KoroneikiContactAPI._viewContactSyncViaEmailAddress(contactEmailAddress = ${staticEmailValue2});

		KoroneikiContactAPI._viewAccountSyncViaUuid(
			accountName = "Liferay, Inc.",
			contactEmailAddress = ${staticEmailValue1});

		KoroneikiContactAPI._viewAccountSyncViaUuid(
			accountName = "Liferay, Inc.",
			contactEmailAddress = ${staticEmailValue2});

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - DXP");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - Portal");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - Commerce");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Liferay Employee");

		OSBAdminRabbitMQ.generateStaticVariables();

		OSBAdminRabbitMQ.publishCreateProjectWithNoPartnerMessage(
			routingKey = "dossiera.provisioning.create",
			table = '''| Account Name                           | Prokor - ${staticCompanyName}              |
	| Address City                           | Diamond Bar                                |
	| Address Country                        | United States                              |
	| Address Postal Code                    | 91765                                      |
	| Address Region                         | California                                 |
	| Address Street                         | 456 Fake Street                            |
	| Contact Email Address                  | ${staticEmailValue1}                       |
	| Contact First Name                     | ${staticContactFirstNameValue1}            |
	| Contact Last Name                      | ${staticContactLastNameValue1}             |
	| Dossiera Account Key                   | ${staticDossieraAccountKey}                |
	| Dossiera Address Key 1                 | ${staticDossieraAddressKey1}               |
	| Dossiera Address Key 2                 | ${staticDossieraAddressKey2}               |
	| Dossiera Contact Key                   | ${staticDossieraContactKey}                |
	| Dossiera Project Key                   | ${staticDossieraProjectKey}                |
	| End Day                                | ${staticEndDay}                            |
	| End Month                              | ${staticEndMonth}                          |
	| End Year                               | ${staticEndYear}                           |
	| Industry                               | Automotive                                 |
	| Owner Email Address                    | ${staticEmailValue2}                       |
	| Owner First Name                       | ${staticContactFirstNameValue2}            |
	| Owner Last Name                        | ${staticContactLastNameValue2}             |
	| Partner First Line Support             | false                                      |
	| Product Type                           | New                                        |
	| Product Name                           | Professional Services- Managed Services    |
	| Project Name                           | Korpro - ${staticProjectName}              |
	| Renewal                                | false                                      |
	| Salesforce Opportunity Key             | ${staticSalesforceOpportunityKey}          |
	| Salesforce Opportunity Line Item Key 1 | ${staticSalesforceOpportunityLineItemKey1} |
	| Salesforce Opportunity Line Item Key 2 | ${staticSalesforceOpportunityLineItemKey2} |
	| Salesforce Opportunity Sold By         | Liferay US                                 |
	| Salesforce Opportunity Stage Name      | Closed Won                                 |
	| Salesforce Opportunity Territory       | United States                              |
	| Salesforce Opportunity Type            | New Business                               |
	| Salesforce Owner User Key              | ${staticSalesforceOwnerUserKey}            |
	| Salesforce Project Key                 | ${staticSalesforceProjectKey}              |
	| Start Day                              | ${staticStartDay}                          |
	| Start Month                            | ${staticStartMonth}                        |
	| Start Year                             | ${staticStartYear}                         |
	| Subscription Level                     | Platinum                                   |
	| Version Number                         | 7.1                                        |''');

		KoroneikiAccountAPI._createAccountTeam(
			accountName = "Korpro - ${staticProjectName}",
			teamName = "Koroneiki Partner");

		KoroneikiAccountAPI._assignTeamRolesToTeam(
			accountName = "Korpro - ${staticProjectName}",
			table = '''| First Line Support |''',
			teamName = "Koroneiki Partner");

		OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		Provisioning.gotoAccounts();

		Provisioning.searchAccounts(keyword = "Korpro");

		Provisioning.clickAccount(accountName = "Korpro - ${staticProjectName}");

		ProvisioningAccount._viewAccountDetails(table = '''| Name           | Korpro - ${staticProjectName} |
	| Code           | PROKORKORPRO                  |
	| State          | ACTIVE                        |
	| Support Region | United States                 |
	| Country        | United States                 |
	| SLA            | Platinum                      |
	| Support Seats  | 0 / 10 Filled                 |
	| Tier           | T4                            |
	| FLS Partner    | Koroneiki Partner             |''');

		Provisioning.clickTab(tabName = "Contacts");

		ProvisioningAccount.searchAndFilter(table = '''| Keyword | ${staticEmailValue1} |''');

		ProvisioningAccount._viewAccountContact(
			emailAddress = ${staticEmailValue1},
			table = '''| Name          | ${staticContactFirstNameValue1} ${staticContactLastNameValue1} |
	| Email Address | ${staticEmailValue1}                                           |
	| Role          | Support Requester                                              |
	| Role          | Support Administrator                                          |
	| User Status   | VERIFIED                                                       |''');

		Provisioning.gotoUsers();

		Provisioning.searchUsers(keyword = ${staticScreenNameValue1});

		Provisioning._viewUserViaIndex(
			table = '''| Name               | ${staticContactFirstNameValue1} ${staticContactLastNameValue1}                     |
	| Email Address      | ${staticEmailValue1}                                                               |
	| Entitlements       | Customer, Customer - Commerce, Customer - DXP, Customer - Portal, Liferay Employee |
	| Number of Accounts | 2                                                                                  |
	| Status             | VERIFIED                                                                           |''',
			userName = "${staticContactFirstNameValue1} ${staticContactLastNameValue1}");

		KoroneikiProductPurchaseAPI._viewProductPurchase(
			accountName = "Korpro - ${staticProjectName}",
			productName = "Professional Services - Managed Services",
			table = '''| Quantity | 1        | |
	| Status   | Approved | |''');

		KoroneikiProductPurchaseAPI._viewProductPurchase(
			accountName = "Korpro - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| Quantity | 1        | |
	| Status   | Approved | |''');
	}

	test ViewLiferayemployee {
		property help.center.acceptance = "true";

		KoroneikiContactAPI._viewContactSyncViaEmailAddress(contactEmailAddress = ${staticEmailValue1});

		KoroneikiContactAPI._viewAccountSyncViaUuid(
			accountName = "Liferay, Inc.",
			contactEmailAddress = ${staticEmailValue1});

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - DXP");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - Portal");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - Commerce");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Liferay Employee");

		OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		Provisioning.gotoAccounts();

		Provisioning.searchAccounts(keyword = "Liferay,");

		Provisioning.clickAccount(accountName = "Liferay, Inc.");

		Provisioning.clickTab(tabName = "Contacts");

		ProvisioningAccount.searchAndFilter(table = '''| Keyword | ${staticEmailValue1} |''');

		ProvisioningAccount._viewAccountContact(
			emailAddress = ${staticEmailValue1},
			table = '''| Name          | ${staticContactFirstNameValue1} ${staticContactLastNameValue1} |
	| Email Address | ${staticEmailValue1}                                           |
	| Role          | Member                                                         |
	| User Status   | VERIFIED                                                       |''');

		Provisioning.gotoUsers();

		Provisioning.searchUsers(keyword = ${staticScreenNameValue1});

		Provisioning._viewUserViaIndex(
			table = '''| Name               | ${staticContactFirstNameValue1} ${staticContactLastNameValue1}                     |
	| Email Address      | ${staticEmailValue1}                                                               |
	| Entitlements       | Customer, Customer - Commerce, Customer - DXP, Customer - Portal, Liferay Employee |
	| Number of Accounts | 1                                                                                  |
	| Status             | VERIFIED                                                                           |''',
			userName = "${staticContactFirstNameValue1} ${staticContactLastNameValue1}");
	}

}