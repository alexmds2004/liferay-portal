	test SetsupportscheduletoUS {
		property help.center.acceptance = "true";

		ZendeskOrganizationAPI._createOrganization(table = '''| Status           | Approved            |
	| Name             | Organization Name 1 |
	| Tags             | liferay_dxp         |
	| Shared Tickets   | true                |
