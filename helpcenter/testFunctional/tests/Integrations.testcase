definition {

	property testray.main.component.name = "Support QA";
	property type = "integration";

	setUp {
		Data.generateSupportStaticVariables();

		KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		Passwords.getPasswords();

		JSONOkta.createOktaUser(table = '''| Screen Name   | ${staticScreamName}       |
	| Email Address | ${staticEmail}            |
	| First Name    | ${staticContactFirstName} |
	| Last Name     | ${staticContactLastName}  |''');
	}

	tearDown {
		ZendeskUserAPI._getDefaultUserId(organizationName = ${staticProjectName});

		ZendeskUserAPI._renameFirstDefaultUserIdVariable();

		OSBAdminProject.tearDownProjects(table = '''| ${staticProjectCode} |''');

		KoroneikiAccountAPI._tearDownAccounts(table = '''| ${staticAccountCode} |
	| ${staticProjectCode} |''');

		JSONUser.tearDownUsersViaSupport(table = '''| ${staticEmail} |''');

		JSONUser.tearDownUsersViaKoroneiki(table = '''| ${staticEmail} |''');

		KoroneikiContactAPI._tearDownContacts(table = '''| ${staticEmail} |''');

		JSONOkta.tearDownUsers(table = '''| ${staticEmail} |''');

		ZendeskTicketAPI._tearDownTicketsByKeywords(table = '''| New Subscription(s) for ${staticAccountName} |
	| New Subscription(s) for ${staticProjectName} |''');

		ZendeskUserAPI._getMultipleUserIdsByEmailAddress(table = '''| ${staticEmail} |''');

		ZendeskUserAPI._tearDownUsersByIdList(userIds = ${staticUserIdList});

		ZendeskOrganizationAPI._getMultipleOrganizationExternalIdsByOrganizationNameIfStillPresent(table = '''| ${staticAccountCode} |
	| ${staticProjectCode} |''');

		ZendeskOrganizationAPI._tearDownOrganizationsByExternalIdList(organizationExternalIds = ${staticOrganizationExternalIdList});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId1});
	}

	test CustomertoZendesk {
		KoroneikiAccountAPI._createAccount(table = '''| Code   | ${staticProjectCode} | |
	| Name   | ${staticProjectName} | |
	| Region | United States        | |
	| Status | Active               | |
	| Tier   | T1                   | |''');

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = ${staticProjectName},
			contactEmailAddress = ${staticEmail},
			table = '''| Support User |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = ${staticProjectName},
			productName = "DXP Production",
			table = '''| End Date                | ${staticEndDate}         |   |
	| Original End Date       | ${staticOriginalEndDate} |   |
	| Perpetual               | false                    |   |
	| Product Field and Value | sizing                   | 1 |
	| Product Field and Value | licenses                 | 1 |
	| Product Field and Value | version                  | 7 |
	| Quantity                | 1                        |   |
	| Start Date              | ${staticStartDate}       |   |
	| Status                  | Approved                 |   |''');

		KoroneikiProductPurchaseAPI._generateProductPurchaseId(
			accountName = ${staticProjectName},
			productName = "DXP Production");

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = ${staticProjectName},
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		JSONOSBAccount.viewSupportOrganizationSync(accountCode = ${staticProjectCode});

		ZendeskOrganizationAPI._viewOrganizationSyncFromOsb(organizationName = ${staticProjectName});

		ZendeskUserAPI._viewUserSyncFromOsb(userEmailAddress = ${staticEmail});
	}

	test DossieraandOktatoKoroneiki {
		OSBAdminRabbitMQ.publishCreateProjectWithNoPartnerMessage(
			routingKey = "dossiera.provisioning.create",
			table = '''| Account Name                           | ${staticAccountName}                       |
	| Address City                           | Diamond Bar                                |
	| Address Country                        | United States                              |
	| Address Postal Code                    | 91765                                      |
	| Address Region                         | California                                 |
	| Address Street                         | 456 Fake Street                            |
	| Contact Email Address                  | ${staticEmail}                             |
	| Contact First Name                     | ${staticContactFirstName}                  |
	| Contact Last Name                      | ${staticContactLastName}                   |
	| Dossiera Account Key                   | ${staticDossieraAccountKey}                |
	| Dossiera Address Key 1                 | ${staticDossieraAddressKey1}               |
	| Dossiera Address Key 2                 | ${staticDossieraAddressKey2}               |
	| Dossiera Contact Key                   | ${staticDossieraContactKey}                |
	| Dossiera Project Key                   | ${staticDossieraProjectKey}                |
	| End Day                                | ${staticEndDay}                            |
	| End Month                              | ${staticEndMonth}                          |
	| End Year                               | ${staticEndYear}                           |
	| Industry                               | Automotive                                 |
	| Owner Email Address                    | ${staticEmail}                             |
	| Owner First Name                       | ${staticContactFirstName}                  |
	| Owner Last Name                        | ${staticContactLastName}                   |
	| Partner First Line Support             | false                                      |
	| Product Type                           | New                                        |
	| Product Name                           | Liferay Digital Enterprise - Prod Sizing 4 |
	| Project Name                           | ${staticProjectName}                       |
	| Renewal                                | false                                      |
	| Salesforce Opportunity Key             | ${staticSalesforceOpportunityKey}          |
	| Salesforce Opportunity Line Item Key 1 | ${staticSalesforceOpportunityLineItemKey1} |
	| Salesforce Opportunity Line Item Key 2 | ${staticSalesforceOpportunityLineItemKey2} |
	| Salesforce Opportunity Sold By         | Liferay US                                 |
	| Salesforce Opportunity Stage Name      | Closed Won                                 |
	| Salesforce Opportunity Territory       | United States                              |
	| Salesforce Opportunity Type            | New Business                               |
	| Salesforce Owner User Key              | ${staticSalesforceOwnerUserKey}            |
	| Salesforce Project Key                 | ${staticSalesforceProjectKey}              |
	| Start Day                              | ${staticStartDay}                          |
	| Start Month                            | ${staticStartMonth}                        |
	| Start Year                             | ${staticStartYear}                         |
	| Subscription Level                     | Platinum                                   |
	| Version Number                         | 7.4                                        |''');

		KoroneikiAccountAPI._viewAccount(
			accountName = ${staticProjectName},
			table = '''| Account Field and Value    | liferayVersion       | DXP 7.4 | |
	| Code                       | ${staticProjectCode} |         | |
	| Parent Account Name        | ${staticAccountName} |         | |
	| Contact Email Address      | ${staticEmail}       |         | |
	| Name                       | ${staticProjectName} |         | |
	| Region                     | United States        |         | |
	| Language                   | English              |         | |
	| Status                     | Active               |         | |''');

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = ${staticProjectName},
			contactEmailAddress = ${staticEmail},
			table = '''| Support User |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		KoroneikiContactAPI._viewContactUuidAndUserUuidComparison(contactEmailAddress = ${staticEmail});

		JSONOkta.viewOktaUserGroupMembership(
			groupName = "Customers",
			userEmailAddress = ${staticEmail});

		KoroneikiContactAPI._viewContactViaEmailAddress(
			contactEmailAddress = ${staticEmail},
			table = '''| Email Address | ${staticEmail}            |
	| First Name    | ${staticContactFirstName} |
	| Last Name     | ${staticContactLastName}  |''');

		KoroneikiProductPurchaseAPI._viewProductPurchase(
			accountName = ${staticProjectName},
			productName = "DXP Production",
			table = '''| Quantity | 1        | |
	| Status   | Approved | |''');

		KoroneikiProductPurchaseAPI._viewProductPurchase(
			accountName = ${staticProjectName},
			productName = "Platinum Subscription",
			table = '''| Quantity | 1        | |
	| Status   | Approved | |''');
	}

	test DossieratoZendesk {
		OSBAdminRabbitMQ.publishCreateProjectWithNoPartnerMessage(
			routingKey = "dossiera.provisioning.create",
			table = '''| Account Name                           | ${staticAccountName}                       |
	| Address City                           | Diamond Bar                                |
	| Address Country                        | United States                              |
	| Address Postal Code                    | 91765                                      |
	| Address Region                         | California                                 |
	| Address Street                         | 456 Fake Street                            |
	| Contact Email Address                  | ${staticEmail}                             |
	| Contact First Name                     | ${staticContactFirstName}                  |
	| Contact Last Name                      | ${staticContactLastName}                   |
	| Dossiera Account Key                   | ${staticDossieraAccountKey}                |
	| Dossiera Address Key 1                 | ${staticDossieraAddressKey1}               |
	| Dossiera Address Key 2                 | ${staticDossieraAddressKey2}               |
	| Dossiera Contact Key                   | ${staticDossieraContactKey}                |
	| Dossiera Project Key                   | ${staticDossieraProjectKey}                |
	| End Day                                | ${staticEndDay}                            |
	| End Month                              | ${staticEndMonth}                          |
	| End Year                               | ${staticEndYear}                           |
	| Industry                               | Automotive                                 |
	| Owner Email Address                    | ${staticEmail}                             |
	| Owner First Name                       | ${staticContactFirstName}                  |
	| Owner Last Name                        | ${staticContactLastName}                   |
	| Partner First Line Support             | false                                      |
	| Product Type                           | New                                        |
	| Product Name                           | Liferay Digital Enterprise - Prod Sizing 4 |
	| Project Name                           | ${staticProjectName}                       |
	| Renewal                                | false                                      |
	| Salesforce Opportunity Key             | ${staticSalesforceOpportunityKey}          |
	| Salesforce Opportunity Line Item Key 1 | ${staticSalesforceOpportunityLineItemKey1} |
	| Salesforce Opportunity Line Item Key 2 | ${staticSalesforceOpportunityLineItemKey2} |
	| Salesforce Opportunity Sold By         | Liferay US                                 |
	| Salesforce Opportunity Stage Name      | Closed Won                                 |
	| Salesforce Opportunity Territory       | United States                              |
	| Salesforce Opportunity Type            | New Business                               |
	| Salesforce Owner User Key              | ${staticSalesforceOwnerUserKey}            |
	| Salesforce Project Key                 | ${staticSalesforceProjectKey}              |
	| Start Day                              | ${staticStartDay}                          |
	| Start Month                            | ${staticStartMonth}                        |
	| Start Year                             | ${staticStartYear}                         |
	| Subscription Level                     | Platinum                                   |
	| Version Number                         | 7.4                                        |''');

		ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		ZendeskTicketAPI._viewTicketSyncByKeywords(keywords = "New Subscription(s) for ${staticProjectName}");

		ZendeskTicketAPI._viewTicketSubject(
			keywords = "New Subscription(s) for ${staticProjectName}",
			subject = "New Business: New Subscription(s) for ${staticProjectName}");

		ZendeskTicketAPI._viewTicketDescription(
			descriptionText = "Account Name: ${staticProjectName}",
			keywords = "New Subscription(s) for ${staticProjectName}");

		ZendeskTicketAPI._viewTicketDescription(
			descriptionText = "Account Code: ${staticProjectCode}",
			keywords = "New Subscription(s) for ${staticProjectName}");

		ZendeskTicketAPI._viewTicketDescription(
			descriptionText = "Opportunity Type: New Business",
			keywords = "New Subscription(s) for ${staticProjectName}");

		ZendeskTicketAPI._viewTicketDescription(
			descriptionText = "New DXP Production (1)",
			keywords = "New Subscription(s) for ${staticProjectName}");

		ZendeskTicketAPI._viewTicketDescription(
			descriptionText = "New Platinum Subscription",
			keywords = "New Subscription(s) for ${staticProjectName}");

		ZendeskTicketAPI._viewTicketDescription(
			descriptionText = "Start Date - End Date: ${staticStartYear}",
			keywords = "New Subscription(s) for ${staticProjectName}");

		ZendeskTicketAPI._viewTicketDescription(
			descriptionText = "US Provisioning - Working with 2019 H2 Pricing Promotions: Grow Link",
			keywords = "New Subscription(s) for ${staticProjectName}");

		ZendeskTicketAPI._viewTicketRequester(
			keywords = "New Subscription(s) for ${staticProjectName}",
			requesterEmailAddress = "provisioningrequest@liferay.com");

		ZendeskTicketAPI._viewTicketOrganizationByKeywords(
			keywords = "New Subscription(s) for ${staticProjectName}",
			organizationName = "Provisioning");

		ZendeskTicketAPI._viewTicketProduct(
			keywords = "New Subscription(s) for ${staticProjectName}",
			product = "prd_provisioning_request");

		ZendeskTicketAPI._viewTicketProvisioningComponent(
			keywords = "New Subscription(s) for ${staticProjectName}",
			provisioningComponent = "opportunity_invoiced");

		ZendeskTicketAPI._viewTicketSupportRegion(
			keywords = "New Subscription(s) for ${staticProjectName}",
			supportRegion = "provisioning_united_states");

		ZendeskTicketAPI._viewTicketPrimaryAddressCountry(
			keywords = "New Subscription(s) for ${staticProjectName}",
			primaryAddressCountry = "United States");
	}

	test KoroneikitoCustomer {
		KoroneikiAccountAPI._createAccount(table = '''| Code   | ${staticProjectCode} | |
	| Name   | ${staticProjectName} | |
	| Region | United States        | |
	| Status | Active               | |
	| Tier   | T1                   | |''');

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = ${staticProjectName},
			contactEmailAddress = ${staticEmail},
			table = '''| Support User |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = ${staticProjectName},
			productName = "DXP Production",
			table = '''| End Date                | ${staticEndDate}         |   |
	| Original End Date       | ${staticOriginalEndDate} |   |
	| Perpetual               | false                    |   |
	| Product Field and Value | sizing                   | 1 |
	| Product Field and Value | licenses                 | 1 |
	| Product Field and Value | version                  | 7 |
	| Quantity                | 1                        |   |
	| Start Date              | ${staticStartDate}       |   |
	| Status                  | Approved                 |   |''');

		KoroneikiProductPurchaseAPI._generateProductPurchaseId(
			accountName = ${staticProjectName},
			productName = "DXP Production");

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = ${staticProjectName},
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		JSONOSBAccount.viewSupportOrganizationSync(accountCode = ${staticProjectCode});

		OSBAdmin.loginToSupport(
			userEmailAddress = ${staticSupportAdminEmailAdress},
			userPassword = ${staticSupportAdminPassword});

		OSBAdmin.gotoOSBAdmin();

		OSBAdminProject.view(
			projectName = ${staticProjectName},
			table = '''| Project Name          | ${staticProjectName} |
	| Code                  | ${staticProjectCode} |
	| Tier                  | T1                   |''');

		ProjectDetails.gotoProjectDetailsPage();

		ProjectDetails.searchKeyword(keyword = ${staticProjectName});

		ProjectDetails.gotoProject(projectName = ${staticProjectName});

		ProjectDetails.viewDetails(table = '''| Project Code    | ${staticProjectCode}  |
	| State           | ACTIVE                |
	| Level           | Platinum Subscription |
	| Support Region  | United States         |
	| Tier            | T1                    |''');
	}

	test KoroneikitoProvisioning {
		KoroneikiAccountAPI._createAccount(table = '''| Code   | ${staticProjectCode} | |
	| Name   | ${staticProjectName} | |
	| Region | United States        | |
	| Status | Active               | |
	| Tier   | T1                   | |''');

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = ${staticProjectName},
			contactEmailAddress = ${staticEmail},
			table = '''| Support User |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = ${staticProjectName},
			productName = "DXP Production",
			table = '''| End Date                | ${staticEndDate}         |   |
	| Original End Date       | ${staticOriginalEndDate} |   |
	| Perpetual               | false                    |   |
	| Product Field and Value | sizing                   | 1 |
	| Product Field and Value | licenses                 | 1 |
	| Product Field and Value | version                  | 7 |
	| Quantity                | 1                        |   |
	| Start Date              | ${staticStartDate}       |   |
	| Status                  | Approved                 |   |''');

		KoroneikiProductPurchaseAPI._generateProductPurchaseId(
			accountName = ${staticProjectName},
			productName = "DXP Production");

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = ${staticProjectName},
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		Provisioning.gotoAccounts();

		Provisioning.searchAccounts(keyword = ${staticProjectName});

		Provisioning.clickAccount(accountName = ${staticProjectName});

		ProvisioningAccount._viewAccountDetails(table = '''| Name           | ${staticProjectName} |
	| Code           | ${staticProjectCode} |
	| State          | ACTIVE               |
	| Support Region | United States        |
	| SLA            | Platinum             |
	| Support Seats  | 0 / 3 Filled         |
	| Tier           | T1                   |''');
	}

}