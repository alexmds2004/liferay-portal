		JSONOkta.viewOktaUserGroupMembership(
			groupName = "Employees",
			userEmailAddress = ${staticEmailValue});

		JSONOkta.viewOktaUserGroupMembership(
			groupName = "Division - Subscription Services",
			userEmailAddress = ${staticEmailValue});

