	test ViewLiferaySubscriptionServicesemployee {
		KoroneikiContactAPI._viewContactSyncViaEmailAddress(contactEmailAddress = ${staticEmailValue});

		KoroneikiContactAPI._viewAccountSyncViaUuid(
			accountName = "Liferay, Inc.",
			contactEmailAddress = ${staticEmailValue});

		KoroneikiContactAPI._viewTeamSyncViaUuid(
			contactEmailAddress = ${staticEmailValue},
			teamName = "Systems - Provisioning");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - DXP");

