	test Viewnonewsupportadministratorcontactemailsforcontactverifiedviaprovisioning {
		JSONOkta.createOktaUser(table = '''| Screen Name   | pro.user1                       |
	| Email Address | pro.user1@lrcustomer.com.broken |
	| First Name    | PRO                             |
	| Last Name     | ${staticContactLastName1}       |
	| Email Status  | UNVERIFIED                      |
	| Active        | true                            |''');

		OSBAdminRabbitMQ.generateProvisioningProjectName();

		KoroneikiAccountAPI._createAccount(table = '''| Code                  | MAILKRKRMAIL                    | |
	| Contact Email Address | pro.user1@lrcustomer.com.broken | |
	| Description           | Test okt account on koroneiki   | |
	| Fax Number            | 555-555-1234                    | |
	| Name                  | Krmail - ${staticProjectName}   | |
	| Phone Number          | 555-555-5678                    | |
	| Profile Email Address | pro.user1@lrcustomer.com.broken | |
	| Region                | United States                   | |
	| Status                | Active                          | |
	| Tier                  | T4                              | |
	| Website               | www.koroneikicorporation.com    | |''');

		KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Krmail - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | true                     | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Krmail - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | true                     | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Krmail - ${staticProjectName}",
			contactEmailAddress = "pro.user1@lrcustomer.com.broken",
			table = '''| Support Administrator |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		KoroneikiContactAPI._updateContactViaEmailAddress(
			contactEmailAddress = "pro.user1@lrcustomer.com.broken",
			table = '''| Email Address Verified | false |''');

		OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		Provisioning.gotoUsers();

		Provisioning.searchUsers(keyword = "pro.user1");

		Provisioning.clickUser(userName = "PRO ${staticContactLastName1}");

		ProvisioningUser.clickSyncWithOktaButton();

		ZendeskHomepage.pause(timeInSeconds = 10);

		MockMock.viewNoSupportMailMessage(
			mockMockAsset = "New Liferay Project Invitation - Krmail - ${staticProjectName}",
			mockMockRecipient = "PRO ${staticContactLastName1}",
			mockMockSender = "Liferay Provisioning",
			recipientEmailAddress = "pro.user1@lrcustomer.com.broken");
	}

