definition {

	property testray.main.component.name = "Support QA";
	property type = "provisioning.user.integration";

	setUp {
		Passwords.getPasswords();

		OSBAdminRabbitMQ.generateStaticVariables();

		OSBAdminRabbitMQ.generateProvisioningCompanyName();

		OSBAdminRabbitMQ.generateProvisioningProjectName();

		OSBAdminRabbitMQ.generateProvisioningContactLastName();

		OSBAdminRabbitMQ._renameFirstUserLastNameVariable();

		OSBAdminRabbitMQ.generateProvisioningContactLastName();

		OSBAdminRabbitMQ._renameSecondUserLastNameVariable();

		OSBAdminRabbitMQ.generateProvisioningContactLastName();

		OSBAdminRabbitMQ._renameThirdUserLastNameVariable();
	}

	tearDown {
		ZendeskUserAPI._getDefaultUserId(organizationName = "Krmail - ${staticProjectName}");

		ZendeskUserAPI._renameFirstDefaultUserIdVariable();

		ZendeskUserAPI._getDefaultUserId(organizationName = "Mailkr - ${staticProjectName}");

		ZendeskUserAPI._renameSecondDefaultUserIdVariable();

		ZendeskUserAPI._getDefaultUserId(organizationName = "Prmail - ${staticCompanyName}");

		ZendeskUserAPI._renameSecondDefaultUserIdVariable();

		OSBAdminProject.tearDownProjects(table = '''| MAILKRKRMAIL |
	| PRMAIL       |
	| MAILKR       |''');

		KoroneikiAccountAPI._tearDownAccounts(table = '''| Krmail - ${staticProjectName} |
	| Mailkr - ${staticCompanyName} |
	| Prmail - ${staticCompanyName} |''');

		KoroneikiAccountAPI._tearDownAccountsViaAccountFieldNameAndValue(
			fieldName = "Code",
			table = '''| MAILKRKRMAIL |
	| PRMAIL       |
	| MAILKR       |''');

		JSONUser.tearDownUsersViaSupport(table = '''| pro.user1@lrcustomer.com.broken |
	| pro.user2@lrcustomer.com.broken |
	| pro.user3@lrpartner.com.broken  |''');

		JSONUser.tearDownUsersViaKoroneiki(table = '''| pro.user1@lrcustomer.com.broken |
	| pro.user2@lrcustomer.com.broken |
	| pro.user3@lrpartner.com.broken  |''');

		KoroneikiContactAPI._tearDownContacts(table = '''| pro.user1@lrcustomer.com.broken |
	| pro.user2@lrcustomer.com.broken |
	| pro.user3@lrpartner.com.broken  |''');

		JSONOkta.tearDownUsers(table = '''| pro.user1@lrcustomer.com.broken |
	| pro.user2@lrcustomer.com.broken |
	| pro.user3@lrpartner.com.broken  |''');

		ZendeskTicketAPI._tearDownTicketsByKeywords(table = '''| New Subscription(s) for Krmail - ${staticProjectName} |
	| New Subscription(s) for Mailkr - ${staticCompanyName} |
	| New Subscription(s) for Prmail - ${staticCompanyName} |''');

		ZendeskUserAPI._getMultipleUserIdsByEmailAddress(table = '''| pro.user1@lrcustomer.com.broken |
	| pro.user2@lrcustomer.com.broken |
	| pro.user3@lrpartner.com.broken  |''');

		ZendeskUserAPI._tearDownUsersByIdList(userIds = ${staticUserIdList});

		ZendeskOrganizationAPI._getMultipleOrganizationExternalIdsByOrganizationNameIfStillPresent(table = '''| Krmail - ${staticProjectName} |
	| Mailkr - ${staticCompanyName} |
	| Prmail - ${staticCompanyName} |''');

		ZendeskOrganizationAPI._tearDownOrganizationsByExternalIdList(organizationExternalIds = ${staticOrganizationExternalIdList});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId1});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId2});

		MockMock.tearDownMailMessage(
			mockMockAsset = "New Liferay Project Invitation - Krmail - ${staticProjectName}",
			mockMockRecipient = "PRO ${staticContactLastName1}",
			mockMockSender = "Liferay Provisioning",
			recipientEmailAddress = "pro.user1@lrcustomer.com.broken");

		MockMock.tearDownMailMessage(
			mockMockAsset = "New Liferay Project Invitation - Krmail - ${staticProjectName}",
			mockMockRecipient = "PRO ${staticContactLastName2}",
			mockMockSender = "Liferay Provisioning",
			recipientEmailAddress = "pro.user2@lrcustomer.com.broken");

		MockMock.tearDownMailMessage(
			mockMockAsset = "New Liferay Project Invitation - Prmail - ${staticCompanyName}",
			mockMockRecipient = "PRO ${staticContactLastName3}",
			mockMockSender = "Liferay Provisioning",
			recipientEmailAddress = "pro.user3@lrpartner.com.broken");

		MockMock.tearDownMailMessage(
			mockMockAsset = "Convite para novo projeto Liferay - Krmail - ${staticProjectName}",
			mockMockRecipient = "PRO ${staticContactLastName1}",
			mockMockSender = "Liferay Provisioning",
			recipientEmailAddress = "pro.user1@lrcustomer.com.broken");

		MockMock.tearDownMailMessage(
			mockMockAsset = "Convite para novo projeto Liferay - Krmail - ${staticProjectName}",
			mockMockRecipient = "PRO ${staticContactLastName2}",
			mockMockSender = "Liferay Provisioning",
			recipientEmailAddress = "pro.user2@lrcustomer.com.broken");

		MockMock.tearDownMailMessage(
			mockMockAsset = "Convite para novo projeto Liferay - Prmail - ${staticCompanyName}",
			mockMockRecipient = "PRO ${staticContactLastName3}",
			mockMockSender = "Liferay Provisioning",
			recipientEmailAddress = "pro.user3@lrpartner.com.broken");

		MockMock.tearDownMailMessage(
			mockMockAsset = "Invitación al nuevo proyecto de Liferay - Krmail - ${staticProjectName}",
			mockMockRecipient = "PRO ${staticContactLastName1}",
			mockMockSender = "Liferay Provisioning",
			recipientEmailAddress = "pro.user1@lrcustomer.com.broken");

		MockMock.tearDownMailMessage(
			mockMockAsset = "Invitación al nuevo proyecto de Liferay - Krmail - ${staticProjectName}",
			mockMockRecipient = "PRO ${staticContactLastName2}",
			mockMockSender = "Liferay Provisioning",
			recipientEmailAddress = "pro.user2@lrcustomer.com.broken");

		MockMock.tearDownMailMessage(
			mockMockAsset = "Invitación al nuevo proyecto de Liferay - Prmail - ${staticCompanyName}",
			mockMockRecipient = "PRO ${staticContactLastName3}",
			mockMockSender = "Liferay Provisioning",
			recipientEmailAddress = "pro.user3@lrpartner.com.broken");

		MockMock.tearDownMailMessage(
			mockMockAsset = "新しいLiferayプロジェクトの招待状 - Krmail - ${staticProjectName}",
			mockMockRecipient = "PRO ${staticContactLastName1}",
			mockMockSender = "Liferay Provisioning",
			recipientEmailAddress = "pro.user1@lrcustomer.com.broken");

		MockMock.tearDownMailMessage(
			mockMockAsset = "新しいLiferayプロジェクトの招待状 - Krmail - ${staticProjectName}",
			mockMockRecipient = "PRO ${staticContactLastName2}",
			mockMockSender = "Liferay Provisioning",
			recipientEmailAddress = "pro.user2@lrcustomer.com.broken");

		MockMock.tearDownMailMessage(
			mockMockAsset = "新しいLiferayプロジェクトの招待状 - Prmail - ${staticCompanyName}",
			mockMockRecipient = "PRO ${staticContactLastName3}",
			mockMockSender = "Liferay Provisioning",
			recipientEmailAddress = "pro.user3@lrpartner.com.broken");
	}

	test ViewnewcontactemailsfornonoktausercontactsinBRESregion {
		OSBAdminRabbitMQ.publishCreateProjectWithNoPartnerMessage(
			routingKey = "dossiera.provisioning.create",
			table = '''| Account Name                           | Mailkr - ${staticCompanyName}              |
	| Address City                           | Tijuana                                    |
	| Address Country                        | Mexico                                     |
	| Address Postal Code                    | 20631                                      |
	| Address Region                         | Baja California                            |
	| Address Street                         | Avenida Agua 120                           |
	| Contact Email Address                  | pro.user1@lrcustomer.com.broken            |
	| Contact First Name                     | PRO                                        |
	| Contact Last Name                      | ${staticContactLastName1}                  |
	| Dossiera Account Key                   | ${staticDossieraAccountKey}                |
	| Dossiera Address Key 1                 | ${staticDossieraAddressKey1}               |
	| Dossiera Address Key 2                 | ${staticDossieraAddressKey2}               |
	| Dossiera Contact Key                   | ${staticDossieraContactKey}                |
	| Dossiera Project Key                   | ${staticDossieraProjectKey}                |
	| End Day                                | ${staticEndDay}                            |
	| End Month                              | ${staticEndMonth}                          |
	| End Year                               | ${staticEndYear}                           |
	| Industry                               | Automotive                                 |
	| Owner Email Address                    | pro.user2@lrcustomer.com.broken            |
	| Owner First Name                       | PRO                                        |
	| Owner Last Name                        | ${staticContactLastName2}                  |
	| Partner First Line Support             | false                                      |
	| Product Type                           | New                                        |
	| Product Name                           | Liferay Digital Enterprise - Prod Sizing 4 |
	| Project Name                           | Krmail - ${staticProjectName}              |
	| Renewal                                | false                                      |
	| Salesforce Opportunity Key             | ${staticSalesforceOpportunityKey}          |
	| Salesforce Opportunity Line Item Key 1 | ${staticSalesforceOpportunityLineItemKey1} |
	| Salesforce Opportunity Line Item Key 2 | ${staticSalesforceOpportunityLineItemKey2} |
	| Salesforce Opportunity Sold By         | Liferay Brazil                             |
	| Salesforce Opportunity Stage Name      | Closed Won                                 |
	| Salesforce Opportunity Territory       | Mexico                                     |
	| Salesforce Opportunity Type            | New Business                               |
	| Salesforce Owner User Key              | ${staticSalesforceOwnerUserKey}            |
	| Salesforce Project Key                 | ${staticSalesforceProjectKey}              |
	| Start Day                              | ${staticStartDay}                          |
	| Start Month                            | ${staticStartMonth}                        |
	| Start Year                             | ${staticStartYear}                         |
	| Subscription Level                     | Platinum                                   |
	| Version Number                         | 7.1                                        |''');

		JSONOkta.updateOktaUser(
			table = '''| Screen Name   | pro.user1                 |
	| First Name    | PRO                       |
	| Last Name     | ${staticContactLastName1} |''',
			userOriginalEmailAddress = "pro.user1@lrcustomer.com.broken");

		JSONOkta.updateOktaUser(
			table = '''| Screen Name   | pro.user2                 |
	| First Name    | PRO                       |
	| Last Name     | ${staticContactLastName2} |''',
			userOriginalEmailAddress = "pro.user2@lrcustomer.com.broken");

		ZendeskHomepage.pause(timeInSeconds = 10);

		MockMock.gotoSupportMailMessage(
			mockMockAsset = "New Liferay Project Invitation - Krmail - ${staticProjectName}",
			mockMockRecipient = "PRO ${staticContactLastName1}",
			mockMockSender = "Liferay Provisioning",
			recipientEmailAddress = "pro.user1@lrcustomer.com.broken");

		MockMock.viewMailMessage(table = '''| You have been invited to the Liferay project   |
	| Krmail - ${staticProjectName}                  |
	| Login or create a Liferay.com account to       |
	| View your project's subscriptions              |
	| Manage team members & roles                    |
	| Activate your Liferay products                 |
	| Learn how to succeed with each of our products |
	| Search our extensive Knowledge Base            |
	| Request help from our Support team             |
	| support.liferay.com                            |''');
	}

