definition {

	property testray.main.component.name = "Support QA";
	property type = "zendesk.large.file.attachment";

	setUp {
		Passwords.getPasswords();

		OSBAdminRabbitMQ.generateProvisioningProjectName();

		JSONOkta.createOktaUser(table = '''| Screen Name   | lfa.customer1                       |
	| Email Address | lfa.customer1@lrcustomer.com.broken |
	| First Name    | LFA                                 |
	| Last Name     | Customer1                           |''');
	}

	tearDown {
		ZendeskUserAPI._getDefaultUserId(organizationName = "Lfazen - ${staticProjectName}");

		ZendeskUserAPI._tearDownUsersRequestedTicketsByEmailAddressTable(table = '''| lfa.customer1@lrcustomer.com.broken |
	| lfa.partner1@lrpartner.com.broken   |
	| lfa.partner2@lrpartner.com.broken   |
	| ${staticEmailValue1}                |
	| ${staticEmailValue2}                |''');

		OSBAdminProject.tearDownProjects(table = '''| LFAZENLFAZEN |
	| LFAPARLFAPAR |''');

		KoroneikiAccountAPI._tearDownAccounts(table = '''| Lfazen - ${staticProjectName} |
	| Lfapar - ${staticProjectName} |''');

		KoroneikiAccountAPI._tearDownAccountsViaAccountFieldNameAndValue(
			fieldName = "Code",
			table = '''| LFAZENLFAZEN |
	| LFAPARLFAPAR |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Gold Subscription");

		JSONUser.tearDownUsersViaSupport(table = '''| lfa.customer1@lrcustomer.com.broken |
	| lfa.partner1@lrpartner.com.broken   |
	| lfa.partner2@lrpartner.com.broken   |
	| ${staticEmailValue1}                |
	| ${staticEmailValue2}                |''');

		JSONUser.tearDownUsersViaKoroneiki(table = '''| lfa.customer1@lrcustomer.com.broken |
	| lfa.partner1@lrpartner.com.broken   |
	| lfa.partner2@lrpartner.com.broken   |
	| ${staticEmailValue1}                |
	| ${staticEmailValue2}                |''');

		KoroneikiProductPurchaseAPI._tearDownProductPurchases(
			accountName = "Lfazen - ${staticProjectName}",
			table = '''| Portal Production |
	| Gold Subscription |''');

		KoroneikiContactAPI._tearDownContacts(table = '''| lfa.customer1@lrcustomer.com.broken |
	| lfa.partner1@lrpartner.com.broken   |
	| lfa.partner2@lrpartner.com.broken   |
	| ${staticEmailValue1}                |
	| ${staticEmailValue2}                |''');

		JSONOkta.tearDownUsers(table = '''| lfa.customer1@lrcustomer.com.broken |
	| lfa.partner1@lrpartner.com.broken   |
	| lfa.partner2@lrpartner.com.broken   |
	| ${staticEmailValue1}                |
	| ${staticEmailValue2}                |''');

		ZendeskUserAPI._getMultipleUserIdsByEmailAddress(table = '''| lfa.customer1@lrcustomer.com.broken |
	| lfa.partner1@lrpartner.com.broken   |
	| lfa.partner2@lrpartner.com.broken   |
	| ${staticEmailValue1}                |
	| ${staticEmailValue2}                |''');

		ZendeskUserAPI._tearDownUsersByIdList(userIds = ${staticUserIdList});

		ZendeskOrganizationAPI._getMultipleOrganizationExternalIdsByOrganizationNameIfStillPresent(table = '''| Lfazen - ${staticProjectName} |
	| Lfapar - ${staticProjectName} |''');

		ZendeskOrganizationAPI._tearDownOrganizationsByExternalIdList(organizationExternalIds = ${staticOrganizationExternalIdList});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId});

		Downloads.teardownDownloadedTableFiles(table = '''| Document_1.txt     |
	| Document_1 (1).txt |
	| Document_2.txt     |
	| Document_2 (1).txt |
	| Document_3.txt     |
	| Document_4.txt     |''');
	}

	test DownloadcustomerEUlargefilesasemployeewithdataaccessUS {
		Data.generateSupportUser();

		Data._renameFirstSupportUserVariables();

		JSONOkta.createOktaUser(table = '''| Screen Name   | ${staticScreenNameValue1}       |
	| Email Address | ${staticEmailValue1}            |
	| First Name    | ${staticContactFirstNameValue1} |
	| Last Name     | ${staticContactLastNameValue1}  |
	| Group         | Employees                       |''');

		KoroneikiContactAPI._viewContactSyncViaEmailAddress(contactEmailAddress = ${staticEmailValue1});

		KoroneikiContactAPI._viewAccountSyncViaUuid(
			accountName = "Liferay, Inc.",
			contactEmailAddress = ${staticEmailValue1});

		Data.generateSupportUser();

		Data._renameSecondSupportUserVariables();

		JSONOkta.createOktaUser(table = '''| Screen Name   | ${staticScreenNameValue2}       |
	| Email Address | ${staticEmailValue2}            |
	| First Name    | ${staticContactFirstNameValue2} |
	| Last Name     | ${staticContactLastNameValue2}  |
	| Group         | Employees                       |''');

		KoroneikiContactAPI._viewContactSyncViaEmailAddress(contactEmailAddress = ${staticEmailValue2});

		KoroneikiContactAPI._viewAccountSyncViaUuid(
			accountName = "Liferay, Inc.",
			contactEmailAddress = ${staticEmailValue2});

		KoroneikiAccountAPI._createAccount(table = '''| Code        | LFAZENLFAZEN                  | |
	| Data Region | Hungary                       | |
	| Language    | English                       | |
	| Name        | Lfazen - ${staticProjectName} | |
	| Region      | Hungary                       | |
	| Status      | Active                        | |
	| Tier        | T1                            | |''');

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Lfazen - ${staticProjectName}",
			contactEmailAddress = "lfa.customer1@lrcustomer.com.broken",
			table = '''| Support Requester |''');

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Lfazen - ${staticProjectName}",
			contactEmailAddress = ${staticEmailValue1},
			table = '''| Support Requester |''');

		KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Lfazen - ${staticProjectName}",
			productName = "Portal Production",
			table = '''| End Date                | ${staticEndDate}         |   |
	| Original End Date       | ${staticOriginalEndDate} |   |
	| Perpetual               | false                    |   |
	| Product Field and Value | sizing                   | 1 |
	| Product Field and Value | licenses                 | 1 |
	| Product Field and Value | version                  | 6 |
	| Quantity                | 1                        |   |
	| Start Date              | ${staticStartDate}       |   |
	| Status                  | Approved                 |   |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Lfazen - ${staticProjectName}",
			productName = "Gold Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Gold Subscription");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - Portal");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Liferay Employee");

		ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		JSONOSBAccount.viewSupportOrganizationSync(accountCode = "LFAZENLFAZEN");

		ZendeskOrganizationAPI._viewOrganizationSyncFromOsb(organizationName = "Lfazen - ${staticProjectName}");

		JSONUser.viewSupportUserSync(userEmailAddress = "lfa.customer1@lrcustomer.com.broken");

		JSONUser.viewSupportUserSync(userEmailAddress = ${staticEmailValue1});

		JSONUser.viewSupportUserSync(userEmailAddress = ${staticEmailValue2});

		JSONUser.updateSupportPassword(
			userEmailAddress = "lfa.customer1@lrcustomer.com.broken",
			userPassword = ${staticSupportUserTestPassword});

		JSONUser.updateSupportPassword(
			userEmailAddress = ${staticEmailValue1},
			userPassword = ${staticSupportUserTestPassword});

		JSONUser.updateSupportPassword(
			userEmailAddress = ${staticEmailValue2},
			userPassword = ${staticSupportUserTestPassword});

		JSONUser.assignUserToSupportOrganization(
			organizationName = "Data Access EU",
			userEmailAddress = ${staticEmailValue1});

		JSONUser.assignUserToSupportOrganization(
			organizationName = "Data Access US",
			userEmailAddress = ${staticEmailValue2});

		ZendeskUserAPI._updateUserPasswordByEmailAddress(
			userEmailAddress = "lfa.customer1@lrcustomer.com.broken",
			userPassword = ${staticZendeskAdminPassword});

		ZendeskUserAPI._updateUserPasswordByEmailAddress(
			userEmailAddress = ${staticEmailValue1},
			userPassword = ${staticZendeskAdminPassword});

		ZendeskUserAPI._updateUserPasswordByEmailAddress(
			userEmailAddress = ${staticEmailValue2},
			userPassword = ${staticZendeskAdminPassword});

		OSBAdmin.logoutAndLoginToSupport(
			userEmailAddress = "lfa.customer1@lrcustomer.com.broken",
			userPassword = ${staticSupportUserTestPassword});

		ZendeskHomepage.login(
			userEmailAddress = "lfa.customer1@lrcustomer.com.broken",
			userPassword = ${staticZendeskAdminPassword});

		ZendeskRequest.create(table = '''| Product       | Liferay Portal                          | 6.2                                   |
	| Component     | Activation Key & Project Administration |                                       |
	| System Status | Production                              | Functioning with limited capabilities |
	| Subject       | Request Subject                         |                                       |
	| Description   | Request Description                     |                                       |''');

		ZendeskRequest.uploadFileViaLargeFileUploader(table = '''| Attachment       | Document_1.txt     |
	| Comment          | Large File Comment |
	| Data Region      | European Union     |
	| No Personal Data | true               |''');

		ZendeskRequest.uploadFileViaLargeFileUploader(table = '''| Attachment       | Document_2.txt     |
	| Comment          | Large File Comment |
	| Data Region      | European Union     |
	| No Personal Data | false              |''');

		OSBAdmin.logoutAndLoginToSupport(
			userEmailAddress = ${staticEmailValue1},
			userPassword = ${staticSupportUserTestPassword});

		ZendeskHomepage.login(
			userEmailAddress = ${staticEmailValue1},
			userPassword = ${staticZendeskAdminPassword});

		ZendeskRequest.gotoViaId(requestId = ${staticRequestId});

		ZendeskRequest.downloadLargeFIle(
			commentContent = "Large File Comment",
			fileName = "Document_1.txt");

		Downloads.viewDownloadedFile(fileName = "Document_1.txt");

		ZendeskRequest.downloadLargeFIle(
			commentContent = "Large File Comment",
			fileName = "Document_2.txt");

		Downloads.viewDownloadedFile(fileName = "Document_2.txt");

		OSBAdmin.logoutAndLoginToSupport(
			userEmailAddress = ${staticEmailValue2},
			userPassword = ${staticSupportUserTestPassword});

		ZendeskHomepage.login(
			userEmailAddress = ${staticEmailValue2},
			userPassword = ${staticZendeskAdminPassword});

		ZendeskRequest.gotoViaId(requestId = ${staticRequestId});

		ZendeskRequest.downloadLargeFIle(
			commentContent = "Large File Comment",
			fileName = "Document_1.txt");

		Downloads.viewDownloadedFile(fileName = "Document_1 (1).txt");

		ZendeskRequest.downloadLargeFIle(
			commentContent = "Large File Comment",
			fileName = "Document_2.txt");

		Downloads.viewNoDownloadedFile(fileName = "Document_2 (1).txt");
	}

	test DownloadcustomerEUlargefilesonprojectdetailsasemployeewithdataaccessUSandEU {
		Data.generateSupportUser();

		Data._renameFirstSupportUserVariables();

		JSONOkta.createOktaUser(table = '''| Screen Name   | ${staticScreenNameValue1}       |
	| Email Address | ${staticEmailValue1}            |
	| First Name    | ${staticContactFirstNameValue1} |
	| Last Name     | ${staticContactLastNameValue1}  |
	| Group         | Employees                       |''');

		KoroneikiContactAPI._viewContactSyncViaEmailAddress(contactEmailAddress = ${staticEmailValue1});

		KoroneikiContactAPI._viewAccountSyncViaUuid(
			accountName = "Liferay, Inc.",
			contactEmailAddress = ${staticEmailValue1});

		Data.generateSupportUser();

		Data._renameSecondSupportUserVariables();

		JSONOkta.createOktaUser(table = '''| Screen Name   | ${staticScreenNameValue2}       |
	| Email Address | ${staticEmailValue2}            |
	| First Name    | ${staticContactFirstNameValue2} |
	| Last Name     | ${staticContactLastNameValue2}  |
	| Group         | Employees                       |''');

		KoroneikiContactAPI._viewContactSyncViaEmailAddress(contactEmailAddress = ${staticEmailValue2});

		KoroneikiContactAPI._viewAccountSyncViaUuid(
			accountName = "Liferay, Inc.",
			contactEmailAddress = ${staticEmailValue2});

		KoroneikiAccountAPI._createAccount(table = '''| Code        | LFAZENLFAZEN                  | |
	| Data Region | Hungary                       | |
	| Language    | English                       | |
	| Name        | Lfazen - ${staticProjectName} | |
	| Region      | Hungary                       | |
	| Status      | Active                        | |
	| Tier        | T1                            | |''');

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Lfazen - ${staticProjectName}",
			contactEmailAddress = "lfa.customer1@lrcustomer.com.broken",
			table = '''| Support Requester |''');

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Lfazen - ${staticProjectName}",
			contactEmailAddress = ${staticEmailValue1},
			table = '''| Support Requester |''');

		KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Lfazen - ${staticProjectName}",
			productName = "Portal Production",
			table = '''| End Date                | ${staticEndDate}         |   |
	| Original End Date       | ${staticOriginalEndDate} |   |
	| Perpetual               | false                    |   |
	| Product Field and Value | sizing                   | 1 |
	| Product Field and Value | licenses                 | 1 |
	| Product Field and Value | version                  | 6 |
	| Quantity                | 1                        |   |
	| Start Date              | ${staticStartDate}       |   |
	| Status                  | Approved                 |   |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Lfazen - ${staticProjectName}",
			productName = "Gold Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Gold Subscription");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - Portal");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Liferay Employee");

		ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		JSONOSBAccount.viewSupportOrganizationSync(accountCode = "LFAZENLFAZEN");

		ZendeskOrganizationAPI._viewOrganizationSyncFromOsb(organizationName = "Lfazen - ${staticProjectName}");

		JSONUser.viewSupportUserSync(userEmailAddress = "lfa.customer1@lrcustomer.com.broken");

		JSONUser.viewSupportUserSync(userEmailAddress = ${staticEmailValue1});

		JSONUser.viewSupportUserSync(userEmailAddress = ${staticEmailValue2});

		JSONUser.updateSupportPassword(
			userEmailAddress = "lfa.customer1@lrcustomer.com.broken",
			userPassword = ${staticSupportUserTestPassword});

		JSONUser.updateSupportPassword(
			userEmailAddress = ${staticEmailValue1},
			userPassword = ${staticSupportUserTestPassword});

		JSONUser.updateSupportPassword(
			userEmailAddress = ${staticEmailValue2},
			userPassword = ${staticSupportUserTestPassword});

		JSONUser.assignUserToSupportOrganization(
			organizationName = "Data Access EU",
			userEmailAddress = ${staticEmailValue1});

		JSONUser.assignUserToSupportOrganization(
			organizationName = "Data Access US",
			userEmailAddress = ${staticEmailValue2});

		ZendeskUserAPI._updateUserPasswordByEmailAddress(
			userEmailAddress = "lfa.customer1@lrcustomer.com.broken",
			userPassword = ${staticZendeskAdminPassword});

		ZendeskUserAPI._updateUserPasswordByEmailAddress(
			userEmailAddress = ${staticEmailValue1},
			userPassword = ${staticZendeskAdminPassword});

		ZendeskUserAPI._updateUserPasswordByEmailAddress(
			userEmailAddress = ${staticEmailValue2},
			userPassword = ${staticZendeskAdminPassword});

		OSBAdmin.logoutAndLoginToSupport(
			userEmailAddress = "lfa.customer1@lrcustomer.com.broken",
			userPassword = ${staticSupportUserTestPassword});

		ZendeskHomepage.login(
			userEmailAddress = "lfa.customer1@lrcustomer.com.broken",
			userPassword = ${staticZendeskAdminPassword});

		ZendeskRequest.create(table = '''| Product       | Liferay Portal                          | 6.2                                   |
	| Component     | Activation Key & Project Administration |                                       |
	| System Status | Production                              | Functioning with limited capabilities |
	| Subject       | Request Subject                         |                                       |
	| Description   | Request Description                     |                                       |''');

		ZendeskRequest.uploadFileViaLargeFileUploader(table = '''| Attachment       | Document_1.txt     |
	| Comment          | Large File Comment |
	| Data Region      | European Union     |
	| No Personal Data | true               |''');

		ZendeskRequest.uploadFileViaLargeFileUploader(table = '''| Attachment       | Document_2.txt     |
	| Comment          | Large File Comment |
	| Data Region      | European Union     |
	| No Personal Data | false              |''');

		OSBAdmin.logoutAndLoginToSupport(
			userEmailAddress = ${staticEmailValue1},
			userPassword = ${staticSupportUserTestPassword});

		ProjectDetails.gotoProjectDetailsPage();

		ProjectDetails.searchKeyword(keyword = "Lfazen");

		ProjectDetails.gotoProject(projectName = "Lfazen - ${staticProjectName}");

		ProjectDetails.gotoAttachments();

		ProjectDetails.downloadAttachmentViaActionLink(fileKeyword = "Document_1.txt");

		Downloads.viewDownloadedFile(fileName = "Document_1.txt");

		ProjectDetails.downloadAttachmentViaActionLink(fileKeyword = "Document_2.txt");

		Downloads.viewDownloadedFile(fileName = "Document_2.txt");

		OSBAdmin.logoutAndLoginToSupport(
			userEmailAddress = ${staticEmailValue2},
			userPassword = ${staticSupportUserTestPassword});

		ProjectDetails.gotoProjectDetailsPage();

		ProjectDetails.searchKeyword(keyword = "Lfazen");

		ProjectDetails.gotoProject(projectName = "Lfazen - ${staticProjectName}");

		ProjectDetails.gotoAttachments();

		ProjectDetails.downloadAttachmentViaActionLink(fileKeyword = "Document_1.txt");

		Downloads.viewDownloadedFile(fileName = "Document_1 (1).txt");

		ProjectDetails.assertFileNameLinkNotClickable(fileKeyword = "Document_2.txt");

		Downloads.viewNoDownloadedFile(fileName = "Document_2 (1).txt");
	}

	test Downloadcustomerlargefilesasemployee {
		Data.generateSupportUser();

		Data._renameFirstSupportUserVariables();

		JSONOkta.createOktaUser(table = '''| Screen Name   | ${staticScreenNameValue1}        |
	| Email Address | ${staticEmailValue1}             |
	| First Name    | ${staticContactFirstNameValue1}  |
	| Last Name     | ${staticContactLastNameValue1}   |
	| Group         | Employees                        |
	| Group         | Division - Subscription Services |''');

		KoroneikiContactAPI._viewContactSyncViaEmailAddress(contactEmailAddress = ${staticEmailValue1});

		KoroneikiContactAPI._viewAccountSyncViaUuid(
			accountName = "Liferay, Inc.",
			contactEmailAddress = ${staticEmailValue1});

		KoroneikiAccountAPI._createAccount(table = '''| Code        | LFAZENLFAZEN                  | |
	| Data Region | United States                 | |
	| Language    | English                       | |
	| Name        | Lfazen - ${staticProjectName} | |
	| Region      | United States                 | |
	| Status      | Active                        | |
	| Tier        | T1                            | |''');

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Lfazen - ${staticProjectName}",
			contactEmailAddress = "lfa.customer1@lrcustomer.com.broken",
			table = '''| Support Requester |''');

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Lfazen - ${staticProjectName}",
			contactEmailAddress = ${staticEmailValue1},
			table = '''| Support Requester |''');

		KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Lfazen - ${staticProjectName}",
			productName = "Portal Production",
			table = '''| End Date                | ${staticEndDate}         |   |
	| Original End Date       | ${staticOriginalEndDate} |   |
	| Perpetual               | false                    |   |
	| Product Field and Value | sizing                   | 1 |
	| Product Field and Value | licenses                 | 1 |
	| Product Field and Value | version                  | 6 |
	| Quantity                | 1                        |   |
	| Start Date              | ${staticStartDate}       |   |
	| Status                  | Approved                 |   |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Lfazen - ${staticProjectName}",
			productName = "Gold Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Gold Subscription");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - Portal");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Liferay Employee");

		ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		JSONOSBAccount.viewSupportOrganizationSync(accountCode = "LFAZENLFAZEN");

		ZendeskOrganizationAPI._viewOrganizationSyncFromOsb(organizationName = "Lfazen - ${staticProjectName}");

		JSONUser.viewSupportUserSync(userEmailAddress = "lfa.customer1@lrcustomer.com.broken");

		JSONUser.viewSupportUserSync(userEmailAddress = ${staticEmailValue1});

		JSONUser.updateSupportPassword(
			userEmailAddress = "lfa.customer1@lrcustomer.com.broken",
			userPassword = ${staticSupportUserTestPassword});

		ZendeskUserAPI._updateUserPasswordByEmailAddress(
			userEmailAddress = "lfa.customer1@lrcustomer.com.broken",
			userPassword = ${staticZendeskAdminPassword});

		JSONUser.updateSupportPassword(
			userEmailAddress = ${staticEmailValue1},
			userPassword = ${staticSupportUserTestPassword});

		ZendeskUserAPI._updateUserPasswordByEmailAddress(
			userEmailAddress = ${staticEmailValue1},
			userPassword = ${staticZendeskAdminPassword});

		OSBAdmin.logoutAndLoginToSupport(
			userEmailAddress = "lfa.customer1@lrcustomer.com.broken",
			userPassword = ${staticSupportUserTestPassword});

		ZendeskHomepage.login(
			userEmailAddress = "lfa.customer1@lrcustomer.com.broken",
			userPassword = ${staticZendeskAdminPassword});

		ZendeskRequest.create(table = '''| Product       | Liferay Portal                          | 6.2                                   |
	| Component     | Activation Key & Project Administration |                                       |
	| System Status | Production                              | Functioning with limited capabilities |
	| Subject       | Request Subject                         |                                       |
	| Description   | Request Description                     |                                       |
	| Attachments   | Document_1.txt                          |                                       |''');

		ZendeskRequest.uploadFileViaLargeFileUploader(table = '''| Attachment       | Document_2.txt     |
	| Comment          | Large File Comment |
	| Data Region      | United States      |
	| No Personal Data | true               |''');

		ZendeskRequest.uploadFileViaLargeFileUploader(table = '''| Attachment       | Document_3.txt     |
	| Comment          | Large File Comment |
	| Data Region      | United States      |
	| No Personal Data | false              |''');

		OSBAdmin.logoutAndLoginToSupport(
			userEmailAddress = ${staticEmailValue1},
			userPassword = ${staticSupportUserTestPassword});

		ZendeskHomepage.login(
			userEmailAddress = ${staticEmailValue1},
			userPassword = ${staticZendeskAdminPassword});

		ZendeskRequest.gotoViaId(requestId = ${staticRequestId});

		ZendeskHomepage.acceptAllCookies();

		ZendeskRequest.downloadAttachedFile(
			fileName = "Document_1.txt",
			positionValue = 4);

		ZendeskRequest.downloadAttachedFileOnRequestDetails(attachmentName = "Document_1.txt");

		Downloads.viewDownloadedFile(fileName = "Document_1.txt");

		ZendeskRequest.downloadLargeFIle(
			commentContent = "Large File Comment",
			fileName = "Document_2.txt");

		Downloads.viewDownloadedFile(fileName = "Document_2.txt");

		ZendeskRequest.downloadLargeFIle(
			commentContent = "Large File Comment",
			fileName = "Document_3.txt");

		Downloads.viewNoDownloadedFile(fileName = "Document_3.txt");
	}

	test Downloadcustomerlargefilesaspartner {
		JSONOkta.createOktaUser(table = '''| Screen Name   | lfa.partner1                      |
	| Email Address | lfa.partner1@lrpartner.com.broken |
