definition {

	property testray.main.component.name = "Support QA";
	property type = "koroneiki";

	tearDown {
		KoroneikiContactAPI._tearDownContactExternalLinks(
			contactEmailAddress = "koroneiki.deletion1@lrcustomer.com.broken",
			table = '''| deletionexternallink |''');

		KoroneikiContactAPI._tearDownContactEntitlementDefinitions(table = '''| Deletion Entitlement |''');

		KoroneikiProductPurchaseAPI._tearDownProductPurchases(
			accountName = "Koroneiki Deletion",
			table = '''| Deletion Digital Experience Platform |''');

		KoroneikiProductAPI._tearDownProducts(table = '''| Deletion Digital Experience Platform |''');

		KoroneikiAccountAPI._tearDownAccounts(table = '''| Koroneiki Deletion |''');

		KoroneikiContactAPI._tearDownContacts(table = '''| koroneiki.deletion1@lrcustomer.com.broken |''');

		KoroneikiContactRoleAPI._tearDownContactRoles(table = '''| Deletion Account Worker Role |''');
	}

	test Deleteworkercontactwithentitlementandteamandexternallinks {
		KoroneikiAccountAPI._createAccount(table = '''| Code         | KORDEL                             | |
	| Description  | Test deletion account on koroneiki | |
	| Fax Number   | 555-555-1234                       | |
	| Name         | Koroneiki Deletion                 | |
	| Phone Number | 555-555-5678                       | |
	| Region       | United States                      | |
	| Status       | Active                             | |
	| Tier         | T4                                 | |
	| Website      | www.koroneikideletion.com          | |''');

		KoroneikiContactAPI._createContact(table = '''| Email Address | koroneiki.deletion1@lrcustomer.com.broken |
	| First Name    | Koroneiki                                 |
	| Language      | English                                   |
	| Last Name     | Deletion1                                 |
	| Middle Name   | User                                      |''');

		KoroneikiContactAPI._createContactExternalLinkViaUuid(
			contactEmailAddress = "koroneiki.deletion1@lrcustomer.com.broken",
			table = '''| Domain      | koroneiki            |
	| Entity Id   | deletionexternallink |
	| Entity Name | DeletionExternalLink |''');

		KoroneikiContactRoleAPI._createContactRole(table = '''| Description | This is the Deletion worker role for accounts |
	| Name        | Deletion Account Worker Role                  |
	| Type        | Account Worker                                |''');

		KoroneikiAccountAPI._assignWorkerContacts(
			accountName = "Koroneiki Deletion",
			table = '''| koroneiki.deletion1@lrcustomer.com.broken |''');

		KoroneikiTeamAPI._assignContacts(
			table = '''| koroneiki.deletion1@lrcustomer.com.broken |''',
			teamName = "Koroneiki Deletion");

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Koroneiki Deletion",
			contactEmailAddress = "koroneiki.deletion1@lrcustomer.com.broken",
			table = '''| Deletion Account Worker Role |''');

		KoroneikiProductAPI._createProduct(table = '''| Name | Deletion Digital Experience Platform | |''');

		KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Koroneiki Deletion",
			productName = "Deletion Digital Experience Platform",
			table = '''| End Date                | ${staticEndDate}   |                |
	| Perpetual               | true               |                |
	| Product Field and Value | additionalProp1    | propertyValue1 |
	| Product Field and Value | additionalProp2    | propertyValue2 |
	| Product Field and Value | additionalProp3    | propertyValue3 |
	| Quantity                | 1                  |                |
	| Start Date              | ${staticStartDate} |                |''');

		KoroneikiContactAPI._createContactEntitlementDefinition(
			contactRoleName = "Deletion Account Worker Role",
			contactRoleType = "Account Worker",
			productName = "Deletion Digital Experience Platform",
			table = '''| Description | Deletion Entitlement Description |
	| Name        | Deletion Entitlement             |
	| Status      | Approved                         |''');

		KoroneikiContactAPI._viewContactEntitlementDefinition(
			entitlementDefinitionName = "Deletion Entitlement",
			table = '''| Description | Deletion Entitlement Description |
	| Name        | Deletion Entitlement             |
	| Status      | Approved                         |''');

		KoroneikiContactAPI._viewContactEntitlementDefinitionViaEntitlementDefinitionKey(
			entitlementDefinitionName = "Deletion Entitlement",
			table = '''| Description | Deletion Entitlement Description |
	| Name        | Deletion Entitlement             |
	| Status      | Approved                         |''');

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Deletion Entitlement");

		KoroneikiContactAPI._createContactEntitlementNestedField(entitlementDefinitionName = "Deletion Entitlement");

		KoroneikiContactAPI._viewContactEntitlementViaNestedField(
			contactEmailAddress = "koroneiki.deletion1@lrcustomer.com.broken",
			entitlementDefinitionName = "Deletion Entitlement");

		KoroneikiContactAPI._viewContactExternalLinkViaUuid(
			contactEmailAddress = "koroneiki.deletion1@lrcustomer.com.broken",
			entityId = "deletionexternallink",
			table = '''| Domain      | koroneiki            |
	| Entity Id   | deletionexternallink |
	| Entity Name | DeletionExternalLink |''');

		KoroneikiContactAPI._deleteContactViaEmailAddress(contactEmailAddress = "koroneiki.deletion1@lrcustomer.com.broken");

		KoroneikiContactAPI._viewNoContact(contactEmailAddress = "koroneiki.deletion1@lrcustomer.com.broken");

		KoroneikiAccountAPI._viewNoWorkerContact(
			accountName = "Koroneiki Automotive",
			contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken");

		KoroneikiTeamAPI._viewNoContact(
			contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken",
			teamName = "Koroneiki Automotive");
	}

}