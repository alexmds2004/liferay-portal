definition {

	property testray.main.component.name = "Support QA";
	property type = "customer.integration";

	setUp {
		Passwords.getPasswords();

		KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		KoroneikiProductPurchaseAPI.generateStaticPastStartAndEndDate();

		KoroneikiProductPurchaseAPI.generateStaticFutureStartAndEndDate();

		OSBAdminRabbitMQ.generateProvisioningCompanyName();

		OSBAdminRabbitMQ.generateProvisioningProjectName();

		JSONOkta.createOktaUser(table = '''| Screen Name   | cstm.customer1                       |
	| Email Address | cstm.customer1@lrcustomer.com.broken |
	| First Name    | CSTM                                 |
	| Last Name     | Customer1                            |''');

		JSONOkta.createOktaUser(table = '''| Screen Name   | cstm.customer2                       |
	| Email Address | cstm.customer2@lrcustomer.com.broken |
	| First Name    | CSTM                                 |
	| Last Name     | Customer2                            |''');

		KoroneikiAccountAPI._createAccount(table = '''| Code   | KORCSTKORCST                  | |
	| Name   | Korcst - ${staticProjectName} | |
	| Region | United States                 | |
	| Status | Active                        | |
	| Tier   | T1                            | |''');

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Korcst - ${staticProjectName}",
			contactEmailAddress = "cstm.customer1@lrcustomer.com.broken",
			table = '''| Support Requester |''');

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Korcst - ${staticProjectName}",
			contactEmailAddress = "cstm.customer2@lrcustomer.com.broken",
			table = '''| Support User |''');
	}

	tearDown {
		KoroneikiTeamAPI._tearDownTeams(table = '''| CSTM Customer |''');

		OSBAdminProject.tearDownProjects(table = '''| KORCSTKORCST |
	| KORCT2KORCT2 |''');

		KoroneikiAccountAPI._tearDownAccounts(table = '''| Korcst - ${staticProjectName} |''');

		KoroneikiAccountAPI._tearDownAccountsViaAccountFieldNameAndValue(
			fieldName = "Code",
			table = '''| KORCSTKORCST |
	| KORCT2KORCT2 |''');

		JSONUser.tearDownUsers(table = '''| cstm.customer1@lrcustomer.com.broken |
	| cstm.customer2@lrcustomer.com.broken |''');

		JSONUser.tearDownUsersViaSupport(table = '''| cstm.customer1@lrcustomer.com.broken |
	| cstm.customer2@lrcustomer.com.broken |''');

		JSONUser.tearDownUsersViaKoroneiki(table = '''| cstm.customer1@lrcustomer.com.broken |
	| cstm.customer2@lrcustomer.com.broken |''');

		KoroneikiContactAPI._tearDownContacts(table = '''| cstm.customer1@lrcustomer.com.broken |
	| cstm.customer2@lrcustomer.com.broken |''');

		JSONOkta.tearDownUsers(table = '''| cstm.customer1@lrcustomer.com.broken |
	| cstm.customer2@lrcustomer.com.broken |''');
	}

	test ViewActiveaccountonCustomeraccountpage {
		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korcst - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korcst - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		Provisioning.gotoAccounts();

		Provisioning.searchAccounts(keyword = "Korcst");

		Provisioning.clickAccount(accountName = "Korcst - ${staticProjectName}");

		ProvisioningAccount.clickSyncToCustomerPortalButton();

		CustomerLogin.loginToCustomer(
			userEmailAddress = ${staticCustomerAdminEmailAddress},
			userPassword = ${staticCustomerAdminPassword});

		CustomerProjects.searchCustomerProject(keyword = "Korcst");

		CustomerProjects.clickCustomerProject(projectName = "Korcst - ${staticProjectName}");

		CustomerProjects._viewCustomerProjectDetails(
			projectName = "Korcst - ${staticProjectName}",
			table = '''| Name           | Korcst - ${staticProjectName} |
	| Code           | KORCSTKORCST                  |
	| State          | ACTIVE                        |
	| Support Region | United States                 |
	| SLA            | -                             |
	| Support Seats  | 0 / 0 Filled                  |
	| Tier           | T1                            |
	| FLS Partner    | -                             |''');
	}

