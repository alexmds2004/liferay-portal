definition {

	property testray.main.component.name = "Support QA";
	property type = "koroneiki";

	tearDown {
		LocalFile.KoroneikiContactAPI._tearDownContactPermissions(contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken");

		LocalFile.KoroneikiContactAPI._tearDownContactPermissions(contactEmailAddress = "koroneiki.contact2@lrcustomer.com.broken");

		LocalFile.KoroneikiContactAPI._tearDownContacts(table = '''| koroneiki.contact1@lrcustomer.com.broken |
	| koroneiki.contact2@lrcustomer.com.broken |''');
	}

	test Createcontactattemptasnonpermissioneduser {
		LocalFile.KoroneikiContactAPIPermissionCheck._createContactAttempt(table = '''| Email Address | koroneiki.contact1@lrcustomer.com.broken |
	| First Name    | Koroneiki                                |
	| Language      | English                                  |
	| Last Name     | Contact1                                 |
	| Middle Name   | User                                     |''');

		LocalFile.KoroneikiContactAPI._viewNoContact(contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken");
	}

