definition {

	property testray.main.component.name = "Support QA";
	property type = "auto.provisioning";

	setUp {
		LocalFile.Passwords.getPasswords();

		LocalFile.OSBAdminRabbitMQ.generateStaticVariables();

		LocalFile.OSBAdminRabbitMQ.generateProvisioningCompanyName();

		LocalFile.OSBAdminRabbitMQ.generateProvisioningProjectName();

		LocalFile.JSONOkta.createOktaUser(table = '''| Screen Name   | zen.koroneiki1                       |
	| Email Address | zen.koroneiki1@lrcustomer.com.broken |
	| First Name    | ZEN                                  |
	| Last Name     | Koroneiki1                           |''');

		LocalFile.JSONOkta.createOktaUser(table = '''| Screen Name   | zen.koroneiki2                       |
	| Email Address | zen.koroneiki2@lrcustomer.com.broken |
	| First Name    | ZEN                                  |
	| Last Name     | Koroneiki2                           |''');
	}

	tearDown {
		LocalFile.ZendeskUserAPI._getDefaultUserId(organizationName = "Korzen - ${staticProjectName}");

		LocalFile.ZendeskUserAPI._renameFirstDefaultUserIdVariable();

		LocalFile.ZendeskUserAPI._getDefaultUserId(organizationName = "Zenkor - ${staticCompanyName}");

		LocalFile.ZendeskUserAPI._renameSecondDefaultUserIdVariable();

		LocalFile.ZendeskUserAPI._getDefaultUserId(organizationName = "Zenpar - ${staticCompanyName}");

		LocalFile.ZendeskUserAPI._renameThirdDefaultUserIdVariable();

		LocalFile.ZendeskUserAPI._getDefaultUserId(organizationName = "Conpar - ${staticCompanyName}");

		LocalFile.ZendeskUserAPI._renameFourthDefaultUserIdVariable();

		LocalFile.OSBAdminProject.tearDownProjects(table = '''| ZENPAR       |
	| CONPAR       |
	| ZENKORKORZEN |
	| ZENKOR       |
	| ZENKOR1      |''');

		LocalFile.KoroneikiAccountAPI._tearDownAccounts(table = '''| Zenpar - ${staticCompanyName} |
	| Conpar - ${staticCompanyName} |''');

		LocalFile.KoroneikiAccountAPI._tearDownAccountsViaAccountFieldNameAndValue(
			fieldName = "Code",
			table = '''| ZENPAR |
	| CONPAR |''');

		LocalFile.KoroneikiAccountAPI._tearDownAccounts(table = '''| Korzen - ${staticProjectName} |
	| Zenkor - ${staticCompanyName} |''');

		LocalFile.KoroneikiAccountAPI._tearDownAccountsViaAccountFieldNameAndValue(
			fieldName = "Code",
			table = '''| ZENKORKORZEN |
	| ZENKOR       |
	| ZENKOR1      |''');

		LocalFile.JSONUser.tearDownUsers(table = '''| zen.koroneiki1@lrcustomer.com.broken |
	| zen.koroneiki2@lrcustomer.com.broken |''');

		LocalFile.JSONUser.tearDownUsersViaSupport(table = '''| zen.koroneiki1@lrcustomer.com.broken |
	| zen.koroneiki2@lrcustomer.com.broken |''');

		LocalFile.JSONUser.tearDownUsersViaKoroneiki(table = '''| zen.koroneiki1@lrcustomer.com.broken |
	| zen.koroneiki2@lrcustomer.com.broken |''');

		LocalFile.KoroneikiContactAPI._tearDownContacts(table = '''| zen.koroneiki1@lrcustomer.com.broken |
	| zen.koroneiki2@lrcustomer.com.broken |''');

		LocalFile.JSONOkta.tearDownUsers(table = '''| zen.koroneiki1@lrcustomer.com.broken |
	| zen.koroneiki2@lrcustomer.com.broken |''');

		LocalFile.ZendeskTicketAPI._tearDownTicketsByKeywords(table = '''| New Subscription(s) for Korzen - ${staticProjectName} |
	| New Subscription(s) for Zenkor - ${staticCompanyName} |
	| Korzen - ${staticProjectName}                         |''');

		LocalFile.ZendeskUserAPI._getMultipleUserIdsByEmailAddress(table = '''| zen.koroneiki1@lrcustomer.com.broken |
	| zen.koroneiki2@lrcustomer.com.broken |''');

		LocalFile.ZendeskUserAPI._tearDownUsersByIdList(userIds = ${staticUserIdList});

		LocalFile.ZendeskOrganizationAPI._getMultipleOrganizationExternalIdsByOrganizationNameIfStillPresent(table = '''| Zenpar - ${staticCompanyName} |
	| Conpar - ${staticCompanyName} |
	| Korzen - ${staticProjectName} |
	| Zenkor - ${staticCompanyName} |''');

		LocalFile.ZendeskOrganizationAPI._tearDownOrganizationsByExternalIdList(organizationExternalIds = ${staticOrganizationExternalIdList});

		LocalFile.ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId1});

		LocalFile.ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId2});

		LocalFile.ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId3});

		LocalFile.ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId4});
	}

	test Viewflswarningonly {
		LocalFile.KoroneikiAccountAPI._createAccount(table = '''| Code   | ZENKOR                        | |
	| Name   | Zenkor - ${staticCompanyName} | |
	| Status | Active                        | |
	| Tier   | T4                            | |''');

		LocalFile.KoroneikiAccountAPI._createChildAccount(
			accountName = "Zenkor - ${staticCompanyName}",
			table = '''| Code   | ZENKORKORZEN                  | |
	| Name   | Korzen - ${staticProjectName} | |
	| Region | United States                 | |
	| Status | Active                        | |
	| Tier   | T4                            | |''');

		LocalFile.KoroneikiAccountAPI._createAccount(table = '''| Code   | ZENPAR                        | |
	| Name   | Zenpar - ${staticCompanyName} | |
	| Status | Active                        | |
	| Tier   | T4                            | |''');

		LocalFile.KoroneikiAccountAPI._createAccountExternalLink(
			accountName = "Zenkor - ${staticCompanyName}",
			table = '''| Domain      | salesforce                  |
	| Entity Id   | ${staticDossieraAccountKey} |
	| Entity Name | account                     |''');

		LocalFile.KoroneikiAccountAPI._createAccountExternalLink(
			accountName = "Zenkor - ${staticCompanyName}",
			table = '''| Domain      | dossiera                    |
	| Entity Id   | ${staticDossieraAccountKey} |
	| Entity Name | account                     |''');

		LocalFile.KoroneikiAccountAPI._createAccountExternalLink(
			accountName = "Zenpar - ${staticCompanyName}",
			table = '''| Domain      | salesforce         |
	| Entity Id   | efghabcd7890123456 |
	| Entity Name | account            |''');

		LocalFile.KoroneikiAccountAPI._createAccountExternalLink(
			accountName = "Zenpar - ${staticCompanyName}",
			table = '''| Domain      | dossiera           |
	| Entity Id   | efghabcd7890123456 |
	| Entity Name | account            |''');

		LocalFile.KoroneikiAccountAPI._createAccountExternalLink(
			accountName = "Korzen - ${staticProjectName}",
			table = '''| Domain      | salesforce                  |
	| Entity Id   | ${staticDossieraAccountKey} |
	| Entity Name | account                     |''');

		LocalFile.KoroneikiAccountAPI._createAccountExternalLink(
			accountName = "Korzen - ${staticProjectName}",
			table = '''| Domain      | dossiera                    |
	| Entity Id   | ${staticDossieraProjectKey} |
	| Entity Name | project                     |''');

		LocalFile.KoroneikiAccountAPI._createAccountExternalLink(
			accountName = "Korzen - ${staticProjectName}",
			table = '''| Domain      | salesforce                    |
	| Entity Id   | ${staticSalesforceProjectKey} |
	| Entity Name | project                       |''');

		LocalFile.KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		LocalFile.KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Zenpar - ${staticCompanyName}",
			productName = "Service Partnership",
			table = '''| Perpetual   | true     | |
	| Quantity    | 1        | |
	| Status      | Approved | |''');

		LocalFile.KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Partner");

		LocalFile.OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		LocalFile.Provisioning.gotoAccounts();

		LocalFile.Provisioning.searchAccounts(keyword = "Korzen");

		LocalFile.Provisioning.removeAdvancedSearchFilters(table = '''| Subscription State: Active      |
	| Subscription State: Cancelled   |
	| Subscription State: Expired     |
	| Subscription State: Unactivated |''');

		LocalFile.Provisioning.clickAccount(accountName = "Korzen - ${staticProjectName}");

		LocalFile.Provisioning.clickTab(tabName = "Details");

		LocalFile.ProvisioningAccount.editAccountDetails(table = '''| Partner/Reseller/SI | Select Entity | Zenpar - ${staticCompanyName} | |
	| First Line Support  | Select Entity | Zenpar - ${staticCompanyName} | |''');

		LocalFile.ProvisioningAccount._viewAccountDetails(table = '''| Name        | Korzen - ${staticProjectName} |
	| FLS Partner | Zenpar - ${staticCompanyName} |''');

		LocalFile.KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Korzen - ${staticProjectName}",
			contactEmailAddress = "zen.koroneiki1@lrcustomer.com.broken",
			table = '''| Support Administrator |''');

		LocalFile.KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Korzen - ${staticProjectName}",
			contactEmailAddress = "zen.koroneiki2@lrcustomer.com.broken",
			table = '''| Liferay Sales |''');

		LocalFile.KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Korzen - ${staticProjectName}",
			contactEmailAddress = "zen.koroneiki2@lrcustomer.com.broken",
			table = '''| Secondary Contact |''');

		LocalFile.OSBAdminRabbitMQ.publishCreateProjectMessage(
			routingKey = "dossiera.provisioning.create",
			table = '''| Account Name                           | Zenkor - ${staticCompanyName}              |
	| Address City                           | Diamond Bar                                |
	| Address Country                        | United States                              |
	| Address Postal Code                    | 91765                                      |
	| Address Region                         | California                                 |
	| Address Street                         | 456 Fake Street                            |
	| Contact Email Address                  | zen.koroneiki1@lrcustomer.com.broken       |
	| Contact First Name                     | ZEN                                        |
	| Contact Last Name                      | Koroneiki1                                 |
	| Dossiera Account Key                   | ${staticDossieraAccountKey}                |
	| Dossiera Address Key 1                 | ${staticDossieraAddressKey1}               |
	| Dossiera Address Key 2                 | ${staticDossieraAddressKey2}               |
	| Dossiera Contact Key                   | ${staticDossieraContactKey}                |
	| Dossiera Project Key                   | ${staticDossieraProjectKey}                |
	| End Day                                | ${staticEndDay}                            |
	| End Month                              | ${staticEndMonth}                          |
	| End Year                               | ${staticEndYear}                           |
	| Industry                               | Automotive                                 |
	| Owner Email Address                    | zen.koroneiki2@lrcustomer.com.broken       |
	| Owner First Name                       | ZEN                                        |
	| Owner Last Name                        | Koroneiki2                                 |
	| Partner First Line Support             | false                                      |
	| Partner Dossiera Key                   | efghabcd7890123456                         |
	| Partner Name                           | Zenpar - ${staticCompanyName}              |
	| Partner Support Level                  | Platinum                                   |
	| Product Type                           | New                                        |
	| Product Name                           | Liferay Digital Enterprise - Prod Sizing 4 |
	| Project Name                           | Korzen - ${staticProjectName}              |
	| Renewal                                | false                                      |
	| Salesforce Opportunity Key             | ${staticSalesforceOpportunityKey}          |
	| Salesforce Opportunity Line Item Key 1 | ${staticSalesforceOpportunityLineItemKey1} |
	| Salesforce Opportunity Line Item Key 2 | ${staticSalesforceOpportunityLineItemKey2} |
	| Salesforce Opportunity Sold By         | Liferay US                                 |
	| Salesforce Opportunity Stage Name      | Closed Won                                 |
	| Salesforce Opportunity Territory       | United States                              |
	| Salesforce Opportunity Type            | Existing Business                          |
	| Salesforce Owner User Key              | ${staticSalesforceOwnerUserKey}            |
	| Salesforce Project Key                 | ${staticSalesforceProjectKey}              |
	| Start Day                              | ${staticStartDay}                          |
	| Start Month                            | ${staticStartMonth}                        |
	| Start Year                             | ${staticStartYear}                         |
	| Subscription Level                     | Platinum                                   |
	| Version Number                         | 7.1                                        |''');

		LocalFile.ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		LocalFile.ZendeskTicketAPI._viewTicketSyncByKeywords(keywords = "New Subscription(s) for Korzen - ${staticProjectName}");

		LocalFile.ZendeskTicketAPI._viewTicketSubject(
			keywords = "New Subscription(s) for Korzen - ${staticProjectName}",
			subject = "[Warning] Existing Business: New Subscription(s) for Korzen - ${staticProjectName}");

		LocalFile.ZendeskTicketAPI._viewTicketDescription(
			descriptionText = "Account Name: Korzen - ${staticProjectName}",
			keywords = "New Subscription(s) for Korzen - ${staticProjectName}");

		LocalFile.ZendeskTicketAPI._viewTicketDescription(
			descriptionText = "Account Code: ZENKORKORZEN",
			keywords = "New Subscription(s) for Korzen - ${staticProjectName}");

		LocalFile.ZendeskTicketAPI._viewTicketDescription(
			descriptionText = "Opportunity Type: Existing Business",
			keywords = "New Subscription(s) for Korzen - ${staticProjectName}");

		LocalFile.ZendeskTicketAPI._viewTicketDescription(
			descriptionText = "Warning",
			keywords = "New Subscription(s) for Korzen - ${staticProjectName}");

		LocalFile.ZendeskTicketAPI._viewTicketDescription(
			descriptionText = "The FLS partner account (N/A) is different from the existing FLS partner account (Zenpar - ${staticCompanyName})",
			keywords = "New Subscription(s) for Korzen - ${staticProjectName}");

		LocalFile.ZendeskTicketAPI._viewTicketDescription(
			descriptionText = "New DXP Production (1)",
			keywords = "New Subscription(s) for Korzen - ${staticProjectName}");

		LocalFile.ZendeskTicketAPI._viewTicketDescription(
			descriptionText = "New Platinum Subscription",
			keywords = "New Subscription(s) for Korzen - ${staticProjectName}");

		LocalFile.ZendeskTicketAPI._viewTicketDescription(
			descriptionText = "Start Date - End Date: ${staticStartYear}",
			keywords = "New Subscription(s) for Korzen - ${staticProjectName}");

		LocalFile.ZendeskTicketAPI._viewTicketDescription(
			descriptionText = "US Provisioning - Working with 2019 H2 Pricing Promotions: Grow Link",
			keywords = "New Subscription(s) for Korzen - ${staticProjectName}");

		LocalFile.ZendeskTicketAPI._viewTicketRequester(
			keywords = "New Subscription(s) for Korzen - ${staticProjectName}",
			requesterEmailAddress = "provisioningrequest@liferay.com");

		LocalFile.ZendeskTicketAPI._viewTicketOrganizationByKeywords(
			keywords = "New Subscription(s) for Korzen - ${staticProjectName}",
			organizationName = "Provisioning");

		LocalFile.ZendeskTicketAPI._viewTicketProduct(
			keywords = "New Subscription(s) for Korzen - ${staticProjectName}",
			product = "prd_provisioning_request");

		LocalFile.ZendeskTicketAPI._viewTicketProvisioningComponent(
			keywords = "New Subscription(s) for Korzen - ${staticProjectName}",
			provisioningComponent = "opportunity_invoiced");

		LocalFile.ZendeskTicketAPI._viewTicketSupportRegion(
			keywords = "New Subscription(s) for Korzen - ${staticProjectName}",
			supportRegion = "provisioning_united_states");

		LocalFile.ZendeskTicketAPI._viewTicketOpportunityOwner(
			keywords = "New Subscription(s) for Korzen - ${staticProjectName}",
			opportunityOwner = "zen.koroneiki2@lrcustomer.com.broken");

		LocalFile.ZendeskTicketAPI._viewTicketEmailCc(
			keywords = "New Subscription(s) for Korzen - ${staticProjectName}",
			userEmailAddress = "zen.koroneiki2@lrcustomer.com.broken");

		LocalFile.ZendeskTicketAPI._viewTicketPrimaryAddressCountry(
			keywords = "New Subscription(s) for Korzen - ${staticProjectName}",
			primaryAddressCountry = "United States");
	}

	test Viewflswarningonlycausedbynoexistingfls {
		LocalFile.KoroneikiAccountAPI._createAccount(table = '''| Code   | ZENKOR                        | |
	| Name   | Zenkor - ${staticCompanyName} | |
	| Status | Active                        | |
	| Tier   | T4                            | |''');

		LocalFile.KoroneikiAccountAPI._createChildAccount(
			accountName = "Zenkor - ${staticCompanyName}",
			table = '''| Code   | ZENKORKORZEN                  | |
	| Name   | Korzen - ${staticProjectName} | |
	| Region | United States                 | |
	| Status | Active                        | |
	| Tier   | T4                            | |''');

		LocalFile.KoroneikiAccountAPI._createAccount(table = '''| Code   | ZENPAR                        | |
	| Name   | Zenpar - ${staticCompanyName} | |
	| Status | Active                        | |
	| Tier   | T4                            | |''');

		LocalFile.KoroneikiAccountAPI._createAccountExternalLink(
			accountName = "Zenkor - ${staticCompanyName}",
			table = '''| Domain      | salesforce                  |
	| Entity Id   | ${staticDossieraAccountKey} |
	| Entity Name | account                     |''');

		LocalFile.KoroneikiAccountAPI._createAccountExternalLink(
			accountName = "Zenkor - ${staticCompanyName}",
			table = '''| Domain      | dossiera                    |
	| Entity Id   | ${staticDossieraAccountKey} |
	| Entity Name | account                     |''');

		LocalFile.KoroneikiAccountAPI._createAccountExternalLink(
			accountName = "Zenpar - ${staticCompanyName}",
			table = '''| Domain      | salesforce         |
	| Entity Id   | efghabcd7890123456 |
	| Entity Name | account            |''');

		LocalFile.KoroneikiAccountAPI._createAccountExternalLink(
			accountName = "Zenpar - ${staticCompanyName}",
			table = '''| Domain      | dossiera           |
	| Entity Id   | efghabcd7890123456 |
	| Entity Name | account            |''');

		LocalFile.KoroneikiAccountAPI._createAccountExternalLink(
			accountName = "Korzen - ${staticProjectName}",
			table = '''| Domain      | salesforce                  |
	| Entity Id   | ${staticDossieraAccountKey} |
	| Entity Name | account                     |''');

		LocalFile.KoroneikiAccountAPI._createAccountExternalLink(
			accountName = "Korzen - ${staticProjectName}",
			table = '''| Domain      | dossiera                    |
	| Entity Id   | ${staticDossieraProjectKey} |
	| Entity Name | project                     |''');

		LocalFile.KoroneikiAccountAPI._createAccountExternalLink(
			accountName = "Korzen - ${staticProjectName}",
			table = '''| Domain      | salesforce                    |
	| Entity Id   | ${staticSalesforceProjectKey} |
	| Entity Name | project                       |''');

		LocalFile.KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		LocalFile.KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Zenpar - ${staticCompanyName}",
			productName = "Service Partnership",
			table = '''| Perpetual   | true     | |
	| Quantity    | 1        | |
	| Status      | Approved | |''');

		LocalFile.KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Partner");

		LocalFile.OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		LocalFile.Provisioning.gotoAccounts();

		LocalFile.Provisioning.searchAccounts(keyword = "Korzen");

		LocalFile.Provisioning.removeAdvancedSearchFilters(table = '''| Subscription State: Active      |
	| Subscription State: Cancelled   |
	| Subscription State: Expired     |
	| Subscription State: Unactivated |''');

		LocalFile.Provisioning.clickAccount(accountName = "Korzen - ${staticProjectName}");

		LocalFile.Provisioning.clickTab(tabName = "Details");

		LocalFile.ProvisioningAccount.editAccountDetails(table = '''| Partner/Reseller/SI | Select Entity | Zenpar - ${staticCompanyName} | |''');

		LocalFile.ProvisioningAccount._viewAccountDetails(table = '''| Name        | Korzen - ${staticProjectName} |
	| FLS Partner | -                             |''');

		LocalFile.KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Korzen - ${staticProjectName}",
			contactEmailAddress = "zen.koroneiki1@lrcustomer.com.broken",
			table = '''| Support Administrator |''');

		LocalFile.KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Korzen - ${staticProjectName}",
			contactEmailAddress = "zen.koroneiki2@lrcustomer.com.broken",
			table = '''| Liferay Sales |''');

		LocalFile.KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Korzen - ${staticProjectName}",
			contactEmailAddress = "zen.koroneiki2@lrcustomer.com.broken",
			table = '''| Secondary Contact |''');

		LocalFile.OSBAdminRabbitMQ.publishCreateProjectMessage(
			routingKey = "dossiera.provisioning.create",
			table = '''| Account Name                           | Zenkor - ${staticCompanyName}              |
	| Address City                           | Diamond Bar                                |
	| Address Country                        | United States                              |
	| Address Postal Code                    | 91765                                      |
	| Address Region                         | California                                 |
	| Address Street                         | 456 Fake Street                            |
	| Contact Email Address                  | zen.koroneiki1@lrcustomer.com.broken       |
	| Contact First Name                     | ZEN                                        |
	| Contact Last Name                      | Koroneiki1                                 |
	| Dossiera Account Key                   | ${staticDossieraAccountKey}                |
	| Dossiera Address Key 1                 | ${staticDossieraAddressKey1}               |
	| Dossiera Address Key 2                 | ${staticDossieraAddressKey2}               |
	| Dossiera Contact Key                   | ${staticDossieraContactKey}                |
	| Dossiera Project Key                   | ${staticDossieraProjectKey}                |
	| End Day                                | ${staticEndDay}                            |
	| End Month                              | ${staticEndMonth}                          |
	| End Year                               | ${staticEndYear}                           |
	| Industry                               | Automotive                                 |
	| Owner Email Address                    | zen.koroneiki2@lrcustomer.com.broken       |
	| Owner First Name                       | ZEN                                        |
	| Owner Last Name                        | Koroneiki2                                 |
	| Partner First Line Support             | true                                       |
	| Partner Dossiera Key                   | efghabcd7890123456                         |
	| Partner Name                           | Zenpar - ${staticCompanyName}              |
	| Partner Support Level                  | Platinum                                   |
	| Product Type                           | New                                        |
	| Product Name                           | Liferay Digital Enterprise - Prod Sizing 4 |
	| Project Name                           | Korzen - ${staticProjectName}              |
	| Renewal                                | false                                      |
	| Salesforce Opportunity Key             | ${staticSalesforceOpportunityKey}          |
	| Salesforce Opportunity Line Item Key 1 | ${staticSalesforceOpportunityLineItemKey1} |
	| Salesforce Opportunity Line Item Key 2 | ${staticSalesforceOpportunityLineItemKey2} |
	| Salesforce Opportunity Sold By         | Liferay US                                 |
	| Salesforce Opportunity Stage Name      | Closed Won                                 |
	| Salesforce Opportunity Territory       | United States                              |
	| Salesforce Opportunity Type            | Existing Business                          |
	| Salesforce Owner User Key              | ${staticSalesforceOwnerUserKey}            |
	| Salesforce Project Key                 | ${staticSalesforceProjectKey}              |
	| Start Day                              | ${staticStartDay}                          |
	| Start Month                            | ${staticStartMonth}                        |
	| Start Year                             | ${staticStartYear}                         |
	| Subscription Level                     | Platinum                                   |
	| Version Number                         | 7.1                                        |''');

		LocalFile.ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		LocalFile.ZendeskTicketAPI._viewTicketSyncByKeywords(keywords = "New Subscription(s) for Korzen - ${staticProjectName}");

		LocalFile.ZendeskTicketAPI._viewTicketSubject(
			keywords = "New Subscription(s) for Korzen - ${staticProjectName}",
			subject = "[Warning] Existing Business: New Subscription(s) for Korzen - ${staticProjectName}");

		LocalFile.ZendeskTicketAPI._viewTicketDescription(
			descriptionText = "Account Name: Korzen - ${staticProjectName}",
			keywords = "New Subscription(s) for Korzen - ${staticProjectName}");

		LocalFile.ZendeskTicketAPI._viewTicketDescription(
			descriptionText = "Account Code: ZENKORKORZEN",
			keywords = "New Subscription(s) for Korzen - ${staticProjectName}");

		LocalFile.ZendeskTicketAPI._viewTicketDescription(
			descriptionText = "Opportunity Type: Existing Business",
			keywords = "New Subscription(s) for Korzen - ${staticProjectName}");

		LocalFile.ZendeskTicketAPI._viewTicketDescription(
			descriptionText = "Warning",
			keywords = "New Subscription(s) for Korzen - ${staticProjectName}");

		LocalFile.ZendeskTicketAPI._viewTicketDescription(
			descriptionText = "The FLS partner account (Zenpar - ${staticCompanyName}) is different from the existing FLS partner account (N/A)",
			keywords = "New Subscription(s) for Korzen - ${staticProjectName}");

		LocalFile.ZendeskTicketAPI._viewTicketDescription(
			descriptionText = "New DXP Production (1)",
			keywords = "New Subscription(s) for Korzen - ${staticProjectName}");

		LocalFile.ZendeskTicketAPI._viewTicketDescription(
			descriptionText = "New Platinum Subscription",
			keywords = "New Subscription(s) for Korzen - ${staticProjectName}");

		LocalFile.ZendeskTicketAPI._viewTicketDescription(
			descriptionText = "Start Date - End Date: ${staticStartYear}",
			keywords = "New Subscription(s) for Korzen - ${staticProjectName}");

		LocalFile.ZendeskTicketAPI._viewTicketDescription(
			descriptionText = "US Provisioning - Working with 2019 H2 Pricing Promotions: Grow Link",
			keywords = "New Subscription(s) for Korzen - ${staticProjectName}");

		LocalFile.ZendeskTicketAPI._viewTicketRequester(
			keywords = "New Subscription(s) for Korzen - ${staticProjectName}",
			requesterEmailAddress = "provisioningrequest@liferay.com");

