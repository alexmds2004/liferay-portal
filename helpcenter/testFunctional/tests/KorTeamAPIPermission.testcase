definition {

	property testray.main.component.name = "Support QA";
	property type = "koroneiki";

	tearDown {
		LocalFile.KoroneikiTeamAPI._tearDownTeamPermissions(teamName = "Development Team");

		LocalFile.KoroneikiTeamAPI._tearDownTeamPermissions(teamName = "Engineering Team");

		LocalFile.KoroneikiTeamAPI._tearDownTeams(table = '''| Development Team |
	| Engineering Team |''');

		LocalFile.KoroneikiAccountAPI._tearDownAccounts(table = '''| Koroneiki Automotive |''');
	}

	test Createteamattemptbynonpermissioneduser {
		LocalFile.KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORAUTO                                  | |
	| Contact Email Address | koroneiki.contact1@lrcustomer.com.broken | |
	| Description           | Test automotive account on koroneiki     | |
	| Fax Number            | 555-555-1234                             | |
	| Name                  | Koroneiki Automotive                     | |
	| Phone Number          | 555-555-5678                             | |
	| Profile Email Address | koroneiki.contact1@lrcustomer.com.broken | |
	| Region                | United States                            | |
	| Status                | Active                                   | |
	| Tier                  | T4                                       | |
	| Website               | www.koroneikiautomotive.com              | |''');

		LocalFile.KoroneikiAccountAPIPermissionCheck._createAccountTeamAttempt(
			accountName = "Koroneiki Automotive",
			teamName = "Development Team");

		LocalFile.KoroneikiTeamAPI._viewNoTeam(teamName = "Development Team");

		LocalFile.KoroneikiAccountAPI._viewNoAccountTeam(
			accountName = "Koroneiki Automotive",
			teamName = "Development Team");
	}

	test Createteamexternallinkattemptasnonpermissioneduser {
		LocalFile.KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORAUTO                                  | |
	| Contact Email Address | koroneiki.contact1@lrcustomer.com.broken | |
	| Description           | Test automotive account on koroneiki     | |
	| Fax Number            | 555-555-1234                             | |
	| Name                  | Koroneiki Automotive                     | |
	| Phone Number          | 555-555-5678                             | |
	| Profile Email Address | koroneiki.contact1@lrcustomer.com.broken | |
	| Region                | United States                            | |
	| Status                | Active                                   | |
	| Tier                  | T4                                       | |
	| Website               | www.koroneikiautomotive.com              | |''');

		LocalFile.KoroneikiAccountAPI._createAccountTeam(
			accountName = "Koroneiki Automotive",
			teamName = "Development Team");

		LocalFile.KoroneikiTeamAPIPermissionCheck._createTeamExternalLinkAttempt(
			table = '''| Domain      | devteam |
	| Entity Id   | 1234    |
	| Entity Name | DevTeam |''',
			teamName = "Development Team");

		LocalFile.KoroneikiTeamAPI._viewNoTeamExternalLink(
			entityId = 1234,
			teamName = "Development Team");
	}

	test Deleteteambypermissioneduser {
		LocalFile.KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORAUTO                                  | |
	| Contact Email Address | koroneiki.contact1@lrcustomer.com.broken | |
	| Description           | Test automotive account on koroneiki     | |
	| Fax Number            | 555-555-1234                             | |
	| Name                  | Koroneiki Automotive                     | |
