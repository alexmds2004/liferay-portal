definition {

	property testray.main.component.name = "Support QA";
	property type = "koroneiki";

	tearDown {
		KoroneikiTeamAPI._tearDownTeamPermissions(teamName = "Development Team");

		KoroneikiTeamAPI._tearDownTeamPermissions(teamName = "Engineering Team");

		KoroneikiTeamAPI._tearDownTeams(table = '''| Development Team |
	| Engineering Team |''');

		KoroneikiAccountAPI._tearDownAccounts(table = '''| Koroneiki Automotive |''');
	}

	test Createteamattemptbynonpermissioneduser {
		KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORAUTO                                  | |
	| Contact Email Address | koroneiki.contact1@lrcustomer.com.broken | |
	| Description           | Test automotive account on koroneiki     | |
	| Fax Number            | 555-555-1234                             | |
	| Name                  | Koroneiki Automotive                     | |
	| Phone Number          | 555-555-5678                             | |
	| Profile Email Address | koroneiki.contact1@lrcustomer.com.broken | |
	| Region                | United States                            | |
	| Status                | Active                                   | |
	| Tier                  | T4                                       | |
	| Website               | www.koroneikiautomotive.com              | |''');

		KoroneikiAccountAPIPermissionCheck._createAccountTeamAttempt(
			accountName = "Koroneiki Automotive",
			teamName = "Development Team");

		KoroneikiTeamAPI._viewNoTeam(teamName = "Development Team");

		KoroneikiAccountAPI._viewNoAccountTeam(
			accountName = "Koroneiki Automotive",
			teamName = "Development Team");
	}

	test Createteamexternallinkattemptasnonpermissioneduser {
		KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORAUTO                                  | |
	| Contact Email Address | koroneiki.contact1@lrcustomer.com.broken | |
	| Description           | Test automotive account on koroneiki     | |
	| Fax Number            | 555-555-1234                             | |
	| Name                  | Koroneiki Automotive                     | |
	| Phone Number          | 555-555-5678                             | |
	| Profile Email Address | koroneiki.contact1@lrcustomer.com.broken | |
	| Region                | United States                            | |
	| Status                | Active                                   | |
	| Tier                  | T4                                       | |
	| Website               | www.koroneikiautomotive.com              | |''');

		KoroneikiAccountAPI._createAccountTeam(
			accountName = "Koroneiki Automotive",
			teamName = "Development Team");

		KoroneikiTeamAPIPermissionCheck._createTeamExternalLinkAttempt(
			table = '''| Domain      | devteam |
	| Entity Id   | 1234    |
	| Entity Name | DevTeam |''',
			teamName = "Development Team");

		KoroneikiTeamAPI._viewNoTeamExternalLink(
			entityId = 1234,
			teamName = "Development Team");
	}

	test Deleteteambypermissioneduser {
		KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORAUTO                                  | |
	| Contact Email Address | koroneiki.contact1@lrcustomer.com.broken | |
	| Description           | Test automotive account on koroneiki     | |
	| Fax Number            | 555-555-1234                             | |
	| Name                  | Koroneiki Automotive                     | |
	| Phone Number          | 555-555-5678                             | |
	| Profile Email Address | koroneiki.contact1@lrcustomer.com.broken | |
	| Region                | United States                            | |
	| Status                | Active                                   | |
	| Tier                  | T4                                       | |
	| Website               | www.koroneikiautomotive.com              | |''');

		KoroneikiAccountAPI._createAccountTeam(
			accountName = "Koroneiki Automotive",
			teamName = "Development Team");

		KoroneikiTeamAPI._setTeamPermissions(
			table = '''| Delete | true |''',
			teamName = "Development Team");

		KoroneikiTeamAPIPermissionCheck._deleteTeam(teamName = "Development Team");

		KoroneikiTeamAPI._viewNoTeam(teamName = "Development Team");
	}

	test Removeteamattemptbynewlynonpermissioneduser {
		KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORAUTO                                  | |
	| Contact Email Address | koroneiki.contact1@lrcustomer.com.broken | |
	| Description           | Test automotive account on koroneiki     | |
	| Fax Number            | 555-555-1234                             | |
	| Name                  | Koroneiki Automotive                     | |
	| Phone Number          | 555-555-5678                             | |
	| Profile Email Address | koroneiki.contact1@lrcustomer.com.broken | |
	| Region                | United States                            | |
	| Status                | Active                                   | |
	| Tier                  | T4                                       | |
	| Website               | www.koroneikiautomotive.com              | |''');

		KoroneikiAccountAPI._createAccountTeam(
			accountName = "Koroneiki Automotive",
			teamName = "Development Team");

		KoroneikiTeamAPI._setTeamPermissions(
			table = '''| Delete | true |''',
			teamName = "Development Team");

		KoroneikiTeamAPI._unsetTeamPermissions(
			table = '''| Delete | true |''',
			teamName = "Development Team");

		KoroneikiTeamAPIPermissionCheck._deleteTeamAttempt(teamName = "Development Team");

		KoroneikiTeamAPI._viewTeam(teamName = "Development Team");

		KoroneikiAccountAPI._viewAccountTeam(
			accountName = "Koroneiki Automotive",
			teamName = "Development Team");

		KoroneikiTeamAPIPermissionCheck._viewNoTeam(teamName = "Development Team");

		KoroneikiTeamAPIPermissionCheck._viewNoTeamAssignedAccount(
			accountName = "Koroneiki Automotive",
			teamName = "Development Team");
	}

