	test Removeteamexternallinkattemptbynonpermissioneduser {
		KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORAUTO                                  | |
	| Contact Email Address | koroneiki.contact1@lrcustomer.com.broken | |
	| Description           | Test automotive account on koroneiki     | |
	| Fax Number            | 555-555-1234                             | |
	| Name                  | Koroneiki Automotive                     | |
	| Phone Number          | 555-555-5678                             | |
	| Profile Email Address | koroneiki.contact1@lrcustomer.com.broken | |
	| Region                | United States                            | |
	| Status                | Active                                   | |
	| Tier                  | T4                                       | |
	| Website               | www.koroneikiautomotive.com              | |''');

		KoroneikiAccountAPI._createAccountTeam(
			accountName = "Koroneiki Automotive",
			teamName = "Development Team");

		KoroneikiTeamAPI._createTeamExternalLink(
			table = '''| Domain      | devteam |
	| Entity Id   | 1234    |
	| Entity Name | DevTeam |''',
			teamName = "Development Team");

		KoroneikiTeamAPIPermissionCheck._deleteTeamExternalLinkAttempt(
			entityId = 1234,
			teamName = "Development Team");

		KoroneikiTeamAPI._viewTeamExternalLink(
			entityId = 1234,
			table = '''| Domain      | devteam |
	| Entity Id   | 1234    |
	| Entity Name | DevTeam |''',
			teamName = "Development Team");

		KoroneikiTeamAPIPermissionCheck._viewNoTeamExternalLink(
			entityId = 1234,
			teamName = "Development Team");

		KoroneikiTeamAPIPermissionCheck._viewNoTeamViaExternalLink(
			domain = "devteam",
			entityId = 1234,
			entityName = "DevTeam",
			teamName = "Development Team");
	}

	test Setteampermissionsattemptbynewlynonpermissioneduser {
		KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORAUTO                                  | |
	| Contact Email Address | koroneiki.contact1@lrcustomer.com.broken | |
	| Description           | Test automotive account on koroneiki     | |
	| Fax Number            | 555-555-1234                             | |
	| Name                  | Koroneiki Automotive                     | |
	| Phone Number          | 555-555-5678                             | |
	| Profile Email Address | koroneiki.contact1@lrcustomer.com.broken | |
	| Region                | United States                            | |
	| Status                | Active                                   | |
	| Tier                  | T4                                       | |
	| Website               | www.koroneikiautomotive.com              | |''');

		KoroneikiAccountAPI._createAccountTeam(
			accountName = "Koroneiki Automotive",
			teamName = "Development Team");

		KoroneikiTeamAPI._setTeamPermissions(
			table = '''| Permissions | true |''',
			teamName = "Development Team");

		KoroneikiTeamAPI._unsetTeamPermissions(
			table = '''| Permissions | true |''',
			teamName = "Development Team");

		KoroneikiTeamAPIPermissionCheck._setTeamPermissionsAttempt(
			table = '''| Update | true |
	| View   | true |''',
			teamName = "Development Team");

		KoroneikiTeamAPIPermissionCheck.updateTeamAttempt(
			teamName = "Development Team",
			teamNameEdit = "Engineering Team");

		KoroneikiTeamAPI._viewTeam(teamName = "Development Team");

		KoroneikiTeamAPI._viewNoTeam(teamName = "Engineering Team");

		KoroneikiAccountAPI._viewAccountTeam(
			accountName = "Koroneiki Automotive",
			teamName = "Development Team");

		KoroneikiAccountAPI._viewNoAccountTeam(
			accountName = "Koroneiki Automotive",
			teamName = "Engineering Team");

		KoroneikiTeamAPIPermissionCheck._viewNoTeam(teamName = "Development Team");

		KoroneikiTeamAPIPermissionCheck._viewNoTeamAssignedAccount(
			accountName = "Koroneiki Automotive",
			teamName = "Development Team");
	}

