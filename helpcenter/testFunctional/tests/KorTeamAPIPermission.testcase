			teamName = "Development Team");

		LocalFile.KoroneikiTeamAPI._viewTeamExternalLink(
			entityId = 1234,
			table = '''| Domain      | devteam |
	| Entity Id   | 1234    |
	| Entity Name | DevTeam |''',
			teamName = "Development Team");

		LocalFile.KoroneikiTeamAPIPermissionCheck._viewNoTeamExternalLink(
			entityId = 1234,
			teamName = "Development Team");

		LocalFile.KoroneikiTeamAPIPermissionCheck._viewNoTeamViaExternalLink(
			domain = "devteam",
			entityId = 1234,
			entityName = "DevTeam",
			teamName = "Development Team");
