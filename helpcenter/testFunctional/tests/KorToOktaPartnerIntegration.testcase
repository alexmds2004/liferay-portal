	| Locality              | Diamond Bar     |
	| Region                | California      |
	| Type                  | Business        |
	| Mailing               | True            |
	| Postal Code           | 91765           |
	| Primary               | True            |
	| Street Address Line 1 | 123 Main Street |''');

		LocalFile.KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Oktkor - ${staticProjectName}",
			productName = "Portal Production",
			table = '''| End Date                | ${staticEndDate}         |   |
	| Original End Date       | ${staticOriginalEndDate} |   |
	| Perpetual               | false                    |   |
	| Product Field and Value | sizing                   | 1 |
	| Product Field and Value | licenses                 | 1 |
	| Product Field and Value | version                  | 6 |
	| Quantity                | 1                        |   |
	| Start Date              | ${staticStartDate}       |   |
	| Status                  | Approved                 |   |''');

		LocalFile.KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Oktkor - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		LocalFile.KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		LocalFile.KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Partner");

		LocalFile.KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Partner");

		LocalFile.JSONOSBAccount.viewSupportOrganizationSync(accountCode = "OKTPAROKTPAR");

		LocalFile.JSONOkta.viewOktaUserGroupMembership(
			groupName = "Partners",
			userEmailAddress = "okt.partner1@lrpartner.com.broken");

		LocalFile.KoroneikiContactAPI._updateContactViaEmailAddress(
			contactEmailAddress = "okt.partner1@lrpartner.com.broken",
			table = '''| Email Address | okt.partner2@lrpartner.com.broken |
	| First Name    | OKT                               |
	| Last Name     | Partner2                          |''');

		LocalFile.OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		LocalFile.Provisioning.gotoUsers();

		LocalFile.Provisioning.searchUsers(keyword = "okt.partner2");

		LocalFile.Provisioning.clickUser(userName = "OKT Partner2");

		LocalFile.ProvisioningUser.clickSyncWithOktaButton();

		LocalFile.ZendeskHomepage.pause(timeInSeconds = 10);

		LocalFile.JSONOkta.viewOktaUser(userEmailAddress = "okt.partner2@lrpartner.com.broken");

		LocalFile.KoroneikiContactAPI._viewContactUuidAndUserUuidComparison(contactEmailAddress = "okt.partner2@lrpartner.com.broken");
	}

}