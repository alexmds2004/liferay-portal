		Provisioning.clickAccount(accountName = "Oktpar - ${staticCompanyName}");

		Provisioning.clickTab(tabName = "Contacts");

		ProvisioningAccount.clickAssignContactButton();

		ProvisioningAccount.populateAssignContactFormAndSave(table = '''| Email Address | okt.partner1@lrpartner.com.broken |
	| Assign Role   | Partner Member                    |''');

		ProvisioningAccount._viewAccountContact(
			emailAddress = "okt.partner1@lrpartner.com.broken",
