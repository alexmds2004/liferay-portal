definition {

	property testray.main.component.name = "Support QA";
	property type = "okta.integration";

	setUp {
		Passwords.getPasswords();

		OSBAdminRabbitMQ.generateStaticVariables();

		KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		OSBAdminRabbitMQ.generateProvisioningCompanyName();

		OSBAdminRabbitMQ.generateProvisioningProjectName();

		JSONOkta.createOktaUser(table = '''| Screen Name   | okt.partner1                      |
	| Email Address | okt.partner1@lrpartner.com.broken |
	| First Name    | OKT                               |
	| Last Name     | Partner1                          |''');
	}

	tearDown {
		ZendeskUserAPI._getDefaultUserId(organizationName = "Oktkor - ${staticProjectName}");

		ZendeskUserAPI._renameFirstDefaultUserIdVariable();

		ZendeskUserAPI._getDefaultUserId(organizationName = "Oktpar - ${staticCompanyName}");

		ZendeskUserAPI._renameSecondDefaultUserIdVariable();

		OSBAdminProject.tearDownProjects(table = '''| OKTKOROKTKOR |
	| OKTPAROKTPAR |''');

		KoroneikiAccountAPI._tearDownAccounts(table = '''| Oktkor - ${staticProjectName} |
	| Oktpar - ${staticCompanyName} |''');

		KoroneikiAccountAPI._tearDownAccountsViaAccountFieldNameAndValue(
			fieldName = "Code",
			table = '''| OKTKOROKTKOR |
	| OKTPAROKTPAR |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		JSONUser.tearDownUsersViaSupport(table = '''| okt.partner1@lrpartner.com.broken |
	| okt.partner2@lrpartner.com.broken |''');

		JSONUser.tearDownUsersViaKoroneiki(table = '''| okt.partner1@lrpartner.com.broken |
	| okt.partner2@lrpartner.com.broken |''');

		KoroneikiContactAPI._tearDownContacts(table = '''| okt.partner1@lrpartner.com.broken |
	| okt.partner2@lrpartner.com.broken |''');

		JSONOkta.tearDownUsers(table = '''| okt.partner1@lrpartner.com.broken |
	| okt.partner2@lrpartner.com.broken |''');

		ZendeskUserAPI._getMultipleUserIdsByEmailAddress(table = '''| okt.partner1@lrpartner.com.broken |
	| okt.partner2@lrpartner.com.broken |''');

		ZendeskUserAPI._tearDownUsersByIdList(userIds = ${staticUserIdList});

		ZendeskOrganizationAPI._getMultipleOrganizationExternalIdsByOrganizationNameIfStillPresent(table = '''| Oktkor - ${staticProjectName} |
	| Oktpar - ${staticCompanyName} |''');

		ZendeskOrganizationAPI._tearDownOrganizationsByExternalIdList(organizationExternalIds = ${staticOrganizationExternalIdList});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId1});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId2});
	}

	test Syncpartnergroupmembershipremovalviakoroneikitookta {
		KoroneikiAccountAPI._createAccount(table = '''| Name   | Oktpar - ${staticCompanyName} | |
	| Code   | OKTPAROKTPAR                  | |
	| Status | Active                        | |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Oktpar - ${staticCompanyName}",
			productName = "Service Partnership",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Oktpar - ${staticCompanyName}",
			contactEmailAddress = "okt.partner1@lrpartner.com.broken",
			table = '''| Partner Member |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Partner");

		KoroneikiAccountAPI._createAssignedTeamNestedField(
			accountName = "Oktkor - ${staticProjectName}",
			teamName = "Oktpar - ${staticCompanyName}");

		KoroneikiAccountAPI._createAccount(table = '''| Assigned Team Nested Field | ${staticAssignedTeamNestedField} | |
	| Code                       | OKTKOROKTKOR                     | |
	| Language                   | English                          | |
	| Name                       | Oktkor - ${staticProjectName}    | |
	| Region                     | United States                    | |
	| Status                     | Active                           | |
	| Tier                       | T1                               | |''');

		KoroneikiAccountAPI._assignTeamRolesToTeam(
			accountName = "Oktkor - ${staticProjectName}",
			table = '''| Partner |''',
			teamName = "Oktpar - ${staticCompanyName}");

		KoroneikiAccountAPI._assignTeamRolesToTeam(
			accountName = "Oktkor - ${staticProjectName}",
			table = '''| First Line Support |''',
			teamName = "Oktpar - ${staticCompanyName}");

		KoroneikiAccountAPI._createAccountPostalAddress(
			accountName = "Oktkor - ${staticProjectName}",
			table = '''| Country               | United States   |
	| Locality              | Diamond Bar     |
	| Region                | California      |
	| Type                  | Business        |
	| Mailing               | True            |
	| Postal Code           | 91765           |
	| Primary               | True            |
	| Street Address Line 1 | 123 Main Street |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Oktkor - ${staticProjectName}",
			productName = "Portal Production",
			table = '''| End Date                | ${staticEndDate}         |   |
	| Original End Date       | ${staticOriginalEndDate} |   |
	| Perpetual               | false                    |   |
	| Product Field and Value | sizing                   | 1 |
	| Product Field and Value | licenses                 | 1 |
	| Product Field and Value | version                  | 6 |
	| Quantity                | 1                        |   |
	| Start Date              | ${staticStartDate}       |   |
	| Status                  | Approved                 |   |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Oktkor - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Partner");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Partner");

		JSONOSBAccount.viewSupportOrganizationSync(accountCode = "OKTPAROKTPAR");

		JSONOkta.viewOktaUserGroupMembership(
			groupName = "Partners",
			userEmailAddress = "okt.partner1@lrpartner.com.broken");

		ProvisioningContactAPI._unassignContactRolesToContact(
			accountName = "Oktpar - ${staticCompanyName}",
			table = '''| Partner Member |''',
			userEmailAddress = "okt.partner1@lrpartner.com.broken");

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Partner");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Partner");

		JSONOkta.viewNoOktaUserGroupMembership(
			groupName = "Partners",
			userEmailAddress = "okt.partner1@lrpartner.com.broken");

		KoroneikiContactAPI._viewContactUuidAndUserUuidComparison(contactEmailAddress = "okt.partner1@lrpartner.com.broken");
	}

	test Syncpartnergroupmembershipremovalviaprovisioningtookta {
		KoroneikiAccountAPI._createAccount(table = '''| Name   | Oktpar - ${staticCompanyName} | |
	| Code   | OKTPAROKTPAR                  | |
	| Status | Active                        | |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Oktpar - ${staticCompanyName}",
			productName = "Service Partnership",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Oktpar - ${staticCompanyName}",
			contactEmailAddress = "okt.partner1@lrpartner.com.broken",
			table = '''| Partner Member |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Partner");

		KoroneikiAccountAPI._createAssignedTeamNestedField(
			accountName = "Oktkor - ${staticProjectName}",
			teamName = "Oktpar - ${staticCompanyName}");

		KoroneikiAccountAPI._createAccount(table = '''| Assigned Team Nested Field | ${staticAssignedTeamNestedField} | |
	| Code                       | OKTKOROKTKOR                     | |
	| Language                   | English                          | |
	| Name                       | Oktkor - ${staticProjectName}    | |
	| Region                     | United States                    | |
	| Status                     | Active                           | |
	| Tier                       | T1                               | |''');

		KoroneikiAccountAPI._assignTeamRolesToTeam(
			accountName = "Oktkor - ${staticProjectName}",
			table = '''| Partner |''',
			teamName = "Oktpar - ${staticCompanyName}");

		KoroneikiAccountAPI._assignTeamRolesToTeam(
			accountName = "Oktkor - ${staticProjectName}",
			table = '''| First Line Support |''',
			teamName = "Oktpar - ${staticCompanyName}");

		KoroneikiAccountAPI._createAccountPostalAddress(
			accountName = "Oktkor - ${staticProjectName}",
			table = '''| Country               | United States   |
	| Locality              | Diamond Bar     |
	| Region                | California      |
	| Type                  | Business        |
	| Mailing               | True            |
	| Postal Code           | 91765           |
	| Primary               | True            |
	| Street Address Line 1 | 123 Main Street |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Oktkor - ${staticProjectName}",
			productName = "Portal Production",
			table = '''| End Date                | ${staticEndDate}         |   |
	| Original End Date       | ${staticOriginalEndDate} |   |
	| Perpetual               | false                    |   |
	| Product Field and Value | sizing                   | 1 |
	| Product Field and Value | licenses                 | 1 |
	| Product Field and Value | version                  | 6 |
	| Quantity                | 1                        |   |
	| Start Date              | ${staticStartDate}       |   |
	| Status                  | Approved                 |   |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Oktkor - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Partner");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Partner");

		JSONOSBAccount.viewSupportOrganizationSync(accountCode = "OKTPAROKTPAR");

		JSONOkta.viewOktaUserGroupMembership(
			groupName = "Partners",
			userEmailAddress = "okt.partner1@lrpartner.com.broken");

		OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		Provisioning.gotoAccounts();

		Provisioning.searchAccounts(keyword = "Oktpar");

		Provisioning.clickAccount(accountName = "Oktpar - ${staticCompanyName}");

		Provisioning.clickTab(tabName = "Contacts");

		ProvisioningAccount.clickContactActionDropdownButton(
			action = "Unassign",
			emailAddress = "okt.partner1@lrpartner.com.broken");

		ProvisioningAccount._viewNoAccountContact(emailAddress = "okt.partner1@lrpartner.com.broken");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Partner");

		Provisioning.gotoUsers();

		Provisioning.searchUsers(keyword = "okt.partner1");

		Provisioning.clickUser(userName = "OKT Partner1");

		ProvisioningUser.clickSyncWithOktaButton();

		ZendeskHomepage.pause(timeInSeconds = 10);

		JSONOkta.viewNoOktaUserGroupMembership(
			groupName = "Partners",
			userEmailAddress = "okt.partner1@lrpartner.com.broken");

		KoroneikiContactAPI._viewContactUuidAndUserUuidComparison(contactEmailAddress = "okt.partner1@lrpartner.com.broken");
	}

