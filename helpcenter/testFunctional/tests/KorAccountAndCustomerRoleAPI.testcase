	test Viewaccountmodifieddatevalueaftercontactupdates {
		KoroneikiAccountAPI._createAccount(table = '''| Code         | KORAUTO                              | |
	| Description  | Test automotive account on koroneiki | |
	| Fax Number   | 555-555-1234                         | |
	| Name         | Koroneiki Automotive                 | |
	| Phone Number | 555-555-5678                         | |
	| Region       | United States                        | |
	| Status       | Active                               | |
	| Tier         | T4                                   | |
	| Website      | www.koroneikiautomotive.com          | |''');

		KoroneikiAccountAPI._getAccountDateModifiedValue(accountName = "Koroneiki Automotive");

		KoroneikiAccountAPI._renameFirstAccountDateModifiedValue();

		KoroneikiContactAPI._createContact(table = '''| Email Address | koroneiki.contact1@lrcustomer.com.broken |
	| First Name    | Koroneiki                                |
	| Language      | English                                  |
	| Last Name     | Contact1                                 |
	| Middle Name   | User                                     |''');

		KoroneikiAccountAPI._assignCustomerContacts(
			accountName = "Koroneiki Automotive",
			table = '''| koroneiki.contact1@lrcustomer.com.broken |''');

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Koroneiki Automotive",
			contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken",
			table = '''| Default Account Customer Role |''');

		KoroneikiAccountAPI._getAccountDateModifiedValue(accountName = "Koroneiki Automotive");

		KoroneikiAccountAPI._renameSecondAccountDateModifiedValue();

		KoroneikiAccountAPI._assertDifferentAccountDateModifiedValuesFirst(
			accountDateModifiedValue1 = ${staticAccountDateModified1Value1},
			accountDateModifiedValue2 = ${staticAccountDateModified1Value2});

		KoroneikiContactRoleAPI._updateContactRole(
			contactRoleName = "Default Account Customer Role",
			table = '''| Description | This is the optional customer role for accounts |
	| Name        | Optional Account Customer Role                  |
	| Type        | Account Customer                                |''');

		KoroneikiContactRoleAPI._viewNoContactRole(contactRoleName = "Default Account Customer Role");

		KoroneikiAccountAPI._getAccountDateModifiedValue(accountName = "Koroneiki Automotive");

		KoroneikiAccountAPI._renameThirdAccountDateModifiedValue();

		KoroneikiAccountAPI._assertDifferentAccountDateModifiedValuesFirst(
			accountDateModifiedValue1 = ${staticAccountDateModifiedValue2},
			accountDateModifiedValue2 = ${accountDateModifiedValue3});

		KoroneikiAccountAPI._removeContactRolesFromContact(
			accountName = "Koroneiki Automotive",
			contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken",
			table = '''| Optional Account Customer Role |''');

		KoroneikiAccountAPI._viewNoContactRole(
			accountName = "Koroneiki Automotive",
			contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken",
			contactRoleName = "Optional Account Customer Role");

		KoroneikiAccountAPI._getAccountDateModifiedValue(accountName = "Koroneiki Automotive");

		KoroneikiAccountAPI._renameFourthAccountDateModifiedValue();

		KoroneikiAccountAPI._assertDifferentAccountDateModifiedValuesFirst(
			accountDateModifiedValue1 = ${accountDateModifiedValue3},
			accountDateModifiedValue2 = ${accountDateModifiedValue4});
	}

