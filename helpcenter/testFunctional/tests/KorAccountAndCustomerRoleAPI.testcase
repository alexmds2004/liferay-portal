definition {

	property testray.main.component.name = "Support QA";
	property type = "koroneiki";

	tearDown {
		KoroneikiAccountAPI._tearDownAccounts(table = '''| Koroneiki Auto Subsidiary |
	| Koroneiki Engr Subsidiary |
	| Koroneiki Automotive      |
	| Koroneiki Engineering     |''');

		KoroneikiContactAPI._tearDownContacts(table = '''| koroneiki.contact1@lrcustomer.com.broken |
	| koroneiki.contact2@lrcustomer.com.broken |''');

		KoroneikiContactRoleAPI._tearDownContactRoles(table = '''| Default Account Customer Role  |
	| Optional Account Customer Role |''');
	}

	test Assignaccountcustomercontactrolestocontact {
		KoroneikiContactAPI._createContact(table = '''| Email Address | koroneiki.contact1@lrcustomer.com.broken |
	| First Name    | Koroneiki                                |
	| Language      | English                                  |
	| Last Name     | Contact1                                 |
	| Middle Name   | User                                     |''');

		KoroneikiAccountAPI._createAccount(table = '''| Code         | KORAUTO                              | |
	| Description  | Test automotive account on koroneiki | |
	| Fax Number   | 555-555-1234                         | |
	| Name         | Koroneiki Automotive                 | |
	| Phone Number | 555-555-5678                         | |
	| Region       | United States                        | |
	| Status       | Active                               | |
	| Tier         | T4                                   | |
	| Website      | www.koroneikiautomotive.com          | |''');

		KoroneikiContactRoleAPI._createContactRole(table = '''| Description | This is the default customer role for accounts |
	| Name        | Default Account Customer Role                  |
	| Type        | Account Customer                               |''');

		KoroneikiContactRoleAPI._createContactRole(table = '''| Description | This is the optional customer role for accounts |
	| Name        | Optional Account Customer Role                  |
	| Type        | Account Customer                                |''');

		KoroneikiAccountAPI._assignCustomerContacts(
			accountName = "Koroneiki Automotive",
			table = '''| koroneiki.contact1@lrcustomer.com.broken |''');

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Koroneiki Automotive",
			contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken",
			table = '''| Default Account Customer Role  |
	| Optional Account Customer Role |''');

		KoroneikiAccountAPI._viewContactRole(
			accountName = "Koroneiki Automotive",
			contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken",
			contactRoleName = "Default Account Customer Role");

		KoroneikiAccountAPI._viewContactRole(
			accountName = "Koroneiki Automotive",
			contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken",
			contactRoleName = "Optional Account Customer Role");

		KoroneikiAccountAPI._viewContactRole(
			accountName = "Koroneiki Automotive",
			contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken",
			contactRoleName = "Member");

		KoroneikiContactAPI._viewAccountCustomerContactRoleViaUuid(
			accountName = "Koroneiki Automotive",
			contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken",
			contactRoleName = "Default Account Customer Role");

		KoroneikiContactAPI._viewAccountCustomerContactRoleViaUuid(
			accountName = "Koroneiki Automotive",
			contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken",
			contactRoleName = "Optional Account Customer Role");

		KoroneikiContactAPI._viewAccountCustomerContactRoleViaUuid(
			accountName = "Koroneiki Automotive",
			contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken",
			contactRoleName = "Member");

		KoroneikiTeamAPI._viewContactRole(
			contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken",
			contactRoleName = "Member",
			teamName = "Koroneiki Automotive");
	}

	test Assignaccountcustomercontactrolestocontactsonaccountandchildaccounts {
		KoroneikiContactAPI._createContact(table = '''| Email Address | koroneiki.contact1@lrcustomer.com.broken |
	| First Name    | Koroneiki                                |
	| Language      | English                                  |
	| Last Name     | Contact1                                 |
	| Middle Name   | User                                     |''');

		KoroneikiContactAPI._createContact(table = '''| Email Address | koroneiki.contact2@lrcustomer.com.broken |
	| First Name    | Koroneiki                                |
	| Language      | English                                  |
	| Last Name     | Contact2                                 |
	| Middle Name   | User                                     |''');

		KoroneikiAccountAPI._createAccount(table = '''| Code         | KORAUTO                              | |
	| Description  | Test automotive account on koroneiki | |
	| Fax Number   | 555-555-1234                         | |
	| Name         | Koroneiki Automotive                 | |
	| Phone Number | 555-555-5678                         | |
	| Region       | United States                        | |
	| Status       | Active                               | |
	| Tier         | T4                                   | |
	| Website      | www.koroneikiautomotive.com          | |''');

		KoroneikiAccountAPI._createChildAccount(
			accountName = "Koroneiki Automotive",
			table = '''| Code         | KORAUTOSUB                                 | |
	| Description  | Test automotive child account on koroneiki | |
	| Fax Number   | 555-555-9012                               | |
	| Name         | Koroneiki Auto Subsidiary                  | |
	| Phone Number | 555-555-3456                               | |
	| Region       | United States                              | |
	| Status       | Active                                     | |
	| Tier         | T4                                         | |
	| Website      | www.koroneikiautomotivesubsidiary.com      | |''');

		KoroneikiContactRoleAPI._createContactRole(table = '''| Description | This is the default customer role for accounts |
	| Name        | Default Account Customer Role                  |
	| Type        | Account Customer                               |''');

		KoroneikiContactRoleAPI._createContactRole(table = '''| Description | This is the optional customer role for accounts |
	| Name        | Optional Account Customer Role                  |
	| Type        | Account Customer                                |''');

		KoroneikiAccountAPI._assignCustomerContacts(
			accountName = "Koroneiki Automotive",
			table = '''| koroneiki.contact1@lrcustomer.com.broken |''');

		KoroneikiAccountAPI._assignCustomerContacts(
			accountName = "Koroneiki Auto Subsidiary",
			table = '''| koroneiki.contact2@lrcustomer.com.broken |''');

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Koroneiki Automotive",
			contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken",
			table = '''| Default Account Customer Role |''');

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Koroneiki Auto Subsidiary",
			contactEmailAddress = "koroneiki.contact2@lrcustomer.com.broken",
			table = '''| Optional Account Customer Role |''');

		KoroneikiAccountAPI._viewContactRole(
			accountName = "Koroneiki Automotive",
			contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken",
			contactRoleName = "Default Account Customer Role");

		KoroneikiAccountAPI._viewContactRole(
			accountName = "Koroneiki Auto Subsidiary",
			contactEmailAddress = "koroneiki.contact2@lrcustomer.com.broken",
			contactRoleName = "Optional Account Customer Role");

		KoroneikiAccountAPI._viewNoContactRole(
			accountName = "Koroneiki Automotive",
			contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken",
			contactRoleName = "Optional Account Customer Role");

		KoroneikiAccountAPI._viewNoContactRole(
			accountName = "Koroneiki Auto Subsidiary",
			contactEmailAddress = "koroneiki.contact2@lrcustomer.com.broken",
			contactRoleName = "Default Account Customer Role");

		KoroneikiAccountAPI._viewContactRole(
			accountName = "Koroneiki Automotive",
			contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken",
			contactRoleName = "Member");

		KoroneikiAccountAPI._viewContactRole(
			accountName = "Koroneiki Auto Subsidiary",
			contactEmailAddress = "koroneiki.contact2@lrcustomer.com.broken",
			contactRoleName = "Member");

		KoroneikiContactAPI._viewAccountCustomerContactRoleViaUuid(
			accountName = "Koroneiki Automotive",
			contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken",
			contactRoleName = "Default Account Customer Role");

		KoroneikiContactAPI._viewAccountCustomerContactRoleViaUuid(
			accountName = "Koroneiki Automotive",
			contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken",
			contactRoleName = "Member");

		KoroneikiContactAPI._viewAccountCustomerContactRoleViaUuid(
			accountName = "Koroneiki Auto Subsidiary",
			contactEmailAddress = "koroneiki.contact2@lrcustomer.com.broken",
			contactRoleName = "Optional Account Customer Role");

		KoroneikiContactAPI._viewAccountCustomerContactRoleViaUuid(
			accountName = "Koroneiki Auto Subsidiary",
			contactEmailAddress = "koroneiki.contact2@lrcustomer.com.broken",
			contactRoleName = "Member");

		KoroneikiContactAPI._viewNoAccountCustomerContactRoleViaUuid(
			accountName = "Koroneiki Automotive",
			contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken",
			contactRoleName = "Optional Account Customer Role");

		KoroneikiContactAPI._viewNoAccountCustomerContactRoleViaUuid(
			accountName = "Koroneiki Auto Subsidiary",
			contactEmailAddress = "koroneiki.contact2@lrcustomer.com.broken",
			contactRoleName = "Default Account Customer Role");

		KoroneikiTeamAPI._viewContactRole(
			contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken",
			contactRoleName = "Member",
			teamName = "Koroneiki Automotive");

		KoroneikiTeamAPI._viewContactRole(
			contactEmailAddress = "koroneiki.contact2@lrcustomer.com.broken",
			contactRoleName = "Member",
			teamName = "Koroneiki Auto Subsidiary");
	}

