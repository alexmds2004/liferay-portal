	test Assignmultiplenonexistentaccountcustomercontactrolestocontact {
		KoroneikiContactRoleAPI._createContactRoleNestedFieldForNonExistentContactRole(table = '''| Description | This is the default customer role for accounts |
	| Name        | Default Account Customer Role                  |
	| Type        | Account Customer                               |''');

		KoroneikiContactRoleAPI._renameFirstContactRoleNestedFieldVariable();

		KoroneikiContactRoleAPI._createContactRoleNestedFieldForNonExistentContactRole(table = '''| Description | This is the optional customer role for accounts |
	| Name        | Optional Account Customer Role                  |
	| Type        | Account Customer                                |''');

		KoroneikiContactRoleAPI._renameSecondContactRoleNestedFieldVariable();

		KoroneikiContactAPI._createContact(table = '''| Email Address | koroneiki.contact1@lrcustomer.com.broken |
	| First Name    | Koroneiki                                |
	| Language      | English                                  |
	| Last Name     | Contact1                                 |
	| Middle Name   | User                                     |''');

		KoroneikiContactAPI._createCustomerContactNestedFieldWithContactRoleNestedField(
			contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken",
			contactRolesNestedField = "${staticContactRolesNestedField1},${staticContactRolesNestedField2}");

		KoroneikiAccountAPI._createAccount(table = '''| Code                 | KORAUTO                              | |
	| Contact Nested Field | ${staticContactsNestedField}         | |
	| Description          | Test automotive account on koroneiki | |
	| Fax Number           | 555-555-1234                         | |
	| Name                 | Koroneiki Automotive                 | |
	| Phone Number         | 555-555-5678                         | |
	| Region               | United States                        | |
	| Status               | Active                               | |
	| Tier                 | T4                                   | |
	| Website              | www.koroneikiautomotive.com          | |''');

		KoroneikiAccountAPI._viewContactRole(
			accountName = "Koroneiki Automotive",
			contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken",
			contactRoleName = "Default Account Customer Role");

		KoroneikiAccountAPI._viewContactRole(
			accountName = "Koroneiki Automotive",
			contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken",
			contactRoleName = "Optional Account Customer Role");

		KoroneikiAccountAPI._viewContactRole(
			accountName = "Koroneiki Automotive",
			contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken",
			contactRoleName = "Member");

		KoroneikiContactRoleAPI._viewContactRole(
			contactRoleName = "Default Account Customer Role",
			table = '''| Description | This is the default customer role for accounts |
	| Name        | Default Account Customer Role                  |
	| Type        | Account Customer                               |''');

		KoroneikiContactRoleAPI._viewContactRole(
			contactRoleName = "Optional Account Customer Role",
			table = '''| Description | This is the optional customer role for accounts |
	| Name        | Optional Account Customer Role                  |
	| Type        | Account Customer                                |''');

		KoroneikiContactAPI._viewAccountCustomerContactRoleViaUuid(
			accountName = "Koroneiki Automotive",
			contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken",
			contactRoleName = "Default Account Customer Role");

		KoroneikiContactAPI._viewAccountCustomerContactRoleViaUuid(
			accountName = "Koroneiki Automotive",
			contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken",
			contactRoleName = "Optional Account Customer Role");

		KoroneikiContactAPI._viewAccountCustomerContactRoleViaUuid(
			accountName = "Koroneiki Automotive",
			contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken",
			contactRoleName = "Member");

		KoroneikiTeamAPI._viewContactRole(
			contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken",
			contactRoleName = "Member",
			teamName = "Koroneiki Automotive");
	}

