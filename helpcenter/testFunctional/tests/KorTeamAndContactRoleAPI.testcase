			teamName = "Development Team");

		KoroneikiTeamAPI._assignContacts(
			table = '''| koroneiki.contact1@lrcustomer.com.broken |''',
			teamName = "Development Team");

		KoroneikiTeamAPI._assignContactRolesToContact(
			contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken",
			table = '''| Default Team Role  |
	| Optional Team Role |''',
			teamName = "Development Team");

		KoroneikiTeamAPI._viewContactRole(
			contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken",
			contactRoleName = "Default Team Role",
			teamName = "Development Team");

		KoroneikiTeamAPI._viewContactRole(
			contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken",
			contactRoleName = "Optional Team Role",
			teamName = "Development Team");

		KoroneikiTeamAPI._viewContactRole(
			contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken",
			contactRoleName = "Member",
			teamName = "Development Team");
