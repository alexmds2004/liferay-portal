definition {

	property testray.main.component.name = "Support QA";
	property type = "koroneiki";

	tearDown {
		KoroneikiAccountAPI._tearDownAccounts(table = '''| Koroneiki Auto Subsidiary |
	| Koroneiki Engr Subsidiary |
	| Koroneiki Automotive      |
	| Koroneiki Engineering     |''');

		KoroneikiContactAPI._tearDownContacts(table = '''| koroneiki.contact1@lrcustomer.com.broken |
	| koroneiki.contact2@lrcustomer.com.broken |''');

		KoroneikiContactRoleAPI._tearDownContactRoles(table = '''| Default Team Role  |
	| Optional Team Role |''');

		KoroneikiTeamAPI._tearDownTeams(table = '''| Development Team |
	| Marketing Team   |
	| Engineering Team |
	| Sales Team       |''');
	}

	test Assignseparateteamcontactrolestocontacts {
		KoroneikiContactAPI._createContact(table = '''| Email Address | koroneiki.contact1@lrcustomer.com.broken |
	| First Name    | Koroneiki                                |
	| Language      | English                                  |
	| Last Name     | Contact1                                 |
	| Middle Name   | User                                     |''');

		KoroneikiContactAPI._createContact(table = '''| Email Address | koroneiki.contact2@lrcustomer.com.broken |
	| First Name    | Koroneiki                                |
	| Language      | English                                  |
	| Last Name     | Contact2                                 |
	| Middle Name   | User                                     |''');

		KoroneikiContactRoleAPI._createContactRole(table = '''| Description | This is the default role for teams |
	| Name        | Default Team Role                  |
	| Type        | Team                               |''');

		KoroneikiContactRoleAPI._createContactRole(table = '''| Description | This is the optional role for teams |
	| Name        | Optional Team Role                  |
	| Type        | Team                                |''');

		KoroneikiAccountAPI._createAccount(table = '''| Code         | KORAUTO                                  | |
	| Description  | Test automotive account on koroneiki     | |
	| Fax Number   | 555-555-1234                             | |
	| Name         | Koroneiki Automotive                     | |
	| Phone Number | 555-555-5678                             | |
	| Region       | United States                            | |
	| Status       | Active                                   | |
	| Tier         | T4                                       | |
	| Website      | www.koroneikiautomotive.com              | |''');

		KoroneikiAccountAPI._createAccountTeam(
			accountName = "Koroneiki Automotive",
			teamName = "Development Team");

		KoroneikiTeamAPI._assignContacts(
			table = '''| koroneiki.contact1@lrcustomer.com.broken |
	| koroneiki.contact2@lrcustomer.com.broken |''',
			teamName = "Development Team");

		KoroneikiTeamAPI._assignContactRolesToContact(
			contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken",
			table = '''| Default Team Role |''',
			teamName = "Development Team");

		KoroneikiTeamAPI._assignContactRolesToContact(
			contactEmailAddress = "koroneiki.contact2@lrcustomer.com.broken",
			table = '''| Optional Team Role |''',
			teamName = "Development Team");

		KoroneikiTeamAPI._viewContactRole(
			contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken",
			contactRoleName = "Default Team Role",
			teamName = "Development Team");

		KoroneikiTeamAPI._viewContactRole(
			contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken",
			contactRoleName = "Member",
			teamName = "Development Team");

		KoroneikiTeamAPI._viewContactRole(
			contactEmailAddress = "koroneiki.contact2@lrcustomer.com.broken",
			contactRoleName = "Optional Team Role",
			teamName = "Development Team");

		KoroneikiTeamAPI._viewContactRole(
			contactEmailAddress = "koroneiki.contact2@lrcustomer.com.broken",
			contactRoleName = "Member",
			teamName = "Development Team");

		KoroneikiTeamAPI._viewNoContactRole(
			contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken",
			contactRoleName = "Optional Team Role",
			teamName = "Development Team");

		KoroneikiTeamAPI._viewNoContactRole(
			contactEmailAddress = "koroneiki.contact2@lrcustomer.com.broken",
			contactRoleName = "Default Team Role",
			teamName = "Development Team");
	}

	test Assignteamcontactrolestocontact {
		KoroneikiContactAPI._createContact(table = '''| Email Address | koroneiki.contact1@lrcustomer.com.broken |
	| First Name    | Koroneiki                                |
	| Language      | English                                  |
	| Last Name     | Contact1                                 |
