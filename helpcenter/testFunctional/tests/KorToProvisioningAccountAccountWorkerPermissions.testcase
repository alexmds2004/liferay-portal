definition {

	property testray.main.component.name = "Support QA";
	property type = "provisioning.security";

	setUp {
		LocalFile.Passwords.getPasswords();

		LocalFile.KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		LocalFile.OSBAdminRabbitMQ.generateStaticVariables();

		LocalFile.OSBAdminRabbitMQ.generateProvisioningCompanyName();

		LocalFile.OSBAdminRabbitMQ.generateProvisioningProjectName();

		LocalFile.JSONUser.createViaProvisioning(table = '''| Screen Name   | provisioning.account.worker                    |
	| Email Address | provisioning.account.worker@liferay.com.broken |
	| First Name    | Provisioning                                   |
	| Last Name     | Account Worker                                 |''');

		LocalFile.JSONUser.assignUserToProvisioningRole(
			roleName = "Provisioning Account Worker",
			userEmailAddress = "provisioning.account.worker@liferay.com.broken");

		LocalFile.JSONOkta.createOktaUser(table = '''| Screen Name   | prm.koroneiki1                       |
	| Email Address | prm.koroneiki1@lrcustomer.com.broken |
	| First Name    | PRM                                  |
	| Last Name     | Koroneiki1                           |''');

		LocalFile.JSONOkta.createOktaUser(table = '''| Screen Name   | prm.koroneiki2                       |
	| Email Address | prm.koroneiki2@lrcustomer.com.broken |
	| First Name    | PRM                                  |
	| Last Name     | Koroneiki2                           |''');
	}

	tearDown {
		LocalFile.ZendeskUserAPI._getDefaultUserId(organizationName = "Permis - ${staticProjectName}");

		LocalFile.ZendeskUserAPI._renameFirstDefaultUserIdVariable();

		LocalFile.ZendeskUserAPI._getDefaultUserId(organizationName = "Rchild - ${staticProjectName}");

		LocalFile.ZendeskUserAPI._renameSecondDefaultUserIdVariable();

		LocalFile.ZendeskUserAPI._getDefaultUserId(organizationName = "Perpro - ${staticProjectName}");

		LocalFile.ZendeskUserAPI._renameThirdDefaultUserIdVariable();

		LocalFile.ZendeskUserAPI._getDefaultUserId(organizationName = "Misper - ${staticCompanyName}");

		LocalFile.ZendeskUserAPI._renameFourthDefaultUserIdVariable();

		LocalFile.KoroneikiTeamAPI._tearDownTeams(table = '''| Permission Partner |''');

		LocalFile.OSBAdminProject.tearDownProjects(table = '''| RCHILDRCHILD |
	| MISPERPERMIS |
	| PERPROPERPRO |
	| MISPER       |''');

		LocalFile.KoroneikiAccountAPI._tearDownAccounts(table = '''| Rchild - ${staticProjectName} |
	| Permis - ${staticProjectName} |
	| Perpro - ${staticProjectName} |
	| Misper - ${staticCompanyName} |''');

		LocalFile.KoroneikiAccountAPI._tearDownAccountsViaAccountFieldNameAndValue(
			fieldName = "Code",
			table = '''| RCHILDRCHILD |
	| MISPERPERMIS |
	| PERPROPERPRO |
	| MISPER       |''');

		LocalFile.JSONUser.tearDownUsers(table = '''| prm.koroneiki1@lrcustomer.com.broken |
	| prm.koroneiki2@lrcustomer.com.broken |''');

		LocalFile.JSONUser.tearDownUsersViaSupport(table = '''| prm.koroneiki1@lrcustomer.com.broken |
	| prm.koroneiki2@lrcustomer.com.broken |''');

		LocalFile.JSONUser.tearDownUsersViaKoroneiki(table = '''| prm.koroneiki1@lrcustomer.com.broken |
	| prm.koroneiki2@lrcustomer.com.broken |''');

		LocalFile.KoroneikiContactAPI._tearDownContacts(table = '''| prm.koroneiki1@lrcustomer.com.broken |
	| prm.koroneiki2@lrcustomer.com.broken |''');

		LocalFile.JSONOkta.tearDownUsers(table = '''| prm.koroneiki1@lrcustomer.com.broken |
	| prm.koroneiki2@lrcustomer.com.broken |''');

		LocalFile.ZendeskTicketAPI._tearDownTicketsByKeywords(table = '''| New Subscription(s) for Permis - ${staticProjectName} |
	| New Subscription(s) for Misper - ${staticCompanyName} |''');

		LocalFile.ZendeskUserAPI._getMultipleUserIdsByEmailAddress(table = '''| prm.koroneiki1@lrcustomer.com.broken |
	| prm.koroneiki2@lrcustomer.com.broken |''');

		LocalFile.ZendeskUserAPI._tearDownUsersByIdList(userIds = ${staticUserIdList});

		LocalFile.ZendeskOrganizationAPI._getMultipleOrganizationExternalIdsByOrganizationNameIfStillPresent(table = '''| Permis - ${staticProjectName} |
	| Rchild - ${staticProjectName} |
	| Perpro - ${staticProjectName} |
	| Misper - ${staticCompanyName} |''');

		LocalFile.ZendeskOrganizationAPI._tearDownOrganizationsByExternalIdList(organizationExternalIds = ${staticOrganizationExternalIdList});

		LocalFile.ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId1});

		LocalFile.ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId2});

		LocalFile.ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId3});

		LocalFile.ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId4});

		LocalFile.JSONUser.tearDownUsersViaProvisioning(table = '''| provisioning.account.worker@liferay.com.broken |''');
	}

	test Addaddress {
		LocalFile.OSBAdminRabbitMQ.publishCreateProjectWithNoPartnerMessage(
			routingKey = "dossiera.provisioning.create",
			table = '''| Account Name                           | Misper - ${staticCompanyName}              |
	| Address City                           | Diamond Bar                                |
	| Address Country                        | United States                              |
	| Address Postal Code                    | 91765                                      |
	| Address Region                         | California                                 |
	| Address Street                         | 456 Fake Street                            |
	| Contact Email Address                  | prm.koroneiki1@lrcustomer.com.broken       |
	| Contact First Name                     | PRM                                        |
	| Contact Last Name                      | Koroneiki1                                 |
	| Dossiera Account Key                   | ${staticDossieraAccountKey}                |
	| Dossiera Address Key 1                 | ${staticDossieraAddressKey1}               |
	| Dossiera Address Key 2                 | ${staticDossieraAddressKey2}               |
	| Dossiera Contact Key                   | ${staticDossieraContactKey}                |
	| Dossiera Project Key                   | ${staticDossieraProjectKey}                |
	| End Day                                | ${staticEndDay}                            |
	| End Month                              | ${staticEndMonth}                          |
	| End Year                               | ${staticEndYear}                           |
	| Industry                               | Automotive                                 |
	| Owner Email Address                    | prm.koroneiki2@lrcustomer.com.broken       |
	| Owner First Name                       | PRM                                        |
	| Owner Last Name                        | Koroneiki2                                 |
	| Partner First Line Support             | false                                      |
	| Product Type                           | New                                        |
	| Product Name                           | Liferay Digital Enterprise - Prod Sizing 4 |
	| Project Name                           | Permis - ${staticProjectName}              |
	| Renewal                                | false                                      |
	| Salesforce Opportunity Key             | ${staticSalesforceOpportunityKey}          |
	| Salesforce Opportunity Line Item Key 1 | ${staticSalesforceOpportunityLineItemKey1} |
	| Salesforce Opportunity Line Item Key 2 | ${staticSalesforceOpportunityLineItemKey2} |
	| Salesforce Opportunity Sold By         | Liferay US                                 |
	| Salesforce Opportunity Stage Name      | Closed Won                                 |
	| Salesforce Opportunity Territory       | United States                              |
	| Salesforce Opportunity Type            | New Business                               |
	| Salesforce Owner User Key              | ${staticSalesforceOwnerUserKey}            |
	| Salesforce Project Key                 | ${staticSalesforceProjectKey}              |
	| Start Day                              | ${staticStartDay}                          |
	| Start Month                            | ${staticStartMonth}                        |
	| Start Year                             | ${staticStartYear}                         |
	| Subscription Level                     | Platinum                                   |
	| Version Number                         | 7.1                                        |''');

		LocalFile.KoroneikiAccountAPI._createAccountTeam(
			accountName = "Permis - ${staticProjectName}",
			teamName = "Permission Partner");

		LocalFile.KoroneikiAccountAPI._assignTeamRolesToTeam(
			accountName = "Permis - ${staticProjectName}",
			table = '''| First Line Support |''',
			teamName = "Permission Partner");

		LocalFile.OSBAdmin.loginToProvisioning(
			userEmailAddress = "provisioning.account.worker@liferay.com.broken",
			userPassword = ${staticProvisioningQaUserPassword});

		LocalFile.UserAccount.updatePasswordUponLogin(userPassword = "test");

		LocalFile.Provisioning.gotoAccounts();

		LocalFile.Provisioning.searchAccounts(keyword = "Permis");

		LocalFile.Provisioning.clickAccount(accountName = "Permis - ${staticProjectName}");

		LocalFile.Provisioning.clickTab(tabName = "Details");

		LocalFile.ProvisioningAccount.clickAddAddress(positionValue = 1);

		LocalFile.ProvisioningAccount.editAndSaveAccountAddressDetails(
			positionValue = 2,
			table = '''| Street 1       | Input         | 456 Main Street  |
	| Country        | Select        | Canada        	|
	| City           | Input         | Vancouver        |
	| State/Province | Select        | British Columbia |
	| Postal Code    | Input         | V5Y 0C9          |
	| Primary        | Toggle Switch | false            |''');

		LocalFile.ProvisioningAccount._viewAccountDetailsViaDetailsTab(table = '''| Account Name        | Permis - ${staticProjectName} |   |
	| State               | ACTIVE                        |   |
	| Code                | MISPERPERMIS                  |   |
	| Tier                | T4                            |   |
	| Parent              | Misper - ${staticCompanyName} |	  |
	| Data Region         | United States                 |   |
	| First Line Support  | Permission Partner            |	  |
	| Street 1            | 456 Fake Street               | 1 |
	| Country             | United States                 | 1 |
	| City                | Diamond Bar                   | 1 |
	| State/Province      | California                    | 1 |
	| Postal Code         | 91765                         | 1 |
	| Primary             | true                          | 1 |
	| Street 1            | 456 Main Street               | 2 |
	| Country             | Canada                        | 2 |
	| City                | Vancouver                     | 2 |
	| State/Province      | British Columbia              | 2 |
	| Postal Code         | V5Y 0C9                       | 2 |
	| Primary             | false                         | 2 |
	| Dossiera Project    | ${staticDossieraProjectKey}   |   |
	| Salesforce Project  | ${staticSalesforceProjectKey} |   |''');

		LocalFile.KoroneikiPostalAddressAPI._viewPostalAddress(
			accountName = "Permis - ${staticProjectName}",
			streetAddressLine1 = "456 Main Street",
			table = '''| Country               | Canada           |
	| Locality              | Vancouver        |
	| Region                | British Columbia |
	| Mailing               | false            |
	| Postal Code           | V5Y 0C9          |
	| Primary               | false            |
	| Street Address Line 1 | 456 Main Street  |''');

		LocalFile.KoroneikiPostalAddressAPI._viewPostalAddress(
			accountName = "Permis - ${staticProjectName}",
			streetAddressLine1 = "456 Fake Street",
			table = '''| Country               | United States   |
	| Locality              | Diamond Bar     |
	| Region                | California      |
	| Mailing               | False           |
	| Postal Code           | 91765           |
	| Primary               | true            |
	| Street Address Line 1 | 456 Fake Street |''');

		LocalFile.Provisioning.clickTab(tabName = "History");

		LocalFile.ProvisioningAccount.viewAccountHistoryEntryByKeyword(
			fieldName = "Address",
			keyword = "Auto > Added Address",
			table = '''| Update Description          | Auto > Added Address |
	| Update Field Name           | Address              |
	| Update Field Original Value | N/A                  |
	| Update Field New Value      | 456 Fake Street      |''');

		LocalFile.ProvisioningAccount.viewAccountHistoryEntryByKeyword(
			fieldName = "Address",
			keyword = "Auto > Added Address",
			table = '''| Update Description          | Auto > Added Address          |
	| Update Field Name           | Address                       |
	| Update Field Original Value | N/A                           |
	| Update Field New Value      | Diamond Bar, California 91765 |''');

		LocalFile.ProvisioningAccount.viewAccountHistoryEntryByKeyword(
			fieldName = "Address",
			keyword = "Auto > Added Address",
			table = '''| Update Description          | Auto > Added Address |
	| Update Field Name           | Address              |
	| Update Field Original Value | N/A                  |
	| Update Field New Value      | United States        |''');

		LocalFile.ProvisioningAccount.viewAccountHistoryEntryByKeyword(
			fieldName = "Address",
			keyword = "Provisioning Account Worker > Added Address",
			table = '''| Update Description          | Provisioning Account Worker > Added Address |
	| Update Field Name           | Address                                     |
	| Update Field Original Value | N/A                                         |
	| Update Field New Value      | 456 Main Street                             |''');

		LocalFile.ProvisioningAccount.viewAccountHistoryEntryByKeyword(
			fieldName = "Address",
			keyword = "Provisioning Account Worker > Added Address",
			table = '''| Update Description          | Provisioning Account Worker > Added Address |
	| Update Field Name           | Address                                     |
	| Update Field Original Value | N/A                                         |
	| Update Field New Value      | Vancouver, British Columbia V5Y 0C9         |''');

		LocalFile.ProvisioningAccount.viewAccountHistoryEntryByKeyword(
			fieldName = "Address",
			keyword = "Provisioning Account Worker > Added Address",
			table = '''| Update Description          | Provisioning Account Worker > Added Address |
	| Update Field Name           | Address                                     |
	| Update Field Original Value | N/A                                         |
	| Update Field New Value      | Canada                                      |''');
	}

	test Assignparentaccount {
		LocalFile.OSBAdminRabbitMQ.publishCreateProjectWithNoPartnerMessage(
			routingKey = "dossiera.provisioning.create",
			table = '''| Account Name                           | Misper - ${staticCompanyName}              |
	| Address City                           | Diamond Bar                                |
	| Address Country                        | United States                              |
	| Address Postal Code                    | 91765                                      |
	| Address Region                         | California                                 |
	| Address Street                         | 456 Fake Street                            |
	| Contact Email Address                  | prm.koroneiki1@lrcustomer.com.broken       |
	| Contact First Name                     | PRM                                        |
	| Contact Last Name                      | Koroneiki1                                 |
	| Dossiera Account Key                   | ${staticDossieraAccountKey}                |
	| Dossiera Address Key 1                 | ${staticDossieraAddressKey1}               |
	| Dossiera Address Key 2                 | ${staticDossieraAddressKey2}               |
	| Dossiera Contact Key                   | ${staticDossieraContactKey}                |
	| Dossiera Project Key                   | ${staticDossieraProjectKey}                |
	| End Day                                | ${staticEndDay}                            |
	| End Month                              | ${staticEndMonth}                          |
	| End Year                               | ${staticEndYear}                           |
	| Industry                               | Automotive                                 |
	| Owner Email Address                    | prm.koroneiki2@lrcustomer.com.broken       |
	| Owner First Name                       | PRM                                        |
	| Owner Last Name                        | Koroneiki2                                 |
	| Partner First Line Support             | false                                      |
	| Product Type                           | New                                        |
	| Product Name                           | Liferay Digital Enterprise - Prod Sizing 4 |
	| Project Name                           | Permis - ${staticProjectName}              |
	| Renewal                                | false                                      |
	| Salesforce Opportunity Key             | ${staticSalesforceOpportunityKey}          |
	| Salesforce Opportunity Line Item Key 1 | ${staticSalesforceOpportunityLineItemKey1} |
	| Salesforce Opportunity Line Item Key 2 | ${staticSalesforceOpportunityLineItemKey2} |
	| Salesforce Opportunity Sold By         | Liferay US                                 |
	| Salesforce Opportunity Stage Name      | Closed Won                                 |
	| Salesforce Opportunity Territory       | United States                              |
	| Salesforce Opportunity Type            | New Business                               |
	| Salesforce Owner User Key              | ${staticSalesforceOwnerUserKey}            |
	| Salesforce Project Key                 | ${staticSalesforceProjectKey}              |
	| Start Day                              | ${staticStartDay}                          |
	| Start Month                            | ${staticStartMonth}                        |
	| Start Year                             | ${staticStartYear}                         |
	| Subscription Level                     | Platinum                                   |
	| Version Number                         | 7.1                                        |''');

		LocalFile.KoroneikiAccountAPI._createAccountTeam(
			accountName = "Permis - ${staticProjectName}",
			teamName = "Permission Partner");

		LocalFile.KoroneikiAccountAPI._assignTeamRolesToTeam(
			accountName = "Permis - ${staticProjectName}",
			table = '''| Partner            |
	| First Line Support |''',
			teamName = "Permission Partner");

		LocalFile.KoroneikiAccountAPI._createAccount(table = '''| Code                  | RCHILDRCHILD                                 | |
	| Contact Email Address | prm.koroneiki2@lrcustomer.com.broken         | |
	| Description           | Test provisioning child account on koroneiki | |
	| Fax Number            | 555-555-9012                                 | |
	| Name                  | Rchild - ${staticProjectName}                | |
	| Phone Number          | 555-555-3456                                 | |
	| Profile Email Address | prm.koroneiki2@lrcustomer.com.broken         | |
	| Region                | United States                                | |
	| Status                | Active                                       | |
	| Tier                  | T4                                           | |
	| Website               | www.pchildsubsidiary.com                     | |''');

		LocalFile.KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		LocalFile.KoroneikiProductPurchaseAPI.generateStaticFullStartAndEndDate();

		LocalFile.KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Rchild - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | true                     | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		LocalFile.KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Rchild - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | true                     | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		LocalFile.KoroneikiAccountAPI._assignTeamRolesToTeam(
			accountName = "Rchild - ${staticProjectName}",
			table = '''| Partner            |
	| First Line Support |''',
			teamName = "Permission Partner");

		LocalFile.OSBAdmin.loginToProvisioning(
			userEmailAddress = "provisioning.account.worker@liferay.com.broken",
			userPassword = ${staticProvisioningQaUserPassword});

		LocalFile.UserAccount.updatePasswordUponLogin(userPassword = "test");

		LocalFile.Provisioning.gotoAccounts();

		LocalFile.Provisioning.searchAccounts(keyword = "Rchild");

		LocalFile.Provisioning.clickAccount(accountName = "Rchild - ${staticProjectName}");

		LocalFile.Provisioning.clickTab(tabName = "Details");

		LocalFile.ProvisioningAccount.editAccountDetails(table = '''| Parent | Select Entity | Permis - ${staticProjectName} | |''');

		LocalFile.ProvisioningAccount._viewAccountDetailsViaDetailsTab(table = '''| Parent | Permis - ${staticProjectName} | |''');

		LocalFile.Provisioning.gotoAccounts();

		LocalFile.Provisioning.searchAccounts(keyword = "Permis");

		LocalFile.Provisioning.clickAccount(accountName = "Permis - ${staticProjectName}");

		LocalFile.Provisioning.clickTab(tabName = "Related Accounts");

		LocalFile.ProvisioningAccount.searchRelatedAccounts(keyword = "Rchild");

		LocalFile.ProvisioningAccount._viewAccountRelatedAccount(
			accountName = "Rchild - ${staticProjectName}",
			table = '''| Name             | Rchild - ${staticProjectName} |
	| Code             | RCHILDRCHILD                  |
	| Support End Date | Perpetual                     |
	| Partner          | Permission Partner            |
	| Region           | United States                 |
	| SLA              | Platinum                      |
	| Tier             | T4                            |
	| State            | ACTIVE                        |''');

		LocalFile.ProvisioningAccount._viewAccountRelatedAccountUnderSection(
			accountName = "Rchild - ${staticProjectName}",
			accountSection = "Child Accounts");

		LocalFile.ProvisioningAccount.viewRelatedAccountTabCount(
			countValue = 2,
			tabName = "All");

		LocalFile.ProvisioningAccount.viewRelatedAccountTabCount(
			countValue = 2,
			tabName = "Active");

		LocalFile.ProvisioningAccount.viewRelatedAccountTabCount(
			countValue = 0,
			tabName = "Closed");

		LocalFile.ProvisioningAccount.clickRelatedAccountTab(tabName = "Active");

		LocalFile.ProvisioningAccount.searchRelatedAccounts(keyword = "Rchild");

		LocalFile.ProvisioningAccount._viewAccountRelatedAccount(
			accountName = "Rchild - ${staticProjectName}",
			table = '''| Name             | Rchild - ${staticProjectName} |
	| Code             | RCHILDRCHILD                  |
	| Support End Date | Perpetual                     |
	| Partner          | Permission Partner            |
	| Region           | United States                 |
	| SLA              | Platinum                      |
	| Tier             | T4                            |
	| State            | ACTIVE                        |''');

		LocalFile.ProvisioningAccount.clickRelatedAccountTab(tabName = "Closed");

		LocalFile.ProvisioningAccount.searchRelatedAccounts(keyword = "Rchild");

		LocalFile.ProvisioningAccount._viewNoAccountRelatedAccount(accountName = "Rchild - ${staticProjectName}");

		LocalFile.ProvisioningAccount.clickRelatedAccountTab(tabName = "All");

		LocalFile.ProvisioningAccount.clickRelatedAccount(accountName = "Rchild - ${staticProjectName}");

		LocalFile.ProvisioningAccount._viewAccountDetails(table = '''| Name           | Rchild - ${staticProjectName} |
	| Code           | RCHILDRCHILD                  |
	| State          | ACTIVE                        |
	| Support Region | United States                 |
	| SLA            | Platinum                      |
	| Support Seats  | 0 / 3 Filled                  |
	| Tier           | T4                            |
	| FLS Partner    | Permission Partner            |''');

		LocalFile.Provisioning.clickTab(tabName = "Details");

		LocalFile.ProvisioningAccount._viewAccountDetailsViaDetailsTab(table = '''| Parent | Permis - ${staticProjectName} | |''');

		LocalFile.Provisioning.gotoAccounts();

		LocalFile.Provisioning.searchAccounts(keyword = "Rchild");

		LocalFile.Provisioning.clickAccount(accountName = "Rchild - ${staticProjectName}");

		LocalFile.ProvisioningAccount._viewAccountDetails(table = '''| Name           | Rchild - ${staticProjectName} |
	| Code           | RCHILDRCHILD                  |
	| State          | ACTIVE                        |
	| Support Region | United States                 |
	| SLA            | Platinum                      |
	| Support Seats  | 0 / 3 Filled                  |
	| Tier           | T4                            |
	| FLS Partner    | Permission Partner            |''');

		LocalFile.Provisioning.clickTab(tabName = "Related Accounts");

		LocalFile.ProvisioningAccount.searchRelatedAccounts(keyword = "Permis");

		LocalFile.ProvisioningAccount._viewAccountRelatedAccount(
			accountName = "Permis - ${staticProjectName}",
			table = '''| Name             | Permis - ${staticProjectName} |
	| Code             | MISPERPERMIS                  |
	| Partner          | Permission Partner            |
	| Region           | United States                 |
	| SLA              | Platinum                      |
	| Tier             | T4                            |
	| State            | ACTIVE                        |''');

		LocalFile.ProvisioningAccount._viewAccountRelatedAccountUnderSection(
			accountName = "Permis - ${staticProjectName}",
			accountSection = "Parent Account");

		LocalFile.ProvisioningAccount.viewRelatedAccountTabCount(
			countValue = 1,
			tabName = "All");

		LocalFile.ProvisioningAccount.viewRelatedAccountTabCount(
			countValue = 1,
			tabName = "Active");

		LocalFile.ProvisioningAccount.viewRelatedAccountTabCount(
			countValue = 0,
			tabName = "Closed");

		LocalFile.ProvisioningAccount.clickRelatedAccountTab(tabName = "Active");

		LocalFile.ProvisioningAccount.searchRelatedAccounts(keyword = "Permis");

		LocalFile.ProvisioningAccount._viewAccountRelatedAccount(
			accountName = "Permis - ${staticProjectName}",
			table = '''| Name             | Permis - ${staticProjectName} |
	| Code             | MISPERPERMIS                  |
	| Partner          | Permission Partner            |
	| Region           | United States                 |
	| SLA              | Platinum                      |
	| Tier             | T4                            |
	| State            | ACTIVE                        |''');

		LocalFile.ProvisioningAccount.clickRelatedAccountTab(tabName = "Closed");

		LocalFile.ProvisioningAccount.searchRelatedAccounts(keyword = "Permis");

		LocalFile.ProvisioningAccount._viewNoAccountRelatedAccount(accountName = "Permis - ${staticProjectName}");

		LocalFile.ProvisioningAccount.clickRelatedAccountTab(tabName = "All");

		LocalFile.ProvisioningAccount.clickRelatedAccount(accountName = "Permis - ${staticProjectName}");

		LocalFile.ProvisioningAccount._viewAccountDetails(table = '''| Name           | Permis - ${staticProjectName} |
	| Code           | MISPERPERMIS                  |
	| State          | ACTIVE                        |
	| Support Region | United States                 |
	| Country        | United States                 |
	| SLA            | Platinum                      |
	| Support Seats  | 1 / 3 Filled                  |
	| Tier           | T4                            |
	| FLS Partner    | Permission Partner            |''');

		LocalFile.Provisioning.clickTab(tabName = "Details");

		LocalFile.ProvisioningAccount._viewAccountDetailsViaDetailsTab(table = '''| Parent | Misper - ${staticCompanyName} | |''');

		LocalFile.KoroneikiAccountAPI._viewChildAccount(
			childAccountName = "Rchild - ${staticProjectName}",
			parentAccountName = "Permis - ${staticProjectName}",
			table = '''| Code                  | RCHILDRCHILD                                 | |
	| Contact Email Address | prm.koroneiki2@lrcustomer.com.broken         | |
	| Description           | Test provisioning child account on koroneiki | |
	| Fax Number            | 555-555-9012                                 | |
	| Name                  | Rchild - ${staticProjectName}                | |
	| Phone Number          | 555-555-3456                                 | |
	| Profile Email Address | prm.koroneiki2@lrcustomer.com.broken         | |
	| Region                | United States                                | |
	| Status                | Active                                       | |
	| Tier                  | T4                                           | |
	| Website               | www.pchildsubsidiary.com                     | |''');
	}

	test Createaccount {
		LocalFile.OSBAdmin.loginToProvisioning(
			userEmailAddress = "provisioning.account.worker@liferay.com.broken",
			userPassword = ${staticProvisioningQaUserPassword});

		LocalFile.UserAccount.updatePasswordUponLogin(userPassword = "test");

		LocalFile.Provisioning.gotoAccounts();

		LocalFile.Provisioning.clickNewAccountButton();

