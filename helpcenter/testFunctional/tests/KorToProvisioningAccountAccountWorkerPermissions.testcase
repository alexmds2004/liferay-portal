	test Updateaccountcomplimentarylicensepermissioninprovisioningaccountdetails {
		LocalFile.OSBAdminRabbitMQ.generateProvisioningProjectName();

		LocalFile.KoroneikiAccountAPI._createAccount(table = '''| Code                  | MISPERPERMIS                         | |
	| Contact Email Address | prm.koroneiki1@lrcustomer.com.broken | |
	| Description           | Test osb account on koroneiki        | |
	| Fax Number            | 555-555-1234                         | |
	| Name                  | Permis - ${staticProjectName}        | |
	| Phone Number          | 555-555-5678                         | |
	| Profile Email Address | prm.koroneiki1@lrcustomer.com.broken | |
	| Region                | United States                        | |
	| Status                | Active                               | |
	| Tier                  | T4                                   | |
	| Website               | www.koroneikicorporation.com         | |''');

		LocalFile.KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Permis - ${staticProjectName}",
			contactEmailAddress = "prm.koroneiki1@lrcustomer.com.broken",
			table = '''| Support Requester |''');

		LocalFile.KoroneikiAccountAPI._generateAccountKey(accountName = "Permis - ${staticProjectName}");

		LocalFile.KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Permis - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| End Date                | ${staticEndDate}         |   |
	| Original End Date       | ${staticOriginalEndDate} |   |
	| Perpetual               | false                    |   |
	| Product Field and Value | sizing                   | 1 |
	| Product Field and Value | licenses                 | 1 |
	| Product Field and Value | version                  | 7 |
	| Quantity                | 1                        |   |
	| Start Date              | ${staticStartDate}       |   |
	| Status                  | Approved                 |   |''');

		LocalFile.KoroneikiProductPurchaseAPI._generateProductPurchaseId(
			accountName = "Permis - ${staticProjectName}",
			productName = "DXP Production");

		LocalFile.KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Permis - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		LocalFile.OSBAdmin.loginToProvisioning(
			userEmailAddress = "provisioning.account.worker@liferay.com.broken",
			userPassword = ${staticProvisioningQaUserPassword});

		LocalFile.Provisioning.gotoAccounts();

		LocalFile.Provisioning.searchAccounts(keyword = "Permis");

		LocalFile.Provisioning.clickAccount(accountName = "Permis - ${staticProjectName}");

		LocalFile.Provisioning.clickTab(tabName = "Details");

		LocalFile.ProvisioningAccount.editAccountDetails(table = '''| Complimentary | Toggle Switch | true | |''');

		LocalFile.ProvisioningAccount.assertToggleSwitchEnabled(
			field = "Complimentary",
			positionValue = 1);

		LocalFile.ProvisioningAccount._viewAccountDetailsViaDetailsTab(table = '''| Account Name        | Permis - ${staticProjectName} |   |
	| State               | ACTIVE                        |   |
	| Code                | MISPERPERMIS                  |   |
	| Tier                | T4                            |   |
	| Complimentary       | true                          |   |''');
	}

