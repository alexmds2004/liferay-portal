definition {

	property testray.main.component.name = "Support QA";
	property type = "koroneiki";

	tearDown {
		KoroneikiContactAPI._tearDownContactPermissions(contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken");

		KoroneikiAccountAPI._tearDownAccountPermissions(accountName = "Koroneiki Automotive");

		KoroneikiContactRoleAPI._tearDownContactRolePermissionsViaNameAndType(
			contactRoleName = "Member",
			contactRoleType = "Account Customer");

		KoroneikiAccountAPI._tearDownAccounts(table = '''| Koroneiki Automotive |''');

		KoroneikiContactAPI._tearDownContacts(table = '''| koroneiki.contact1@lrcustomer.com.broken |''');
	}

	test Assigncustomercontacttoaccountaspermissioneduser {
		KoroneikiContactAPI._createContact(table = '''| Email Address | koroneiki.contact1@lrcustomer.com.broken |
	| First Name    | Koroneiki                                |
	| Language      | English                                  |
	| Last Name     | Contact1                                 |
	| Middle Name   | User                                     |''');

		KoroneikiAccountAPI._createAccount(table = '''| Code         | KORAUTO                              | |
	| Description  | Test automotive account on koroneiki | |
	| Fax Number   | 555-555-1234                         | |
	| Name         | Koroneiki Automotive                 | |
	| Phone Number | 555-555-5678                         | |
	| Region       | United States                        | |
	| Status       | Active                               | |
	| Tier         | T4                                   | |
	| Website      | www.koroneikiautomotive.com          | |''');

		KoroneikiAccountAPI._setAccountPermissions(
			accountName = "Koroneiki Automotive",
			table = '''| Assign Contact | true |''');

		KoroneikiContactAPI._setContactPermissionsViaUuid(
			contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken",
			table = '''| View | true |''');

		KoroneikiContactRoleAPI._setContactRolePermissionsViaNameAndType(
			contactRoleName = "Member",
			contactRoleType = "Account Customer",
			table = '''| Assign Contact | true |''');

		KoroneikiAccountAPIPermissionCheck._assignCustomerContacts(
			accountName = "Koroneiki Automotive",
			table = '''| koroneiki.contact1@lrcustomer.com.broken |''');

		KoroneikiAccountAPI._viewContact(
			accountName = "Koroneiki Automotive",
			contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken");

		KoroneikiAccountAPI._viewCustomerContact(
			accountName = "Koroneiki Automotive",
