		LocalFile.KoroneikiTeamAPI._deleteTeam(teamName = "Development Team");

		LocalFile.KoroneikiTeamAPI._deleteTeam(teamName = "Marketing Team");

		LocalFile.KoroneikiTeamAPI._viewNoTeam(teamName = "Development Team");

		LocalFile.KoroneikiTeamAPI._viewNoTeam(teamName = "Marketing Team");

		LocalFile.KoroneikiAccountAPI._viewNoAccountTeam(
