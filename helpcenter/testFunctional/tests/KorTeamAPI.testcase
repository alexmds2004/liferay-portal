	| Profile Email Address | koroneiki.contact1@lrcustomer.com.broken | |
	| Region                | United States                            | |
	| Status                | Active                                   | |
	| Tier                  | T4                                       | |
	| Website               | www.koroneikiautomotive.com              | |''');

		LocalFile.KoroneikiAccountAPI._createAccountTeam(
			accountName = "Koroneiki Automotive",
			teamName = "Development Team");

		LocalFile.KoroneikiTeamAPI._viewTeam(teamName = "Development Team");

		LocalFile.KoroneikiAccountAPI._viewAccountTeam(
			accountName = "Koroneiki Automotive",
			teamName = "Development Team");
	}

	test Createandviewteamexternallink {
		LocalFile.KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORAUTO                                  | |
	| Contact Email Address | koroneiki.contact1@lrcustomer.com.broken | |
	| Description           | Test automotive account on koroneiki     | |
	| Fax Number            | 555-555-1234                             | |
	| Name                  | Koroneiki Automotive                     | |
	| Phone Number          | 555-555-5678                             | |
	| Profile Email Address | koroneiki.contact1@lrcustomer.com.broken | |
	| Region                | United States                            | |
	| Status                | Active                                   | |
	| Tier                  | T4                                       | |
	| Website               | www.koroneikiautomotive.com              | |''');

		LocalFile.KoroneikiAccountAPI._createAccountTeam(
			accountName = "Koroneiki Automotive",
			teamName = "Development Team");

		LocalFile.KoroneikiTeamAPI._createTeamExternalLink(
			table = '''| Domain      | devteam |
	| Entity Id   | 1234    |
	| Entity Name | DevTeam |''',
			teamName = "Development Team");

		LocalFile.KoroneikiTeamAPI._createTeamExternalLinkNestedField(table = '''| Domain      | devteam |
	| Entity Id   | 1234    |
	| Entity Name | DevTeam |''');

		LocalFile.KoroneikiTeamAPI._viewTeamWithExternalLink(
			teamExternalLinkNestedFieldPartialValue = "devteam",
			teamName = "Development Team");

		LocalFile.KoroneikiTeamAPI._viewTeamExternalLink(
			entityId = 1234,
			table = '''| Domain      | devteam |
	| Entity Id   | 1234    |
	| Entity Name | DevTeam |''',
			teamName = "Development Team");

		LocalFile.KoroneikiTeamAPI._viewTeamExternalLinkViaExternalLinkKey(
			entityId = 1234,
			table = '''| Domain      | devteam |
	| Entity Id   | 1234    |
	| Entity Name | DevTeam |''',
			teamName = "Development Team");

		LocalFile.KoroneikiTeamAPI._viewTeamViaExternalLink(
			domain = "devteam",
			entityId = 1234,
			entityName = "DevTeam",
			teamName = "Development Team");
	}

	test Createandviewteamsonaccountandchildaccount {
		LocalFile.KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORAUTO                                  | |
	| Contact Email Address | koroneiki.contact1@lrcustomer.com.broken | |
	| Description           | Test automotive account on koroneiki     | |
	| Fax Number            | 555-555-1234                             | |
	| Name                  | Koroneiki Automotive                     | |
	| Phone Number          | 555-555-5678                             | |
	| Profile Email Address | koroneiki.contact1@lrcustomer.com.broken | |
	| Region                | United States                            | |
	| Status                | Active                                   | |
	| Tier                  | T4                                       | |
	| Website               | www.koroneikiautomotive.com              | |''');

		LocalFile.KoroneikiAccountAPI._createChildAccount(
			accountName = "Koroneiki Automotive",
			table = '''| Code                  | KORAUTOSUB                                 | |
	| Contact Email Address | koroneiki.contact2@lrcustomer.com.broken   | |
	| Description           | Test automotive child account on koroneiki | |
	| Fax Number            | 555-555-9012                               | |
	| Name                  | Koroneiki Auto Subsidiary                  | |
	| Phone Number          | 555-555-3456                               | |
	| Profile Email Address | koroneiki.contact2@lrcustomer.com.broken   | |
	| Region                | United States                              | |
	| Status                | Active                                     | |
	| Tier                  | T4                                         | |
	| Website               | www.koroneikiautomotivesubsidiary.com      | |''');

		LocalFile.KoroneikiAccountAPI._createAccountTeam(
			accountName = "Koroneiki Automotive",
			teamName = "Development Team");

		LocalFile.KoroneikiAccountAPI._createAccountTeam(
			accountName = "Koroneiki Auto Subsidiary",
			teamName = "Marketing Team");

		LocalFile.KoroneikiTeamAPI._viewTeam(teamName = "Development Team");

		LocalFile.KoroneikiTeamAPI._viewTeam(teamName = "Marketing Team");

		LocalFile.KoroneikiAccountAPI._viewAccountTeam(
			accountName = "Koroneiki Automotive",
			teamName = "Development Team");

		LocalFile.KoroneikiAccountAPI._viewAccountTeam(
			accountName = "Koroneiki Auto Subsidiary",
			teamName = "Marketing Team");

		LocalFile.KoroneikiAccountAPI._viewNoAccountTeam(
			accountName = "Koroneiki Auto Subsidiary",
			teamName = "Development Team");

		LocalFile.KoroneikiAccountAPI._viewNoAccountTeam(
			accountName = "Koroneiki Automotive",
			teamName = "Marketing Team");
	}

