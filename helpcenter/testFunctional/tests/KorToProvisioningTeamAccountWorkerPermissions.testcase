definition {

	property testray.main.component.name = "Support QA";
	property type = "provisioning.security";

	setUp {
		LocalFile.Passwords.getPasswords();

		LocalFile.OSBAdminRabbitMQ.generateStaticVariables();

		LocalFile.OSBAdminRabbitMQ.generateProvisioningCompanyName();

		LocalFile.OSBAdminRabbitMQ.generateProvisioningProjectName();

		LocalFile.JSONUser.createViaProvisioning(table = '''| Screen Name   | provisioning.account.worker                    |
	| Email Address | provisioning.account.worker@liferay.com.broken |
	| First Name    | Provisioning                                   |
	| Last Name     | Account Worker                                 |''');

		LocalFile.JSONUser.assignUserToProvisioningRole(
			roleName = "Provisioning Account Worker",
			userEmailAddress = "provisioning.account.worker@liferay.com.broken");

		LocalFile.JSONOkta.createOktaUser(table = '''| Screen Name   | prm.koroneiki1                       |
	| Email Address | prm.koroneiki1@lrcustomer.com.broken |
	| First Name    | PRM                                  |
	| Last Name     | Koroneiki1                           |''');

		LocalFile.JSONOkta.createOktaUser(table = '''| Screen Name   | prm.koroneiki2                       |
	| Email Address | prm.koroneiki2@lrcustomer.com.broken |
	| First Name    | PRM                                  |
	| Last Name     | Koroneiki2                           |''');
	}

	tearDown {
		LocalFile.ZendeskUserAPI._getDefaultUserId(organizationName = "Permis - ${staticProjectName}");

		LocalFile.ZendeskUserAPI._renameFirstDefaultUserIdVariable();

		LocalFile.ZendeskUserAPI._getDefaultUserId(organizationName = "Misper - ${staticCompanyName}");

		LocalFile.ZendeskUserAPI._renameSecondDefaultUserIdVariable();

		LocalFile.KoroneikiTeamAPI._tearDownTeams(table = '''| Permission Partner |
	| Perm New Partner   |
	| Permissioning Team |
	| Updated Perm Team  |''');

		LocalFile.OSBAdminProject.tearDownProjects(table = '''| MISPERPERMIS |
	| MISPER       |''');

		LocalFile.KoroneikiAccountAPI._tearDownAccounts(table = '''| Permis - ${staticProjectName} |
	| Misper - ${staticCompanyName} |''');

		LocalFile.KoroneikiAccountAPI._tearDownAccountsViaAccountFieldNameAndValue(
			fieldName = "Code",
			table = '''| MISPERPERMIS |
	| MISPER       |''');

		LocalFile.JSONUser.tearDownUsers(table = '''| prm.koroneiki1@lrcustomer.com.broken |
	| prm.koroneiki2@lrcustomer.com.broken |''');

		LocalFile.JSONUser.tearDownUsersViaSupport(table = '''| prm.koroneiki1@lrcustomer.com.broken |
	| prm.koroneiki2@lrcustomer.com.broken |''');

		LocalFile.JSONUser.tearDownUsersViaKoroneiki(table = '''| prm.koroneiki1@lrcustomer.com.broken |
	| prm.koroneiki2@lrcustomer.com.broken |''');

		LocalFile.KoroneikiContactAPI._tearDownContacts(table = '''| prm.koroneiki1@lrcustomer.com.broken |
	| prm.koroneiki2@lrcustomer.com.broken |''');

		LocalFile.JSONOkta.tearDownUsers(table = '''| prm.koroneiki1@lrcustomer.com.broken |
	| prm.koroneiki2@lrcustomer.com.broken |''');

		LocalFile.ZendeskTicketAPI._tearDownTicketsByKeywords(table = '''| New Subscription(s) for Permis - ${staticProjectName} |
	| New Subscription(s) for Misper - ${staticCompanyName} |''');

		LocalFile.ZendeskUserAPI._getMultipleUserIdsByEmailAddress(table = '''| prm.koroneiki1@lrcustomer.com.broken |
	| prm.koroneiki2@lrcustomer.com.broken |''');

		LocalFile.ZendeskUserAPI._tearDownUsersByIdList(userIds = ${staticUserIdList});

		LocalFile.ZendeskOrganizationAPI._getMultipleOrganizationExternalIdsByOrganizationNameIfStillPresent(table = '''| Permis - ${staticProjectName} |
	| Misper - ${staticCompanyName} |''');

		LocalFile.ZendeskOrganizationAPI._tearDownOrganizationsByExternalIdList(organizationExternalIds = ${staticOrganizationExternalIdList});

		LocalFile.ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId1});

		LocalFile.ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId2});

		LocalFile.JSONUser.tearDownUsersViaProvisioning(table = '''| provisioning.account.worker@liferay.com.broken |''');
	}

	test Assignteammember {
		LocalFile.OSBAdminRabbitMQ.publishCreateProjectWithNoPartnerMessage(
			routingKey = "dossiera.provisioning.create",
			table = '''| Account Name                           | Misper - ${staticCompanyName}              |
	| Address City                           | Diamond Bar                                |
	| Address Country                        | United States                              |
	| Address Postal Code                    | 91765                                      |
	| Address Region                         | California                                 |
	| Address Street                         | 456 Fake Street                            |
	| Contact Email Address                  | prm.koroneiki1@lrcustomer.com.broken       |
	| Contact First Name                     | PRM                                        |
	| Contact Last Name                      | Koroneiki1                                 |
	| Dossiera Account Key                   | ${staticDossieraAccountKey}                |
	| Dossiera Address Key 1                 | ${staticDossieraAddressKey1}               |
	| Dossiera Address Key 2                 | ${staticDossieraAddressKey2}               |
	| Dossiera Contact Key                   | ${staticDossieraContactKey}                |
	| Dossiera Project Key                   | ${staticDossieraProjectKey}                |
	| End Day                                | ${staticEndDay}                            |
	| End Month                              | ${staticEndMonth}                          |
	| End Year                               | ${staticEndYear}                           |
	| Industry                               | Automotive                                 |
	| Owner Email Address                    | prm.koroneiki2@lrcustomer.com.broken       |
	| Owner First Name                       | PRM                                        |
	| Owner Last Name                        | Koroneiki2                                 |
	| Partner First Line Support             | false                                      |
	| Product Type                           | New                                        |
	| Product Name                           | Liferay Digital Enterprise - Prod Sizing 4 |
	| Project Name                           | Permis - ${staticProjectName}              |
	| Renewal                                | false                                      |
	| Salesforce Opportunity Key             | ${staticSalesforceOpportunityKey}          |
	| Salesforce Opportunity Line Item Key 1 | ${staticSalesforceOpportunityLineItemKey1} |
	| Salesforce Opportunity Line Item Key 2 | ${staticSalesforceOpportunityLineItemKey2} |
	| Salesforce Opportunity Sold By         | Liferay US                                 |
	| Salesforce Opportunity Stage Name      | Closed Won                                 |
	| Salesforce Opportunity Territory       | United States                              |
	| Salesforce Opportunity Type            | New Business                               |
	| Salesforce Owner User Key              | ${staticSalesforceOwnerUserKey}            |
	| Salesforce Project Key                 | ${staticSalesforceProjectKey}              |
	| Start Day                              | ${staticStartDay}                          |
	| Start Month                            | ${staticStartMonth}                        |
	| Start Year                             | ${staticStartYear}                         |
	| Subscription Level                     | Platinum                                   |
	| Version Number                         | 7.1                                        |''');

		LocalFile.KoroneikiAccountAPI._createAccountTeam(
			accountName = "Permis - ${staticProjectName}",
			teamName = "Permission Partner");

		LocalFile.KoroneikiAccountAPI._assignTeamRolesToTeam(
			accountName = "Permis - ${staticProjectName}",
			table = '''| Partner |''',
			teamName = "Permission Partner");

		LocalFile.OSBAdmin.loginToProvisioning(
			userEmailAddress = "provisioning.account.worker@liferay.com.broken",
			userPassword = ${staticProvisioningQaUserPassword});

		LocalFile.UserAccount.updatePasswordUponLogin(userPassword = "test");

		LocalFile.Provisioning.gotoAccounts();

		LocalFile.Provisioning.searchAccounts(keyword = "Permis");

		LocalFile.Provisioning.clickAccount(accountName = "Permis - ${staticProjectName}");

		LocalFile.Provisioning.clickTab(tabName = "Teams");

		LocalFile.ProvisioningAccount.search(keyword = "Permission");

		LocalFile.ProvisioningAccount.clickTeamLink(teamName = "Permission Partner");

		LocalFile.ProvisioningTeam.clickAssignMembersButton();

		LocalFile.ProvisioningTeam.assignMember(memberEmailAddress = "prm.koroneiki1@lrcustomer.com.broken");

		LocalFile.ProvisioningTeam.search(keyword = "prm.koroneiki1@lrcustomer.com.broken");

		LocalFile.ProvisioningTeam._viewTeamMember(
			memberEmailAddress = "prm.koroneiki1@lrcustomer.com.broken",
			table = '''| Name          | PRM Koroneiki1                       |
	| Email Address | prm.koroneiki1@lrcustomer.com.broken |
	| Status        | VERIFIED                             |''');

		LocalFile.KoroneikiTeamAPI._viewContact(
			contactEmailAddress = "prm.koroneiki1@lrcustomer.com.broken",
			teamName = "Permission Partner");

		LocalFile.KoroneikiTeamAPI._viewContactViaNestedField(
			contactEmailAddress = "prm.koroneiki1@lrcustomer.com.broken",
			teamName = "Permission Partner");

		LocalFile.Provisioning.gotoAccounts();

		LocalFile.Provisioning.searchAccounts(keyword = "Permis");

		LocalFile.Provisioning.clickAccount(accountName = "Permis - ${staticProjectName}");

		LocalFile.Provisioning.clickTab(tabName = "Teams");

		LocalFile.ProvisioningAccount.search(keyword = "Permis");

		LocalFile.ProvisioningAccount._viewAccountTeam(
			table = '''| Name   | Permis - ${staticProjectName} |
	| Member | PRM Koroneiki1                |''',
			teamName = "Permis - ${staticProjectName}");

		LocalFile.ProvisioningAccount.clickTeamLink(teamName = "Permis - ${staticProjectName}");

		LocalFile.ProvisioningTeam._viewTeamDetails(table = '''| Name | Permis - ${staticProjectName} |''');

		LocalFile.ProvisioningTeam.search(keyword = "prm.koroneiki1@lrcustomer.com.broken");

		LocalFile.ProvisioningTeam._viewTeamMember(
			memberEmailAddress = "prm.koroneiki1@lrcustomer.com.broken",
			table = '''| Name          | PRM Koroneiki1                       |
	| Email Address | prm.koroneiki1@lrcustomer.com.broken |
	| Status        | VERIFIED                             |''');

		LocalFile.Provisioning.gotoAccounts();

		LocalFile.Provisioning.searchAccounts(keyword = "Permis");

		LocalFile.Provisioning.clickAccount(accountName = "Permis - ${staticProjectName}");

		LocalFile.Provisioning.clickTab(tabName = "History");

		LocalFile.ProvisioningAccount.viewAccountHistoryEntryByKeyword(
			fieldName = "Contact",
			keyword = "Provisioning Account Worker > Updated Team",
			table = '''| Update Description          | Provisioning Account Worker > Updated Team > Permission Partner Member |
	| Update Field Name           | Contact                                                                |
	| Update Field Original Value | N/A                                                                    |
	| Update Field New Value      | PRM Koroneiki1                                                         |''');
	}

	test Createteam {
		LocalFile.OSBAdminRabbitMQ.publishCreateProjectWithNoPartnerMessage(
			routingKey = "dossiera.provisioning.create",
			table = '''| Account Name                           | Misper - ${staticCompanyName}              |
	| Address City                           | Diamond Bar                                |
	| Address Country                        | United States                              |
	| Address Postal Code                    | 91765                                      |
	| Address Region                         | California                                 |
	| Address Street                         | 456 Fake Street                            |
	| Contact Email Address                  | prm.koroneiki1@lrcustomer.com.broken       |
	| Contact First Name                     | PRM                                        |
	| Contact Last Name                      | Koroneiki1                                 |
	| Dossiera Account Key                   | ${staticDossieraAccountKey}                |
	| Dossiera Address Key 1                 | ${staticDossieraAddressKey1}               |
	| Dossiera Address Key 2                 | ${staticDossieraAddressKey2}               |
	| Dossiera Contact Key                   | ${staticDossieraContactKey}                |
	| Dossiera Project Key                   | ${staticDossieraProjectKey}                |
	| End Day                                | ${staticEndDay}                            |
	| End Month                              | ${staticEndMonth}                          |
	| End Year                               | ${staticEndYear}                           |
	| Industry                               | Automotive                                 |
	| Owner Email Address                    | prm.koroneiki2@lrcustomer.com.broken       |
	| Owner First Name                       | PRM                                        |
	| Owner Last Name                        | Koroneiki2                                 |
	| Partner First Line Support             | false                                      |
	| Product Type                           | New                                        |
	| Product Name                           | Liferay Digital Enterprise - Prod Sizing 4 |
	| Project Name                           | Permis - ${staticProjectName}              |
	| Renewal                                | false                                      |
	| Salesforce Opportunity Key             | ${staticSalesforceOpportunityKey}          |
	| Salesforce Opportunity Line Item Key 1 | ${staticSalesforceOpportunityLineItemKey1} |
	| Salesforce Opportunity Line Item Key 2 | ${staticSalesforceOpportunityLineItemKey2} |
	| Salesforce Opportunity Sold By         | Liferay US                                 |
	| Salesforce Opportunity Stage Name      | Closed Won                                 |
	| Salesforce Opportunity Territory       | United States                              |
	| Salesforce Opportunity Type            | New Business                               |
	| Salesforce Owner User Key              | ${staticSalesforceOwnerUserKey}            |
	| Salesforce Project Key                 | ${staticSalesforceProjectKey}              |
	| Start Day                              | ${staticStartDay}                          |
	| Start Month                            | ${staticStartMonth}                        |
	| Start Year                             | ${staticStartYear}                         |
	| Subscription Level                     | Platinum                                   |
	| Version Number                         | 7.1                                        |''');

		LocalFile.KoroneikiAccountAPI._createAccountTeam(
			accountName = "Permis - ${staticProjectName}",
			teamName = "Permission Partner");

		LocalFile.KoroneikiAccountAPI._assignTeamRolesToTeam(
			accountName = "Permis - ${staticProjectName}",
			table = '''| Partner |''',
			teamName = "Permission Partner");

		LocalFile.KoroneikiTeamAPI._assignContacts(
			table = '''| prm.koroneiki1@lrcustomer.com.broken |''',
			teamName = "Permission Partner");

		LocalFile.OSBAdmin.loginToProvisioning(
			userEmailAddress = "provisioning.account.worker@liferay.com.broken",
			userPassword = ${staticProvisioningQaUserPassword});

		LocalFile.UserAccount.updatePasswordUponLogin(userPassword = "test");

		LocalFile.Provisioning.gotoAccounts();

		LocalFile.Provisioning.searchAccounts(keyword = "Permis");

		LocalFile.Provisioning.clickAccount(accountName = "Permis - ${staticProjectName}");

		LocalFile.Provisioning.clickTab(tabName = "Teams");

		LocalFile.ProvisioningAccount.clickNewTeamButton();

		LocalFile.ProvisioningTeam.populateTeamFormAndSave(teamName = "Permissioning Team");

		LocalFile.ProvisioningTeam._viewTeamDetails(table = '''| Name | Permissioning Team |''');

		LocalFile.KoroneikiTeamAPI._viewTeam(teamName = "Permissioning Team");

		LocalFile.KoroneikiAccountAPI._viewAccountTeam(
			accountName = "Permis - ${staticProjectName}",
			teamName = "Permissioning Team");

		LocalFile.Provisioning.gotoAccounts();

		LocalFile.Provisioning.searchAccounts(keyword = "Permis");

		LocalFile.Provisioning.clickAccount(accountName = "Permis - ${staticProjectName}");

		LocalFile.Provisioning.clickTab(tabName = "Teams");

		LocalFile.ProvisioningAccount._viewAccountTeam(
			table = '''| Name | Permissioning Team |''',
			teamName = "Permissioning Team");

		LocalFile.ProvisioningAccount.clickTeamLink(teamName = "Permissioning Team");

		LocalFile.ProvisioningTeam._viewTeamDetails(table = '''| Name | Permissioning Team |''');

		LocalFile.Provisioning.gotoAccounts();

		LocalFile.Provisioning.searchAccounts(keyword = "Permis");

		LocalFile.Provisioning.clickAccount(accountName = "Permis - ${staticProjectName}");

		LocalFile.Provisioning.clickTab(tabName = "History");

		LocalFile.ProvisioningAccount.viewAccountHistoryEntryByKeyword(
			fieldName = "name",
			keyword = "Provisioning Account Worker > Added Team",
			table = '''| Update Description          | Provisioning Account Worker > Added Team > Permissioning Team |
	| Update Field Name           | name                                                          |
	| Update Field Original Value | N/A                                                           |
	| Update Field New Value      | Permissioning Team                                            |''');
	}

	test Deleteteam {
		LocalFile.OSBAdminRabbitMQ.publishCreateProjectWithNoPartnerMessage(
			routingKey = "dossiera.provisioning.create",
			table = '''| Account Name                           | Misper - ${staticCompanyName}              |
	| Address City                           | Diamond Bar                                |
	| Address Country                        | United States                              |
	| Address Postal Code                    | 91765                                      |
	| Address Region                         | California                                 |
	| Address Street                         | 456 Fake Street                            |
	| Contact Email Address                  | prm.koroneiki1@lrcustomer.com.broken       |
	| Contact First Name                     | PRM                                        |
	| Contact Last Name                      | Koroneiki1                                 |
	| Dossiera Account Key                   | ${staticDossieraAccountKey}                |
	| Dossiera Address Key 1                 | ${staticDossieraAddressKey1}               |
	| Dossiera Address Key 2                 | ${staticDossieraAddressKey2}               |
	| Dossiera Contact Key                   | ${staticDossieraContactKey}                |
	| Dossiera Project Key                   | ${staticDossieraProjectKey}                |
	| End Day                                | ${staticEndDay}                            |
	| End Month                              | ${staticEndMonth}                          |
	| End Year                               | ${staticEndYear}                           |
	| Industry                               | Automotive                                 |
	| Owner Email Address                    | prm.koroneiki2@lrcustomer.com.broken       |
	| Owner First Name                       | PRM                                        |
	| Owner Last Name                        | Koroneiki2                                 |
	| Partner First Line Support             | false                                      |
	| Product Type                           | New                                        |
	| Product Name                           | Liferay Digital Enterprise - Prod Sizing 4 |
	| Project Name                           | Permis - ${staticProjectName}              |
	| Renewal                                | false                                      |
	| Salesforce Opportunity Key             | ${staticSalesforceOpportunityKey}          |
	| Salesforce Opportunity Line Item Key 1 | ${staticSalesforceOpportunityLineItemKey1} |
	| Salesforce Opportunity Line Item Key 2 | ${staticSalesforceOpportunityLineItemKey2} |
	| Salesforce Opportunity Sold By         | Liferay US                                 |
	| Salesforce Opportunity Stage Name      | Closed Won                                 |
	| Salesforce Opportunity Territory       | United States                              |
	| Salesforce Opportunity Type            | New Business                               |
	| Salesforce Owner User Key              | ${staticSalesforceOwnerUserKey}            |
	| Salesforce Project Key                 | ${staticSalesforceProjectKey}              |
	| Start Day                              | ${staticStartDay}                          |
	| Start Month                            | ${staticStartMonth}                        |
	| Start Year                             | ${staticStartYear}                         |
	| Subscription Level                     | Platinum                                   |
	| Version Number                         | 7.1                                        |''');

		LocalFile.KoroneikiAccountAPI._createAccountTeam(
			accountName = "Permis - ${staticProjectName}",
			teamName = "Permission Partner");

		LocalFile.KoroneikiAccountAPI._assignTeamRolesToTeam(
			accountName = "Permis - ${staticProjectName}",
			table = '''| Partner |''',
			teamName = "Permission Partner");

		LocalFile.KoroneikiTeamAPI._assignContacts(
			table = '''| prm.koroneiki1@lrcustomer.com.broken |''',
			teamName = "Permission Partner");

		LocalFile.OSBAdmin.loginToProvisioning(
			userEmailAddress = "provisioning.account.worker@liferay.com.broken",
			userPassword = ${staticProvisioningQaUserPassword});

		LocalFile.UserAccount.updatePasswordUponLogin(userPassword = "test");

		LocalFile.Provisioning.gotoAccounts();

		LocalFile.Provisioning.searchAccounts(keyword = "Permis");

		LocalFile.Provisioning.clickAccount(accountName = "Permis - ${staticProjectName}");

		LocalFile.Provisioning.clickTab(tabName = "Teams");

		LocalFile.ProvisioningAccount.search(keyword = "Permission");

		LocalFile.ProvisioningAccount.clickTeamLink(teamName = "Permission Partner");

		LocalFile.ProvisioningTeam.clickDeleteButton();

		LocalFile.ProvisioningAccount.search(keyword = "Permission");

		LocalFile.ProvisioningAccount._viewNoAccountTeam(teamName = "Permission Partner");

		LocalFile.KoroneikiTeamAPI._viewNoTeam(teamName = "Permission Partner");

		LocalFile.KoroneikiAccountAPI._viewNoAccountTeam(
			accountName = "Permis - ${staticProjectName}",
			teamName = "Permission Partner");

		LocalFile.ProvisioningAccount.search(keyword = "Permis");

		LocalFile.ProvisioningAccount._viewAccountTeam(
			table = '''| Name   | Permis - ${staticProjectName} |
	| Member | PRM Koroneiki1                |''',
			teamName = "Permis - ${staticProjectName}");

		LocalFile.ProvisioningAccount.clickTeamLink(teamName = "Permis - ${staticProjectName}");

		LocalFile.ProvisioningTeam._viewTeamDetails(table = '''| Name | Permis - ${staticProjectName} |''');

		LocalFile.ProvisioningTeam.search(keyword = "prm.koroneiki1@lrcustomer.com.broken");

		LocalFile.ProvisioningTeam._viewTeamMember(
			memberEmailAddress = "prm.koroneiki1@lrcustomer.com.broken",
			table = '''| Name          | PRM Koroneiki1                       |
	| Email Address | prm.koroneiki1@lrcustomer.com.broken |
	| Status        | VERIFIED                             |''');

		LocalFile.Provisioning.gotoAccounts();

		LocalFile.Provisioning.searchAccounts(keyword = "Permis");

		LocalFile.Provisioning.clickAccount(accountName = "Permis - ${staticProjectName}");

		LocalFile.Provisioning.clickTab(tabName = "History");

		LocalFile.ProvisioningAccount.viewAccountHistoryEntryByKeyword(
			fieldName = "Contact",
			keyword = "Provisioning Account Worker > Updated Team",
			table = '''| Update Description          | Provisioning Account Worker > Updated Team > Permission Partner |
	| Update Field Name           | Contact                                                         |
	| Update Field Original Value | PRM Koroneiki1                                                  |
	| Update Field New Value      | N/A                                                             |''');

		LocalFile.ProvisioningAccount.viewAccountHistoryEntryByKeyword(
			fieldName = "Team Role",
			keyword = "Provisioning Account Worker > Unassigned Team",
			table = '''| Update Description          | Provisioning Account Worker > Unassigned Team > Permission Partner |
	| Update Field Name           | Team Role                                                          |
	| Update Field Original Value | Partner                                                            |
	| Update Field New Value      | N/A                                                                |''');

		LocalFile.ProvisioningAccount.viewAccountHistoryEntryByKeyword(
			fieldName = "name",
			keyword = "Provisioning Account Worker > Deleted Team",
			table = '''| Update Description          | Provisioning Account Worker > Deleted Team > Permission Partner |
	| Update Field Name           | name                                                            |
	| Update Field Original Value | Permission Partner                                              |
	| Update Field New Value      | N/A                                                             |''');
	}

	test Deleteteamviaindex {
		LocalFile.OSBAdminRabbitMQ.publishCreateProjectWithNoPartnerMessage(
			routingKey = "dossiera.provisioning.create",
			table = '''| Account Name                           | Misper - ${staticCompanyName}              |
	| Address City                           | Diamond Bar                                |
	| Address Country                        | United States                              |
	| Address Postal Code                    | 91765                                      |
	| Address Region                         | California                                 |
	| Address Street                         | 456 Fake Street                            |
	| Contact Email Address                  | prm.koroneiki1@lrcustomer.com.broken       |
	| Contact First Name                     | PRM                                        |
	| Contact Last Name                      | Koroneiki1                                 |
	| Dossiera Account Key                   | ${staticDossieraAccountKey}                |
	| Dossiera Address Key 1                 | ${staticDossieraAddressKey1}               |
	| Dossiera Address Key 2                 | ${staticDossieraAddressKey2}               |
	| Dossiera Contact Key                   | ${staticDossieraContactKey}                |
	| Dossiera Project Key                   | ${staticDossieraProjectKey}                |
	| End Day                                | ${staticEndDay}                            |
	| End Month                              | ${staticEndMonth}                          |
	| End Year                               | ${staticEndYear}                           |
	| Industry                               | Automotive                                 |
	| Owner Email Address                    | prm.koroneiki2@lrcustomer.com.broken       |
	| Owner First Name                       | PRM                                        |
	| Owner Last Name                        | Koroneiki2                                 |
	| Partner First Line Support             | false                                      |
	| Product Type                           | New                                        |
	| Product Name                           | Liferay Digital Enterprise - Prod Sizing 4 |
	| Project Name                           | Permis - ${staticProjectName}              |
	| Renewal                                | false                                      |
	| Salesforce Opportunity Key             | ${staticSalesforceOpportunityKey}          |
	| Salesforce Opportunity Line Item Key 1 | ${staticSalesforceOpportunityLineItemKey1} |
	| Salesforce Opportunity Line Item Key 2 | ${staticSalesforceOpportunityLineItemKey2} |
	| Salesforce Opportunity Sold By         | Liferay US                                 |
	| Salesforce Opportunity Stage Name      | Closed Won                                 |
	| Salesforce Opportunity Territory       | United States                              |
	| Salesforce Opportunity Type            | New Business                               |
	| Salesforce Owner User Key              | ${staticSalesforceOwnerUserKey}            |
	| Salesforce Project Key                 | ${staticSalesforceProjectKey}              |
	| Start Day                              | ${staticStartDay}                          |
	| Start Month                            | ${staticStartMonth}                        |
	| Start Year                             | ${staticStartYear}                         |
	| Subscription Level                     | Platinum                                   |
	| Version Number                         | 7.1                                        |''');

		LocalFile.KoroneikiAccountAPI._createAccountTeam(
			accountName = "Permis - ${staticProjectName}",
			teamName = "Permission Partner");

		LocalFile.KoroneikiAccountAPI._assignTeamRolesToTeam(
			accountName = "Permis - ${staticProjectName}",
			table = '''| Partner |''',
			teamName = "Permission Partner");

		LocalFile.KoroneikiTeamAPI._assignContacts(
