	test Viewheatscoreofreproducedsubstatusandurgentpriorityrequest {
		LocalFile.ZendeskUserAPI._createUser(table = '''| Name             | Zendesk User1                       |
	| Tags             | osb_customer,osb_kb,lxc_sm          |
	| Password         | ${staticZendeskAdminPassword}       |
	| Role             | End-user                            |
	| Access           | Organization                        |
	| Email            | zendesk.enduser1@zendesk.com.broken |
	| Phone Number     | +1 (555) 555-5555                   |
	| Organization     | Vodafone UK Customer Portal         |
	| Language         | Portuguese                          |
	| Time Zone        | Brasilia                            | 
	| External ID      | Enduser1                            |''');

		LocalFile.ZendeskUserAPI._assignUserToOrganization(
			organizationExternalId = 83313192,
			userEmailAddress = "zendesk.enduser1@zendesk.com.broken");

		LocalFile.ZendeskRequestAPI._createLXCSMRequest(
			requesterEmail = "zendesk.enduser1@zendesk.com.broken",
			table = '''| Product                  | prd_lxc_sm                     |
	| Component                | backup_recovery                |
