definition {

	property testray.main.component.name = "Support QA";
	property type = "koroneiki";

	tearDown {
		KoroneikiAccountAPI._tearDownAccounts(table = '''| Koroneiki Deletion |''');

		KoroneikiContactAPI._tearDownContacts(table = '''| koroneiki.deletion1@lrcustomer.com.broken |''');

		KoroneikiContactRoleAPI._tearDownContactRoles(table = '''| Default Team Deletion Role  |''');

		KoroneikiTeamAPI._tearDownTeams(table = '''| Deletion Team |''');
	}

	test Deleteteamandteamcontactandteamcontactroleafterteamcontactandcontactroleassignment {
		KoroneikiContactAPI._createContact(table = '''| Email Address | koroneiki.deletion1@lrcustomer.com.broken |
	| First Name    | Koroneiki                                 |
	| Language      | English                                   |
	| Last Name     | Deletion1                                 |
	| Middle Name   | User                                      |''');

		KoroneikiContactRoleAPI._createContactRole(table = '''| Description | This is the default deletion role for teams |
	| Name        | Default Team Deletion Role                  |
	| Type        | Team                                        |''');

		KoroneikiAccountAPI._createAccount(table = '''| Code         | KORDEL                             | |
	| Description  | Test deletion account on koroneiki | |
	| Fax Number   | 555-555-1234                       | |
	| Name         | Koroneiki Deletion                 | |
	| Phone Number | 555-555-5678                       | |
	| Region       | United States                      | |
	| Status       | Active                             | |
	| Tier         | T4                                 | |
	| Website      | www.koroneikideletion.com          | |''');

		KoroneikiAccountAPI._assignCustomerContacts(
			accountName = "Koroneiki Deletion",
			table = '''| koroneiki.deletion1@lrcustomer.com.broken |''');

		KoroneikiAccountAPI._createAccountTeam(
			accountName = "Koroneiki Deletion",
			teamName = "Deletion Team");

		KoroneikiTeamAPI._assignContacts(
			table = '''| koroneiki.deletion1@lrcustomer.com.broken |''',
			teamName = "Deletion Team");

		KoroneikiTeamAPI._assignContactRolesToContact(
			contactEmailAddress = "koroneiki.deletion1@lrcustomer.com.broken",
			table = '''| Default Team Deletion Role |''',
			teamName = "Deletion Team");

		KoroneikiTeamAPI._deleteTeam(teamName = "Deletion Team");

		KoroneikiContactRoleAPI._deleteContactRole(contactRoleName = "Default Team Deletion Role");

		KoroneikiContactAPI._deleteContactViaEmailAddress(contactEmailAddress = "koroneiki.deletion1@lrcustomer.com.broken");

		KoroneikiContactAPI._viewNoContact(contactEmailAddress = "koroneiki.deletion1@lrcustomer.com.broken");

		KoroneikiTeamAPI._viewNoTeam(teamName = "Deletion Team");

		KoroneikiContactRoleAPI._viewNoContactRole(contactRoleName = "Default Team Deletion Role");
	}

}