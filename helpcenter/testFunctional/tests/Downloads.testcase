		Downloads.viewResultsCurrentPageNumber(pageNumber = 1);

		Downloads.gotoDownload(downloadName = "Liferay DXP 7.2 Fix Pack 14");

		Downloads.viewDownload(
			downloadName = "Liferay DXP 7.2 Fix Pack 14",
			table = '''| Date         | Jul 26, 2021                          |
	| Name         | Liferay DXP 7.2 Fix Pack 14           |
