definition {

	property testray.main.component.name = "Support QA";
	property type = "customer.portal";

	setUp {
		Passwords.getPasswords();

		OSBAdmin.loginToSupport(
			userEmailAddress = ${staticSupportAdminEmailAdress},
			userPassword = ${staticSupportAdminPassword});

		Downloads.gotoDownloadsPage();
	}

	test ViewDownloadDetails {
		Downloads.setSearchFilters(
			fileType = "Fix Packs",
			productName = "DXP 7.1");

		Downloads.viewDownload(
			downloadName = "Liferay DXP 7.1 Fix Pack 7",
			table = '''| Date         | Feb 19, 2019	                                                                                                                                                                                                 |
	| Name         | Liferay DXP 7.1 Fix Pack 7                                                                                                                                                                                      |
	| Link         | Changelog                                                                                                                                                                                                       |
	| Link         | Important Changes                                                                                                                                                                                               |
	| Link         | Known Issues                                                                                                                                                                                                    |
	| Link         | Installation                                                                                                                                                                                                    |
	| Info Message | This fix pack provides solutions for SEV-3 security issues in LPE-16671, LPE-16664, LPE-16663, LPE-16660, LPE-16659, LPE-16653, LPE-16652, LPE-16649, LPE-16645, LPE-16641, LPE-16638, LPE-16628 and LPE-16596. |
	| Size         | File Size: 337 MB                                                                                                                                                                                               |
	| MD5          | MD5: 76366ACDCBCCC34AE334507097C52C98                                                                                                                                                                           |''');

		Downloads.gotoDownload(downloadName = "Liferay DXP 7.1 Fix Pack 7");

