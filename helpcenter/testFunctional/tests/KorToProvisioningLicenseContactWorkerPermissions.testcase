definition {

	property testray.main.component.name = "Support QA";
	property type = "provisioning.security";

	setUp {
		Passwords.getPasswords();

		JSONUser.createViaProvisioning(table = '''| Screen Name   | licensing.contact.worker                    |
	| Email Address | licensing.contact.worker@liferay.com.broken |
	| First Name    | Licensing                                   |
	| Last Name     | Contact Worker                              |''');

		JSONUser.assignUserToProvisioningRole(
			roleName = "Provisioning Contact Worker",
			userEmailAddress = "licensing.contact.worker@liferay.com.broken");
	}

	tearDown {
		ZendeskUserAPI._getDefaultUserId(organizationName = "Perlic - ${staticProjectName}");

		KoroneikiProductConsumptionAPI._tearDownProductConsumptionList(
			accountName = "Perlic - ${staticProjectName}",
			table = '''| DXP Production |''');

		OSBAdminProject.tearDownProjects(table = '''| PERLICPERLIC |''');

		KoroneikiAccountAPI._tearDownAccounts(table = '''| Perlic - ${staticProjectName} |''');

		KoroneikiAccountAPI._tearDownAccountsViaAccountFieldNameAndValue(
			fieldName = "Code",
			table = '''| PERLICPERLIC |''');

		ZendeskOrganizationAPI._getMultipleOrganizationExternalIdsByOrganizationNameIfStillPresent(table = '''| Perlic - ${staticProjectName} |''');

		ZendeskOrganizationAPI._tearDownOrganizationsByExternalIdList(organizationExternalIds = ${staticOrganizationExternalIdList});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId});

		JSONUser.tearDownUsersViaProvisioning(table = '''| licensing.contact.worker@liferay.com.broken |''');

		Downloads.teardownDownloadedListedFiles(list = ${staticDownloadedListName});
	}

	test DownloadDXPlicense {
		OSBAdminRabbitMQ.generateProvisioningProjectName();

		KoroneikiAccountAPI._createAccount(table = '''| Code                  | PERLICPERLIC                         | |
	| Contact Email Address | lic.koroneiki1@lrcustomer.com.broken | |
	| Description           | Test osb account on koroneiki        | |
	| Fax Number            | 555-555-1234                         | |
	| Name                  | Perlic - ${staticProjectName}        | |
	| Phone Number          | 555-555-5678                         | |
	| Profile Email Address | lic.koroneiki1@lrcustomer.com.broken | |
	| Region                | United States                        | |
	| Status                | Active                               | |
	| Tier                  | T4                                   | |
	| Website               | www.koroneikicorporation.com         | |''');

		KoroneikiAccountAPI._generateAccountKey(accountName = "Perlic - ${staticProjectName}");

		KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		KoroneikiProductPurchaseAPI.generateStaticFullStartAndEndDate();

		KoroneikiProductPurchaseAPI.generateStaticFutureStartAndEndDate();

		KoroneikiProductPurchaseAPI.generateStaticFullFutureStartAndEndDate();

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Perlic - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| End Date                | ${staticEndDate}         |   |
	| Original End Date       | ${staticOriginalEndDate} |   |
	| Perpetual               | false                    |   |
	| Product Field and Value | sizing                   | 1 |
	| Product Field and Value | licenses                 | 1 |
	| Product Field and Value | version                  | 7 |
	| Quantity                | 3                        |   |
	| Start Date              | ${staticStartDate}       |   |
	| Status                  | Approved                 |   |''');

		KoroneikiProductPurchaseAPI._generateProductPurchaseId(
			accountName = "Perlic - ${staticProjectName}",
			productName = "DXP Production");

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Perlic - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		Provisioning.gotoLicenses();

		Provisioning.clickGenerateLicenseButton();

		ProvisioningLicense.populateGenerateLicenseForm(table = '''| Account | Select Entity | Perlic - ${staticProjectName} | |
	| Product | Select        | DXP Production                | |
	| Version | Select        | 7.2                           | |
	| Type    | Select        | DXP Production                | |''');

		ProvisioningLicense.clickChooseProductPurchaseButton(positionValue = 1);

		ProvisioningLicense.populateGenerateLicenseForm(table = '''| Host Name     | Input    | localhost         | |
	| IP Addresses  | Textarea | 123.45.67.89      | |
	| MAC Addresses | Textarea | 0A-1B-2C-3D-4E-5F | |''');

		ProvisioningLicense.clickGenerateLicenseButton();

		ProvisioningLicense.viewLicense(table = '''| Header  | Perlic - ${staticProjectName} | |
	| Product | DXP Production                | |''');

		OSBAdmin.logoutAndLoginToProvisioning(
			userEmailAddress = "licensing.contact.worker@liferay.com.broken",
			userPassword = ${staticProvisioningQaUserPassword});

		UserAccount.updatePasswordUponLogin(userPassword = "test");

		Provisioning.gotoLicenses();

		Provisioning.searchLicenses(keyword = ${staticAccountKey});

		Provisioning.clickLicense(licenseKeyword = "Perlic - ${staticProjectName}");

		ProvisioningLicense.downloadLicense(positionValue = 1);

		ProvisioningLicense.assertDownloadedLicensePresent(
			fileType = "xml",
			table = '''| License Type | activation-key                |
	| Product      | DXP Production                |
	| Version      | 7.2                           |
	| License Name | Perlic - ${staticProjectName} |''');
	}

	test DownloadDXPsinglelicenseaggregate {
		OSBAdminRabbitMQ.generateProvisioningProjectName();

		KoroneikiAccountAPI._createAccount(table = '''| Code                  | PERLICPERLIC                         | |
	| Contact Email Address | lic.koroneiki1@lrcustomer.com.broken | |
	| Description           | Test osb account on koroneiki        | |
	| Fax Number            | 555-555-1234                         | |
	| Name                  | Perlic - ${staticProjectName}        | |
	| Phone Number          | 555-555-5678                         | |
	| Profile Email Address | lic.koroneiki1@lrcustomer.com.broken | |
	| Region                | United States                        | |
	| Status                | Active                               | |
	| Tier                  | T4                                   | |
	| Website               | www.koroneikicorporation.com         | |''');

		KoroneikiAccountAPI._generateAccountKey(accountName = "Perlic - ${staticProjectName}");

		KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		KoroneikiProductPurchaseAPI.generateStaticFullStartAndEndDate();

		KoroneikiProductPurchaseAPI.generateStaticFutureStartAndEndDate();

		KoroneikiProductPurchaseAPI.generateStaticFullFutureStartAndEndDate();

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Perlic - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| End Date                | ${staticEndDate}         |   |
	| Original End Date       | ${staticOriginalEndDate} |   |
	| Perpetual               | false                    |   |
	| Product Field and Value | sizing                   | 1 |
	| Product Field and Value | licenses                 | 1 |
	| Product Field and Value | version                  | 7 |
	| Quantity                | 1                        |   |
	| Start Date              | ${staticStartDate}       |   |
	| Status                  | Approved                 |   |''');

		KoroneikiProductPurchaseAPI._generateProductPurchaseId(
			accountName = "Perlic - ${staticProjectName}",
			productName = "DXP Production");

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Perlic - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		Provisioning.gotoLicenses();

		Provisioning.clickGenerateLicenseButton();

		ProvisioningLicense.populateGenerateLicenseForm(table = '''| Account | Select Entity | Perlic - ${staticProjectName} | |
	| Product | Select        | DXP Production                | |
	| Version | Select        | 7.2                           | |
	| Type    | Select        | DXP Production                | |''');

		ProvisioningLicense.clickChooseProductPurchaseButton(positionValue = 1);

		ProvisioningLicense.populateGenerateLicenseForm(table = '''| Host Name     | Input    | localhost         | |
	| IP Addresses  | Textarea | 123.45.67.89      | |
	| MAC Addresses | Textarea | 0A-1B-2C-3D-4E-5F | |''');

		ProvisioningLicense.clickGenerateLicenseButton();

		ProvisioningLicense.viewLicense(table = '''| Header  | Perlic - ${staticProjectName} | |
	| Product | DXP Production                | |''');

		ProvisioningLicense.getLicenseKeyIdViaLicenseDetails();

		OSBAdmin.logoutAndLoginToProvisioning(
			userEmailAddress = "licensing.contact.worker@liferay.com.broken",
			userPassword = ${staticProvisioningQaUserPassword});

		UserAccount.updatePasswordUponLogin(userPassword = "test");

		Provisioning.gotoAccounts();

		Provisioning.searchAccounts(keyword = "Perlic");

		Provisioning.clickAccount(accountName = "Perlic - ${staticProjectName}");

		Provisioning.clickTab(tabName = "Licenses");

		ProvisioningAccount.selectLicensesViaLicensesTab(table = '''| Perlic - ${staticProjectName} |''');

		ProvisioningAccount.clickLicensesActionDropdownButton(action = "Download");

		ProvisioningLicense.downloadLicenseViaDownloadLicensePage(table = '''| ${staticLicenseKeyId} |''');

		ProvisioningLicense.assertDownloadedLicensePresent(
			fileType = "xml",
			table = '''| License Type | activation-key                |
	| Product      | DXP Production                |
	| Version      | 7.2                           |
	| License Name | Perlic - ${staticProjectName} |''');
	}

	test DownloadnewDXPaggregatelicense {
		OSBAdminRabbitMQ.generateProvisioningProjectName();

		KoroneikiAccountAPI._createAccount(table = '''| Code                  | PERLICPERLIC                         | |
	| Contact Email Address | lic.koroneiki1@lrcustomer.com.broken | |
	| Description           | Test osb account on koroneiki        | |
	| Fax Number            | 555-555-1234                         | |
	| Name                  | Perlic - ${staticProjectName}        | |	
	| Phone Number          | 555-555-5678                         | |
	| Profile Email Address | lic.koroneiki1@lrcustomer.com.broken | |
	| Region                | United States                        | |
	| Status                | Active                               | |
	| Tier                  | T4                                   | |
	| Website               | www.koroneikicorporation.com         | |''');

		KoroneikiAccountAPI._generateAccountKey(accountName = "Perlic - ${staticProjectName}");

		KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		KoroneikiProductPurchaseAPI.generateStaticFullStartAndEndDate();

		KoroneikiProductPurchaseAPI.generateStaticFutureStartAndEndDate();

		KoroneikiProductPurchaseAPI.generateStaticFullFutureStartAndEndDate();

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Perlic - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| End Date                | ${staticEndDate}         |   |
	| Original End Date       | ${staticOriginalEndDate} |   |
	| Perpetual               | false                    |   |
	| Product Field and Value | sizing                   | 2 |
	| Product Field and Value | licenses                 | 2 |
	| Product Field and Value | version                  | 7 |
	| Quantity                | 2                        |   |
	| Start Date              | ${staticStartDate}       |   |
	| Status                  | Approved                 |   |''');

		KoroneikiProductPurchaseAPI._generateProductPurchaseId(
			accountName = "Perlic - ${staticProjectName}",
			productName = "DXP Production");

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Perlic - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		Provisioning.gotoLicenses();

		Provisioning.clickGenerateLicenseButton();

		ProvisioningLicense.populateGenerateLicenseForm(table = '''| Account | Select Entity | Perlic - ${staticProjectName} | |
	| Product | Select        | DXP Production                | |
	| Version | Select        | 7.2                           | |
	| Type    | Select        | DXP Production                | |''');

		ProvisioningLicense.clickChooseProductPurchaseButton(positionValue = 1);

		ProvisioningLicense.populateGenerateLicenseForm(table = '''| Name          | Input    | License1Name        | |
	| Description   | Input    | Perlic - ${staticProjectName} License1 Description | |
	| Host Name     | Input    | localhost                                          | |
	| IP Addresses  | Textarea | 123.45.67.89                                       | |
	| MAC Addresses | Textarea | 0A-1B-2C-3D-4E-5F                                  | |''');

		ProvisioningLicense.clickGenerateLicenseButton();

		ProvisioningLicense.viewLicense(table = '''| Header  | Perlic - ${staticProjectName} | |
	| Product | DXP Production                | |''');

		ProvisioningLicense.getLicenseKeyIdViaLicenseDetails();

		ProvisioningLicense._renameFirstLicenseKeyIdVariable();

		Provisioning.gotoLicenses();

		Provisioning.searchLicenses(keyword = ${staticAccountKey});

		Provisioning.clickGenerateLicenseButton();

		ProvisioningLicense.populateGenerateLicenseForm(table = '''| Account | Select Entity | Perlic - ${staticProjectName} | |
	| Product | Select        | DXP Production                | |
	| Version | Select        | 7.2                           | |
	| Type    | Select        | DXP Production                | |''');

		ProvisioningLicense.clickChooseProductPurchaseButton(positionValue = 1);

		ProvisioningLicense.populateGenerateLicenseForm(table = '''| Name          | Input    | License2Name        | |
	| Description   | Input    | Perlic - ${staticProjectName} License2 Description | |
	| Host Name     | Input    | localhost                                          | |
	| IP Addresses  | Textarea | 123.45.67.89                                       | |
	| MAC Addresses | Textarea | 0A-1B-2C-3D-4E-5F                                  | |''');

		ProvisioningLicense.clickGenerateLicenseButton();

		ProvisioningLicense.viewLicense(table = '''| Header  | Perlic - ${staticProjectName} | |
	| Product | DXP Production                | |''');

		ProvisioningLicense.getLicenseKeyIdViaLicenseDetails();

		ProvisioningLicense._renameSecondLicenseKeyIdVariable();

		OSBAdmin.logoutAndLoginToProvisioning(
			userEmailAddress = "licensing.contact.worker@liferay.com.broken",
			userPassword = ${staticProvisioningQaUserPassword});

		UserAccount.updatePasswordUponLogin(userPassword = "test");

		Provisioning.gotoAccounts();

		Provisioning.searchAccounts(keyword = "Perlic");

		Provisioning.clickAccount(accountName = "Perlic - ${staticProjectName}");

		Provisioning.clickTab(tabName = "Licenses");

		ProvisioningAccount.selectLicensesViaLicensesTab(table = '''| License1Name |
	| License2Name |''');

		ProvisioningAccount.clickLicensesActionDropdownButton(action = "Download");

		ProvisioningLicense.downloadLicenseViaDownloadLicensePage(table = '''| ${staticLicenseKeyId2} |
	| ${staticLicenseKeyId1} |''');

		ProvisioningLicense.assertDownloadedLicensePresent(
			fileType = "xml",
			table = '''| License Type | activation-key                              |
	| Product      | DXP Production                              |
	| Version      | 7.2                                         |
	| License Name | License2Name |''');
	}

	test GeneratenewDXPaggregatelicense {
		OSBAdminRabbitMQ.generateProvisioningProjectName();

		KoroneikiAccountAPI._createAccount(table = '''| Code                  | PERLICPERLIC                         | |
	| Contact Email Address | lic.koroneiki1@lrcustomer.com.broken | |
	| Description           | Test osb account on koroneiki        | |
	| Fax Number            | 555-555-1234                         | |
	| Name                  | Perlic - ${staticProjectName}        | |
	| Phone Number          | 555-555-5678                         | |
	| Profile Email Address | lic.koroneiki1@lrcustomer.com.broken | |
	| Region                | United States                        | |
	| Status                | Active                               | |
	| Tier                  | T4                                   | |
	| Website               | www.koroneikicorporation.com         | |''');

		KoroneikiAccountAPI._generateAccountKey(accountName = "Perlic - ${staticProjectName}");

		KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		KoroneikiProductPurchaseAPI.generateStaticFullStartAndEndDate();

		KoroneikiProductPurchaseAPI.generateStaticFutureStartAndEndDate();

		KoroneikiProductPurchaseAPI.generateStaticFullFutureStartAndEndDate();

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Perlic - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| End Date                | ${staticEndDate}         |   |
	| Original End Date       | ${staticOriginalEndDate} |   |
	| Perpetual               | false                    |   |
	| Product Field and Value | sizing                   | 2 |
	| Product Field and Value | licenses                 | 2 |
	| Product Field and Value | version                  | 7 |
	| Quantity                | 2                        |   |
	| Start Date              | ${staticStartDate}       |   |
	| Status                  | Approved                 |   |''');

		KoroneikiProductPurchaseAPI._generateProductPurchaseId(
