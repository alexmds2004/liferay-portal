definition {

	property testray.main.component.name = "Support QA";
	property type = "zendesk.integration";

	setUp {
		OSBAdminRabbitMQ.generateProvisioningProjectName();

		JSONOkta.createOktaUser(table = '''| Screen Name   | zen.phonenumber1                       |
	| Email Address | zen.phonenumber1@lrcustomer.com.broken |
	| First Name    | ZEN                                    |
	| Last Name     | Phonenumber1                           |''');

		KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		KoroneikiAccountAPI._createAccount(table = '''| Code   | PHONEZPHONEZ                  | |
	| Name   | Phonez - ${staticProjectName} | |
	| Region | United States                 | |
	| Status | Active                        | |
	| Tier   | T1                            | |''');

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Phonez - ${staticProjectName}",
			contactEmailAddress = "zen.phonenumber1@lrcustomer.com.broken",
			table = '''| Support Requester |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Phonez - ${staticProjectName}",
			productName = "Portal Production",
			table = '''| End Date                | ${staticEndDate}         |   |
	| Original End Date       | ${staticOriginalEndDate} |   |
	| Perpetual               | false                    |   |
	| Product Field and Value | sizing                   | 1 |
	| Product Field and Value | licenses                 | 1 |
	| Product Field and Value | version                  | 6 |
	| Quantity                | 1                        |   |
	| Start Date              | ${staticStartDate}       |   |
	| Status                  | Approved                 |   |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Phonez - ${staticProjectName}",
			productName = "Gold Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Gold Subscription");

		JSONOSBAccount.viewSupportOrganizationSync(accountCode = "PHONEZPHONEZ");

		ZendeskOrganizationAPI._viewOrganizationSyncFromOsb(organizationName = "Phonez - ${staticProjectName}");

		ZendeskUserAPI._viewUserSyncFromOsb(userEmailAddress = "zen.phonenumber1@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserSyncFromOsbViaSearchByExternalIdApi(userEmailAddress = "zen.phonenumber1@lrcustomer.com.broken");
	}

	tearDown {
		JSONOkta.updateOktaUser(
			table = '''| Primary Number | |
	| Mobile Number  | |''',
			userOriginalEmailAddress = "zen.phonenumber1@lrcustomer.com.broken");

		ZendeskHomepage.pause(timeInSeconds = 30);

		ZendeskUserAPI._getDefaultUserId(organizationName = "Phonez - ${staticProjectName}");

		OSBAdminProject.tearDownProjects(table = '''| PHONEZPHONEZ |''');

		KoroneikiAccountAPI._tearDownAccounts(table = '''| Phonez - ${staticProjectName} |''');

		KoroneikiAccountAPI._tearDownAccountsViaAccountFieldNameAndValue(
			fieldName = "Code",
			table = '''| PHONEZPHONEZ |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Gold Subscription");

		JSONOkta.tearDownUsersByScreenName(table = '''| zen.phonenumber1 |''');

		JSONUser.tearDownUsers(table = '''| zen.phonenumber1@lrcustomer.com.broken |''');

		JSONUser.tearDownUsersViaSupport(table = '''| zen.phonenumber1@lrcustomer.com.broken |''');

		JSONUser.tearDownUsersViaKoroneiki(table = '''| zen.phonenumber1@lrcustomer.com.broken |''');

		JSONUser.tearDownUsersByScreenNameViaKoroneiki(table = '''| zen.phonenumber1 |''');

		KoroneikiContactAPI._tearDownContacts(table = '''| zen.phonenumber1@lrcustomer.com.broken |''');

		JSONOkta.tearDownUsers(table = '''| zen.phonenumber1@lrcustomer.com.broken |''');

		ZendeskUserAPI._getMultipleUserIdsByEmailAddress(table = '''| zen.phonenumber1@lrcustomer.com.broken |''');

		ZendeskUserAPI._tearDownUsersByIdList(userIds = ${staticUserIdList});

		ZendeskOrganizationAPI._getMultipleOrganizationExternalIdsByOrganizationNameIfStillPresent(table = '''| Phonez - ${staticProjectName} |''');

		ZendeskOrganizationAPI._tearDownOrganizationsByExternalIdList(organizationExternalIds = ${staticOrganizationExternalIdList});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId});
	}

	test Viewusermultiplephonenumberupdate {
		JSONOkta.updateOktaUser(
			table = '''| Primary Number | +15558402834 |
	| Mobile Number  | +15554394671 |''',
			userOriginalEmailAddress = "zen.phonenumber1@lrcustomer.com.broken");

		ZendeskHomepage.pause(timeInSeconds = 30);

		ZendeskUserAPI._viewUserPhoneNumberByEmailAddress(
			userEmailAddress = "zen.phonenumber1@lrcustomer.com.broken",
			userPhoneNumber = "+15558402834");

		JSONOkta.updateOktaUser(
			table = '''| Primary Number |              |
	| Mobile Number  | +15554394671 |''',
			userOriginalEmailAddress = "zen.phonenumber1@lrcustomer.com.broken");

		ZendeskHomepage.pause(timeInSeconds = 30);

		ZendeskUserAPI._viewUserPhoneNumberByEmailAddress(
			userEmailAddress = "zen.phonenumber1@lrcustomer.com.broken",
			userPhoneNumber = "+15554394671");

		JSONOkta.updateOktaUser(
			table = '''| Primary Number | +15558402834 |
	| Mobile Number  | +15554394671 |''',
			userOriginalEmailAddress = "zen.phonenumber1@lrcustomer.com.broken");

		ZendeskHomepage.pause(timeInSeconds = 30);

		ZendeskUserAPI._viewUserPhoneNumberByEmailAddress(
			userEmailAddress = "zen.phonenumber1@lrcustomer.com.broken",
			userPhoneNumber = "+15554394671");

		JSONOkta.updateOktaUser(
			table = '''| Primary Number | +15558402834 |
	| Mobile Number  |              |''',
			userOriginalEmailAddress = "zen.phonenumber1@lrcustomer.com.broken");

		ZendeskHomepage.pause(timeInSeconds = 30);

		ZendeskUserAPI._viewUserPhoneNumberByEmailAddress(
			userEmailAddress = "zen.phonenumber1@lrcustomer.com.broken",
			userPhoneNumber = "+15558402834");

		JSONOkta.updateOktaUser(
			table = '''| Primary Number | +15558402834 |
	| Mobile Number  | +15554394671 |''',
			userOriginalEmailAddress = "zen.phonenumber1@lrcustomer.com.broken");

		ZendeskHomepage.pause(timeInSeconds = 30);

		ZendeskUserAPI._viewUserPhoneNumberByEmailAddress(
			userEmailAddress = "zen.phonenumber1@lrcustomer.com.broken",
			userPhoneNumber = "+15558402834");

		JSONOkta.updateOktaUser(
			table = '''| Primary Number | |
	| Mobile Number  | |''',
			userOriginalEmailAddress = "zen.phonenumber1@lrcustomer.com.broken");

		ZendeskHomepage.pause(timeInSeconds = 30);

		ZendeskUserAPI._viewNoUserPhoneNumberByEmailAddress(
			userEmailAddress = "zen.phonenumber1@lrcustomer.com.broken",
			userPhoneNumber = "+15558402834");

		ZendeskUserAPI._viewNoUserPhoneNumberByEmailAddress(
			userEmailAddress = "zen.phonenumber1@lrcustomer.com.broken",
			userPhoneNumber = "+15554394671");
	}

}