definition {

	property testray.main.component.name = "Support QA";
	property type = "customer.integration";

	setUp {
		Passwords.getPasswords();

		KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		KoroneikiProductPurchaseAPI.generateStaticPastStartAndEndDate();

		KoroneikiProductPurchaseAPI.generateStaticFutureStartAndEndDate();

		OSBAdminRabbitMQ.generateProvisioningCompanyName();

		OSBAdminRabbitMQ.generateProvisioningProjectName();

		JSONOkta.createOktaUser(table = '''| Screen Name   | cstm.customer1                       |
	| Email Address | cstm.customer1@lrcustomer.com.broken |
	| First Name    | CSTM                                 |
	| Last Name     | Customer1                            |''');

		JSONOkta.createOktaUser(table = '''| Screen Name   | cstm.customer2                       |
	| Email Address | cstm.customer2@lrcustomer.com.broken |
	| First Name    | CSTM                                 |
	| Last Name     | Customer2                            |''');

		KoroneikiAccountAPI._createAccount(table = '''| Code   | KORCSTKORCST                  | |
	| Name   | Korcst - ${staticProjectName} | |
	| Region | United States                 | |
	| Status | Active                        | |
	| Tier   | T1                            | |''');
	}

	tearDown {
		KoroneikiTeamAPI._tearDownTeams(table = '''| CSTM Customer |''');

		OSBAdminProject.tearDownProjects(table = '''| KORCSTKORCST |
	| KORCT2KORCT2 |''');

		KoroneikiAccountAPI._tearDownAccounts(table = '''| Korcst - ${staticProjectName} |''');

		KoroneikiAccountAPI._tearDownAccountsViaAccountFieldNameAndValue(
			fieldName = "Code",
			table = '''| KORCSTKORCST |
	| KORCT2KORCT2 |''');

		JSONUser.tearDownUsersViaSupport(table = '''| cstm.customer1@lrcustomer.com.broken |
	| cstm.customer2@lrcustomer.com.broken |''');

		JSONUser.tearDownUsersViaKoroneiki(table = '''| cstm.customer1@lrcustomer.com.broken |
	| cstm.customer2@lrcustomer.com.broken |''');

		KoroneikiContactAPI._tearDownContacts(table = '''| cstm.customer1@lrcustomer.com.broken |
	| cstm.customer2@lrcustomer.com.broken |''');

		JSONOkta.tearDownUsers(table = '''| cstm.customer1@lrcustomer.com.broken |
	| cstm.customer2@lrcustomer.com.broken |''');

		CustomerContactApi.tearDownUsersOnCustomer(
			accountName = "Korcst - ${staticProjectName}",
			table = '''
				| cstm.customer1@lrcustomer.com.broken |
				| cstm.customer2@lrcustomer.com.broken |
			'''
		);

		CustomerSubscriptionApi.tearDownSubscriptionsOnCustomer(
			accountName = "Korcst - ${staticProjectName}",
			table = '''
				| DXP Production      |
				| Service Partnership |
			'''
		);

		CustomerAccountApi.tearDownCustomerAccounts(
			table = '''
				| Korcst - ${staticProjectName} |
			'''
		);

		
	}

	test ViewLiferayemployee {
		Data.generateSupportUser();

		JSONOkta.createOktaUser(table = '''| Screen Name   | ${staticScreenNameValue}       |
	| Email Address | ${staticEmailValue}            |
	| First Name    | ${staticContactFirstNameValue} |
	| Last Name     | ${staticContactLastNameValue}  |
	| Group         | Employees                       |''');

		KoroneikiContactAPI._viewContactSyncViaEmailAddress(contactEmailAddress = ${staticEmailValue});

		KoroneikiContactAPI._viewAccountSyncViaUuid(
			accountName = "Liferay, Inc.",
			contactEmailAddress = ${staticEmailValue});

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - DXP");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - Portal");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - Commerce");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Liferay Employee");

		JSONUser.viewSupportUserSync(userEmailAddress = ${staticEmailValue});

		JSONUser.viewSupportUserOrganizationSync(
			organizationName = "Employees",
			userEmailAddress = ${staticEmailValue});

		JSONUser.viewSupportUserOrganizationSync(
			organizationName = "Koroneiki Customer",
			userEmailAddress = ${staticEmailValue});

		JSONUser.viewSupportUserOrganizationSync(
			organizationName = "Koroneiki Customer - DXP",
			userEmailAddress = ${staticEmailValue});

		JSONUser.viewSupportUserOrganizationSync(
			organizationName = "Koroneiki Customer - Portal",
			userEmailAddress = ${staticEmailValue});

		JSONUser.viewSupportUserOrganizationSync(
			organizationName = "Koroneiki Customer - Commerce",
			userEmailAddress = ${staticEmailValue});

		CustomerLogin.loginToCustomer(
			userEmailAddress = ${staticCustomerAdminEmailAddress},
			userPassword = ${staticCustomerAdminPassword});
	}

}