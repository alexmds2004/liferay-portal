		ProvisioningProductBundle.populateProductBundleFormAndSave(table = '''| Name        | Input | Bundled Subscri Products         |
	| Add Product |       | A Bundled Subscri Product        |
	| Add Product |       | A Bundled Subscri Second Product |''');

		Provisioning._viewProductBundleViaIndex(
			productBundleName = "Bundled Subscri Products",
