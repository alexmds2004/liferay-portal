definition {

	property testray.main.component.name = "Support QA";
	property type = "osb.integration";

	setUp {
		Passwords.getPasswords();
	}

	tearDown {
		KoroneikiProductAPI._tearDownProducts(table = '''| A Liferay OSB Product    |
	| A Liferay Server Product |''');

		OSBAdminSales.tearDownProducts(table = '''| A Liferay OSB Product    |
	| A Liferay Server Product |''');
	}

	test Addbackdeletedproduct {
		KoroneikiProductAPI._createProduct(table = '''| Name | A Liferay OSB Product | |''');

		OSBAdmin.loginToSupport(
			userEmailAddress = ${staticSupportAdminEmailAdress},
			userPassword = ${staticSupportAdminPassword});

		OSBAdmin.gotoOSBAdmin();

		OSBAdminSales.updateProduct(
			productName = "A Liferay OSB Product",
			table = '''| Koroneiki Product Key | KOR-123 |''');

		OSBAdminSales.deleteProduct(productName = "A Liferay OSB Product");

		OSBAdminSales.addProduct(table = '''| Name | A Liferay OSB Product |''');

		OSBAdminSales.viewProduct(
			productName = "A Liferay OSB Product",
			table = '''| Name                  | A Liferay OSB Product |
	| Koroneiki Product Key | Verify from name      |''');
	}

	test Addbackdeletedupdatedproduct {
		KoroneikiProductAPI._createProduct(table = '''| Name | A Liferay OSB Product | |''');

		KoroneikiProductAPI.updateProduct(
			productName = "A Liferay OSB Product",
			table = '''| Name | A Liferay Server Product | |''');

		OSBAdmin.loginToSupport(
			userEmailAddress = ${staticSupportAdminEmailAdress},
			userPassword = ${staticSupportAdminPassword});

		OSBAdmin.gotoOSBAdmin();

		OSBAdminSales.updateProduct(
			productName = "A Liferay Server Product",
			table = '''| Koroneiki Product Key | KOR-123 |''');

		OSBAdminSales.deleteProduct(productName = "A Liferay Server Product");

		OSBAdminSales.addProduct(table = '''| Name | A Liferay Server Product |''');

		OSBAdminSales.viewProduct(
			productName = "A Liferay Server Product",
			table = '''| Name                  | A Liferay Server Product |
	| Koroneiki Product Key | Verify from name         |''');
	}

	test Attempttodeleteaddedbackproduct {
		KoroneikiProductAPI._createProduct(table = '''| Name | A Liferay OSB Product | |''');

		OSBAdmin.loginToSupport(
			userEmailAddress = ${staticSupportAdminEmailAdress},
			userPassword = ${staticSupportAdminPassword});

		OSBAdmin.gotoOSBAdmin();

		OSBAdminSales.updateProduct(
			productName = "A Liferay OSB Product",
			table = '''| Koroneiki Product Key | KOR-123 |''');

		OSBAdminSales.deleteProduct(productName = "A Liferay OSB Product");

		OSBAdminSales.addProduct(table = '''| Name | A Liferay OSB Product |''');

		OSBAdminSales.deleteProductLinkedToKoroneikiAttempt(productName = "A Liferay OSB Product");

		OSBAdminSales.viewProduct(
			productName = "A Liferay OSB Product",
			table = '''| Name                  | A Liferay OSB Product |
	| Koroneiki Product Key | Verify from name      |''');
	}

	test Attempttodeletelinkedproduct {
		KoroneikiProductAPI._createProduct(table = '''| Name | A Liferay OSB Product | |''');

		OSBAdmin.loginToSupport(
			userEmailAddress = ${staticSupportAdminEmailAdress},
			userPassword = ${staticSupportAdminPassword});

		OSBAdmin.gotoOSBAdmin();

		OSBAdminSales.deleteProductLinkedToKoroneikiAttempt(productName = "A Liferay OSB Product");

		OSBAdminSales.viewProduct(
			productName = "A Liferay OSB Product",
			table = '''| Name                  | A Liferay OSB Product |
	| Koroneiki Product Key | Verify from name      |''');
	}

	test AttempttodeletelinkedproductupdatedviaKoroneiki {
		KoroneikiProductAPI._createProduct(table = '''| Name | A Liferay OSB Product | |''');

		KoroneikiProductAPI.updateProduct(
			productName = "A Liferay OSB Product",
			table = '''| Name | A Liferay Server Product | |''');

		OSBAdmin.loginToSupport(
			userEmailAddress = ${staticSupportAdminEmailAdress},
			userPassword = ${staticSupportAdminPassword});

		OSBAdmin.gotoOSBAdmin();

		OSBAdminSales.deleteProductLinkedToKoroneikiAttempt(productName = "A Liferay Server Product");

		OSBAdminSales.viewProduct(
			productName = "A Liferay Server Product",
			table = '''| Name                  | A Liferay Server Product |
	| Koroneiki Product Key | Verify from name         |''');

		OSBAdminSales.viewNoProduct(productName = "A Liferay OSB Product");
	}

	test Attempttodeletelinkedproductwithexternallink {
		KoroneikiProductAPI._createProduct(table = '''| Name | A Liferay OSB Product | |''');

		KoroneikiProductAPI._createProductExternalLink(
			productName = "A Liferay OSB Product",
			table = '''| Domain      | liferayosb |
	| Entity Id   | 1234       |
	| Entity Name | LiferayOSB |''');

		OSBAdmin.loginToSupport(
			userEmailAddress = ${staticSupportAdminEmailAdress},
			userPassword = ${staticSupportAdminPassword});

		OSBAdmin.gotoOSBAdmin();

		OSBAdminSales.deleteProductLinkedToKoroneikiAttempt(productName = "A Liferay OSB Product");

		OSBAdminSales.viewProduct(
			productName = "A Liferay OSB Product",
			table = '''| Name                      | A Liferay OSB Product |
	| Koroneiki Product Key     | Verify from name      |
	| External Link Domain      | liferayosb            |
	| External Link Entity Id   | 1234                  |
	| External Link Entity Name | LiferayOSB            |''');
	}

	test Attempttodeleteupdatedandaddedbackproduct {
		KoroneikiProductAPI._createProduct(table = '''| Name | A Liferay OSB Product | |''');

		KoroneikiProductAPI.updateProduct(
			productName = "A Liferay OSB Product",
			table = '''| Name | A Liferay Server Product | |''');

		OSBAdmin.loginToSupport(
			userEmailAddress = ${staticSupportAdminEmailAdress},
			userPassword = ${staticSupportAdminPassword});

		OSBAdmin.gotoOSBAdmin();

		OSBAdminSales.updateProduct(
			productName = "A Liferay Server Product",
			table = '''| Koroneiki Product Key | KOR-123 |''');

		OSBAdminSales.deleteProduct(productName = "A Liferay Server Product");

		OSBAdminSales.addProduct(table = '''| Name | A Liferay Server Product |''');

		OSBAdminSales.deleteProductLinkedToKoroneikiAttempt(productName = "A Liferay Server Product");

		OSBAdminSales.viewProduct(
			productName = "A Liferay Server Product",
			table = '''| Name                  | A Liferay Server Product |
	| Koroneiki Product Key | Verify from name         |''');
	}

	test Updateanddeleteproduct {
		property help.center.acceptance = "true";

		KoroneikiProductAPI._createProduct(table = '''| Name | A Liferay OSB Product | |''');

		OSBAdmin.loginToSupport(
			userEmailAddress = ${staticSupportAdminEmailAdress},
			userPassword = ${staticSupportAdminPassword});

		OSBAdmin.gotoOSBAdmin();

		OSBAdminSales.updateProduct(
			productName = "A Liferay OSB Product",
			table = '''| Koroneiki Product Key | KOR-123 |''');

		OSBAdminSales.deleteProduct(productName = "A Liferay OSB Product");

		OSBAdminSales.viewNoProduct(productName = "A Liferay OSB Product");
	}

	test UpdateanddeleteproductupdatedviaKoroneiki {
		KoroneikiProductAPI._createProduct(table = '''| Name | A Liferay OSB Product | |''');

		KoroneikiProductAPI.updateProduct(
			productName = "A Liferay OSB Product",
			table = '''| Name | A Liferay Server Product | |''');

		OSBAdmin.loginToSupport(
			userEmailAddress = ${staticSupportAdminEmailAdress},
			userPassword = ${staticSupportAdminPassword});

		OSBAdmin.gotoOSBAdmin();

		OSBAdminSales.updateProduct(
			productName = "A Liferay Server Product",
			table = '''| Koroneiki Product Key | KOR-123 |''');

		OSBAdminSales.deleteProduct(productName = "A Liferay Server Product");

		OSBAdminSales.viewNoProduct(productName = "A Liferay Server Product");

		OSBAdminSales.viewNoProduct(productName = "A Liferay OSB Product");
	}

	test Updateanddeleteproductwithexternallink {
		KoroneikiProductAPI._createProduct(table = '''| Name | A Liferay OSB Product | |''');

		KoroneikiProductAPI._createProductExternalLink(
			productName = "A Liferay OSB Product",
			table = '''| Domain      | liferayosb |
	| Entity Id   | 1234       |
	| Entity Name | LiferayOSB |''');

		OSBAdmin.loginToSupport(
			userEmailAddress = ${staticSupportAdminEmailAdress},
			userPassword = ${staticSupportAdminPassword});

		OSBAdmin.gotoOSBAdmin();

		OSBAdminSales.updateProduct(
			productName = "A Liferay OSB Product",
			table = '''| Koroneiki Product Key | KOR-123 |''');

		OSBAdminSales.deleteProduct(productName = "A Liferay OSB Product");

		OSBAdminSales.viewNoProduct(productName = "A Liferay OSB Product");
	}

}