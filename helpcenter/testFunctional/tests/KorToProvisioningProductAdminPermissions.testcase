definition {

	property testray.main.component.name = "Support QA";
	property type = "provisioning.security";

	setUp {
		Passwords.getPasswords();

		JSONUser.createViaProvisioning(table = '''| Screen Name   | provisioning.admin                    |
	| Email Address | provisioning.admin@liferay.com.broken |
	| First Name    | Provisioning                          |
	| Last Name     | Admin                                 |''');

		JSONUser.assignUserToProvisioningRole(
			roleName = "Provisioning Admin",
			userEmailAddress = "provisioning.admin@liferay.com.broken");
	}

	tearDown {
		KoroneikiProductAPI._tearDownProducts(table = '''| A Visible DXP Product    |
	| A Visible Portal Product |''');

		JSONUser.tearDownUsersViaProvisioning(table = '''| provisioning.admin@liferay.com.broken |''');
	}

	test Createproducts {
		OSBAdmin.loginToProvisioning(
			userEmailAddress = "provisioning.admin@liferay.com.broken",
			userPassword = ${staticProvisioningQaUserPassword});

		UserAccount.updatePasswordUponLogin(userPassword = "test");

		Provisioning.gotoProducts();

		Provisioning.clickNewProductButton();

		ProvisioningProduct.populateProductFormAndSave(table = '''| Name | Input  | A Visible Portal Product |
	| Type | Select | Primary                  |''');

		Provisioning.searchProducts(keyword = "A");

		Provisioning._viewProductViaIndex(
			productName = "A Visible Portal Product",
			table = '''| Name | A Visible Portal Product |''');

		KoroneikiProductAPI._viewProduct(
			productName = "A Visible Portal Product",
			table = '''| Name                    | A Visible Portal Product |         |
	| Product Field and Value | type                     | primary |''');
	}

	test Deleteproducts {
		KoroneikiProductAPI._createProduct(table = '''| Name | A Visible DXP Product | |''');

		OSBAdmin.loginToProvisioning(
			userEmailAddress = "provisioning.admin@liferay.com.broken",
			userPassword = ${staticProvisioningQaUserPassword});

		UserAccount.updatePasswordUponLogin(userPassword = "test");

		Provisioning.gotoProducts();

		Provisioning.searchProducts(keyword = "A");

		Provisioning.clickProductDeleteButton(productName = "A Visible DXP Product");

		Provisioning.searchProducts(keyword = "A");

		Provisioning._viewNoProductViaIndex(productName = "A Visible DXP Product");

		KoroneikiProductAPI._viewNoProduct(productName = "A Visible DXP Product");
	}

	test Updateproducts {
		KoroneikiProductAPI._createProduct(table = '''| Name | A Visible DXP Product | |''');

		OSBAdmin.loginToProvisioning(
			userEmailAddress = "provisioning.admin@liferay.com.broken",
			userPassword = ${staticProvisioningQaUserPassword});

		UserAccount.updatePasswordUponLogin(userPassword = "test");

		Provisioning.gotoProducts();

		Provisioning.searchProducts(keyword = "A");

		Provisioning.clickProduct(productName = "A Visible DXP Product");

		ProvisioningProduct.populateProductFormAndSave(table = '''| Name | Input  | A Visible Portal Product |
	| Type | Select | Primary                  |''');

		Provisioning.searchProducts(keyword = "A");

		Provisioning._viewProductViaIndex(
			productName = "A Visible Portal Product",
			table = '''| Name | A Visible Portal Product |''');

		Provisioning._viewNoProductViaIndex(productName = "A Visible DXP Product");

		KoroneikiProductAPI._viewProduct(
			productName = "A Visible Portal Product",
			table = '''| Name                    | A Visible Portal Product |         |
	| Product Field and Value | type                     | primary |''');
	}

}