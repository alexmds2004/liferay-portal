	| Status                  | Approved                 | |''');

		LocalFile.OSBAdmin.loginToProvisioning(
			userEmailAddress = "provisioning.account.worker@liferay.com.broken",
			userPassword = ${staticProvisioningQaUserPassword});

		LocalFile.UserAccount.updatePasswordUponLogin(userPassword = "test");

		LocalFile.Provisioning.gotoAccounts();

		LocalFile.Provisioning.searchAccounts(keyword = "Permis");

		LocalFile.Provisioning.clickAccount(accountName = "Permis - ${staticProjectName}");

		LocalFile.ProvisioningAccount.clickProductTab(tabName = "All");

		LocalFile.ProvisioningAccount.selectProductsViaSubscriptionsTab(table = '''| Portal Production |''');

		LocalFile.ProvisioningAccount.clickEditSubscriptions();

		LocalFile.ProvisioningSubscription.populateSubscriptionTermFormAndProceed(table = '''| Portal Production | ${staticFullStartDate} - ${staticFullOriginalEndDate} |''');

		LocalFile.ProvisioningSubscription.populateSubscriptionFormAndSave(table = '''| Portal Production | Salesforce Opportunity Key | ${staticSalesforceOpportunityKey} |
	| Portal Production | Start Date                 | ${staticYyyyMmDdStartDate}        |
	| Portal Production | End Date                   | ${staticYyyyMmDdOriginalEndDate}  |
	| Portal Production | Grace Period               | 30                                |''');

		LocalFile.ProvisioningAccount.clickSubscriptionLink(productName = "Portal Production");

		LocalFile.ProvisioningSubscription._viewSubscriptionDetails(table = '''| Name         | Portal Production                                     |
	| State        | ACTIVE                                                |
	| Support Life | ${staticFullStartDate} - ${staticFullOriginalEndDate} |
	| Grace Period | ${staticFullOriginalEndDate} - ${staticFullEndDate}   |
	| Provisioned  | 0                                                     |
	| Purchased    | 1                                                     |''');

		LocalFile.ProvisioningSubscription._viewSubscriptionTerm(
			startDateEndDate = "${staticFullStartDate} - ${staticFullOriginalEndDate}",
			table = '''| Start - End Date           | ${staticFullStartDate} - ${staticFullOriginalEndDate} |
	| Grace Period               | ${staticFullOriginalEndDate} - ${staticFullEndDate}   |
	| Provisioned                | 0                                                     |
	| Purchased                  | 1                                                     |
	| Salesforce Opportunity Key | ${staticSalesforceOpportunityKey}                     |
	| State                      | ACTIVE                                                |''');
	}

}