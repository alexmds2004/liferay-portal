	test Viewsubscriptionafterremovalandreassignmenttoaccount {
		LocalFile.KoroneikiAccountAPI._removeCustomerContacts(
			accountName = "Lxczen - ${staticProjectName}",
			table = '''| lxcsm.customer1@lrcustomer.com.broken |''');

		LocalFile.KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		LocalFile.KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - LXC SM");

		LocalFile.ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		LocalFile.DXPCloud.viewNoSubscribedUser(userEmailAddress = "lxcsm.customer1@lrcustomer.com.broken");

		LocalFile.DXPCloud.viewSubscribedUser(userEmailAddress = "lxcsm.customer2@lrcustomer.com.broken");

		LocalFile.KoroneikiAccountAPI._removeCustomerContacts(
			accountName = "Lxczen - ${staticProjectName}",
			table = '''| lxcsm.customer2@lrcustomer.com.broken |''');

		LocalFile.KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		LocalFile.KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - LXC SM");

		LocalFile.ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		LocalFile.DXPCloud.viewNoSubscribedUser(userEmailAddress = "lxcsm.customer1@lrcustomer.com.broken");

		LocalFile.DXPCloud.viewNoSubscribedUser(userEmailAddress = "lxcsm.customer2@lrcustomer.com.broken");

		LocalFile.KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Lxczen - ${staticProjectName}",
			contactEmailAddress = "lxcsm.customer1@lrcustomer.com.broken",
			table = '''| Support Requester |''');

		LocalFile.KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		LocalFile.KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - LXC SM");

		LocalFile.ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		LocalFile.DXPCloud.viewSubscribedUser(userEmailAddress = "lxcsm.customer1@lrcustomer.com.broken");

		LocalFile.DXPCloud.viewNoSubscribedUser(userEmailAddress = "lxcsm.customer2@lrcustomer.com.broken");

		LocalFile.KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Lxczen - ${staticProjectName}",
			contactEmailAddress = "lxcsm.customer2@lrcustomer.com.broken",
			table = '''| Support User |''');

		LocalFile.KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		LocalFile.KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - LXC SM");

		LocalFile.ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		LocalFile.DXPCloud.viewSubscribedUser(userEmailAddress = "lxcsm.customer2@lrcustomer.com.broken");

		LocalFile.DXPCloud.viewSubscribedUser(userEmailAddress = "lxcsm.customer1@lrcustomer.com.broken");
	}

