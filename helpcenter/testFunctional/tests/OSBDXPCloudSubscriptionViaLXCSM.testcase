definition {

	property testray.main.component.name = "Support QA";
	property type = "osb.integration";

	setUp {
		Passwords.getPasswords();

		OSBAdminRabbitMQ.generateProvisioningProjectName();

		JSONOkta.createOktaUser(table = '''| Screen Name   | lxcsm.customer1                       |
	| Email Address | lxcsm.customer1@lrcustomer.com.broken |
	| First Name    | LXCSM                                 |
	| Last Name     | Customer1                             |''');

		JSONOkta.createOktaUser(table = '''| Screen Name   | lxcsm.customer2                       |
	| Email Address | lxcsm.customer2@lrcustomer.com.broken |
	| First Name    | LXCSM                                 |
	| Last Name     | Customer2                             |''');

		JSONUser.createViaSupport(table = '''| Screen Name   | lxcsm.user1                       |
	| Email Address | lxcsm.user1@lrcustomer.com.broken |
	| First Name    | LXCSM                             |
	| Last Name     | User1                             |''');

		KoroneikiAccountAPI._createAccount(table = '''| Code   | LXCZENLXCZEN                  | |
	| Name   | Lxczen - ${staticProjectName} | |
	| Region | United States                 | |
	| Status | Active                        | |
	| Tier   | T1                            | |''');

		KoroneikiAccountAPI._createAccount(table = '''| Code   | LXCDUPLXCDUP                  | |
	| Name   | Lxcdup - ${staticProjectName} | |
	| Region | United States                 | |
	| Status | Active                        | |
	| Tier   | T1                            | |''');

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Lxczen - ${staticProjectName}",
			contactEmailAddress = "lxcsm.customer1@lrcustomer.com.broken",
			table = '''| Support Requester |''');

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Lxczen - ${staticProjectName}",
			contactEmailAddress = "lxcsm.customer2@lrcustomer.com.broken",
			table = '''| Support User |''');

		KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Lxczen - ${staticProjectName}",
			productName = "LXC SM Subscription HA Production",
			table = '''| End Date                | ${staticEndDate}         |   |
	| Original End Date       | ${staticOriginalEndDate} |   |
	| Perpetual               | false                    |   |
	| Product Field and Value | sizing                   | 1 |
	| Quantity                | 1                        |   |
	| Start Date              | ${staticStartDate}       |   |
	| Status                  | Approved                 |   |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Lxczen - ${staticProjectName}",
			productName = "Premium Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Premium Subscription");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - LXC SM");

		JSONOSBAccount.viewSupportOrganizationSync(accountCode = "LXCZENLXCZEN");

		Downloads.teardownDownloadedListedFiles(list = ${staticDownloadedListName});
	}

	tearDown {
		ZendeskHomepage.pause(timeInSeconds = 10);

		ZendeskUserAPI._getDefaultUserId(organizationName = "Lxczen - ${staticProjectName}");

		ZendeskUserAPI._renameFirstDefaultUserIdVariable();

		ZendeskUserAPI._getDefaultUserId(organizationName = "Lxcdup - ${staticProjectName}");

		ZendeskUserAPI._renameSecondDefaultUserIdVariable();

		OSBAdminProject.tearDownProjects(table = '''| LXCZENLXCZEN |
	| LXCDUPLXCDUP |''');

		KoroneikiAccountAPI._tearDownAccounts(table = '''| Lxczen - ${staticProjectName} |
	| Lxcdup - ${staticProjectName} |''');

		KoroneikiAccountAPI._tearDownAccountsViaAccountFieldNameAndValue(
			fieldName = "Code",
			table = '''| LXCZENLXCZEN |
	| LXCDUPLXCDUP |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Premium Subscription");

		JSONUser.tearDownUsersViaSupport(table = '''| lxcsm.customer1@lrcustomer.com.broken |
	| lxcsm.customer2@lrcustomer.com.broken |
	| lxcsm.user1@lrcustomer.com.broken     |''');

		JSONUser.tearDownUsersViaKoroneiki(table = '''| lxcsm.customer1@lrcustomer.com.broken |
	| lxcsm.customer2@lrcustomer.com.broken |''');

		KoroneikiContactAPI._tearDownContacts(table = '''| lxcsm.customer1@lrcustomer.com.broken |
	| lxcsm.customer2@lrcustomer.com.broken |''');

		JSONOkta.tearDownUsers(table = '''| lxcsm.customer1@lrcustomer.com.broken |
	| lxcsm.customer2@lrcustomer.com.broken |''');

		ZendeskUserAPI._getMultipleUserIdsByEmailAddress(table = '''| lxcsm.customer1@lrcustomer.com.broken |
	| lxcsm.customer2@lrcustomer.com.broken |''');

		ZendeskUserAPI._tearDownUsersByIdList(userIds = ${staticUserIdList});

		ZendeskOrganizationAPI._getMultipleOrganizationExternalIdsByOrganizationNameIfStillPresent(table = '''| Lxczen - ${staticProjectName} |
	| Lxcdup - ${staticProjectName} |''');

		ZendeskOrganizationAPI._tearDownOrganizationsByExternalIdList(organizationExternalIds = ${staticOrganizationExternalIdList});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId1});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId2});

		OSBAdmin.logoutAndLoginToSupport(
			userEmailAddress = ${staticSupportAdminEmailAdress},
			userPassword = ${staticSupportAdminPassword});

		DXPCloud.tearDownDXPCloudSubscriptionUsers(table = '''| lxcsm.customer1@lrcustomer.com.broken |
	| lxcsm.customer2@lrcustomer.com.broken |
	| lxcsm.user1@lrcustomer.com.broken     |''');
	}

	test Downloadselfprovisioninglicense {
		JSONUser.updateSupportPassword(
			userEmailAddress = "lxcsm.customer1@lrcustomer.com.broken",
			userPassword = ${staticSupportUserTestPassword});

		JSONUser.updateSupportPassword(
			userEmailAddress = "lxcsm.customer2@lrcustomer.com.broken",
			userPassword = ${staticSupportUserTestPassword});

		JSONUser.assignUserToSupportGroup(
			groupName = "Help Center",
			userEmailAddress = "lxcsm.customer1@lrcustomer.com.broken");

		JSONUser.assignUserToSupportGroup(
			groupName = "Help Center",
			userEmailAddress = "lxcsm.customer2@lrcustomer.com.broken");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - DXP");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - LXC SM");

		OSBAdmin.logoutAndLoginToSupport(
			userEmailAddress = "lxcsm.customer1@lrcustomer.com.broken",
			userPassword = ${staticSupportUserTestPassword});

		SelfProvisioning.gotoSelfProvisioningPage();

		SelfProvisioning.downloadSelfProvisioningLicense(table = '''| Project | Lxczen - ${staticProjectName} |
	| Product | DXP                           |
	| Version | 7.4                           |''');

		SelfProvisioning.downloadSelfProvisioningLicense(table = '''| Project | Lxczen - ${staticProjectName} |
	| Product | DXP                           |
	| Version | 7.3                           |''');

		SelfProvisioning.downloadSelfProvisioningLicense(table = '''| Project | Lxczen - ${staticProjectName} |
	| Product | DXP                           |
	| Version | 7.2                           |''');

		ProvisioningLicense.assertDownloadedLicensePresent(
			fileType = "xml",
			table = '''| License Type | activation-key            |
	| Product      | DXP Development           |
	| Version      | 7.4                       |
	| License Name | Developer Activation Keys |''');

		ProvisioningLicense.assertDownloadedLicensePresent(
			fileType = "xml",
			table = '''| License Type | activation-key            |
	| Product      | DXP Development           |
	| Version      | 7.3                       |
	| License Name | Developer Activation Keys |''');

		ProvisioningLicense.assertDownloadedLicensePresent(
			fileType = "xml",
			table = '''| License Type | activation-key            |
	| Product      | DXP Development           |
	| Version      | 7.2                       |
	| License Name | Developer Activation Keys |''');

		OSBAdmin.logoutAndLoginToSupport(
			userEmailAddress = "lxcsm.customer2@lrcustomer.com.broken",
			userPassword = ${staticSupportUserTestPassword});

		SelfProvisioning.gotoSelfProvisioningPage();

		SelfProvisioning.downloadSelfProvisioningLicense(table = '''| Project | Lxczen - ${staticProjectName} |
	| Product | DXP                           |
	| Version | 7.4                           |''');

		SelfProvisioning.downloadSelfProvisioningLicense(table = '''| Project | Lxczen - ${staticProjectName} |
	| Product | DXP                           |
	| Version | 7.3                           |''');

		SelfProvisioning.downloadSelfProvisioningLicense(table = '''| Project | Lxczen - ${staticProjectName} |
	| Product | DXP                           |
	| Version | 7.2                           |''');

		ProvisioningLicense.assertDownloadedLicensePresent(
			fileType = "xml",
			table = '''| License Type | activation-key            |
	| Product      | DXP Development           |
	| Version      | 7.4                       |
	| License Name | Developer Activation Keys |
	| Copy         | 1                         |''');

		ProvisioningLicense.assertDownloadedLicensePresent(
			fileType = "xml",
			table = '''| License Type | activation-key            |
	| Product      | DXP Development           |
	| Version      | 7.3                       |
	| License Name | Developer Activation Keys |
	| Copy         | 1                         |''');

		ProvisioningLicense.assertDownloadedLicensePresent(
			fileType = "xml",
			table = '''| License Type | activation-key            |
	| Product      | DXP Development           |
	| Version      | 7.2                       |
	| License Name | Developer Activation Keys |
	| Copy         | 1                         |''');
	}

	test Viewdownloadspage {
		JSONUser.updateSupportPassword(
			userEmailAddress = "lxcsm.customer1@lrcustomer.com.broken",
			userPassword = ${staticSupportUserTestPassword});

		JSONUser.updateSupportPassword(
			userEmailAddress = "lxcsm.customer2@lrcustomer.com.broken",
			userPassword = ${staticSupportUserTestPassword});

		JSONUser.assignUserToSupportGroup(
			groupName = "Help Center",
			userEmailAddress = "lxcsm.customer1@lrcustomer.com.broken");

		JSONUser.assignUserToSupportGroup(
			groupName = "Help Center",
			userEmailAddress = "lxcsm.customer2@lrcustomer.com.broken");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - DXP");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - LXC SM");

		OSBAdmin.logoutAndLoginToSupport(
			userEmailAddress = "lxcsm.customer1@lrcustomer.com.broken",
			userPassword = ${staticSupportUserTestPassword});

		Downloads.gotoDownloadsPage();

		Downloads.setSearchFilters(
			fileType = "Product/Updates",
			productName = "DXP 7.3");

		Downloads.viewDownloadHeader(downloadName = "Liferay DXP 7.3 Service Pack 1");

		Downloads.viewDownloadHeader(downloadName = "Liferay DXP 7.3 and Liferay Commerce 3.0");

		Downloads.setSearchFilters(
			fileType = "Fix Packs",
			productName = "DXP 7.2");

		Downloads.viewDownloadHeader(downloadName = "Liferay DXP 7.2 Fix Pack 2");

		Downloads.viewDownloadHeader(downloadName = "Liferay DXP 7.2 Fix Pack 1");

		Downloads.setSearchFilters(
			fileType = "Fix Packs",
			productName = "DXP 7.1");

		Downloads.viewDownloadHeader(downloadName = "Liferay DXP 7.1 Fix Pack 14");

		Downloads.viewDownloadHeader(downloadName = "Liferay DXP 7.1 Fix Pack 13");

		Downloads.setSearchFilters(
			fileType = "Fix Packs",
			productName = "DXP 7.0");

		Downloads.viewDownloadHeader(downloadName = "Liferay DXP 7.0 Fix Pack 86");

		Downloads.viewDownloadHeader(downloadName = "Liferay DXP 7.0 Fix Pack 85");

		OSBAdmin.logoutAndLoginToSupport(
			userEmailAddress = "lxcsm.customer2@lrcustomer.com.broken",
			userPassword = ${staticSupportUserTestPassword});

		Downloads.gotoDownloadsPage();

		Downloads.setSearchFilters(
			fileType = "Product/Updates",
			productName = "DXP 7.3");

		Downloads.viewDownloadHeader(downloadName = "Liferay DXP 7.3 Service Pack 1");

		Downloads.viewDownloadHeader(downloadName = "Liferay DXP 7.3 and Liferay Commerce 3.0");

		Downloads.setSearchFilters(
			fileType = "Fix Packs",
			productName = "DXP 7.2");

		Downloads.viewDownloadHeader(downloadName = "Liferay DXP 7.2 Fix Pack 2");

		Downloads.viewDownloadHeader(downloadName = "Liferay DXP 7.2 Fix Pack 1");

		Downloads.setSearchFilters(
			fileType = "Fix Packs",
			productName = "DXP 7.1");

		Downloads.viewDownloadHeader(downloadName = "Liferay DXP 7.1 Fix Pack 14");

		Downloads.viewDownloadHeader(downloadName = "Liferay DXP 7.1 Fix Pack 13");

		Downloads.setSearchFilters(
			fileType = "Fix Packs",
			productName = "DXP 7.0");

		Downloads.viewDownloadHeader(downloadName = "Liferay DXP 7.0 Fix Pack 86");

		Downloads.viewDownloadHeader(downloadName = "Liferay DXP 7.0 Fix Pack 85");
	}

	test Viewnosubscriptionaftercustomerremoval {
		KoroneikiAccountAPI._removeCustomerContacts(
			accountName = "Lxczen - ${staticProjectName}",
			table = '''| lxcsm.customer1@lrcustomer.com.broken |''');

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - LXC SM");

		ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		DXPCloud.viewNoSubscribedUser(userEmailAddress = "lxcsm.customer1@lrcustomer.com.broken");

		DXPCloud.viewSubscribedUser(userEmailAddress = "lxcsm.customer2@lrcustomer.com.broken");

		KoroneikiAccountAPI._removeCustomerContacts(
			accountName = "Lxczen - ${staticProjectName}",
			table = '''| lxcsm.customer2@lrcustomer.com.broken |''');

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - LXC SM");

		ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		DXPCloud.viewNoSubscribedUser(userEmailAddress = "lxcsm.customer1@lrcustomer.com.broken");

		DXPCloud.viewNoSubscribedUser(userEmailAddress = "lxcsm.customer2@lrcustomer.com.broken");
	}

	test Viewnosubscriptionafterofferingcancellation {
		KoroneikiProductPurchaseAPI._updateProductPurchase(
			accountName = "Lxczen - ${staticProjectName}",
			productName = "LXC SM Subscription HA Production",
			table = '''| End Date          | ${staticEndDate}         | |
	| Original End Date | ${staticOriginalEndDate} | |
	| Perpetual         | false                    | |
	| Start Date        | ${staticStartDate}       | |
	| Status            | Cancelled                | |''');

		KoroneikiProductPurchaseAPI._updateProductPurchase(
			accountName = "Lxczen - ${staticProjectName}",
			productName = "Premium Subscription",
			table = '''| End Date          | ${staticEndDate}         | |
	| Original End Date | ${staticOriginalEndDate} | |
	| Perpetual         | false                    | |
	| Start Date        | ${staticStartDate}       | |
	| Status            | Cancelled                | |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Premium Subscription");

		KoroneikiAccountAPI._removeCustomerContacts(
			accountName = "Lxczen - ${staticProjectName}",
			table = '''| lxcsm.customer1@lrcustomer.com.broken |''');

		KoroneikiAccountAPI._removeCustomerContacts(
			accountName = "Lxczen - ${staticProjectName}",
			table = '''| lxcsm.customer2@lrcustomer.com.broken |''');

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - LXC SM");

		ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		DXPCloud.viewNoSubscribedUser(userEmailAddress = "lxcsm.customer1@lrcustomer.com.broken");

		DXPCloud.viewNoSubscribedUser(userEmailAddress = "lxcsm.customer2@lrcustomer.com.broken");
	}

	test Viewnosubscriptionafterofferingexpiration {
		KoroneikiProductPurchaseAPI.generateStaticPastStartAndEndDate();

		KoroneikiProductPurchaseAPI._updateProductPurchase(
			accountName = "Lxczen - ${staticProjectName}",
			productName = "LXC SM Subscription HA Production",
			table = '''| End Date          | ${staticPastEndDate}         | |
	| Original End Date | ${staticPastOriginalEndDate} | |
	| Perpetual         | false                        | |
	| Start Date        | ${staticPastStartDate}       | |
	| Status            | Approved                     | |''');

		KoroneikiProductPurchaseAPI._updateProductPurchase(
			accountName = "Lxczen - ${staticProjectName}",
			productName = "Premium Subscription",
			table = '''| End Date          | ${staticPastEndDate}         | |
	| Original End Date | ${staticPastOriginalEndDate} | |
	| Perpetual         | false                        | |
	| Start Date        | ${staticPastStartDate}       | |
	| Status            | Approved                     | |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Premium Subscription");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - LXC SM");

		DXPCloud.viewNoSubscribedUser(userEmailAddress = "lxcsm.customer1@lrcustomer.com.broken");

		DXPCloud.viewNoSubscribedUser(userEmailAddress = "lxcsm.customer2@lrcustomer.com.broken");
	}

	test Viewnosubscriptionafterofferingremoval {
		KoroneikiProductPurchaseAPI.generateStaticPastStartAndEndDate();

		KoroneikiProductPurchaseAPI._deleteProductPurchase(
			accountName = "Lxczen - ${staticProjectName}",
			productName = "LXC SM Subscription HA Production");

		KoroneikiProductPurchaseAPI._deleteProductPurchase(
			accountName = "Lxczen - ${staticProjectName}",
			productName = "Premium Subscription");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - LXC SM");

		ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		DXPCloud.viewNoSubscribedUser(userEmailAddress = "lxcsm.customer1@lrcustomer.com.broken");

		DXPCloud.viewNoSubscribedUser(userEmailAddress = "lxcsm.customer2@lrcustomer.com.broken");
	}

	test Viewreleasenotes {
		JSONUser.updateSupportPassword(
			userEmailAddress = "lxcsm.customer1@lrcustomer.com.broken",
			userPassword = ${staticSupportUserTestPassword});

		JSONUser.updateSupportPassword(
			userEmailAddress = "lxcsm.customer2@lrcustomer.com.broken",
			userPassword = ${staticSupportUserTestPassword});

		JSONUser.assignUserToSupportGroup(
			groupName = "Help Center",
			userEmailAddress = "lxcsm.customer1@lrcustomer.com.broken");

		JSONUser.assignUserToSupportGroup(
			groupName = "Help Center",
			userEmailAddress = "lxcsm.customer2@lrcustomer.com.broken");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - DXP");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - LXC SM");

		OSBAdmin.logoutAndLoginToSupport(
			userEmailAddress = "lxcsm.customer1@lrcustomer.com.broken",
			userPassword = ${staticSupportUserTestPassword});

		ReleaseNotes.gotoDXPReleaseNotes();

		ReleaseNotes.setSearchFilters(
			fixPackName1 = "Fix Pack 74",
			fixPackName2 = "Fix Pack 76",
			productName = "DXP 7.0");

		ReleaseNotes.refineFilters(table = '''| Key Highlights    | true  |
	| Important Changes | false |
	| Known Issues      | false |
	| Security          | false |''');

		ReleaseNotes.viewFixPackHighlightsWithRefinedFilters(
			fixPackName = "Fix Pack 76",
			productName = "DXP 7.0",
			table = '''| Key Highlights    | true  |
	| Important Changes | false |
	| Known Issues      | false |
	| Security          | false |''');

		ReleaseNotes.viewFixPackHighlightsWithRefinedFilters(
			fixPackName = "Fix Pack 75",
			productName = "DXP 7.0",
			table = '''| Key Highlights    | true  |
	| Important Changes | false |
	| Known Issues      | false |
	| Security          | false |''');

		ReleaseNotes.gotoChangelog();

		ReleaseNotes.viewChangelogReleaseVersion(version = "Fix Pack 76");

		ReleaseNotes.viewChangelogReleaseVersion(version = "Fix Pack 75");

		ReleaseNotes.gotoModuleChanges();

		ReleaseNotes.refineFilters(table = '''| Liferay Artifacts     | true  |
	| Third Party Libraries | false |
	| Only Show Changes     | false |''');

		ReleaseNotes.viewResultsCount(resultsCount = 716);

		ReleaseNotes.viewNoModuleChange(name = "antlr");

		ReleaseNotes.viewModuleChangeText(
			name = "com.liferay.adaptive.media.api",
			table = '''| Name          | com.liferay.adaptive.media.api |
	| Group         | com.liferay	                 |
	| Fix Pack From | 2.0.3                          |
	| Fix Pack To   | 2.0.3                          |
	| Change        | false                          |''');

		ReleaseNotes.viewModuleChangeText(
			name = "com.liferay.adaptive.media.document.library",
			table = '''| Name          | com.liferay.adaptive.media.document.library |
	| Group         | com.liferay	                              |
	| Fix Pack From | 1.0.7                                       |
	| Fix Pack To   | 1.0.9                                       |
	| Change        | true                                        |''');

		OSBAdmin.logoutAndLoginToSupport(
			userEmailAddress = "lxcsm.customer2@lrcustomer.com.broken",
			userPassword = ${staticSupportUserTestPassword});

		ReleaseNotes.gotoDXPReleaseNotes();

		ReleaseNotes.setSearchFilters(
			fixPackName1 = "Fix Pack 74",
			fixPackName2 = "Fix Pack 76",
			productName = "DXP 7.0");

		ReleaseNotes.refineFilters(table = '''| Key Highlights    | true  |
	| Important Changes | false |
	| Known Issues      | false |
	| Security          | false |''');

		ReleaseNotes.viewFixPackHighlightsWithRefinedFilters(
			fixPackName = "Fix Pack 76",
			productName = "DXP 7.0",
			table = '''| Key Highlights    | true  |
	| Important Changes | false |
	| Known Issues      | false |
	| Security          | false |''');

		ReleaseNotes.viewFixPackHighlightsWithRefinedFilters(
			fixPackName = "Fix Pack 75",
			productName = "DXP 7.0",
			table = '''| Key Highlights    | true  |
	| Important Changes | false |
	| Known Issues      | false |
	| Security          | false |''');

		ReleaseNotes.gotoChangelog();

		ReleaseNotes.viewChangelogReleaseVersion(version = "Fix Pack 76");

		ReleaseNotes.viewChangelogReleaseVersion(version = "Fix Pack 75");

		ReleaseNotes.gotoModuleChanges();

		ReleaseNotes.refineFilters(table = '''| Liferay Artifacts     | true  |
	| Third Party Libraries | false |
	| Only Show Changes     | false |''');

		ReleaseNotes.viewResultsCount(resultsCount = 716);

		ReleaseNotes.viewNoModuleChange(name = "antlr");

		ReleaseNotes.viewModuleChangeText(
			name = "com.liferay.adaptive.media.api",
			table = '''| Name          | com.liferay.adaptive.media.api |
	| Group         | com.liferay	                 |
	| Fix Pack From | 2.0.3                          |
	| Fix Pack To   | 2.0.3                          |
	| Change        | false                          |''');

		ReleaseNotes.viewModuleChangeText(
			name = "com.liferay.adaptive.media.document.library",
			table = '''| Name          | com.liferay.adaptive.media.document.library |
	| Group         | com.liferay	                              |
	| Fix Pack From | 1.0.7                                       |
	| Fix Pack To   | 1.0.9                                       |
	| Change        | true                                        |''');
	}

	test Viewselfprovisioningpage {
		JSONUser.updateSupportPassword(
			userEmailAddress = "lxcsm.customer1@lrcustomer.com.broken",
			userPassword = ${staticSupportUserTestPassword});

		JSONUser.updateSupportPassword(
