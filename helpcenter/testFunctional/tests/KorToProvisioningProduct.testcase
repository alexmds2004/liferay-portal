definition {

	property testray.main.component.name = "Support QA";
	property type = "provisioning.product.integration";

	setUp {
		Passwords.getPasswords();

		JSONOkta.createOktaUser(table = '''| Screen Name   | prd.koroneiki1                       |
	| Email Address | prd.koroneiki1@lrcustomer.com.broken |
	| First Name    | PRD                                  |
	| Last Name     | Koroneiki1                           |''');

		JSONOkta.createOktaUser(table = '''| Screen Name   | prd.koroneiki2                       |
	| Email Address | prd.koroneiki2@lrcustomer.com.broken |
	| First Name    | PRD                                  |
	| Last Name     | Koroneiki2                           |''');
	}

	tearDown {
		ZendeskUserAPI._getDefaultUserId(organizationName = "Korprd - ${staticProjectName}");

		ZendeskUserAPI._renameFirstDefaultUserIdVariable();

		ZendeskUserAPI._getDefaultUserId(organizationName = "Prdkor - ${staticCompanyName}");

		ZendeskUserAPI._renameSecondDefaultUserIdVariable();

		KoroneikiProductConsumptionAPI._tearDownProductConsumptions(
			accountName = "Korprd - ${staticProjectName}",
			table = '''| A Digital DXP Product     |
	| A Digital Portal Product  |
	| An Updated Portal Product |
	| Platinum Subscription     |''');

		OSBAdminProject.tearDownProjects(table = '''| PRDKORKORPRD |
	| PRDKOR       |''');

		KoroneikiAccountAPI._tearDownAccounts(table = '''| Korprd - ${staticProjectName} |
	| Prdkor - ${staticCompanyName} |''');

		KoroneikiAccountAPI._tearDownAccountsViaAccountFieldNameAndValue(
			fieldName = "Code",
			table = '''| PRDKORKORPRD |
	| PRDKOR       |''');

		KoroneikiProductAPI._tearDownProducts(table = '''| A Digital DXP Product     |
	| A Digital Portal Product  |
	| An Updated Portal Product |
	| Bronze Subscription       |
	| Copper Subscription       |''');

		JSONUser.tearDownUsersViaSupport(table = '''| prd.koroneiki1@lrcustomer.com.broken |
	| prd.koroneiki2@lrcustomer.com.broken |''');

		JSONUser.tearDownUsersViaKoroneiki(table = '''| prd.koroneiki1@lrcustomer.com.broken |
	| prd.koroneiki2@lrcustomer.com.broken |''');

		KoroneikiContactAPI._tearDownContacts(table = '''| prd.koroneiki1@lrcustomer.com.broken |
	| prd.koroneiki2@lrcustomer.com.broken |''');

		JSONOkta.tearDownUsers(table = '''| prd.koroneiki1@lrcustomer.com.broken |
	| prd.koroneiki2@lrcustomer.com.broken |''');

		ZendeskTicketAPI._tearDownTicketsByKeywords(table = '''| New Subscription(s) for Korprd - ${staticProjectName} |
	| New Subscription(s) for Prdkor - ${staticCompanyName} |''');

		ZendeskUserAPI._getMultipleUserIdsByEmailAddress(table = '''| prd.koroneiki1@lrcustomer.com.broken |
	| prd.koroneiki2@lrcustomer.com.broken |''');

		ZendeskUserAPI._tearDownUsersByIdList(userIds = ${staticUserIdList});

		ZendeskOrganizationAPI._getMultipleOrganizationExternalIdsByOrganizationNameIfStillPresent(table = '''| Korprd - ${staticProjectName} |
	| Prdkor - ${staticCompanyName} |''');

		ZendeskOrganizationAPI._tearDownOrganizationsByExternalIdList(organizationExternalIds = ${staticOrganizationExternalIdList});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId1});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId2});
	}

	test Createproducts {
		property help.center.acceptance = "true";

		OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		Provisioning.gotoProducts();

		Provisioning.clickNewProductButton();

		ProvisioningProduct.populateProductFormAndSave(table = '''| Name | Input  | A Digital Portal Product |
	| Type | Select | Primary                  |''');

		Provisioning.clickNewProductButton();

		ProvisioningProduct.populateProductFormAndSave(table = '''| Name | Input  | Bronze Subscription |
	| Type | Select | Add On              |''');

		Provisioning.searchProducts(keyword = "A");

		Provisioning._viewProductViaIndex(
			productName = "A Digital Portal Product",
			table = '''| Name | A Digital Portal Product |''');

		Provisioning.searchProducts(keyword = "Bronze");

		Provisioning._viewProductViaIndex(
			productName = "Bronze Subscription",
			table = '''| Name | Bronze Subscription |''');

		KoroneikiProductAPI._viewProduct(
			productName = "A Digital Portal Product",
			table = '''| Name                    | A Digital Portal Product |         |
	| Product Field and Value | type                     | primary |''');

		KoroneikiProductAPI._viewProduct(
			productName = "Bronze Subscription",
			table = '''| Name                    | Bronze Subscription |        |
	| Product Field and Value | type                | add-on |''');
	}

	test Createproductswithduplicatenames {
		KoroneikiProductAPI._createProduct(table = '''| Name | A Digital DXP Product | |''');

		OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		Provisioning.gotoProducts();

		Provisioning.clickNewProductButton();

		ProvisioningProduct.populateProductFormAndSave(table = '''| Name | Input  | A Digital DXP Product |
	| Type | Select | Primary               |''');

		ProvisioningProduct.viewProductFormDuplicateNameErrorMessage(productName = "A Digital DXP Product");

		ProvisioningProduct.populateProductFormAndSave(table = '''| Name | Input  | A Digital Portal Product |
	| Type | Select | Primary                  |''');

		Provisioning.clickNewProductButton();

		ProvisioningProduct.populateProductFormAndSave(table = '''| Name | Input  | Platinum Subscription |
	| Type | Select | Add On                |''');

		ProvisioningProduct.viewProductFormDuplicateNameErrorMessage(productName = "Platinum Subscription");

		ProvisioningProduct.populateProductFormAndSave(table = '''| Name | Input  | Bronze Subscription |
	| Type | Select | Add On              |''');

		Provisioning.searchProducts(keyword = "A");

		Provisioning._viewProductViaIndex(
			productName = "A Digital Portal Product",
			table = '''| Name | A Digital Portal Product |''');

		Provisioning._viewProductViaIndex(
			productName = "A Digital DXP Product",
			table = '''| Name | A Digital DXP Product |''');

		Provisioning.searchProducts(keyword = "Bronze");

		Provisioning._viewProductViaIndex(
			productName = "Bronze Subscription",
			table = '''| Name | Bronze Subscription |''');

		Provisioning.searchProducts(keyword = "Platinum");

		Provisioning._viewProductViaIndex(
			productName = "Platinum Subscription",
			table = '''| Name | Platinum Subscription |''');

		KoroneikiProductAPI._viewProduct(
			productName = "A Digital Portal Product",
			table = '''| Name                    | A Digital Portal Product |         |
	| Product Field and Value | type                     | primary |''');

		KoroneikiProductAPI._viewProduct(
			productName = "Bronze Subscription",
			table = '''| Name                    | Bronze Subscription |        |
	| Product Field and Value | type                | add-on |''');

		KoroneikiProductAPI._viewProduct(
			productName = "A Digital DXP Product",
			table = '''| Name | A Digital DXP Product | |''');

		KoroneikiProductAPI._viewProduct(
			productName = "Platinum Subscription",
			table = '''| Name | Platinum Subscription | |''');
	}

	test Deletecreatedproducts {
		OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		Provisioning.gotoProducts();

		Provisioning.clickNewProductButton();

		ProvisioningProduct.populateProductFormAndSave(table = '''| Name | Input  | A Digital Portal Product |
	| Type | Select | Primary                  |''');

		Provisioning.searchProducts(keyword = "A");

		Provisioning.clickProductDeleteButton(productName = "A Digital Portal Product");

		Provisioning.searchProducts(keyword = "A");

		Provisioning._viewNoProductViaIndex(productName = "A Digital Portal Product");

		KoroneikiProductAPI._viewNoProduct(productName = "A Digital Portal Product");
	}

	test Deleteproducts {
		property help.center.acceptance = "true";

		KoroneikiProductAPI._createProduct(table = '''| Name | A Digital DXP Product | |''');

		OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		Provisioning.gotoProducts();

		Provisioning.searchProducts(keyword = "A");

		Provisioning.clickProductDeleteButton(productName = "A Digital DXP Product");

		Provisioning.searchProducts(keyword = "A");

		Provisioning._viewNoProductViaIndex(productName = "A Digital DXP Product");

		KoroneikiProductAPI._viewNoProduct(productName = "A Digital DXP Product");
	}

	test Deleteproductswithconsumptions {
		OSBAdminRabbitMQ.generateStaticVariables();

		OSBAdminRabbitMQ.generateProvisioningCompanyName();

		OSBAdminRabbitMQ.generateProvisioningProjectName();

		KoroneikiProductAPI._createProduct(table = '''| Name | A Digital DXP Product | |''');

		KoroneikiProductAPI._createProductExternalLink(
			productName = "A Digital DXP Product",
			table = '''| Domain      | dossiera              |
	| Entity Id   | A Digital DXP Product |
	| Entity Name | product               |''');

		OSBAdminRabbitMQ.publishCreateProjectWithNoPartnerMessage(
			routingKey = "dossiera.provisioning.create",
			table = '''| Account Name                           | Prdkor - ${staticCompanyName}              |
	| Address City                           | Diamond Bar                                |
	| Address Country                        | United States                              |
	| Address Postal Code                    | 91765                                      |
	| Address Region                         | California                                 |
	| Address Street                         | 456 Fake Street                            |
	| Contact Email Address                  | prd.koroneiki1@lrcustomer.com.broken       |
	| Contact First Name                     | PRD                                        |
	| Contact Last Name                      | Koroneiki1                                 |
	| Dossiera Account Key                   | ${staticDossieraAccountKey}                |
	| Dossiera Address Key 1                 | ${staticDossieraAddressKey1}               |
	| Dossiera Address Key 2                 | ${staticDossieraAddressKey2}               |
	| Dossiera Contact Key                   | ${staticDossieraContactKey}                |
	| Dossiera Project Key                   | ${staticDossieraProjectKey}                |
	| End Day                                | ${staticEndDay}                            |
	| End Month                              | ${staticEndMonth}                          |
	| End Year                               | ${staticEndYear}                           |
	| Industry                               | Automotive                                 |
	| Owner Email Address                    | prd.koroneiki2@lrcustomer.com.broken       |
	| Owner First Name                       | PRD                                        |
	| Owner Last Name                        | Koroneiki2                                 |
	| Partner First Line Support             | false                                      |
	| Product Type                           | New                                        |
	| Product Name                           | A Digital DXP Product                      |
	| Project Name                           | Korprd - ${staticProjectName}              |
	| Renewal                                | false                                      |
	| Salesforce Opportunity Key             | ${staticSalesforceOpportunityKey}          |
	| Salesforce Opportunity Line Item Key 1 | ${staticSalesforceOpportunityLineItemKey1} |
	| Salesforce Opportunity Line Item Key 2 | ${staticSalesforceOpportunityLineItemKey2} |
	| Salesforce Opportunity Sold By         | Liferay US                                 |
	| Salesforce Opportunity Stage Name      | Closed Won                                 |
	| Salesforce Opportunity Territory       | United States                              |
	| Salesforce Opportunity Type            | New Business                               |
	| Salesforce Owner User Key              | ${staticSalesforceOwnerUserKey}            |
	| Salesforce Project Key                 | ${staticSalesforceProjectKey}              |
	| Start Day                              | ${staticStartDay}                          |
	| Start Month                            | ${staticStartMonth}                        |
	| Start Year                             | ${staticStartYear}                         |
	| Subscription Level                     | Platinum                                   |
	| Version Number                         | 7.1                                        |''');

		KoroneikiAccountAPI._createAccountProductConsumption(
			accountName = "Korprd - ${staticProjectName}",
			productName = "A Digital DXP Product",
			table = '''| Product Field and Value | additionalProp1 | propertyValue1 |
	| Product Field and Value | additionalProp2 | propertyValue2 |
	| Product Field and Value | additionalProp3 | propertyValue3 |''');

		KoroneikiProductAPI._generateProductId(productName = "A Digital DXP Product");

		OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		Provisioning.gotoProducts();

		Provisioning.searchProducts(keyword = "A");

		Provisioning.clickProductDeleteButton(productName = "A Digital DXP Product");

		Provisioning.viewProductIndexProductConsumptionErrorMessage(productId = ${staticProductId});

		Provisioning.searchProducts(keyword = "A");

		Provisioning._viewProductViaIndex(
			productName = "A Digital DXP Product",
			table = '''| Name | A Digital DXP Product |''');

		KoroneikiProductAPI._viewProduct(
			productName = "A Digital DXP Product",
			table = '''| Name | A Digital DXP Product | |''');
	}

	test Deleteproductswithpurchases {
		OSBAdminRabbitMQ.generateStaticVariables();

		OSBAdminRabbitMQ.generateProvisioningCompanyName();

		OSBAdminRabbitMQ.generateProvisioningProjectName();

		KoroneikiProductAPI._createProduct(table = '''| Name | A Digital DXP Product | |''');

		KoroneikiProductAPI._createProductExternalLink(
			productName = "A Digital DXP Product",
			table = '''| Domain      | dossiera              |
	| Entity Id   | A Digital DXP Product |
	| Entity Name | product               |''');

		OSBAdminRabbitMQ.publishCreateProjectWithNoPartnerMessage(
			routingKey = "dossiera.provisioning.create",
			table = '''| Account Name                           | Prdkor - ${staticCompanyName}              |
	| Address City                           | Diamond Bar                                |
	| Address Country                        | United States                              |
	| Address Postal Code                    | 91765                                      |
	| Address Region                         | California                                 |
	| Address Street                         | 456 Fake Street                            |
	| Contact Email Address                  | prd.koroneiki1@lrcustomer.com.broken       |
	| Contact First Name                     | PRD                                        |
	| Contact Last Name                      | Koroneiki1                                 |
	| Dossiera Account Key                   | ${staticDossieraAccountKey}                |
	| Dossiera Address Key 1                 | ${staticDossieraAddressKey1}               |
	| Dossiera Address Key 2                 | ${staticDossieraAddressKey2}               |
	| Dossiera Contact Key                   | ${staticDossieraContactKey}                |
	| Dossiera Project Key                   | ${staticDossieraProjectKey}                |
	| End Day                                | ${staticEndDay}                            |
	| End Month                              | ${staticEndMonth}                          |
	| End Year                               | ${staticEndYear}                           |
	| Industry                               | Automotive                                 |
	| Owner Email Address                    | prd.koroneiki2@lrcustomer.com.broken       |
	| Owner First Name                       | PRD                                        |
	| Owner Last Name                        | Koroneiki2                                 |
	| Partner First Line Support             | false                                      |
	| Product Type                           | New                                        |
	| Product Name                           | A Digital DXP Product                      |
	| Project Name                           | Korprd - ${staticProjectName}              |
	| Renewal                                | false                                      |
	| Salesforce Opportunity Key             | ${staticSalesforceOpportunityKey}          |
	| Salesforce Opportunity Line Item Key 1 | ${staticSalesforceOpportunityLineItemKey1} |
	| Salesforce Opportunity Line Item Key 2 | ${staticSalesforceOpportunityLineItemKey2} |
	| Salesforce Opportunity Sold By         | Liferay US                                 |
	| Salesforce Opportunity Stage Name      | Closed Won                                 |
	| Salesforce Opportunity Territory       | United States                              |
	| Salesforce Opportunity Type            | New Business                               |
	| Salesforce Owner User Key              | ${staticSalesforceOwnerUserKey}            |
	| Salesforce Project Key                 | ${staticSalesforceProjectKey}              |
	| Start Day                              | ${staticStartDay}                          |
	| Start Month                            | ${staticStartMonth}                        |
	| Start Year                             | ${staticStartYear}                         |
	| Subscription Level                     | Platinum                                   |
	| Version Number                         | 7.1                                        |''');

		KoroneikiProductAPI._generateProductId(productName = "A Digital DXP Product");

		OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		Provisioning.gotoProducts();

		Provisioning.searchProducts(keyword = "A");

		Provisioning.clickProductDeleteButton(productName = "A Digital DXP Product");

		Provisioning.viewProductIndexProductPurchaseErrorMessage(productId = ${staticProductId});

		Provisioning.searchProducts(keyword = "A");

		Provisioning._viewProductViaIndex(
			productName = "A Digital DXP Product",
			table = '''| Name | A Digital DXP Product |''');

		KoroneikiProductAPI._viewProduct(
			productName = "A Digital DXP Product",
			table = '''| Name | A Digital DXP Product | |''');
	}

	test Updatecreatedproducts {
		OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		Provisioning.gotoProducts();

		Provisioning.clickNewProductButton();

		ProvisioningProduct.populateProductFormAndSave(table = '''| Name | Input  | A Digital Portal Product |
	| Type | Select | Primary                  |''');

		Provisioning.clickNewProductButton();

		ProvisioningProduct.populateProductFormAndSave(table = '''| Name | Input  | Bronze Subscription |
	| Type | Select | Add On              |''');

		Provisioning.searchProducts(keyword = "A");

		Provisioning.clickProduct(productName = "A Digital Portal Product");

		ProvisioningProduct.populateProductFormAndSave(table = '''| Name | Input  | An Updated Portal Product |
	| Type | Select | Primary                   |''');

		Provisioning.searchProducts(keyword = "Bronze");

		Provisioning.clickProduct(productName = "Bronze Subscription");

		ProvisioningProduct.populateProductFormAndSave(table = '''| Name | Input  | Copper Subscription |
	| Type | Select | Add On              |''');

		Provisioning.searchProducts(keyword = "An");

		Provisioning._viewProductViaIndex(
			productName = "An Updated Portal Product",
			table = '''| Name | An Updated Portal Product |''');

		Provisioning.searchProducts(keyword = "A");

		Provisioning._viewNoProductViaIndex(productName = "A Digital Portal Product");

		Provisioning.searchProducts(keyword = "Bronze");

		Provisioning._viewNoProductViaIndex(productName = "Bronze Subscription");

		Provisioning.searchProducts(keyword = "Copper");

		Provisioning._viewProductViaIndex(
			productName = "Copper Subscription",
			table = '''| Name | Copper Subscription |''');

		KoroneikiProductAPI._viewProduct(
			productName = "An Updated Portal Product",
			table = '''| Name                    | An Updated Portal Product |         |
	| Product Field and Value | type                      | primary |''');

		KoroneikiProductAPI._viewProduct(
			productName = "Copper Subscription",
			table = '''| Name                    | Copper Subscription |        |
	| Product Field and Value | type                | add-on |''');

		KoroneikiProductAPI._viewNoProduct(productName = "A Digital Portal Product");

		KoroneikiProductAPI._viewNoProduct(productName = "Bronze Subscription");
	}

	test Updatecreatedproductswithduplicatenames {
		KoroneikiProductAPI._createProduct(table = '''| Name | A Digital DXP Product | |''');

		OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		Provisioning.gotoProducts();

		Provisioning.clickNewProductButton();

		ProvisioningProduct.populateProductFormAndSave(table = '''| Name | Input  | A Digital Portal Product |
	| Type | Select | Primary                  |''');

		Provisioning.clickNewProductButton();

		ProvisioningProduct.populateProductFormAndSave(table = '''| Name | Input  | Bronze Subscription |
	| Type | Select | Add On              |''');

		Provisioning.searchProducts(keyword = "A");

		Provisioning.clickProduct(productName = "A Digital Portal Product");

		ProvisioningProduct.populateProductFormAndSave(table = '''| Name | Input  | An Updated Portal Product |
	| Type | Select | Primary                   |''');

		Provisioning.searchProducts(keyword = "Bronze");

		Provisioning.clickProduct(productName = "Bronze Subscription");

		ProvisioningProduct.populateProductFormAndSave(table = '''| Name | Input  | Platinum Subscription |
	| Type | Select | Add On                |''');

		ProvisioningProduct.viewProductFormDuplicateNameErrorMessage(productName = "Platinum Subscription");

		ProvisioningProduct.populateProductFormAndSave(table = '''| Name | Input  | Copper Subscription |
	| Type | Select | Add On              |''');

		Provisioning.searchProducts(keyword = "An");

		Provisioning._viewProductViaIndex(
			productName = "An Updated Portal Product",
			table = '''| Name | An Updated Portal Product |''');

		Provisioning.searchProducts(keyword = "A");

		Provisioning._viewProductViaIndex(
			productName = "A Digital DXP Product",
			table = '''| Name | A Digital DXP Product |''');

		Provisioning._viewNoProductViaIndex(productName = "A Digital Portal Product");

		Provisioning.searchProducts(keyword = "Bronze");

		Provisioning._viewNoProductViaIndex(productName = "Bronze Subscription");

		Provisioning.searchProducts(keyword = "Copper");

		Provisioning._viewProductViaIndex(
			productName = "Copper Subscription",
			table = '''| Name | Copper Subscription |''');

		Provisioning.searchProducts(keyword = "Platinum");

		Provisioning._viewProductViaIndex(
			productName = "Platinum Subscription",
			table = '''| Name | Platinum Subscription |''');

		KoroneikiProductAPI._viewProduct(
			productName = "An Updated Portal Product",
			table = '''| Name                    | An Updated Portal Product |         |
	| Product Field and Value | type                      | primary |''');

		KoroneikiProductAPI._viewProduct(
			productName = "Copper Subscription",
			table = '''| Name                    | Copper Subscription |        |
	| Product Field and Value | type                | add-on |''');

		KoroneikiProductAPI._viewProduct(
			productName = "A Digital DXP Product",
			table = '''| Name | A Digital DXP Product | |''');

		KoroneikiProductAPI._viewProduct(
			productName = "Platinum Subscription",
			table = '''| Name | Platinum Subscription | |''');

		KoroneikiProductAPI._viewNoProduct(productName = "A Digital Portal Product");

		KoroneikiProductAPI._viewNoProduct(productName = "Bronze Subscription");
	}

	test Updateproducts {
		property help.center.acceptance = "true";

		KoroneikiProductAPI._createProduct(table = '''| Name | A Digital DXP Product | |''');

		OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		Provisioning.gotoProducts();

		Provisioning.searchProducts(keyword = "A");

		Provisioning.clickProduct(productName = "A Digital DXP Product");

		ProvisioningProduct.populateProductFormAndSave(table = '''| Name | Input  | A Digital Portal Product |
	| Type | Select | Primary                  |''');

		Provisioning.searchProducts(keyword = "A");

		Provisioning._viewProductViaIndex(
			productName = "A Digital Portal Product",
			table = '''| Name | A Digital Portal Product |''');

		Provisioning._viewNoProductViaIndex(productName = "A Digital DXP Product");

		KoroneikiProductAPI._viewProduct(
			productName = "A Digital Portal Product",
			table = '''| Name                    | A Digital Portal Product |         |
	| Product Field and Value | type                     | primary |''');
	}

	test Viewdeletedproduct {
		KoroneikiProductAPI._createProduct(table = '''| Name | A Digital DXP Product | |''');

		KoroneikiProductAPI._deleteProduct(productName = "A Digital DXP Product");

		OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		Provisioning.gotoProducts();

		Provisioning.searchProducts(keyword = "A");

		Provisioning._viewNoProductViaIndex(productName = "A Digital DXP Product");
	}

	test Viewproducts {
		property help.center.acceptance = "true";

		KoroneikiProductAPI._createProduct(table = '''| Name | A Digital DXP Product | |''');

		OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		Provisioning.gotoProducts();

		Provisioning.searchProducts(keyword = "A");

		Provisioning._viewProductViaIndex(
			productName = "A Digital DXP Product",
			table = '''| Name | A Digital DXP Product |''');
	}

	test Viewupdatedproduct {
		KoroneikiProductAPI._createProduct(table = '''| Name | A Digital DXP Product | |''');

		KoroneikiProductAPI.updateProduct(
			productName = "A Digital DXP Product",
			table = '''| Name | A Digital Portal Product | |''');

		OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		Provisioning.gotoProducts();

		Provisioning.searchProducts(keyword = "A");

		Provisioning._viewProductViaIndex(
			productName = "A Digital Portal Product",
			table = '''| Name | A Digital Portal Product |''');

		Provisioning._viewNoProductViaIndex(productName = "A Digital DXP Product");
	}

}