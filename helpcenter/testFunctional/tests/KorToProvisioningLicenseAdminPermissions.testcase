	| Product | DXP Production                | |''');

		LocalFile.Provisioning.gotoAccounts();

		LocalFile.Provisioning.searchAccounts(keyword = "Perlic");

		LocalFile.Provisioning.clickAccount(accountName = "Perlic - ${staticProjectName}");

		LocalFile.ProvisioningAccount.clickSubscriptionLink(productName = "DXP Production");

		LocalFile.Provisioning.clickTab(tabName = "Licenses");

		LocalFile.ProvisioningSubscription.selectLicensesViaLicensesTab(table = '''| Perlic - ${staticProjectName} License1 Name |
	| Perlic - ${staticProjectName} License2 Name |''');

		LocalFile.ProvisioningSubscription.clickLicensesActionDropdownButton(action = "Remove Complimentary");

		LocalFile.ProvisioningSubscription._viewSubscriptionLicense(
			licenseKeyword = "Perlic - ${staticProjectName} License1 Name",
			table = '''| Name          | Perlic - ${staticProjectName} License1 Name 		 |
	| Description   | Perlic - ${staticProjectName} License1 Description |
	| Product       | DXP Production                              		 |
	| Type          | Production                                  		 |
	| Details       | Host Name: localhost                        		 |
	| Details       | IP Address: 123.45.67.89                    		 |
	| Details       | MAC Address: 0A-1B-2C-3D-4E-5F              		 |
	| Status        | ACTIVE                                      		 |
	| Complimentary | false                                        		 |''');

		LocalFile.ProvisioningSubscription._viewSubscriptionLicense(
			licenseKeyword = "Perlic - ${staticProjectName} License2 Name",
			table = '''| Name          | Perlic - ${staticProjectName} License2 Name 		 |
	| Description   | Perlic - ${staticProjectName} License2 Description |
