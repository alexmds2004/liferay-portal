		LocalFile.UserAccount.updatePasswordUponLogin(userPassword = "test");

		LocalFile.Provisioning.gotoLicenses();

		LocalFile.Provisioning.clickGenerateLicenseButton();

		LocalFile.ProvisioningLicense.populateGenerateLicenseForm(table = '''| Account | Select Entity | Perlic - ${staticProjectName} | |
	| Product | Select        | DXP Production                | |
	| Version | Select        | 7.2                           | |
	| Type    | Select        | DXP Production                | |''');

		LocalFile.ProvisioningLicense.clickChooseProductPurchaseButton(positionValue = 1);

		LocalFile.ProvisioningLicense.populateGenerateLicenseForm(table = '''| Name          | Input    | Perlic - ${staticProjectName} License1 Name        | |
	| Description   | Input    | Perlic - ${staticProjectName} License1 Description | |
	| Host Name     | Input    | localhost                                          | |
	| IP Addresses  | Textarea | 123.45.67.89                                       | |
	| MAC Addresses | Textarea | 0A-1B-2C-3D-4E-5F                                  | |''');

		LocalFile.ProvisioningLicense.clickGenerateLicenseButton();

		LocalFile.ProvisioningLicense.viewLicense(table = '''| Header  | Perlic - ${staticProjectName} | |
	| Product | DXP Production                | |''');

		LocalFile.Provisioning.gotoLicenses();

		LocalFile.Provisioning.clickGenerateLicenseButton();

		LocalFile.ProvisioningLicense.populateGenerateLicenseForm(table = '''| Account | Select Entity | Perlic - ${staticProjectName} | |
	| Product | Select        | DXP Production                | |
	| Version | Select        | 7.2                           | |
	| Type    | Select        | DXP Production                | |''');

		LocalFile.ProvisioningLicense.clickChooseProductPurchaseButton(positionValue = 1);

		LocalFile.ProvisioningLicense.populateGenerateLicenseForm(table = '''| Name          | Input    | Perlic - ${staticProjectName} License2 Name        | |
	| Description   | Input    | Perlic - ${staticProjectName} License2 Description | |
	| Host Name     | Input    | localhost                                          | |
	| IP Addresses  | Textarea | 123.45.67.89                                       | |
	| MAC Addresses | Textarea | 0A-1B-2C-3D-4E-5F                                  | |''');

		LocalFile.ProvisioningLicense.clickGenerateLicenseButton();

		LocalFile.ProvisioningLicense.viewLicense(table = '''| Header  | Perlic - ${staticProjectName} | |
	| Product | DXP Production                | |''');

		LocalFile.Provisioning.gotoAccounts();

		LocalFile.Provisioning.searchAccounts(keyword = "Perlic");

		LocalFile.Provisioning.clickAccount(accountName = "Perlic - ${staticProjectName}");

		LocalFile.ProvisioningAccount.clickSubscriptionLink(productName = "DXP Production");

		LocalFile.Provisioning.clickTab(tabName = "Licenses");

		LocalFile.ProvisioningSubscription.selectLicensesViaLicensesTab(table = '''| Perlic - ${staticProjectName} License1 Name |
	| Perlic - ${staticProjectName} License2 Name |''');

		LocalFile.ProvisioningSubscription.clickLicensesActionDropdownButton(action = "Deactivate");

		LocalFile.ProvisioningAccount.clickLicenseTab(tabName = "Deactivated");

		LocalFile.ProvisioningSubscription._viewSubscriptionLicense(
			licenseKeyword = "Perlic - ${staticProjectName} License1 Name",
			table = '''| Name          | Perlic - ${staticProjectName} License1 Name 		 |
	| Description   | Perlic - ${staticProjectName} License1 Description |
	| Product       | DXP Production                              		 |
	| Type          | Production                                  		 |
	| Details       | Host Name: localhost                        		 |
	| Details       | IP Address: 123.45.67.89                    		 |
	| Details       | MAC Address: 0A-1B-2C-3D-4E-5F              		 |
	| Status        | DEACTIVATED                                 		 |
	| Complimentary | false                                       		 |''');

		LocalFile.ProvisioningSubscription._viewSubscriptionLicense(
			licenseKeyword = "Perlic - ${staticProjectName} License2 Name",
			table = '''| Name          | Perlic - ${staticProjectName} License2 Name 		 |
	| Description   | Perlic - ${staticProjectName} License2 Description |
	| Product       | DXP Production                              		 |
	| Type          | Production                                  		 |
	| Details       | Host Name: localhost                        		 |
	| Details       | IP Address: 123.45.67.89                    		 |
	| Details       | MAC Address: 0A-1B-2C-3D-4E-5F              		 |
	| Status        | DEACTIVATED                                 		 |
	| Complimentary | false                                       		 |''');

		LocalFile.ProvisioningSubscription.selectLicensesViaLicensesTab(table = '''| Perlic - ${staticProjectName} License1 Name |
	| Perlic - ${staticProjectName} License2 Name |''');

		LocalFile.ProvisioningSubscription.clickLicensesActionDropdownButton(action = "Activate");

		LocalFile.ProvisioningAccount.clickLicenseTab(tabName = "Active");

		LocalFile.ProvisioningSubscription._viewSubscriptionLicense(
			licenseKeyword = "Perlic - ${staticProjectName} License1 Name",
			table = '''| Name          | Perlic - ${staticProjectName} License1 Name 		 |
	| Description   | Perlic - ${staticProjectName} License1 Description |
	| Product       | DXP Production                              		 |
	| Type          | Production                                  		 |
	| Details       | Host Name: localhost                        		 |
	| Details       | IP Address: 123.45.67.89                    		 |
	| Details       | MAC Address: 0A-1B-2C-3D-4E-5F              		 |
	| Status        | ACTIVE                                      		 |
	| Complimentary | false                                       		 |''');

		LocalFile.ProvisioningSubscription._viewSubscriptionLicense(
			licenseKeyword = "Perlic - ${staticProjectName} License2 Name",
			table = '''| Name          | Perlic - ${staticProjectName} License2 Name 		 |
	| Description   | Perlic - ${staticProjectName} License2 Description |
	| Product       | DXP Production                              		 |
	| Type          | Production                                  		 |
	| Details       | Host Name: localhost                        		 |
	| Details       | IP Address: 123.45.67.89                    		 |
	| Details       | MAC Address: 0A-1B-2C-3D-4E-5F              		 |
	| Status        | ACTIVE                                      		 |
	| Complimentary | false                                       		 |''');

		LocalFile.ProvisioningSubscription._viewNoSubscriptionLicense(licenseKeyword = "DEACTIVATED");
	}

