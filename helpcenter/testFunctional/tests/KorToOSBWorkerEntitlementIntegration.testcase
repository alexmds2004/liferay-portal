definition {

	property testray.main.component.name = "Support QA";
	property type = "osb.integration";

	setUp {
		Passwords.getPasswords();
	}

	tearDown {
		ZendeskUserAPI._getDefaultUserId(organizationName = "Korone - ${staticProjectName}");

		KoroneikiContactAPI._tearDownContactEntitlementDefinitions(table = '''| Liferay Role    |
	| NonLiferay Role |''');

		OSBAdminProject.tearDownProjects(table = '''| KORONEKORONE |''');

		KoroneikiAccountAPI._tearDownAccounts(table = '''| Korone - ${staticProjectName} |''');

		KoroneikiAccountAPI._tearDownAccountsViaAccountFieldNameAndValue(
			fieldName = "Code",
			table = '''| KORONEKORONE |''');

		KoroneikiProductAPI._tearDownProducts(table = '''| A Liferay OSB Product |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		KoroneikiContactAPI._tearDownContacts(table = '''| osb.koroneiki1@lrcustomer.com.broken |
	| osb.koroneiki2@lrcustomer.com.broken |''');

		KoroneikiContactRoleAPI._tearDownContactRoles(table = '''| Liferay Account Role    |
	| NonLiferay Account Role |''');

		JSONUser.tearDownUsersViaSupport(table = '''| osb.koroneiki1@lrcustomer.com.broken |
	| osb.koroneiki2@lrcustomer.com.broken |''');

		JSONUser.tearDownUsersViaKoroneiki(table = '''| osb.koroneiki1@lrcustomer.com.broken |
	| osb.koroneiki2@lrcustomer.com.broken |''');

		JSONUser.tearDownUsersViaSupportOrganization(
			organizationName = "Koroneiki Liferay Role",
			table = '''| osb.koroneiki1@lrcustomer.com.broken |
	| osb.koroneiki2@lrcustomer.com.broken |''');

		JSONUser.tearDownUsersViaSupportOrganization(
			organizationName = "Koroneiki NonLiferay Role",
			table = '''| osb.koroneiki1@lrcustomer.com.broken |
	| osb.koroneiki2@lrcustomer.com.broken |''');

		JSONOrganization.tearDownOrganizationsViaSupport(table = '''| Koroneiki Liferay Role    |
	| Koroneiki NonLiferay Role |''');

		JSONOkta.tearDownUsers(table = '''| osb.koroneiki1@lrcustomer.com.broken |
	| osb.koroneiki2@lrcustomer.com.broken |''');

		ZendeskOrganizationAPI._getMultipleOrganizationExternalIdsByOrganizationNameIfStillPresent(table = '''| Korone - ${staticProjectName} |''');

		ZendeskOrganizationAPI._tearDownOrganizationsByExternalIdList(organizationExternalIds = ${staticOrganizationExternalIdList});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId});
	}

	test ResyncmultipleusersviaOSB {
		OSBAdminRabbitMQ.generateProvisioningProjectName();

		JSONOkta.createOktaUser(table = '''| Screen Name   | osb.koroneiki1                       |
	| Email Address | osb.koroneiki1@lrcustomer.com.broken |
	| First Name    | OSB                                  |
	| Last Name     | Koroneiki1                           |''');

		JSONOkta.createOktaUser(table = '''| Screen Name   | osb.koroneiki2                       |
	| Email Address | osb.koroneiki2@lrcustomer.com.broken |
	| First Name    | OSB                                  |
	| Last Name     | Koroneiki2                           |''');

		JSONUser.createViaKoroneiki(table = '''| Screen Name   | osb.koroneiki1                       |
	| Email Address | osb.koroneiki1@lrcustomer.com.broken |
	| First Name    | OSB                                  |
	| Last Name     | Koroneiki1                           |''');

		JSONUser.createViaKoroneiki(table = '''| Screen Name   | osb.koroneiki2                       |
	| Email Address | osb.koroneiki2@lrcustomer.com.broken |
	| First Name    | OSB                                  |
	| Last Name     | Koroneiki2                           |''');

		KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORONEKORONE                         | |
	| Contact Email Address | osb.koroneiki1@lrcustomer.com.broken | |
	| Description           | Test osb account on koroneiki        | |
	| Fax Number            | 555-555-1234                         | |
	| Name                  | Korone - ${staticProjectName}        | |
	| Phone Number          | 555-555-5678                         | |
	| Profile Email Address | osb.koroneiki1@lrcustomer.com.broken | |
	| Region                | United States                        | |
	| Status                | Active                               | |
	| Tier                  | T4                                   | |
	| Website               | www.koroneikicorporation.com         | |''');

		KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korone - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | true                     | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korone - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | true                     | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		JSONOSBAccount.viewSupportOrganizationSync(accountCode = "KORONEKORONE");

		KoroneikiContactAPI._createContactWithKoroneikiUuid(table = '''| Email Address | osb.koroneiki1@lrcustomer.com.broken |
	| First Name    | OSB                                  |
	| Language      | English                              |
	| Last Name     | Koroneiki1                           |''');

		KoroneikiContactAPI._createContactWithKoroneikiUuid(table = '''| Email Address | osb.koroneiki2@lrcustomer.com.broken |
	| First Name    | OSB                                  |
	| Language      | English                              |
	| Last Name     | Koroneiki2                           |''');

		KoroneikiContactRoleAPI._createContactRole(table = '''| Description | This is the Liferay role for accounts |
	| Name        | Liferay Account Role                  |
	| Type        | Account Worker                        |''');

		KoroneikiContactRoleAPI._createContactRole(table = '''| Description | This is the NonLiferay role for accounts |
	| Name        | NonLiferay Account Role                  |
	| Type        | Account Worker                           |''');

		KoroneikiAccountAPI._assignWorkerContacts(
			accountName = "Korone - ${staticProjectName}",
			table = '''| osb.koroneiki1@lrcustomer.com.broken |
	| osb.koroneiki2@lrcustomer.com.broken |''');

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Korone - ${staticProjectName}",
			contactEmailAddress = "osb.koroneiki1@lrcustomer.com.broken",
			table = '''| Liferay Account Role |''');

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Korone - ${staticProjectName}",
			contactEmailAddress = "osb.koroneiki2@lrcustomer.com.broken",
			table = '''| Liferay Account Role |''');

		KoroneikiProductAPI._createProduct(table = '''| Name | A Liferay OSB Product | |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korone - ${staticProjectName}",
			productName = "A Liferay OSB Product",
			table = '''| End Date                | ${staticEndDate}   |                |
	| Perpetual               | true               |                |
	| Product Field and Value | additionalProp1    | propertyValue1 |
	| Product Field and Value | additionalProp2    | propertyValue2 |
	| Product Field and Value | additionalProp3    | propertyValue3 |
	| Quantity                | 1                  |                |
	| Start Date              | ${staticStartDate} |                |''');

		KoroneikiContactAPI._createContactEntitlementDefinition(
			contactRoleName = "Liferay Account Role",
			contactRoleType = "Account Worker",
			productName = "A Liferay OSB Product",
			table = '''| Description | Liferay Role Entitlement |
	| Name        | Liferay Role             |
	| Status      | Approved                 |''');

		JSONOrganization.createViaSupport(organizationName = "Koroneiki Liferay Role");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Liferay Role");

		JSONOrganization.viewSupportOrganizationMemberSync(
			organizationName = "Koroneiki Liferay Role",
			userEmailAddress = "osb.koroneiki1@lrcustomer.com.broken");

		JSONOrganization.viewSupportOrganizationMemberSync(
			organizationName = "Koroneiki Liferay Role",
			userEmailAddress = "osb.koroneiki1@lrcustomer.com.broken");

		JSONUser.deleteSupportUser(userEmailAddress = "osb.koroneiki1@lrcustomer.com.broken");

		JSONUser.deleteSupportUser(userEmailAddress = "osb.koroneiki2@lrcustomer.com.broken");

		OSBAdmin.loginToSupport(
			userEmailAddress = ${staticSupportAdminEmailAdress},
			userPassword = ${staticSupportAdminPassword});

		OSBAdmin.gotoOSBAdmin();

		OSBAdminEntitlements.resyncEntitlements(entitlementName = "Koroneiki Liferay Role");

		JSONOrganization.viewSupportOrganizationMemberSync(
			organizationName = "Koroneiki Liferay Role",
			userEmailAddress = "osb.koroneiki1@lrcustomer.com.broken");

		JSONOrganization.viewSupportOrganizationMemberSync(
			organizationName = "Koroneiki Liferay Role",
			userEmailAddress = "osb.koroneiki2@lrcustomer.com.broken");
	}

	test ResyncseparateusersandorganizationsviaKoroneiki {
		OSBAdminRabbitMQ.generateProvisioningProjectName();

		JSONOkta.createOktaUser(table = '''| Screen Name   | osb.koroneiki1                       |
	| Email Address | osb.koroneiki1@lrcustomer.com.broken |
	| First Name    | OSB                                  |
	| Last Name     | Koroneiki1                           |''');

		JSONOkta.createOktaUser(table = '''| Screen Name   | osb.koroneiki2                       |
	| Email Address | osb.koroneiki2@lrcustomer.com.broken |
	| First Name    | OSB                                  |
	| Last Name     | Koroneiki2                           |''');

		JSONUser.createViaKoroneiki(table = '''| Screen Name   | osb.koroneiki1                       |
	| Email Address | osb.koroneiki1@lrcustomer.com.broken |
	| First Name    | OSB                                  |
	| Last Name     | Koroneiki1                           |''');

		JSONUser.createViaKoroneiki(table = '''| Screen Name   | osb.koroneiki2                       |
	| Email Address | osb.koroneiki2@lrcustomer.com.broken |
	| First Name    | OSB                                  |
	| Last Name     | Koroneiki2                           |''');

		KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORONEKORONE                         | |
	| Contact Email Address | osb.koroneiki1@lrcustomer.com.broken | |
	| Description           | Test osb account on koroneiki        | |
	| Fax Number            | 555-555-1234                         | |
	| Name                  | Korone - ${staticProjectName}        | |
	| Phone Number          | 555-555-5678                         | |
	| Profile Email Address | osb.koroneiki1@lrcustomer.com.broken | |
	| Region                | United States                        | |
	| Status                | Active                               | |
	| Tier                  | T4                                   | |
	| Website               | www.koroneikicorporation.com         | |''');

		KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korone - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | true                     | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korone - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | true                     | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		JSONOSBAccount.viewSupportOrganizationSync(accountCode = "KORONEKORONE");

		KoroneikiContactAPI._createContactWithKoroneikiUuid(table = '''| Email Address | osb.koroneiki1@lrcustomer.com.broken |
	| First Name    | OSB                                  |
	| Language      | English                              |
	| Last Name     | Koroneiki1                           |''');

		KoroneikiContactAPI._createContactWithKoroneikiUuid(table = '''| Email Address | osb.koroneiki2@lrcustomer.com.broken |
	| First Name    | OSB                                  |
	| Language      | English                              |
	| Last Name     | Koroneiki2                           |''');

		KoroneikiContactRoleAPI._createContactRole(table = '''| Description | This is the Liferay role for accounts |
	| Name        | Liferay Account Role                  |
	| Type        | Account Worker                        |''');

		KoroneikiContactRoleAPI._createContactRole(table = '''| Description | This is the NonLiferay role for accounts |
	| Name        | NonLiferay Account Role                  |
	| Type        | Account Worker                           |''');

		KoroneikiAccountAPI._assignWorkerContacts(
			accountName = "Korone - ${staticProjectName}",
			table = '''| osb.koroneiki1@lrcustomer.com.broken |
	| osb.koroneiki2@lrcustomer.com.broken |''');

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Korone - ${staticProjectName}",
			contactEmailAddress = "osb.koroneiki1@lrcustomer.com.broken",
			table = '''| Liferay Account Role |''');

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Korone - ${staticProjectName}",
			contactEmailAddress = "osb.koroneiki2@lrcustomer.com.broken",
			table = '''| NonLiferay Account Role |''');

		KoroneikiProductAPI._createProduct(table = '''| Name | A Liferay OSB Product | |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korone - ${staticProjectName}",
			productName = "A Liferay OSB Product",
			table = '''| End Date                | ${staticEndDate}   |                |
	| Perpetual               | true               |                |
	| Product Field and Value | additionalProp1    | propertyValue1 |
	| Product Field and Value | additionalProp2    | propertyValue2 |
	| Product Field and Value | additionalProp3    | propertyValue3 |
	| Quantity                | 1                  |                |
	| Start Date              | ${staticStartDate} |                |''');

		KoroneikiContactAPI._createContactEntitlementDefinition(
			contactRoleName = "Liferay Account Role",
			contactRoleType = "Account Worker",
			productName = "A Liferay OSB Product",
			table = '''| Description | Liferay Role Entitlement |
	| Name        | Liferay Role             |
	| Status      | Approved                 |''');

		KoroneikiContactAPI._createContactEntitlementDefinition(
			contactRoleName = "NonLiferay Account Role",
			contactRoleType = "Account Worker",
			productName = "A Liferay OSB Product",
			table = '''| Description | NonLiferay Role Entitlement |
	| Name        | NonLiferay Role             |
	| Status      | Approved                    |''');

		JSONOrganization.createViaSupport(organizationName = "Koroneiki Liferay Role");

		JSONOrganization.createViaSupport(organizationName = "Koroneiki NonLiferay Role");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Liferay Role");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "NonLiferay Role");

		JSONOrganization.viewSupportOrganizationMemberSync(
			organizationName = "Koroneiki Liferay Role",
			userEmailAddress = "osb.koroneiki1@lrcustomer.com.broken");

		JSONOrganization.viewSupportOrganizationMemberSync(
			organizationName = "Koroneiki NonLiferay Role",
			userEmailAddress = "osb.koroneiki2@lrcustomer.com.broken");

		JSONUser.deleteSupportUser(userEmailAddress = "osb.koroneiki1@lrcustomer.com.broken");

		JSONUser.deleteSupportUser(userEmailAddress = "osb.koroneiki2@lrcustomer.com.broken");

		OSBAdmin.loginToSupport(
			userEmailAddress = ${staticSupportAdminEmailAdress},
			userPassword = ${staticSupportAdminPassword});

		OSBAdmin.gotoOSBAdmin();

		OSBAdminEntitlements.resyncEntitlements(entitlementName = "Koroneiki Liferay Role");

		OSBAdminEntitlements.resyncEntitlements(entitlementName = "Koroneiki NonLiferay Role");

		JSONOrganization.viewSupportOrganizationMemberSync(
			organizationName = "Koroneiki Liferay Role",
			userEmailAddress = "osb.koroneiki1@lrcustomer.com.broken");

		JSONOrganization.viewNoSupportOrganizationMemberSync(
			organizationName = "Koroneiki Liferay Role",
			userEmailAddress = "osb.koroneiki2@lrcustomer.com.broken");

		JSONOrganization.viewNoSupportOrganizationMemberSync(
			organizationName = "Koroneiki NonLiferay Role",
			userEmailAddress = "osb.koroneiki1@lrcustomer.com.broken");

		JSONOrganization.viewSupportOrganizationMemberSync(
			organizationName = "Koroneiki NonLiferay Role",
			userEmailAddress = "osb.koroneiki2@lrcustomer.com.broken");
	}

	test ResyncuserandorganizationviaOSB {
		OSBAdminRabbitMQ.generateProvisioningProjectName();

		JSONOkta.createOktaUser(table = '''| Screen Name   | osb.koroneiki1                       |
	| Email Address | osb.koroneiki1@lrcustomer.com.broken |
	| First Name    | OSB                                  |
	| Last Name     | Koroneiki1                           |''');

		JSONOkta.createOktaUser(table = '''| Screen Name   | osb.koroneiki2                       |
	| Email Address | osb.koroneiki2@lrcustomer.com.broken |
	| First Name    | OSB                                  |
	| Last Name     | Koroneiki2                           |''');

		JSONUser.createViaKoroneiki(table = '''| Screen Name   | osb.koroneiki1                       |
	| Email Address | osb.koroneiki1@lrcustomer.com.broken |
	| First Name    | OSB                                  |
	| Last Name     | Koroneiki1                           |''');

		JSONUser.createViaKoroneiki(table = '''| Screen Name   | osb.koroneiki2                       |
	| Email Address | osb.koroneiki2@lrcustomer.com.broken |
	| First Name    | OSB                                  |
	| Last Name     | Koroneiki2                           |''');

		KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORONEKORONE                         | |
	| Contact Email Address | osb.koroneiki1@lrcustomer.com.broken | |
	| Description           | Test osb account on koroneiki        | |
	| Fax Number            | 555-555-1234                         | |
	| Name                  | Korone - ${staticProjectName}        | |
	| Phone Number          | 555-555-5678                         | |
	| Profile Email Address | osb.koroneiki1@lrcustomer.com.broken | |
	| Region                | United States                        | |
	| Status                | Active                               | |
	| Tier                  | T4                                   | |
	| Website               | www.koroneikicorporation.com         | |''');

		KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korone - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | true                     | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korone - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | true                     | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		JSONOSBAccount.viewSupportOrganizationSync(accountCode = "KORONEKORONE");

		KoroneikiContactAPI._createContactWithKoroneikiUuid(table = '''| Email Address | osb.koroneiki1@lrcustomer.com.broken |
	| First Name    | OSB                                  |
	| Language      | English                              |
	| Last Name     | Koroneiki1                           |''');

		KoroneikiContactAPI._createContactWithKoroneikiUuid(table = '''| Email Address | osb.koroneiki2@lrcustomer.com.broken |
	| First Name    | OSB                                  |
	| Language      | English                              |
	| Last Name     | Koroneiki2                           |''');

		KoroneikiContactRoleAPI._createContactRole(table = '''| Description | This is the Liferay role for accounts |
	| Name        | Liferay Account Role                  |
	| Type        | Account Worker                        |''');

		KoroneikiContactRoleAPI._createContactRole(table = '''| Description | This is the NonLiferay role for accounts |
	| Name        | NonLiferay Account Role                  |
	| Type        | Account Worker                           |''');

		KoroneikiAccountAPI._assignWorkerContacts(
			accountName = "Korone - ${staticProjectName}",
			table = '''| osb.koroneiki1@lrcustomer.com.broken |''');

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Korone - ${staticProjectName}",
			contactEmailAddress = "osb.koroneiki1@lrcustomer.com.broken",
			table = '''| Liferay Account Role |''');

		KoroneikiProductAPI._createProduct(table = '''| Name | A Liferay OSB Product | |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korone - ${staticProjectName}",
			productName = "A Liferay OSB Product",
			table = '''| End Date                | ${staticEndDate}   |                |
	| Perpetual               | true               |                |
	| Product Field and Value | additionalProp1    | propertyValue1 |
	| Product Field and Value | additionalProp2    | propertyValue2 |
	| Product Field and Value | additionalProp3    | propertyValue3 |
	| Quantity                | 1                  |                |
	| Start Date              | ${staticStartDate} |                |''');

		KoroneikiContactAPI._createContactEntitlementDefinition(
			contactRoleName = "Liferay Account Role",
			contactRoleType = "Account Worker",
			productName = "A Liferay OSB Product",
			table = '''| Description | Liferay Role Entitlement |
	| Name        | Liferay Role             |
	| Status      | Approved                 |''');

		JSONOrganization.createViaSupport(organizationName = "Koroneiki Liferay Role");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Liferay Role");

		JSONOrganization.viewSupportOrganizationMemberSync(
			organizationName = "Koroneiki Liferay Role",
			userEmailAddress = "osb.koroneiki1@lrcustomer.com.broken");

		JSONUser.deleteSupportUser(userEmailAddress = "osb.koroneiki1@lrcustomer.com.broken");

		OSBAdmin.loginToSupport(
			userEmailAddress = ${staticSupportAdminEmailAdress},
			userPassword = ${staticSupportAdminPassword});

		OSBAdmin.gotoOSBAdmin();

		OSBAdminEntitlements.resyncEntitlements(entitlementName = "Koroneiki Liferay Role");

		JSONOrganization.viewSupportOrganizationMemberSync(
			organizationName = "Koroneiki Liferay Role",
			userEmailAddress = "osb.koroneiki1@lrcustomer.com.broken");

		JSONOrganization.viewNoSupportOrganizationMemberSync(
			organizationName = "Koroneiki Liferay Role",
			userEmailAddress = "osb.koroneiki2@lrcustomer.com.broken");
	}

	test SyncmultipleusersviaKoroneiki {
		OSBAdminRabbitMQ.generateProvisioningProjectName();

		JSONOkta.createOktaUser(table = '''| Screen Name   | osb.koroneiki1                       |
	| Email Address | osb.koroneiki1@lrcustomer.com.broken |
	| First Name    | OSB                                  |
	| Last Name     | Koroneiki1                           |''');

		JSONOkta.createOktaUser(table = '''| Screen Name   | osb.koroneiki2                       |
	| Email Address | osb.koroneiki2@lrcustomer.com.broken |
	| First Name    | OSB                                  |
	| Last Name     | Koroneiki2                           |''');

		JSONUser.createViaKoroneiki(table = '''| Screen Name   | osb.koroneiki1                       |
	| Email Address | osb.koroneiki1@lrcustomer.com.broken |
	| First Name    | OSB                                  |
	| Last Name     | Koroneiki1                           |''');

		JSONUser.createViaKoroneiki(table = '''| Screen Name   | osb.koroneiki2                       |
	| Email Address | osb.koroneiki2@lrcustomer.com.broken |
