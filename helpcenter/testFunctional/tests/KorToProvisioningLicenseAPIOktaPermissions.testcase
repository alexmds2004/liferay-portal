definition {

	property testray.main.component.name = "Support QA";
	property type = "provisioning.security";

	setUp {
		LocalFile.Passwords.getPasswords();

		LocalFile.OSBAdminRabbitMQ.generateStaticVariables();

		LocalFile.OSBAdminRabbitMQ.generateProvisioningCompanyName();

		LocalFile.OSBAdminRabbitMQ.generateProvisioningProjectName();

		LocalFile.JSONOkta.createOktaUser(table = '''| Screen Name   | pro.okta1                       |
	| Email Address | pro.okta1@lrcustomer.com.broken |
	| First Name    | PRO                             |
	| Last Name     | Okta1                           |''');

		LocalFile.JSONOkta.createOktaUser(table = '''| Screen Name   | pro.okta2                       |
	| Email Address | pro.okta2@lrcustomer.com.broken |
	| First Name    | PRO                             |
	| Last Name     | Okta2                           |''');

		LocalFile.JSONOkta.createOktaUser(table = '''| Screen Name   | pro.okta3                      |
	| Email Address | pro.okta3@lrpartner.com.broken |
	| First Name    | PRO                            |
	| Last Name     | Okta3                          |''');

		LocalFile.JSONOkta.createOktaUser(table = '''| Screen Name   | pro.okta4                       |
	| Email Address | pro.okta4@lrcustomer.com.broken |
	| First Name    | PRO                             |
	| Last Name     | Okta4                           |''');
	}

	tearDown {
		LocalFile.ZendeskUserAPI._getDefaultUserId(organizationName = "Permis - ${staticProjectName}");

		LocalFile.ZendeskUserAPI._renameFirstDefaultUserIdVariable();

		LocalFile.ZendeskUserAPI._getDefaultUserId(organizationName = "Misper - ${staticCompanyName}");

		LocalFile.ZendeskUserAPI._renameSecondDefaultUserIdVariable();

		LocalFile.ZendeskUserAPI._getDefaultUserId(organizationName = "Perpar - ${staticCompanyName}");

		LocalFile.ZendeskUserAPI._renameThirdDefaultUserIdVariable();

		LocalFile.ZendeskUserAPI._getDefaultUserId(organizationName = "Kormis - ${staticCompanyName}");

		LocalFile.ZendeskUserAPI._renameThirdDefaultUserIdVariable();

		LocalFile.KoroneikiProductConsumptionAPI._tearDownProductConsumptionList(
			accountName = "Permis - ${staticProjectName}",
			table = '''| DXP Production    |
	| Portal Production |''');

		LocalFile.KoroneikiProductConsumptionAPI._tearDownProductConsumptionList(
			accountName = "Kormis - ${staticProjectName}",
			table = '''| DXP Production    |
	| Portal Production |''');

		LocalFile.KoroneikiProductConsumptionAPI._tearDownProductConsumptions(
			accountName = "Permis - ${staticProjectName}",
			table = '''| DXP Production    |
	| Portal Production |''');

		LocalFile.KoroneikiProductConsumptionAPI._tearDownProductConsumptions(
			accountName = "Kormis - ${staticProjectName}",
			table = '''| DXP Production    |
	| Portal Production |''');

		LocalFile.ZendeskUserAPI._getDefaultUserId(organizationName = "Permis - ${staticProjectName}");

		LocalFile.KoroneikiProductConsumptionAPI._tearDownProductConsumptionList(
			accountName = "Permis - ${staticProjectName}",
			table = '''| DXP Production    |
	| Portal Production |''');

		LocalFile.ZendeskUserAPI._getDefaultUserId(organizationName = "Kormis - ${staticProjectName}");

		LocalFile.KoroneikiProductConsumptionAPI._tearDownProductConsumptionList(
			accountName = "Kormis - ${staticProjectName}",
			table = '''| DXP Production    |
	| Portal Production |''');

		LocalFile.OSBAdminProject.tearDownProjects(table = '''| MISPERPERMIS |
	| MISKORKORMIS |
	| MISPER       |
	| PERPAR       |''');

		LocalFile.KoroneikiAccountAPI._tearDownAccounts(table = '''| Permis - ${staticProjectName} |
	| Misper - ${staticCompanyName} |
	| Perpar - ${staticCompanyName} |
	| Kormis - ${staticCompanyName} |''');

		LocalFile.KoroneikiAccountAPI._tearDownAccountsViaAccountFieldNameAndValue(
			fieldName = "Code",
			table = '''| MISPERPERMIS |
	| MISKORKORMIS |
	| MISPER       |
	| PERPAR       |''');

		LocalFile.JSONUser.tearDownUsers(table = '''| pro.okta1@lrcustomer.com.broken |
	| pro.okta2@lrcustomer.com.broken |
	| pro.okta3@lrpartner.com.broken  |
	| pro.okta4@lrcustomer.com.broken |
	| ${staticEmailValue}             |''');

		LocalFile.JSONUser.tearDownUsersViaSupport(table = '''| pro.okta1@lrcustomer.com.broken |
	| pro.okta2@lrcustomer.com.broken |
	| pro.okta3@lrpartner.com.broken  |
	| pro.okta4@lrcustomer.com.broken |
	| ${staticEmailValue}             |''');

		LocalFile.JSONUser.tearDownUsersViaKoroneiki(table = '''| pro.okta1@lrcustomer.com.broken |
	| pro.okta2@lrcustomer.com.broken |
	| pro.okta3@lrpartner.com.broken  |
	| pro.okta4@lrcustomer.com.broken |
	| ${staticEmailValue}             |''');

		LocalFile.KoroneikiContactAPI._tearDownContacts(table = '''| pro.okta1@lrcustomer.com.broken |
	| pro.okta2@lrcustomer.com.broken |
	| pro.okta3@lrpartner.com.broken  |
	| pro.okta4@lrcustomer.com.broken |
	| ${staticEmailValue}             |''');

		LocalFile.JSONOkta.tearDownUsers(table = '''| pro.okta1@lrcustomer.com.broken |
	| pro.okta2@lrcustomer.com.broken |
	| pro.okta3@lrpartner.com.broken  |
	| pro.okta4@lrcustomer.com.broken |
	| ${staticEmailValue}             |''');

		LocalFile.ZendeskTicketAPI._tearDownTicketsByKeywords(table = '''| New Subscription(s) for Permis - ${staticProjectName} |
	| New Subscription(s) for Misper - ${staticCompanyName} |
	| New Subscription(s) for Perpar - ${staticCompanyName} |
	| New Subscription(s) for Kormis - ${staticCompanyName} |''');

		LocalFile.ZendeskUserAPI._getMultipleUserIdsByEmailAddress(table = '''| pro.okta1@lrcustomer.com.broken |
	| pro.okta2@lrcustomer.com.broken |
	| pro.okta3@lrpartner.com.broken  |
	| pro.okta4@lrcustomer.com.broken |
	| ${staticEmailValue}             |''');

		LocalFile.ZendeskUserAPI._tearDownUsersByIdList(userIds = ${staticUserIdList});

		LocalFile.ZendeskOrganizationAPI._getMultipleOrganizationExternalIdsByOrganizationNameIfStillPresent(table = '''| Permis - ${staticProjectName} |
	| Misper - ${staticCompanyName} |
	| Perpar - ${staticCompanyName} |
	| Kormis - ${staticCompanyName} |''');

		LocalFile.ZendeskOrganizationAPI._tearDownOrganizationsByExternalIdList(organizationExternalIds = ${staticOrganizationExternalIdList});

		LocalFile.ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId1});

		LocalFile.ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId2});

		LocalFile.ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId3});
	}

	test AttemptdeveloperDXPlicensedownloadwithProvisioningAPIandoktaauthenticationforanaccountwithselfprovisioningdisabled {
		LocalFile.OSBAdminRabbitMQ.generateProvisioningProjectName();

		LocalFile.KoroneikiAccountAPI._createAccount(table = '''| Code                  | MISPERPERMIS                         | |
	| Contact Email Address | lic.koroneiki1@lrcustomer.com.broken | |
	| Description           | Test osb account on koroneiki        | |
	| Fax Number            | 555-555-1234                         | |
	| Name                  | Permis - ${staticProjectName}        | |
	| Phone Number          | 555-555-5678                         | |
	| Profile Email Address | lic.koroneiki1@lrcustomer.com.broken | |
	| Region                | United States                        | |
	| Status                | Active                               | |
	| Tier                  | T4                                   | |
	| Website               | www.koroneikicorporation.com         | |''');

		LocalFile.KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Permis - ${staticProjectName}",
			contactEmailAddress = "pro.okta1@lrcustomer.com.broken",
			table = '''| Support Administrator |''');

		LocalFile.Okta._loginToDevDomain(
			userEmailAddress = "pro.okta1@lrcustomer.com.broken",
			userPassword = ${staticOktaUserPassword});

		LocalFile.Okta._getOktaSessionIdDevPage();

		LocalFile.KoroneikiAccountAPI._generateAccountKey(accountName = "Permis - ${staticProjectName}");

		LocalFile.KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		LocalFile.KoroneikiProductPurchaseAPI.generateStaticFullStartAndEndDate();

		LocalFile.KoroneikiProductPurchaseAPI.generateStaticFutureStartAndEndDate();

		LocalFile.KoroneikiProductPurchaseAPI.generateStaticFullFutureStartAndEndDate();

		LocalFile.KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Permis - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| End Date                | ${staticEndDate}         |   |
	| Original End Date       | ${staticOriginalEndDate} |   |
	| Perpetual               | false                    |   |
	| Product Field and Value | sizing                   | 1 |
	| Product Field and Value | licenses                 | 1 |
	| Product Field and Value | version                  | 7 |
	| Quantity                | 1                        |   |
	| Start Date              | ${staticStartDate}       |   |
	| Status                  | Approved                 |   |''');

		LocalFile.KoroneikiProductPurchaseAPI._generateProductPurchaseId(
			accountName = "Permis - ${staticProjectName}",
			productName = "DXP Production");

		LocalFile.KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Permis - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		LocalFile.OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		LocalFile.Provisioning.gotoAccounts();

		LocalFile.Provisioning.searchAccounts(keyword = "Permis");

		LocalFile.Provisioning.clickAccount(accountName = "Permis - ${staticProjectName}");

		LocalFile.Provisioning.clickTab(tabName = "Licenses");

		LocalFile.ProvisioningAccount.clickGenerateLicenseButton();

		LocalFile.ProvisioningLicense.populateGenerateLicenseForm(table = '''| Product | Select | DXP Production                | |
	| Version | Select | 7.2                           | |
	| Type    | Select | DXP Production                | |''');

		LocalFile.ProvisioningLicense.clickChooseProductPurchaseButton(positionValue = 1);

		LocalFile.ProvisioningLicense.populateGenerateLicenseForm(table = '''| Host Name     | Input    | localhost         | |
	| IP Addresses  | Textarea | 123.45.67.89      | |
	| MAC Addresses | Textarea | 0A-1B-2C-3D-4E-5F | |''');

		LocalFile.ProvisioningLicense.clickGenerateLicenseButton();

		LocalFile.ProvisioningLicense.viewLicense(table = '''| Header  | Permis - ${staticProjectName} | |
	| Product | DXP Production                | |''');

		LocalFile.Provisioning.gotoLicenses();

		LocalFile.Provisioning.searchLicenses(keyword = ${staticAccountKey});

		LocalFile.Provisioning._viewLicenseViaIndex(
			licenseKeyword = "Permis - ${staticProjectName}",
			table = '''| Name          | Permis - ${staticProjectName}  |
	| Description   | Permis - ${staticProjectName}  |
	| Account       | Permis - ${staticProjectName}  |
	| Product       | DXP Production                 |
	| Type          | Production                     |
	| Details       | Host Name: localhost           |
	| Details       | IP Address: 123.45.67.89       |
	| Details       | MAC Address: 0A-1B-2C-3D-4E-5F |
	| Status        | ACTIVE                         |
	| Complimentary | false                          |''');

		LocalFile.Provisioning.clickLicense(licenseKeyword = "Permis - ${staticProjectName}");

		LocalFile.ProvisioningLicense.viewLicense(table = '''| Header        | Permis - ${staticProjectName} | |
	| Product       | DXP Production                | |
	| Version       | 7.2                           | |
	| Type          | Production                    | |
	| Host Name     | localhost                     | |
	| IP Addresses  | 123.45.67.89                  | |
	| MAC Addresses | 0A-1B-2C-3D-4E-5F             | |
	| Owner         | Permis - ${staticProjectName} | |
	| Description   | Permis - ${staticProjectName} | |
	| Complimentary | No                            | |
	| Status        | ACTIVE                        | |
	| Created By    | Test Test                     | |''');

		LocalFile.Provisioning.gotoAccounts();

		LocalFile.Provisioning.searchAccounts(keyword = "Permis");

		LocalFile.Provisioning.clickAccount(accountName = "Permis - ${staticProjectName}");

		LocalFile.Provisioning.clickTab(tabName = "Details");

		LocalFile.ProvisioningAccount.editAccountDetails(table = '''| Self Provisioning | Toggle Switch | false | |''');

		LocalFile.ProvisioningAccount.assertToggleSwitchDisabled(
			field = "Self Provisioning",
			positionValue = 1);

		LocalFile.ProvisioningLicenseAPI._downloadNoDeveloperLicenseSessionId(
			accountName = "Permis - ${staticProjectName}",
			productGroup = "DXP",
			productVersion = "7.2");
	}

	test AttempttogeneratealicensewithProvisioningAPIandoktaauthenticationusinganonpermissionedemployee {
		LocalFile.OSBAdminRabbitMQ.publishCreateProjectWithNoPartnerMessage(
			routingKey = "dossiera.provisioning.create",
			table = '''| Account Name                           | Misper - ${staticCompanyName}              |
	| Address City                           | Diamond Bar                                |
	| Address Country                        | United States                              |
	| Address Postal Code                    | 91765                                      |
	| Address Region                         | California                                 |
	| Address Street                         | 456 Fake Street                            |
	| Contact Email Address                  | pro.okta2@lrcustomer.com.broken            |
	| Contact First Name                     | PRO                                        |
	| Contact Last Name                      | Okta1                                      |
	| Dossiera Account Key                   | ${staticDossieraAccountKey}                |
	| Dossiera Address Key 1                 | ${staticDossieraAddressKey1}               |
	| Dossiera Address Key 2                 | ${staticDossieraAddressKey2}               |
	| Dossiera Contact Key                   | ${staticDossieraContactKey}                |
	| Dossiera Project Key                   | ${staticDossieraProjectKey}                |
	| End Day                                | ${staticEndDay}                            |
	| End Month                              | ${staticEndMonth}                          |
	| End Year                               | ${staticEndYear}                           |
	| Industry                               | Automotive                                 |
	| Owner Email Address                    | pro.okta2@lrcustomer.com.broken            |
	| Owner First Name                       | PRO                                        |
	| Owner Last Name                        | Okta2                                      |
	| Partner First Line Support             | false                                      |
	| Product Type                           | New                                        |
	| Product Name                           | Liferay Digital Enterprise - Prod Sizing 4 |
	| Project Name                           | Permis - ${staticProjectName}              |
	| Renewal                                | false                                      |
	| Salesforce Opportunity Key             | ${staticSalesforceOpportunityKey}          |
	| Salesforce Opportunity Line Item Key 1 | ${staticSalesforceOpportunityLineItemKey1} |
	| Salesforce Opportunity Line Item Key 2 | ${staticSalesforceOpportunityLineItemKey2} |
	| Salesforce Opportunity Sold By         | Liferay US                                 |
	| Salesforce Opportunity Stage Name      | Closed Won                                 |
	| Salesforce Opportunity Territory       | United States                              |
	| Salesforce Opportunity Type            | New Business                               |
	| Salesforce Owner User Key              | ${staticSalesforceOwnerUserKey}            |
	| Salesforce Project Key                 | ${staticSalesforceProjectKey}              |
	| Start Day                              | ${staticStartDay}                          |
	| Start Month                            | ${staticStartMonth}                        |
	| Start Year                             | ${staticStartYear}                         |
	| Subscription Level                     | Platinum                                   |
	| Version Number                         | 7.1                                        |''');

		LocalFile.Data.generateSupportUser();

		LocalFile.JSONOkta.createOktaUser(table = '''| Screen Name   | ${staticScreenNameValue}       |
	| Email Address | ${staticEmailValue}            |
	| First Name    | ${staticContactFirstNameValue} |
	| Last Name     | ${staticContactLastNameValue}  |
	| Group         | Employees                      |''');

		LocalFile.KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		LocalFile.KoroneikiProductPurchaseAPI._generateProductPurchaseKey(
			accountName = "Permis - ${staticProjectName}",
			productName = "DXP Production");

		LocalFile.Okta._loginToDevDomain(
			userEmailAddress = ${staticEmailValue},
			userPassword = ${staticOktaUserPassword});

		LocalFile.Okta._getOktaSessionIdDevPage();

		LocalFile.OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		LocalFile.ProvisioningLicenseAPI.createNoLicenseViaSessionId(
			accountName = "Permis - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| Active                     | true                            |
	| Expiration Date            | ${staticEndDate}                |
	| License Entry Type         | production                      |
	| Max Cluster Nodes          | 0                               |
	| Name                       | Permis - ${staticProjectName}   |
	| Product Version            | 7.4                             |
	| Start Date                 | ${staticStartDate}              |''');

		LocalFile.Provisioning.gotoLicenses();

		LocalFile.Provisioning.expandLicenseAdvancedSearchForm();

		LocalFile.Provisioning.populateAdvancedSearchFormAndSearch(table = '''| Account Name | | Input | Permis - ${staticProjectName} |''');

		LocalFile.Provisioning._viewNoLicenseViaIndex(licenseKeyword = "Permis - ${staticProjectName}");
	}

	test AttempttogeneratealicensewithProvisioningAPIandoktaauthenticationusinganonpermissionedSupportRequesteruser {
		LocalFile.OSBAdminRabbitMQ.publishCreateProjectWithNoPartnerMessage(
			routingKey = "dossiera.provisioning.create",
			table = '''| Account Name                           | Misper - ${staticCompanyName}              |
	| Address City                           | Diamond Bar                                |
	| Address Country                        | United States                              |
	| Address Postal Code                    | 91765                                      |
	| Address Region                         | California                                 |
	| Address Street                         | 456 Fake Street                            |
	| Contact Email Address                  | pro.okta1@lrcustomer.com.broken            |
	| Contact First Name                     | PRO                                        |
	| Contact Last Name                      | Okta1                                      |
	| Dossiera Account Key                   | ${staticDossieraAccountKey}                |
	| Dossiera Address Key 1                 | ${staticDossieraAddressKey1}               |
	| Dossiera Address Key 2                 | ${staticDossieraAddressKey2}               |
	| Dossiera Contact Key                   | ${staticDossieraContactKey}                |
	| Dossiera Project Key                   | ${staticDossieraProjectKey}                |
	| End Day                                | ${staticEndDay}                            |
	| End Month                              | ${staticEndMonth}                          |
	| End Year                               | ${staticEndYear}                           |
	| Industry                               | Automotive                                 |
	| Owner Email Address                    | pro.okta2@lrcustomer.com.broken            |
	| Owner First Name                       | PRO                                        |
	| Owner Last Name                        | Okta2                                      |
	| Partner First Line Support             | false                                      |
	| Product Type                           | New                                        |
	| Product Name                           | Liferay Digital Enterprise - Prod Sizing 4 |
	| Project Name                           | Permis - ${staticProjectName}              |
	| Renewal                                | false                                      |
	| Salesforce Opportunity Key             | ${staticSalesforceOpportunityKey}          |
	| Salesforce Opportunity Line Item Key 1 | ${staticSalesforceOpportunityLineItemKey1} |
	| Salesforce Opportunity Line Item Key 2 | ${staticSalesforceOpportunityLineItemKey2} |
	| Salesforce Opportunity Sold By         | Liferay US                                 |
	| Salesforce Opportunity Stage Name      | Closed Won                                 |
	| Salesforce Opportunity Territory       | United States                              |
	| Salesforce Opportunity Type            | New Business                               |
	| Salesforce Owner User Key              | ${staticSalesforceOwnerUserKey}            |
	| Salesforce Project Key                 | ${staticSalesforceProjectKey}              |
	| Start Day                              | ${staticStartDay}                          |
	| Start Month                            | ${staticStartMonth}                        |
	| Start Year                             | ${staticStartYear}                         |
	| Subscription Level                     | Platinum                                   |
	| Version Number                         | 7.1                                        |''');

		LocalFile.KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		LocalFile.KoroneikiProductPurchaseAPI._generateProductPurchaseKey(
			accountName = "Permis - ${staticProjectName}",
			productName = "DXP Production");

		LocalFile.KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Permis - ${staticProjectName}",
			contactEmailAddress = "pro.okta1@lrcustomer.com.broken",
			table = '''| Support Requester |''');

		LocalFile.KoroneikiAccountAPI._removeContactRolesFromContact(
			accountName = "Permis - ${staticProjectName}",
			contactEmailAddress = "pro.okta1@lrcustomer.com.broken",
			table = '''| Support Administrator |''');

		LocalFile.Okta._loginToDevDomain(
			userEmailAddress = "pro.okta1@lrcustomer.com.broken",
			userPassword = ${staticOktaUserPassword});

		LocalFile.Okta._getOktaSessionIdDevPage();

		LocalFile.OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		LocalFile.ProvisioningLicenseAPI.createNoLicenseViaSessionId(
			accountName = "Permis - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| Active                     | true                            |
	| Expiration Date            | ${staticEndDate}                |
	| License Entry Type         | production                      |
	| Max Cluster Nodes          | 0                               |
	| Name                       | Permis - ${staticProjectName}   |
	| Product Version            | 7.4                             |
	| Start Date                 | ${staticStartDate}              |''');

		LocalFile.Provisioning.gotoLicenses();

		LocalFile.Provisioning.expandLicenseAdvancedSearchForm();

		LocalFile.Provisioning.populateAdvancedSearchFormAndSearch(table = '''| Account Name | | Input | Permis - ${staticProjectName} |''');

		LocalFile.Provisioning._viewNoLicenseViaIndex(licenseKeyword = "Permis - ${staticProjectName}");
	}

	test AttempttogeneratealicensewithProvisioningAPIusingaLiferayemployeeonAccountAccessEUgroupwithoktaauthentication {
		LocalFile.OSBAdminRabbitMQ.publishCreateProjectWithNoPartnerMessage(
			routingKey = "dossiera.provisioning.create",
			table = '''| Account Name                           | Misper - ${staticCompanyName}              |
	| Address City                           | Diamond Bar                                |
	| Address Country                        | United States                              |
	| Address Postal Code                    | 91765                                      |
	| Address Region                         | California                                 |
	| Address Street                         | 456 Fake Street                            |
	| Contact Email Address                  | pro.okta2@lrcustomer.com.broken            |
	| Contact First Name                     | PRO                                        |
	| Contact Last Name                      | Okta1                                      |
	| Dossiera Account Key                   | ${staticDossieraAccountKey}                |
	| Dossiera Address Key 1                 | ${staticDossieraAddressKey1}               |
	| Dossiera Address Key 2                 | ${staticDossieraAddressKey2}               |
	| Dossiera Contact Key                   | ${staticDossieraContactKey}                |
	| Dossiera Project Key                   | ${staticDossieraProjectKey}                |
	| End Day                                | ${staticEndDay}                            |
	| End Month                              | ${staticEndMonth}                          |
	| End Year                               | ${staticEndYear}                           |
	| Industry                               | Automotive                                 |
	| Owner Email Address                    | pro.okta2@lrcustomer.com.broken            |
	| Owner First Name                       | PRO                                        |
	| Owner Last Name                        | Okta2                                      |
	| Partner First Line Support             | false                                      |
	| Product Type                           | New                                        |
	| Product Name                           | Liferay Digital Enterprise - Prod Sizing 4 |
	| Project Name                           | Permis - ${staticProjectName}              |
	| Renewal                                | false                                      |
	| Salesforce Opportunity Key             | ${staticSalesforceOpportunityKey}          |
	| Salesforce Opportunity Line Item Key 1 | ${staticSalesforceOpportunityLineItemKey1} |
	| Salesforce Opportunity Line Item Key 2 | ${staticSalesforceOpportunityLineItemKey2} |
	| Salesforce Opportunity Sold By         | Liferay US                                 |
	| Salesforce Opportunity Stage Name      | Closed Won                                 |
	| Salesforce Opportunity Territory       | United States                              |
	| Salesforce Opportunity Type            | New Business                               |
	| Salesforce Owner User Key              | ${staticSalesforceOwnerUserKey}            |
	| Salesforce Project Key                 | ${staticSalesforceProjectKey}              |
	| Start Day                              | ${staticStartDay}                          |
	| Start Month                            | ${staticStartMonth}                        |
	| Start Year                             | ${staticStartYear}                         |
	| Subscription Level                     | Platinum                                   |
	| Version Number                         | 7.1                                        |''');

		LocalFile.Data.generateSupportUser();

		LocalFile.JSONOkta.createOktaUser(table = '''| Screen Name   | ${staticScreenNameValue}       |
	| Email Address | ${staticEmailValue}            |
	| First Name    | ${staticContactFirstNameValue} |
	| Last Name     | ${staticContactLastNameValue}  |
	| Group         | Employees                      |
	| Group         | Account Access EU              |''');

		LocalFile.KoroneikiContactAPI._viewContactSyncViaEmailAddress(contactEmailAddress = ${staticEmailValue});

		LocalFile.KoroneikiContactAPI._viewAccountSyncViaUuid(
			accountName = "Liferay, Inc.",
			contactEmailAddress = ${staticEmailValue});

		LocalFile.KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		LocalFile.KoroneikiProductPurchaseAPI._generateProductPurchaseKey(
			accountName = "Permis - ${staticProjectName}",
			productName = "DXP Production");

		LocalFile.Okta._loginToDevDomain(
			userEmailAddress = ${staticEmailValue},
			userPassword = ${staticOktaUserPassword});

		LocalFile.Okta._getOktaSessionIdDevPage();

		LocalFile.OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

