definition {

	property testray.main.component.name = "Support QA";
	property type = "koroneiki";

	tearDown {
		LocalFile.KoroneikiTeamAPI._tearDownTeams(table = '''| Development Team |
	| Marketing Team   |
	| Engineering Team |
	| Sales Team       |''');

		LocalFile.KoroneikiTeamRoleAPI._tearDownTeamRoles(table = '''| Default Account Role  |
	| Optional Account Role |''');

		LocalFile.KoroneikiAccountAPI._tearDownAccounts(table = '''| Koroneiki Auto Subsidiary |
	| Koroneiki Engr Subsidiary |
	| Koroneiki Automotive      |
	| Koroneiki Engineering     |''');
	}

	test Assignaccountteamrolestoteam {
		LocalFile.KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORAUTO                                  | |
	| Contact Email Address | koroneiki.contact1@lrcustomer.com.broken | |
	| Description           | Test automotive account on koroneiki     | |
	| Fax Number            | 555-555-1234                             | |
	| Name                  | Koroneiki Automotive                     | |
	| Phone Number          | 555-555-5678                             | |
	| Profile Email Address | koroneiki.contact1@lrcustomer.com.broken | |
	| Region                | United States                            | |
	| Status                | Active                                   | |
	| Tier                  | T4                                       | |
	| Website               | www.koroneikiautomotive.com              | |''');

		LocalFile.KoroneikiAccountAPI._createAccountTeam(
			accountName = "Koroneiki Automotive",
			teamName = "Development Team");

		LocalFile.KoroneikiTeamRoleAPI._createTeamRole(table = '''| Description | This is the default role for accounts |
	| Name        | Default Account Role                  |
	| Type        | Account                               |''');

		LocalFile.KoroneikiTeamRoleAPI._createTeamRole(table = '''| Description | This is the optional role for accounts |
	| Name        | Optional Account Role                  |
	| Type        | Account                                |''');

		LocalFile.KoroneikiAccountAPI._assignTeamRolesToTeam(
			accountName = "Koroneiki Automotive",
			table = '''| Default Account Role  |
	| Optional Account Role |''',
			teamName = "Development Team");

		LocalFile.KoroneikiAccountAPI._viewTeamRole(
			accountName = "Koroneiki Automotive",
			teamName = "Development Team",
			teamRoleName = "Default Account Role");

		LocalFile.KoroneikiAccountAPI._viewTeamRole(
			accountName = "Koroneiki Automotive",
			teamName = "Development Team",
			teamRoleName = "Optional Account Role");
	}

	test Assignaccountteamrolestoteamsonaccountandchildaccounts {
		LocalFile.KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORAUTO                                  | |
	| Contact Email Address | koroneiki.contact1@lrcustomer.com.broken | |
	| Description           | Test automotive account on koroneiki     | |
	| Fax Number            | 555-555-1234                             | |
	| Name                  | Koroneiki Automotive                     | |
	| Phone Number          | 555-555-5678                             | |
	| Profile Email Address | koroneiki.contact1@lrcustomer.com.broken | |
	| Region                | United States                            | |
	| Status                | Active                                   | |
	| Tier                  | T4                                       | |
	| Website               | www.koroneikiautomotive.com              | |''');

		LocalFile.KoroneikiAccountAPI._createChildAccount(
			accountName = "Koroneiki Automotive",
			table = '''| Code                  | KORAUTOSUB                                 | |
	| Contact Email Address | koroneiki.contact2@lrcustomer.com.broken   | |
	| Description           | Test automotive child account on koroneiki | |
	| Fax Number            | 555-555-9012                               | |
	| Name                  | Koroneiki Auto Subsidiary                  | |
	| Phone Number          | 555-555-3456                               | |
	| Profile Email Address | koroneiki.contact2@lrcustomer.com.broken   | |
	| Region                | United States                              | |
	| Status                | Active                                     | |
	| Tier                  | T4                                         | |
	| Website               | www.koroneikiautomotivesubsidiary.com      | |''');

		LocalFile.KoroneikiAccountAPI._createAccountTeam(
			accountName = "Koroneiki Automotive",
			teamName = "Development Team");

		LocalFile.KoroneikiAccountAPI._createAccountTeam(
			accountName = "Koroneiki Auto Subsidiary",
			teamName = "Marketing Team");

		LocalFile.KoroneikiTeamRoleAPI._createTeamRole(table = '''| Description | This is the default role for accounts |
	| Name        | Default Account Role                  |
	| Type        | Account                               |''');

		LocalFile.KoroneikiTeamRoleAPI._createTeamRole(table = '''| Description | This is the optional role for accounts |
	| Name        | Optional Account Role                  |
	| Type        | Account                                |''');

		LocalFile.KoroneikiAccountAPI._assignTeamRolesToTeam(
			accountName = "Koroneiki Automotive",
			table = '''| Default Account Role |''',
			teamName = "Development Team");

		LocalFile.KoroneikiAccountAPI._assignTeamRolesToTeam(
			accountName = "Koroneiki Auto Subsidiary",
			table = '''| Optional Account Role |''',
			teamName = "Marketing Team");

		LocalFile.KoroneikiAccountAPI._viewTeamRole(
			accountName = "Koroneiki Automotive",
			teamName = "Development Team",
			teamRoleName = "Default Account Role");

		LocalFile.KoroneikiAccountAPI._viewTeamRole(
			accountName = "Koroneiki Auto Subsidiary",
			teamName = "Marketing Team",
			teamRoleName = "Optional Account Role");

		LocalFile.KoroneikiAccountAPI._viewNoTeamRole(
			accountName = "Koroneiki Automotive",
			teamName = "Development Team",
			teamRoleName = "Optional Account Role");

		LocalFile.KoroneikiAccountAPI._viewNoTeamRole(
			accountName = "Koroneiki Auto Subsidiary",
			teamName = "Marketing Team",
			teamRoleName = "Default Account Role");
	}

	test Assignaccountteamroletomultipleaccounts {
		LocalFile.KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORAUTO                                  | |
	| Contact Email Address | koroneiki.contact1@lrcustomer.com.broken | |
	| Description           | Test automotive account on koroneiki     | |
	| Fax Number            | 555-555-1234                             | |
	| Name                  | Koroneiki Automotive                     | |
	| Phone Number          | 555-555-5678                             | |
	| Profile Email Address | koroneiki.contact1@lrcustomer.com.broken | |
	| Region                | United States                            | |
	| Status                | Active                                   | |
	| Tier                  | T4                                       | |
	| Website               | www.koroneikiautomotive.com              | |''');

		LocalFile.KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORENGR                                  | |
	| Contact Email Address | koroneiki.contact2@lrcustomer.com.broken | |
	| Description           | Test engineering account on koroneiki    | |
	| Fax Number            | 555-555-4321                             | |
	| Name                  | Koroneiki Engineering                    | |
	| Phone Number          | 555-555-8765                             | |
	| Profile Email Address | koroneiki.contact2@lrcustomer.com.broken | |
	| Region                | Japan                                    | |
	| Status                | Active                                   | |
	| Tier                  | T1                                       | |
	| Website               | www.koroneikiengineering.com             | |''');

		LocalFile.KoroneikiAccountAPI._createAccountTeam(
			accountName = "Koroneiki Automotive",
			teamName = "Development Team");

		LocalFile.KoroneikiTeamRoleAPI._createTeamRole(table = '''| Description | This is the default role for accounts |
	| Name        | Default Account Role                  |
	| Type        | Account                               |''');

		LocalFile.KoroneikiAccountAPI._assignTeamRolesToTeam(
			accountName = "Koroneiki Automotive",
			table = '''| Default Account Role |''',
			teamName = "Development Team");

		LocalFile.KoroneikiAccountAPI._assignTeamRolesToTeam(
			accountName = "Koroneiki Engineering",
			table = '''| Default Account Role |''',
			teamName = "Development Team");

		LocalFile.KoroneikiAccountAPI._viewTeamRole(
			accountName = "Koroneiki Automotive",
			teamName = "Development Team",
			teamRoleName = "Default Account Role");

		LocalFile.KoroneikiAccountAPI._viewTeamRole(
			accountName = "Koroneiki Engineering",
			teamName = "Development Team",
			teamRoleName = "Default Account Role");

		LocalFile.KoroneikiTeamAPI._viewTeamAssignedAccount(
			accountName = "Koroneiki Automotive",
			table = '''| Code                  | KORAUTO                                  | |
	| Contact Email Address | koroneiki.contact1@lrcustomer.com.broken | |
	| Description           | Test automotive account on koroneiki     | |
	| Fax Number            | 555-555-1234                             | |
	| Name                  | Koroneiki Automotive                     | |
	| Phone Number          | 555-555-5678                             | |
	| Profile Email Address | koroneiki.contact1@lrcustomer.com.broken | |
	| Region                | United States                            | |
	| Status                | Active                                   | |
	| Tier                  | T4                                       | |
	| Website               | www.koroneikiautomotive.com              | |''',
			teamName = "Development Team");

		LocalFile.KoroneikiTeamAPI._viewTeamAssignedAccount(
			accountName = "Koroneiki Engineering",
			table = '''| Code                  | KORENGR                                  | |
	| Contact Email Address | koroneiki.contact2@lrcustomer.com.broken | |
	| Description           | Test engineering account on koroneiki    | |
	| Fax Number            | 555-555-4321                             | |
	| Name                  | Koroneiki Engineering                    | |
	| Phone Number          | 555-555-8765                             | |
	| Profile Email Address | koroneiki.contact2@lrcustomer.com.broken | |
	| Region                | Japan                                    | |
	| Status                | Active                                   | |
	| Tier                  | T1                                       | |
	| Website               | www.koroneikiengineering.com             | |''',
			teamName = "Development Team");
	}

