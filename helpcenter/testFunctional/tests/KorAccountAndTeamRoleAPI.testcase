	test Removeaccountteamrolefrommultipleaccounts {
		LocalFile.KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORAUTO                                  | |
	| Contact Email Address | koroneiki.contact1@lrcustomer.com.broken | |
	| Description           | Test automotive account on koroneiki     | |
	| Fax Number            | 555-555-1234                             | |
	| Name                  | Koroneiki Automotive                     | |
	| Phone Number          | 555-555-5678                             | |
	| Profile Email Address | koroneiki.contact1@lrcustomer.com.broken | |
	| Region                | United States                            | |
	| Status                | Active                                   | |
	| Tier                  | T4                                       | |
	| Website               | www.koroneikiautomotive.com              | |''');

		LocalFile.KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORENGR                                  | |
	| Contact Email Address | koroneiki.contact2@lrcustomer.com.broken | |
	| Description           | Test engineering account on koroneiki    | |
	| Fax Number            | 555-555-4321                             | |
	| Name                  | Koroneiki Engineering                    | |
	| Phone Number          | 555-555-8765                             | |
	| Profile Email Address | koroneiki.contact2@lrcustomer.com.broken | |
	| Region                | Japan                                    | |
	| Status                | Active                                   | |
	| Tier                  | T1                                       | |
