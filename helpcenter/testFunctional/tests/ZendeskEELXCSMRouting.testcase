definition {

	property testray.main.component.name = "Support QA";
	property type = "zendesk.api";

	setUp {
		Passwords.getPasswords();
	}

	tearDown {
		ZendeskTicketAPI._tearDownTicketByIds(ticketIdList = ${staticRequestIdList});

		ZendeskUserAPI._tearDownUsersByExternalIdTable(table = '''| User1 |''');

		ZendeskOrganizationAPI._tearDownOrganizationsByExternalIdTable(table = '''| 12345678 |''');

		ZendeskHomepage.pause(timeInSeconds = 3);
	}

	test EELXCSMAURouting {
		ZendeskOrganizationAPI._createOrganization(table = '''| Status           | Approved            |
	| Name             | Organization Name 1 |
	| Shared Tickets   | true                |
	| Shared Comments  | true                |
	| SLA              | Gold                |
	| Tier             | T4                  |
	| Support Region   | Australia           |
	| Support Language | English             |
	| External ID      | 12345678            |''');

		ZendeskOrganizationAPI._assignTagsToOrganizationViaOrganizationExternalID(
			organizationExternalId = 12345678,
			table = '''| lxc_sm |''');

		ZendeskUserAPI._createUser(table = '''| Name             | Zendesk User1                    |
	| Tags             | osb_customer,osb_kb              |
	| Password         | ${staticZendeskAdminPassword}    |
	| Role             | End-user                         |
	| Access           | Organization                     |
	| Email            | zendesk.user1@zendesk.com.broken |
	| Phone Number     | +1 (555) 555-5555                |
	| Organization     | Organization Name 1              |
	| Language         | English                          |
	| Time Zone        | Sydney                           |
	| External ID      | User1                            |''');

		ZendeskRequestAPI._createLXCSMRequest(
			requesterEmail = "zendesk.user1@zendesk.com.broken",
			table = '''| Product                  | prd_lxc_sm                                       |
	| Component                | backup_recovery                                  |
	| Liferay Version          | liferay_version_7_2                              |
	| Tags                     | escalation_engineer                              |
	| System Status            | production_functioning_with_limited_capabilities |
	| Subject                  | Request Subject                                  |
	| Description              | Request Description                              |
	| Organization External ID | 12345678                                         |''');

		ZendeskTicketAPI._viewMultipleTicketGroupAssignees(
			groupAssignee = "EE - LXC - SM - AU/NZ",
			ticketIdList = ${staticRequestIdList});

		ZendeskTicketAPI._viewTicketSupportSchedule(
			supportRegionAbbreviation = "JP",
			ticketId = ${staticRequestIdList});
	}

