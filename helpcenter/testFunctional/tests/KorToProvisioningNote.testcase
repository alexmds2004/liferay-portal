	| Salesforce Opportunity Territory       | United States                              |
	| Salesforce Opportunity Type            | New Business                               |
	| Salesforce Owner User Key              | ${staticSalesforceOwnerUserKey}            |
	| Salesforce Project Key                 | ${staticSalesforceProjectKey}              |
	| Start Day                              | ${staticStartDay}                          |
	| Start Month                            | ${staticStartMonth}                        |
	| Start Year                             | ${staticStartYear}                         |
	| Subscription Level                     | Platinum                                   |
	| Version Number                         | 7.1                                        |''');

		KoroneikiAccountAPI._createAccountNote(
			accountName = "Korpro - ${staticProjectName}",
			table = '''| Agent Name | Koroneiki User       |
	| Content    | Account Note Content |
	| Format     | Plain                |
	| Priority   | 2                    |
	| Status     | Approved             |
	| Type       | General              |''');

		OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		Provisioning.gotoAccounts();

		Provisioning.searchAccounts(keyword = "Korpro");

		Provisioning.clickAccount(accountName = "Korpro - ${staticProjectName}");

		ProvisioningAccount.expandSidePanel();

		ProvisioningAccount.clickSidePanelTab(tabName = "Notes");

		ProvisioningAccount.clickNoteActionDropdownButton(
			action = "Archive",
			noteContent = "Account Note Content",
			noteType = "General");

		ProvisioningAccount._viewNoAccountNote(
			noteContent = "Account Note Content",
			noteType = "General");

		ProvisioningAccount._viewNoAccountNoteViaArchive(noteContent = "Account Note Content");

		ProvisioningAccount.clickViewArchivedNotesLink();

		ProvisioningAccount._viewAccountNoteViaArchive(
			noteContent = "Account Note Content",
			table = '''| Author  | Koroneiki User       |
	| Content | Account Note Content |''');

		Provisioning.clickTab(tabName = "History");

		ProvisioningAccount.viewAccountHistoryEntryByKeyword(
			fieldName = "status",
			keyword = "Test Test > Updated Note",
			table = '''| Update Description          | Test Test > Updated Note |
	| Update Field Name           | status                   |
	| Update Field Original Value | Approved                 |
	| Update Field New Value      | Archived                 |''');

		ProvisioningAccount.viewAccountHistoryEntryByKeyword(
			fieldName = "content",
			keyword = "Test Test > Updated Note",
			table = '''| Update Description          | Test Test > Updated Note |
	| Update Field Name           | content                  |
	| Update Field Original Value | Account Note Content     |
	| Update Field New Value      | Account Note Content     |''');
	}

