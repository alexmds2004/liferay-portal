		Provisioning.gotoAccounts();

		Provisioning.searchAccounts(keyword = "Korpro");

		Provisioning.clickAccount(accountName = "Korpro - ${staticProjectName}");

		ProvisioningAccount.expandSidePanel();

		ProvisioningAccount.clickSidePanelTab(tabName = "Notes");

		ProvisioningAccount.cancelNote(content = "Account Note Content");

		ProvisioningAccount._viewNoAccountNote(
			noteContent = "Account Note Content",
			noteType = "Pinned");

		ProvisioningAccount._viewNoAccountNote(
			noteContent = "Account Note Content",
			noteType = "General");

		ProvisioningAccount._viewAccountNotesEmptyState();

		ProvisioningAccount.viewNoArchivedNotesLink();

		Provisioning.clickTab(tabName = "History");

		ProvisioningAccount.viewNoAccountHistoryEntryByKeyword(keyword = "Test Test > Added Note");
	}

	test Cancelnoteupdate {
		OSBAdminRabbitMQ.publishCreateProjectWithNoPartnerMessage(
			routingKey = "dossiera.provisioning.create",
			table = '''| Account Name                           | Prokor - ${staticCompanyName}              |
	| Address City                           | Diamond Bar                                |
	| Address Country                        | United States                              |
