	test Assignmultiplenonexistentaccountworkercontactrolestocontact {
		KoroneikiContactRoleAPI._createContactRoleNestedFieldForNonExistentContactRole(table = '''| Description | This is the default worker role for accounts |
	| Name        | Default Account Worker Role                  |
	| Type        | Account Worker                               |''');

		KoroneikiContactRoleAPI._renameFirstContactRoleNestedFieldVariable();

		KoroneikiContactRoleAPI._createContactRoleNestedFieldForNonExistentContactRole(table = '''| Description | This is the optional worker role for accounts |
	| Name        | Optional Account Worker Role                  |
	| Type        | Account Worker                                |''');

		KoroneikiContactRoleAPI._renameSecondContactRoleNestedFieldVariable();

		KoroneikiContactAPI._createContact(table = '''| Email Address | koroneiki.contact1@lrcustomer.com.broken |
	| First Name    | Koroneiki                                |
	| Language      | English                                  |
	| Last Name     | Contact1                                 |
	| Middle Name   | User                                     |''');

		KoroneikiContactAPI._createWorkerContactNestedFieldWithContactRoleNestedField(
			contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken",
			contactRolesNestedField = "${staticContactRolesNestedField1},${staticContactRolesNestedField2}");

		KoroneikiAccountAPI._createAccount(table = '''| Code                 | KORAUTO                              | |
	| Contact Nested Field | ${staticContactsNestedField}         | |
	| Description          | Test automotive account on koroneiki | |
	| Fax Number           | 555-555-1234                         | |
	| Name                 | Koroneiki Automotive                 | |
	| Phone Number         | 555-555-5678                         | |
	| Region               | United States                        | |
	| Status               | Active                               | |
	| Tier                 | T4                                   | |
