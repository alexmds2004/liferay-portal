			contactRoleName = "Default Account Worker Role",
			table = '''| Description | This is the default worker role for accounts |
	| Name        | Default Account Worker Role                  |
	| Type        | Account Worker                               |''');

		KoroneikiContactRoleAPI._viewContactRole(
			contactRoleName = "Optional Account Worker Role",
			table = '''| Description | This is the optional worker role for accounts |
	| Name        | Optional Account Worker Role                  |
	| Type        | Account Worker                                |''');

		KoroneikiContactAPI._viewAccountWorkerContactRoleViaUuid(
			accountName = "Koroneiki Automotive",
			contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken",
			contactRoleName = "Default Account Worker Role");

		KoroneikiContactAPI._viewAccountWorkerContactRoleViaUuid(
			accountName = "Koroneiki Automotive",
			contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken",
			contactRoleName = "Optional Account Worker Role");

		KoroneikiContactAPI._viewAccountWorkerContactRoleViaUuid(
			accountName = "Koroneiki Automotive",
			contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken",
			contactRoleName = "Member");
	}

