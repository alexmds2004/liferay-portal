definition {

	property testray.main.component.name = "Support QA";
	property type = "koroneiki";

	tearDown {
		LocalFile.KoroneikiAccountAPI._tearDownAccounts(table = '''| Koroneiki Auto Subsidiary |
	| Koroneiki Engr Subsidiary |
	| Koroneiki Automotive      |
	| Koroneiki Engineering     |''');

		LocalFile.KoroneikiContactAPI._tearDownContacts(table = '''| koroneiki.contact1@lrcustomer.com.broken |
	| koroneiki.contact2@lrcustomer.com.broken |''');

		LocalFile.KoroneikiContactRoleAPI._tearDownContactRoles(table = '''| Default Account Worker Role  |
	| Optional Account Worker Role |''');
	}

	test Assignaccountworkercontactrolestocontact {
		LocalFile.KoroneikiContactAPI._createContact(table = '''| Email Address | koroneiki.contact1@lrcustomer.com.broken |
	| First Name    | Koroneiki                                |
	| Language      | English                                  |
	| Last Name     | Contact1                                 |
	| Middle Name   | User                                     |''');

		LocalFile.KoroneikiAccountAPI._createAccount(table = '''| Code         | KORAUTO                              | |
	| Description  | Test automotive account on koroneiki | |
	| Fax Number   | 555-555-1234                         | |
	| Name         | Koroneiki Automotive                 | |
	| Phone Number | 555-555-5678                         | |
	| Region       | United States                        | |
	| Status       | Active                               | |
	| Tier         | T4                                   | |
	| Website      | www.koroneikiautomotive.com          | |''');

		LocalFile.KoroneikiContactRoleAPI._createContactRole(table = '''| Description | This is the default worker role for accounts |
	| Name        | Default Account Worker Role                  |
	| Type        | Account Worker                               |''');

		LocalFile.KoroneikiContactRoleAPI._createContactRole(table = '''| Description | This is the optional worker role for accounts |
	| Name        | Optional Account Worker Role                  |
	| Type        | Account Worker                                |''');

		LocalFile.KoroneikiAccountAPI._assignWorkerContacts(
			accountName = "Koroneiki Automotive",
			table = '''| koroneiki.contact1@lrcustomer.com.broken |''');

		LocalFile.KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Koroneiki Automotive",
			contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken",
			table = '''| Default Account Worker Role  |
	| Optional Account Worker Role |''');

		LocalFile.KoroneikiAccountAPI._viewContactRole(
			accountName = "Koroneiki Automotive",
			contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken",
			contactRoleName = "Default Account Worker Role");

		LocalFile.KoroneikiAccountAPI._viewContactRole(
			accountName = "Koroneiki Automotive",
			contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken",
			contactRoleName = "Optional Account Worker Role");

		LocalFile.KoroneikiAccountAPI._viewContactRole(
			accountName = "Koroneiki Automotive",
