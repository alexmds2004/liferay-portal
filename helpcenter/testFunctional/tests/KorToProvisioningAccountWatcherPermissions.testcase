definition {

	property testray.main.component.name = "Support QA";
	property type = "provisioning.security";

	setUp {
		Passwords.getPasswords();

		KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		OSBAdminRabbitMQ.generateStaticVariables();

		OSBAdminRabbitMQ.generateProvisioningCompanyName();

		OSBAdminRabbitMQ.generateProvisioningProjectName();

		JSONUser.createViaProvisioning(table = '''| Screen Name   | provisioning.watcher                    |
	| Email Address | provisioning.watcher@liferay.com.broken |
	| First Name    | Provisioning                            |
	| Last Name     | Watcher                                 |''');

		JSONUser.assignUserToProvisioningRole(
			roleName = "Provisioning Watcher",
			userEmailAddress = "provisioning.watcher@liferay.com.broken");

		JSONOkta.createOktaUser(table = '''| Screen Name   | prm.koroneiki1                       |
	| Email Address | prm.koroneiki1@lrcustomer.com.broken |
	| First Name    | PRM                                  |
	| Last Name     | Koroneiki1                           |''');

		JSONOkta.createOktaUser(table = '''| Screen Name   | prm.koroneiki2                       |
	| Email Address | prm.koroneiki2@lrcustomer.com.broken |
	| First Name    | PRM                                  |
	| Last Name     | Koroneiki2                           |''');
	}

	tearDown {
		ZendeskUserAPI._getDefaultUserId(organizationName = "Permis - ${staticProjectName}");

		ZendeskUserAPI._renameFirstDefaultUserIdVariable();

		ZendeskUserAPI._getDefaultUserId(organizationName = "Misper - ${staticCompanyName}");

		ZendeskUserAPI._renameSecondDefaultUserIdVariable();

		KoroneikiTeamAPI._tearDownTeams(table = '''| Permission Partner |''');

		OSBAdminProject.tearDownProjects(table = '''| MISPERPERMIS |
	| MISPER       |''');

		KoroneikiAccountAPI._tearDownAccounts(table = '''| Permis - ${staticProjectName} |
	| Misper - ${staticCompanyName} |''');

		KoroneikiAccountAPI._tearDownAccountsViaAccountFieldNameAndValue(
			fieldName = "Code",
			table = '''| MISPERPERMIS |
	| MISPER       |''');

		JSONUser.tearDownUsers(table = '''| prm.koroneiki1@lrcustomer.com.broken |
	| prm.koroneiki2@lrcustomer.com.broken |''');

		JSONUser.tearDownUsersViaSupport(table = '''| prm.koroneiki1@lrcustomer.com.broken |
	| prm.koroneiki2@lrcustomer.com.broken |''');

		JSONUser.tearDownUsersViaKoroneiki(table = '''| prm.koroneiki1@lrcustomer.com.broken |
	| prm.koroneiki2@lrcustomer.com.broken |''');

		KoroneikiContactAPI._tearDownContacts(table = '''| prm.koroneiki1@lrcustomer.com.broken |
	| prm.koroneiki2@lrcustomer.com.broken |''');

		JSONOkta.tearDownUsers(table = '''| prm.koroneiki1@lrcustomer.com.broken |
	| prm.koroneiki2@lrcustomer.com.broken |''');

		ZendeskTicketAPI._tearDownTicketsByKeywords(table = '''| New Subscription(s) for Permis - ${staticProjectName} |
	| New Subscription(s) for Misper - ${staticCompanyName} |''');

		ZendeskUserAPI._getMultipleUserIdsByEmailAddress(table = '''| prm.koroneiki1@lrcustomer.com.broken |
	| prm.koroneiki2@lrcustomer.com.broken |''');

		ZendeskUserAPI._tearDownUsersByIdList(userIds = ${staticUserIdList});

		ZendeskOrganizationAPI._getMultipleOrganizationExternalIdsByOrganizationNameIfStillPresent(table = '''| Permis - ${staticProjectName} |
	| Misper - ${staticCompanyName} |''');

		ZendeskOrganizationAPI._tearDownOrganizationsByExternalIdList(organizationExternalIds = ${staticOrganizationExternalIdList});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId1});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId2});

		JSONUser.tearDownUsersViaProvisioning(table = '''| provisioning.watcher@liferay.com.broken |''');
	}

	test Updateaccountsupportinstructions {
		OSBAdminRabbitMQ.publishCreateProjectWithNoPartnerMessage(
			routingKey = "dossiera.provisioning.create",
			table = '''| Account Name                           | Misper - ${staticCompanyName}              |
	| Address City                           | Diamond Bar                                |
	| Address Country                        | United States                              |
	| Address Postal Code                    | 91765                                      |
	| Address Region                         | California                                 |
	| Address Street                         | 456 Fake Street                            |
	| Contact Email Address                  | prm.koroneiki1@lrcustomer.com.broken       |
	| Contact First Name                     | PRM                                        |
	| Contact Last Name                      | Koroneiki1                                 |
	| Dossiera Account Key                   | ${staticDossieraAccountKey}                |
	| Dossiera Address Key 1                 | ${staticDossieraAddressKey1}               |
	| Dossiera Address Key 2                 | ${staticDossieraAddressKey2}               |
	| Dossiera Contact Key                   | ${staticDossieraContactKey}                |
	| Dossiera Project Key                   | ${staticDossieraProjectKey}                |
	| End Day                                | ${staticEndDay}                            |
	| End Month                              | ${staticEndMonth}                          |
	| End Year                               | ${staticEndYear}                           |
	| Industry                               | Automotive                                 |
	| Owner Email Address                    | prm.koroneiki2@lrcustomer.com.broken       |
	| Owner First Name                       | PRM                                        |
	| Owner Last Name                        | Koroneiki2                                 |
	| Partner First Line Support             | false                                      |
	| Product Type                           | New                                        |
	| Product Name                           | Liferay Digital Enterprise - Prod Sizing 4 |
	| Project Name                           | Permis - ${staticProjectName}              |
	| Renewal                                | false                                      |
	| Salesforce Opportunity Key             | ${staticSalesforceOpportunityKey}          |
	| Salesforce Opportunity Line Item Key 1 | ${staticSalesforceOpportunityLineItemKey1} |
	| Salesforce Opportunity Line Item Key 2 | ${staticSalesforceOpportunityLineItemKey2} |
	| Salesforce Opportunity Sold By         | Liferay US                                 |
	| Salesforce Opportunity Stage Name      | Closed Won                                 |
	| Salesforce Opportunity Territory       | United States                              |
	| Salesforce Opportunity Type            | New Business                               |
	| Salesforce Owner User Key              | ${staticSalesforceOwnerUserKey}            |
	| Salesforce Project Key                 | ${staticSalesforceProjectKey}              |
	| Start Day                              | ${staticStartDay}                          |
	| Start Month                            | ${staticStartMonth}                        |
	| Start Year                             | ${staticStartYear}                         |
	| Subscription Level                     | Platinum                                   |
	| Version Number                         | 7.1                                        |''');

		JSONOSBAccount.viewSupportOrganizationSync(accountCode = "MISPERPERMIS");

		KoroneikiAccountAPI._createAccountTeam(
			accountName = "Permis - ${staticProjectName}",
			teamName = "Permission Partner");

		KoroneikiAccountAPI._assignTeamRolesToTeam(
			accountName = "Permis - ${staticProjectName}",
			table = '''| First Line Support |''',
			teamName = "Permission Partner");

		OSBAdmin.loginToProvisioning(
			userEmailAddress = "provisioning.watcher@liferay.com.broken",
			userPassword = ${staticProvisioningQaUserPassword});

		UserAccount.updatePasswordUponLogin(userPassword = "test");

		Provisioning.gotoAccounts();

		Provisioning.searchAccounts(keyword = "Permis");

		Provisioning.clickAccount(accountName = "Permis - ${staticProjectName}");

		Provisioning.clickTab(tabName = "Support");

		ProvisioningAccount.editAccountDetails(table = '''| OEM Instructions     | File Upload | Document_1.txt                           | |
	| Support Instructions | Textarea    | Please follow these support instructions | |''');

		ProvisioningAccount._viewAccountDetailsViaDetailsTab(table = '''| OEM Instructions     | Document_1.txt                           | |
	| Support Instructions | Please follow these support instructions | |''');
	}

	test Viewaccount {
		OSBAdminRabbitMQ.publishCreateProjectWithNoPartnerMessage(
			routingKey = "dossiera.provisioning.create",
			table = '''| Account Name                           | Misper - ${staticCompanyName}              |
	| Address City                           | Diamond Bar                                |
	| Address Country                        | United States                              |
	| Address Postal Code                    | 91765                                      |
	| Address Region                         | California                                 |
	| Address Street                         | 456 Fake Street                            |
	| Contact Email Address                  | prm.koroneiki1@lrcustomer.com.broken       |
	| Contact First Name                     | PRM                                        |
	| Contact Last Name                      | Koroneiki1                                 |
	| Dossiera Account Key                   | ${staticDossieraAccountKey}                |
	| Dossiera Address Key 1                 | ${staticDossieraAddressKey1}               |
	| Dossiera Address Key 2                 | ${staticDossieraAddressKey2}               |
	| Dossiera Contact Key                   | ${staticDossieraContactKey}                |
	| Dossiera Project Key                   | ${staticDossieraProjectKey}                |
	| End Day                                | ${staticEndDay}                            |
	| End Month                              | ${staticEndMonth}                          |
	| End Year                               | ${staticEndYear}                           |
	| Industry                               | Automotive                                 |
	| Owner Email Address                    | prm.koroneiki2@lrcustomer.com.broken       |
	| Owner First Name                       | PRM                                        |
	| Owner Last Name                        | Koroneiki2                                 |
	| Partner First Line Support             | false                                      |
	| Product Type                           | New                                        |
	| Product Name                           | Liferay Digital Enterprise - Prod Sizing 4 |
	| Project Name                           | Permis - ${staticProjectName}              |
	| Renewal                                | false                                      |
	| Salesforce Opportunity Key             | ${staticSalesforceOpportunityKey}          |
	| Salesforce Opportunity Line Item Key 1 | ${staticSalesforceOpportunityLineItemKey1} |
	| Salesforce Opportunity Line Item Key 2 | ${staticSalesforceOpportunityLineItemKey2} |
	| Salesforce Opportunity Sold By         | Liferay US                                 |
	| Salesforce Opportunity Stage Name      | Closed Won                                 |
	| Salesforce Opportunity Territory       | United States                              |
	| Salesforce Opportunity Type            | New Business                               |
	| Salesforce Owner User Key              | ${staticSalesforceOwnerUserKey}            |
	| Salesforce Project Key                 | ${staticSalesforceProjectKey}              |
	| Start Day                              | ${staticStartDay}                          |
	| Start Month                            | ${staticStartMonth}                        |
	| Start Year                             | ${staticStartYear}                         |
	| Subscription Level                     | Platinum                                   |
	| Version Number                         | 7.1                                        |''');

		JSONOSBAccount.viewSupportOrganizationSync(accountCode = "MISPERPERMIS");

		KoroneikiAccountAPI._createAccountTeam(
			accountName = "Permis - ${staticProjectName}",
			teamName = "Permission Partner");

		KoroneikiAccountAPI._assignTeamRolesToTeam(
			accountName = "Permis - ${staticProjectName}",
			table = '''| First Line Support |''',
			teamName = "Permission Partner");

		OSBAdmin.loginToProvisioning(
			userEmailAddress = "provisioning.watcher@liferay.com.broken",
			userPassword = ${staticProvisioningQaUserPassword});

		UserAccount.updatePasswordUponLogin(userPassword = "test");

		Provisioning.gotoAccounts();

		Provisioning.searchAccounts(keyword = "Permis");

		Provisioning.clickAccount(accountName = "Permis - ${staticProjectName}");

		ProvisioningAccount._viewAccountDetails(table = '''| Name           | Permis - ${staticProjectName} |
	| Code           | MISPERPERMIS                  |
	| State          | ACTIVE                        |
	| Support Region | United States                 |
	| Country        | United States                 |
	| SLA            | Platinum                      |
	| Support Seats  | 1 / 3 Filled                  |
	| Tier           | T4                            |
	| FLS Partner    | Permission Partner            |''');

		Provisioning.clickTab(tabName = "Details");

		ProvisioningAccount._viewAccountDetailsViaDetailsTab(table = '''| Account Name        | Permis - ${staticProjectName} | |
	| State               | ACTIVE                        | |
	| Code                | MISPERPERMIS                  | |
	| Tier                | T4                            | |
	| Parent              | Misper - ${staticCompanyName} |	|
	| Data Region         | United States                 | |
	| First Line Support  | Permission Partner            |	|
	| Street 1            | 456 Fake Street               | |
	| Country             | United States                 | |
	| City                | Diamond Bar                   | |
	| State/Province      | California                    | |
	| Postal Code         | 91765                         | |
	| Primary             | true                          | |
	| Dossiera Project    | ${staticDossieraProjectKey}   | |
	| Salesforce Project  | ${staticSalesforceProjectKey} | |''');

		ProvisioningAccount.viewNonEditableAccountDetailsFields(table = '''| Account Name          | Input         | |
	| Code                  | Input         | |
	| Tier                  | Select        | |
	| Parent                | Select Entity | |
	| Data Region           | Select        | |
	| Partner/Reseller/SI   | Select Entity | |
	| First Line Support    | Select Entity | |
	| Dossiera Account      | Input         | |
	| Dossiera Project      | Input         | |
	| Salesforce Project    | Input         | |
	| DXP Cloud Project     | Input         | |
	| Analytics Cloud Group | Input         | |
	| Complimentary         | Toggle Switch | |
	| Self Provisioning     | Toggle Switch | |
	| Permanent Licenses    | Toggle Switch | |''');

		ProvisioningAccount.viewNonEditableAccountAddressDetailsFields(
			positionValue = 1,
			table = '''| Street 1       | Input         |
	| Street 2       | Input         |
	| Street 3       | Input         |
	| Country        | Select        |
	| City           | Input         |
	| State/Province | Select        |
	| Postal Code    | Input         |
	| Primary        | Toggle Switch |''');

		ProvisioningAccount.viewNoAddAddressButton(positionValue = 1);

		ProvisioningAccount.viewNoDeleteAddressButton(positionValue = 1);

		Provisioning.clickTab(tabName = "Support");

		ProvisioningAccount._viewAccountDetailsViaDetailsTab(table = '''| Support Region   | United States | |
	| Support Language | English       | |''');

		ProvisioningAccount.viewNonEditableAccountDetailsFields(table = '''| Support Region   | Select | |
	| Support Language | Select | |''');

		Provisioning.clickTab(tabName = "History");

		ProvisioningAccount.viewAccountHistoryEntryByKeyword(
			fieldName = "contactEmailAddress",
			keyword = "Auto > Added Account",
			table = '''| Update Description          | Auto > Added Account                 |
	| Update Field Name           | contactEmailAddress                  |
	| Update Field Original Value | N/A                                  |
	| Update Field New Value      | prm.koroneiki2@lrcustomer.com.broken |''');

		ProvisioningAccount.viewAccountHistoryEntryByKeyword(
			fieldName = "internal",
			keyword = "Auto > Added Account",
			table = '''| Update Description          | Auto > Added Account |
	| Update Field Name           | internal             |
	| Update Field Original Value | N/A                  |
	| Update Field New Value      | false                |''');

		ProvisioningAccount.viewAccountHistoryEntryByKeyword(
			fieldName = "code",
			keyword = "Auto > Added Account",
			table = '''| Update Description          | Auto > Added Account |
	| Update Field Name           | code                 |
	| Update Field Original Value | N/A                  |
	| Update Field New Value      | MISPERPERMIS         |''');

		ProvisioningAccount.viewAccountHistoryEntryByKeyword(
			fieldName = "region",
			keyword = "Auto > Added Account",
			table = '''| Update Description          | Auto > Added Account |
	| Update Field Name           | region               |
	| Update Field Original Value | N/A                  |
	| Update Field New Value      | United States        |''');

		KoroneikiAccountAPI._generateAccountId(accountName = "Misper - ${staticCompanyName}");

		ProvisioningAccount.viewAccountHistoryEntryByKeyword(
			fieldName = "parentAccountId",
			keyword = "Auto > Added Account",
			table = '''| Update Description          | Auto > Added Account |
	| Update Field Name           | parentAccountId      |
	| Update Field Original Value | N/A                  |
	| Update Field New Value      | ${staticAccountId}   |''');

		KoroneikiAccountAPI._generateAccountId(accountName = "Permis - ${staticProjectName}");

		ProvisioningAccount.viewAccountHistoryEntryByKeyword(
			fieldName = "accountId",
			keyword = "Auto > Added Account",
			table = '''| Update Description          | Auto > Added Account |
	| Update Field Name           | accountId            |
	| Update Field Original Value | N/A                  |
	| Update Field New Value      | ${staticAccountId}   |''');

		ProvisioningAccount.viewAccountHistoryEntryByKeyword(
			fieldName = "name",
			keyword = "Auto > Added Account",
			table = '''| Update Description          | Auto > Added Account          |
	| Update Field Name           | name                          |
	| Update Field Original Value | N/A                           |
	| Update Field New Value      | Permis - ${staticProjectName} |''');

		ProvisioningAccount.viewAccountHistoryEntryByKeyword(
			fieldName = "status",
			keyword = "Auto > Added Account",
			table = '''| Update Description          | Auto > Added Account |
	| Update Field Name           | status               |
	| Update Field Original Value | N/A                  |
	| Update Field New Value      | Active               |''');

		ProvisioningAccount.viewAccountHistoryEntryByKeyword(
			fieldName = "tier",
			keyword = "Auto > Added Account",
			table = '''| Update Description          | Auto > Added Account |
	| Update Field Name           | tier                 |
	| Update Field Original Value | N/A                  |
	| Update Field New Value      | T4                   |''');
	}

	test Viewaccounthistorypagination {
		property help.center.acceptance = "true";

		OSBAdmin.loginToProvisioning(
			userEmailAddress = "provisioning.watcher@liferay.com.broken",
			userPassword = ${staticProvisioningQaUserPassword});

		Provisioning.gotoAccounts();

		Provisioning.searchAccounts(keyword = "The Space Program");

		Provisioning.clickAccount(accountName = "The Space Program");

		ProvisioningAccount._viewAccountDetails(table = '''| Name           | The Space Program             |
    | Code           | THESPACEPRO                   |
    | State          | ACTIVE                        |
    | Support Region | United States                 |
    | SLA            | Platinum                      |
    | Support Seats  | 3 / 22 Filled                 |
    | Tier           | T1                            |''');

		Provisioning.clickTab(tabName = "History");

		ProvisioningAccount.viewAccountHistoryRow(positionValue = 1);

		ProvisioningAccount.clickHistoryNextPage();

		ProvisioningAccount.viewAccountHistoryRow(positionValue = 1);

		ProvisioningAccount.clickHistoryNextPage();

		ProvisioningAccount.viewAccountHistoryRow(positionValue = 1);

		ProvisioningAccount.clickHistoryPreviousPage();

		ProvisioningAccount.viewAccountHistoryRow(positionValue = 1);

		ProvisioningAccount.clickHistoryPreviousPage();

		ProvisioningAccount.viewAccountHistoryRow(positionValue = 1);

		ProvisioningAccount.clickHistoryPageNumber(key_pageNumber = 2);

		ProvisioningAccount.viewAccountHistoryRow(positionValue = 1);

		ProvisioningAccount.clickHistoryPageNumber(key_pageNumber = 3);

		ProvisioningAccount.viewAccountHistoryRow(positionValue = 1);

		ProvisioningAccount.clickHistoryPageNumber(key_pageNumber = 2);

		ProvisioningAccount.viewAccountHistoryRow(positionValue = 1);

		ProvisioningAccount.clickHistoryPageNumber(key_pageNumber = 1);

		ProvisioningAccount.viewAccountHistoryRow(positionValue = 1);
	}

}