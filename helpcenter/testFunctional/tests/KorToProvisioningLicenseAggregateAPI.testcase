		LocalFile.ProvisioningLicense.viewLicense(table = '''| Header  | Korlic - ${staticProjectName} | |
	| Product | Portal Production             | |''');

		LocalFile.ProvisioningLicense.getLicenseKeyIdViaLicenseDetails();

		LocalFile.ProvisioningLicense._renameFirstLicenseKeyIdVariable();

		LocalFile.Provisioning.gotoLicenses();

		LocalFile.Provisioning.clickGenerateLicenseButton();

		LocalFile.ProvisioningLicense.populateGenerateLicenseForm(table = '''| Account | Select Entity | Korlic - ${staticProjectName} | |
	| Product | Select        | Portal Production             | |
	| Version | Select        | 6.2 EE                        | |
	| Type    | Select        | Portal Production             | |''');

		LocalFile.ProvisioningLicense.clickChooseProductPurchaseButton(positionValue = 1);

		LocalFile.ProvisioningLicense.populateGenerateLicenseForm(table = '''| Name          | Input    | Korlic - ${staticProjectName} License2 Name        | |
	| Description   | Input    | Korlic - ${staticProjectName} License2 Description | |
	| Host Name     | Input    | localhost                                          | |
	| IP Addresses  | Textarea | 123.45.67.89                                       | |
	| MAC Addresses | Textarea | 0A-1B-2C-3D-4E-5F                                  | |''');

		LocalFile.ProvisioningLicense.clickGenerateLicenseButton();

		LocalFile.ProvisioningLicense.viewLicense(table = '''| Header  | Korlic - ${staticProjectName}    | |
	| Product | Portal Production                | |''');

		LocalFile.ProvisioningLicense.getLicenseKeyIdViaLicenseDetails();

		LocalFile.ProvisioningLicense._renameSecondLicenseKeyIdVariable();

		LocalFile.Provisioning.gotoAccounts();

		LocalFile.Provisioning.searchAccounts(keyword = "Korlic");

		LocalFile.Provisioning.clickAccount(accountName = "Korlic - ${staticProjectName}");

		LocalFile.Provisioning.clickTab(tabName = "Licenses");

		LocalFile.ProvisioningAccount.selectLicensesViaLicensesTab(table = '''| Korlic - ${staticProjectName} License1 Name |
	| Korlic - ${staticProjectName} License2 Name |''');

		LocalFile.ProvisioningAccount.clickLicensesActionDropdownButton(action = "Download");

		LocalFile.ProvisioningLicense._viewLicenseViaDownloadLicensePage(
			licenseKeyword = "Korlic - ${staticProjectName} License1 Name",
			table = '''| Name        | Korlic - ${staticProjectName} License1 Name        |
	| Description | Korlic - ${staticProjectName} License1 Description |
	| Version     | 6.2 EE                                             |
	| Product     | Portal Production                                  |
	| Type        | Portal Production                                  |
	| Status      | ACTIVE                                             |''');

		LocalFile.ProvisioningLicense._viewLicenseViaDownloadLicensePage(
			licenseKeyword = "Korlic - ${staticProjectName} License2 Name",
			table = '''| Name        | Korlic - ${staticProjectName} License2 Name        |
	| Description | Korlic - ${staticProjectName} License2 Description |
	| Version     | 6.2 EE                                             |
	| Product     | Portal Production                                  |
	| Type        | Portal Production                                  |
	| Status      | ACTIVE                                             |''');

		LocalFile.ProvisioningLicenseAPI._downloadLicenseAggregate(
			accountName = "Korlic - ${staticProjectName}",
			aggregatedFilePattern = "old",
			table = '''| ${staticLicenseKeyId3} |
	| ${staticLicenseKeyId2} |
	| ${staticLicenseKeyId1} |''');
	}

}