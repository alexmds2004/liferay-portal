	test Createcustomercontactswithmultiplenonexistentroles {
		OSBAdminRabbitMQ.generateProvisioningProjectName();

		KoroneikiContactRoleAPI._createContactRoleNestedFieldForNonExistentContactRole(table = '''| Description | This is the Liferay role for accounts |
	| Name        | Liferay Account Role                  |
	| Type        | Account Customer                      |''');

		KoroneikiContactRoleAPI._renameFirstContactRoleNestedFieldVariable();

		KoroneikiContactRoleAPI._createContactRoleNestedFieldForNonExistentContactRole(table = '''| Description | This is the NonLiferay role for accounts |
	| Name        | NonLiferay Account Role                  |
	| Type        | Account Customer                         |''');

		KoroneikiContactRoleAPI._renameSecondContactRoleNestedFieldVariable();

		KoroneikiContactRoleAPI._createContactRoleNestedFieldForNonExistentContactRole(table = '''| Description | This is the optional Liferay role for accounts |
	| Name        | Liferay Optional Role                          |
	| Type        | Account Customer                               |''');

		KoroneikiContactRoleAPI._renameThirdContactRoleNestedFieldVariable();

		KoroneikiContactRoleAPI._createContactRoleNestedFieldForNonExistentContactRole(table = '''| Description | This is the optional NonLiferay role for accounts |
	| Name        | NonLiferay Optional Role                          |
	| Type        | Account Customer                                  |''');

		KoroneikiContactRoleAPI._renameFourthContactRoleNestedFieldVariable();

		KoroneikiContactAPI._createContact(table = '''| Email Address | osb.koroneiki1@lrcustomer.com.broken |
