definition {

	property testray.main.component.name = "Support QA";
	property type = "osb.integration";

	setUp {
		Passwords.getPasswords();
	}

	tearDown {
		ZendeskUserAPI._getDefaultUserId(organizationName = "Korone - ${staticProjectName}");

		ZendeskUserAPI._renameFirstDefaultUserIdVariable();

		ZendeskUserAPI._getDefaultUserId(organizationName = "Kchild - ${staticProjectName}");

		ZendeskUserAPI._renameSecondDefaultUserIdVariable();

		ZendeskUserAPI._getDefaultUserId(organizationName = "Oneiki - ${staticProjectName}");

		ZendeskUserAPI._renameThirdDefaultUserIdVariable();

		OSBAdminProject.tearDownProjects(table = '''| KCHILDKCHILD |
	| KORONEKORONE |
	| ONEIKIONEIKI |''');

		KoroneikiAccountAPI._tearDownAccounts(table = '''| Kchild - ${staticProjectName} |
	| Korone - ${staticProjectName} |
	| Oneiki - ${staticProjectName} |''');

		KoroneikiAccountAPI._tearDownAccountsViaAccountFieldNameAndValue(
			fieldName = "Code",
			table = '''| KCHILDKCHILD |
	| KORONEKORONE |
	| ONEIKIONEIKI |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		KoroneikiContactAPI._tearDownContacts(table = '''| osb.koroneiki1@lrcustomer.com.broken |
	| osb.koroneiki2@lrcustomer.com.broken |
	| bso.koroneiki3@lrcustomer.com.broken |
	| bso.koroneiki4@lrcustomer.com.broken |''');

		KoroneikiContactRoleAPI._tearDownContactRoles(table = '''| Liferay Account Role     |
	| Liferay Optional Role    |
	| NonLiferay Account Role  |
	| NonLiferay Optional Role |''');

		ZendeskOrganizationAPI._getMultipleOrganizationExternalIdsByOrganizationNameIfStillPresent(table = '''| Kchild - ${staticProjectName} |
	| Korone - ${staticProjectName} |
	| Oneiki - ${staticProjectName} |''');

		ZendeskOrganizationAPI._tearDownOrganizationsByExternalIdList(organizationExternalIds = ${staticOrganizationExternalIdList});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId1});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId2});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId3});
	}

	test Createcustomercontactswithbothteammemberandcontactroles {
		OSBAdminRabbitMQ.generateProvisioningProjectName();

		KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORONEKORONE                         | |
	| Contact Email Address | osb.koroneiki1@lrcustomer.com.broken | |
	| Description           | Test osb account on koroneiki        | |
	| Fax Number            | 555-555-1234                         | |
	| Name                  | Korone - ${staticProjectName}        | |
	| Phone Number          | 555-555-5678                         | |
	| Profile Email Address | osb.koroneiki1@lrcustomer.com.broken | |
	| Region                | United States                        | |
	| Status                | Active                               | |
	| Tier                  | T4                                   | |
	| Website               | www.koroneikicorporation.com         | |''');

		KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korone - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | true                     | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korone - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | true                     | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		KoroneikiContactAPI._createContact(table = '''| Email Address | osb.koroneiki1@lrcustomer.com.broken |
	| First Name    | OSB                                  |
	| Language      | English                              |
	| Last Name     | Koroneiki1                           |''');

		KoroneikiContactAPI._createContact(table = '''| Email Address | osb.koroneiki2@lrcustomer.com.broken |
	| First Name    | OSB                                  |
	| Language      | English                              |
	| Last Name     | Koroneiki2                           |''');

		KoroneikiContactRoleAPI._createContactRole(table = '''| Description | This is the Liferay role for accounts |
	| Name        | Liferay Account Role                  |
	| Type        | Account Worker                        |''');

		KoroneikiContactRoleAPI._createContactRole(table = '''| Description | This is the optional Liferay role for accounts |
	| Name        | Liferay Optional Role                          |
	| Type        | Account Worker                                 |''');

		KoroneikiContactRoleAPI._createContactRole(table = '''| Description | This is the NonLiferay role for accounts |
	| Name        | NonLiferay Account Role                  |
	| Type        | Account Customer                         |''');

		KoroneikiContactRoleAPI._createContactRole(table = '''| Description | This is the optional NonLiferay role for accounts |
	| Name        | NonLiferay Optional Role                          |
	| Type        | Account Customer                                  |''');

		KoroneikiAccountAPI._assignCustomerContacts(
			accountName = "Korone - ${staticProjectName}",
			table = '''| osb.koroneiki1@lrcustomer.com.broken |
	| osb.koroneiki2@lrcustomer.com.broken |''');

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Korone - ${staticProjectName}",
			contactEmailAddress = "osb.koroneiki1@lrcustomer.com.broken",
			table = '''| Liferay Account Role     |
	| NonLiferay Optional Role |''');

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Korone - ${staticProjectName}",
			contactEmailAddress = "osb.koroneiki2@lrcustomer.com.broken",
			table = '''| NonLiferay Account Role |
	| Liferay Optional Role   |''');

		OSBAdmin.loginToSupport(
			userEmailAddress = ${staticSupportAdminEmailAdress},
			userPassword = ${staticSupportAdminPassword});

		ProjectDetails.gotoProjectDetailsPage();

		ProjectDetails.searchKeyword(keyword = "Korone");

		ProjectDetails.gotoProject(projectName = "Korone - ${staticProjectName}");

		ProjectDetails.gotoHistory();

		ProjectDetails.viewHistoryEntryByThreeKeywords(
			fieldName = "Contact Role",
			keyword1 = "Assigned Contact",
			keyword2 = "OSB Koroneiki1",
			keyword3 = "Member",
			table = '''| Updater Name                | Koroneiki QA Service Producer |
	| Update Summary              | Assigned Contact              |
	| Update Description          | OSB Koroneiki1                |
	| Update Date                 | Today                         |
	| Update Field Name           | Contact Role                  |
	| Update Field Original Value | N/A                           |
	| Update Field New Value      | Member                        |''');

		ProjectDetails.viewHistoryEntryByThreeKeywords(
			fieldName = "Contact Role",
			keyword1 = "Assigned Contact",
			keyword2 = "OSB Koroneiki2",
			keyword3 = "Member",
			table = '''| Updater Name                | Koroneiki QA Service Producer |
	| Update Summary              | Assigned Contact              |
	| Update Description          | OSB Koroneiki2                |
	| Update Date                 | Today                         |
	| Update Field Name           | Contact Role                  |
	| Update Field Original Value | N/A                           |
	| Update Field New Value      | Member                        |''');

		ProjectDetails.viewHistoryEntryByThreeKeywords(
			fieldName = "Contact Role",
			keyword1 = "Assigned Contact",
			keyword2 = "OSB Koroneiki1",
			keyword3 = "Liferay Account Role",
			table = '''| Updater Name                | Koroneiki QA Service Producer |
	| Update Summary              | Assigned Contact              |
	| Update Description          | OSB Koroneiki1                |
	| Update Date                 | Today                         |
	| Update Field Name           | Contact Role                  |
	| Update Field Original Value | N/A                           |
	| Update Field New Value      | Liferay Account Role          |''');

		ProjectDetails.viewHistoryEntryByThreeKeywords(
			fieldName = "Contact Role",
			keyword1 = "Assigned Contact",
			keyword2 = "OSB Koroneiki1",
			keyword3 = "NonLiferay Optional Role",
			table = '''| Updater Name                | Koroneiki QA Service Producer |
	| Update Summary              | Assigned Contact              |
	| Update Description          | OSB Koroneiki1                |
	| Update Date                 | Today                         |
	| Update Field Name           | Contact Role                  |
	| Update Field Original Value | N/A                           |
	| Update Field New Value      | NonLiferay Optional Role      |''');

		ProjectDetails.viewHistoryEntryByThreeKeywords(
			fieldName = "Contact Role",
			keyword1 = "Assigned Contact",
			keyword2 = "OSB Koroneiki2",
			keyword3 = "NonLiferay Account Role",
			table = '''| Updater Name                | Koroneiki QA Service Producer |
	| Update Summary              | Assigned Contact              |
	| Update Description          | OSB Koroneiki2                |
	| Update Date                 | Today                         |
	| Update Field Name           | Contact Role                  |
	| Update Field Original Value | N/A                           |
	| Update Field New Value      | NonLiferay Account Role       |''');

		ProjectDetails.viewHistoryEntryByThreeKeywords(
			fieldName = "Contact Role",
			keyword1 = "Assigned Contact",
			keyword2 = "OSB Koroneiki2",
			keyword3 = "Liferay Optional Role",
			table = '''| Updater Name                | Koroneiki QA Service Producer |
	| Update Summary              | Assigned Contact              |
	| Update Description          | OSB Koroneiki2                |
	| Update Date                 | Today                         |
	| Update Field Name           | Contact Role                  |
	| Update Field Original Value | N/A                           |
	| Update Field New Value      | Liferay Optional Role         |''');
	}

	test Createcustomercontactswithexistentandnonexistentroles {
		OSBAdminRabbitMQ.generateProvisioningProjectName();

		KoroneikiContactRoleAPI._createContactRoleNestedFieldForNonExistentContactRole(table = '''| Description | This is the Liferay role for accounts |
	| Name        | Liferay Account Role                  |
	| Type        | Account Customer                      |''');

		KoroneikiContactRoleAPI._renameFirstContactRoleNestedFieldVariable();

		KoroneikiContactRoleAPI._createContactRoleNestedFieldForNonExistentContactRole(table = '''| Description | This is the NonLiferay role for accounts |
	| Name        | NonLiferay Account Role                  |
	| Type        | Account Customer                         |''');

		KoroneikiContactRoleAPI._renameSecondContactRoleNestedFieldVariable();

		KoroneikiContactRoleAPI._createContactRole(table = '''| Description | This is the optional Liferay role for accounts |
	| Name        | Liferay Optional Role                          |
	| Type        | Account Customer                               |''');

		KoroneikiContactRoleAPI._createContactRoleNestedField(contactRoleName = "Liferay Optional Role");

		KoroneikiContactRoleAPI._renameThirdContactRoleNestedFieldVariable();

		KoroneikiContactRoleAPI._createContactRole(table = '''| Description | This is the optional NonLiferay role for accounts |
	| Name        | NonLiferay Optional Role                          |
	| Type        | Account Customer                                  |''');

		KoroneikiContactRoleAPI._createContactRoleNestedField(contactRoleName = "NonLiferay Optional Role");

		KoroneikiContactRoleAPI._renameFourthContactRoleNestedFieldVariable();

		KoroneikiContactAPI._createContact(table = '''| Email Address | osb.koroneiki1@lrcustomer.com.broken |
	| First Name    | OSB                                  |
	| Language      | English                              |
	| Last Name     | Koroneiki1                           |''');

		KoroneikiContactAPI._createContact(table = '''| Email Address | osb.koroneiki2@lrcustomer.com.broken |
	| First Name    | OSB                                  |
	| Language      | English                              |
	| Last Name     | Koroneiki2                           |''');

		KoroneikiContactAPI._createCustomerContactNestedFieldWithContactRoleNestedField(
			contactEmailAddress = "osb.koroneiki1@lrcustomer.com.broken",
			contactRolesNestedField = "${staticContactRolesNestedField1},${staticContactRolesNestedField3}");

		KoroneikiContactAPI._renameFirstContactNestedFieldVariable();

		KoroneikiContactAPI._createCustomerContactNestedFieldWithContactRoleNestedField(
			contactEmailAddress = "osb.koroneiki2@lrcustomer.com.broken",
			contactRolesNestedField = "${staticContactRolesNestedField2},${staticContactRolesNestedField4}");

		KoroneikiContactAPI._renameSecondContactNestedFieldVariable();

		KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORONEKORONE                                                | |
	| Contact Email Address | osb.koroneiki1@lrcustomer.com.broken                        | |
	| Contact Nested Field  | ${staticContactsNestedField1},${staticContactsNestedField2} | |
	| Description           | Test osb account on koroneiki                               | |
	| Fax Number            | 555-555-1234                                                | |
	| Name                  | Korone - ${staticProjectName}                               | |
	| Phone Number          | 555-555-5678                                                | |
	| Profile Email Address | osb.koroneiki1@lrcustomer.com.broken                        | |
	| Region                | United States                                               | |
	| Status                | Active                                                      | |
	| Tier                  | T4                                                          | |
	| Website               | www.koroneikicorporation.com                                | |''');

		KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korone - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | true                     | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korone - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | true                     | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		OSBAdmin.loginToSupport(
			userEmailAddress = ${staticSupportAdminEmailAdress},
			userPassword = ${staticSupportAdminPassword});

		ProjectDetails.gotoProjectDetailsPage();

		ProjectDetails.searchKeyword(keyword = "Korone");

		ProjectDetails.gotoProject(projectName = "Korone - ${staticProjectName}");

		ProjectDetails.gotoHistory();

		ProjectDetails.viewHistoryEntryByThreeKeywords(
			fieldName = "Contact Role",
			keyword1 = "Assigned Contact",
			keyword2 = "OSB Koroneiki1",
			keyword3 = "Member",
			table = '''| Updater Name                | Koroneiki QA Service Producer |
	| Update Summary              | Assigned Contact              |
	| Update Description          | OSB Koroneiki1                |
	| Update Date                 | Today                         |
	| Update Field Name           | Contact Role                  |
	| Update Field Original Value | N/A                           |
	| Update Field New Value      | Member                        |''');

		ProjectDetails.viewHistoryEntryByThreeKeywords(
			fieldName = "Contact Role",
			keyword1 = "Assigned Contact",
			keyword2 = "OSB Koroneiki2",
			keyword3 = "Member",
			table = '''| Updater Name                | Koroneiki QA Service Producer |
	| Update Summary              | Assigned Contact              |
	| Update Description          | OSB Koroneiki2                |
	| Update Date                 | Today                         |
	| Update Field Name           | Contact Role                  |
	| Update Field Original Value | N/A                           |
	| Update Field New Value      | Member                        |''');

		ProjectDetails.viewHistoryEntryByThreeKeywords(
			fieldName = "Contact Role",
			keyword1 = "Assigned Contact",
			keyword2 = "OSB Koroneiki1",
			keyword3 = "Liferay Account Role",
			table = '''| Updater Name                | Koroneiki QA Service Producer |
	| Update Summary              | Assigned Contact              |
	| Update Description          | OSB Koroneiki1                |
	| Update Date                 | Today                         |
	| Update Field Name           | Contact Role                  |
	| Update Field Original Value | N/A                           |
	| Update Field New Value      | Liferay Account Role          |''');

		ProjectDetails.viewHistoryEntryByThreeKeywords(
			fieldName = "Contact Role",
			keyword1 = "Assigned Contact",
			keyword2 = "OSB Koroneiki1",
			keyword3 = "Liferay Optional Role",
			table = '''| Updater Name                | Koroneiki QA Service Producer |
	| Update Summary              | Assigned Contact              |
	| Update Description          | OSB Koroneiki1                |
	| Update Date                 | Today                         |
	| Update Field Name           | Contact Role                  |
	| Update Field Original Value | N/A                           |
	| Update Field New Value      | Liferay Optional Role         |''');

		ProjectDetails.viewHistoryEntryByThreeKeywords(
			fieldName = "Contact Role",
			keyword1 = "Assigned Contact",
			keyword2 = "OSB Koroneiki2",
			keyword3 = "NonLiferay Account Role",
			table = '''| Updater Name                | Koroneiki QA Service Producer |
	| Update Summary              | Assigned Contact              |
	| Update Description          | OSB Koroneiki2                |
	| Update Date                 | Today                         |
	| Update Field Name           | Contact Role                  |
	| Update Field Original Value | N/A                           |
	| Update Field New Value      | NonLiferay Account Role       |''');

		ProjectDetails.viewHistoryEntryByThreeKeywords(
			fieldName = "Contact Role",
			keyword1 = "Assigned Contact",
			keyword2 = "OSB Koroneiki2",
			keyword3 = "NonLiferay Optional Role",
			table = '''| Updater Name                | Koroneiki QA Service Producer |
	| Update Summary              | Assigned Contact              |
	| Update Description          | OSB Koroneiki2                |
	| Update Date                 | Today                         |
	| Update Field Name           | Contact Role                  |
	| Update Field Original Value | N/A                           |
	| Update Field New Value      | NonLiferay Optional Role      |''');
	}

	test Createcustomercontactswithexistentandnonexistentrolesvianestedfield {
		OSBAdminRabbitMQ.generateProvisioningProjectName();

		KoroneikiContactAPI._createContact(table = '''| Email Address | osb.koroneiki1@lrcustomer.com.broken |
	| First Name    | OSB                                  |
	| Language      | English                              |
	| Last Name     | Koroneiki1                           |''');

		KoroneikiContactAPI._createContact(table = '''| Email Address | osb.koroneiki2@lrcustomer.com.broken |
	| First Name    | OSB                                  |
	| Language      | English                              |
	| Last Name     | Koroneiki2                           |''');

		KoroneikiContactRoleAPI._createContactRoleNestedFieldForNonExistentContactRole(table = '''| Description | This is the Liferay role for accounts |
	| Name        | Liferay Account Role                  |
	| Type        | Account Customer                      |''');

		KoroneikiContactRoleAPI._renameFirstContactRoleNestedFieldVariable();

		KoroneikiContactRoleAPI._createContactRole(table = '''| Description | This is the NonLiferay role for accounts |
	| Name        | NonLiferay Account Role                  |
	| Type        | Account Customer                         |''');

		KoroneikiContactRoleAPI._createContactRoleNestedField(contactRoleName = "NonLiferay Account Role");

		KoroneikiContactRoleAPI._renameSecondContactRoleNestedFieldVariable();

		KoroneikiContactAPI._createCustomerContactNestedFieldWithContactRoleNestedField(
			contactEmailAddress = "osb.koroneiki1@lrcustomer.com.broken",
			contactRolesNestedField = ${staticContactRolesNestedField1});

		KoroneikiContactAPI._renameFirstContactNestedFieldVariable();

		KoroneikiContactAPI._createCustomerContactNestedFieldWithContactRoleNestedField(
			contactEmailAddress = "osb.koroneiki2@lrcustomer.com.broken",
			contactRolesNestedField = ${staticContactRolesNestedField2});

		KoroneikiContactAPI._renameSecondContactNestedFieldVariable();

		KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORONEKORONE                                                | |
	| Contact Email Address | osb.koroneiki1@lrcustomer.com.broken                        | |
	| Contact Nested Field  | ${staticContactsNestedField1},${staticContactsNestedField2} | |
	| Description           | Test osb account on koroneiki                               | |
	| Fax Number            | 555-555-1234                                                | |
	| Name                  | Korone - ${staticProjectName}                               | |
	| Phone Number          | 555-555-5678                                                | |
	| Profile Email Address | osb.koroneiki1@lrcustomer.com.broken                        | |
	| Region                | United States                                               | |
	| Status                | Active                                                      | |
	| Tier                  | T4                                                          | |
	| Website               | www.koroneikicorporation.com                                | |''');

		KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

