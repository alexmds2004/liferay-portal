definition {

	property testray.main.component.name = "Support QA";
	property type = "provisioning.security";

	setUp {
		Passwords.getPasswords();

		JSONUser.createViaProvisioning(table = '''| Screen Name   | provisioning.admin                    |
	| Email Address | provisioning.admin@liferay.com.broken |
	| First Name    | Provisioning                          |
	| Last Name     | Admin                                 |''');

		JSONUser.assignUserToProvisioningRole(
			roleName = "Provisioning Admin",
			userEmailAddress = "provisioning.admin@liferay.com.broken");
	}

	tearDown {
		OSBAdmin.logoutAndLoginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		Provisioning.gotoProductBundles();

		Provisioning.tearDownProductBundles(table = '''| Visible Products |
	| Changed Products |''');

		KoroneikiProductAPI._tearDownProducts(table = '''| A Visible Product        |
	| A Visible Second Product |
	| A Visible Third Product  |
	| A Visible Fourth Product |''');

		JSONUser.tearDownUsersViaProvisioning(table = '''| provisioning.admin@liferay.com.broken |''');
	}

	test Createproductbundle {
		KoroneikiProductAPI._createProduct(table = '''| Name | A Visible Product | |''');

		KoroneikiProductAPI._createProduct(table = '''| Name | A Visible Second Product | |''');

		OSBAdmin.loginToProvisioning(
			userEmailAddress = "provisioning.admin@liferay.com.broken",
			userPassword = ${staticProvisioningQaUserPassword});

		UserAccount.updatePasswordUponLogin(userPassword = "test");

		Provisioning.gotoProductBundles();

		Provisioning.clickNewProductBundleButton();

		ProvisioningProductBundle.populateProductBundleFormAndSave(table = '''| Name        | Input | Visible Products         |
	| Add Product |       | A Visible Product        |
	| Add Product |       | A Visible Second Product |''');

		Provisioning._viewProductBundleViaIndex(
			productBundleName = "Visible Products",
			table = '''| Name | Visible Products |''');

		Provisioning.clickProductBundle(productBundleName = "Visible Products");

		ProvisioningProductBundle.viewProductViaProductBundle(productName = "A Visible Product");

		ProvisioningProductBundle.viewProductViaProductBundle(productName = "A Visible Second Product");
	}

	test Deleteproductbundle {
		KoroneikiProductAPI._createProduct(table = '''| Name | A Visible Product | |''');

		KoroneikiProductAPI._createProduct(table = '''| Name | A Visible Second Product | |''');

		OSBAdmin.loginToProvisioning(
			userEmailAddress = "provisioning.admin@liferay.com.broken",
			userPassword = ${staticProvisioningQaUserPassword});

		UserAccount.updatePasswordUponLogin(userPassword = "test");

		Provisioning.gotoProductBundles();

		Provisioning.clickNewProductBundleButton();

		ProvisioningProductBundle.populateProductBundleFormAndSave(table = '''| Name        | Input | Visible Products         |
	| Add Product |       | A Visible Product        |
	| Add Product |       | A Visible Second Product |''');

		Provisioning.clickProductBundleDeleteButton(productBundleName = "Visible Products");

		Provisioning._viewNoProductBundleViaIndex(productBundleName = "Visible Products");
	}

	test Updateproductbundle {
		KoroneikiProductAPI._createProduct(table = '''| Name | A Visible Product | |''');

		KoroneikiProductAPI._createProduct(table = '''| Name | A Visible Second Product | |''');

		KoroneikiProductAPI._createProduct(table = '''| Name | A Visible Third Product | |''');

		KoroneikiProductAPI._createProduct(table = '''| Name | A Visible Fourth Product | |''');

		OSBAdmin.loginToProvisioning(
			userEmailAddress = "provisioning.admin@liferay.com.broken",
			userPassword = ${staticProvisioningQaUserPassword});

		UserAccount.updatePasswordUponLogin(userPassword = "test");

		Provisioning.gotoProductBundles();

		Provisioning.clickNewProductBundleButton();

		ProvisioningProductBundle.populateProductBundleFormAndSave(table = '''| Name        | Input | Visible Products         |
	| Add Product |       | A Visible Product        |
	| Add Product |       | A Visible Second Product |''');

		Provisioning.clickProductBundle(productBundleName = "Visible Products");

		ProvisioningProductBundle.populateProductBundleFormAndSave(table = '''| Name           | Input | Changed Products         |
	| Remove Product |       | A Visible Second Product |
	| Add Product    |       | A Visible Third Product  |
	| Remove Product |       | A Visible Product        |
	| Add Product    |       | A Visible Fourth Product |''');

		Provisioning._viewProductBundleViaIndex(
			productBundleName = "Changed Products",
			table = '''| Name | Changed Products |''');

		Provisioning._viewNoProductBundleViaIndex(productBundleName = "Visible Products");

		Provisioning.clickProductBundle(productBundleName = "Changed Products");

		ProvisioningProductBundle.viewProductViaProductBundle(productName = "A Visible Third Product");

		ProvisioningProductBundle.viewProductViaProductBundle(productName = "A Visible Fourth Product");

		ProvisioningProductBundle.viewNoProductViaProductBundle(productName = "A Visible Product");

		ProvisioningProductBundle.viewNoProductViaProductBundle(productName = "A Visible Second Product");
	}

}