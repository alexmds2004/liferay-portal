	tearDown {
		LocalFile.KoroneikiTeamRoleAPI._tearDownTeamRolePermissions(teamRoleName = "Default Account Role");

		LocalFile.KoroneikiTeamRoleAPI._tearDownTeamRolePermissions(teamRoleName = "Optional Account Role");

		LocalFile.KoroneikiTeamRoleAPI._tearDownTeamRoles(table = '''| Default Account Role  |
	| Optional Account Role |''');
	}

	test Createteamroleattempt {
		LocalFile.KoroneikiTeamRoleAPIPermissionCheck._createTeamRoleAttempt(table = '''| Description | This is the default role for accounts |
	| Name        | Default Account Role                  |
	| Type        | Account                               |''');

		LocalFile.KoroneikiTeamRoleAPI._viewNoTeamRole(teamRoleName = "Default Account Role");
	}

