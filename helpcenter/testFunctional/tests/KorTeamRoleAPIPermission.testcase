definition {

	property testray.main.component.name = "Support QA";
	property type = "koroneiki";

	tearDown {
		KoroneikiTeamRoleAPI._tearDownTeamRolePermissions(teamRoleName = "Default Account Role");

		KoroneikiTeamRoleAPI._tearDownTeamRolePermissions(teamRoleName = "Optional Account Role");

		KoroneikiTeamRoleAPI._tearDownTeamRoles(table = '''| Default Account Role  |
	| Optional Account Role |''');
	}

	test Createteamroleattempt {
		KoroneikiTeamRoleAPIPermissionCheck._createTeamRoleAttempt(table = '''| Description | This is the default role for accounts |
	| Name        | Default Account Role                  |
	| Type        | Account                               |''');

		KoroneikiTeamRoleAPI._viewNoTeamRole(teamRoleName = "Default Account Role");
	}

