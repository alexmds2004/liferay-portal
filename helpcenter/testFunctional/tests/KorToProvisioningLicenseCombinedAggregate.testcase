definition {

	property testray.main.component.name = "Support QA";
	property type = "provisioning.license.integration";

	setUp {
		Passwords.getPasswords();
	}

	tearDown {
		ZendeskUserAPI._getDefaultUserId(organizationName = "Korlic - ${staticProjectName}");

		KoroneikiProductConsumptionAPI._tearDownProductConsumptionList(
			accountName = "Korlic - ${staticProjectName}",
			table = '''| DXP Production                   |
	| Portal Production                |
	| DXP Development                  |
	| Commerce Subscription Production |''');

		KoroneikiProductConsumptionAPI._tearDownProductConsumptions(
			accountName = "Korlic - ${staticProjectName}",
			table = '''| DXP OEM                                         |
	| DXP Limited                                     |
	| DXP Non-Production                              |
	| Portal Per User                                 |
	| Commerce Subscription Development               |
	| Commerce Subscription Non-Production            |
	| Commerce Subscription Backup                    |
	| Commerce Subscription Unlimited Enterprise-Wide |''');

		OSBAdminProject.tearDownProjects(table = '''| KORLICKORLIC |''');

		KoroneikiAccountAPI._tearDownAccounts(table = '''| Korlic - ${staticProjectName} |''');

		KoroneikiAccountAPI._tearDownAccountsViaAccountFieldNameAndValue(
			fieldName = "Code",
			table = '''| KORLICKORLIC |''');

		ZendeskOrganizationAPI._getMultipleOrganizationExternalIdsByOrganizationNameIfStillPresent(table = '''| Korlic - ${staticProjectName} |''');

		ZendeskOrganizationAPI._tearDownOrganizationsByExternalIdList(organizationExternalIds = ${staticOrganizationExternalIdList});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId});

		Downloads.teardownDownloadedListedFiles(list = ${staticDownloadedListName});
	}

	test DeleteCommercelicensefromcombinedaggregatelicense {
		OSBAdminRabbitMQ.generateProvisioningProjectName();

		KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORLICKORLIC                         | |
	| Contact Email Address | lic.koroneiki1@lrcustomer.com.broken | |
	| Description           | Test osb account on koroneiki        | |
	| Fax Number            | 555-555-1234                         | |
	| Name                  | Korlic - ${staticProjectName}        | |
	| Phone Number          | 555-555-5678                         | |
	| Profile Email Address | lic.koroneiki1@lrcustomer.com.broken | |
	| Region                | United States                        | |
	| Status                | Active                               | |
	| Tier                  | T4                                   | |
	| Website               | www.koroneikicorporation.com         | |''');

		KoroneikiAccountAPI._generateAccountKey(accountName = "Korlic - ${staticProjectName}");

		KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		KoroneikiProductPurchaseAPI.generateStaticFullStartAndEndDate();

		KoroneikiProductPurchaseAPI.generateStaticFutureStartAndEndDate();

		KoroneikiProductPurchaseAPI.generateStaticFullFutureStartAndEndDate();

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korlic - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| End Date                | ${staticEndDate}         |   |
	| Original End Date       | ${staticOriginalEndDate} |   |
	| Perpetual               | false                    |   |
	| Product Field and Value | sizing                   | 1 |
	| Product Field and Value | licenses                 | 1 |
	| Product Field and Value | version                  | 7 |
	| Quantity                | 3                        |   |
	| Start Date              | ${staticStartDate}       |   |
	| Status                  | Approved                 |   |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korlic - ${staticProjectName}",
			productName = "Commerce Subscription Production",
			table = '''| End Date                | ${staticEndDate}         |   |
	| Original End Date       | ${staticOriginalEndDate} |   |
	| Perpetual               | false                    |   |
	| Product Field and Value | sizing                   | 1 |
	| Product Field and Value | licenses                 | 1 |
	| Product Field and Value | version                  | 0 |
	| Quantity                | 1                        |   |
	| Start Date              | ${staticStartDate}       |   |
	| Status                  | Approved                 |   |''');

		KoroneikiProductPurchaseAPI._generateProductPurchaseId(
			accountName = "Korlic - ${staticProjectName}",
			productName = "DXP Production");

		KoroneikiProductPurchaseAPI._generateProductPurchaseId(
			accountName = "Korlic - ${staticProjectName}",
			productName = "Commerce Subscription Production");

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korlic - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		Provisioning.gotoLicenses();

		Provisioning.clickGenerateLicenseButton();

		ProvisioningLicense.populateGenerateLicenseForm(table = '''| Account | Select Entity | Korlic - ${staticProjectName} | |
	| Product | Select        | DXP Production                | |
	| Version | Select        | 7.2                           | |
	| Type    | Select        | DXP Production                | |''');

		ProvisioningLicense.clickChooseProductPurchaseButton(positionValue = 1);

		ProvisioningLicense.populateGenerateLicenseForm(table = '''| Name          | Input    | License1Name        | |
	| Description   | Input    | Korlic - ${staticProjectName} License1 Description | |
	| Host Name     | Input    | localhost                                          | |
	| IP Addresses  | Textarea | 123.45.67.89                                       | |
	| MAC Addresses | Textarea | 0A-1B-2C-3D-4E-5F                                  | |''');

		ProvisioningLicense.clickGenerateLicenseButton();

		ProvisioningLicense.viewLicense(table = '''| Header  | Korlic - ${staticProjectName} | |
	| Product | DXP Production                | |''');

		ProvisioningLicense.getLicenseKeyIdViaLicenseDetails();

		ProvisioningLicense._renameFirstLicenseKeyIdVariable();

		Provisioning.gotoLicenses();

		Provisioning.clickGenerateLicenseButton();

		ProvisioningLicense.populateGenerateLicenseForm(table = '''| Account | Select Entity | Korlic - ${staticProjectName}    | |
	| Product | Select        | Commerce Subscription Production | |
	| Version | Select        | 1                                | |
	| Type    | Select        | Commerce Subscription Production | |''');

		ProvisioningLicense.clickChooseProductPurchaseButton(positionValue = 1);

		ProvisioningLicense.populateGenerateLicenseForm(table = '''| Name          | Input    | License2Name        | |
	| Description   | Input    | Korlic - ${staticProjectName} License2 Description | |
	| Host Name     | Input    | localhost                                          | |
	| IP Addresses  | Textarea | 123.45.67.89                                       | |
	| MAC Addresses | Textarea | 0A-1B-2C-3D-4E-5F                                  | |''');

		ProvisioningLicense.clickGenerateLicenseButton();

		ProvisioningLicense.viewLicense(table = '''| Header  | Korlic - ${staticProjectName}    | |
	| Product | Commerce Subscription Production | |''');

		ProvisioningLicense.getLicenseKeyIdViaLicenseDetails();

		ProvisioningLicense._renameSecondLicenseKeyIdVariable();

		Provisioning.gotoAccounts();

		Provisioning.searchAccounts(keyword = "Korlic");

		Provisioning.clickAccount(accountName = "Korlic - ${staticProjectName}");

		Provisioning.clickTab(tabName = "Licenses");

		ProvisioningAccount.selectLicensesViaLicensesTab(table = '''| License1Name |
	| License2Name |''');

		ProvisioningAccount.clickLicensesActionDropdownButton(action = "Download");

		ProvisioningLicense.clickDeleteLicenseButtonViaDownloadLicensePage(licenseKeyword = "License2Name");

		ProvisioningLicense._viewNoLicenseViaDownloadLicensePage(licenseKeyword = "License2Name");

		ProvisioningLicense._viewLicenseViaDownloadLicensePage(
			licenseKeyword = "License1Name",
			table = '''| Name        | License1Name        |
	| Description | Korlic - ${staticProjectName} License1 Description |
	| Product     | DXP Production                                     |
	| Type        | DXP Production                                     |
	| Status      | ACTIVE                                             |''');

		ProvisioningLicense.viewDisabledDeleteLicenseButtonViaDownloadLicensePage(licenseKeyword = "License1Name");

		ProvisioningLicense.viewDownloadLicenseButtonViaDownloadLicensePage(table = '''| ${staticLicenseKeyId1} |''');

		ProvisioningLicense.viewNoDownloadLicenseButtonViaDownloadLicensePage(table = '''| ${staticLicenseKeyId2} |''');

		ProvisioningLicense.viewNoDownloadLicenseButtonViaDownloadLicensePage(table = '''| ${staticLicenseKeyId2} |
	| ${staticLicenseKeyId1} |''');
	}

	test DeleteCommercelicensefromnewDXPaggregatelicenseandCommerceProductionnonaggregatelicensesandcombinedaggregatelicense {
		OSBAdminRabbitMQ.generateProvisioningProjectName();

		KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORLICKORLIC                         | |
	| Contact Email Address | lic.koroneiki1@lrcustomer.com.broken | |
	| Description           | Test osb account on koroneiki        | |
	| Fax Number            | 555-555-1234                         | |
	| Name                  | Korlic - ${staticProjectName}        | |
	| Phone Number          | 555-555-5678                         | |
	| Profile Email Address | lic.koroneiki1@lrcustomer.com.broken | |
	| Region                | United States                        | |
	| Status                | Active                               | |
	| Tier                  | T4                                   | |
	| Website               | www.koroneikicorporation.com         | |''');

		KoroneikiAccountAPI._generateAccountKey(accountName = "Korlic - ${staticProjectName}");

		KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		KoroneikiProductPurchaseAPI.generateStaticFullStartAndEndDate();

		KoroneikiProductPurchaseAPI.generateStaticFutureStartAndEndDate();

		KoroneikiProductPurchaseAPI.generateStaticFullFutureStartAndEndDate();

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korlic - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| End Date                | ${staticEndDate}         |   |
	| Original End Date       | ${staticOriginalEndDate} |   |
	| Perpetual               | false                    |   |
	| Product Field and Value | sizing                   | 2 |
	| Product Field and Value | licenses                 | 2 |
	| Product Field and Value | version                  | 7 |
	| Quantity                | 2                        |   |
	| Start Date              | ${staticStartDate}       |   |
	| Status                  | Approved                 |   |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korlic - ${staticProjectName}",
			productName = "Commerce Subscription Production",
			table = '''| End Date                | ${staticEndDate}         |   |
	| Original End Date       | ${staticOriginalEndDate} |   |
	| Perpetual               | false                    |   |
	| Product Field and Value | sizing                   | 2 |
	| Product Field and Value | licenses                 | 2 |
	| Product Field and Value | version                  | 0 |
	| Quantity                | 2                        |   |
	| Start Date              | ${staticStartDate}       |   |
	| Status                  | Approved                 |   |''');

		KoroneikiProductPurchaseAPI._generateProductPurchaseId(
			accountName = "Korlic - ${staticProjectName}",
			productName = "DXP Production");

		KoroneikiProductPurchaseAPI._generateProductPurchaseId(
			accountName = "Korlic - ${staticProjectName}",
			productName = "Commerce Subscription Production");

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korlic - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		Provisioning.gotoLicenses();

		Provisioning.clickGenerateLicenseButton();

		ProvisioningLicense.populateGenerateLicenseForm(table = '''| Account | Select Entity | Korlic - ${staticProjectName} | |
	| Product | Select        | DXP Production                | |
	| Version | Select        | 7.2                           | |
	| Type    | Select        | DXP Production                | |''');

		ProvisioningLicense.clickChooseProductPurchaseButton(positionValue = 1);

		ProvisioningLicense.populateGenerateLicenseForm(table = '''| Name          | Input    | License1Name        | |
	| Description   | Input    | Korlic - ${staticProjectName} License1 Description | |
	| Host Name     | Input    | localhost                                          | |
	| IP Addresses  | Textarea | 123.45.67.89                                       | |
	| MAC Addresses | Textarea | 0A-1B-2C-3D-4E-5F                                  | |''');

		ProvisioningLicense.clickGenerateLicenseButton();

		ProvisioningLicense.viewLicense(table = '''| Header  | Korlic - ${staticProjectName} | |
	| Product | DXP Production                | |''');

		ProvisioningLicense.getLicenseKeyIdViaLicenseDetails();

		ProvisioningLicense._renameFirstLicenseKeyIdVariable();

		Provisioning.gotoLicenses();

		Provisioning.clickGenerateLicenseButton();

		ProvisioningLicense.populateGenerateLicenseForm(table = '''| Account | Select Entity | Korlic - ${staticProjectName} | |
	| Product | Select        | DXP Production                | |
	| Version | Select        | 7.2                           | |
	| Type    | Select        | DXP Production                | |''');

		ProvisioningLicense.clickChooseProductPurchaseButton(positionValue = 1);

		ProvisioningLicense.populateGenerateLicenseForm(table = '''| Name          | Input    | License2Name        | |
	| Description   | Input    | Korlic - ${staticProjectName} License2 Description | |
	| Host Name     | Input    | localhost                                          | |
	| IP Addresses  | Textarea | 123.45.67.89                                       | |
	| MAC Addresses | Textarea | 0A-1B-2C-3D-4E-5F                                  | |''');

		ProvisioningLicense.clickGenerateLicenseButton();

		ProvisioningLicense.viewLicense(table = '''| Header  | Korlic - ${staticProjectName} | |
	| Product | DXP Production                | |''');

		ProvisioningLicense.getLicenseKeyIdViaLicenseDetails();

		ProvisioningLicense._renameSecondLicenseKeyIdVariable();

		Provisioning.gotoLicenses();

		Provisioning.clickGenerateLicenseButton();

		ProvisioningLicense.populateGenerateLicenseForm(table = '''| Account | Select Entity | Korlic - ${staticProjectName}    | |
	| Product | Select        | Commerce Subscription Production | |
	| Version | Select        | 1                                | |
	| Type    | Select        | Commerce Subscription Production | |''');

		ProvisioningLicense.clickChooseProductPurchaseButton(positionValue = 1);

		ProvisioningLicense.populateGenerateLicenseForm(table = '''| Name          | Input    | License3Name        | |
	| Description   | Input    | Korlic - ${staticProjectName} License3 Description | |
	| Host Name     | Input    | localhost                                          | |
	| IP Addresses  | Textarea | 123.45.67.89                                       | |
	| MAC Addresses | Textarea | 0A-1B-2C-3D-4E-5F                                  | |''');

		ProvisioningLicense.clickGenerateLicenseButton();

		ProvisioningLicense.viewLicense(table = '''| Header  | Korlic - ${staticProjectName}    | |
	| Product | Commerce Subscription Production | |''');

		ProvisioningLicense.getLicenseKeyIdViaLicenseDetails();

		ProvisioningLicense._renameThirdLicenseKeyIdVariable();

		Provisioning.gotoLicenses();

		Provisioning.clickGenerateLicenseButton();

		ProvisioningLicense.populateGenerateLicenseForm(table = '''| Account | Select Entity | Korlic - ${staticProjectName}    | |
	| Product | Select        | Commerce Subscription Production | |
	| Version | Select        | 1                                | |
	| Type    | Select        | Commerce Subscription Production | |''');

		ProvisioningLicense.clickChooseProductPurchaseButton(positionValue = 1);

		ProvisioningLicense.populateGenerateLicenseForm(table = '''| Name          | Input    | License4Name        | |
	| Description   | Input    | Korlic - ${staticProjectName} License4 Description | |
	| Host Name     | Input    | localhost                                          | |
	| IP Addresses  | Textarea | 123.45.67.89                                       | |
	| MAC Addresses | Textarea | 0A-1B-2C-3D-4E-5F                                  | |''');

		ProvisioningLicense.clickGenerateLicenseButton();

		ProvisioningLicense.viewLicense(table = '''| Header  | Korlic - ${staticProjectName}    | |
	| Product | Commerce Subscription Production | |''');

		ProvisioningLicense.getLicenseKeyIdViaLicenseDetails();

		ProvisioningLicense._renameFourthLicenseKeyIdVariable();

		Provisioning.gotoAccounts();

		Provisioning.searchAccounts(keyword = "Korlic");

		Provisioning.clickAccount(accountName = "Korlic - ${staticProjectName}");

		Provisioning.clickTab(tabName = "Licenses");

		ProvisioningAccount.selectLicensesViaLicensesTab(table = '''| License1Name |
	| License2Name |
	| License3Name |
	| License4Name |''');

		ProvisioningAccount.clickLicensesActionDropdownButton(action = "Download");

		ProvisioningLicense.clickDeleteLicenseButtonViaDownloadLicensePage(licenseKeyword = "License3Name");

		ProvisioningLicense._viewNoLicenseViaDownloadLicensePage(licenseKeyword = "License3Name");

		ProvisioningLicense._viewLicenseViaDownloadLicensePage(
			licenseKeyword = "License1Name",
			table = '''| Name        | License1Name        |
	| Description | Korlic - ${staticProjectName} License1 Description |
	| Version     | 7.2                                                |
	| Product     | DXP Production                                     |
	| Type        | DXP Production                                     |
	| Status      | ACTIVE                                             |''');

		ProvisioningLicense._viewLicenseViaDownloadLicensePage(
			licenseKeyword = "License2Name",
			table = '''| Name        | License2Name        |
	| Description | Korlic - ${staticProjectName} License2 Description |
	| Version     | 7.2                                                |
	| Product     | DXP Production                                     |
	| Type        | DXP Production                                     |
	| Status      | ACTIVE                                             |''');

		ProvisioningLicense._viewLicenseViaDownloadLicensePage(
			licenseKeyword = "License4Name",
			table = '''| Name        | License4Name        |
	| Description | Korlic - ${staticProjectName} License4 Description |
	| Product     | Commerce Subscription Production                   |
	| Type        | Commerce Subscription Production                   |
	| Status      | ACTIVE                                             |''');

		ProvisioningLicense.viewNoDisabledDeleteLicenseButtonViaDownloadLicensePage(licenseKeyword = "License1Name");

		ProvisioningLicense.viewNoDisabledDeleteLicenseButtonViaDownloadLicensePage(licenseKeyword = "License2Name");

		ProvisioningLicense.viewNoDisabledDeleteLicenseButtonViaDownloadLicensePage(licenseKeyword = "License4Name");

		ProvisioningLicense.viewDownloadLicenseButtonViaDownloadLicensePage(table = '''| ${staticLicenseKeyId4} |''');

		ProvisioningLicense.viewDownloadLicenseButtonViaDownloadLicensePage(table = '''| ${staticLicenseKeyId1} |
	| ${staticLicenseKeyId2} |''');

		ProvisioningLicense.viewNoDownloadLicenseButtonViaDownloadLicensePage(table = '''| ${staticLicenseKeyId3} |''');

		ProvisioningLicense.viewNoDownloadLicenseButtonViaDownloadLicensePage(table = '''| ${staticLicenseKeyId4} |
	| ${staticLicenseKeyId3} |
	| ${staticLicenseKeyId2} |
	| ${staticLicenseKeyId1} |''');
	}

	test DeleteCommercelicensefromnewDXPProductionandVirtualClusternonaggregatelicensesandCommerceProductionandVirtualClusternonaggregatelicensesandcombinedaggregatelicenses {
		OSBAdminRabbitMQ.generateProvisioningProjectName();

		KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORLICKORLIC                         | |
	| Contact Email Address | lic.koroneiki1@lrcustomer.com.broken | |
	| Description           | Test osb account on koroneiki        | |
	| Fax Number            | 555-555-1234                         | |
	| Name                  | Korlic - ${staticProjectName}        | |
	| Phone Number          | 555-555-5678                         | |
	| Profile Email Address | lic.koroneiki1@lrcustomer.com.broken | |
	| Region                | United States                        | |
	| Status                | Active                               | |
	| Tier                  | T4                                   | |
	| Website               | www.koroneikicorporation.com         | |''');

		KoroneikiAccountAPI._generateAccountKey(accountName = "Korlic - ${staticProjectName}");

		KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		KoroneikiProductPurchaseAPI.generateStaticFullStartAndEndDate();

		KoroneikiProductPurchaseAPI.generateStaticFutureStartAndEndDate();

		KoroneikiProductPurchaseAPI.generateStaticFullFutureStartAndEndDate();

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korlic - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| End Date                | ${staticEndDate}         |   |
	| Original End Date       | ${staticOriginalEndDate} |   |
	| Perpetual               | false                    |   |
	| Product Field and Value | sizing                   | 2 |
	| Product Field and Value | licenses                 | 2 |
	| Product Field and Value | version                  | 7 |
	| Quantity                | 10                       |   |
	| Start Date              | ${staticStartDate}       |   |
	| Status                  | Approved                 |   |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korlic - ${staticProjectName}",
			productName = "Commerce Subscription Production",
			table = '''| End Date                | ${staticEndDate}         |   |
	| Original End Date       | ${staticOriginalEndDate} |   |
	| Perpetual               | false                    |   |
	| Product Field and Value | sizing                   | 2 |
	| Product Field and Value | licenses                 | 2 |
	| Product Field and Value | version                  | 0 |
	| Quantity                | 10                       |   |
	| Start Date              | ${staticStartDate}       |   |
	| Status                  | Approved                 |   |''');

		KoroneikiProductPurchaseAPI._generateProductPurchaseId(
			accountName = "Korlic - ${staticProjectName}",
			productName = "DXP Production");

		KoroneikiProductPurchaseAPI._generateProductPurchaseId(
			accountName = "Korlic - ${staticProjectName}",
			productName = "Commerce Subscription Production");

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korlic - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

