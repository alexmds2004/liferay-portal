definition {

	property testray.main.component.name = "Support QA";
	property type = "provisioning.product.integration";

	setUp {
		Passwords.getPasswords();
	}

	tearDown {
		OSBAdmin.logoutAndLoginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		Provisioning.gotoProductBundles();

		Provisioning.tearDownProductBundles(table = '''| Bundled Products |
	| Updated Products |''');

		KoroneikiProductAPI._tearDownProducts(table = '''| A Bundled Product        |
	| A Bundled Second Product |
	| A Bundled Third Product  |
	| A Bundled Fourth Product |''');
	}

	test Createproductbundle {
		property help.center.acceptance = "true";

		KoroneikiProductAPI._createProduct(table = '''| Name | A Bundled Product | |''');

		KoroneikiProductAPI._createProduct(table = '''| Name | A Bundled Second Product | |''');

		OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		Provisioning.gotoProductBundles();

		Provisioning.clickNewProductBundleButton();

		ProvisioningProductBundle.populateProductBundleFormAndSave(table = '''| Name        | Input | Bundled Products         |
	| Add Product |       | A Bundled Product        |
	| Add Product |       | A Bundled Second Product |''');

		Provisioning._viewProductBundleViaIndex(
			productBundleName = "Bundled Products",
			table = '''| Name | Bundled Products |''');

		Provisioning.clickProductBundle(productBundleName = "Bundled Products");

		ProvisioningProductBundle.viewProductViaProductBundle(productName = "A Bundled Product");

		ProvisioningProductBundle.viewProductViaProductBundle(productName = "A Bundled Second Product");
	}

	test Deletebundledproductviakoroneiki {
		KoroneikiProductAPI._createProduct(table = '''| Name | A Bundled Product | |''');

		KoroneikiProductAPI._createProduct(table = '''| Name | A Bundled Second Product | |''');

		OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		Provisioning.gotoProductBundles();

		Provisioning.clickNewProductBundleButton();

		ProvisioningProductBundle.populateProductBundleFormAndSave(table = '''| Name        | Input | Bundled Products         |
	| Add Product |       | A Bundled Product        |
	| Add Product |       | A Bundled Second Product |''');

		Provisioning._viewProductBundleViaIndex(
			productBundleName = "Bundled Products",
			table = '''| Name | Bundled Products |''');

		KoroneikiProductAPI._deleteProduct(productName = "A Bundled Product");

		KoroneikiProductAPI._deleteProduct(productName = "A Bundled Second Product");

		Provisioning.gotoProductBundles();

		Provisioning.clickProductBundle(productBundleName = "Bundled Products");

		ProvisioningProductBundle.viewNoProductViaProductBundle(productName = "A Bundled Product");

		ProvisioningProductBundle.viewNoProductViaProductBundle(productName = "A Bundled Second Product");

		Provisioning.gotoProducts();

		Provisioning.searchProducts(keyword = "A");

		Provisioning._viewNoProductViaIndex(productName = "A Bundled Product");

		Provisioning._viewNoProductViaIndex(productName = "A Bundled Second Product");

		KoroneikiProductAPI._viewNoProduct(productName = "A Bundled Product");

		KoroneikiProductAPI._viewNoProduct(productName = "A Bundled Second Product");
	}

	test Deletebundledproductviaprovisioning {
		KoroneikiProductAPI._createProduct(table = '''| Name | A Bundled Product | |''');

		KoroneikiProductAPI._createProduct(table = '''| Name | A Bundled Second Product | |''');

		OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		Provisioning.gotoProductBundles();

		Provisioning.clickNewProductBundleButton();

		ProvisioningProductBundle.populateProductBundleFormAndSave(table = '''| Name        | Input | Bundled Products         |
	| Add Product |       | A Bundled Product        |
	| Add Product |       | A Bundled Second Product |''');

		Provisioning._viewProductBundleViaIndex(
			productBundleName = "Bundled Products",
			table = '''| Name | Bundled Products |''');

		Provisioning.gotoProducts();

		Provisioning.searchProducts(keyword = "A");

		Provisioning.clickProductDeleteButton(productName = "A Bundled Product");

		Provisioning.viewProductIndexProductBundleErrorMessage();

		Provisioning.searchProducts(keyword = "A");

		Provisioning.clickProductDeleteButton(productName = "A Bundled Second Product");

		Provisioning.viewProductIndexProductBundleErrorMessage();

		Provisioning.gotoProductBundles();

		Provisioning.clickProductBundle(productBundleName = "Bundled Products");

		ProvisioningProductBundle.viewProductViaProductBundle(productName = "A Bundled Product");

		ProvisioningProductBundle.viewProductViaProductBundle(productName = "A Bundled Second Product");
	}

	test Deleteproductbundle {
		property help.center.acceptance = "true";

		KoroneikiProductAPI._createProduct(table = '''| Name | A Bundled Product | |''');

		KoroneikiProductAPI._createProduct(table = '''| Name | A Bundled Second Product | |''');

		OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		Provisioning.gotoProductBundles();

		Provisioning.clickNewProductBundleButton();

		ProvisioningProductBundle.populateProductBundleFormAndSave(table = '''| Name        | Input | Bundled Products         |
	| Add Product |       | A Bundled Product        |
	| Add Product |       | A Bundled Second Product |''');

		Provisioning.clickProductBundleDeleteButton(productBundleName = "Bundled Products");

		Provisioning._viewNoProductBundleViaIndex(productBundleName = "Bundled Products");
	}

	test Updatebundledproductviakoroneiki {
		KoroneikiProductAPI._createProduct(table = '''| Name | A Bundled Product | |''');

		KoroneikiProductAPI._createProduct(table = '''| Name | A Bundled Second Product | |''');

		OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		Provisioning.gotoProductBundles();

		Provisioning.clickNewProductBundleButton();

		ProvisioningProductBundle.populateProductBundleFormAndSave(table = '''| Name        | Input | Bundled Products         |
	| Add Product |       | A Bundled Product        |
	| Add Product |       | A Bundled Second Product |''');

		KoroneikiProductAPI.updateProduct(
			productName = "A Bundled Product",
			table = '''| Name | A Bundled Third Product | |''');

		KoroneikiProductAPI.updateProduct(
			productName = "A Bundled Second Product",
			table = '''| Name | A Bundled Fourth Product | |''');

		Provisioning.clickProductBundle(productBundleName = "Bundled Products");

		ProvisioningProductBundle.viewProductViaProductBundle(productName = "A Bundled Third Product");

		ProvisioningProductBundle.viewProductViaProductBundle(productName = "A Bundled Fourth Product");

		ProvisioningProductBundle.viewNoProductViaProductBundle(productName = "A Bundled Product");

		ProvisioningProductBundle.viewNoProductViaProductBundle(productName = "A Bundled Second Product");
	}

	test Updatebundledproductviaprovisioning {
		KoroneikiProductAPI._createProduct(table = '''| Name | A Bundled Product | |''');

		KoroneikiProductAPI._createProduct(table = '''| Name | A Bundled Second Product | |''');

		OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		Provisioning.gotoProductBundles();

		Provisioning.clickNewProductBundleButton();

		ProvisioningProductBundle.populateProductBundleFormAndSave(table = '''| Name        | Input | Bundled Products         |
	| Add Product |       | A Bundled Product        |
	| Add Product |       | A Bundled Second Product |''');

		Provisioning._viewProductBundleViaIndex(
			productBundleName = "Bundled Products",
			table = '''| Name | Bundled Products |''');

		Provisioning.gotoProducts();

		Provisioning.searchProducts(keyword = "A");

		Provisioning.clickProduct(productName = "A Bundled Product");

		ProvisioningProduct.populateProductFormAndSave(table = '''| Name | Input  | A Bundled Third Product |
	| Type | Select | Primary                 |''');

		Provisioning.searchProducts(keyword = "A");

		Provisioning._viewProductViaIndex(
			productName = "A Bundled Third Product",
			table = '''| Name | A Bundled Third Product |''');

		Provisioning.searchProducts(keyword = "A");

		Provisioning.clickProduct(productName = "A Bundled Second Product");

		ProvisioningProduct.populateProductFormAndSave(table = '''| Name | Input  | A Bundled Fourth Product |
	| Type | Select | Primary                  |''');

		Provisioning.searchProducts(keyword = "A");

		Provisioning._viewProductViaIndex(
			productName = "A Bundled Fourth Product",
			table = '''| Name | A Bundled Fourth Product |''');

		Provisioning.gotoProductBundles();

		Provisioning.clickProductBundle(productBundleName = "Bundled Products");

		ProvisioningProductBundle.viewProductViaProductBundle(productName = "A Bundled Third Product");

		ProvisioningProductBundle.viewProductViaProductBundle(productName = "A Bundled Fourth Product");

		ProvisioningProductBundle.viewNoProductViaProductBundle(productName = "A Bundled Product");

		ProvisioningProductBundle.viewNoProductViaProductBundle(productName = "A Bundled Second Product");
	}

	test Updateproductbundle {
		property help.center.acceptance = "true";

		KoroneikiProductAPI._createProduct(table = '''| Name | A Bundled Product | |''');

		KoroneikiProductAPI._createProduct(table = '''| Name | A Bundled Second Product | |''');

		KoroneikiProductAPI._createProduct(table = '''| Name | A Bundled Third Product | |''');

		KoroneikiProductAPI._createProduct(table = '''| Name | A Bundled Fourth Product | |''');

		OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		Provisioning.gotoProductBundles();

		Provisioning.clickNewProductBundleButton();

		ProvisioningProductBundle.populateProductBundleFormAndSave(table = '''| Name        | Input | Bundled Products         |
	| Add Product |       | A Bundled Product        |
	| Add Product |       | A Bundled Second Product |''');

		Provisioning.clickProductBundle(productBundleName = "Bundled Products");

		ProvisioningProductBundle.populateProductBundleFormAndSave(table = '''| Name           | Input | Updated Products         |
	| Remove Product |       | A Bundled Second Product |
	| Add Product    |       | A Bundled Third Product  |
	| Remove Product |       | A Bundled Product        |
	| Add Product    |       | A Bundled Fourth Product |''');

		Provisioning._viewProductBundleViaIndex(
			productBundleName = "Updated Products",
			table = '''| Name | Updated Products |''');

		Provisioning._viewNoProductBundleViaIndex(productBundleName = "Bundled Products");

		Provisioning.clickProductBundle(productBundleName = "Updated Products");

		ProvisioningProductBundle.viewProductViaProductBundle(productName = "A Bundled Third Product");

		ProvisioningProductBundle.viewProductViaProductBundle(productName = "A Bundled Fourth Product");

		ProvisioningProductBundle.viewNoProductViaProductBundle(productName = "A Bundled Product");

		ProvisioningProductBundle.viewNoProductViaProductBundle(productName = "A Bundled Second Product");
	}

}