definition {

	property testray.main.component.name = "Support QA";
	property type = "customer.portal";

	setUp {
		Passwords.getPasswords();

		OSBAdminRabbitMQ.generateProvisioningProjectName();

		OSBAdminRabbitMQ.generateProvisioningCompanyName();

		JSONOkta.createOktaUser(table = '''| Screen Name   | pjd.customer1                       |
	| Email Address | pjd.customer1@lrcustomer.com.broken |
	| First Name    | PJD                                 |
	| Last Name     | Customer1                           |''');

		JSONOkta.createOktaUser(table = '''| Screen Name   | pjd.customer2                       |
	| Email Address | pjd.customer2@lrcustomer.com.broken |
	| First Name    | PJD                                 |
	| Last Name     | Customer2                           |''');

		JSONOkta.createOktaUser(table = '''| Screen Name   | pjd.partner1                      |
	| Email Address | pjd.partner1@lrpartner.com.broken |
	| First Name    | PJD                               |
	| Last Name     | Partner1                          |''');

		KoroneikiAccountAPI._createAccount(table = '''| Name   | Zenpar - ${staticCompanyName} | |
	| Code   | ZENPARZENPAR                  | |
	| Status | Active                        | |''');

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Zenpar - ${staticCompanyName}",
			contactEmailAddress = "pjd.partner1@lrpartner.com.broken",
			table = '''| Partner Manager |''');

		KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Zenpar - ${staticCompanyName}",
			productName = "Service Partnership",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiAccountAPI._createAssignedTeamNestedField(
			accountName = "Pjdzen - ${staticProjectName}",
			teamName = "Zenpar - ${staticCompanyName}");

		KoroneikiAccountAPI._createAccount(table = '''| Assigned Team Nested Field | ${staticAssignedTeamNestedField} | |
	| Code                       | PJDZENPJDZEN                     | |
	| Name                       | Pjdzen - ${staticProjectName}    | |
	| Region                     | United States                    | |
	| Status                     | Active                           | |
	| Tier                       | T1                               | |''');

		KoroneikiAccountAPI._assignTeamRolesToTeam(
			accountName = "Pjdzen - ${staticProjectName}",
			table = '''| Partner |''',
			teamName = "Zenpar - ${staticCompanyName}");

		KoroneikiAccountAPI._assignTeamRolesToTeam(
			accountName = "Pjdzen - ${staticProjectName}",
			table = '''| First Line Support |''',
			teamName = "Zenpar - ${staticCompanyName}");

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Pjdzen - ${staticProjectName}",
			contactEmailAddress = "pjd.customer1@lrcustomer.com.broken",
			table = '''| Support Requester |''');

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Pjdzen - ${staticProjectName}",
			contactEmailAddress = "pjd.customer2@lrcustomer.com.broken",
			table = '''| Support User |''');

		KoroneikiAccountAPI._createAccount(table = '''| Code   | DUPZENDUPZEN                     | |
	| Name   | Dupzen - ${staticProjectName}    | |
	| Region | United States                    | |
	| Status | Active                           | |
	| Tier   | T1                               | |''');
	}

	tearDown {
		ZendeskUserAPI._getDefaultUserId(organizationName = "Pjdzen - ${staticProjectName}");

		ZendeskUserAPI._renameFirstDefaultUserIdVariable();

		ZendeskUserAPI._getDefaultUserId(organizationName = "Dupzen - ${staticProjectName}");

		ZendeskUserAPI._renameSecondDefaultUserIdVariable();

		ZendeskUserAPI._getDefaultUserId(organizationName = "Zenpar - ${staticCompanyName}");

		ZendeskUserAPI._renameThirdDefaultUserIdVariable();

		OSBAdminProject.tearDownProjects(table = '''| ZENPARZENPAR |
	| PJDZENPJDZEN |
	| DUPZENDUPZEN |''');

		KoroneikiAccountAPI._tearDownAccounts(table = '''| Zenpar - ${staticCompanyName} |
	| Pjdzen - ${staticProjectName} |
	| Dupzen - ${staticProjectName} |''');

		KoroneikiAccountAPI._tearDownAccountsViaAccountFieldNameAndValue(
			fieldName = "Code",
			table = '''| ZENPARZENPAR |
	| PJDZENPJDZEN |
	| DUPZENDUPZEN |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		JSONUser.tearDownUsers(table = '''| pjd.customer1@lrcustomer.com.broken |
	| pjd.customer2@lrcustomer.com.broken |
	| pjd.partner1@lrpartner.com.broken   |''');

		JSONUser.tearDownUsersViaSupport(table = '''| pjd.customer1@lrcustomer.com.broken |
	| pjd.customer2@lrcustomer.com.broken |
	| pjd.partner1@lrpartner.com.broken   |''');

		JSONUser.tearDownUsersViaKoroneiki(table = '''| pjd.customer1@lrcustomer.com.broken |
	| pjd.customer2@lrcustomer.com.broken |
	| pjd.partner1@lrpartner.com.broken   |''');

		KoroneikiContactAPI._tearDownContacts(table = '''| pjd.customer1@lrcustomer.com.broken |
	| pjd.customer2@lrcustomer.com.broken |
	| pjd.partner1@lrpartner.com.broken   |''');

		JSONOkta.tearDownUsers(table = '''| pjd.customer1@lrcustomer.com.broken |
	| pjd.customer2@lrcustomer.com.broken |
	| pjd.partner1@lrpartner.com.broken   |''');

		ZendeskUserAPI._getMultipleUserIdsByEmailAddress(table = '''| pjd.customer1@lrcustomer.com.broken |
	| pjd.customer2@lrcustomer.com.broken |
	| pjd.partner1@lrpartner.com.broken   |''');

		ZendeskUserAPI._tearDownUsersByIdList(userIds = ${staticUserIdList});

		ZendeskOrganizationAPI._getMultipleOrganizationExternalIdsByOrganizationNameIfStillPresent(table = '''| Zenpar - ${staticCompanyName} |
	| Pjdzen - ${staticProjectName} |
	| Dupzen - ${staticProjectName} |''');

		ZendeskOrganizationAPI._tearDownOrganizationsByExternalIdList(organizationExternalIds = ${staticOrganizationExternalIdList});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId1});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId2});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId3});

		OSBAdmin.logoutAndLoginToSupport(
			userEmailAddress = "amos.fong@liferay.com.broken",
			userPassword = "test");

		OSBAdminProject.removeNonSourceCodeAccessUsersFromGitHub();
	}

	test Addduplicatesourcecodeaccessuser {
		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Pjdzen - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Pjdzen - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		JSONOSBAccount.viewSupportOrganizationSync(accountCode = "PJDZENPJDZEN");

		OSBAdmin.loginToSupport(
			userEmailAddress = ${staticSupportAdminEmailAdress},
			userPassword = ${staticSupportAdminPassword});

		ProjectDetails.gotoProjectDetailsPage();

		ProjectDetails.searchProject(projectName = "Pjdzen - ${staticProjectName}");

		ProjectDetails.gotoProject(projectName = "Pjdzen - ${staticProjectName}");

		ProjectDetails.gotoSourceCodeAccess();

		ProjectDetails.addSourceCodeAccessUser(table = '''| Name            | Info Services QA           |
	| Email Address   | info.services.qa@gmail.com |
	| GitHub Username | infoservicesqa             |''');

		ProjectDetails.viewSourceCodeAccessUserPanel(
			table = '''| Name            | Info Services QA           |
	| Email Address   | info.services.qa@gmail.com |
	| GitHub Username | infoservicesqa             |''',
			userEmailAddress = "info.services.qa@gmail.com");

		ProjectDetails.viewSourceCodeAccessUserDetails(
			table = '''| Name            | Info Services QA           |
	| Email Address   | info.services.qa@gmail.com |
	| GitHub Username | infoservicesqa             |''',
			userEmailAddress = "info.services.qa@gmail.com");

		ZendeskHomepage.pause(timeInSeconds = 30);

		GitHub.acceptGitHubInvitation(
			userGitHubUsername = "infoservicesqa",
			userPassword = "rejoicealways123");

		GitHub.viewISSupportIntegrationGitHubRespository(
			userGitHubUsername = "infoservicesqa",
			userPassword = "rejoicealways123");

		ProjectDetails.gotoProjectDetailsPage();

		ProjectDetails.searchProject(projectName = "Pjdzen - ${staticProjectName}");

		ProjectDetails.gotoProject(projectName = "Pjdzen - ${staticProjectName}");

		ProjectDetails.gotoSourceCodeAccess();

		ProjectDetails.clickSourceCodeAccessAddUserButton();

		ProjectDetails.populateSourceCodeAccessUserForm(table = '''| Name            | Info Services QA           |
	| Email Address   | info.services.qa@gmail.com |
	| GitHub Username | infoservicesqa             |''');

		ProjectDetails.clickSourceCodeAccessFormSubmitButton();

		ProjectDetails.viewSourceCodeAccessFormErrors(table = '''| Main Error |  Please provide a unique GitHub username |''');

		ProjectDetails.populateSourceCodeAccessUserForm(table = '''| Name            | Info Service QA           |
	| Email Address   | info.service.qa@gmail.com |
	| GitHub Username | infoservicesqa            |''');

		ProjectDetails.clickSourceCodeAccessFormSubmitButton();

		ProjectDetails.viewSourceCodeAccessFormErrors(table = '''| Main Error |  Please provide a unique GitHub username |''');
	}

	test Addsourcecodeaccessuseronpartneraccount {
		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Zenpar - ${staticCompanyName}",
			productName = "Service Partnership",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Partner");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Partner");

		ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		JSONOSBAccount.viewSupportOrganizationSync(accountCode = "ZENPARZENPAR");

		JSONUser.viewSupportUserSync(userEmailAddress = "pjd.partner1@lrpartner.com.broken");

		JSONUser.updateSupportPassword(
			userEmailAddress = "pjd.partner1@lrpartner.com.broken",
			userPassword = ${staticSupportUserTestPassword});

		JSONUser.assignUserToSupportGroup(
			groupName = "Help Center",
			userEmailAddress = "pjd.partner1@lrpartner.com.broken");

		OSBAdmin.logoutAndLoginToSupport(
			userEmailAddress = "pjd.partner1@lrpartner.com.broken",
			userPassword = ${staticSupportUserTestPassword});

		ProjectDetails.gotoProjectDetailsPage();

		ProjectDetails.gotoSourceCodeAccess();

		ProjectDetails.addSourceCodeAccessUser(table = '''| Name            | Info Services QA           |
	| Email Address   | info.services.qa@gmail.com |
	| GitHub Username | infoservicesqa             |''');

		ProjectDetails.viewSourceCodeAccessUserPanel(
			table = '''| Name            | Info Services QA           |
	| Email Address   | info.services.qa@gmail.com |
	| GitHub Username | infoservicesqa             |''',
			userEmailAddress = "info.services.qa@gmail.com");

		ProjectDetails.viewSourceCodeAccessUserDetails(
			table = '''| Name            | Info Services QA           |
	| Email Address   | info.services.qa@gmail.com |
	| GitHub Username | infoservicesqa             |''',
			userEmailAddress = "info.services.qa@gmail.com");

		GitHub.acceptGitHubInvitation(
			userGitHubUsername = "infoservicesqa",
			userPassword = "rejoicealways123");

		GitHub.viewISSupportIntegrationGitHubRespository(
			userGitHubUsername = "infoservicesqa",
			userPassword = "rejoicealways123");
	}

	test Deletesourcecodeaccessuser {
		KoroneikiAccountAPI._createAccountProductPurchase(
