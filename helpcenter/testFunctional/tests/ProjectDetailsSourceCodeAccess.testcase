		ProjectDetails.populateSourceCodeAccessUserForm(table = '''| Name            | Info                   |
	| Email Address   | info.services.qa@gmail |
	| GitHub Username | infoservicesqa78592    |''');

		ProjectDetails.clickSourceCodeAccessFormSubmitButton();

		ProjectDetails.viewSourceCodeAccessFormErrors(table = '''| Main Error                  | Please correct the following fields: Email Address |
	| Email Address Field Error   | Invalid Format                                     |''');

		ProjectDetails.populateSourceCodeAccessUserForm(table = '''| Name            | Info Services          |
	| Email Address   | info.services.qa@gmail |
	| GitHub Username | infoservicesqa78592    |''');

		ProjectDetails.clickSourceCodeAccessFormSubmitButton();

		ProjectDetails.viewSourceCodeAccessFormErrors(table = '''| Main Error                | Please correct the following fields: Email Address |
	| Email Address Field Error | Invalid Format                                     |''');

		ProjectDetails.populateSourceCodeAccessUserForm(table = '''| Name            | Info Services              |
	| Email Address   | info.services.qa@gmail.com |
	| GitHub Username | infoservicesqa.78592       |''');

		ProjectDetails.clickSourceCodeAccessFormSubmitButton();

		ProjectDetails.viewSourceCodeAccessFormErrors(table = '''| Main Error                  | Error: Please correct the following fields: GitHub Username |
	| GitHub Username Field Error | Incorrect Username                                          |''');

		ProjectDetails.populateSourceCodeAccessUserForm(table = '''| Name            | Info Services              |
	| Email Address   | info.services.qa@gmail.com |
	| GitHub Username | infoservicesqa78592        |''');

		ProjectDetails.clickSourceCodeAccessFormSubmitButton();

		ProjectDetails.viewSourceCodeAccessFormErrors(table = '''| Main Error | Please provide a valid GitHub user or collaborator. |''');
	}

