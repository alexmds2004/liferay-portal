definition {

	property testray.main.component.name = "Support QA";
	property type = "customer.portal";

	setUp {
		LocalFile.Passwords.getPasswords();

		LocalFile.OSBAdminRabbitMQ.generateProvisioningProjectName();

		LocalFile.OSBAdminRabbitMQ.generateProvisioningCompanyName();

		LocalFile.JSONOkta.createOktaUser(table = '''| Screen Name   | pjd.customer1                       |
	| Email Address | pjd.customer1@lrcustomer.com.broken |
	| First Name    | PJD                                 |
	| Last Name     | Customer1                           |''');

		LocalFile.JSONOkta.createOktaUser(table = '''| Screen Name   | pjd.customer2                       |
	| Email Address | pjd.customer2@lrcustomer.com.broken |
	| First Name    | PJD                                 |
	| Last Name     | Customer2                           |''');

		LocalFile.JSONOkta.createOktaUser(table = '''| Screen Name   | pjd.partner1                      |
	| Email Address | pjd.partner1@lrpartner.com.broken |
	| First Name    | PJD                               |
	| Last Name     | Partner1                          |''');

		LocalFile.KoroneikiAccountAPI._createAccount(table = '''| Name   | Zenpar - ${staticCompanyName} | |
	| Code   | ZENPARZENPAR                  | |
	| Status | Active                        | |''');

		LocalFile.KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Zenpar - ${staticCompanyName}",
			contactEmailAddress = "pjd.partner1@lrpartner.com.broken",
			table = '''| Partner Manager |''');

		LocalFile.KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		LocalFile.KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Zenpar - ${staticCompanyName}",
			productName = "Service Partnership",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		LocalFile.KoroneikiAccountAPI._createAssignedTeamNestedField(
			accountName = "Pjdzen - ${staticProjectName}",
			teamName = "Zenpar - ${staticCompanyName}");

		LocalFile.KoroneikiAccountAPI._createAccount(table = '''| Assigned Team Nested Field | ${staticAssignedTeamNestedField} | |
	| Code                       | PJDZENPJDZEN                     | |
	| Name                       | Pjdzen - ${staticProjectName}    | |
	| Region                     | United States                    | |
	| Status                     | Active                           | |
	| Tier                       | T1                               | |''');

		LocalFile.KoroneikiAccountAPI._assignTeamRolesToTeam(
			accountName = "Pjdzen - ${staticProjectName}",
			table = '''| Partner |''',
			teamName = "Zenpar - ${staticCompanyName}");

		LocalFile.KoroneikiAccountAPI._assignTeamRolesToTeam(
			accountName = "Pjdzen - ${staticProjectName}",
			table = '''| First Line Support |''',
			teamName = "Zenpar - ${staticCompanyName}");

		LocalFile.KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Pjdzen - ${staticProjectName}",
			contactEmailAddress = "pjd.customer1@lrcustomer.com.broken",
			table = '''| Support Requester |''');

		LocalFile.KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Pjdzen - ${staticProjectName}",
			contactEmailAddress = "pjd.customer2@lrcustomer.com.broken",
			table = '''| Support User |''');

		LocalFile.KoroneikiAccountAPI._createAccount(table = '''| Code   | DUPZENDUPZEN                     | |
	| Name   | Dupzen - ${staticProjectName}    | |
	| Region | United States                    | |
	| Status | Active                           | |
	| Tier   | T1                               | |''');
	}

	tearDown {
		LocalFile.ZendeskUserAPI._getDefaultUserId(organizationName = "Pjdzen - ${staticProjectName}");

		LocalFile.ZendeskUserAPI._renameFirstDefaultUserIdVariable();

		LocalFile.ZendeskUserAPI._getDefaultUserId(organizationName = "Dupzen - ${staticProjectName}");

		LocalFile.ZendeskUserAPI._renameSecondDefaultUserIdVariable();

		LocalFile.ZendeskUserAPI._getDefaultUserId(organizationName = "Zenpar - ${staticCompanyName}");

		LocalFile.ZendeskUserAPI._renameThirdDefaultUserIdVariable();

		LocalFile.OSBAdminProject.tearDownProjects(table = '''| ZENPARZENPAR |
	| PJDZENPJDZEN |
	| DUPZENDUPZEN |''');

		LocalFile.KoroneikiAccountAPI._tearDownAccounts(table = '''| Zenpar - ${staticCompanyName} |
	| Pjdzen - ${staticProjectName} |
	| Dupzen - ${staticProjectName} |''');

		LocalFile.KoroneikiAccountAPI._tearDownAccountsViaAccountFieldNameAndValue(
			fieldName = "Code",
			table = '''| ZENPARZENPAR |
	| PJDZENPJDZEN |
	| DUPZENDUPZEN |''');

		LocalFile.KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		LocalFile.JSONUser.tearDownUsers(table = '''| pjd.customer1@lrcustomer.com.broken |
	| pjd.customer2@lrcustomer.com.broken |
	| pjd.partner1@lrpartner.com.broken   |''');

		LocalFile.JSONUser.tearDownUsersViaSupport(table = '''| pjd.customer1@lrcustomer.com.broken |
	| pjd.customer2@lrcustomer.com.broken |
	| pjd.partner1@lrpartner.com.broken   |''');

		LocalFile.JSONUser.tearDownUsersViaKoroneiki(table = '''| pjd.customer1@lrcustomer.com.broken |
	| pjd.customer2@lrcustomer.com.broken |
	| pjd.partner1@lrpartner.com.broken   |''');

		LocalFile.KoroneikiContactAPI._tearDownContacts(table = '''| pjd.customer1@lrcustomer.com.broken |
	| pjd.customer2@lrcustomer.com.broken |
	| pjd.partner1@lrpartner.com.broken   |''');

		LocalFile.JSONOkta.tearDownUsers(table = '''| pjd.customer1@lrcustomer.com.broken |
	| pjd.customer2@lrcustomer.com.broken |
	| pjd.partner1@lrpartner.com.broken   |''');

		LocalFile.ZendeskUserAPI._getMultipleUserIdsByEmailAddress(table = '''| pjd.customer1@lrcustomer.com.broken |
	| pjd.customer2@lrcustomer.com.broken |
	| pjd.partner1@lrpartner.com.broken   |''');

		LocalFile.ZendeskUserAPI._tearDownUsersByIdList(userIds = ${staticUserIdList});

		LocalFile.ZendeskOrganizationAPI._getMultipleOrganizationExternalIdsByOrganizationNameIfStillPresent(table = '''| Zenpar - ${staticCompanyName} |
	| Pjdzen - ${staticProjectName} |
	| Dupzen - ${staticProjectName} |''');

		LocalFile.ZendeskOrganizationAPI._tearDownOrganizationsByExternalIdList(organizationExternalIds = ${staticOrganizationExternalIdList});

		LocalFile.ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId1});

		LocalFile.ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId2});

		LocalFile.ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId3});

		LocalFile.OSBAdmin.logoutAndLoginToSupport(
			userEmailAddress = "amos.fong@liferay.com.broken",
			userPassword = "test");

		LocalFile.OSBAdminProject.removeNonSourceCodeAccessUsersFromGitHub();
	}

	test Addduplicatesourcecodeaccessuser {
		LocalFile.KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Pjdzen - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		LocalFile.KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Pjdzen - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		LocalFile.KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		LocalFile.JSONOSBAccount.viewSupportOrganizationSync(accountCode = "PJDZENPJDZEN");

		LocalFile.OSBAdmin.loginToSupport(
			userEmailAddress = ${staticSupportAdminEmailAdress},
			userPassword = ${staticSupportAdminPassword});

		LocalFile.ProjectDetails.gotoProjectDetailsPage();

		LocalFile.ProjectDetails.searchProject(projectName = "Pjdzen - ${staticProjectName}");

		LocalFile.ProjectDetails.gotoProject(projectName = "Pjdzen - ${staticProjectName}");

		LocalFile.ProjectDetails.gotoSourceCodeAccess();

		LocalFile.ProjectDetails.addSourceCodeAccessUser(table = '''| Name            | Info Services QA           |
	| Email Address   | info.services.qa@gmail.com |
	| GitHub Username | infoservicesqa             |''');

		LocalFile.ProjectDetails.viewSourceCodeAccessUserPanel(
			table = '''| Name            | Info Services QA           |
	| Email Address   | info.services.qa@gmail.com |
	| GitHub Username | infoservicesqa             |''',
			userEmailAddress = "info.services.qa@gmail.com");

		LocalFile.ProjectDetails.viewSourceCodeAccessUserDetails(
			table = '''| Name            | Info Services QA           |
	| Email Address   | info.services.qa@gmail.com |
	| GitHub Username | infoservicesqa             |''',
			userEmailAddress = "info.services.qa@gmail.com");

		LocalFile.ZendeskHomepage.pause(timeInSeconds = 30);

		LocalFile.GitHub.acceptGitHubInvitation(
			userGitHubUsername = "infoservicesqa",
			userPassword = "rejoicealways123");

		LocalFile.GitHub.viewISSupportIntegrationGitHubRespository(
			userGitHubUsername = "infoservicesqa",
			userPassword = "rejoicealways123");

		LocalFile.ProjectDetails.gotoProjectDetailsPage();

		LocalFile.ProjectDetails.searchProject(projectName = "Pjdzen - ${staticProjectName}");

		LocalFile.ProjectDetails.gotoProject(projectName = "Pjdzen - ${staticProjectName}");

		LocalFile.ProjectDetails.gotoSourceCodeAccess();

		LocalFile.ProjectDetails.clickSourceCodeAccessAddUserButton();

		LocalFile.ProjectDetails.populateSourceCodeAccessUserForm(table = '''| Name            | Info Services QA           |
	| Email Address   | info.services.qa@gmail.com |
	| GitHub Username | infoservicesqa             |''');

		LocalFile.ProjectDetails.clickSourceCodeAccessFormSubmitButton();

		LocalFile.ProjectDetails.viewSourceCodeAccessFormErrors(table = '''| Main Error |  Please provide a unique GitHub username |''');

		LocalFile.ProjectDetails.populateSourceCodeAccessUserForm(table = '''| Name            | Info Service QA           |
	| Email Address   | info.service.qa@gmail.com |
	| GitHub Username | infoservicesqa            |''');

		LocalFile.ProjectDetails.clickSourceCodeAccessFormSubmitButton();

		LocalFile.ProjectDetails.viewSourceCodeAccessFormErrors(table = '''| Main Error |  Please provide a unique GitHub username |''');
	}

	test Addsourcecodeaccessuseronpartneraccount {
		LocalFile.KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Zenpar - ${staticCompanyName}",
			productName = "Service Partnership",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		LocalFile.KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Partner");

		LocalFile.KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Partner");

		LocalFile.ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		LocalFile.JSONOSBAccount.viewSupportOrganizationSync(accountCode = "ZENPARZENPAR");

		LocalFile.JSONUser.viewSupportUserSync(userEmailAddress = "pjd.partner1@lrpartner.com.broken");

		LocalFile.JSONUser.updateSupportPassword(
			userEmailAddress = "pjd.partner1@lrpartner.com.broken",
			userPassword = ${staticSupportUserTestPassword});

		LocalFile.JSONUser.assignUserToSupportGroup(
			groupName = "Help Center",
			userEmailAddress = "pjd.partner1@lrpartner.com.broken");

		LocalFile.OSBAdmin.logoutAndLoginToSupport(
			userEmailAddress = "pjd.partner1@lrpartner.com.broken",
			userPassword = ${staticSupportUserTestPassword});

		LocalFile.ProjectDetails.gotoProjectDetailsPage();

		LocalFile.ProjectDetails.gotoSourceCodeAccess();

		LocalFile.ProjectDetails.addSourceCodeAccessUser(table = '''| Name            | Info Services QA           |
	| Email Address   | info.services.qa@gmail.com |
	| GitHub Username | infoservicesqa             |''');

		LocalFile.ProjectDetails.viewSourceCodeAccessUserPanel(
			table = '''| Name            | Info Services QA           |
	| Email Address   | info.services.qa@gmail.com |
	| GitHub Username | infoservicesqa             |''',
			userEmailAddress = "info.services.qa@gmail.com");

		LocalFile.ProjectDetails.viewSourceCodeAccessUserDetails(
			table = '''| Name            | Info Services QA           |
	| Email Address   | info.services.qa@gmail.com |
	| GitHub Username | infoservicesqa             |''',
			userEmailAddress = "info.services.qa@gmail.com");

		LocalFile.GitHub.acceptGitHubInvitation(
			userGitHubUsername = "infoservicesqa",
			userPassword = "rejoicealways123");

		LocalFile.GitHub.viewISSupportIntegrationGitHubRespository(
			userGitHubUsername = "infoservicesqa",
			userPassword = "rejoicealways123");
	}

	test Deletesourcecodeaccessuser {
		LocalFile.KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Pjdzen - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
