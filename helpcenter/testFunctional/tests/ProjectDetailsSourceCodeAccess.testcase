	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		LocalFile.KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Pjdzen - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		LocalFile.KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		LocalFile.JSONOSBAccount.viewSupportOrganizationSync(accountCode = "PJDZENPJDZEN");

		LocalFile.OSBAdmin.loginToSupport(
			userEmailAddress = ${staticSupportAdminEmailAdress},
			userPassword = ${staticSupportAdminPassword});

		LocalFile.ProjectDetails.gotoProjectDetailsPage();

		LocalFile.ProjectDetails.searchProject(projectName = "Pjdzen - ${staticProjectName}");

		LocalFile.ProjectDetails.gotoProject(projectName = "Pjdzen - ${staticProjectName}");

		LocalFile.ProjectDetails.gotoSourceCodeAccess();

		LocalFile.ProjectDetails.addSourceCodeAccessUser(table = '''| Name            | Info Services QA           |
	| Email Address   | info.services.qa@gmail.com |
	| GitHub Username | infoservicesqa             |''');

		LocalFile.ProjectDetails.viewSourceCodeAccessUserPanel(
			table = '''| Name            | Info Services QA           |
	| Email Address   | info.services.qa@gmail.com |
	| GitHub Username | infoservicesqa             |''',
			userEmailAddress = "info.services.qa@gmail.com");

		LocalFile.ProjectDetails.viewSourceCodeAccessUserDetails(
			table = '''| Name            | Info Services QA           |
	| Email Address   | info.services.qa@gmail.com |
	| GitHub Username | infoservicesqa             |''',
			userEmailAddress = "info.services.qa@gmail.com");

		LocalFile.GitHub.acceptGitHubInvitation(
			userGitHubUsername = "infoservicesqa",
			userPassword = "rejoicealways123");

		LocalFile.ProjectDetails.gotoProjectDetailsPage();

		LocalFile.ProjectDetails.searchProject(projectName = "Pjdzen - ${staticProjectName}");

		LocalFile.ProjectDetails.gotoProject(projectName = "Pjdzen - ${staticProjectName}");

		LocalFile.ProjectDetails.gotoSourceCodeAccess();

		LocalFile.ProjectDetails.deleteSourceCodeAccessUser(userEmailAddress = "info.services.qa@gmail.com");

		LocalFile.GitHub.viewNoGitHubRespository(
			userGitHubUsername = "infoservicesqa",
			userPassword = "rejoicealways123");
	}

	test Deletesourcecodeaccessuserfromclosedproject {
		LocalFile.KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Pjdzen - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		LocalFile.KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Pjdzen - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		LocalFile.KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		LocalFile.JSONOSBAccount.viewSupportOrganizationSync(accountCode = "PJDZENPJDZEN");

		LocalFile.KoroneikiAccountAPI._updateAccount(
			accountName = "Pjdzen - ${staticProjectName}",
			table = '''| Status | Closed | |''');

		LocalFile.OSBAdmin.loginToSupport(
			userEmailAddress = ${staticSupportAdminEmailAdress},
			userPassword = ${staticSupportAdminPassword});

		LocalFile.ProjectDetails.gotoProjectDetailsPage();

		LocalFile.ProjectDetails.searchProject(projectName = "Pjdzen - ${staticProjectName}");

		LocalFile.ProjectDetails.gotoProject(projectName = "Pjdzen - ${staticProjectName}");

		LocalFile.ProjectDetails.gotoSourceCodeAccess();

		LocalFile.ProjectDetails.addSourceCodeAccessUserOnClosedProject(table = '''| Name            | Info Services QA           |
	| Email Address   | info.services.qa@gmail.com |
	| GitHub Username | infoservicesqa             |''');

		LocalFile.ProjectDetails.viewSourceCodeAccessUserPanel(
			table = '''| Name            | Info Services QA           |
	| Email Address   | info.services.qa@gmail.com |
	| GitHub Username | infoservicesqa             |''',
			userEmailAddress = "info.services.qa@gmail.com");

		LocalFile.ProjectDetails.viewSourceCodeAccessUserDetails(
			table = '''| Name            | Info Services QA           |
	| Email Address   | info.services.qa@gmail.com |
	| GitHub Username | infoservicesqa             |''',
			userEmailAddress = "info.services.qa@gmail.com");

		LocalFile.ProjectDetails.deleteSourceCodeAccessUser(userEmailAddress = "info.services.qa@gmail.com");

		LocalFile.GitHub.viewNoGitHubInvitation(
			userGitHubUsername = "infoservicesqa",
			userPassword = "rejoicealways123");

		LocalFile.GitHub.viewNoGitHubRespository(
			userGitHubUsername = "infoservicesqa",
			userPassword = "rejoicealways123");
	}

	test Viewsourcecodeaccessformerrors {
		LocalFile.KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Pjdzen - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		LocalFile.KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Pjdzen - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		LocalFile.KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		LocalFile.JSONOSBAccount.viewSupportOrganizationSync(accountCode = "PJDZENPJDZEN");

		LocalFile.OSBAdmin.loginToSupport(
			userEmailAddress = ${staticSupportAdminEmailAdress},
			userPassword = ${staticSupportAdminPassword});

		LocalFile.ProjectDetails.gotoProjectDetailsPage();

		LocalFile.ProjectDetails.searchProject(projectName = "Pjdzen - ${staticProjectName}");

		LocalFile.ProjectDetails.gotoProject(projectName = "Pjdzen - ${staticProjectName}");

		LocalFile.ProjectDetails.gotoSourceCodeAccess();

		LocalFile.ProjectDetails.clickSourceCodeAccessAddUserButton();

		LocalFile.ProjectDetails.populateSourceCodeAccessUserForm(table = '''| Name            | |
	| Email Address   | |
	| GitHub Username | |''');

		LocalFile.ProjectDetails.clickSourceCodeAccessFormSubmitButton();

		LocalFile.ProjectDetails.viewSourceCodeAccessFormErrors(table = '''| Main Error                  | Please correct the following fields: Name, Email Address, GitHub Username |
	| Name Field Error            | This field is required.                                                   |
	| Email Address Field Error   | This field is required.                                                   |
	| GitHub Username Field Error | This field is required.                                                   |''');

		LocalFile.ProjectDetails.populateSourceCodeAccessUserForm(table = '''| Name            | Info                |
	| Email Address   | info.services.qa    |
	| GitHub Username | infoservicesqa78592 |''');

		LocalFile.ProjectDetails.clickSourceCodeAccessFormSubmitButton();

		LocalFile.ProjectDetails.viewSourceCodeAccessFormErrors(table = '''| Main Error                  | Please correct the following fields: Email Address |
	| Email Address Field Error   | Invalid Format                                     |''');

		LocalFile.ProjectDetails.populateSourceCodeAccessUserForm(table = '''| Name            | Info                   |
	| Email Address   | info.services.qa@gmail |
	| GitHub Username | infoservicesqa78592    |''');

		LocalFile.ProjectDetails.clickSourceCodeAccessFormSubmitButton();

		LocalFile.ProjectDetails.viewSourceCodeAccessFormErrors(table = '''| Main Error                  | Please correct the following fields: Email Address |
	| Email Address Field Error   | Invalid Format                                     |''');

		LocalFile.ProjectDetails.populateSourceCodeAccessUserForm(table = '''| Name            | Info Services          |
	| Email Address   | info.services.qa@gmail |
	| GitHub Username | infoservicesqa78592    |''');

		LocalFile.ProjectDetails.clickSourceCodeAccessFormSubmitButton();

		LocalFile.ProjectDetails.viewSourceCodeAccessFormErrors(table = '''| Main Error                | Please correct the following fields: Email Address |
	| Email Address Field Error | Invalid Format                                     |''');

		LocalFile.ProjectDetails.populateSourceCodeAccessUserForm(table = '''| Name            | Info Services              |
	| Email Address   | info.services.qa@gmail.com |
	| GitHub Username | infoservicesqa.78592       |''');

		LocalFile.ProjectDetails.clickSourceCodeAccessFormSubmitButton();

		LocalFile.ProjectDetails.viewSourceCodeAccessFormErrors(table = '''| Main Error                  | Error: Please correct the following fields: GitHub Username |
	| GitHub Username Field Error | Incorrect Username                                          |''');

		LocalFile.ProjectDetails.populateSourceCodeAccessUserForm(table = '''| Name            | Info Services              |
	| Email Address   | info.services.qa@gmail.com |
	| GitHub Username | infoservicesqa78592        |''');

		LocalFile.ProjectDetails.clickSourceCodeAccessFormSubmitButton();

		LocalFile.ProjectDetails.viewSourceCodeAccessFormErrors(table = '''| Main Error | Please provide a valid GitHub user or collaborator. |''');
	}

	@help.center.acceptance = "true"
	test Viewsourcecodeaccessuser {
		LocalFile.KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Pjdzen - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		LocalFile.KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Pjdzen - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		LocalFile.KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		LocalFile.JSONOSBAccount.viewSupportOrganizationSync(accountCode = "PJDZENPJDZEN");

		LocalFile.OSBAdmin.loginToSupport(
			userEmailAddress = ${staticSupportAdminEmailAdress},
			userPassword = ${staticSupportAdminPassword});

		LocalFile.ProjectDetails.gotoProjectDetailsPage();

		LocalFile.ProjectDetails.searchProject(projectName = "Pjdzen - ${staticProjectName}");

		LocalFile.ProjectDetails.gotoProject(projectName = "Pjdzen - ${staticProjectName}");

		LocalFile.ProjectDetails.gotoSourceCodeAccess();

		LocalFile.ProjectDetails.addSourceCodeAccessUser(table = '''| Name            | Info Services QA           |
	| Email Address   | info.services.qa@gmail.com |
	| GitHub Username | infoservicesqa             |''');

