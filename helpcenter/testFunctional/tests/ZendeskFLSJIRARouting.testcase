definition {

	property testray.main.component.name = "Support QA";
	property type = "zendesk.api";

	setUp {
		LocalFile.Passwords.getPasswords();
	}

	tearDown {
		LocalFile.ZendeskTicketAPI._tearDownTicketByIds(ticketIdList = ${staticRequestIdList});

		LocalFile.ZendeskUserAPI._tearDownUsersByExternalIdTable(table = '''| User1 |''');
	}

	property help.center.acceptance = "true";
	test FLSJIRARouting {
		LocalFile.ZendeskOrganizationAPI._assignTagsToOrganization(
			organizationName = "The Space Program",
			table = '''| partner_first_line_support |''');

		LocalFile.ZendeskUserAPI._createUser(table = '''| Name             | Zendesk User1                    |
	| Tags             | osb_customer,osb_kb              |
	| Password         | ${staticZendeskAdminPassword}    |
	| Role             | End-user                         |
	| Access           | Organization                     |
	| Email            | zendesk.user1@zendesk.com.broken |
	| Phone Number     | +1 (555) 555-5555                |
	| Organization     | The Space Program                |
	| Language         | English                          |
	| Time Zone        | Pacific Time (US & Canada)       | 
	| External ID      | User1                            |''');

		LocalFile.ZendeskRequestAPI._createMultipleRequestsWithProductAndComponentValues(
			requesterEmail = "zendesk.user1@zendesk.com.broken",
			table = '''| prd_developer_tools         |                                        |
	| prd_enterprise_search       | security                               |
	| prd_liferay_commerce_4_0    | configuration_and_settings             |
	| prd_liferay_dxp_7_4         | caching_clustering                     |
	| prd_liferay_portal_6_2      | authentication                         |
	| prd_management_tools_lcs    |                                        |
	| prd_mobile_device_detection |                                        |
	| prd_mobile_experience       |                                        |
	| prd_productivity_tools_sync |                                        |
	| prd_social_office           |                                        |''');

		LocalFile.ZendeskHomepage.pauseInMinutes(timeInMinutes = 5);

		LocalFile.ZendeskTicketAPI._viewSpecificTagForMultipleTickets(
			tagName = "jira_escalated",
			ticketIdList = ${staticRequestIdList});
	}

}