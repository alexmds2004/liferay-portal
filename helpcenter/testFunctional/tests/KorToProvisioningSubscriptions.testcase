			routingKey = "dossiera.provisioning.create",
			table = '''| Account Name                           | Subkor - ${staticCompanyName}              |
	| Address City                           | Diamond Bar                                |
	| Address Country                        | United States                              |
	| Address Postal Code                    | 91765                                      |
	| Address Region                         | California                                 |
	| Address Street                         | 456 Fake Street                            |
	| Contact Email Address                  | sub.koroneiki1@lrcustomer.com.broken       |
	| Contact First Name                     | SUB                                        |
	| Contact Last Name                      | Koroneiki1                                 |
	| Dossiera Account Key                   | ${staticDossieraAccountKey}                |
	| Dossiera Address Key 1                 | ${staticDossieraAddressKey1}               |
	| Dossiera Address Key 2                 | ${staticDossieraAddressKey2}               |
	| Dossiera Contact Key                   | ${staticDossieraContactKey}                |
	| Dossiera Project Key                   | ${staticDossieraProjectKey}                |
	| End Day                                | ${staticEndDay}                            |
	| End Month                              | ${staticEndMonth}                          |
	| End Year                               | ${staticEndYear}                           |
	| Industry                               | Automotive                                 |
	| Owner Email Address                    | sub.koroneiki2@lrcustomer.com.broken       |
	| Owner First Name                       | SUB                                        |
	| Owner Last Name                        | Koroneiki2                                 |
	| Partner First Line Support             | false                                      |
	| Product Type                           | New                                        |
	| Product Name                           | Liferay Digital Enterprise - Prod Sizing 4 |
	| Project Name                           | Korsub - ${staticProjectName}              |
	| Renewal                                | false                                      |
	| Salesforce Opportunity Key             | ${staticSalesforceOpportunityKey}          |
	| Salesforce Opportunity Line Item Key 1 | ${staticSalesforceOpportunityLineItemKey1} |
	| Salesforce Opportunity Line Item Key 2 | ${staticSalesforceOpportunityLineItemKey2} |
	| Salesforce Opportunity Sold By         | Liferay US                                 |
	| Salesforce Opportunity Stage Name      | Closed Won                                 |
	| Salesforce Opportunity Territory       | United States                              |
	| Salesforce Opportunity Type            | New Business                               |
	| Salesforce Owner User Key              | ${staticSalesforceOwnerUserKey}            |
	| Salesforce Project Key                 | ${staticSalesforceProjectKey}              |
	| Start Day                              | ${staticStartDay}                          |
	| Start Month                            | ${staticStartMonth}                        |
	| Start Year                             | ${staticStartYear}                         |
	| Subscription Level                     | Platinum                                   |
	| Version Number                         | 7.1                                        |''');

		KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		KoroneikiProductPurchaseAPI.generateStaticFullStartAndEndDate();

		KoroneikiProductPurchaseAPI.generateStaticFutureStartAndEndDate();

		KoroneikiProductPurchaseAPI.generateStaticFullFutureStartAndEndDate();

		KoroneikiProductPurchaseAPI.generateStaticPastStartAndEndDate();

		KoroneikiProductPurchaseAPI.generateStaticFullPastStartAndEndDate();

		KoroneikiProductPurchaseAPI.generateStaticYyyyMmDdStartAndEndDate();

		KoroneikiProductPurchaseAPI._updateProductPurchase(
			accountName = "Korsub - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | true                     | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiProductPurchaseAPI._updateProductPurchase(
			accountName = "Korsub - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | true                     | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiAccountAPI._createAccountProductConsumption(
			accountName = "Korsub - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| Product Purchase        | true            |                |
	| Product Field and Value | additionalProp1 | propertyValue1 |
	| Product Field and Value | additionalProp2 | propertyValue2 |
	| Product Field and Value | additionalProp3 | propertyValue3 |''');

		OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		Provisioning.gotoAccounts();

		Provisioning.searchAccounts(keyword = "Korsub");

		Provisioning.clickAccount(accountName = "Korsub - ${staticProjectName}");

		ProvisioningAccount.clickProductTab(tabName = "All");

		ProvisioningAccount.selectProductsViaSubscriptionsTab(table = '''| DXP Production        |
	| Platinum Subscription |''');

		ProvisioningAccount.clickEditSubscriptions();

		ProvisioningSubscription.populateSubscriptionTermFormAndProceed(table = '''| DXP Production        | Perpetual |
	| Platinum Subscription | Perpetual |''');

		ProvisioningSubscription.populateSubscriptionFormAndSave(table = '''| DXP Production        | Perpetual    | false                            |
	| DXP Production        | Start Date   | ${staticYyyyMmDdStartDate}       |
	| DXP Production        | End Date     | ${staticYyyyMmDdOriginalEndDate} |
	| DXP Production        | Grace Period | 30                               |
	| Platinum Subscription | Perpetual    | false                            |
	| Platinum Subscription | Start Date   | ${staticYyyyMmDdStartDate}       |
	| Platinum Subscription | End Date     | ${staticYyyyMmDdOriginalEndDate} |
	| Platinum Subscription | Grace Period | 30                               |''');

		ProvisioningAccount._viewAccountProduct(
			productName = "DXP Production",
			table = '''| Name               | DXP Production |
	| Provisioned        | 1              |
	| Approved Purchased | 1              |
	| State              | ACTIVE         |''');

		ProvisioningAccount._viewAccountProduct(
			productName = "Platinum Subscription",
			table = '''| Name               | Platinum Subscription |
	| Provisioned        | 0                     |
	| Approved Purchased | 1                     |
	| State              | ACTIVE                |''');

		ProvisioningAccount.clickProductTab(tabName = "Active");

		ProvisioningAccount._viewAccountProduct(
			productName = "DXP Production",
			table = '''| Name                | DXP Production |
	| Current Provisioned | 1              |
	| Current Purchased   | 1              |
	| State               | ACTIVE         |''');

		ProvisioningAccount._viewAccountProduct(
			productName = "Platinum Subscription",
			table = '''| Name                | Platinum Subscription |
	| Current Provisioned | 0                     |
	| Current Purchased   | 1                     |
	| State               | ACTIVE                |''');

		ProvisioningAccount.clickProductTab(tabName = "Future");

		ProvisioningAccount._viewNoAccountProduct(productName = "DXP Production");

		ProvisioningAccount._viewNoAccountProduct(productName = "Platinum Subscription");

		ProvisioningAccount.clickProductTab(tabName = "Complimentary");

		ProvisioningAccount._viewNoAccountProduct(productName = "DXP Production");

		ProvisioningAccount._viewNoAccountProduct(productName = "Platinum Subscription");

		ProvisioningAccount.clickProductTab(tabName = "Expired");

		ProvisioningAccount._viewNoAccountProduct(productName = "DXP Production");

		ProvisioningAccount._viewNoAccountProduct(productName = "Platinum Subscription");

		ProvisioningAccount.clickProductTab(tabName = "Cancelled");

		ProvisioningAccount._viewNoAccountProduct(productName = "DXP Production");

		ProvisioningAccount._viewNoAccountProduct(productName = "Platinum Subscription");

		ProvisioningAccount.clickProductTab(tabName = "All");

		ProvisioningAccount.clickSubscriptionLink(productName = "DXP Production");

		ProvisioningSubscription._viewSubscriptionDetails(table = '''| Name         | DXP Production                                        |
	| State        | ACTIVE                                                |
	| Support Life | ${staticFullStartDate} - ${staticFullOriginalEndDate} |
	| Grace Period | ${staticFullOriginalEndDate} - ${staticFullEndDate}   |
	| Provisioned  | 1                                                     |
	| Purchased    | 1                                                     |''');

		ProvisioningSubscription._viewSubscriptionTerm(
			startDateEndDate = "${staticFullStartDate} - ${staticFullOriginalEndDate}",
			table = '''| Start - End Date           | ${staticFullStartDate} - ${staticFullOriginalEndDate} |
	| Grace Period               | ${staticFullOriginalEndDate} - ${staticFullEndDate}   |
	| Provisioned                | 1                                                     |
	| Purchased                  | 1                                                     |
	| Salesforce Opportunity Key | ${staticSalesforceOpportunityKey}                     |
	| State                      | ACTIVE                                                |''');

		Provisioning.gotoAccounts();

		Provisioning.searchAccounts(keyword = "Korsub");

		Provisioning.clickAccount(accountName = "Korsub - ${staticProjectName}");

		ProvisioningAccount.clickProductTab(tabName = "All");

		ProvisioningAccount.clickSubscriptionLink(productName = "Platinum Subscription");

		ProvisioningSubscription._viewSubscriptionDetails(table = '''| Name         | Platinum Subscription                                 |
	| State        | ACTIVE                                                |
	| Support Life | ${staticFullStartDate} - ${staticFullOriginalEndDate} |
	| Grace Period | ${staticFullOriginalEndDate} - ${staticFullEndDate}   |
	| Provisioned  | 0                                                     |
	| Purchased    | 1                                                     |''');

		ProvisioningSubscription._viewSubscriptionTerm(
			startDateEndDate = "${staticFullStartDate} - ${staticFullOriginalEndDate}",
			table = '''| Start - End Date           | ${staticFullStartDate} - ${staticFullOriginalEndDate} |
	| Grace Period               | ${staticFullOriginalEndDate} - ${staticFullEndDate}   |
	| Provisioned                | 0                                                     |
	| Purchased                  | 1                                                     |
	| Salesforce Opportunity Key | ${staticSalesforceOpportunityKey}                     |
	| State                      | ACTIVE                                                |''');

		Provisioning.gotoAccounts();

		Provisioning.searchAccounts(keyword = "Korsub");

		Provisioning._viewAccountViaIndex(
			accountName = "Korsub - ${staticProjectName}",
			table = '''| Name    | Korsub - ${staticProjectName} |
	| Code    | SUBKORKORSUB                  |
	| State   | ACTIVE                        |''');

		Provisioning.clickAccount(accountName = "Korsub - ${staticProjectName}");

		ProvisioningAccount._viewAccountDetails(table = '''| Name           | Korsub - ${staticProjectName} |
	| Code           | SUBKORKORSUB                  |
	| State          | ACTIVE                        |''');
	}

