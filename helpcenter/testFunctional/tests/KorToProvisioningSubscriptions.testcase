	| Support Life          | ${staticFullPastStartDate} - ${staticFullOriginalEndDate} |
	| Grace Period End Date | ${staticFullEndDate}                                      |
	| Current Provisioned   | 0                                                         |
	| Current Purchased     | 1                                                         |
	| State                 | ACTIVE                                                    |''');

		ProvisioningAccount.viewProductTabCount(
			countValue = 2,
			tabName = "Active");

		ProvisioningAccount.viewProductTabCount(
			countValue = 0,
			tabName = "Future");

		ProvisioningAccount.viewProductTabCount(
			countValue = 0,
			tabName = "Complimentary");

		ProvisioningAccount.viewProductTabCount(
			countValue = 0,
			tabName = "Expired");

		ProvisioningAccount.viewProductTabCount(
			countValue = 0,
			tabName = "Cancelled");

		ProvisioningAccount.viewProductTabCount(
			countValue = 2,
			tabName = "All");

		ProvisioningAccount.clickProductTab(tabName = "Future");

		ProvisioningAccount._viewNoAccountProduct(productName = "DXP Production");

		ProvisioningAccount._viewNoAccountProduct(productName = "Platinum Subscription");

		ProvisioningAccount.clickProductTab(tabName = "Complimentary");

		ProvisioningAccount._viewNoAccountProduct(productName = "DXP Production");

		ProvisioningAccount._viewNoAccountProduct(productName = "Platinum Subscription");

		ProvisioningAccount.clickProductTab(tabName = "Expired");

		ProvisioningAccount._viewNoAccountProduct(productName = "DXP Production");

		ProvisioningAccount._viewNoAccountProduct(productName = "Platinum Subscription");

		ProvisioningAccount.clickProductTab(tabName = "Cancelled");

		ProvisioningAccount._viewNoAccountProduct(productName = "DXP Production");

		ProvisioningAccount._viewNoAccountProduct(productName = "Platinum Subscription");

		ProvisioningAccount.clickProductTab(tabName = "All");

		ProvisioningAccount._viewAccountProduct(
			productName = "DXP Production",
			table = '''| Name                  | DXP Production                                            |
	| Support Life          | ${staticFullPastStartDate} - ${staticFullOriginalEndDate} |
	| Grace Period End Date | ${staticFullEndDate}                                      |
	| Provisioned           | 1                                                         |
	| Approved Purchased    | 2                                                         |
	| State                 | ACTIVE                                                    |''');

		ProvisioningAccount._viewAccountProduct(
			productName = "Platinum Subscription",
			table = '''| Name                  | Platinum Subscription                                     |
	| Support Life          | ${staticFullPastStartDate} - ${staticFullOriginalEndDate} |
	| Grace Period End Date | ${staticFullEndDate}                                      |
	| Provisioned           | 0                                                         |
	| Approved Purchased    | 2                                                         |
	| State                 | ACTIVE                                                    |''');

		ProvisioningAccount.clickSubscriptionLink(productName = "DXP Production");

		ProvisioningSubscription._viewSubscriptionDetails(table = '''| Name         | DXP Production                                            |
	| State        | ACTIVE                                                    |
	| Support Life | ${staticFullPastStartDate} - ${staticFullOriginalEndDate} |
	| Grace Period | ${staticFullOriginalEndDate} - ${staticFullEndDate}       |
	| Provisioned  | 1                                                         |
	| Purchased    | 1                                                         |''');

		ProvisioningSubscription._viewSubscriptionTerm(
			startDateEndDate = "${staticFullStartDate} - ${staticFullOriginalEndDate}",
			table = '''| Start - End Date           | ${staticFullStartDate} - ${staticFullOriginalEndDate} |
	| Grace Period               | ${staticFullOriginalEndDate} - ${staticFullEndDate}   |
	| Provisioned                | 0                                                     |
	| Purchased                  | 1                                                     |
	| Salesforce Opportunity Key | ${staticSalesforceOpportunityKey}                     |
	| State                      | ACTIVE                                                |''');

		ProvisioningSubscription._viewSubscriptionTerm(
			startDateEndDate = "${staticFullPastStartDate} - ${staticFullPastOriginalEndDate}",
			table = '''| Start - End Date           | ${staticFullPastStartDate} - ${staticFullPastOriginalEndDate} |
	| Grace Period               | ${staticFullPastOriginalEndDate} - ${staticFullPastEndDate}   |
	| Provisioned                | 0                                                             |
	| Purchased                  | 1                                                             |
	| State                      | EXPIRED                                                       |''');

		Provisioning.gotoAccounts();

		Provisioning.searchAccounts(keyword = "Korsub");

		Provisioning.clickAccount(accountName = "Korsub - ${staticProjectName}");

		ProvisioningAccount.clickSubscriptionLink(productName = "Platinum Subscription");

		ProvisioningSubscription._viewSubscriptionDetails(table = '''| Name         | Platinum Subscription                                     |
	| State        | ACTIVE                                                    |
	| Support Life | ${staticFullPastStartDate} - ${staticFullOriginalEndDate} |
	| Grace Period | ${staticFullOriginalEndDate} - ${staticFullEndDate}       |
	| Provisioned  | 0                                                         |
	| Purchased    | 1                                                         |''');

		ProvisioningSubscription._viewSubscriptionTerm(
			startDateEndDate = "${staticFullStartDate} - ${staticFullOriginalEndDate}",
			table = '''| Start - End Date           | ${staticFullStartDate} - ${staticFullOriginalEndDate} |
	| Grace Period               | ${staticFullOriginalEndDate} - ${staticFullEndDate}   |
	| Provisioned                | 0                                                     |
	| Purchased                  | 1                                                     |
	| Salesforce Opportunity Key | ${staticSalesforceOpportunityKey}                     |
	| State                      | ACTIVE                                                |''');

		ProvisioningSubscription._viewSubscriptionTerm(
			startDateEndDate = "${staticFullPastStartDate} - ${staticFullPastOriginalEndDate}",
			table = '''| Start - End Date           | ${staticFullPastStartDate} - ${staticFullPastOriginalEndDate} |
	| Grace Period               | ${staticFullPastOriginalEndDate} - ${staticFullPastEndDate}   |
	| Provisioned                | 0                                                             |
	| Purchased                  | 1                                                             |
	| State                      | EXPIRED                                                       |''');
	}

}