	| Status                | Active                                     | |
	| Tier                  | T4                                         | |
	| Website               | www.koroneikiautomotivesubsidiary.com      | |''');

		KoroneikiAccountAPI._createAccountNote(
			accountName = "Koroneiki Automotive",
			table = '''| Content  | Account Note1 Content |
	| Format   | HTML                  |
	| Priority | 1                     |
	| Status   | Approved              |
	| Type     | General               |''');

		KoroneikiAccountAPI._createAccountNote(
			accountName = "Koroneiki Automotive",
			table = '''| Content  | Account Note2 Content |
	| Format   | Plain                 |
	| Priority | 2                     |
	| Status   | Archived              |
	| Type     | Sales                 |''');

		KoroneikiAccountAPI._createAccountNote(
			accountName = "Koroneiki Auto Subsidiary",
			table = '''| Content  | Account Note3 Content |
	| Format   | HTML                  |
	| Priority | 3                     |
	| Status   | Approved              |
	| Type     | General               |''');

		KoroneikiAccountAPI._createAccountNote(
			accountName = "Koroneiki Auto Subsidiary",
			table = '''| Content  | Account Note4 Content |
	| Format   | Plain                 |
	| Priority | 4                     |
	| Status   | Archived              |
	| Type     | Sales                 |''');

		KoroneikiNoteAPI._viewNote(
			accountName = "Koroneiki Automotive",
			content = "Account Note1 Content",
			table = '''| Content  | Account Note1 Content |
	| Format   | HTML                  |
	| Priority | 1                     |
	| Status   | Approved              |
	| Type     | General               |''');

		KoroneikiNoteAPI._viewNote(
			accountName = "Koroneiki Automotive",
			content = "Account Note2 Content",
			table = '''| Content  | Account Note2 Content |
	| Format   | Plain                 |
	| Priority | 2                     |
	| Status   | Archived              |
	| Type     | Sales                 |''');

		KoroneikiNoteAPI._viewNote(
			accountName = "Koroneiki Auto Subsidiary",
			content = "Account Note3 Content",
			table = '''| Content  | Account Note3 Content |
	| Format   | HTML                  |
	| Priority | 3                     |
	| Status   | Approved              |
	| Type     | General               |''');

		KoroneikiNoteAPI._viewNote(
			accountName = "Koroneiki Auto Subsidiary",
			content = "Account Note4 Content",
			table = '''| Content  | Account Note4 Content |
	| Format   | Plain                 |
	| Priority | 4                     |
	| Status   | Archived              |
	| Type     | Sales                 |''');

		KoroneikiNoteAPI._viewNoNote(
			accountName = "Koroneiki Automotive",
			content = "Account Note3 Content");

		KoroneikiNoteAPI._viewNoNote(
			accountName = "Koroneiki Automotive",
			content = "Account Note4 Content");

		KoroneikiNoteAPI._viewNoNote(
			accountName = "Koroneiki Auto Subsidiary",
			content = "Account Note1 Content");

		KoroneikiNoteAPI._viewNoNote(
			accountName = "Koroneiki Auto Subsidiary",
			content = "Account Note2 Content");
	}

	test Removenoteandview {
		KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORAUTO                                  | |
	| Contact Email Address | koroneiki.contact1@lrcustomer.com.broken | |
