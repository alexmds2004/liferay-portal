	| Region                | United States                            | |
	| Status                | Active                                   | |
	| Tier                  | T4                                       | |
	| Website               | www.koroneikiautomotive.com              | |''');

		KoroneikiAccountAPI._createAccountNote(
			accountName = "Koroneiki Automotive",
			table = '''| Content  | Account Note Content |
	| Format   | HTML                 |
	| Priority | 1                    |
	| Status   | Approved             |
	| Type     | General              |''');

		KoroneikiNoteAPI._deleteNote(
			accountName = "Koroneiki Automotive",
			content = "Account Note Content");

		KoroneikiNoteAPI._viewNoNote(
			accountName = "Koroneiki Automotive",
			content = "Account Note Content");
	}

