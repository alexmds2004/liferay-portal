definition {

	property testray.main.component.name = "Support QA";
	property type = "zendesk.api";

	setUp {
		LocalFile.Passwords.getPasswords();
	}

	tearDown {
		LocalFile.ZendeskTicketAPI._tearDownTicketByIds(ticketIdList = ${staticRequestIdList});

		LocalFile.ZendeskUserAPI._tearDownUsersByExternalIdTable(table = '''| User1 |''');

		LocalFile.ZendeskHomepage.pause(timeInSeconds = 3);
	}

	test ACTrialRoutingBR {
		LocalFile.ZendeskUserAPI._createUser(table = '''| Name             | Zendesk User1                    |
	| Tags             | osb_customer,osb_kb              |
	| Password         | ${staticZendeskAdminPassword}    |
	| Role             | End-user                         |
	| Access           | Organization                     |
	| Email            | zendesk.user1@zendesk.com.broken |
	| Phone Number     | +1 (555) 555-5555                |
	| Organization     | AC Trial                         |
	| Language         | English                          |
	| Time Zone        | Pacific Time (US & Canada)       |
	| External ID      | User1                            |''');

		LocalFile.ZendeskRequestAPI._createMultipleACTrialRequestsWithProductAndComponentValues(
			requesterEmail = "zendesk.user1@zendesk.com.broken",
			table = '''| prd_liferay_analytics_cloud | ac_90_day_trial | southamerica-east1-ac1-c1 |''');

		LocalFile.ZendeskTicketAPI._viewMultipleTicketGroupAssignees(
			groupAssignee = "Analytics Cloud - BR",
			ticketIdList = ${staticRequestIdList});
	}

	test ACTrialRoutingES {
		LocalFile.ZendeskUserAPI._createUser(table = '''| Name             | Zendesk User1                    |
	| Tags             | osb_customer,osb_kb              |
	| Password         | ${staticZendeskAdminPassword}    |
	| Role             | End-user                         |
	| Access           | Organization                     |
	| Email            | zendesk.user1@zendesk.com.broken |
	| Phone Number     | +1 (555) 555-5555                |
	| Organization     | AC Trial                         |
	| Language         | English                          |
	| Time Zone        | Pacific Time (US & Canada)       |
	| External ID      | User1                            |''');

		LocalFile.ZendeskRequestAPI._createMultipleACTrialRequestsWithProductAndComponentValues(
			requesterEmail = "zendesk.user1@zendesk.com.broken",
			table = '''| prd_liferay_analytics_cloud | ac_90_day_trial | europe-west2-ac2-c1 |''');

		LocalFile.ZendeskTicketAPI._viewMultipleTicketGroupAssignees(
			groupAssignee = "Analytics Cloud - ES",
			ticketIdList = ${staticRequestIdList});
	}

	test ACTrialRoutingHU {
		LocalFile.ZendeskUserAPI._createUser(table = '''| Name             | Zendesk User1                    |
	| Tags             | osb_customer,osb_kb              |
	| Password         | ${staticZendeskAdminPassword}    |
	| Role             | End-user                         |
	| Access           | Organization                     |
	| Email            | zendesk.user1@zendesk.com.broken |
	| Phone Number     | +1 (555) 555-5555                |
	| Organization     | AC Trial                         |
	| Language         | English                          |
	| Time Zone        | Pacific Time (US & Canada)       |
	| External ID      | User1                            |''');

		LocalFile.ZendeskRequestAPI._createMultipleACTrialRequestsWithProductAndComponentValues(
			requesterEmail = "zendesk.user1@zendesk.com.broken",
			table = '''| prd_liferay_analytics_cloud | ac_90_day_trial | europe-west3-ac3-c1 |''');

		LocalFile.ZendeskTicketAPI._viewMultipleTicketGroupAssignees(
			groupAssignee = "Analytics Cloud - HU",
			ticketIdList = ${staticRequestIdList});
	}

	property help.center.acceptance = "true";
	test ACTrialRoutingUS {
		LocalFile.ZendeskUserAPI._createUser(table = '''| Name             | Zendesk User1                    |
	| Tags             | osb_customer,osb_kb              |
	| Password         | ${staticZendeskAdminPassword}    |
	| Role             | End-user                         |
	| Access           | Organization                     |
	| Email            | zendesk.user1@zendesk.com.broken |
	| Phone Number     | +1 (555) 555-5555                |
	| Organization     | AC Trial                         |
	| Language         | English                          |
	| Time Zone        | Pacific Time (US & Canada)       |
	| External ID      | User1                            |''');

		LocalFile.ZendeskRequestAPI._createMultipleACTrialRequestsWithProductAndComponentValues(
			requesterEmail = "zendesk.user1@zendesk.com.broken",
			table = '''| prd_liferay_analytics_cloud | ac_90_day_trial | us-west1-ac4-c1-2 |
	| prd_liferay_analytics_cloud | ac_90_day_trial | us-west1-ac4-c1   |''');

		LocalFile.ZendeskTicketAPI._viewMultipleTicketGroupAssignees(
			groupAssignee = "Analytics Cloud - US",
			ticketIdList = ${staticRequestIdList});
	}

}