definition {

	property testray.main.component.name = "Support QA";
	property type = "customer.integration";

	setUp {
		LocalFile.Passwords.getPasswords();

		LocalFile.KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		LocalFile.KoroneikiProductPurchaseAPI.generateStaticPastStartAndEndDate();

		LocalFile.KoroneikiProductPurchaseAPI.generateStaticFutureStartAndEndDate();

		LocalFile.OSBAdminRabbitMQ.generateProvisioningCompanyName();

		LocalFile.OSBAdminRabbitMQ.generateProvisioningProjectName();

		LocalFile.Data.generateSupportUser();

		LocalFile.Data._renameFirstSupportUserVariables();

		LocalFile.JSONOkta.createOktaUser(table = '''| Screen Name   | ${staticScreenNameValue1}       |
	| Email Address | ${staticEmailValue1}            |
	| First Name    | ${staticContactFirstNameValue1} |
	| Last Name     | ${staticContactLastNameValue1}  |
	| Group         | Employees                       |
	| Group         | Account Access US               |''');

		LocalFile.Data.generateSupportUser();

		LocalFile.Data._renameSecondSupportUserVariables();

		LocalFile.JSONOkta.createOktaUser(table = '''| Screen Name   | ${staticScreenNameValue2}       |
	| Email Address | ${staticEmailValue2}            |
	| First Name    | ${staticContactFirstNameValue2} |
	| Last Name     | ${staticContactLastNameValue2}  |
	| Group         | Employees                       |
	| Group         | Account Access EU               |''');

		LocalFile.KoroneikiAccountAPI._createAccount(table = '''| Code   | KORCSTKORCST                  | |
	| Name   | Korcst - ${staticProjectName} | |
	| Region | United States                 | |
	| Status | Active                        | |
	| Tier   | T1                            | |''');

		LocalFile.KoroneikiAccountAPI._createAccount(table = '''| Code   | KORCT2KORCT2                   | |
	| Name   | Korcst2 - ${staticProjectName} | |
	| Region | Spain                          | |
	| Status | Active                         | |
	| Tier   | T1                             | |''');
	}

	tearDown {
		LocalFile.KoroneikiTeamAPI._tearDownTeams(table = '''| CSTM Customer |''');

		LocalFile.OSBAdminProject.tearDownProjects(table = '''| KORCSTKORCST |
	| KORCT2KORCT2 |''');

		LocalFile.KoroneikiAccountAPI._tearDownAccounts(table = '''| Korcst - ${staticProjectName}  |
	| Korcst2 - ${staticProjectName} |''');

		LocalFile.KoroneikiAccountAPI._tearDownAccountsViaAccountFieldNameAndValue(
			fieldName = "Code",
			table = '''| KORCSTKORCST |
	| KORCT2KORCT2 |''');

		LocalFile.JSONUser.tearDownUsers(table = '''| ${staticEmailValue1} |
	| ${staticEmailValue2} |''');

		LocalFile.JSONUser.tearDownUsersViaSupport(table = '''| ${staticEmailValue1} |
	| ${staticEmailValue2} |''');

		LocalFile.JSONUser.tearDownUsersViaKoroneiki(table = '''| ${staticEmailValue1} |
	| ${staticEmailValue2} |''');

		LocalFile.KoroneikiContactAPI._tearDownContacts(table = '''| ${staticEmailValue1} |
	| ${staticEmailValue2} |''');

		LocalFile.JSONOkta.tearDownUsers(table = '''| ${staticEmailValue1} |
	| ${staticEmailValue2} |''');
	}

	test ViewEURegionaccountasanEUEmployeeonCustomer {
		LocalFile.KoroneikiContactAPI._viewContactSyncViaEmailAddress(contactEmailAddress = ${staticEmailValue1});

		LocalFile.KoroneikiContactAPI._viewAccountSyncViaUuid(
			accountName = "Liferay, Inc.",
			contactEmailAddress = ${staticEmailValue1});

		LocalFile.KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		LocalFile.KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - DXP");

		LocalFile.KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - Portal");

		LocalFile.KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - Commerce");

		LocalFile.KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Liferay Employee");

		LocalFile.JSONUser.viewSupportUserSync(userEmailAddress = ${staticEmailValue1});

		LocalFile.JSONUser.viewSupportUserOrganizationSync(
			organizationName = "Employees",
			userEmailAddress = ${staticEmailValue1});

		LocalFile.Passwords.getPasswords();

		LocalFile.JSONOkta.assignUserToOktaGroup(
			groupName = "Data Access US",
			userEmailAddress = ${staticEmailValue1});

		LocalFile.KoroneikiContactAPI._viewTeamSyncViaUuid(
			contactEmailAddress = ${staticEmailValue1},
			teamName = "Account Access US");

		LocalFile.JSONUser.viewSupportUserOrganizationSync(
			organizationName = "Data Access US",
			userEmailAddress = ${staticEmailValue1});

		LocalFile.CustomerLogin.loginToCustomer(
			userEmailAddress = ${staticCustomerAdminEmailAddress},
			userPassword = ${staticCustomerAdminPassword});

		LocalFile.CustomerProjects._viewCustomerProjectDetails(
			projectName = "Korcst - ${staticProjectName}",
			table = '''| Name           | Korcst - ${staticProjectName} |
	| Code           | KORCSTKORCST                  |
	| State          | ACTIVE                        |
	| Support Region | United States                 |
	| SLA            | -                             |
	| Support Seats  | 0 / 0 Filled                  |
	| Tier           | T1                            |
	| FLS Partner    | -                             |''');

		LocalFile.CustomerProjects._viewCustomerProjectDetails(
			projectName = "Korcst - ${staticProjectName}",
			table = '''| Name           | Korcst - ${staticProjectName} |
	| Code           | KORCSTKORCST                  |
	| State          | ACTIVE                        |
	| Support Region | Spain                         |
	| SLA            | -                             |
	| Support Seats  | 0 / 0 Filled                  |
	| Tier           | T1                            |
	| FLS Partner    | -                             |''');
	}

	test ViewUSandEURegionaccountsasanUSEmployeeonCustomer {
		LocalFile.KoroneikiContactAPI._viewAccountSyncViaUuid(
			accountName = "Liferay, Inc.",
			contactEmailAddress = ${staticEmailValue1});

		LocalFile.KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		LocalFile.KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - DXP");

		LocalFile.KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - Portal");

		LocalFile.KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - Commerce");

		LocalFile.KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Liferay Employee");

		LocalFile.JSONUser.viewSupportUserSync(userEmailAddress = ${staticEmailValue1});

		LocalFile.JSONUser.viewSupportUserOrganizationSync(
			organizationName = "Employees",
			userEmailAddress = ${staticEmailValue1});

		LocalFile.Passwords.getPasswords();

		LocalFile.JSONOkta.assignUserToOktaGroup(
			groupName = "Data Access US",
			userEmailAddress = ${staticEmailValue1});

		LocalFile.KoroneikiContactAPI._viewTeamSyncViaUuid(
			contactEmailAddress = ${staticEmailValue1},
			teamName = "Account Access US");

		LocalFile.JSONUser.viewSupportUserOrganizationSync(
			organizationName = "Data Access US",
			userEmailAddress = ${staticEmailValue1});

		LocalFile.CustomerLogin.loginToCustomer(
			userEmailAddress = ${staticCustomerAdminEmailAddress},
			userPassword = ${staticCustomerAdminPassword});

		LocalFile.CustomerProjects._viewCustomerProjectDetails(
			projectName = "Korcst - ${staticProjectName}",
			table = '''| Name           | Korcst - ${staticProjectName} |
	| Code           | KORCSTKORCST                  |
	| State          | ACTIVE                        |
	| Support Region | United States                 |
	| SLA            | -                             |
	| Support Seats  | 0 / 0 Filled                  |
	| Tier           | T1                            |
	| FLS Partner    | -                             |''');

		LocalFile.CustomerProjects._viewCustomerProjectDetails(
			projectName = "Korcst - ${staticProjectName}",
			table = '''| Name           | Korcst - ${staticProjectName} |
	| Code           | KORCSTKORCST                  |
	| State          | ACTIVE                        |
	| Support Region | Spain                         |
	| SLA            | -                             |
	| Support Seats  | 0 / 0 Filled                  |
	| Tier           | T1                            |
	| FLS Partner    | -                             |''');
	}

}