definition {

	property testray.main.component.name = "Support QA";
	property type = "customer.integration";

	setUp {
		Passwords.getPasswords();

		KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		KoroneikiProductPurchaseAPI.generateStaticPastStartAndEndDate();

		KoroneikiProductPurchaseAPI.generateStaticFutureStartAndEndDate();

		OSBAdminRabbitMQ.generateProvisioningCompanyName();

		OSBAdminRabbitMQ.generateProvisioningProjectName();

		Data.generateSupportUser();

		Data._renameFirstSupportUserVariables();

		JSONOkta.createOktaUser(table = '''| Screen Name   | ${staticScreenNameValue1}       |
	| Email Address | ${staticEmailValue1}            |
	| First Name    | ${staticContactFirstNameValue1} |
	| Last Name     | ${staticContactLastNameValue1}  |
	| Group         | Employees                       |
	| Group         | Account Access US               |''');

		Data.generateSupportUser();

		Data._renameSecondSupportUserVariables();

		JSONOkta.createOktaUser(table = '''| Screen Name   | ${staticScreenNameValue2}       |
	| Email Address | ${staticEmailValue2}            |
	| First Name    | ${staticContactFirstNameValue2} |
	| Last Name     | ${staticContactLastNameValue2}  |
	| Group         | Employees                       |
	| Group         | Account Access EU               |''');

		KoroneikiAccountAPI._createAccount(table = '''| Code   | KORCSTKORCST                  | |
	| Name   | Korcst - ${staticProjectName} | |
	| Region | United States                 | |
	| Status | Active                        | |
	| Tier   | T1                            | |''');

		KoroneikiAccountAPI._createAccount(table = '''| Code   | KORCT2KORCT2                   | |
	| Name   | Korcst2 - ${staticProjectName} | |
	| Region | Spain                          | |
	| Status | Active                         | |
	| Tier   | T1                             | |''');
	}

	tearDown {
		KoroneikiTeamAPI._tearDownTeams(table = '''| CSTM Customer |''');

		OSBAdminProject.tearDownProjects(table = '''| KORCSTKORCST |
	| KORCT2KORCT2 |''');

		KoroneikiAccountAPI._tearDownAccounts(table = '''| Korcst - ${staticProjectName}  |
	| Korcst2 - ${staticProjectName} |''');

		KoroneikiAccountAPI._tearDownAccountsViaAccountFieldNameAndValue(
			fieldName = "Code",
			table = '''| KORCSTKORCST |
	| KORCT2KORCT2 |''');

		JSONUser.tearDownUsersViaSupport(table = '''| ${staticEmailValue1} |
	| ${staticEmailValue2} |''');

		JSONUser.tearDownUsersViaKoroneiki(table = '''| ${staticEmailValue1} |
	| ${staticEmailValue2} |''');

		KoroneikiContactAPI._tearDownContacts(table = '''| ${staticEmailValue1} |
	| ${staticEmailValue2} |''');

		JSONOkta.tearDownUsers(table = '''| ${staticEmailValue1} |
	| ${staticEmailValue2} |''');
	}

	test ViewEURegionaccountasanEUEmployeeonCustomer {
		KoroneikiContactAPI._viewContactSyncViaEmailAddress(contactEmailAddress = ${staticEmailValue1});

		KoroneikiContactAPI._viewAccountSyncViaUuid(
			accountName = "Liferay, Inc.",
			contactEmailAddress = ${staticEmailValue1});

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - DXP");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - Portal");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - Commerce");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Liferay Employee");

		JSONUser.viewSupportUserSync(userEmailAddress = ${staticEmailValue1});

		JSONUser.viewSupportUserOrganizationSync(
			organizationName = "Employees",
			userEmailAddress = ${staticEmailValue1});

		Passwords.getPasswords();

		JSONOkta.assignUserToOktaGroup(
			groupName = "Data Access US",
			userEmailAddress = ${staticEmailValue1});

		KoroneikiContactAPI._viewTeamSyncViaUuid(
			contactEmailAddress = ${staticEmailValue1},
			teamName = "Account Access US");

		JSONUser.viewSupportUserOrganizationSync(
			organizationName = "Data Access US",
			userEmailAddress = ${staticEmailValue1});

		CustomerLogin.loginToCustomer(
			userEmailAddress = ${staticCustomerAdminEmailAddress},
			userPassword = ${staticCustomerAdminPassword});

		CustomerProjects._viewCustomerProjectDetails(
			projectName = "Korcst - ${staticProjectName}",
			table = '''| Name           | Korcst - ${staticProjectName} |
	| Code           | KORCSTKORCST                  |
	| State          | ACTIVE                        |
	| Support Region | United States                 |
	| SLA            | -                             |
	| Support Seats  | 0 / 0 Filled                  |
	| Tier           | T1                            |
	| FLS Partner    | -                             |''');

		CustomerProjects._viewCustomerProjectDetails(
			projectName = "Korcst - ${staticProjectName}",
			table = '''| Name           | Korcst - ${staticProjectName} |
	| Code           | KORCSTKORCST                  |
	| State          | ACTIVE                        |
	| Support Region | Spain                         |
	| SLA            | -                             |
	| Support Seats  | 0 / 0 Filled                  |
	| Tier           | T1                            |
	| FLS Partner    | -                             |''');
	}

	test ViewUSandEURegionaccountsasanUSEmployeeonCustomer {
		KoroneikiContactAPI._viewAccountSyncViaUuid(
			accountName = "Liferay, Inc.",
			contactEmailAddress = ${staticEmailValue1});

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - DXP");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - Portal");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - Commerce");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Liferay Employee");

		JSONUser.viewSupportUserSync(userEmailAddress = ${staticEmailValue1});

		JSONUser.viewSupportUserOrganizationSync(
			organizationName = "Employees",
			userEmailAddress = ${staticEmailValue1});

		Passwords.getPasswords();

		JSONOkta.assignUserToOktaGroup(
			groupName = "Data Access US",
			userEmailAddress = ${staticEmailValue1});

		KoroneikiContactAPI._viewTeamSyncViaUuid(
			contactEmailAddress = ${staticEmailValue1},
			teamName = "Account Access US");

		JSONUser.viewSupportUserOrganizationSync(
			organizationName = "Data Access US",
			userEmailAddress = ${staticEmailValue1});

		CustomerLogin.loginToCustomer(
			userEmailAddress = ${staticCustomerAdminEmailAddress},
			userPassword = ${staticCustomerAdminPassword});

		CustomerProjects._viewCustomerProjectDetails(
			projectName = "Korcst - ${staticProjectName}",
			table = '''| Name           | Korcst - ${staticProjectName} |
	| Code           | KORCSTKORCST                  |
	| State          | ACTIVE                        |
	| Support Region | United States                 |
	| SLA            | -                             |
	| Support Seats  | 0 / 0 Filled                  |
	| Tier           | T1                            |
	| FLS Partner    | -                             |''');

		CustomerProjects._viewCustomerProjectDetails(
			projectName = "Korcst - ${staticProjectName}",
			table = '''| Name           | Korcst - ${staticProjectName} |
	| Code           | KORCSTKORCST                  |
	| State          | ACTIVE                        |
	| Support Region | Spain                         |
	| SLA            | -                             |
	| Support Seats  | 0 / 0 Filled                  |
	| Tier           | T1                            |
	| FLS Partner    | -                             |''');
	}

}