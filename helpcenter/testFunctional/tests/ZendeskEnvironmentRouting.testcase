definition {

	property testray.main.component.name = "Support QA";
	property type = "zendesk.api";

	setUp {
		Passwords.getPasswords();
	}

	tearDown {
		ZendeskTicketAPI._tearDownTicketByIds(ticketIdList = ${staticRequestIdList});

		ZendeskUserAPI._tearDownUsersByExternalIdTable(table = '''| User1  |
	| Agent1 |''');

		ZendeskOrganizationAPI._tearDownOrganizationsByExternalIdTable(table = '''| 12345678 |''');

		ZendeskHomepage.pause(timeInSeconds = 3);
	}

	test NonProductionEnvironmentRouting {
		ZendeskOrganizationAPI._createOrganization(table = '''| Status           | Approved                   |
	| Name             | Organization Name 1        |
	| Tags             | liferay_dxp,liferay_portal |
	| Shared Tickets   | true                       |
	| Shared Comments  | true                       |
	| SLA              | Gold                       |
	| Tier             | T4                         |
	| Support Region   | US                         |
	| Support Language | English                    |
	| External ID      | 12345678                   |''');

		ZendeskUserAPI._createUser(table = '''| Name             | Zendesk User1                    |
	| Tags             | osb_customer,osb_kb              |
	| Password         | ${staticZendeskAdminPassword}    |
	| Role             | End-user                         |
	| Access           | Organization                     |
	| Email            | zendesk.user1@zendesk.com.broken |
	| Phone Number     | +1 (555) 555-5555                |
	| Organization     | Organization Name 1              |
	| Language         | Portuguese                       |
	| Time Zone        | Brasilia                         |
	| External ID      | User1                            |''');

		ZendeskRequestAPI._createMultipleRequestsWithProductAndComponentAndSystemStatusValues(
			requesterEmail = "zendesk.user1@zendesk.com.broken",
			table = '''| prd_liferay_dxp_7_4    | authentication          | non-production_completely_shutdown                   |
	| prd_liferay_dxp_7_3    | caching_clustering      | non-production_severely_impacted_inoperable          |
	| prd_liferay_portal_6_2 | calendar                | non-production_unstable_with_periodic_interruptions  |
	| prd_liferay_portal_6_1 | collaboration_suite     | non-production_functioning_with_limited_capabilities |
	| prd_liferay_portal_6_0 | deployment_environments | non-production_fully_functional_with_observed_errors |''');

		ZendeskTicketAPI._viewMultipleTicketEnvironments(
			environment = "non-production",
			ticketIdList = ${staticRequestIdList});
	}


	test ProductionEnvironmentRouting {
	property help.center.acceptance = "true";
		ZendeskOrganizationAPI._createOrganization(table = '''| Status           | Approved                   |
	| Name             | Organization Name 1        |
	| Tags             | liferay_dxp,liferay_portal |
	| Shared Tickets   | true                       |
	| Shared Comments  | true                       |
	| SLA              | Gold                       |
	| Tier             | T4                         |
	| Support Region   | US                         |
	| Support Language | English                    |
	| External ID      | 12345678                   |''');

		ZendeskUserAPI._createUser(table = '''| Name             | Zendesk User1                    |
	| Tags             | osb_customer,osb_kb              |
	| Password         | ${staticZendeskAdminPassword}    |
	| Role             | End-user                         |
	| Access           | Organization                     |
	| Email            | zendesk.user1@zendesk.com.broken |
	| Phone Number     | +1 (555) 555-5555                |
	| Organization     | Organization Name 1              |
	| Language         | Portuguese                       |
	| Time Zone        | Brasilia                         |
	| External ID      | User1                            |''');

		ZendeskRequestAPI._createMultipleRequestsWithProductAndComponentAndSystemStatusValues(
			requesterEmail = "zendesk.user1@zendesk.com.broken",
			table = '''| prd_liferay_dxp_7_4    | authentication          | production_completely_shutdown                   |
	| prd_liferay_dxp_7_3    | caching_clustering      | production_severely_impacted_inoperable          |
	| prd_liferay_portal_6_2 | calendar                | production_unstable_with_periodic_interruptions  |
	| prd_liferay_portal_6_1 | collaboration_suite     | production_functioning_with_limited_capabilities |
	| prd_liferay_portal_6_0 | deployment_environments | production_fully_functional_with_observed_errors |''');

		ZendeskTicketAPI._viewMultipleTicketEnvironments(
			environment = "production",
			ticketIdList = ${staticRequestIdList});
	}

	test ResolutionPlanningRouting {
		ZendeskOrganizationAPI._createOrganization(table = '''| Status           | Approved            |
	| Name             | Organization Name 1 |
	| Tags             | lxc_sm              |
	| Shared Tickets   | true                |
	| Shared Comments  | true                |
	| SLA              | Gold                |
	| Tier             | T4                  |
	| Support Region   | US                  |
	| Support Language | English             |
	| External ID      | 12345678            |''');

		ZendeskOrganizationAPI._assignTagsToOrganizationViaOrganizationExternalID(
			organizationExternalId = 12345678,
			table = '''| developer_tools         |
	| enterprise_search       |
	| liferay_commerce        |
	| liferay_dxp             |
	| liferay_portal          |
	| management_tools_lcs    |
	| mobile_device_detection |
	| mobile_experience       |
	| productivity_tools_sync |
	| social_office           |''');

		ZendeskUserAPI._createUser(table = '''| Name             | Zendesk User1                    |
	| Tags             | osb_customer,osb_kb              |
	| Password         | ${staticZendeskAdminPassword}    |
	| Role             | End-user                         |
	| Access           | Organization                     |
	| Email            | zendesk.user1@zendesk.com.broken |
	| Phone Number     | +1 (555) 555-5555                |
	| Organization     | Organization Name 1              |
	| Language         | English                          |
	| Time Zone        | Pacific Time (US & Canada)       |
	| External ID      | User1                            |''');

		ZendeskRequestAPI._createMultipleRequestsWithProductAndComponentValues(
			requesterEmail = "zendesk.user1@zendesk.com.broken",
			table = '''| prd_developer_tools         |                                        |
	| prd_enterprise_search       | monitoring                             |
	| prd_liferay_commerce_1_1    | apis_integrations_and_extension_points |
	| prd_liferay_commerce_2_0    | commerce_insights                      |
	| prd_liferay_commerce_2_1    | configuration_and_settings             |
	| prd_liferay_commerce_3_0    | connectors                             |
	| prd_liferay_commerce_4_0    | digital_merchandise_management         |
	| prd_liferay_dxp_7_4         | authentication                         |
	| prd_liferay_dxp_7_3         | caching_clustering                     |
	| prd_liferay_dxp_7_2         | calendar                               |
	| prd_liferay_dxp_7_1         | collaboration                          |
	| prd_liferay_dxp_7_0         | content_management                     |
	| prd_liferay_portal_6_2      | collaboration_suite                    |
	| prd_liferay_portal_6_1      | deployment_environments                |
	| prd_liferay_portal_6_0      | document_management                    |
	| prd_liferay_portal_5_2      | liferay_api                            |
	| prd_management_tools_lcs    |                                        |
	| prd_mobile_device_detection |                                        |
	| prd_mobile_experience       |                                        |
	| prd_productivity_tools_sync |                                        |
	| prd_social_office           |                                        |''');

		ZendeskTicketAPI._assignTagsToTickets(
			table = '''| jira_verified |''',
			ticketIdList = ${staticRequestIdList});

		ZendeskTicketAPI._viewMultipleTicketSubStatuses(
			subStatus = "resolution_planning",
			ticketIdList = ${staticRequestIdList});

		ZendeskTicketAPI._viewSpecificTagForMultipleTickets(
			tagName = "resolution_planning",
			ticketIdList = ${staticRequestIdList});

		ZendeskTicketAPI._viewNoSpecificTagForMultipleTickets(
			tagName = "jira_verified",
			ticketIdList = ${staticRequestIdList});
	}

}