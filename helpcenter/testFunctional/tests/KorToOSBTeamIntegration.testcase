	| Update Field Name           | name                          |
	| Update Field Original Value | OSB Devlopr Team              |
	| Update Field New Value      | OSB Mktng Team                |''');
	}

	test Updateteamexecutedbyagent {
		LocalFile.OSBAdminRabbitMQ.generateProvisioningProjectName();

		LocalFile.KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORONEKORONE                         | |
	| Contact Email Address | osb.koroneiki1@lrcustomer.com.broken | |
	| Description           | Test osb account on koroneiki        | |
	| Fax Number            | 555-555-1234                         | |
	| Name                  | Korone - ${staticProjectName}        | |
	| Phone Number          | 555-555-5678                         | |
	| Profile Email Address | osb.koroneiki1@lrcustomer.com.broken | |
	| Region                | United States                        | |
	| Status                | Active                               | |
	| Tier                  | T4                                   | |
	| Website               | www.koroneikicorporation.com         | |''');

		LocalFile.KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		LocalFile.KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korone - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | true                     | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		LocalFile.KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korone - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | true                     | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		LocalFile.KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		LocalFile.KoroneikiAccountAPI._createAccountTeamExecutedByAgent(
			accountName = "Korone - ${staticProjectName}",
			agentName = "Koroneiki User",
			teamName = "OSB Devlopr Team");

		LocalFile.KoroneikiTeamAPI.updateTeamExecutedByAgent(
			agentName = "Koroneiki User",
			teamName = "OSB Devlopr Team",
			teamNameEdit = "OSB Mktng Team");

		LocalFile.OSBAdmin.loginToSupport(
			userEmailAddress = ${staticSupportAdminEmailAdress},
			userPassword = ${staticSupportAdminPassword});

		LocalFile.ProjectDetails.gotoProjectDetailsPage();

		LocalFile.ProjectDetails.searchKeyword(keyword = "Korone");

		LocalFile.ProjectDetails.gotoProject(projectName = "Korone - ${staticProjectName}");

		LocalFile.ProjectDetails.gotoHistory();

		LocalFile.ProjectDetails.viewHistoryEntryByKeywords(
			fieldName = "name",
			keyword1 = "Added Team",
			keyword2 = "OSB Devlopr Team",
			table = '''| Updater Name                | Koroneiki User   |
	| Update Summary              | Added Team       |
	| Update Date                 | Today            |
	| Update Field Name           | name             |
	| Update Field Original Value | N/A              |
	| Update Field New Value      | OSB Devlopr Team |''');

		LocalFile.ProjectDetails.viewHistoryEntryByKeywords(
			fieldName = "name",
			keyword1 = "Updated Team",
			keyword2 = "OSB Devlopr Team",
			table = '''| Updater Name                | Koroneiki User   |
	| Update Summary              | Updated Team     |
	| Update Date                 | Today            |
	| Update Field Name           | name             |
	| Update Field Original Value | OSB Devlopr Team |
	| Update Field New Value      | OSB Mktng Team   |''');
