definition {

	property testray.main.component.name = "Support QA";
	property type = "customer.portal";

	setUp {
		OSBAdminRabbitMQ.generateProvisioningProjectName();

		Passwords.getPasswords();

		KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		Data.generateSupportUser();

		Data._renameFirstSupportUserVariables();

		JSONOkta.createOktaUser(table = '''| Screen Name   | ${staticScreenNameValue1}       |
	| Email Address | ${staticEmailValue1}            |
	| First Name    | ${staticContactFirstNameValue1} |
	| Last Name     | ${staticContactLastNameValue1}  |''');

		Data.generateSupportUser();

		Data._renameSecondSupportUserVariables();

		JSONOkta.createOktaUser(table = '''| Screen Name   | ${staticScreenNameValue2}       |
	| Email Address | ${staticEmailValue2}            |
	| First Name    | ${staticContactFirstNameValue2} |
	| Last Name     | ${staticContactLastNameValue2}  |
	| Group         | Employees                       |''');
	}

	tearDown {
		ZendeskUserAPI._getDefaultUserId(organizationName = "Sfpzen - ${staticProjectName}");

		OSBAdminProject.tearDownProjects(table = '''| SFPZENSFPZEN |''');

		KoroneikiAccountAPI._tearDownAccounts(table = '''| Sfpzen - ${staticProjectName} |''');

		KoroneikiAccountAPI._tearDownAccountsViaAccountFieldNameAndValue(
			fieldName = "Code",
			table = '''| SFPZENSFPZEN |''');

		JSONUser.tearDownUsers(table = '''| ${staticEmailValue1} |
	| ${staticEmailValue2} |''');

		JSONUser.tearDownUsersViaSupport(table = '''| ${staticEmailValue1} |
	| ${staticEmailValue2} |''');

		JSONUser.tearDownUsersViaKoroneiki(table = '''| ${staticEmailValue1} |
	| ${staticEmailValue2} |''');

		KoroneikiContactAPI._tearDownContacts(table = '''| ${staticEmailValue1} |
	| ${staticEmailValue2} |''');

		JSONOkta.tearDownUsers(table = '''| ${staticEmailValue1} |
	| ${staticEmailValue2} |''');

		ZendeskUserAPI._getMultipleUserIdsByEmailAddress(table = '''| ${staticEmailValue1} |
	| ${staticEmailValue2} |''');

		ZendeskUserAPI._tearDownUsersByIdList(userIds = ${staticUserIdList});

		ZendeskOrganizationAPI._getMultipleOrganizationExternalIdsByOrganizationNameIfStillPresent(table = '''| Sfpzen - ${staticProjectName} |''');

		ZendeskOrganizationAPI._tearDownOrganizationsByExternalIdList(organizationExternalIds = ${staticOrganizationExternalIdList});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId});

		Downloads.teardownDownloadedListedFiles(list = ${staticDownloadedListName});
	}

	test Downloaddxpselfprovisioninglicense {
		KoroneikiAccountAPI._createAccount(table = '''| Code   | SFPZENSFPZEN                  | |
	| Name   | Sfpzen - ${staticProjectName} | |
	| Region | United States                 | |
	| Status | Active                        | |
	| Tier   | T1                            | |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Sfpzen - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| End Date                | ${staticEndDate}         |   |
	| Original End Date       | ${staticOriginalEndDate} |   |
	| Perpetual               | false                    |   |
	| Product Field and Value | sizing                   | 1 |
	| Product Field and Value | licenses                 | 1 |
	| Product Field and Value | version                  | 7 |
	| Quantity                | 1                        |   |
	| Start Date              | ${staticStartDate}       |   |
	| Status                  | Approved                 |   |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Sfpzen - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Sfpzen - ${staticProjectName}",
			contactEmailAddress = ${staticEmailValue1},
			table = '''| Support Requester |''');

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - DXP");

		JSONUser.viewSupportUserSync(userEmailAddress = ${staticEmailValue1});

		JSONUser.updateSupportPassword(
			userEmailAddress = ${staticEmailValue1},
			userPassword = ${staticSupportUserTestPassword});

		JSONUser.assignUserToSupportGroup(
			groupName = "Help Center",
			userEmailAddress = ${staticEmailValue1});

		JSONUser.assignUserToSupportRole(
			roleName = "Customer - DXP",
			userEmailAddress = ${staticEmailValue1});

		JSONUser.assignUserToSupportUserGroup(
			userEmailAddress = ${staticEmailValue1},
			userGroupName = "customer");

		OSBAdmin.logoutAndLoginToSupport(
			userEmailAddress = ${staticEmailValue1},
			userPassword = ${staticSupportUserTestPassword});

		SelfProvisioning.gotoSelfProvisioningPage();

		SelfProvisioning.downloadSelfProvisioningLicense(table = '''| Project | Sfpzen - ${staticProjectName} |
	| Product | DXP                           |
	| Version | 7.4                           |''');

		SelfProvisioning.downloadSelfProvisioningLicense(table = '''| Project | Sfpzen - ${staticProjectName} |
	| Product | DXP                           |
	| Version | 7.3                           |''');

		SelfProvisioning.downloadSelfProvisioningLicense(table = '''| Project | Sfpzen - ${staticProjectName} |
	| Product | DXP                           |
	| Version | 7.2                           |''');

		SelfProvisioning.downloadSelfProvisioningLicense(table = '''| Project | Sfpzen - ${staticProjectName} |
	| Product | DXP                           |
	| Version | 7.1                           |''');

		SelfProvisioning.downloadSelfProvisioningLicense(table = '''| Project | Sfpzen - ${staticProjectName} |
	| Product | DXP                           |
	| Version | 7.0                           |''');

		ProvisioningLicense.assertDownloadedLicensePresent(
			fileType = "xml",
			table = '''| License Type | activation-key            |
	| Product      | DXP Development           |
	| Version      | 7.4                       |
	| License Name | Developer Activation Keys |''');

		ProvisioningLicense.assertDownloadedLicensePresent(
			fileType = "xml",
			table = '''| License Type | activation-key            |
	| Product      | DXP Development           |
	| Version      | 7.3                       |
	| License Name | Developer Activation Keys |''');

		ProvisioningLicense.assertDownloadedLicensePresent(
			fileType = "xml",
			table = '''| License Type | activation-key            |
	| Product      | DXP Development           |
	| Version      | 7.1                       |
	| License Name | Developer Activation Keys |''');

		ProvisioningLicense.assertDownloadedLicensePresent(
			fileType = "xml",
			table = '''| License Type | activation-key            |
	| Product      | DXP Development           |
	| Version      | 7.0                       |
	| License Name | Developer Activation Keys |''');
	}

	test Viewcommerceoptions {
		KoroneikiAccountAPI._createAccount(table = '''| Code   | SFPZENSFPZEN                  | |
	| Name   | Sfpzen - ${staticProjectName} | |
	| Region | United States                 | |
	| Status | Active                        | |
	| Tier   | T1                            | |''');

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Sfpzen - ${staticProjectName}",
			contactEmailAddress = ${staticEmailValue1},
			table = '''| Support Requester |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Sfpzen - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| End Date                | ${staticEndDate}         |   |
	| Original End Date       | ${staticOriginalEndDate} |   |
	| Perpetual               | false                    |   |
	| Product Field and Value | sizing                   | 1 |
	| Product Field and Value | licenses                 | 1 |
	| Product Field and Value | version                  | 7 |
	| Quantity                | 1                        |   |
	| Start Date              | ${staticStartDate}       |   |
	| Status                  | Approved                 |   |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Sfpzen - ${staticProjectName}",
			productName = "Commerce Subscription Production",
			table = '''| End Date                | ${staticEndDate}         |   |
	| Original End Date       | ${staticOriginalEndDate} |   |
	| Perpetual               | false                    |   |
	| Product Field and Value | sizing                   | 1 |
	| Product Field and Value | licenses                 | 1 |
	| Product Field and Value | version                  | 0 |
	| Quantity                | 1                        |   |
	| Start Date              | ${staticStartDate}       |   |
	| Status                  | Approved                 |   |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Sfpzen - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - DXP");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - Commerce");

		JSONUser.viewSupportUserSync(userEmailAddress = ${staticEmailValue1});

		JSONUser.updateSupportPassword(
			userEmailAddress = ${staticEmailValue1},
			userPassword = ${staticSupportUserTestPassword});

		JSONUser.assignUserToSupportGroup(
			groupName = "Help Center",
			userEmailAddress = ${staticEmailValue1});

		JSONUser.assignUserToSupportRole(
			roleName = "Customer - DXP",
			userEmailAddress = ${staticEmailValue1});

		JSONUser.assignUserToSupportRole(
			roleName = "Customer - Liferay Commerce",
			userEmailAddress = ${staticEmailValue1});

		JSONUser.assignUserToSupportUserGroup(
			userEmailAddress = ${staticEmailValue1},
			userGroupName = "customer");

		OSBAdmin.logoutAndLoginToSupport(
			userEmailAddress = ${staticEmailValue1},
			userPassword = ${staticSupportUserTestPassword});

		SelfProvisioning.gotoSelfProvisioningPage();

		SelfProvisioning.viewSelfProvisioningOptions(table = '''| Project | Sfpzen - ${staticProjectName} |
	| Product | Commerce Subscription         |
	| Version | 1                             |''');
	}

	test ViewcommerceoptionsviacommerceforLXCSMpurchase {
		KoroneikiAccountAPI._createAccount(table = '''| Code   | SFPZENSFPZEN                  | |
	| Name   | Sfpzen - ${staticProjectName} | |
	| Region | United States                 | |
	| Status | Active                        | |
	| Tier   | T1                            | |''');

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Sfpzen - ${staticProjectName}",
			contactEmailAddress = ${staticEmailValue1},
			table = '''| Support Requester |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Sfpzen - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| End Date                | ${staticEndDate}         |   |
	| Original End Date       | ${staticOriginalEndDate} |   |
	| Perpetual               | false                    |   |
	| Product Field and Value | sizing                   | 1 |
	| Product Field and Value | licenses                 | 1 |
	| Product Field and Value | version                  | 7 |
	| Quantity                | 1                        |   |
	| Start Date              | ${staticStartDate}       |   |
	| Status                  | Approved                 |   |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Sfpzen - ${staticProjectName}",
			productName = "Commerce for LXC SM Production",
			table = '''| End Date                | ${staticEndDate}         |   |
	| Original End Date       | ${staticOriginalEndDate} |   |
	| Perpetual               | false                    |   |
	| Product Field and Value | sizing                   | 1 |
	| Product Field and Value | licenses                 | 1 |
	| Product Field and Value | version                  | 0 |
	| Quantity                | 1                        |   |
	| Start Date              | ${staticStartDate}       |   |
	| Status                  | Approved                 |   |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Sfpzen - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - DXP");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - Commerce");

		JSONUser.viewSupportUserSync(userEmailAddress = ${staticEmailValue1});

		JSONUser.updateSupportPassword(
			userEmailAddress = ${staticEmailValue1},
			userPassword = ${staticSupportUserTestPassword});

		JSONUser.assignUserToSupportGroup(
			groupName = "Help Center",
			userEmailAddress = ${staticEmailValue1});

		JSONUser.assignUserToSupportRole(
			roleName = "Customer - DXP",
			userEmailAddress = ${staticEmailValue1});

		JSONUser.assignUserToSupportRole(
			roleName = "Customer - Liferay Commerce",
			userEmailAddress = ${staticEmailValue1});

		JSONUser.assignUserToSupportUserGroup(
			userEmailAddress = ${staticEmailValue1},
			userGroupName = "customer");

		OSBAdmin.logoutAndLoginToSupport(
			userEmailAddress = ${staticEmailValue1},
			userPassword = ${staticSupportUserTestPassword});

		SelfProvisioning.gotoSelfProvisioningPage();

		SelfProvisioning.viewSelfProvisioningOptions(table = '''| Project | Sfpzen - ${staticProjectName} |
	| Product | Commerce Subscription         |
	| Version | 1                             |''');
	}


	test Viewdxpoptions {
	property help.center.acceptance = "true";
		KoroneikiAccountAPI._createAccount(table = '''| Code   | SFPZENSFPZEN                  | |
	| Name   | Sfpzen - ${staticProjectName} | |
	| Region | United States                 | |
	| Status | Active                        | |
	| Tier   | T1                            | |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Sfpzen - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| End Date                | ${staticEndDate}         |   |
	| Original End Date       | ${staticOriginalEndDate} |   |
	| Perpetual               | false                    |   |
	| Product Field and Value | sizing                   | 1 |
	| Product Field and Value | licenses                 | 1 |
	| Product Field and Value | version                  | 7 |
	| Quantity                | 1                        |   |
	| Start Date              | ${staticStartDate}       |   |
	| Status                  | Approved                 |   |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Sfpzen - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Sfpzen - ${staticProjectName}",
			contactEmailAddress = ${staticEmailValue1},
			table = '''| Support Requester |''');

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - DXP");

		JSONUser.viewSupportUserSync(userEmailAddress = ${staticEmailValue1});

		JSONUser.updateSupportPassword(
			userEmailAddress = ${staticEmailValue1},
			userPassword = ${staticSupportUserTestPassword});

		JSONUser.assignUserToSupportGroup(
			groupName = "Help Center",
			userEmailAddress = ${staticEmailValue1});

		JSONUser.assignUserToSupportRole(
			roleName = "Customer - DXP",
			userEmailAddress = ${staticEmailValue1});

		JSONUser.assignUserToSupportUserGroup(
			userEmailAddress = ${staticEmailValue1},
			userGroupName = "customer");

		OSBAdmin.logoutAndLoginToSupport(
			userEmailAddress = ${staticEmailValue1},
			userPassword = ${staticSupportUserTestPassword});

		SelfProvisioning.gotoSelfProvisioningPage();

		SelfProvisioning.viewSelfProvisioningOptions(table = '''| Project | Sfpzen - ${staticProjectName} |
	| Product | DXP                           |
	| Version | 7.4                           |
	| Version | 7.3                           |
	| Version | 7.2                           |
	| Version | 7.1                           |
	| Version | 7.0                           |''');
	}

	test Viewemployeeoptions {
		KoroneikiContactAPI._viewContactSyncViaEmailAddress(contactEmailAddress = ${staticEmailValue2});

		KoroneikiContactAPI._viewAccountSyncViaUuid(
			accountName = "Liferay, Inc.",
			contactEmailAddress = ${staticEmailValue2});

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - DXP");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - Portal");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - Commerce");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Liferay Employee");

		JSONUser.viewSupportUserSync(userEmailAddress = ${staticEmailValue2});

		JSONUser.updateSupportPassword(
			userEmailAddress = ${staticEmailValue2},
			userPassword = ${staticSupportUserTestPassword});

		OSBAdmin.logoutAndLoginToSupport(
			userEmailAddress = ${staticEmailValue2},
			userPassword = ${staticSupportUserTestPassword});

		SelfProvisioning.gotoSelfProvisioningPage();

		SelfProvisioning.viewSelfProvisioningOptions(table = '''| Project | Liferay, Inc.         |
	| Product | Commerce Subscription |
	| Product | DXP                   |
	| Product | Portal                |''');
	}

	test Viewportaloptions {
		KoroneikiAccountAPI._createAccount(table = '''| Code   | SFPZENSFPZEN                  | |
	| Name   | Sfpzen - ${staticProjectName} | |
	| Region | United States                 | |
	| Status | Active                        | |
	| Tier   | T1                            | |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Sfpzen - ${staticProjectName}",
			productName = "Portal Production",
			table = '''| End Date                | ${staticEndDate}         |   |
	| Original End Date       | ${staticOriginalEndDate} |   |
	| Perpetual               | false                    |   |
	| Product Field and Value | sizing                   | 1 |
	| Product Field and Value | licenses                 | 1 |
	| Product Field and Value | version                  | 6 |
	| Quantity                | 1                        |   |
	| Start Date              | ${staticStartDate}       |   |
	| Status                  | Approved                 |   |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Sfpzen - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Sfpzen - ${staticProjectName}",
			contactEmailAddress = ${staticEmailValue1},
			table = '''| Support Requester |''');

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - Portal");

		JSONUser.viewSupportUserSync(userEmailAddress = ${staticEmailValue1});

		JSONUser.updateSupportPassword(
			userEmailAddress = ${staticEmailValue1},
			userPassword = ${staticSupportUserTestPassword});

		JSONUser.assignUserToSupportGroup(
			groupName = "Help Center",
			userEmailAddress = ${staticEmailValue1});

		JSONUser.assignUserToSupportRole(
			roleName = "Customer - Portal",
			userEmailAddress = ${staticEmailValue1});

		JSONUser.assignUserToSupportUserGroup(
			userEmailAddress = ${staticEmailValue1},
			userGroupName = "customer");

		OSBAdmin.logoutAndLoginToSupport(
			userEmailAddress = ${staticEmailValue1},
			userPassword = ${staticSupportUserTestPassword});

		SelfProvisioning.gotoSelfProvisioningPage();

		SelfProvisioning.viewSelfProvisioningOptions(table = '''| Project | Sfpzen - ${staticProjectName} |
	| Product | Portal                        |
	| Version | 6.2                           |
	| Version | 6.1                           |
	| Version | 6.0                           |
	| Version | 5.2                           |
	| Version | 5.1                           |''');
	}

}