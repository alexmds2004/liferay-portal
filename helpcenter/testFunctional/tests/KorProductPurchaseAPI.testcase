definition {

	property testray.main.component.name = "Support QA";
	property type = "koroneiki";

	tearDown {
		KoroneikiAccountAPI._tearDownAccounts(table = '''| Koroneiki Auto Subsidiary |
	| Koroneiki Engr Subsidiary |
	| Koroneiki Automotive      |
	| Koroneiki Engineering     |''');

		KoroneikiProductAPI._tearDownProducts(table = '''| Liferay Digital Experience Platform |
	| Liferay Portal Six                  |''');
	}

	test Createandviewfutureproductpurchase {
		KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORAUTO                                  | |
	| Contact Email Address | koroneiki.contact1@lrcustomer.com.broken | |
	| Description           | Test automotive account on koroneiki     | |
	| Fax Number            | 555-555-1234                             | |
	| Name                  | Koroneiki Automotive                     | |
	| Phone Number          | 555-555-5678                             | |
	| Profile Email Address | koroneiki.contact1@lrcustomer.com.broken | |
	| Region                | United States                            | |
	| Status                | Active                                   | |
	| Tier                  | T4                                       | |
	| Website               | www.koroneikiautomotive.com              | |''');

		KoroneikiProductAPI._createProduct(table = '''| Name | Liferay Digital Experience Platform | |''');

		KoroneikiProductPurchaseAPI.generateStaticFutureStartAndEndDate();

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Koroneiki Automotive",
			productName = "Liferay Digital Experience Platform",
			table = '''| End Date                | ${staticFutureEndDate}         |                |
	| Original End Date       | ${staticFutureOriginalEndDate} |                |
	| Perpetual               | false                          |                |
	| Product Field and Value | additionalProp1                | propertyValue1 |
	| Product Field and Value | additionalProp2                | propertyValue2 |
	| Product Field and Value | additionalProp3                | propertyValue3 |
	| Quantity                | 1                              |                |
	| Start Date              | ${staticFutureStartDate}       |                |
	| Status                  | Approved                       |                |''');

		KoroneikiProductPurchaseAPI._viewProductPurchase(
			accountName = "Koroneiki Automotive",
			productName = "Liferay Digital Experience Platform",
			table = '''| End Date                | ${staticFutureEndDate}         |                |
	| Original End Date       | ${staticFutureOriginalEndDate} |                |
	| Perpetual               | false                          |                |
	| Product Field and Value | additionalProp1                | propertyValue1 |
	| Product Field and Value | additionalProp2                | propertyValue2 |
	| Product Field and Value | additionalProp3                | propertyValue3 |
	| Quantity                | 1                              |                |
	| Start Date              | ${staticFutureStartDate}       |                |
	| Status                  | Approved                       |                |''');

		KoroneikiAccountAPI._viewProduct(
			accountName = "Koroneiki Automotive",
			filterName = "All",
			productName = "Liferay Digital Experience Platform",
			table = '''| Name | Liferay Digital Experience Platform | |''');

		KoroneikiAccountAPI._viewProduct(
			accountName = "Koroneiki Automotive",
			filterName = "Unactivated",
			productName = "Liferay Digital Experience Platform",
			table = '''| Name | Liferay Digital Experience Platform | |''');

		KoroneikiAccountAPI._viewNoProduct(
			accountName = "Koroneiki Automotive",
			filterName = "Expired",
			productName = "Liferay Digital Experience Platform");

		KoroneikiAccountAPI._viewNoProduct(
			accountName = "Koroneiki Automotive",
			filterName = "Active",
			productName = "Liferay Digital Experience Platform");

		KoroneikiAccountAPI._viewProductPurchase(
			accountName = "Koroneiki Automotive",
			filterName = "All",
			productName = "Liferay Digital Experience Platform",
			table = '''| End Date                | ${staticFutureEndDate}         |                |
	| Original End Date       | ${staticFutureOriginalEndDate} |                |
	| Perpetual               | false                          |                |
	| Product Field and Value | additionalProp1                | propertyValue1 |
	| Product Field and Value | additionalProp2                | propertyValue2 |
	| Product Field and Value | additionalProp3                | propertyValue3 |
	| Quantity                | 1                              |                |
	| Start Date              | ${staticFutureStartDate}       |                |
	| Status                  | Approved                       |                |''');

		KoroneikiAccountAPI._viewProductPurchase(
			accountName = "Koroneiki Automotive",
			filterName = "Unactivated",
			productName = "Liferay Digital Experience Platform",
			table = '''| End Date                | ${staticFutureEndDate}         |                |
	| Original End Date       | ${staticFutureOriginalEndDate} |                |
	| Perpetual               | false                          |                |
	| Product Field and Value | additionalProp1                | propertyValue1 |
	| Product Field and Value | additionalProp2                | propertyValue2 |
	| Product Field and Value | additionalProp3                | propertyValue3 |
	| Quantity                | 1                              |                |
	| Start Date              | ${staticFutureStartDate}       |                |
	| Status                  | Approved                       |                |''');
	}

	test Createandviewmultipleproductpurchases {
		KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORAUTO                                  | |
	| Contact Email Address | koroneiki.contact1@lrcustomer.com.broken | |
	| Description           | Test automotive account on koroneiki     | |
	| Fax Number            | 555-555-1234                             | |
	| Name                  | Koroneiki Automotive                     | |
	| Phone Number          | 555-555-5678                             | |
	| Profile Email Address | koroneiki.contact1@lrcustomer.com.broken | |
