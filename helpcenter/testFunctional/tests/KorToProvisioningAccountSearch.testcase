definition {

	property testray.main.component.name = "Support QA";
	property type = "provisioning.integration";

	setUp {
		LocalFile.Passwords.getPasswords();

		LocalFile.OSBAdminRabbitMQ.generateStaticVariables();

		LocalFile.OSBAdminRabbitMQ.generateProvisioningCompanyName();

		LocalFile.OSBAdminRabbitMQ.generateProvisioningProjectName();

		LocalFile.KoroneikiProductPurchaseAPI.generateStaticYyyyMmDdPastStartAndEndDate();

		LocalFile.KoroneikiProductPurchaseAPI.generateStaticYyyyMmDdFutureStartAndEndDate();

		LocalFile.JSONOkta.createOktaUser(table = '''| Screen Name   | sea.koroneiki1                       |
	| Email Address | sea.koroneiki1@lrcustomer.com.broken |
	| First Name    | SEA                                  |
	| Last Name     | Koroneiki1                           |''');

		LocalFile.JSONOkta.createOktaUser(table = '''| Screen Name   | sea.koroneiki2                       |
	| Email Address | sea.koroneiki2@lrcustomer.com.broken |
	| First Name    | SEA                                  |
	| Last Name     | Koroneiki2                           |''');
	}

	tearDown {
		LocalFile.ZendeskUserAPI._getDefaultUserId(organizationName = "Korsea - ${staticProjectName}");

		LocalFile.ZendeskUserAPI._renameFirstDefaultUserIdVariable();

		LocalFile.ZendeskUserAPI._getDefaultUserId(organizationName = "Onesea - ${staticProjectName}");

		LocalFile.ZendeskUserAPI._renameSecondDefaultUserIdVariable();

		LocalFile.ZendeskUserAPI._getDefaultUserId(organizationName = "Seakor - ${staticCompanyName}");

		LocalFile.ZendeskUserAPI._renameThirdDefaultUserIdVariable();

		LocalFile.KoroneikiTeamAPI._tearDownTeams(table = '''| Korsearch Partner |''');

		LocalFile.OSBAdminProject.tearDownProjects(table = '''| SEAKORKORSEA |
	| ONESEAONESEA |
	| SEAKOR       |''');

		LocalFile.KoroneikiAccountAPI._tearDownAccounts(table = '''| Korsea - ${staticProjectName} |
	| Onesea - ${staticProjectName} |
	| Seakor - ${staticCompanyName} |''');

		LocalFile.KoroneikiAccountAPI._tearDownAccountsViaAccountFieldNameAndValue(
			fieldName = "Code",
			table = '''| SEAKORKORSEA |
	| ONESEAONESEA |
	| SEAKOR       |''');

		LocalFile.JSONUser.tearDownUsers(table = '''| sea.koroneiki1@lrcustomer.com.broken |
	| sea.koroneiki2@lrcustomer.com.broken |''');

		LocalFile.JSONUser.tearDownUsersViaSupport(table = '''| sea.koroneiki1@lrcustomer.com.broken |
	| sea.koroneiki2@lrcustomer.com.broken |''');

		LocalFile.JSONUser.tearDownUsersViaKoroneiki(table = '''| sea.koroneiki1@lrcustomer.com.broken |
	| sea.koroneiki2@lrcustomer.com.broken |''');

		LocalFile.KoroneikiContactAPI._tearDownContacts(table = '''| sea.koroneiki1@lrcustomer.com.broken |
	| sea.koroneiki2@lrcustomer.com.broken |''');

		LocalFile.JSONOkta.tearDownUsers(table = '''| sea.koroneiki1@lrcustomer.com.broken |
	| sea.koroneiki2@lrcustomer.com.broken |''');

		LocalFile.ZendeskTicketAPI._tearDownTicketsByKeywords(table = '''| New Subscription(s) for Korsea - ${staticProjectName} |
	| New Subscription(s) for Seakor - ${staticCompanyName} |''');

		LocalFile.ZendeskUserAPI._getMultipleUserIdsByEmailAddress(table = '''| sea.koroneiki1@lrcustomer.com.broken |
	| sea.koroneiki2@lrcustomer.com.broken |''');

		LocalFile.ZendeskUserAPI._tearDownUsersByIdList(userIds = ${staticUserIdList});

		LocalFile.ZendeskOrganizationAPI._getMultipleOrganizationExternalIdsByOrganizationNameIfStillPresent(table = '''| Korsea - ${staticProjectName} |
	| Onesea - ${staticProjectName} |
	| Seakor - ${staticCompanyName} |''');

		LocalFile.ZendeskOrganizationAPI._tearDownOrganizationsByExternalIdList(organizationExternalIds = ${staticOrganizationExternalIdList});

		LocalFile.ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId1});

		LocalFile.ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId2});

		LocalFile.ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId3});
	}

	test Viewaccountsearchfieldviaprovisioningpages {
		LocalFile.OSBAdminRabbitMQ.publishCreateProjectWithNoPartnerMessage(
			routingKey = "dossiera.provisioning.create",
			table = '''| Account Name                           | Seakor - ${staticCompanyName}              |
	| Address City                           | Diamond Bar                                |
	| Address Country                        | United States                              |
	| Address Postal Code                    | 91765                                      |
	| Address Region                         | California                                 |
	| Address Street                         | 456 Fake Street                            |
	| Contact Email Address                  | sea.koroneiki1@lrcustomer.com.broken       |
	| Contact First Name                     | SEA                                        |
	| Contact Last Name                      | Koroneiki1                                 |
	| Dossiera Account Key                   | ${staticDossieraAccountKey}                |
	| Dossiera Address Key 1                 | ${staticDossieraAddressKey1}               |
	| Dossiera Address Key 2                 | ${staticDossieraAddressKey2}               |
	| Dossiera Contact Key                   | ${staticDossieraContactKey}                |
	| Dossiera Project Key                   | ${staticDossieraProjectKey}                |
	| End Day                                | ${staticEndDay}                            |
	| End Month                              | ${staticEndMonth}                          |
	| End Year                               | ${staticEndYear}                           |
	| Industry                               | Automotive                                 |
	| Owner Email Address                    | sea.koroneiki2@lrcustomer.com.broken       |
	| Owner First Name                       | SEA                                        |
	| Owner Last Name                        | Koroneiki2                                 |
	| Partner First Line Support             | false                                      |
	| Product Type                           | New                                        |
	| Product Name                           | Liferay Digital Enterprise - Prod Sizing 4 |
	| Project Name                           | Korsea - ${staticProjectName}              |
	| Renewal                                | false                                      |
	| Salesforce Opportunity Key             | ${staticSalesforceOpportunityKey}          |
	| Salesforce Opportunity Line Item Key 1 | ${staticSalesforceOpportunityLineItemKey1} |
	| Salesforce Opportunity Line Item Key 2 | ${staticSalesforceOpportunityLineItemKey2} |
	| Salesforce Opportunity Sold By         | Liferay US                                 |
	| Salesforce Opportunity Stage Name      | Closed Won                                 |
	| Salesforce Opportunity Territory       | United States                              |
	| Salesforce Opportunity Type            | New Business                               |
	| Salesforce Owner User Key              | ${staticSalesforceOwnerUserKey}            |
	| Salesforce Project Key                 | ${staticSalesforceProjectKey}              |
	| Start Day                              | ${staticStartDay}                          |
	| Start Month                            | ${staticStartMonth}                        |
	| Start Year                             | ${staticStartYear}                         |
	| Subscription Level                     | Platinum                                   |
	| Version Number                         | 7.1                                        |''');

		LocalFile.KoroneikiAccountAPI._createAccountTeam(
			accountName = "Korsea - ${staticProjectName}",
			teamName = "Korsearch Partner");

		LocalFile.KoroneikiAccountAPI._assignTeamRolesToTeam(
			accountName = "Korsea - ${staticProjectName}",
			table = '''| First Line Support |''',
			teamName = "Korsearch Partner");

		LocalFile.OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		LocalFile.Provisioning.gotoAccounts();

		LocalFile.Provisioning.viewSearchAccountsField();

		LocalFile.Provisioning.searchAccounts(keyword = "Korsea");

		LocalFile.Provisioning.viewSearchAccountsField();

		LocalFile.Provisioning.clickAccount(accountName = "Korsea - ${staticProjectName}");

		LocalFile.Provisioning.viewSearchAccountsField();

		LocalFile.Provisioning.clickTab(tabName = "Details");

		LocalFile.Provisioning.viewSearchAccountsField();

		LocalFile.Provisioning.clickTab(tabName = "Contacts");

		LocalFile.Provisioning.viewSearchAccountsField();

		LocalFile.Provisioning.clickTab(tabName = "Liferay Workers");

		LocalFile.Provisioning.viewSearchAccountsField();

		LocalFile.Provisioning.clickTab(tabName = "Licenses");

		LocalFile.Provisioning.viewSearchAccountsField();

		LocalFile.Provisioning.clickTab(tabName = "Teams");

		LocalFile.Provisioning.viewSearchAccountsField();

		LocalFile.Provisioning.clickTab(tabName = "Related Accounts");

		LocalFile.Provisioning.viewSearchAccountsField();

		LocalFile.ProvisioningAccount.clickRelatedAccountTab(tabName = "Active");

		LocalFile.Provisioning.viewSearchAccountsField();

		LocalFile.ProvisioningAccount.clickRelatedAccountTab(tabName = "Closed");

		LocalFile.Provisioning.viewSearchAccountsField();

		LocalFile.Provisioning.clickTab(tabName = "History");

		LocalFile.Provisioning.viewSearchAccountsField();

		LocalFile.Provisioning.clickTab(tabName = "Support");

		LocalFile.Provisioning.viewSearchAccountsField();

		LocalFile.Provisioning.clickTab(tabName = "Teams");

		LocalFile.Provisioning.viewSearchAccountsField();

		LocalFile.ProvisioningAccount.clickTeamLink(teamName = "Korsea - ${staticProjectName}");

		LocalFile.Provisioning.viewSearchAccountsField();

		LocalFile.Provisioning.clickTab(tabName = "Partner/Reseller/SI Accounts");

		LocalFile.Provisioning.viewSearchAccountsField();

		LocalFile.Provisioning.clickTab(tabName = "First Line Support Accounts");

		LocalFile.Provisioning.viewSearchAccountsField();

		LocalFile.Provisioning.gotoAccounts();

		LocalFile.Provisioning.searchAccounts(keyword = "Korsea");

		LocalFile.Provisioning.clickAccount(accountName = "Korsea - ${staticProjectName}");

		LocalFile.ProvisioningAccount.clickSubscriptionLink(productName = "DXP Production");

		LocalFile.Provisioning.viewSearchAccountsField();

		LocalFile.Provisioning.clickTab(tabName = "Licenses");

		LocalFile.Provisioning.viewSearchAccountsField();

		LocalFile.Provisioning.gotoProducts();

		LocalFile.Provisioning.viewSearchAccountsField();

		LocalFile.Provisioning.searchProducts(keyword = "Portal");

		LocalFile.Provisioning.viewSearchAccountsField();

		LocalFile.Provisioning.clickProduct(productName = "Portal Production");

		LocalFile.Provisioning.viewSearchAccountsField();

		LocalFile.Provisioning.gotoProductBundles();

		LocalFile.Provisioning.viewSearchAccountsField();

		LocalFile.Provisioning.gotoUsers();

		LocalFile.Provisioning.viewSearchAccountsField();

		LocalFile.Provisioning.searchUsers(keyword = "sea.koroneiki1");

		LocalFile.Provisioning.viewSearchAccountsField();

		LocalFile.Provisioning.clickUser(userName = "SEA Koroneiki1");

		LocalFile.Provisioning.viewSearchAccountsField();

		LocalFile.Provisioning.clickTab(tabName = "General");

		LocalFile.Provisioning.viewSearchAccountsField();

		LocalFile.Provisioning.clickTab(tabName = "Entitlements");

		LocalFile.Provisioning.viewSearchAccountsField();

		LocalFile.Provisioning.gotoLicenses();

		LocalFile.Provisioning.viewSearchAccountsField();
	}

	test Viewaccountviaexactcodesearch {
		LocalFile.OSBAdminRabbitMQ.publishCreateProjectWithNoPartnerMessage(
			routingKey = "dossiera.provisioning.create",
			table = '''| Account Name                           | Seakor - ${staticCompanyName}              |
	| Address City                           | Diamond Bar                                |
	| Address Country                        | United States                              |
	| Address Postal Code                    | 91765                                      |
	| Address Region                         | California                                 |
	| Address Street                         | 456 Fake Street                            |
	| Contact Email Address                  | sea.koroneiki1@lrcustomer.com.broken       |
	| Contact First Name                     | SEA                                        |
	| Contact Last Name                      | Koroneiki1                                 |
	| Dossiera Account Key                   | ${staticDossieraAccountKey}                |
	| Dossiera Address Key 1                 | ${staticDossieraAddressKey1}               |
	| Dossiera Address Key 2                 | ${staticDossieraAddressKey2}               |
	| Dossiera Contact Key                   | ${staticDossieraContactKey}                |
	| Dossiera Project Key                   | ${staticDossieraProjectKey}                |
	| End Day                                | ${staticEndDay}                            |
	| End Month                              | ${staticEndMonth}                          |
	| End Year                               | ${staticEndYear}                           |
	| Industry                               | Automotive                                 |
	| Owner Email Address                    | sea.koroneiki2@lrcustomer.com.broken       |
	| Owner First Name                       | SEA                                        |
	| Owner Last Name                        | Koroneiki2                                 |
	| Partner First Line Support             | false                                      |
	| Product Type                           | New                                        |
	| Product Name                           | Liferay Digital Enterprise - Prod Sizing 4 |
	| Project Name                           | Korsea - ${staticProjectName}              |
	| Renewal                                | false                                      |
	| Salesforce Opportunity Key             | ${staticSalesforceOpportunityKey}          |
	| Salesforce Opportunity Line Item Key 1 | ${staticSalesforceOpportunityLineItemKey1} |
	| Salesforce Opportunity Line Item Key 2 | ${staticSalesforceOpportunityLineItemKey2} |
	| Salesforce Opportunity Sold By         | Liferay US                                 |
	| Salesforce Opportunity Stage Name      | Closed Won                                 |
	| Salesforce Opportunity Territory       | United States                              |
	| Salesforce Opportunity Type            | New Business                               |
	| Salesforce Owner User Key              | ${staticSalesforceOwnerUserKey}            |
	| Salesforce Project Key                 | ${staticSalesforceProjectKey}              |
	| Start Day                              | ${staticStartDay}                          |
	| Start Month                            | ${staticStartMonth}                        |
	| Start Year                             | ${staticStartYear}                         |
	| Subscription Level                     | Platinum                                   |
	| Version Number                         | 7.1                                        |''');

		LocalFile.KoroneikiAccountAPI._createAccountTeam(
			accountName = "Korsea - ${staticProjectName}",
			teamName = "Korsearch Partner");

		LocalFile.KoroneikiAccountAPI._assignTeamRolesToTeam(
			accountName = "Korsea - ${staticProjectName}",
			table = '''| First Line Support |''',
			teamName = "Korsearch Partner");

		LocalFile.OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		LocalFile.Provisioning.gotoAccounts();

		LocalFile.Provisioning.searchAccounts(keyword = "SEAKORKORSEA");

		LocalFile.ProvisioningAccount._viewAccountDetails(table = '''| Name           | Korsea - ${staticProjectName} |
	| Code           | SEAKORKORSEA                  |
	| State          | ACTIVE                        |
	| Support Region | United States                 |
	| Country        | United States                 |
	| SLA            | Platinum                      |
	| Tier           | T4                            |
	| FLS Partner    | Korsearch Partner             |''');
	}

	test Viewaccountviaexactcodesearchviaotherindexes {
		LocalFile.OSBAdminRabbitMQ.publishCreateProjectWithNoPartnerMessage(
			routingKey = "dossiera.provisioning.create",
			table = '''| Account Name                           | Seakor - ${staticCompanyName}              |
	| Address City                           | Diamond Bar                                |
	| Address Country                        | United States                              |
	| Address Postal Code                    | 91765                                      |
	| Address Region                         | California                                 |
	| Address Street                         | 456 Fake Street                            |
	| Contact Email Address                  | sea.koroneiki1@lrcustomer.com.broken       |
	| Contact First Name                     | SEA                                        |
	| Contact Last Name                      | Koroneiki1                                 |
	| Dossiera Account Key                   | ${staticDossieraAccountKey}                |
	| Dossiera Address Key 1                 | ${staticDossieraAddressKey1}               |
	| Dossiera Address Key 2                 | ${staticDossieraAddressKey2}               |
	| Dossiera Contact Key                   | ${staticDossieraContactKey}                |
	| Dossiera Project Key                   | ${staticDossieraProjectKey}                |
	| End Day                                | ${staticEndDay}                            |
	| End Month                              | ${staticEndMonth}                          |
	| End Year                               | ${staticEndYear}                           |
	| Industry                               | Automotive                                 |
	| Owner Email Address                    | sea.koroneiki2@lrcustomer.com.broken       |
	| Owner First Name                       | SEA                                        |
	| Owner Last Name                        | Koroneiki2                                 |
	| Partner First Line Support             | false                                      |
	| Product Type                           | New                                        |
	| Product Name                           | Liferay Digital Enterprise - Prod Sizing 4 |
	| Project Name                           | Korsea - ${staticProjectName}              |
	| Renewal                                | false                                      |
	| Salesforce Opportunity Key             | ${staticSalesforceOpportunityKey}          |
	| Salesforce Opportunity Line Item Key 1 | ${staticSalesforceOpportunityLineItemKey1} |
	| Salesforce Opportunity Line Item Key 2 | ${staticSalesforceOpportunityLineItemKey2} |
	| Salesforce Opportunity Sold By         | Liferay US                                 |
	| Salesforce Opportunity Stage Name      | Closed Won                                 |
	| Salesforce Opportunity Territory       | United States                              |
	| Salesforce Opportunity Type            | New Business                               |
	| Salesforce Owner User Key              | ${staticSalesforceOwnerUserKey}            |
	| Salesforce Project Key                 | ${staticSalesforceProjectKey}              |
	| Start Day                              | ${staticStartDay}                          |
	| Start Month                            | ${staticStartMonth}                        |
	| Start Year                             | ${staticStartYear}                         |
	| Subscription Level                     | Platinum                                   |
	| Version Number                         | 7.1                                        |''');

		LocalFile.KoroneikiAccountAPI._createAccountTeam(
			accountName = "Korsea - ${staticProjectName}",
			teamName = "Korsearch Partner");

		LocalFile.KoroneikiAccountAPI._assignTeamRolesToTeam(
			accountName = "Korsea - ${staticProjectName}",
			table = '''| First Line Support |''',
			teamName = "Korsearch Partner");

		LocalFile.OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		LocalFile.Provisioning.gotoProducts();

		LocalFile.Provisioning.searchAccounts(keyword = "SEAKORKORSEA");

		LocalFile.ProvisioningAccount._viewAccountDetails(table = '''| Name           | Korsea - ${staticProjectName} |
	| Code           | SEAKORKORSEA                  |
	| State          | ACTIVE                        |
	| Support Region | United States                 |
	| Country        | United States                 |
	| SLA            | Platinum                      |
	| Tier           | T4                            |
	| FLS Partner    | Korsearch Partner             |''');

		LocalFile.Provisioning.gotoProductBundles();

		LocalFile.Provisioning.searchAccounts(keyword = "SEAKORKORSEA");

		LocalFile.ProvisioningAccount._viewAccountDetails(table = '''| Name           | Korsea - ${staticProjectName} |
	| Code           | SEAKORKORSEA                  |
	| State          | ACTIVE                        |
	| Support Region | United States                 |
	| Country        | United States                 |
	| SLA            | Platinum                      |
	| Tier           | T4                            |
	| FLS Partner    | Korsearch Partner             |''');

		LocalFile.Provisioning.gotoUsers();

		LocalFile.Provisioning.searchAccounts(keyword = "SEAKORKORSEA");

		LocalFile.ProvisioningAccount._viewAccountDetails(table = '''| Name           | Korsea - ${staticProjectName} |
	| Code           | SEAKORKORSEA                  |
	| State          | ACTIVE                        |
	| Support Region | United States                 |
	| Country        | United States                 |
	| SLA            | Platinum                      |
	| Tier           | T4                            |
	| FLS Partner    | Korsearch Partner             |''');

		LocalFile.Provisioning.gotoLicenses();

		LocalFile.Provisioning.searchAccounts(keyword = "SEAKORKORSEA");

		LocalFile.ProvisioningAccount._viewAccountDetails(table = '''| Name           | Korsea - ${staticProjectName} |
	| Code           | SEAKORKORSEA                  |
	| State          | ACTIVE                        |
	| Support Region | United States                 |
	| Country        | United States                 |
	| SLA            | Platinum                      |
	| Tier           | T4                            |
	| FLS Partner    | Korsearch Partner             |''');
	}

	property help.center.acceptance = "true";
	test Viewadvancedsearchresult {
		LocalFile.OSBAdminRabbitMQ.publishCreateProjectWithNoPartnerMessage(
			routingKey = "dossiera.provisioning.create",
			table = '''| Account Name                           | Seakor - ${staticCompanyName}              |
	| Address City                           | Diamond Bar                                |
	| Address Country                        | United States                              |
	| Address Postal Code                    | 91765                                      |
	| Address Region                         | California                                 |
	| Address Street                         | 456 Fake Street                            |
	| Contact Email Address                  | sea.koroneiki1@lrcustomer.com.broken       |
	| Contact First Name                     | SEA                                        |
	| Contact Last Name                      | Koroneiki1                                 |
	| Dossiera Account Key                   | ${staticDossieraAccountKey}                |
	| Dossiera Address Key 1                 | ${staticDossieraAddressKey1}               |
	| Dossiera Address Key 2                 | ${staticDossieraAddressKey2}               |
	| Dossiera Contact Key                   | ${staticDossieraContactKey}                |
	| Dossiera Project Key                   | ${staticDossieraProjectKey}                |
	| End Day                                | ${staticEndDay}                            |
	| End Month                              | ${staticEndMonth}                          |
	| End Year                               | ${staticEndYear}                           |
	| Industry                               | Automotive                                 |
	| Owner Email Address                    | sea.koroneiki2@lrcustomer.com.broken       |
	| Owner First Name                       | SEA                                        |
	| Owner Last Name                        | Koroneiki2                                 |
	| Partner First Line Support             | false                                      |
	| Product Type                           | New                                        |
	| Product Name                           | Liferay Digital Enterprise - Prod Sizing 4 |
	| Project Name                           | Korsea - ${staticProjectName}              |
	| Renewal                                | false                                      |
	| Salesforce Opportunity Key             | ${staticSalesforceOpportunityKey}          |
	| Salesforce Opportunity Line Item Key 1 | ${staticSalesforceOpportunityLineItemKey1} |
	| Salesforce Opportunity Line Item Key 2 | ${staticSalesforceOpportunityLineItemKey2} |
	| Salesforce Opportunity Sold By         | Liferay US                                 |
	| Salesforce Opportunity Stage Name      | Closed Won                                 |
	| Salesforce Opportunity Territory       | United States                              |
	| Salesforce Opportunity Type            | New Business                               |
	| Salesforce Owner User Key              | ${staticSalesforceOwnerUserKey}            |
	| Salesforce Project Key                 | ${staticSalesforceProjectKey}              |
	| Start Day                              | ${staticStartDay}                          |
	| Start Month                            | ${staticStartMonth}                        |
	| Start Year                             | ${staticStartYear}                         |
	| Subscription Level                     | Platinum                                   |
	| Version Number                         | 7.1                                        |''');

		LocalFile.KoroneikiAccountAPI._createAccountTeam(
			accountName = "Korsea - ${staticProjectName}",
			teamName = "Korsearch Partner");

		LocalFile.KoroneikiAccountAPI._assignTeamRolesToTeam(
			accountName = "Korsea - ${staticProjectName}",
			table = '''| Partner            |
	| First Line Support |''',
			teamName = "Korsearch Partner");

		LocalFile.OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		LocalFile.Provisioning.gotoAccounts();

		LocalFile.Provisioning.expandAccountAdvancedSearchForm();

		LocalFile.Provisioning.populateAdvancedSearchFormAndSearch(table = '''| Match                |               | Radio Button  | All                                  |
	| Account Name         |               | Input         | Korsea - ${staticProjectName}        |
	| Code                 |               | Input         | SEAKORKORSEA                         |
	| Parent Account       |               | Select Entity | Seakor - ${staticCompanyName}        |
	| Project Worker       |               | Input         | sea.koroneiki2@lrcustomer.com.broken |
	| Country              |               | Select        | United States                        |
	| External Account Key |               | Input         | ${staticDossieraProjectKey}          |
	| Account              |               | Panel         | Collapse                             |
	| Categorization       |               | Panel         | Expand                               |
	| Partner              | No            | Checkbox      | true                                 |
	| Receives FLS         | Yes           | Checkbox      | true                                 |
	| Internal             | No            | Checkbox      | true                                 |
	| Tier                 | T4            | Checkbox      | true                                 |
	| Subscription State   | Active        | Checkbox      | true                                 |
	| Subscription State   | Cancelled     | Checkbox      | false                                |
	| Subscription State   | Expired       | Checkbox      | false                                |
	| Subscription State   | Unactivated   | Checkbox      | false                                |
	| Subscription Level   | Platinum      | Checkbox      | true                                 |
	| Support Region       | United States | Checkbox      | true                                 |
	| Categorization       |               | Panel         | Collapse                             |
	| Dates                |               | Panel         | Expand                               |
	| Created After        |               | Input         | ${staticYyyyMmDdPastEndDate}         |
	| Created Before       |               | Input         | ${staticYyyyMmDdFutureStartDate}     |
	| Modified After       |               | Input         | ${staticYyyyMmDdPastEndDate}         |
	| Modified Before      |               | Input         | ${staticYyyyMmDdFutureStartDate}     |
	| Date                 |               | Panel         | Collapse                             |''');

		LocalFile.Provisioning._viewAccountViaIndex(
			accountName = "Korsea - ${staticProjectName}",
			table = '''| Name    | Korsea - ${staticProjectName} |
	| Code    | SEAKORKORSEA                  |
	| Partner | Korsearch Partner             |
	| Region  | United States                 |
	| SLA     | Platinum                      |
	| Tier    | T4                            |
	| State   | ACTIVE                        |''');

		LocalFile.Provisioning.viewSearchInfoMessage(table = '''| Label | Country: United States                               |
	| Label | Internal: No                                         |
	| Label | Code: SEAKORKORSEA                                   |
	| Label | Modified After: ${staticYyyyMmDdPastEndDate}         |
	| Label | Subscription State: Active                           |
	| Label | Modified Before: ${staticYyyyMmDdFutureStartDate}    |
	| Label | Receives FLS: Yes                                    |
	| Label | Created Before: ${staticYyyyMmDdFutureStartDate}     |
	| Label | Partner: No                                          |
	| Label | Tier: T4                                             |
	| Label | Support Region: United States                        |
	| Label | Parent Account: Seakor - ${staticCompanyName}        |
	| Label | Account Name: Korsea - ${staticProjectName}          |
	| Label | Created After: ${staticYyyyMmDdPastEndDate}          |
	| Label | Subscription Level: Platinum Subscription            |
