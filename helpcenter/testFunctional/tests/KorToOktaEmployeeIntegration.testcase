	test RemoveemployeefromAccountAccessEUteamviaSyncfromOkta {
		JSONOkta.createOktaUser(table = '''| Screen Name   | ${staticScreenNameValue}       |
	| Email Address | ${staticEmailValue}            |
	| First Name    | ${staticContactFirstNameValue} |
	| Last Name     | ${staticContactLastNameValue}  |
	| Group         | Employees                      |''');

		OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		Provisioning.gotoAccounts();

		Provisioning.searchAccounts(keyword = "Liferay,");

		Provisioning.clickAccount(accountName = "Liferay, Inc.");

		Provisioning.clickTab(tabName = "Teams");

		ProvisioningAccount.search(keyword = "Account Access EU");

		ProvisioningAccount.clickTeamLink(teamName = "Account Access EU");

		ProvisioningTeam.search(keyword = ${staticEmailValue});

		ProvisioningTeam._viewNoTeamMember(memberEmailAddress = ${staticEmailValue});

		ProvisioningTeam.clickAssignMembersButton();

		ProvisioningTeam.assignMember(memberEmailAddress = ${staticEmailValue});

		ProvisioningTeam.search(keyword = ${staticEmailValue});

		ProvisioningTeam._viewTeamMember(
			memberEmailAddress = ${staticEmailValue},
			table = '''| Name          | ${staticContactFirstNameValue} ${staticContactLastNameValue} |
	| Email Address | ${staticEmailValue}                                          |
	| Status        | VERIFIED                                                     |''');

		ProvisioningTeam.clickSyncFromOktaButton();

		ProvisioningTeam.search(keyword = ${staticEmailValue});

		ProvisioningTeam._viewNoTeamMember(memberEmailAddress = ${staticEmailValue});
	}

