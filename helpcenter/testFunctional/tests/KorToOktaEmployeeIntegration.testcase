		LocalFile.ProvisioningAccount.clickTeamLink(teamName = "Account Access EU");

		LocalFile.ProvisioningTeam.search(keyword = ${staticEmailValue});

		LocalFile.ProvisioningTeam._viewNoTeamMember(memberEmailAddress = ${staticEmailValue});

		LocalFile.ProvisioningTeam.clickAssignMembersButton();

		LocalFile.ProvisioningTeam.assignMember(memberEmailAddress = ${staticEmailValue});

		LocalFile.ProvisioningTeam.search(keyword = ${staticEmailValue});

		LocalFile.ProvisioningTeam._viewTeamMember(
			memberEmailAddress = ${staticEmailValue},
			table = '''| Name          | ${staticContactFirstNameValue} ${staticContactLastNameValue} |
	| Email Address | ${staticEmailValue}                                          |
	| Status        | VERIFIED                                                     |''');

		LocalFile.ProvisioningTeam.clickSyncFromOktaButton();

		LocalFile.ProvisioningTeam.search(keyword = ${staticEmailValue});

		LocalFile.ProvisioningTeam._viewNoTeamMember(memberEmailAddress = ${staticEmailValue});
	}

