definition {

	property testray.main.component.name = "Support QA";
	property type = "okta.integration";

	setUp {
		LocalFile.Passwords.getPasswords();
	}

	tearDown {
		LocalFile.JSONUser.tearDownUsers(table = '''| ${staticEmailValue} |''');

		LocalFile.JSONUser.tearDownUsersViaSupport(table = '''| ${staticEmailValue} |''');

		LocalFile.KoroneikiContactAPI._tearDownContacts(table = '''| ${staticEmailValue} |''');

		LocalFile.JSONOkta.tearDownUsers(table = '''| ${staticEmailValue} |''');

		LocalFile.ZendeskUserAPI._getMultipleUserIdsByEmailAddress(table = '''| ${staticEmailValue} |''');

		LocalFile.ZendeskUserAPI._tearDownUsersByIdList(userIds = ${staticUserIdList});
	}

	test AddbackemployeetoAccountAccessEUteamviaSyncfromOkta {
		LocalFile.JSONOkta.createOktaUser(table = '''| Screen Name   | ${staticScreenNameValue}       |
	| Email Address | ${staticEmailValue}            |
	| First Name    | ${staticContactFirstNameValue} |
	| Last Name     | ${staticContactLastNameValue}  |
	| Group         | Employees                      |
	| Group         | Account Access EU              |''');

		LocalFile.OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		LocalFile.Provisioning.gotoAccounts();

		LocalFile.Provisioning.searchAccounts(keyword = "Liferay,");

		LocalFile.Provisioning.clickAccount(accountName = "Liferay, Inc.");

		LocalFile.Provisioning.clickTab(tabName = "Teams");

		LocalFile.ProvisioningAccount.search(keyword = "Account Access EU");

		LocalFile.ProvisioningAccount.clickTeamLink(teamName = "Account Access EU");

		LocalFile.ProvisioningTeam.search(keyword = ${staticEmailValue});

		LocalFile.ProvisioningTeam._viewTeamMember(
			memberEmailAddress = ${staticEmailValue},
			table = '''| Name          | ${staticContactFirstNameValue} ${staticContactLastNameValue} |
	| Email Address | ${staticEmailValue}                                          |
	| Status        | VERIFIED                                                     |''');

		LocalFile.ProvisioningTeam.unassignMember(memberEmailAddress = ${staticEmailValue});

		LocalFile.ProvisioningTeam.search(keyword = ${staticEmailValue});

		LocalFile.ProvisioningTeam._viewNoTeamMember(memberEmailAddress = ${staticEmailValue});

		LocalFile.ProvisioningTeam.clickSyncFromOktaButton();

		LocalFile.ProvisioningTeam.search(keyword = ${staticEmailValue});

		LocalFile.ProvisioningTeam._viewTeamMember(
			memberEmailAddress = ${staticEmailValue},
			table = '''| Name          | ${staticContactFirstNameValue} ${staticContactLastNameValue} |
	| Email Address | ${staticEmailValue}                                          |
	| Status        | VERIFIED                                                     |''');
	}

