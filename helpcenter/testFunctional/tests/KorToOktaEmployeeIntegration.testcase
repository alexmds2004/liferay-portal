	test ViewLiferayemployeeonAccountAccessEUgroup {
		LocalFile.Data.generateSupportUser();

		LocalFile.JSONOkta.createOktaUser(table = '''| Screen Name   | ${staticScreenNameValue}       |
	| Email Address | ${staticEmailValue}            |
	| First Name    | ${staticContactFirstNameValue} |
	| Last Name     | ${staticContactLastNameValue1} |
	| Group         | Employees                      |
	| Group         | Account Access EU              |''');

		LocalFile.KoroneikiContactAPI._viewContactSyncViaEmailAddress(contactEmailAddress = ${staticEmailValue});

		LocalFile.KoroneikiContactAPI._viewAccountSyncViaUuid(
			accountName = "Liferay, Inc.",
			contactEmailAddress = ${staticEmailValue});

		LocalFile.KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		LocalFile.KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - DXP");

		LocalFile.KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - Portal");

		LocalFile.KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - Commerce");

		LocalFile.KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Liferay Employee");

		LocalFile.JSONUser.viewSupportUserSync(userEmailAddress = ${staticEmailValue});

		LocalFile.JSONUser.viewSupportUserOrganizationSync(
			organizationName = "Employees",
			userEmailAddress = ${staticEmailValue});

		LocalFile.JSONUser.viewSupportUserOrganizationSync(
			organizationName = "Koroneiki Customer",
			userEmailAddress = ${staticEmailValue});

		LocalFile.JSONUser.viewSupportUserOrganizationSync(
			organizationName = "Koroneiki Customer - DXP",
			userEmailAddress = ${staticEmailValue});

		LocalFile.JSONUser.viewSupportUserOrganizationSync(
			organizationName = "Koroneiki Customer - Portal",
			userEmailAddress = ${staticEmailValue});

		LocalFile.JSONUser.viewSupportUserOrganizationSync(
			organizationName = "Koroneiki Customer - Commerce",
			userEmailAddress = ${staticEmailValue});

		LocalFile.JSONOkta.viewOktaUserGroupMembership(
			groupName = "Account Access EU",
			userEmailAddress = ${staticEmailValue});
	}

