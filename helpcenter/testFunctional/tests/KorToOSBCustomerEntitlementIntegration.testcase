			productName = "DXP Production",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | true                     | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		LocalFile.KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korone - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | true                     | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		LocalFile.KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		LocalFile.JSONOSBAccount.viewSupportOrganizationSync(accountCode = "KORONEKORONE");

		LocalFile.KoroneikiContactAPI._createContactWithKoroneikiUuid(table = '''| Email Address | osb.koroneiki1@lrcustomer.com.broken |
	| First Name    | OSB                                  |
	| Language      | English                              |
	| Last Name     | Koroneiki1                           |''');

		LocalFile.KoroneikiContactAPI._createContactWithKoroneikiUuid(table = '''| Email Address | osb.koroneiki2@lrcustomer.com.broken |
	| First Name    | OSB                                  |
	| Language      | English                              |
	| Last Name     | Koroneiki2                           |''');

		LocalFile.KoroneikiContactRoleAPI._createContactRole(table = '''| Description | This is the Liferay role for accounts |
	| Name        | Liferay Account Role                  |
	| Type        | Account Customer                      |''');

		LocalFile.KoroneikiContactRoleAPI._createContactRole(table = '''| Description | This is the NonLiferay role for accounts |
	| Name        | NonLiferay Account Role                  |
	| Type        | Account Customer                         |''');

		LocalFile.KoroneikiAccountAPI._assignCustomerContacts(
			accountName = "Korone - ${staticProjectName}",
			table = '''| osb.koroneiki1@lrcustomer.com.broken |''');

		LocalFile.KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Korone - ${staticProjectName}",
			contactEmailAddress = "osb.koroneiki1@lrcustomer.com.broken",
			table = '''| Liferay Account Role |''');

		LocalFile.KoroneikiProductAPI._createProduct(table = '''| Name | A Liferay OSB Product | |''');

		LocalFile.KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korone - ${staticProjectName}",
			productName = "A Liferay OSB Product",
			table = '''| End Date                | ${staticEndDate}   |                |
	| Perpetual               | true               |                |
	| Product Field and Value | additionalProp1    | propertyValue1 |
	| Product Field and Value | additionalProp2    | propertyValue2 |
	| Product Field and Value | additionalProp3    | propertyValue3 |
