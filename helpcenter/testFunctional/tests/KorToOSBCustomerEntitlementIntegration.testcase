definition {

	property testray.main.component.name = "Support QA";
	property type = "osb.integration";

	tearDown {
		LocalFile.ZendeskUserAPI._getDefaultUserId(organizationName = "Korone - ${staticProjectName}");

		LocalFile.KoroneikiContactAPI._tearDownContactEntitlementDefinitions(table = '''| Liferay Role    |
	| NonLiferay Role |''');

		LocalFile.OSBAdminProject.tearDownProjects(table = '''| KORONEKORONE |''');

		LocalFile.KoroneikiAccountAPI._tearDownAccounts(table = '''| Korone - ${staticProjectName} |''');

		LocalFile.KoroneikiAccountAPI._tearDownAccountsViaAccountFieldNameAndValue(
			fieldName = "Code",
			table = '''| KORONEKORONE |''');

		LocalFile.KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		LocalFile.KoroneikiProductAPI._tearDownProducts(table = '''| A Liferay OSB Product |''');

		LocalFile.KoroneikiContactRoleAPI._tearDownContactRoles(table = '''| Liferay Account Role    |
	| NonLiferay Account Role |''');

		LocalFile.JSONUser.tearDownUsers(table = '''| osb.koroneiki1@lrcustomer.com.broken |
	| osb.koroneiki2@lrcustomer.com.broken |''');

		LocalFile.JSONUser.tearDownUsersViaSupport(table = '''| osb.koroneiki1@lrcustomer.com.broken |
	| osb.koroneiki2@lrcustomer.com.broken |''');

		LocalFile.JSONUser.tearDownUsersViaKoroneiki(table = '''| osb.koroneiki1@lrcustomer.com.broken |
	| osb.koroneiki2@lrcustomer.com.broken |''');

		LocalFile.KoroneikiContactAPI._tearDownContacts(table = '''| osb.koroneiki1@lrcustomer.com.broken |
	| osb.koroneiki2@lrcustomer.com.broken |''');

		LocalFile.JSONUser.tearDownUsersViaSupportOrganization(
			organizationName = "Koroneiki Liferay Role",
			table = '''| osb.koroneiki1@lrcustomer.com.broken |
	| osb.koroneiki2@lrcustomer.com.broken |''');

		LocalFile.JSONUser.tearDownUsersViaSupportOrganization(
			organizationName = "Koroneiki NonLiferay Role",
			table = '''| osb.koroneiki1@lrcustomer.com.broken |
	| osb.koroneiki2@lrcustomer.com.broken |''');

		LocalFile.JSONOrganization.tearDownOrganizationsViaSupport(table = '''| Koroneiki Liferay Role    |
	| Koroneiki NonLiferay Role |''');

		LocalFile.JSONOkta.tearDownUsers(table = '''| osb.koroneiki1@lrcustomer.com.broken |
	| osb.koroneiki2@lrcustomer.com.broken |''');

		LocalFile.ZendeskOrganizationAPI._getMultipleOrganizationExternalIdsByOrganizationNameIfStillPresent(table = '''| Korone - ${staticProjectName} |''');

		LocalFile.ZendeskOrganizationAPI._tearDownOrganizationsByExternalIdList(organizationExternalIds = ${staticOrganizationExternalIdList});

		LocalFile.ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId});
	}

	test ResyncmultipleusersviaOSB {
		LocalFile.OSBAdminRabbitMQ.generateProvisioningProjectName();

		LocalFile.JSONOkta.createOktaUser(table = '''| Screen Name   | osb.koroneiki1                       |
	| Email Address | osb.koroneiki1@lrcustomer.com.broken |
	| First Name    | OSB                                  |
	| Last Name     | Koroneiki1                           |''');

		LocalFile.JSONOkta.createOktaUser(table = '''| Screen Name   | osb.koroneiki2                       |
	| Email Address | osb.koroneiki2@lrcustomer.com.broken |
	| First Name    | OSB                                  |
	| Last Name     | Koroneiki2                           |''');

		LocalFile.JSONUser.createViaKoroneiki(table = '''| Screen Name   | osb.koroneiki1                       |
	| Email Address | osb.koroneiki1@lrcustomer.com.broken |
	| First Name    | OSB                                  |
	| Last Name     | Koroneiki1                           |''');

		LocalFile.JSONUser.createViaKoroneiki(table = '''| Screen Name   | osb.koroneiki2                       |
	| Email Address | osb.koroneiki2@lrcustomer.com.broken |
	| First Name    | OSB                                  |
	| Last Name     | Koroneiki2                           |''');

		LocalFile.KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORONEKORONE                         | |
	| Contact Email Address | osb.koroneiki1@lrcustomer.com.broken | |
	| Description           | Test osb account on koroneiki        | |
	| Fax Number            | 555-555-1234                         | |
	| Name                  | Korone - ${staticProjectName}        | |
	| Phone Number          | 555-555-5678                         | |
	| Profile Email Address | osb.koroneiki1@lrcustomer.com.broken | |
	| Region                | United States                        | |
	| Status                | Active                               | |
	| Tier                  | T4                                   | |
	| Website               | www.koroneikicorporation.com         | |''');

		LocalFile.KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		LocalFile.KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korone - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | true                     | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		LocalFile.KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korone - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | true                     | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		LocalFile.KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		LocalFile.JSONOSBAccount.viewSupportOrganizationSync(accountCode = "KORONEKORONE");

		LocalFile.KoroneikiContactAPI._createContactWithKoroneikiUuid(table = '''| Email Address | osb.koroneiki1@lrcustomer.com.broken |
	| First Name    | OSB                                  |
	| Language      | English                              |
	| Last Name     | Koroneiki1                           |''');

		LocalFile.KoroneikiContactAPI._createContactWithKoroneikiUuid(table = '''| Email Address | osb.koroneiki2@lrcustomer.com.broken |
	| First Name    | OSB                                  |
	| Language      | English                              |
	| Last Name     | Koroneiki2                           |''');

		LocalFile.KoroneikiContactRoleAPI._createContactRole(table = '''| Description | This is the Liferay role for accounts |
	| Name        | Liferay Account Role                  |
	| Type        | Account Customer                      |''');

		LocalFile.KoroneikiContactRoleAPI._createContactRole(table = '''| Description | This is the NonLiferay role for accounts |
	| Name        | NonLiferay Account Role                  |
	| Type        | Account Customer                         |''');

		LocalFile.KoroneikiAccountAPI._assignCustomerContacts(
			accountName = "Korone - ${staticProjectName}",
			table = '''| osb.koroneiki1@lrcustomer.com.broken |
	| osb.koroneiki2@lrcustomer.com.broken |''');

		LocalFile.KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Korone - ${staticProjectName}",
			contactEmailAddress = "osb.koroneiki1@lrcustomer.com.broken",
			table = '''| Liferay Account Role |''');

		LocalFile.KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Korone - ${staticProjectName}",
			contactEmailAddress = "osb.koroneiki2@lrcustomer.com.broken",
			table = '''| Liferay Account Role |''');

		LocalFile.KoroneikiProductAPI._createProduct(table = '''| Name | A Liferay OSB Product | |''');

		LocalFile.KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korone - ${staticProjectName}",
			productName = "A Liferay OSB Product",
			table = '''| End Date                | ${staticEndDate}   |                |
	| Perpetual               | true               |                |
	| Product Field and Value | additionalProp1    | propertyValue1 |
	| Product Field and Value | additionalProp2    | propertyValue2 |
	| Product Field and Value | additionalProp3    | propertyValue3 |
	| Quantity                | 1                  |                |
	| Start Date              | ${staticStartDate} |                |''');

		LocalFile.KoroneikiContactAPI._createContactEntitlementDefinition(
			contactRoleName = "Liferay Account Role",
			contactRoleType = "Account Customer",
			productName = "A Liferay OSB Product",
			table = '''| Description | Liferay Role Entitlement |
	| Name        | Liferay Role             |
	| Status      | Approved                 |''');

		LocalFile.JSONOrganization.createViaSupport(organizationName = "Koroneiki Liferay Role");

		LocalFile.KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Liferay Role");

		LocalFile.JSONOrganization.viewSupportOrganizationMemberSync(
			organizationName = "Koroneiki Liferay Role",
			userEmailAddress = "osb.koroneiki1@lrcustomer.com.broken");

		LocalFile.JSONOrganization.viewSupportOrganizationMemberSync(
			organizationName = "Koroneiki Liferay Role",
			userEmailAddress = "osb.koroneiki1@lrcustomer.com.broken");

		LocalFile.JSONUser.deleteSupportUser(userEmailAddress = "osb.koroneiki1@lrcustomer.com.broken");

		LocalFile.JSONUser.deleteSupportUser(userEmailAddress = "osb.koroneiki2@lrcustomer.com.broken");

		LocalFile.Passwords.getPasswords();

		LocalFile.OSBAdmin.loginToSupport(
			userEmailAddress = ${staticSupportAdminEmailAdress},
			userPassword = ${staticSupportAdminPassword});

		LocalFile.OSBAdmin.gotoOSBAdmin();

		LocalFile.OSBAdminEntitlements.resyncEntitlements(entitlementName = "Koroneiki Liferay Role");

		LocalFile.JSONOrganization.viewSupportOrganizationMemberSync(
			organizationName = "Koroneiki Liferay Role",
			userEmailAddress = "osb.koroneiki1@lrcustomer.com.broken");

		LocalFile.JSONOrganization.viewSupportOrganizationMemberSync(
			organizationName = "Koroneiki Liferay Role",
			userEmailAddress = "osb.koroneiki2@lrcustomer.com.broken");
	}

	test ResyncseparateusersandorganizationsviaKoroneiki {
		LocalFile.OSBAdminRabbitMQ.generateProvisioningProjectName();

		LocalFile.JSONOkta.createOktaUser(table = '''| Screen Name   | osb.koroneiki1                       |
	| Email Address | osb.koroneiki1@lrcustomer.com.broken |
	| First Name    | OSB                                  |
	| Last Name     | Koroneiki1                           |''');

		LocalFile.JSONOkta.createOktaUser(table = '''| Screen Name   | osb.koroneiki2                       |
	| Email Address | osb.koroneiki2@lrcustomer.com.broken |
	| First Name    | OSB                                  |
	| Last Name     | Koroneiki2                           |''');

		LocalFile.JSONUser.createViaKoroneiki(table = '''| Screen Name   | osb.koroneiki1                       |
	| Email Address | osb.koroneiki1@lrcustomer.com.broken |
	| First Name    | OSB                                  |
	| Last Name     | Koroneiki1                           |''');

		LocalFile.JSONUser.createViaKoroneiki(table = '''| Screen Name   | osb.koroneiki2                       |
	| Email Address | osb.koroneiki2@lrcustomer.com.broken |
	| First Name    | OSB                                  |
	| Last Name     | Koroneiki2                           |''');

		LocalFile.KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORONEKORONE                         | |
	| Contact Email Address | osb.koroneiki1@lrcustomer.com.broken | |
	| Description           | Test osb account on koroneiki        | |
	| Fax Number            | 555-555-1234                         | |
	| Name                  | Korone - ${staticProjectName}        | |
	| Phone Number          | 555-555-5678                         | |
	| Profile Email Address | osb.koroneiki1@lrcustomer.com.broken | |
	| Region                | United States                        | |
	| Status                | Active                               | |
	| Tier                  | T4                                   | |
	| Website               | www.koroneikicorporation.com         | |''');

		LocalFile.KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		LocalFile.KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korone - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | true                     | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		LocalFile.KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korone - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | true                     | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		LocalFile.KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		LocalFile.JSONOSBAccount.viewSupportOrganizationSync(accountCode = "KORONEKORONE");

		LocalFile.KoroneikiContactAPI._createContactWithKoroneikiUuid(table = '''| Email Address | osb.koroneiki1@lrcustomer.com.broken |
	| First Name    | OSB                                  |
	| Language      | English                              |
	| Last Name     | Koroneiki1                           |''');

		LocalFile.KoroneikiContactAPI._createContactWithKoroneikiUuid(table = '''| Email Address | osb.koroneiki2@lrcustomer.com.broken |
	| First Name    | OSB                                  |
	| Language      | English                              |
	| Last Name     | Koroneiki2                           |''');

		LocalFile.KoroneikiContactRoleAPI._createContactRole(table = '''| Description | This is the Liferay role for accounts |
	| Name        | Liferay Account Role                  |
	| Type        | Account Customer                      |''');

		LocalFile.KoroneikiContactRoleAPI._createContactRole(table = '''| Description | This is the NonLiferay role for accounts |
	| Name        | NonLiferay Account Role                  |
	| Type        | Account Customer                         |''');

		LocalFile.KoroneikiAccountAPI._assignCustomerContacts(
			accountName = "Korone - ${staticProjectName}",
			table = '''| osb.koroneiki1@lrcustomer.com.broken |
	| osb.koroneiki2@lrcustomer.com.broken |''');

		LocalFile.KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Korone - ${staticProjectName}",
			contactEmailAddress = "osb.koroneiki1@lrcustomer.com.broken",
			table = '''| Liferay Account Role |''');

		LocalFile.KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Korone - ${staticProjectName}",
			contactEmailAddress = "osb.koroneiki2@lrcustomer.com.broken",
			table = '''| NonLiferay Account Role |''');

		LocalFile.KoroneikiProductAPI._createProduct(table = '''| Name | A Liferay OSB Product | |''');

		LocalFile.KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korone - ${staticProjectName}",
			productName = "A Liferay OSB Product",
			table = '''| End Date                | ${staticEndDate}   |                |
	| Perpetual               | true               |                |
	| Product Field and Value | additionalProp1    | propertyValue1 |
	| Product Field and Value | additionalProp2    | propertyValue2 |
	| Product Field and Value | additionalProp3    | propertyValue3 |
	| Quantity                | 1                  |                |
	| Start Date              | ${staticStartDate} |                |''');

		LocalFile.KoroneikiContactAPI._createContactEntitlementDefinition(
			contactRoleName = "Liferay Account Role",
			contactRoleType = "Account Customer",
			productName = "A Liferay OSB Product",
			table = '''| Description | Liferay Role Entitlement |
	| Name        | Liferay Role             |
	| Status      | Approved                 |''');

		LocalFile.KoroneikiContactAPI._createContactEntitlementDefinition(
			contactRoleName = "NonLiferay Account Role",
			contactRoleType = "Account Customer",
			productName = "A Liferay OSB Product",
			table = '''| Description | NonLiferay Role Entitlement |
	| Name        | NonLiferay Role             |
	| Status      | Approved                    |''');

		LocalFile.JSONOrganization.createViaSupport(organizationName = "Koroneiki Liferay Role");

		LocalFile.JSONOrganization.createViaSupport(organizationName = "Koroneiki NonLiferay Role");

		LocalFile.KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Liferay Role");

		LocalFile.KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "NonLiferay Role");

		LocalFile.JSONOrganization.viewSupportOrganizationMemberSync(
			organizationName = "Koroneiki Liferay Role",
			userEmailAddress = "osb.koroneiki1@lrcustomer.com.broken");

		LocalFile.JSONOrganization.viewSupportOrganizationMemberSync(
			organizationName = "Koroneiki NonLiferay Role",
			userEmailAddress = "osb.koroneiki2@lrcustomer.com.broken");

		LocalFile.JSONUser.deleteSupportUser(userEmailAddress = "osb.koroneiki1@lrcustomer.com.broken");

		LocalFile.JSONUser.deleteSupportUser(userEmailAddress = "osb.koroneiki2@lrcustomer.com.broken");

		LocalFile.Passwords.getPasswords();

		LocalFile.OSBAdmin.loginToSupport(
			userEmailAddress = ${staticSupportAdminEmailAdress},
			userPassword = ${staticSupportAdminPassword});

		LocalFile.OSBAdmin.gotoOSBAdmin();

		LocalFile.OSBAdminEntitlements.resyncEntitlements(entitlementName = "Koroneiki Liferay Role");

		LocalFile.OSBAdminEntitlements.resyncEntitlements(entitlementName = "Koroneiki NonLiferay Role");

		LocalFile.JSONOrganization.viewSupportOrganizationMemberSync(
			organizationName = "Koroneiki Liferay Role",
			userEmailAddress = "osb.koroneiki1@lrcustomer.com.broken");

		LocalFile.JSONOrganization.viewNoSupportOrganizationMemberSync(
			organizationName = "Koroneiki Liferay Role",
			userEmailAddress = "osb.koroneiki2@lrcustomer.com.broken");

		LocalFile.JSONOrganization.viewNoSupportOrganizationMemberSync(
			organizationName = "Koroneiki NonLiferay Role",
			userEmailAddress = "osb.koroneiki1@lrcustomer.com.broken");

		LocalFile.JSONOrganization.viewSupportOrganizationMemberSync(
			organizationName = "Koroneiki NonLiferay Role",
			userEmailAddress = "osb.koroneiki2@lrcustomer.com.broken");
	}

	test ResyncuserandorganizationviaOSB {
		LocalFile.OSBAdminRabbitMQ.generateProvisioningProjectName();

		LocalFile.JSONOkta.createOktaUser(table = '''| Screen Name   | osb.koroneiki1                       |
	| Email Address | osb.koroneiki1@lrcustomer.com.broken |
	| First Name    | OSB                                  |
	| Last Name     | Koroneiki1                           |''');

		LocalFile.JSONOkta.createOktaUser(table = '''| Screen Name   | osb.koroneiki2                       |
	| Email Address | osb.koroneiki2@lrcustomer.com.broken |
	| First Name    | OSB                                  |
	| Last Name     | Koroneiki2                           |''');

		LocalFile.JSONUser.createViaKoroneiki(table = '''| Screen Name   | osb.koroneiki1                       |
	| Email Address | osb.koroneiki1@lrcustomer.com.broken |
	| First Name    | OSB                                  |
	| Last Name     | Koroneiki1                           |''');

		LocalFile.JSONUser.createViaKoroneiki(table = '''| Screen Name   | osb.koroneiki2                       |
	| Email Address | osb.koroneiki2@lrcustomer.com.broken |
	| First Name    | OSB                                  |
	| Last Name     | Koroneiki2                           |''');

		LocalFile.KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORONEKORONE                         | |
	| Contact Email Address | osb.koroneiki1@lrcustomer.com.broken | |
	| Description           | Test osb account on koroneiki        | |
	| Fax Number            | 555-555-1234                         | |
	| Name                  | Korone - ${staticProjectName}        | |
	| Phone Number          | 555-555-5678                         | |
	| Profile Email Address | osb.koroneiki1@lrcustomer.com.broken | |
	| Region                | United States                        | |
	| Status                | Active                               | |
	| Tier                  | T4                                   | |
	| Website               | www.koroneikicorporation.com         | |''');

		LocalFile.KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		LocalFile.KoroneikiAccountAPI._createAccountProductPurchase(
