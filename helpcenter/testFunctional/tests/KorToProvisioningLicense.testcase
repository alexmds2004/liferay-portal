definition {

	property testray.main.component.name = "Support QA";
	property type = "provisioning.license.integration";

	setUp {
		Passwords.getPasswords();
	}

	tearDown {
		ZendeskUserAPI._getDefaultUserId(organizationName = "Korlic - ${staticProjectName}");

		KoroneikiProductConsumptionAPI._tearDownProductConsumptionList(
			accountName = "Korlic - ${staticProjectName}",
			table = '''| DXP Production                   |
	| DXP Non-Production               |
	| Portal Production                |
	| DXP Development                  |
	| Commerce Subscription Production |''');

		KoroneikiProductConsumptionAPI._tearDownProductConsumptions(
			accountName = "Korlic - ${staticProjectName}",
			table = '''| DXP OEM                                         |
	| DXP Limited                                     |
	| DXP Non-Production                              |
	| Portal Per User                                 |
	| Commerce Subscription Development               |
	| Commerce Subscription Non-Production            |
	| Commerce Subscription Backup                    |
	| Commerce Subscription Unlimited Enterprise-Wide |''');

		OSBAdminProject.tearDownProjects(table = '''| KORLICKORLIC |''');

		KoroneikiAccountAPI._tearDownAccounts(table = '''| Korlic - ${staticProjectName} |''');

		KoroneikiAccountAPI._tearDownAccountsViaAccountFieldNameAndValue(
			fieldName = "Code",
			table = '''| KORLICKORLIC |''');

		ZendeskOrganizationAPI._getMultipleOrganizationExternalIdsByOrganizationNameIfStillPresent(table = '''| Korlic - ${staticProjectName} |''');

		ZendeskOrganizationAPI._tearDownOrganizationsByExternalIdList(organizationExternalIds = ${staticOrganizationExternalIdList});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId});

		Downloads.teardownDownloadedListedFiles(list = ${staticDownloadedListName});
	}

	test Bulkactivatelicensesviaaccountdetails {
		OSBAdminRabbitMQ.generateProvisioningProjectName();

		KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORLICKORLIC                         | |
	| Contact Email Address | lic.koroneiki1@lrcustomer.com.broken | |
	| Description           | Test osb account on koroneiki        | |
	| Fax Number            | 555-555-1234                         | |
	| Name                  | Korlic - ${staticProjectName}        | |
	| Phone Number          | 555-555-5678                         | |
	| Profile Email Address | lic.koroneiki1@lrcustomer.com.broken | |
	| Region                | United States                        | |
	| Status                | Active                               | |
	| Tier                  | T4                                   | |
	| Website               | www.koroneikicorporation.com         | |''');

		KoroneikiAccountAPI._generateAccountKey(accountName = "Korlic - ${staticProjectName}");

		KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		KoroneikiProductPurchaseAPI.generateStaticFullStartAndEndDate();

		KoroneikiProductPurchaseAPI.generateStaticFutureStartAndEndDate();

		KoroneikiProductPurchaseAPI.generateStaticFullFutureStartAndEndDate();

		KoroneikiProductPurchaseAPI.generateStaticYyyyMmDdFutureStartAndEndDate();

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korlic - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| End Date                | ${staticEndDate}         |   |
	| Original End Date       | ${staticOriginalEndDate} |   |
	| Perpetual               | false                    |   |
	| Product Field and Value | sizing                   | 1 |
	| Product Field and Value | licenses                 | 1 |
	| Product Field and Value | version                  | 7 |
	| Quantity                | 1                        |   |
	| Start Date              | ${staticStartDate}       |   |
	| Status                  | Approved                 |   |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korlic - ${staticProjectName}",
			productName = "Portal Production",
			table = '''| End Date                | ${staticEndDate}         |   |
	| Original End Date       | ${staticOriginalEndDate} |   |
	| Perpetual               | false                    |   |
	| Product Field and Value | sizing                   | 1 |
	| Product Field and Value | licenses                 | 1 |
	| Product Field and Value | version                  | 6 |
	| Quantity                | 1                        |   |
	| Start Date              | ${staticStartDate}       |   |
	| Status                  | Approved                 |   |''');

		KoroneikiProductPurchaseAPI._generateProductPurchaseId(
			accountName = "Korlic - ${staticProjectName}",
			productName = "DXP Production");

		KoroneikiProductPurchaseAPI._renameFirstProductPurchaseIdVariable();

		KoroneikiProductPurchaseAPI._generateProductPurchaseId(
			accountName = "Korlic - ${staticProjectName}",
			productName = "Portal Production");

		KoroneikiProductPurchaseAPI._renameSecondProductPurchaseIdVariable();

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korlic - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		Provisioning.gotoLicenses();

		Provisioning.clickGenerateLicenseButton();

		ProvisioningLicense.populateGenerateLicenseForm(table = '''| Account | Select Entity | Korlic - ${staticProjectName} | |
	| Product | Select        | DXP Production                | |
	| Version | Select        | 7.2                           | |
	| Type    | Select        | DXP Production                | |''');

		ProvisioningLicense.clickChooseProductPurchaseButton(positionValue = 1);

		ProvisioningLicense.populateGenerateLicenseForm(table = '''| Name          | Input    | Korlic - ${staticProjectName} License1 Name        | |
	| Description   | Input    | Korlic - ${staticProjectName} License1 Description | |
	| Host Name     | Input    | localhost                                          | |
	| IP Addresses  | Textarea | 123.45.67.89                                       | |
	| MAC Addresses | Textarea | 0A-1B-2C-3D-4E-5F                                  | |''');

		ProvisioningLicense.clickGenerateLicenseButton();

		ProvisioningLicense.viewLicense(table = '''| Header  | Korlic - ${staticProjectName} | |
	| Product | DXP Production                | |''');

		Provisioning.gotoLicenses();

		Provisioning.clickGenerateLicenseButton();

		ProvisioningLicense.populateGenerateLicenseForm(table = '''| Account | Select Entity | Korlic - ${staticProjectName} | |
	| Product | Select        | Portal Production             | |
	| Version | Select        | 6.2 EE                        | |
	| Type    | Select        | Portal Production             | |''');

		ProvisioningLicense.clickChooseProductPurchaseButton(positionValue = 1);

		ProvisioningLicense.populateGenerateLicenseForm(table = '''| Name          | Input    | Korlic - ${staticProjectName} License2 Name        | |
	| Description   | Input    | Korlic - ${staticProjectName} License2 Description | |
	| Host Name     | Input    | localhost                                          | |
	| IP Addresses  | Textarea | 123.45.67.89                                       | |
	| MAC Addresses | Textarea | 0A-1B-2C-3D-4E-5F                                  | |''');

		ProvisioningLicense.clickGenerateLicenseButton();

		ProvisioningLicense.viewLicense(table = '''| Header  | Korlic - ${staticProjectName} | |
	| Product | Portal Production             | |''');

		Provisioning.gotoAccounts();

		Provisioning.searchAccounts(keyword = "Korlic");

		Provisioning.clickAccount(accountName = "Korlic - ${staticProjectName}");

		Provisioning.clickTab(tabName = "Licenses");

		ProvisioningAccount.selectLicensesViaLicensesTab(table = '''| Korlic - ${staticProjectName} License1 Name |
	| Korlic - ${staticProjectName} License2 Name |''');

		ProvisioningAccount.clickLicensesActionDropdownButton(action = "Deactivate");

		ProvisioningAccount.viewLicenseTabCount(
			countValue = 0,
			tabName = "Active");

		ProvisioningAccount.viewLicenseTabCount(
			countValue = 0,
			tabName = "Expired");

		ProvisioningAccount.viewLicenseTabCount(
			countValue = 2,
			tabName = "Deactivated");

		ProvisioningAccount.viewLicenseTabCount(
			countValue = 2,
			tabName = "All");

		ProvisioningAccount.clickLicenseTab(tabName = "Expired");

		ProvisioningAccount._viewNoAccountLicense(licenseKeyword = "Korlic - ${staticProjectName} License1 Name");

		ProvisioningAccount._viewNoAccountLicense(licenseKeyword = "Korlic - ${staticProjectName} License2 Name");

		ProvisioningAccount.clickLicenseTab(tabName = "Deactivated");

		ProvisioningAccount._viewAccountLicense(
			licenseKeyword = "Korlic - ${staticProjectName} License1 Name",
			table = '''| Name          | Korlic - ${staticProjectName} License1 Name        |
	| Description   | Korlic - ${staticProjectName} License1 Description |
	| Product       | DXP Production                                     |
	| Type          | Production                                         |
	| Details       | Host Name: localhost                               |
	| Details       | IP Address: 123.45.67.89                           |
	| Details       | MAC Address: 0A-1B-2C-3D-4E-5F                     |
	| Status        | DEACTIVATED                                        |
	| Complimentary | false                                              |''');

		ProvisioningAccount._viewAccountLicense(
			licenseKeyword = "Korlic - ${staticProjectName} License2 Name",
			table = '''| Name          | Korlic - ${staticProjectName} License2 Name        |
	| Description   | Korlic - ${staticProjectName} License2 Description |
	| Product       | Portal Production                                  |
	| Type          | Production                                         |
	| Details       | Host Name: localhost                               |
	| Details       | IP Address: 123.45.67.89                           |
	| Details       | MAC Address: 0A-1B-2C-3D-4E-5F                     |
	| Status        | DEACTIVATED                                        |
	| Complimentary | false                                              |''');

		ProvisioningAccount._viewNoAccountLicense(licenseKeyword = "ACTIVE");

		ProvisioningAccount.selectLicensesViaLicensesTab(table = '''| Korlic - ${staticProjectName} License1 Name |
	| Korlic - ${staticProjectName} License2 Name |''');

		ProvisioningAccount.clickLicensesActionDropdownButton(action = "Activate");

		ProvisioningAccount.viewLicenseTabCount(
			countValue = 2,
			tabName = "Active");

		ProvisioningAccount.viewLicenseTabCount(
			countValue = 0,
			tabName = "Expired");

		ProvisioningAccount.viewLicenseTabCount(
			countValue = 0,
			tabName = "Deactivated");

		ProvisioningAccount.viewLicenseTabCount(
			countValue = 2,
			tabName = "All");

		ProvisioningAccount.clickLicenseTab(tabName = "Expired");

		ProvisioningAccount._viewNoAccountLicense(licenseKeyword = "Korlic - ${staticProjectName} License1 Name");

		ProvisioningAccount._viewNoAccountLicense(licenseKeyword = "Korlic - ${staticProjectName} License2 Name");

		ProvisioningAccount.clickLicenseTab(tabName = "Active");

		ProvisioningAccount._viewAccountLicense(
			licenseKeyword = "Korlic - ${staticProjectName} License1 Name",
			table = '''| Name          | Korlic - ${staticProjectName} License1 Name        |
	| Description   | Korlic - ${staticProjectName} License1 Description |
	| Product       | DXP Production                                     |
	| Type          | Production                                         |
	| Details       | Host Name: localhost                               |
	| Details       | IP Address: 123.45.67.89                           |
	| Details       | MAC Address: 0A-1B-2C-3D-4E-5F                     |
	| Status        | ACTIVE                                             |
	| Complimentary | false                                              |''');

		ProvisioningAccount._viewAccountLicense(
			licenseKeyword = "Korlic - ${staticProjectName} License2 Name",
			table = '''| Name          | Korlic - ${staticProjectName} License2 Name        |
	| Description   | Korlic - ${staticProjectName} License2 Description |
	| Product       | Portal Production                                  |
	| Type          | Production                                         |
	| Details       | Host Name: localhost                               |
	| Details       | IP Address: 123.45.67.89                           |
	| Details       | MAC Address: 0A-1B-2C-3D-4E-5F                     |
	| Status        | ACTIVE                                             |
	| Complimentary | false                                              |''');

		ProvisioningAccount._viewNoAccountLicense(licenseKeyword = "DEACTIVATED");
	}

	test Bulkactivatelicensesviasubscriptiondetails {
		OSBAdminRabbitMQ.generateProvisioningProjectName();

		KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORLICKORLIC                         | |
    | Contact Email Address | lic.koroneiki1@lrcustomer.com.broken | |
    | Description           | Test osb account on koroneiki        | |
    | Fax Number            | 555-555-1234                         | |
    | Name                  | Korlic - ${staticProjectName}        | |
    | Phone Number          | 555-555-5678                         | |
    | Profile Email Address | lic.koroneiki1@lrcustomer.com.broken | |
    | Region                | United States                        | |
    | Status                | Active                               | |
    | Tier                  | T4                                   | |
    | Website               | www.koroneikicorporation.com         | |''');

		KoroneikiAccountAPI._generateAccountKey(accountName = "Korlic - ${staticProjectName}");

		KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		KoroneikiProductPurchaseAPI.generateStaticFullStartAndEndDate();

		KoroneikiProductPurchaseAPI.generateStaticFutureStartAndEndDate();

		KoroneikiProductPurchaseAPI.generateStaticFullFutureStartAndEndDate();

		KoroneikiProductPurchaseAPI.generateStaticYyyyMmDdFutureStartAndEndDate();

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korlic - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| End Date                | ${staticEndDate}         |   |
    | Original End Date       | ${staticOriginalEndDate} |   |
    | Perpetual               | false                    |   |
    | Product Field and Value | sizing                   | 2 |
    | Product Field and Value | licenses                 | 2 |
    | Product Field and Value | version                  | 7 |
    | Quantity                | 2                        |   |
    | Start Date              | ${staticStartDate}       |   |
    | Status                  | Approved                 |   |''');

		KoroneikiProductPurchaseAPI._generateProductPurchaseId(
			accountName = "Korlic - ${staticProjectName}",
			productName = "DXP Production");

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korlic - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
    | Original End Date       | ${staticOriginalEndDate} | |
    | Perpetual               | false                    | |
    | Quantity                | 1                        | |
    | Start Date              | ${staticStartDate}       | |
    | Status                  | Approved                 | |''');

		OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		Provisioning.gotoLicenses();

		Provisioning.clickGenerateLicenseButton();

		ProvisioningLicense.populateGenerateLicenseForm(table = '''| Account | Select Entity | Korlic - ${staticProjectName} | |
    | Product | Select        | DXP Production                | |
    | Version | Select        | 7.2                           | |
    | Type    | Select        | DXP Production                | |''');

		ProvisioningLicense.clickChooseProductPurchaseButton(positionValue = 1);

		ProvisioningLicense.populateGenerateLicenseForm(table = '''| Name          | Input    | Korlic - ${staticProjectName} License1 Name        | |
    | Description   | Input    | Korlic - ${staticProjectName} License1 Description | |
    | Host Name     | Input    | localhost                                          | |
    | IP Addresses  | Textarea | 123.45.67.89                                       | |
    | MAC Addresses | Textarea | 0A-1B-2C-3D-4E-5F                                  | |''');

		ProvisioningLicense.clickGenerateLicenseButton();

		ProvisioningLicense.viewLicense(table = '''| Header  | Korlic - ${staticProjectName} | |
    | Product | DXP Production                | |''');

		Provisioning.gotoLicenses();

		Provisioning.clickGenerateLicenseButton();

		ProvisioningLicense.populateGenerateLicenseForm(table = '''| Account | Select Entity | Korlic - ${staticProjectName} | |
    | Product | Select        | DXP Production                | |
    | Version | Select        | 7.2                           | |
    | Type    | Select        | DXP Production                | |''');

		ProvisioningLicense.clickChooseProductPurchaseButton(positionValue = 1);

		ProvisioningLicense.populateGenerateLicenseForm(table = '''| Name          | Input    | Korlic - ${staticProjectName} License2 Name        | |
    | Description   | Input    | Korlic - ${staticProjectName} License2 Description | |
    | Host Name     | Input    | localhost                                          | |
    | IP Addresses  | Textarea | 123.45.67.89                                       | |
    | MAC Addresses | Textarea | 0A-1B-2C-3D-4E-5F                                  | |''');

		ProvisioningLicense.clickGenerateLicenseButton();

		ProvisioningLicense.viewLicense(table = '''| Header  | Korlic - ${staticProjectName} | |
    | Product | DXP Production                | |''');

		Provisioning.gotoAccounts();

		Provisioning.searchAccounts(keyword = "Korlic");

		Provisioning.clickAccount(accountName = "Korlic - ${staticProjectName}");

		ProvisioningAccount.clickSubscriptionLink(productName = "DXP Production");

		Provisioning.clickTab(tabName = "Licenses");

		ProvisioningSubscription.selectLicensesViaLicensesTab(table = '''| Korlic - ${staticProjectName} License1 Name |
    | Korlic - ${staticProjectName} License2 Name |''');

		ProvisioningSubscription.clickLicensesActionDropdownButton(action = "Deactivate");

		ProvisioningAccount.viewLicenseTabCount(
			countValue = 0,
			tabName = "Active");

		ProvisioningAccount.viewLicenseTabCount(
			countValue = 0,
			tabName = "Expired");

		ProvisioningAccount.viewLicenseTabCount(
			countValue = 2,
			tabName = "Deactivated");

		ProvisioningAccount.viewLicenseTabCount(
			countValue = 2,
			tabName = "All");

		ProvisioningAccount.clickLicenseTab(tabName = "Expired");

		ProvisioningSubscription._viewNoSubscriptionLicense(licenseKeyword = "Korlic - ${staticProjectName} License1 Name");

		ProvisioningSubscription._viewNoSubscriptionLicense(licenseKeyword = "Korlic - ${staticProjectName} License2 Name");

		ProvisioningAccount.clickLicenseTab(tabName = "Deactivate");

		ProvisioningSubscription._viewSubscriptionLicense(
			licenseKeyword = "Korlic - ${staticProjectName} License1 Name",
			table = '''| Name          | Korlic - ${staticProjectName} License1 Name        |
    | Description   | Korlic - ${staticProjectName} License1 Description |
    | Product       | DXP Production                                     |
    | Type          | Production                                         |
    | Details       | Host Name: localhost                               |
    | Details       | IP Address: 123.45.67.89                           |
    | Details       | MAC Address: 0A-1B-2C-3D-4E-5F                     |
    | Status        | DEACTIVATED                                        |
    | Complimentary | false                                              |''');

		ProvisioningSubscription._viewSubscriptionLicense(
			licenseKeyword = "Korlic - ${staticProjectName} License2 Name",
			table = '''| Name          | Korlic - ${staticProjectName} License2 Name        |
    | Description   | Korlic - ${staticProjectName} License2 Description |
    | Product       | DXP Production                                     |
    | Type          | Production                                         |
    | Details       | Host Name: localhost                               |
    | Details       | IP Address: 123.45.67.89                           |
    | Details       | MAC Address: 0A-1B-2C-3D-4E-5F                     |
    | Status        | DEACTIVATED                                        |
    | Complimentary | false                                              |''');

		ProvisioningSubscription._viewNoSubscriptionLicense(licenseKeyword = "ACTIVE");

		ProvisioningSubscription.selectLicensesViaLicensesTab(table = '''| Korlic - ${staticProjectName} License1 Name |
    | Korlic - ${staticProjectName} License2 Name |''');

		ProvisioningSubscription.clickLicensesActionDropdownButton(action = "Activate");

		ProvisioningAccount.viewLicenseTabCount(
			countValue = 2,
			tabName = "Active");

		ProvisioningAccount.viewLicenseTabCount(
			countValue = 0,
			tabName = "Expired");

		ProvisioningAccount.viewLicenseTabCount(
			countValue = 0,
			tabName = "Deactivated");

		ProvisioningAccount.viewLicenseTabCount(
			countValue = 2,
			tabName = "All");

		ProvisioningAccount.clickLicenseTab(tabName = "Expired");

		ProvisioningSubscription._viewNoSubscriptionLicense(licenseKeyword = "Korlic - ${staticProjectName} License1 Name");

		ProvisioningSubscription._viewNoSubscriptionLicense(licenseKeyword = "Korlic - ${staticProjectName} License2 Name");

		ProvisioningAccount.clickLicenseTab(tabName = "Active");

		ProvisioningSubscription._viewSubscriptionLicense(
			licenseKeyword = "Korlic - ${staticProjectName} License1 Name",
			table = '''| Name          | Korlic - ${staticProjectName} License1 Name        |
    | Description   | Korlic - ${staticProjectName} License1 Description |
    | Product       | DXP Production                                     |
    | Type          | Production                                         |
    | Details       | Host Name: localhost                               |
    | Details       | IP Address: 123.45.67.89                           |
    | Details       | MAC Address: 0A-1B-2C-3D-4E-5F                     |
    | Status        | ACTIVE                                             |
    | Complimentary | false                                              |''');

		ProvisioningSubscription._viewSubscriptionLicense(
			licenseKeyword = "Korlic - ${staticProjectName} License2 Name",
			table = '''| Name          | Korlic - ${staticProjectName} License2 Name        |
    | Description   | Korlic - ${staticProjectName} License2 Description |
    | Product       | DXP Production                                     |
    | Type          | Production                                         |
    | Details       | Host Name: localhost                               |
    | Details       | IP Address: 123.45.67.89                           |
    | Details       | MAC Address: 0A-1B-2C-3D-4E-5F                     |
    | Status        | ACTIVE                                             |
    | Complimentary | false                                              |''');

		ProvisioningSubscription._viewNoSubscriptionLicense(licenseKeyword = "DEACTIVATED");
	}

	test Bulkdeactivatelicensesviaaccountdetails {
		OSBAdminRabbitMQ.generateProvisioningProjectName();

		KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORLICKORLIC                         | |
	| Contact Email Address | lic.koroneiki1@lrcustomer.com.broken | |
	| Description           | Test osb account on koroneiki        | |
	| Fax Number            | 555-555-1234                         | |
	| Name                  | Korlic - ${staticProjectName}        | |
	| Phone Number          | 555-555-5678                         | |
	| Profile Email Address | lic.koroneiki1@lrcustomer.com.broken | |
	| Region                | United States                        | |
	| Status                | Active                               | |
	| Tier                  | T4                                   | |
	| Website               | www.koroneikicorporation.com         | |''');

