	test GenerateNewDxpDeveloperClusterLicense {
		OSBAdminRabbitMQ.generateProvisioningProjectName();

		KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORLICKORLIC                         | |
	| Contact Email Address | lic.koroneiki1@lrcustomer.com.broken | |
	| Description           | Test osb account on koroneiki        | |
	| Fax Number            | 555-555-1234                         | |
	| Name                  | Korlic - ${staticProjectName}        | |
	| Phone Number          | 555-555-5678                         | |
	| Profile Email Address | lic.koroneiki1@lrcustomer.com.broken | |
	| Region                | United States                        | |
	| Status                | Active                               | |
	| Tier                  | T4                                   | |
	| Website               | www.koroneikicorporation.com         | |''');

		KoroneikiAccountAPI._generateAccountKey(accountName = "Korlic - ${staticProjectName}");

		KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		KoroneikiProductPurchaseAPI.generateStaticFullStartAndEndDate();

		KoroneikiProductPurchaseAPI.generateStaticFutureStartAndEndDate();

		KoroneikiProductPurchaseAPI.generateStaticFullFutureStartAndEndDate();

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korlic - ${staticProjectName}",
			productName = "DXP Development",
			table = '''| End Date                | ${staticEndDate}         |   |
	| Original End Date       | ${staticOriginalEndDate} |   |
	| Perpetual               | false                    |   |
	| Product Field and Value | sizing                   | 1 |
	| Product Field and Value | licenses                 | 1 |
	| Product Field and Value | version                  | 7 |
	| Quantity                | 1                        |   |
	| Start Date              | ${staticStartDate}       |   |
	| Status                  | Approved                 |   |''');

		KoroneikiProductPurchaseAPI._generateProductPurchaseId(
			accountName = "Korlic - ${staticProjectName}",
			productName = "DXP Development");

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korlic - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		Provisioning.gotoLicenses();

		Provisioning.clickGenerateLicenseButton();

		ProvisioningLicense.populateGenerateLicenseForm(table = '''| Account | Select Entity | Korlic - ${staticProjectName}                 | |
	| Product | Select        | DXP Development                               | |
	| Version | Select        | 7.2                                           | |
	| Type    | Select        | DXP Development (Cluster) (Developer Cluster) | |''');

		ProvisioningLicense.clickChooseProductPurchaseButton(positionValue = 1);

		ProvisioningLicense.clickGenerateLicenseButton();

		ProvisioningLicense.viewLicense(table = '''| Header  | Korlic - ${staticProjectName} | |
	| Product | DXP Development               | |''');

		Provisioning.gotoLicenses();

		Provisioning.searchLicenses(keyword = ${staticAccountKey});

		Provisioning._viewLicenseViaIndex(
			licenseKeyword = "Korlic - ${staticProjectName}",
			table = '''| Name          | Korlic - ${staticProjectName}  |
	| Description   | Korlic - ${staticProjectName}  |
	| Account       | Korlic - ${staticProjectName}  |
	| Product       | DXP Development                |
	| Type          | Developer Cluster              |
	| Status        | ACTIVE                         |
	| Complimentary | false                          |''');

		Provisioning.clickLicense(licenseKeyword = "Korlic - ${staticProjectName}");

		ProvisioningLicense.viewLicense(table = '''| Header              | Korlic - ${staticProjectName} | |
	| Product             | DXP Development               | |
	| Version             | 7.2                           | |
	| Type                | Developer Cluster             | |
	| Owner               | Korlic - ${staticProjectName} | |
	| Description         | Korlic - ${staticProjectName} | |
	| Maximum Connections | 5                             | |
	| Complimentary       | No                            | |
	| Status              | ACTIVE                        | |
	| Created By          | Test Test                     | |''');

		ProvisioningLicense.getLicenseKeyIdViaLicenseDetails();

		KoroneikiProductPurchaseAPI.generateStaticEndDates();

		KoroneikiProductPurchaseAPI.generateStaticStartDates();

		KoroneikiProductConsumptionAPI._viewProductConsumption(
			accountName = "Korlic - ${staticProjectName}",
			productName = "DXP Development",
			table = '''| End Date   | ${staticEndDates}   | |
	| Start Date | ${staticStartDates} | |''');

		KoroneikiProductConsumptionAPI._viewProductConsumptionExternalLink(
			accountName = "Korlic - ${staticProjectName}",
			entityId = ${staticLicenseKeyId},
			productName = "DXP Development",
			table = '''| Domain      | provisioning          |
	| Entity Id   | ${staticLicenseKeyId} |
	| Entity Name | license-key           |''');

		Provisioning.gotoAccounts();

		Provisioning.searchAccounts(keyword = "Korlic");

		Provisioning.clickAccount(accountName = "Korlic - ${staticProjectName}");

		ProvisioningAccount._viewAccountProduct(
			productName = "DXP Development",
			table = '''| Name                | DXP Development |
	| Current Provisioned | 1               |
	| State               | ACTIVE          |''');

		ProvisioningAccount.clickSubscriptionProvisionedLink(productName = "DXP Development");

		ProvisioningSubscription._viewSubscriptionLicense(
			licenseKeyword = "Korlic - ${staticProjectName}",
			table = '''| Name        | Korlic - ${staticProjectName} |
	| Description | Korlic - ${staticProjectName} |
	| Product     | DXP Development               |
	| Type        | Developer Cluster             |''');

		Provisioning.gotoAccounts();

		Provisioning.searchAccounts(keyword = "Korlic");

		Provisioning.clickAccount(accountName = "Korlic - ${staticProjectName}");

		ProvisioningAccount.clickSubscriptionLink(productName = "DXP Development");

		ProvisioningSubscription.clickSubscriptionProvisionedLink();

		ProvisioningSubscription._viewSubscriptionLicense(
			licenseKeyword = "Korlic - ${staticProjectName}",
			table = '''| Name          | Korlic - ${staticProjectName} |
	| Description   | Korlic - ${staticProjectName} |
	| Product       | DXP Development               |
	| Type          | Developer Cluster             |
	| Status        | ACTIVE                        |
	| Complimentary | false                         |''');

		Provisioning.gotoAccounts();

		Provisioning.searchAccounts(keyword = "Korlic");

		Provisioning.clickAccount(accountName = "Korlic - ${staticProjectName}");

		ProvisioningAccount.clickSubscriptionLink(productName = "DXP Development");

		ProvisioningSubscription.clickSubscriptionTermProvisionedLink(startDateEndDate = "${staticFullStartDate} - ${staticFullEndDate}");

		ProvisioningSubscription._viewSubscriptionLicense(
			licenseKeyword = "Korlic - ${staticProjectName}",
			table = '''| Name          | Korlic - ${staticProjectName} |
	| Description   | Korlic - ${staticProjectName} |
	| Product       | DXP Development               |
	| Type          | Developer Cluster             |
	| Status        | ACTIVE                        |
	| Complimentary | false                         |''');

		Provisioning.gotoAccounts();

		Provisioning.searchAccounts(keyword = "Korlic");

		Provisioning.clickAccount(accountName = "Korlic - ${staticProjectName}");

		Provisioning.clickTab(tabName = "History");

		ProvisioningAccount.viewAccountHistoryEntryByKeyword(
			fieldName = "productName",
			keyword = "Test Test > Added License Key",
			table = '''
				| Update Description          | Test Test > Added License Key |
				| Update Field Name           | productName                   |
				| Update Field Original Value | N/A                           |
				| Update Field New Value      | DXP Development               |''');

		ProvisioningAccount.viewAccountHistoryEntryByKeyword(
			fieldName = "maxHttpSessions",
			keyword = "Test Test > Added License Key",
			table = '''
				| Update Description          | Test Test > Added License Key |
				| Update Field Name           | maxHttpSessions               |
				| Update Field Original Value | N/A                           |
				| Update Field New Value      | 5                             |''');

		ProvisioningAccount.viewAccountHistoryEntryByKeyword(
			fieldName = "licenseEntryType",
			keyword = "Test Test > Added License Key",
			table = '''
				| Update Description          | Test Test > Added License Key |
				| Update Field Name           | licenseEntryType              |
				| Update Field Original Value | N/A                           |
				| Update Field New Value      | developer-cluster             |''');
