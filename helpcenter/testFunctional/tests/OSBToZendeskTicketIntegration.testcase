	test Viewticketafterprojectofferingdeactivation {
		property help.center.acceptance = "true";

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Osbzen - ${staticProjectName}",
			contactEmailAddress = "osb.customer2@lrcustomer.com.broken",
			table = '''| Support Requester |''');

		KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Osbzen - ${staticProjectName}",
			productName = "Portal Production",
			table = '''| End Date                | ${staticEndDate}         |   |
	| Original End Date       | ${staticOriginalEndDate} |   |
	| Perpetual               | false                    |   |
	| Product Field and Value | sizing                   | 1 |
	| Product Field and Value | licenses                 | 1 |
	| Product Field and Value | version                  | 6 |
	| Quantity                | 1                        |   |
	| Start Date              | ${staticStartDate}       |   |
	| Status                  | Approved                 |   |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Osbzen - ${staticProjectName}",
			productName = "Gold Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Gold Subscription");

		JSONOSBAccount.viewSupportOrganizationSync(accountCode = "OSBZENOSBZEN");

		ZendeskOrganizationAPI._viewOrganizationSyncFromOsb(organizationName = "Osbzen - ${staticProjectName}");

		ZendeskUserAPI._viewUserSyncFromOsb(userEmailAddress = "osb.customer1@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserSyncFromOsb(userEmailAddress = "osb.customer2@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserOrganizationIdSync(
			organizationName = "Osbzen - ${staticProjectName}",
			userEmailAddress = "osb.customer1@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserOrganizationIdSync(
			organizationName = "Osbzen - ${staticProjectName}",
			userEmailAddress = "osb.customer2@lrcustomer.com.broken");

		ZendeskRequestAPI._createRequest(
			requesterEmail = "osb.customer1@lrcustomer.com.broken",
			table = '''| Product           | prd_liferay_portal_6_2                           |
	| Component         | activation_key_project_administration            |
	| System Status     | production_functioning_with_limited_capabilities |
	| Subject           | Request Subject                                  |
	| Description       | Request Description                              |
	| Organization Name | Osbzen - ${staticProjectName}                    |''');

		ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		ZendeskTicketAPI._viewTicketStatusSync(
			status = "new",
			ticketId = ${staticRequestIdList});

		ZendeskTicketAPI._viewTicketRequesterSync(
			requesterEmailAddress = "osb.customer1@lrcustomer.com.broken",
			ticketId = ${staticRequestIdList});

		KoroneikiProductPurchaseAPI.generateStaticFutureStartAndEndDate();

		KoroneikiProductPurchaseAPI._updateProductPurchase(
			accountName = "Osbzen - ${staticProjectName}",
			productName = "Portal Production",
			table = '''| End Date                | ${staticFutureEndDate}         | |
	| Original End Date       | ${staticFutureOriginalEndDate} | |
	| Perpetual               | false                          | |
	| Start Date              | ${staticFutureStartDate}       | |
	| Status                  | Approved                       | |''');

		KoroneikiProductPurchaseAPI._updateProductPurchase(
			accountName = "Osbzen - ${staticProjectName}",
			productName = "Gold Subscription",
			table = '''| End Date                | ${staticFutureEndDate}         | |
	| Original End Date       | ${staticFutureOriginalEndDate} | |
	| Perpetual               | false                          | |
	| Start Date              | ${staticFutureStartDate}       | |
	| Status                  | Approved                       | |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Gold Subscription");

		ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		ZendeskTicketAPI._viewTicketStatusSync(
			status = "new",
			ticketId = ${staticRequestIdList});

		ZendeskTicketAPI._viewTicketRequesterSync(
			requesterEmailAddress = "osb.customer1@lrcustomer.com.broken",
			ticketId = ${staticRequestIdList});
	}

	test Viewticketafterprojectofferingdeactivationwithclosedwatcher {
		KoroneikiAccountAPI._assignContactRolesToContact(
