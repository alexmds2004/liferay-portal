		LocalFile.ZendeskTicketAPI._viewTicketRequesterSync(
			requesterEmailAddress = "osb.customer1@lrcustomer.com.broken",
			ticketId = ${staticRequestIdList});
	}

	test Viewticketafteradministratorroleupdatetorequesterroleonprovisioningaccountwithmultipleadministrators {
		LocalFile.KoroneikiAccountAPI._removeContactRolesFromContact(
			accountName = "Osbzen - ${staticProjectName}",
			contactEmailAddress = "osb.customer1@lrcustomer.com.broken",
			table = '''| Support Requester |''');

		LocalFile.KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Osbzen - ${staticProjectName}",
			contactEmailAddress = "osb.customer1@lrcustomer.com.broken",
			table = '''| Support Administrator |''');

		LocalFile.KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Osbzen - ${staticProjectName}",
			contactEmailAddress = "osb.customer2@lrcustomer.com.broken",
			table = '''| Support Administrator |''');

		LocalFile.KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		LocalFile.KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Osbzen - ${staticProjectName}",
			productName = "Portal Production",
			table = '''| End Date                | ${staticEndDate}         |   |
	| Original End Date       | ${staticOriginalEndDate} |   |
	| Perpetual               | false                    |   |
	| Product Field and Value | sizing                   | 1 |
	| Product Field and Value | licenses                 | 1 |
	| Product Field and Value | version                  | 6 |
	| Quantity                | 1                        |   |
	| Start Date              | ${staticStartDate}       |   |
	| Status                  | Approved                 |   |''');

		LocalFile.KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Osbzen - ${staticProjectName}",
			productName = "Gold Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		LocalFile.KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Gold Subscription");

		LocalFile.JSONOSBAccount.viewSupportOrganizationSync(accountCode = "OSBZENOSBZEN");

		LocalFile.ZendeskOrganizationAPI._viewOrganizationSyncFromOsb(organizationName = "Osbzen - ${staticProjectName}");

		LocalFile.ZendeskUserAPI._viewUserSyncFromOsb(userEmailAddress = "osb.customer1@lrcustomer.com.broken");

		LocalFile.ZendeskUserAPI._viewUserSyncFromOsb(userEmailAddress = "osb.customer2@lrcustomer.com.broken");

		LocalFile.ZendeskUserAPI._viewUserOrganizationIdSync(
			organizationName = "Osbzen - ${staticProjectName}",
			userEmailAddress = "osb.customer1@lrcustomer.com.broken");

		LocalFile.ZendeskUserAPI._viewUserOrganizationIdSync(
			organizationName = "Osbzen - ${staticProjectName}",
			userEmailAddress = "osb.customer2@lrcustomer.com.broken");

		LocalFile.ZendeskRequestAPI._createRequest(
			requesterEmail = "osb.customer1@lrcustomer.com.broken",
			table = '''| Product           | prd_liferay_portal_6_2                           |
	| Component         | activation_key_project_administration            |
	| System Status     | production_functioning_with_limited_capabilities |
	| Subject           | Request Subject                                  |
	| Description       | Request Description                              |
	| Organization Name | Osbzen - ${staticProjectName}                    |''');

		LocalFile.ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		LocalFile.ZendeskTicketAPI._viewTicketStatusSync(
			status = "new",
			ticketId = ${staticRequestIdList});

		LocalFile.ZendeskTicketAPI._viewTicketRequesterSync(
			requesterEmailAddress = "osb.customer1@lrcustomer.com.broken",
			ticketId = ${staticRequestIdList});

		LocalFile.OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		LocalFile.Provisioning.gotoAccounts();

		LocalFile.Provisioning.searchAccounts(keyword = "Osbzen");

		LocalFile.Provisioning.clickAccount(accountName = "Osbzen - ${staticProjectName}");

		LocalFile.Provisioning.clickTab(tabName = "Contacts");

		LocalFile.ProvisioningAccount.clickContactActionDropdownButton(
			action = "Edit",
			emailAddress = "osb.customer1@lrcustomer.com.broken");

		LocalFile.ProvisioningAccount.populateAssignContactFormAndSave(table = '''| Unassign Role | Support Administrator |
	| Assign Role   | Support Requester     |''');

		LocalFile.ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		LocalFile.ZendeskTicketAPI._viewTicketStatusSync(
			status = "new",
			ticketId = ${staticRequestIdList});

		LocalFile.ZendeskTicketAPI._viewTicketRequesterSync(
			requesterEmailAddress = "osb.customer1@lrcustomer.com.broken",
			ticketId = ${staticRequestIdList});
	}

	@help.center.acceptance = "true"
	test Viewticketafterprojectofferingdeactivation {
