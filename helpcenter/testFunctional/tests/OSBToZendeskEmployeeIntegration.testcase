definition {

	property testray.main.component.name = "Support QA";
	property type = "zendesk.integration";

	setUp {
		Data.generateSupportUser();

		JSONOkta.createOktaUser(table = '''| Screen Name   | ${staticScreenNameValue}       |
	| Email Address | ${staticEmailValue}            |
	| First Name    | ${staticContactFirstNameValue} |
	| Last Name     | ${staticContactLastNameValue}  |
	| Group         | Employees                      |''');
	}

	tearDown {
		JSONUser.tearDownUsers(table = '''| ${staticEmailValue} |''');

		JSONUser.tearDownUsersViaSupport(table = '''| ${staticEmailValue} |''');

		KoroneikiContactAPI._tearDownContacts(table = '''| ${staticEmailValue} |''');

		JSONOkta.tearDownUsers(table = '''| ${staticEmailValue} |''');

		ZendeskUserAPI._getMultipleUserIdsByEmailAddress(table = '''| ${staticEmailValue} |''');

		ZendeskUserAPI._tearDownUsersByIdList(userIds = ${staticUserIdList});
	}

	test DeactivateLiferayemployee {
		KoroneikiContactAPI._viewContactSyncViaEmailAddress(contactEmailAddress = ${staticEmailValue});

		KoroneikiContactAPI._viewAccountSyncViaUuid(
			accountName = "Liferay, Inc.",
			contactEmailAddress = ${staticEmailValue});

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - DXP");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - Portal");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - Commerce");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Liferay Employee");

		ZendeskUserAPI._viewUserSyncFromOsb(userEmailAddress = ${staticEmailValue});

		ZendeskUserAPI._viewNoUserOrganizationIdSync(
			organizationName = "Liferay, Inc.",
			userEmailAddress = ${staticEmailValue});

		ZendeskUserAPI._viewUserTagSync(
			tag = "osb_kb",
			userEmailAddress = ${staticEmailValue});

		ZendeskUserAPI._viewUserTagSync(
			tag = "osb_lr_employee",
			userEmailAddress = ${staticEmailValue});

		ZendeskUserAPI._viewUserNameByEmailAddress(
			userEmailAddress = ${staticEmailValue},
			userName = "${staticContactFirstNameValue} ${staticContactLastNameValue}");

		ZendeskUserAPI._updateUserRoleByEmailAddress(
			roleName = "Agent",
			userEmailAddress = ${staticEmailValue});

		ZendeskUserAPI._viewUserRoleByEmailAddress(
			roleName = "Agent",
			userEmailAddress = ${staticEmailValue});

		JSONOkta.deactivateOktaUser(userEmailAddress = ${staticEmailValue});

		KoroneikiContactAPI._viewNoAccountSyncViaUuid(
			accountName = "Liferay, Inc.",
			contactEmailAddress = ${staticEmailValue});

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - DXP");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - Portal");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - Commerce");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Liferay Employee");

		ZendeskUserAPI._viewUserSyncFromOsb(userEmailAddress = ${staticEmailValue});

		ZendeskUserAPI._viewNoUserOrganizationIdSync(
			organizationName = "Liferay, Inc.",
			userEmailAddress = ${staticEmailValue});

		ZendeskUserAPI._viewNoUserTagSync(
			tag = "osb_lr_employee",
			userEmailAddress = ${staticEmailValue});

		ZendeskUserAPI._viewUserNameByEmailAddress(
			userEmailAddress = ${staticEmailValue},
			userName = "${staticContactFirstNameValue} ${staticContactLastNameValue}");

		ZendeskUserAPI._viewUserRoleByEmailAddress(
			roleName = "End User",
			userEmailAddress = ${staticEmailValue});
	}


	test RemoveLiferayemployee {
	property help.center.acceptance = "true";
		KoroneikiContactAPI._viewContactSyncViaEmailAddress(contactEmailAddress = ${staticEmailValue});

		KoroneikiContactAPI._viewAccountSyncViaUuid(
			accountName = "Liferay, Inc.",
			contactEmailAddress = ${staticEmailValue});

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - DXP");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - Portal");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - Commerce");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Liferay Employee");

		ZendeskUserAPI._viewUserSyncFromOsb(userEmailAddress = ${staticEmailValue});

		ZendeskUserAPI._viewNoUserOrganizationIdSync(
			organizationName = "Liferay, Inc.",
			userEmailAddress = ${staticEmailValue});

		ZendeskUserAPI._viewUserTagSync(
			tag = "osb_kb",
			userEmailAddress = ${staticEmailValue});

		ZendeskUserAPI._viewUserTagSync(
			tag = "osb_lr_employee",
			userEmailAddress = ${staticEmailValue});

		ZendeskUserAPI._viewUserNameByEmailAddress(
			userEmailAddress = ${staticEmailValue},
			userName = "${staticContactFirstNameValue} ${staticContactLastNameValue}");

		ZendeskUserAPI._updateUserRoleByEmailAddress(
			roleName = "Agent",
			userEmailAddress = ${staticEmailValue});

		ZendeskUserAPI._viewUserRoleByEmailAddress(
			roleName = "Agent",
			userEmailAddress = ${staticEmailValue});

		JSONOkta.removeUserFromOktaGroup(
			groupName = "Employees",
			userEmailAddress = ${staticEmailValue});

		KoroneikiContactAPI._viewNoAccountSyncViaUuid(
			accountName = "Liferay, Inc.",
			contactEmailAddress = ${staticEmailValue});

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - DXP");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - Portal");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - Commerce");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Liferay Employee");

		ZendeskUserAPI._viewUserSyncFromOsb(userEmailAddress = ${staticEmailValue});

		ZendeskUserAPI._viewNoUserOrganizationIdSync(
			organizationName = "Liferay, Inc.",
			userEmailAddress = ${staticEmailValue});

		ZendeskUserAPI._viewNoUserTagSync(
			tag = "osb_lr_employee",
			userEmailAddress = ${staticEmailValue});

		ZendeskUserAPI._viewUserNameByEmailAddress(
			userEmailAddress = ${staticEmailValue},
			userName = "${staticContactFirstNameValue} ${staticContactLastNameValue}");

		ZendeskUserAPI._viewUserRoleByEmailAddress(
			roleName = "End User",
			userEmailAddress = ${staticEmailValue});
	}


	test ViewLiferayemployee {
	property help.center.acceptance = "true";
		KoroneikiContactAPI._viewContactSyncViaEmailAddress(contactEmailAddress = ${staticEmailValue});

		KoroneikiContactAPI._viewAccountSyncViaUuid(
			accountName = "Liferay, Inc.",
			contactEmailAddress = ${staticEmailValue});

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - DXP");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - Portal");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - Commerce");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Liferay Employee");

		ZendeskUserAPI._viewUserSyncFromOsb(userEmailAddress = ${staticEmailValue});

		ZendeskUserAPI._viewNoUserOrganizationIdSync(
			organizationName = "Liferay, Inc.",
			userEmailAddress = ${staticEmailValue});

		ZendeskUserAPI._viewUserTagSync(
			tag = "osb_kb",
			userEmailAddress = ${staticEmailValue});

		ZendeskUserAPI._viewUserTagSync(
			tag = "osb_lr_employee",
			userEmailAddress = ${staticEmailValue});

		ZendeskUserAPI._viewUserNameByEmailAddress(
			userEmailAddress = ${staticEmailValue},
			userName = "${staticContactFirstNameValue} ${staticContactLastNameValue}");
	}

}