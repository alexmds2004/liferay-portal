definition {

	property testray.main.component.name = "Support QA";
	property type = "zendesk.integration";

	setUp {
		LocalFile.Data.generateSupportUser();

		LocalFile.JSONOkta.createOktaUser(table = '''| Screen Name   | ${staticScreenNameValue}       |
	| Email Address | ${staticEmailValue}            |
	| First Name    | ${staticContactFirstNameValue} |
	| Last Name     | ${staticContactLastNameValue}  |
	| Group         | Employees                      |''');
	}

	tearDown {
		LocalFile.JSONUser.tearDownUsers(table = '''| ${staticEmailValue} |''');

		LocalFile.JSONUser.tearDownUsersViaSupport(table = '''| ${staticEmailValue} |''');

		LocalFile.KoroneikiContactAPI._tearDownContacts(table = '''| ${staticEmailValue} |''');

		LocalFile.JSONOkta.tearDownUsers(table = '''| ${staticEmailValue} |''');

		LocalFile.ZendeskUserAPI._getMultipleUserIdsByEmailAddress(table = '''| ${staticEmailValue} |''');

		LocalFile.ZendeskUserAPI._tearDownUsersByIdList(userIds = ${staticUserIdList});
	}

	test DeactivateLiferayemployee {
		LocalFile.KoroneikiContactAPI._viewContactSyncViaEmailAddress(contactEmailAddress = ${staticEmailValue});

		LocalFile.KoroneikiContactAPI._viewAccountSyncViaUuid(
			accountName = "Liferay, Inc.",
			contactEmailAddress = ${staticEmailValue});

		LocalFile.KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		LocalFile.KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - DXP");

		LocalFile.KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - Portal");

		LocalFile.KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - Commerce");

		LocalFile.KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Liferay Employee");

		LocalFile.ZendeskUserAPI._viewUserSyncFromOsb(userEmailAddress = ${staticEmailValue});

		LocalFile.ZendeskUserAPI._viewNoUserOrganizationIdSync(
			organizationName = "Liferay, Inc.",
			userEmailAddress = ${staticEmailValue});

		LocalFile.ZendeskUserAPI._viewUserTagSync(
			tag = "osb_kb",
			userEmailAddress = ${staticEmailValue});

		LocalFile.ZendeskUserAPI._viewUserTagSync(
			tag = "osb_lr_employee",
			userEmailAddress = ${staticEmailValue});

		LocalFile.ZendeskUserAPI._viewUserNameByEmailAddress(
			userEmailAddress = ${staticEmailValue},
			userName = "${staticContactFirstNameValue} ${staticContactLastNameValue}");

		LocalFile.ZendeskUserAPI._updateUserRoleByEmailAddress(
			roleName = "Agent",
			userEmailAddress = ${staticEmailValue});

		LocalFile.ZendeskUserAPI._viewUserRoleByEmailAddress(
			roleName = "Agent",
			userEmailAddress = ${staticEmailValue});

		LocalFile.JSONOkta.deactivateOktaUser(userEmailAddress = ${staticEmailValue});

		LocalFile.KoroneikiContactAPI._viewNoAccountSyncViaUuid(
			accountName = "Liferay, Inc.",
			contactEmailAddress = ${staticEmailValue});

		LocalFile.KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		LocalFile.KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - DXP");

		LocalFile.KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - Portal");

		LocalFile.KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - Commerce");

		LocalFile.KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Liferay Employee");

		LocalFile.ZendeskUserAPI._viewUserSyncFromOsb(userEmailAddress = ${staticEmailValue});

		LocalFile.ZendeskUserAPI._viewNoUserOrganizationIdSync(
			organizationName = "Liferay, Inc.",
			userEmailAddress = ${staticEmailValue});

		LocalFile.ZendeskUserAPI._viewNoUserTagSync(
			tag = "osb_lr_employee",
			userEmailAddress = ${staticEmailValue});

		LocalFile.ZendeskUserAPI._viewUserNameByEmailAddress(
			userEmailAddress = ${staticEmailValue},
			userName = "${staticContactFirstNameValue} ${staticContactLastNameValue}");

		LocalFile.ZendeskUserAPI._viewUserRoleByEmailAddress(
			roleName = "End User",
			userEmailAddress = ${staticEmailValue});
	}

	@help.center.acceptance = "true"
	test RemoveLiferayemployee {
		LocalFile.KoroneikiContactAPI._viewContactSyncViaEmailAddress(contactEmailAddress = ${staticEmailValue});

		LocalFile.KoroneikiContactAPI._viewAccountSyncViaUuid(
			accountName = "Liferay, Inc.",
			contactEmailAddress = ${staticEmailValue});

		LocalFile.KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		LocalFile.KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - DXP");

		LocalFile.KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - Portal");

		LocalFile.KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - Commerce");

		LocalFile.KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Liferay Employee");

		LocalFile.ZendeskUserAPI._viewUserSyncFromOsb(userEmailAddress = ${staticEmailValue});

		LocalFile.ZendeskUserAPI._viewNoUserOrganizationIdSync(
			organizationName = "Liferay, Inc.",
			userEmailAddress = ${staticEmailValue});

		LocalFile.ZendeskUserAPI._viewUserTagSync(
			tag = "osb_kb",
			userEmailAddress = ${staticEmailValue});

		LocalFile.ZendeskUserAPI._viewUserTagSync(
			tag = "osb_lr_employee",
			userEmailAddress = ${staticEmailValue});

		LocalFile.ZendeskUserAPI._viewUserNameByEmailAddress(
			userEmailAddress = ${staticEmailValue},
			userName = "${staticContactFirstNameValue} ${staticContactLastNameValue}");

		LocalFile.ZendeskUserAPI._updateUserRoleByEmailAddress(
			roleName = "Agent",
			userEmailAddress = ${staticEmailValue});

		LocalFile.ZendeskUserAPI._viewUserRoleByEmailAddress(
			roleName = "Agent",
			userEmailAddress = ${staticEmailValue});

		LocalFile.JSONOkta.removeUserFromOktaGroup(
			groupName = "Employees",
			userEmailAddress = ${staticEmailValue});

		LocalFile.KoroneikiContactAPI._viewNoAccountSyncViaUuid(
			accountName = "Liferay, Inc.",
			contactEmailAddress = ${staticEmailValue});

		LocalFile.KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		LocalFile.KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - DXP");

		LocalFile.KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - Portal");

		LocalFile.KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - Commerce");

		LocalFile.KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Liferay Employee");

		LocalFile.ZendeskUserAPI._viewUserSyncFromOsb(userEmailAddress = ${staticEmailValue});

		LocalFile.ZendeskUserAPI._viewNoUserOrganizationIdSync(
			organizationName = "Liferay, Inc.",
			userEmailAddress = ${staticEmailValue});

		LocalFile.ZendeskUserAPI._viewNoUserTagSync(
			tag = "osb_lr_employee",
			userEmailAddress = ${staticEmailValue});

		LocalFile.ZendeskUserAPI._viewUserNameByEmailAddress(
			userEmailAddress = ${staticEmailValue},
			userName = "${staticContactFirstNameValue} ${staticContactLastNameValue}");

		LocalFile.ZendeskUserAPI._viewUserRoleByEmailAddress(
			roleName = "End User",
			userEmailAddress = ${staticEmailValue});
	}

	@help.center.acceptance = "true"
	test ViewLiferayemployee {
		LocalFile.KoroneikiContactAPI._viewContactSyncViaEmailAddress(contactEmailAddress = ${staticEmailValue});

		LocalFile.KoroneikiContactAPI._viewAccountSyncViaUuid(
			accountName = "Liferay, Inc.",
			contactEmailAddress = ${staticEmailValue});

		LocalFile.KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		LocalFile.KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - DXP");

		LocalFile.KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - Portal");

		LocalFile.KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - Commerce");

		LocalFile.KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Liferay Employee");

		LocalFile.ZendeskUserAPI._viewUserSyncFromOsb(userEmailAddress = ${staticEmailValue});

		LocalFile.ZendeskUserAPI._viewNoUserOrganizationIdSync(
			organizationName = "Liferay, Inc.",
			userEmailAddress = ${staticEmailValue});

		LocalFile.ZendeskUserAPI._viewUserTagSync(
			tag = "osb_kb",
			userEmailAddress = ${staticEmailValue});

		LocalFile.ZendeskUserAPI._viewUserTagSync(
			tag = "osb_lr_employee",
			userEmailAddress = ${staticEmailValue});

		LocalFile.ZendeskUserAPI._viewUserNameByEmailAddress(
			userEmailAddress = ${staticEmailValue},
			userName = "${staticContactFirstNameValue} ${staticContactLastNameValue}");
	}

}