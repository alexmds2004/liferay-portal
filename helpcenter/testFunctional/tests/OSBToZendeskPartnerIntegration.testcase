definition {

	property testray.main.component.name = "Support QA";
	property type = "zendesk.integration";

	setUp {
		Passwords.getPasswords();

		OSBAdminRabbitMQ.generateProvisioningProjectName();

		JSONOkta.createOktaUser(table = '''| Screen Name   | osb.partner1                      |
	| Email Address | osb.partner1@lrpartner.com.broken |
	| First Name    | OSB                               |
	| Last Name     | Partner1                          |''');

		JSONOkta.createOktaUser(table = '''| Screen Name   | osb.partner2                      |
	| Email Address | osb.partner2@lrpartner.com.broken |
	| First Name    | OSB                               |
	| Last Name     | Partner2                          |''');

		KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		KoroneikiAccountAPI._createAccount(table = '''| Name   | Osbpar - ${staticProjectName} | |
	| Code   | OSBPAROSBPAR                  | |
	| Status | Active                        | |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Osbpar - ${staticProjectName}",
			productName = "Service Partnership",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Osbpar - ${staticProjectName}",
			contactEmailAddress = "osb.partner1@lrpartner.com.broken",
			table = '''| Partner Member |''');

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Osbpar - ${staticProjectName}",
			contactEmailAddress = "osb.partner2@lrpartner.com.broken",
			table = '''| Partner Manager |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Partner");

		KoroneikiAccountAPI._createAssignedTeamNestedField(
			accountName = "Osbzen - ${staticProjectName}",
			teamName = "Osbpar - ${staticProjectName}");
	}

	tearDown {
		ZendeskUserAPI._getDefaultUserId(organizationName = "Osbzen - ${staticProjectName}");

		ZendeskUserAPI._renameFirstDefaultUserIdVariable();

		ZendeskUserAPI._getDefaultUserId(organizationName = "Osbpar - ${staticProjectName}");

		ZendeskUserAPI._renameSecondDefaultUserIdVariable();

		OSBAdminProject.tearDownProjects(table = '''| OSBPAROSBPAR |
	| OSBZENOSBZEN |''');

		KoroneikiAccountAPI._tearDownAccounts(table = '''| Osbpar - ${staticProjectName} |
	| Osbzen - ${staticProjectName} |''');

		KoroneikiAccountAPI._tearDownAccountsViaAccountFieldNameAndValue(
			fieldName = "Code",
			table = '''| OSBPAROSBPAR |
	| OSBZENOSBZEN |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Gold Subscription");

		JSONUser.tearDownUsersViaSupport(table = '''| osb.partner1@lrpartner.com.broken |
	| osb.partner2@lrpartner.com.broken |''');

		JSONUser.tearDownUsersViaKoroneiki(table = '''| osb.partner1@lrpartner.com.broken |
	| osb.partner2@lrpartner.com.broken |''');

		KoroneikiContactAPI._tearDownContacts(table = '''| osb.partner1@lrpartner.com.broken |
	| osb.partner2@lrpartner.com.broken |''');

		JSONOkta.tearDownUsers(table = '''| osb.partner1@lrpartner.com.broken |
	| osb.partner2@lrpartner.com.broken |''');

		ZendeskUserAPI._getMultipleUserIdsByEmailAddress(table = '''| osb.partner1@lrpartner.com.broken |
	| osb.partner2@lrpartner.com.broken |''');

		ZendeskUserAPI._tearDownUsersByIdList(userIds = ${staticUserIdList});

		ZendeskOrganizationAPI._getMultipleOrganizationExternalIdsByOrganizationNameIfStillPresent(table = '''| Osbpar - ${staticProjectName} |
	| Osbzen - ${staticProjectName} |''');

		ZendeskOrganizationAPI._tearDownOrganizationsByExternalIdList(organizationExternalIds = ${staticOrganizationExternalIdList});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId1});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId2});
	}

	test Viewexpiredprojectpartnerworkerupdates {
		KoroneikiAccountAPI._createAccount(table = '''| Assigned Team Nested Field | ${staticAssignedTeamNestedField} | |
	| Code                       | OSBZENOSBZEN                     | |
	| Language                   | English                          | |
	| Name                       | Osbzen - ${staticProjectName}    | |
	| Region                     | United States                    | |
	| Status                     | Active                           | |
	| Tier                       | T1                               | |''');

		KoroneikiAccountAPI._assignTeamRolesToTeam(
			accountName = "Osbzen - ${staticProjectName}",
			table = '''| Partner |''',
			teamName = "Osbpar - ${staticProjectName}");

		KoroneikiAccountAPI._assignTeamRolesToTeam(
			accountName = "Osbzen - ${staticProjectName}",
			table = '''| First Line Support |''',
			teamName = "Osbpar - ${staticProjectName}");

		KoroneikiAccountAPI._createAccountPostalAddress(
			accountName = "Osbzen - ${staticProjectName}",
			table = '''| Country               | United States   |
	| Locality              | Diamond Bar     |
	| Region                | California      |
	| Type                  | Business        |
	| Mailing               | True            |
	| Postal Code           | 91765           |
	| Primary               | True            |
	| Street Address Line 1 | 123 Main Street |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Osbzen - ${staticProjectName}",
			productName = "Portal Production",
			table = '''| End Date                | ${staticEndDate}         |   |
	| Original End Date       | ${staticOriginalEndDate} |   |
	| Perpetual               | false                    |   |
	| Product Field and Value | sizing                   | 1 |
	| Product Field and Value | licenses                 | 1 |
	| Product Field and Value | version                  | 6 |
	| Quantity                | 1                        |   |
	| Start Date              | ${staticStartDate}       |   |
	| Status                  | Approved                 |   |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Osbzen - ${staticProjectName}",
			productName = "Gold Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Gold Subscription");

		ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		JSONOSBAccount.viewSupportOrganizationSync(accountCode = "OSBZENOSBZEN");

		ZendeskOrganizationAPI._viewOrganizationSyncFromOsb(organizationName = "Osbzen - ${staticProjectName}");

		ZendeskUserAPI._viewUserSyncFromOsb(userEmailAddress = "osb.partner1@lrpartner.com.broken");

		ZendeskUserAPI._viewUserSyncFromOsb(userEmailAddress = "osb.partner2@lrpartner.com.broken");

		ZendeskUserAPI._viewUserOrganizationIdSync(
			organizationName = "Osbzen - ${staticProjectName}",
			userEmailAddress = "osb.partner1@lrpartner.com.broken");

		ZendeskUserAPI._viewUserOrganizationIdSync(
			organizationName = "Osbzen - ${staticProjectName}",
			userEmailAddress = "osb.partner2@lrpartner.com.broken");

		ZendeskUserAPI._viewUserNameByEmailAddress(
			userEmailAddress = "osb.partner1@lrpartner.com.broken",
			userName = "OSB Partner1 [P]");

		ZendeskUserAPI._viewUserNameByEmailAddress(
			userEmailAddress = "osb.partner2@lrpartner.com.broken",
			userName = "OSB Partner2 [P]");

		KoroneikiProductPurchaseAPI.generateStaticPastStartAndEndDate();

		KoroneikiProductPurchaseAPI._updateProductPurchase(
			accountName = "Osbzen - ${staticProjectName}",
			productName = "Portal Production",
			table = '''| End Date                | ${staticPastEndDate}         | |
	| Original End Date       | ${staticPastOriginalEndDate} | |
	| Perpetual               | false                        | |
	| Start Date              | ${staticPastStartDate}       | |
	| Status                  | Approved                     | |''');

		KoroneikiProductPurchaseAPI._updateProductPurchase(
			accountName = "Osbzen - ${staticProjectName}",
			productName = "Gold Subscription",
			table = '''| End Date                | ${staticPastEndDate}         | |
	| Original End Date       | ${staticPastOriginalEndDate} | |
	| Perpetual               | false                        | |
	| Start Date              | ${staticPastStartDate}       | |
	| Status                  | Approved                     | |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Gold Subscription");

		ZendeskUserAPI._viewUserOrganizationIdSync(
			organizationName = "Osbzen - ${staticProjectName}",
			userEmailAddress = "osb.partner1@lrpartner.com.broken");

		ZendeskUserAPI._viewUserOrganizationIdSync(
			organizationName = "Osbzen - ${staticProjectName}",
			userEmailAddress = "osb.partner2@lrpartner.com.broken");

		ZendeskUserAPI._viewUserNameByEmailAddress(
			userEmailAddress = "osb.partner1@lrpartner.com.broken",
			userName = "OSB Partner1 [P]");

		ZendeskUserAPI._viewUserNameByEmailAddress(
			userEmailAddress = "osb.partner2@lrpartner.com.broken",
			userName = "OSB Partner2 [P]");

		ZendeskUserAPI._viewUserOrganizationSubscriptionSync(
			organizationName = "Osbzen - ${staticProjectName}",
			userEmailAddress = "osb.partner1@lrpartner.com.broken");

		ZendeskUserAPI._viewUserOrganizationSubscriptionSync(
			organizationName = "Osbzen - ${staticProjectName}",
			userEmailAddress = "osb.partner2@lrpartner.com.broken");

		ZendeskUserAPI._viewUserTagSync(
			tag = "osb_kb",
			userEmailAddress = "osb.partner1@lrpartner.com.broken");

		ZendeskUserAPI._viewUserTagSync(
			tag = "osb_kb",
			userEmailAddress = "osb.partner2@lrpartner.com.broken");

		ZendeskUserAPI._viewUserTagSync(
			tag = "osb_partner",
			userEmailAddress = "osb.partner1@lrpartner.com.broken");

		ZendeskUserAPI._viewUserTagSync(
			tag = "osb_partner",
			userEmailAddress = "osb.partner2@lrpartner.com.broken");
	}

