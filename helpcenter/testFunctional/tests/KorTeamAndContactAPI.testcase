	| Description  | Test automotive child account on koroneiki | |
	| Fax Number   | 555-555-9012                               | |
	| Name         | Koroneiki Auto Subsidiary                  | |
	| Phone Number | 555-555-3456                               | |
	| Region       | United States                              | |
	| Status       | Active                                     | |
	| Tier         | T4                                         | |
	| Website      | www.koroneikiautomotivesubsidiary.com      | |''');

		KoroneikiAccountAPI._createAccountTeam(
			accountName = "Koroneiki Automotive",
			teamName = "Development Team");

		KoroneikiAccountAPI._createAccountTeam(
			accountName = "Koroneiki Auto Subsidiary",
			teamName = "Marketing Team");

		KoroneikiTeamAPI._assignContacts(
			table = '''| koroneiki.contact1@lrcustomer.com.broken |''',
			teamName = "Development Team");

		KoroneikiTeamAPI._assignContacts(
			table = '''| koroneiki.contact2@lrcustomer.com.broken |''',
			teamName = "Marketing Team");

		KoroneikiTeamAPI._viewContact(
			contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken",
			teamName = "Development Team");

		KoroneikiTeamAPI._viewContact(
			contactEmailAddress = "koroneiki.contact2@lrcustomer.com.broken",
