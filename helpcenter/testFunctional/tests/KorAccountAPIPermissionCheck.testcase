	| Region                | United States                            | |
	| Status                | Active                                   | |
	| Tier                  | T4                                       | |
	| Website               | www.koroneikiautomotive.com              | |''');

		KoroneikiAccountAPIPermissionCheck._createAccountExternalLinkAttempt(
			accountName = "Koroneiki Automotive",
			table = '''| Domain      | koroneikiautomotive |
	| Entity Id   | 1234                |
	| Entity Name | KoroneikiAutomotive |''');

		KoroneikiAccountAPI._viewNoAccountExternalLink(
			accountName = "Koroneiki Automotive",
			entityId = 1234);
	}

	test Createchildaccountattemptasnonpermissioneduser {
		KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORAUTO                                  | |
	| Contact Email Address | koroneiki.contact1@lrcustomer.com.broken | |
