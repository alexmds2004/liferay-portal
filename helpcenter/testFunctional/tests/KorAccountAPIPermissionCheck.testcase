	| Entity Id   | 1234                |
	| Entity Name | KoroneikiAutomotive |''');

		KoroneikiAccountAPIPermissionCheck._deleteAccountExternalLinkAttempt(
			accountName = "Koroneiki Automotive",
			entityId = 1234);

		KoroneikiAccountAPI._viewAccountExternalLink(
			accountName = "Koroneiki Automotive",
