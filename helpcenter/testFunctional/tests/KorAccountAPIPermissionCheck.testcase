definition {

	property testray.main.component.name = "Support QA";
	property type = "koroneiki";

	tearDown {
		LocalFile.KoroneikiAccountAPI._tearDownAccountPermissions(accountName = "Koroneiki Auto Subsidiary");

		LocalFile.KoroneikiAccountAPI._tearDownAccountPermissions(accountName = "Koroneiki Engr Subsidiary");

		LocalFile.KoroneikiAccountAPI._tearDownAccountPermissions(accountName = "Koroneiki Automotive");

		LocalFile.KoroneikiAccountAPI._tearDownAccountPermissions(accountName = "Koroneiki Engineering");

		LocalFile.KoroneikiAccountAPI._tearDownAccounts(table = '''| Koroneiki Auto Subsidiary |
	| Koroneiki Engr Subsidiary |
	| Koroneiki Automotive      |
	| Koroneiki Engineering     |''');
	}

	test Createaccountattemptasnonpermissioneduser {
		LocalFile.KoroneikiAccountAPIPermissionCheck._createAccountAttempt(table = '''| Code                  | KORAUTO                                  | |
	| Contact Email Address | koroneiki.contact1@lrcustomer.com.broken | |
	| Description           | Test automotive account on koroneiki     | |
	| Fax Number            | 555-555-1234                             | |
	| Name                  | Koroneiki Automotive                     | |
	| Phone Number          | 555-555-5678                             | |
	| Profile Email Address | koroneiki.contact1@lrcustomer.com.broken | |
	| Region                | United States                            | |
	| Status                | Active                                   | |
	| Tier                  | T4                                       | |
	| Website               | www.koroneikiautomotive.com              | |''');

		LocalFile.KoroneikiAccountAPI._viewNoAccount(accountName = "Koroneiki Automotive");
	}

