		ProvisioningSubscription.selectLicensesViaLicensesTab(table = '''| License1Name |
	| License2Name |''');

		ProvisioningSubscription.clickLicensesActionDropdownButton(action = "Activate");

		ProvisioningAccount.clickLicenseTab(tabName = "Active");

		ProvisioningSubscription._viewSubscriptionLicense(
