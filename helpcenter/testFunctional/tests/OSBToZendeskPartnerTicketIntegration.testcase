	| Component         | activation_key_project_administration            |
	| System Status     | production_functioning_with_limited_capabilities |
	| Subject           | Request Subject                                  |
	| Description       | Request Description                              |
	| Organization Name | Osbzen - ${staticProjectName}                    |''');

		LocalFile.ZendeskTicketAPI._viewTicketStatusSync(
			status = "new",
			ticketId = ${staticRequestIdList});

		LocalFile.ZendeskTicketAPI._viewTicketRequesterSync(
			requesterEmailAddress = "osb.partner1@lrpartner.com.broken",
			ticketId = ${staticRequestIdList});

		LocalFile.ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		LocalFile.Passwords.getPasswords();

		LocalFile.OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		LocalFile.Provisioning.gotoAccounts();

		LocalFile.Provisioning.searchAccounts(keyword = "Osbpar");

		LocalFile.Provisioning.clickAccount(accountName = "Osbpar - ${staticProjectName}");

		LocalFile.Provisioning.clickTab(tabName = "Contacts");

		LocalFile.ProvisioningAccount.clickContactActionDropdownButton(
			action = "Edit",
			emailAddress = "osb.partner1@lrpartner.com.broken");

		LocalFile.ProvisioningAccount.populateAssignContactFormAndSave(table = '''| Unassign Role | Partner Member  |
	| Assign Role   | Partner Manager |''');

		LocalFile.ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		LocalFile.ZendeskTicketAPI._viewTicketStatusSync(
			status = "new",
			ticketId = ${staticRequestIdList});

		LocalFile.ZendeskTicketAPI._viewTicketRequesterSync(
			requesterEmailAddress = "osb.partner1@lrpartner.com.broken",
			ticketId = ${staticRequestIdList});
	}

}