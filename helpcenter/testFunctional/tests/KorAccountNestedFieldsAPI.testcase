		LocalFile.KoroneikiProductPurchaseAPI._createProductPurchaseExternalLinkNestedField(table = '''| Domain      | liferaydxppurchase |
	| Entity Id   | 12345              |
	| Entity Name | LiferayDXPPurchase |''');

