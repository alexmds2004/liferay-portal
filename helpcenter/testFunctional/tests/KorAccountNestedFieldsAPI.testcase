definition {

	property testray.main.component.name = "Support QA";
	property type = "koroneiki";

	tearDown {
		LocalFile.KoroneikiAccountAPI._tearDownAccounts(table = '''| Koroneiki Automotive |''');

		LocalFile.KoroneikiProductAPI._tearDownProducts(table = '''| Liferay Digital Experience Platform |
	| Liferay Portal Six                  |''');

		LocalFile.KoroneikiContactAPI._tearDownContacts(table = '''| koroneiki.contact1@lrcustomer.com.broken |
	| koroneiki.contact2@lrcustomer.com.broken |''');

		LocalFile.KoroneikiContactRoleAPI._tearDownContactRoles(table = '''| Default Account Role |
	| Extra Account Role   |''');
	}

	property help.center.acceptance = "true";
	test Createandviewaccountwithnestedfields {
		LocalFile.KoroneikiContactAPI._createContact(table = '''| Email Address | koroneiki.contact1@lrcustomer.com.broken |
	| First Name    | Koroneiki                                |
	| Language      | English                                  |
	| Last Name     | Contact1                                 |
	| Middle Name   | User                                     |''');

		LocalFile.KoroneikiContactAPI._createContact(table = '''| Email Address | koroneiki.contact2@lrcustomer.com.broken |
	| First Name    | Koroneiki                                |
	| Language      | English                                  |
	| Last Name     | Contact2                                 |
	| Middle Name   | User                                     |''');

		LocalFile.KoroneikiContactRoleAPI._createContactRole(table = '''| Description | This is the default role for accounts |
	| Name        | Default Account Role                  |
	| Type        | Account Customer                      |''');

		LocalFile.KoroneikiContactRoleAPI._createContactRole(table = '''| Description | This is the extra role for accounts |
	| Name        | Extra Account Role                  |
	| Type        | Account Worker                      |''');

		LocalFile.KoroneikiProductAPI._createProduct(table = '''| Name | Liferay Digital Experience Platform | |''');

		LocalFile.KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		LocalFile.KoroneikiContactRoleAPI._createContactRoleNestedField(contactRoleName = "Default Account Role");

