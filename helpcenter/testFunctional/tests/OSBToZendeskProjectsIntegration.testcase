definition {

	property testray.main.component.name = "Support QA";
	property type = "zendesk.integration";

	setUp {
		Passwords.getPasswords();

		OSBAdminRabbitMQ.generateProvisioningProjectName();

		JSONOkta.createOktaUser(table = '''| Screen Name   | osb.customer1                       |
	| Email Address | osb.customer1@lrcustomer.com.broken |
	| First Name    | OSB                                 |
	| Last Name     | Customer1                           |''');

		JSONOkta.createOktaUser(table = '''| Screen Name   | osb.customer2                       |
	| Email Address | osb.customer2@lrcustomer.com.broken |
	| First Name    | OSB                                 |
	| Last Name     | Customer2                           |''');

		JSONOkta.createOktaUser(table = '''| Screen Name   | osb.customer3                       |
	| Email Address | osb.customer3@lrcustomer.com.broken |
	| First Name    | OSB                                 |
	| Last Name     | Customer3                           |''');

		KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		KoroneikiAccountAPI._createAccount(table = '''| Code     | OSBZENOSBZEN                  | |
	| Language | English                       | |
	| Name     | Osbzen - ${staticProjectName} | |
	| Region   | United States                 | |
	| Status   | Active                        | |
	| Tier     | T1                            | |''');

		KoroneikiAccountAPI._createAccountPostalAddress(
			accountName = "Osbzen - ${staticProjectName}",
			table = '''| Country               | United States   |
	| Locality              | Diamond Bar     |
	| Region                | California      |
	| Type                  | Business        |
	| Mailing               | True            |
	| Postal Code           | 91765           |
	| Primary               | True            |
	| Street Address Line 1 | 123 Main Street |''');

		KoroneikiAccountAPI._createAccount(table = '''| Code   | OSBDSKOSBDSK                  | |
	| Name   | Osbdsk - ${staticProjectName} | |
	| Region | United States                 | |
	| Status | Active                        | |
	| Tier   | T1                            | |''');

		KoroneikiAccountAPI._createAccountPostalAddress(
			accountName = "Osbdsk - ${staticProjectName}",
			table = '''| Country               | United States   |
	| Locality              | Los Angeles     |
	| Region                | California      |
	| Type                  | Business        |
	| Mailing               | True            |
	| Postal Code           | 90013           |
	| Primary               | True            |
	| Street Address Line 1 | 456 Main Street |''');

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Osbzen - ${staticProjectName}",
			contactEmailAddress = "osb.customer1@lrcustomer.com.broken",
			table = '''| Support Requester |''');

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Osbdsk - ${staticProjectName}",
			contactEmailAddress = "osb.customer1@lrcustomer.com.broken",
			table = '''| Support Requester |''');

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Osbzen - ${staticProjectName}",
			contactEmailAddress = "osb.customer2@lrcustomer.com.broken",
			table = '''| Support Requester |''');

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Osbdsk - ${staticProjectName}",
			contactEmailAddress = "osb.customer3@lrcustomer.com.broken",
			table = '''| Support Requester |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Osbzen - ${staticProjectName}",
			productName = "Portal Production",
			table = '''| End Date                | ${staticEndDate}         |   |
	| Original End Date       | ${staticOriginalEndDate} |   |
	| Perpetual               | false                    |   |
	| Product Field and Value | sizing                   | 1 |
	| Product Field and Value | licenses                 | 1 |
	| Product Field and Value | version                  | 6 |
	| Quantity                | 1                        |   |
	| Start Date              | ${staticStartDate}       |   |
	| Status                  | Approved                 |   |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Osbzen - ${staticProjectName}",
			productName = "Gold Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Osbdsk - ${staticProjectName}",
			productName = "Portal Production",
			table = '''| End Date                | ${staticEndDate}         |   |
	| Original End Date       | ${staticOriginalEndDate} |   |
	| Perpetual               | false                    |   |
	| Product Field and Value | sizing                   | 1 |
	| Product Field and Value | licenses                 | 1 |
	| Product Field and Value | version                  | 6 |
	| Quantity                | 1                        |   |
	| Start Date              | ${staticStartDate}       |   |
	| Status                  | Approved                 |   |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Osbdsk - ${staticProjectName}",
			productName = "Gold Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Gold Subscription");

		ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		JSONOSBAccount.viewSupportOrganizationSync(accountCode = "OSBZENOSBZEN");

		JSONOSBAccount.viewSupportOrganizationSync(accountCode = "OSBDSKOSBDSK");

		ZendeskOrganizationAPI._viewOrganizationSyncFromOsb(organizationName = "Osbzen - ${staticProjectName}");

		ZendeskOrganizationAPI._viewOrganizationSyncFromOsb(organizationName = "Osbdsk - ${staticProjectName}");

		ZendeskUserAPI._viewUserSyncFromOsb(userEmailAddress = "osb.customer1@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserSyncFromOsb(userEmailAddress = "osb.customer2@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserSyncFromOsb(userEmailAddress = "osb.customer3@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserOrganizationIdSync(
			organizationName = "Osbzen - ${staticProjectName}",
			userEmailAddress = "osb.customer1@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserOrganizationIdSync(
			organizationName = "Osbdsk - ${staticProjectName}",
			userEmailAddress = "osb.customer1@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserOrganizationIdSync(
			organizationName = "Osbzen - ${staticProjectName}",
			userEmailAddress = "osb.customer2@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserOrganizationIdSync(
			organizationName = "Osbdsk - ${staticProjectName}",
			userEmailAddress = "osb.customer3@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserOrganizationSubscriptionSync(
			organizationName = "Osbzen - ${staticProjectName}",
			userEmailAddress = "osb.customer1@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserOrganizationSubscriptionSync(
			organizationName = "Osbdsk - ${staticProjectName}",
			userEmailAddress = "osb.customer1@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserOrganizationSubscriptionSync(
			organizationName = "Osbzen - ${staticProjectName}",
			userEmailAddress = "osb.customer2@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserOrganizationSubscriptionSync(
			organizationName = "Osbdsk - ${staticProjectName}",
			userEmailAddress = "osb.customer3@lrcustomer.com.broken");
	}

	tearDown {
		ZendeskUserAPI._getDefaultUserId(organizationName = "Osbzen - ${staticProjectName}");

		ZendeskUserAPI._renameFirstDefaultUserIdVariable();

		ZendeskUserAPI._getDefaultUserId(organizationName = "Osbdsk - ${staticProjectName}");

		ZendeskUserAPI._renameSecondDefaultUserIdVariable();

		ZendeskTicketAPI._tearDownTicketByIds(ticketIdList = ${staticRequestIdList});

		OSBAdminProject.tearDownProjects(table = '''| OSBDSKOSBDSK |
	| OSBZENOSBZEN |''');

		KoroneikiAccountAPI._tearDownAccounts(table = '''| Osbdsk - ${staticProjectName} |
	| Osbzen - ${staticProjectName} |''');

		KoroneikiAccountAPI._tearDownAccountsViaAccountFieldNameAndValue(
			fieldName = "Code",
			table = '''| OSBDSKOSBDSK |
	| OSBZENOSBZEN |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Gold Subscription");

		JSONUser.tearDownUsers(table = '''| osb.customer1@lrcustomer.com.broken |
	| osb.customer2@lrcustomer.com.broken |
	| osb.customer3@lrcustomer.com.broken |''');

		JSONUser.tearDownUsersViaSupport(table = '''| osb.customer1@lrcustomer.com.broken |
	| osb.customer2@lrcustomer.com.broken |
	| osb.customer3@lrcustomer.com.broken |''');

		JSONUser.tearDownUsersViaKoroneiki(table = '''| osb.customer1@lrcustomer.com.broken |
	| osb.customer2@lrcustomer.com.broken |
	| osb.customer3@lrcustomer.com.broken |''');

		KoroneikiContactAPI._tearDownContacts(table = '''| osb.customer1@lrcustomer.com.broken |
	| osb.customer2@lrcustomer.com.broken |
	| osb.customer3@lrcustomer.com.broken |''');

		JSONOkta.tearDownUsers(table = '''| osb.customer1@lrcustomer.com.broken |
	| osb.customer2@lrcustomer.com.broken |
	| osb.customer3@lrcustomer.com.broken |''');

		ZendeskUserAPI._getMultipleUserIdsByEmailAddress(table = '''| osb.customer1@lrcustomer.com.broken |
	| osb.customer2@lrcustomer.com.broken |
	| osb.customer3@lrcustomer.com.broken |''');

		ZendeskUserAPI._tearDownUsersByIdList(userIds = ${staticUserIdList});

		ZendeskOrganizationAPI._getMultipleOrganizationExternalIdsByOrganizationNameIfStillPresent(table = '''| Osbdsk - ${staticProjectName} |
	| Osbzen - ${staticProjectName} |''');

		ZendeskOrganizationAPI._tearDownOrganizationsByExternalIdList(organizationExternalIds = ${staticOrganizationExternalIdList});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId1});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId2});
	}

	test Viewticketafterrequesteronmultipleprojectsisremovedfromprojectwithnoticket {
		ZendeskRequestAPI._createRequest(
			requesterEmail = "osb.customer1@lrcustomer.com.broken",
			table = '''| Product           | prd_liferay_portal_6_2                           |
	| Component         | activation_key_project_administration            |
	| System Status     | production_functioning_with_limited_capabilities |
	| Subject           | Request Subject                                  |
	| Description       | Request Description                              |
	| Organization Name | Osbzen - ${staticProjectName}                    |''');

		ZendeskTicketAPI._viewTicketStatusSync(
			status = "new",
			ticketId = ${staticRequestIdList});

		ZendeskTicketAPI._viewTicketRequesterSync(
			requesterEmailAddress = "osb.customer1@lrcustomer.com.broken",
			ticketId = ${staticRequestIdList});

		KoroneikiAccountAPI._removeCustomerContacts(
			accountName = "Osbdsk - ${staticProjectName}",
			table = '''| osb.customer1@lrcustomer.com.broken |''');

		ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		ZendeskTicketAPI._viewTicketStatusSync(
			status = "new",
			ticketId = ${staticRequestIdList});

		ZendeskTicketAPI._viewTicketRequesterSync(
			requesterEmailAddress = "osb.customer1@lrcustomer.com.broken",
			ticketId = ${staticRequestIdList});

		ZendeskTicketAPI._viewTicketOrganization(
			organizationName = "Osbzen - ${staticProjectName}",
			ticketSubject = "Request Subject");
	}

	test Viewticketafterrequesteronmultipleprojectsisremovedfromprojectwithticket {
		ZendeskRequestAPI._createRequest(
			requesterEmail = "osb.customer1@lrcustomer.com.broken",
			table = '''| Product           | prd_liferay_portal_6_2                           |
	| Component         | activation_key_project_administration            |
	| System Status     | production_functioning_with_limited_capabilities |
	| Subject           | Request Subject                                  |
	| Description       | Request Description                              |
	| Organization Name | Osbzen - ${staticProjectName}                    |''');

		ZendeskTicketAPI._viewTicketStatusSync(
			status = "new",
			ticketId = ${staticRequestIdList});

		ZendeskTicketAPI._viewTicketRequesterSync(
			requesterEmailAddress = "osb.customer1@lrcustomer.com.broken",
			ticketId = ${staticRequestIdList});

		ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		KoroneikiAccountAPI._removeCustomerContacts(
			accountName = "Osbzen - ${staticProjectName}",
			table = '''| osb.customer1@lrcustomer.com.broken |''');

		ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		ZendeskTicketAPI._viewTicketStatusSync(
			status = "new",
			ticketId = ${staticRequestIdList});

		ZendeskTicketAPI._viewTicketRequesterSync(
			requesterEmailAddress = "osb.customer2@lrcustomer.com.broken",
			ticketId = ${staticRequestIdList});

		ZendeskTicketAPI._viewTicketOrganization(
			organizationName = "Osbzen - ${staticProjectName}",
			ticketSubject = "Request Subject");
	}

	test Viewticketreassignedtouserwithadifferentdefaultorganization {
		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Osbzen - ${staticProjectName}",
			contactEmailAddress = "osb.customer3@lrcustomer.com.broken",
			table = '''| Support Requester |''');

		KoroneikiAccountAPI._removeCustomerContacts(
			accountName = "Osbzen - ${staticProjectName}",
			table = '''| osb.customer2@lrcustomer.com.broken |''');

		ZendeskRequestAPI._createRequest(
			requesterEmail = "osb.customer1@lrcustomer.com.broken",
			table = '''| Product           | prd_liferay_portal_6_2                           |
	| Component         | activation_key_project_administration            |
	| System Status     | production_functioning_with_limited_capabilities |
	| Subject           | Request Subject                                  |
	| Description       | Request Description                              |
	| Organization Name | Osbzen - ${staticProjectName}                    |''');

		ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		ZendeskTicketAPI._viewTicketStatusSync(
			status = "new",
			ticketId = ${staticRequestIdList});

		ZendeskTicketAPI._viewTicketRequesterSync(
			requesterEmailAddress = "osb.customer1@lrcustomer.com.broken",
			ticketId = ${staticRequestIdList});

		ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		KoroneikiAccountAPI._removeCustomerContacts(
			accountName = "Osbzen - ${staticProjectName}",
			table = '''| osb.customer1@lrcustomer.com.broken |''');

		ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		ZendeskTicketAPI._viewTicketStatusSync(
			status = "new",
			ticketId = ${staticRequestIdList});

		ZendeskTicketAPI._viewTicketRequesterSync(
			requesterEmailAddress = "osb.customer3@lrcustomer.com.broken",
			ticketId = ${staticRequestIdList});

		ZendeskTicketAPI._viewTicketOrganization(
			organizationName = "Osbzen - ${staticProjectName}",
			ticketSubject = "Request Subject");
	}

	test Viewusertagsaftermultipleprojectexpirations {
		KoroneikiProductPurchaseAPI.generateStaticPastStartAndEndDate();

		KoroneikiProductPurchaseAPI._updateProductPurchase(
			accountName = "Osbzen - ${staticProjectName}",
			productName = "Portal Production",
			table = '''| End Date                | ${staticPastEndDate}         | |
	| Original End Date       | ${staticPastOriginalEndDate} | |
	| Perpetual               | false                        | |
	| Start Date              | ${staticPastStartDate}       | |
	| Status                  | Approved                     | |''');

		KoroneikiProductPurchaseAPI._updateProductPurchase(
			accountName = "Osbzen - ${staticProjectName}",
			productName = "Gold Subscription",
			table = '''| End Date                | ${staticPastEndDate}         | |
	| Original End Date       | ${staticPastOriginalEndDate} | |
	| Perpetual               | false                        | |
	| Start Date              | ${staticPastStartDate}       | |
	| Status                  | Approved                     | |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Gold Subscription");

		ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		ZendeskUserAPI._viewNoUserOrganizationIdSync(
			organizationName = "Osbzen - ${staticProjectName}",
			userEmailAddress = "osb.customer1@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserOrganizationIdSync(
			organizationName = "Osbdsk - ${staticProjectName}",
			userEmailAddress = "osb.customer1@lrcustomer.com.broken");

		ZendeskUserAPI._viewNoUserOrganizationIdSync(
			organizationName = "Osbzen - ${staticProjectName}",
			userEmailAddress = "osb.customer2@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserOrganizationIdSync(
			organizationName = "Osbdsk - ${staticProjectName}",
			userEmailAddress = "osb.customer3@lrcustomer.com.broken");

		ZendeskUserAPI._viewNoUserOrganizationSubscriptionSync(
			organizationName = "Osbzen - ${staticProjectName}",
			userEmailAddress = "osb.customer1@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserOrganizationSubscriptionSync(
			organizationName = "Osbdsk - ${staticProjectName}",
			userEmailAddress = "osb.customer1@lrcustomer.com.broken");

		ZendeskUserAPI._viewNoUserOrganizationSubscriptionSync(
			organizationName = "Osbzen - ${staticProjectName}",
			userEmailAddress = "osb.customer2@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserOrganizationSubscriptionSync(
			organizationName = "Osbdsk - ${staticProjectName}",
			userEmailAddress = "osb.customer3@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserTagSync(
			tag = "osb_kb",
			userEmailAddress = "osb.customer1@lrcustomer.com.broken");

		ZendeskUserAPI._viewNoUserTagSync(
			tag = "osb_kb",
			userEmailAddress = "osb.customer2@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserTagSync(
			tag = "osb_kb",
			userEmailAddress = "osb.customer3@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserTagSync(
			tag = "osb_customer",
			userEmailAddress = "osb.customer1@lrcustomer.com.broken");

		ZendeskUserAPI._viewNoUserTagSync(
			tag = "osb_customer",
			userEmailAddress = "osb.customer2@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserTagSync(
			tag = "osb_customer",
			userEmailAddress = "osb.customer3@lrcustomer.com.broken");

		KoroneikiProductPurchaseAPI._updateProductPurchase(
			accountName = "Osbdsk - ${staticProjectName}",
			productName = "Portal Production",
			table = '''| End Date                | ${staticPastEndDate}         | |
	| Original End Date       | ${staticPastOriginalEndDate} | |
	| Perpetual               | false                        | |
	| Start Date              | ${staticPastStartDate}       | |
	| Status                  | Approved                     | |''');

		KoroneikiProductPurchaseAPI._updateProductPurchase(
			accountName = "Osbdsk - ${staticProjectName}",
			productName = "Gold Subscription",
			table = '''| End Date                | ${staticPastEndDate}         | |
	| Original End Date       | ${staticPastOriginalEndDate} | |
	| Perpetual               | false                        | |
	| Start Date              | ${staticPastStartDate}       | |
	| Status                  | Approved                     | |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Gold Subscription");

		ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		ZendeskUserAPI._viewNoUserOrganizationIdSync(
			organizationName = "Osbzen - ${staticProjectName}",
			userEmailAddress = "osb.customer1@lrcustomer.com.broken");

		ZendeskUserAPI._viewNoUserOrganizationIdSync(
			organizationName = "Osbdsk - ${staticProjectName}",
			userEmailAddress = "osb.customer1@lrcustomer.com.broken");

		ZendeskUserAPI._viewNoUserOrganizationIdSync(
			organizationName = "Osbzen - ${staticProjectName}",
			userEmailAddress = "osb.customer2@lrcustomer.com.broken");

		ZendeskUserAPI._viewNoUserOrganizationIdSync(
			organizationName = "Osbdsk - ${staticProjectName}",
			userEmailAddress = "osb.customer3@lrcustomer.com.broken");

		ZendeskUserAPI._viewNoUserOrganizationSubscriptionSync(
			organizationName = "Osbzen - ${staticProjectName}",
			userEmailAddress = "osb.customer1@lrcustomer.com.broken");

		ZendeskUserAPI._viewNoUserOrganizationSubscriptionSync(
			organizationName = "Osbdsk - ${staticProjectName}",
			userEmailAddress = "osb.customer1@lrcustomer.com.broken");

		ZendeskUserAPI._viewNoUserOrganizationSubscriptionSync(
			organizationName = "Osbzen - ${staticProjectName}",
			userEmailAddress = "osb.customer2@lrcustomer.com.broken");

		ZendeskUserAPI._viewNoUserOrganizationSubscriptionSync(
			organizationName = "Osbdsk - ${staticProjectName}",
			userEmailAddress = "osb.customer3@lrcustomer.com.broken");

		ZendeskUserAPI._viewNoUserTagSync(
			tag = "osb_kb",
			userEmailAddress = "osb.customer1@lrcustomer.com.broken");

		ZendeskUserAPI._viewNoUserTagSync(
			tag = "osb_kb",
			userEmailAddress = "osb.customer2@lrcustomer.com.broken");

		ZendeskUserAPI._viewNoUserTagSync(
			tag = "osb_kb",
			userEmailAddress = "osb.customer3@lrcustomer.com.broken");

		ZendeskUserAPI._viewNoUserTagSync(
			tag = "osb_customer",
			userEmailAddress = "osb.customer1@lrcustomer.com.broken");

		ZendeskUserAPI._viewNoUserTagSync(
			tag = "osb_customer",
			userEmailAddress = "osb.customer2@lrcustomer.com.broken");

		ZendeskUserAPI._viewNoUserTagSync(
			tag = "osb_customer",
			userEmailAddress = "osb.customer3@lrcustomer.com.broken");
	}

	test Viewusertagsaftermultipleroleupdates {
		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Osbzen - ${staticProjectName}",
			contactEmailAddress = "osb.customer1@lrcustomer.com.broken",
			table = '''| Support User |''');

		KoroneikiAccountAPI._removeContactRolesFromContact(
			accountName = "Osbzen - ${staticProjectName}",
			contactEmailAddress = "osb.customer1@lrcustomer.com.broken",
			table = '''| Support Requester |''');

		ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		ZendeskUserAPI._viewUserOrganizationIdSync(
			organizationName = "Osbzen - ${staticProjectName}",
			userEmailAddress = "osb.customer1@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserOrganizationIdSync(
			organizationName = "Osbdsk - ${staticProjectName}",
			userEmailAddress = "osb.customer1@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserOrganizationIdSync(
			organizationName = "Osbzen - ${staticProjectName}",
			userEmailAddress = "osb.customer2@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserOrganizationIdSync(
			organizationName = "Osbdsk - ${staticProjectName}",
			userEmailAddress = "osb.customer3@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserOrganizationSubscriptionSync(
			organizationName = "Osbzen - ${staticProjectName}",
			userEmailAddress = "osb.customer1@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserOrganizationSubscriptionSync(
			organizationName = "Osbdsk - ${staticProjectName}",
			userEmailAddress = "osb.customer1@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserOrganizationSubscriptionSync(
			organizationName = "Osbzen - ${staticProjectName}",
			userEmailAddress = "osb.customer2@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserOrganizationSubscriptionSync(
			organizationName = "Osbdsk - ${staticProjectName}",
			userEmailAddress = "osb.customer3@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserWatcherTagSync(
			organizationName = "Osbzen - ${staticProjectName}",
			userEmailAddress = "osb.customer1@lrcustomer.com.broken");

		ZendeskUserAPI._viewNoUserWatcherTagSync(
			organizationName = "Osbdsk - ${staticProjectName}",
			userEmailAddress = "osb.customer1@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserTagSync(
			tag = "osb_kb",
			userEmailAddress = "osb.customer1@lrcustomer.com.broken");

