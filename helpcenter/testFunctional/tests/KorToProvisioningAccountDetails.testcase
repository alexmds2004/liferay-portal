	| Region           | Japan                         |
	| SLA              | Platinum                      |
	| Tier             | T1                            |
	| State            | ACTIVE                        |''');

		LocalFile.ProvisioningAccount._viewAccountRelatedAccountUnderSection(
			accountName = "Onepro - ${staticProjectName}",
			accountSection = "Parent Account");

		LocalFile.ProvisioningAccount.viewRelatedAccountTabCount(
			countValue = 1,
			tabName = "All");

		LocalFile.ProvisioningAccount.viewRelatedAccountTabCount(
			countValue = 0,
			tabName = "Active");

		LocalFile.ProvisioningAccount.viewRelatedAccountTabCount(
			countValue = 1,
			tabName = "Closed");

		LocalFile.ZendeskHomepage.pause(timeInSeconds = 5);

		LocalFile.ProvisioningAccount.searchRelatedAccounts(keyword = "Korpro");

		LocalFile.ProvisioningAccount._viewNoAccountRelatedAccount(accountName = "Korpro - ${staticProjectName}");

		LocalFile.ProvisioningAccount.clickRelatedAccountTab(tabName = "Active");

		LocalFile.ProvisioningAccount.searchRelatedAccounts(keyword = "Onepro");

		LocalFile.ProvisioningAccount._viewNoAccountRelatedAccount(accountName = "Onepro - ${staticProjectName}");

