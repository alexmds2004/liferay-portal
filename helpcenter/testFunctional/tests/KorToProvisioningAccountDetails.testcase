definition {

	property testray.main.component.name = "Support QA";
	property type = "provisioning.integration";

	setUp {
		LocalFile.Passwords.getPasswords();

		LocalFile.OSBAdminRabbitMQ.generateStaticVariables();

		LocalFile.OSBAdminRabbitMQ.generateProvisioningCompanyName();

		LocalFile.OSBAdminRabbitMQ.generateProvisioningProjectName();

		LocalFile.KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		LocalFile.KoroneikiProductPurchaseAPI.generateStaticFullStartAndEndDate();

		LocalFile.KoroneikiProductPurchaseAPI.generateStaticFutureStartAndEndDate();

		LocalFile.KoroneikiProductPurchaseAPI.generateStaticFullFutureStartAndEndDate();

		LocalFile.KoroneikiProductPurchaseAPI.generateStaticPastStartAndEndDate();

		LocalFile.KoroneikiProductPurchaseAPI.generateStaticFullPastStartAndEndDate();

		LocalFile.JSONOkta.createOktaUser(table = '''| Screen Name   | pro.koroneiki1                       |
	| Email Address | pro.koroneiki1@lrcustomer.com.broken |
	| First Name    | PRO                                  |
	| Last Name     | Koroneiki1                           |''');

		LocalFile.JSONOkta.createOktaUser(table = '''| Screen Name   | pro.koroneiki2                       |
	| Email Address | pro.koroneiki2@lrcustomer.com.broken |
	| First Name    | PRO                                  |
	| Last Name     | Koroneiki2                           |''');
	}

	tearDown {
		LocalFile.ZendeskUserAPI._getDefaultUserId(organizationName = "Korpro - ${staticProjectName}");

		LocalFile.ZendeskUserAPI._renameFirstDefaultUserIdVariable();

		LocalFile.ZendeskUserAPI._getDefaultUserId(organizationName = "Vchild - ${staticProjectName}");

		LocalFile.ZendeskUserAPI._renameSecondDefaultUserIdVariable();

		LocalFile.ZendeskUserAPI._getDefaultUserId(organizationName = "Pchild - ${staticProjectName}");

		LocalFile.ZendeskUserAPI._renameThirdDefaultUserIdVariable();

		LocalFile.ZendeskUserAPI._getDefaultUserId(organizationName = "Onepro - ${staticProjectName}");

		LocalFile.ZendeskUserAPI._renameFourthDefaultUserIdVariable();

		LocalFile.ZendeskUserAPI._getDefaultUserId(organizationName = "Prokor - ${staticCompanyName}");

		LocalFile.ZendeskUserAPI._renameFifthDefaultUserIdVariable();

		LocalFile.KoroneikiTeamAPI._tearDownTeams(table = '''| Koroneiki Partner |
	| Updated Partner   |''');

		LocalFile.OSBAdminProject.tearDownProjects(table = '''| VCHILDVCHILD |
	| PCHILDPCHILD |
	| PROKORKORPRO |
	| ONEPROONEPRO |
	| PROKOR       |''');

		LocalFile.KoroneikiAccountAPI._tearDownAccounts(table = '''| Vchild - ${staticProjectName} |
	| Pchild - ${staticProjectName} |
	| Korpro - ${staticProjectName} |
	| Onepro - ${staticProjectName} |
	| Prokor - ${staticCompanyName} |''');

		LocalFile.KoroneikiAccountAPI._tearDownAccountsViaAccountFieldNameAndValue(
			fieldName = "Code",
			table = '''| VCHILDVCHILD |
	| PCHILDPCHILD |
	| PROKORKORPRO |
	| ONEPROONEPRO |
	| PROKOR       |''');

		LocalFile.KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		LocalFile.KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Gold Subscription");

		LocalFile.JSONUser.tearDownUsers(table = '''| pro.koroneiki1@lrcustomer.com.broken |
	| pro.koroneiki2@lrcustomer.com.broken |''');

		LocalFile.JSONUser.tearDownUsersViaSupport(table = '''| pro.koroneiki1@lrcustomer.com.broken |
	| pro.koroneiki2@lrcustomer.com.broken |''');

		LocalFile.JSONUser.tearDownUsersViaKoroneiki(table = '''| pro.koroneiki1@lrcustomer.com.broken |
	| pro.koroneiki2@lrcustomer.com.broken |''');

		LocalFile.KoroneikiContactAPI._tearDownContacts(table = '''| pro.koroneiki1@lrcustomer.com.broken |
	| pro.koroneiki2@lrcustomer.com.broken |''');

		LocalFile.JSONOkta.tearDownUsers(table = '''| pro.koroneiki1@lrcustomer.com.broken |
	| pro.koroneiki2@lrcustomer.com.broken |''');

		LocalFile.ZendeskTicketAPI._tearDownTicketsByKeywords(table = '''| New Subscription(s) for Korpro - ${staticProjectName} |
	| New Subscription(s) for Prokor - ${staticCompanyName} |''');

		LocalFile.ZendeskUserAPI._getMultipleUserIdsByEmailAddress(table = '''| pro.koroneiki1@lrcustomer.com.broken |
	| pro.koroneiki2@lrcustomer.com.broken |''');

		LocalFile.ZendeskUserAPI._tearDownUsersByIdList(userIds = ${staticUserIdList});

		LocalFile.ZendeskOrganizationAPI._getMultipleOrganizationExternalIdsByOrganizationNameIfStillPresent(table = '''| Korpro - ${staticProjectName} |
	| Vchild - ${staticProjectName} |
	| Pchild - ${staticProjectName} |
	| Onepro - ${staticProjectName} |
	| Prokor - ${staticCompanyName} |''');

		LocalFile.ZendeskOrganizationAPI._tearDownOrganizationsByExternalIdList(organizationExternalIds = ${staticOrganizationExternalIdList});

		LocalFile.ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId1});

		LocalFile.ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId2});

		LocalFile.ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId3});

		LocalFile.ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId4});

		LocalFile.ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId5});
	}

	@help.center.acceptance = "true"
	test Addaddress {
		LocalFile.OSBAdminRabbitMQ.publishCreateProjectWithNoPartnerMessage(
			routingKey = "dossiera.provisioning.create",
			table = '''| Account Name                           | Prokor - ${staticCompanyName}              |
	| Address City                           | Diamond Bar                                |
	| Address Country                        | United States                              |
	| Address Postal Code                    | 91765                                      |
	| Address Region                         | California                                 |
	| Address Street                         | 456 Fake Street                            |
	| Contact Email Address                  | pro.koroneiki1@lrcustomer.com.broken       |
	| Contact First Name                     | PRO                                        |
	| Contact Last Name                      | Koroneiki1                                 |
	| Dossiera Account Key                   | ${staticDossieraAccountKey}                |
	| Dossiera Address Key 1                 | ${staticDossieraAddressKey1}               |
	| Dossiera Address Key 2                 | ${staticDossieraAddressKey2}               |
	| Dossiera Contact Key                   | ${staticDossieraContactKey}                |
	| Dossiera Project Key                   | ${staticDossieraProjectKey}                |
	| End Day                                | ${staticEndDay}                            |
	| End Month                              | ${staticEndMonth}                          |
	| End Year                               | ${staticEndYear}                           |
	| Industry                               | Automotive                                 |
	| Owner Email Address                    | pro.koroneiki2@lrcustomer.com.broken       |
	| Owner First Name                       | PRO                                        |
	| Owner Last Name                        | Koroneiki2                                 |
	| Partner First Line Support             | false                                      |
	| Product Type                           | New                                        |
	| Product Name                           | Liferay Digital Enterprise - Prod Sizing 4 |
	| Project Name                           | Korpro - ${staticProjectName}              |
	| Renewal                                | false                                      |
	| Salesforce Opportunity Key             | ${staticSalesforceOpportunityKey}          |
	| Salesforce Opportunity Line Item Key 1 | ${staticSalesforceOpportunityLineItemKey1} |
	| Salesforce Opportunity Line Item Key 2 | ${staticSalesforceOpportunityLineItemKey2} |
	| Salesforce Opportunity Sold By         | Liferay US                                 |
	| Salesforce Opportunity Stage Name      | Closed Won                                 |
	| Salesforce Opportunity Territory       | United States                              |
	| Salesforce Opportunity Type            | New Business                               |
	| Salesforce Owner User Key              | ${staticSalesforceOwnerUserKey}            |
	| Salesforce Project Key                 | ${staticSalesforceProjectKey}              |
	| Start Day                              | ${staticStartDay}                          |
	| Start Month                            | ${staticStartMonth}                        |
	| Start Year                             | ${staticStartYear}                         |
	| Subscription Level                     | Platinum                                   |
	| Version Number                         | 7.1                                        |''');

		LocalFile.KoroneikiAccountAPI._createAccountTeam(
			accountName = "Korpro - ${staticProjectName}",
			teamName = "Koroneiki Partner");

		LocalFile.KoroneikiAccountAPI._assignTeamRolesToTeam(
			accountName = "Korpro - ${staticProjectName}",
			table = '''| First Line Support |''',
			teamName = "Koroneiki Partner");

		LocalFile.OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		LocalFile.Provisioning.gotoAccounts();

		LocalFile.Provisioning.searchAccounts(keyword = "Korpro");

		LocalFile.Provisioning.clickAccount(accountName = "Korpro - ${staticProjectName}");

		LocalFile.Provisioning.clickTab(tabName = "Details");

		LocalFile.ProvisioningAccount.clickAddAddress(positionValue = 1);

		LocalFile.ProvisioningAccount.editAndSaveAccountAddressDetails(
			positionValue = 2,
			table = '''| Street 1       | Input         | 456 Main Street  |
	| Country        | Select        | Canada           |
	| City           | Input         | Vancouver        |
	| State/Province | Select        | British Columbia |
	| Postal Code    | Input         | V5Y 0C9          |
	| Primary        | Toggle Switch | false            |''');

		LocalFile.ProvisioningAccount._viewAccountDetailsViaDetailsTab(table = '''| Account Name        | Korpro - ${staticProjectName} |   |
	| State               | ACTIVE                        |   |
	| Code                | PROKORKORPRO                  |   |
	| Tier                | T4                            |   |
	| Parent              | Prokor - ${staticCompanyName} |	  |
	| Data Region         | United States                 |   |
	| First Line Support  | Koroneiki Partner             |	  |
	| Liferay Version     | DXP 7.1                       |   |
	| Street 1            | 456 Fake Street               | 1 |
	| Country             | United States                 | 1 |
	| City                | Diamond Bar                   | 1 |
	| State/Province      | California                    | 1 |
	| Postal Code         | 91765                         | 1 |
	| Primary             | true                          | 1 |
	| Street 1            | 456 Main Street               | 2 |
	| Country             | Canada                        | 2 |
	| City                | Vancouver                     | 2 |
	| State/Province      | British Columbia              | 2 |
	| Postal Code         | V5Y 0C9                       | 2 |
	| Primary             | false                         | 2 |
	| Dossiera Project    | ${staticDossieraProjectKey}   |   |
	| Salesforce Project  | ${staticSalesforceProjectKey} |   |''');

		LocalFile.KoroneikiPostalAddressAPI._viewPostalAddress(
			accountName = "Korpro - ${staticProjectName}",
			streetAddressLine1 = "456 Main Street",
			table = '''| Country               | Canada           |
	| Locality              | Vancouver        |
	| Region                | British Columbia |
	| Mailing               | false            |
	| Postal Code           | V5Y 0C9          |
	| Primary               | false            |
	| Street Address Line 1 | 456 Main Street  |''');

		LocalFile.KoroneikiPostalAddressAPI._viewPostalAddress(
			accountName = "Korpro - ${staticProjectName}",
			streetAddressLine1 = "456 Fake Street",
			table = '''| Country               | United States   |
	| Locality              | Diamond Bar     |
	| Region                | California      |
	| Mailing               | false           |
	| Postal Code           | 91765           |
	| Primary               | true            |
	| Street Address Line 1 | 456 Fake Street |''');

		LocalFile.Provisioning.clickTab(tabName = "History");

		LocalFile.ProvisioningAccount.viewAccountHistoryEntryByKeyword(
			fieldName = "Address",
			keyword = "Auto > Added Address",
			table = '''| Update Description          | Auto > Added Address |
	| Update Field Name           | Address              |
	| Update Field Original Value | N/A                  |
	| Update Field New Value      | 456 Fake Street      |''');

		LocalFile.ProvisioningAccount.viewAccountHistoryEntryByKeyword(
			fieldName = "Address",
			keyword = "Auto > Added Address",
			table = '''| Update Description          | Auto > Added Address          |
	| Update Field Name           | Address                       |
	| Update Field Original Value | N/A                           |
	| Update Field New Value      | Diamond Bar, California 91765 |''');

		LocalFile.ProvisioningAccount.viewAccountHistoryEntryByKeyword(
			fieldName = "Address",
			keyword = "Auto > Added Address",
			table = '''| Update Description          | Auto > Added Address |
	| Update Field Name           | Address              |
	| Update Field Original Value | N/A                  |
	| Update Field New Value      | United States        |''');

		LocalFile.ProvisioningAccount.viewAccountHistoryEntryByKeyword(
			fieldName = "Address",
			keyword = "Test Test > Added Address",
			table = '''| Update Description          | Test Test > Added Address |
	| Update Field Name           | Address                   |
	| Update Field Original Value | N/A                       |
	| Update Field New Value      | 456 Main Street           |''');

		LocalFile.ProvisioningAccount.viewAccountHistoryEntryByKeyword(
			fieldName = "Address",
			keyword = "Test Test > Added Address",
			table = '''| Update Description          | Test Test > Added Address           |
	| Update Field Name           | Address                             |
	| Update Field Original Value | N/A                                 |
	| Update Field New Value      | Vancouver, British Columbia V5Y 0C9 |''');

		LocalFile.ProvisioningAccount.viewAccountHistoryEntryByKeyword(
			fieldName = "Address",
			keyword = "Test Test > Added Address",
			table = '''| Update Description          | Test Test > Added Address |
	| Update Field Name           | Address                   |
	| Update Field Original Value | N/A                       |
	| Update Field New Value      | Canada                    |''');
	}

	test Addaddressonupdatedaccount {
		LocalFile.OSBAdminRabbitMQ.publishCreateProjectWithNoPartnerMessage(
			routingKey = "dossiera.provisioning.create",
			table = '''| Account Name                           | Prokor - ${staticCompanyName}              |
	| Address City                           | Diamond Bar                                |
	| Address Country                        | United States                              |
	| Address Postal Code                    | 91765                                      |
	| Address Region                         | California                                 |
	| Address Street                         | 456 Fake Street                            |
	| Contact Email Address                  | pro.koroneiki1@lrcustomer.com.broken       |
	| Contact First Name                     | PRO                                        |
	| Contact Last Name                      | Koroneiki1                                 |
	| Dossiera Account Key                   | ${staticDossieraAccountKey}                |
	| Dossiera Address Key 1                 | ${staticDossieraAddressKey1}               |
	| Dossiera Address Key 2                 | ${staticDossieraAddressKey2}               |
	| Dossiera Contact Key                   | ${staticDossieraContactKey}                |
	| Dossiera Project Key                   | ${staticDossieraProjectKey}                |
	| End Day                                | ${staticEndDay}                            |
	| End Month                              | ${staticEndMonth}                          |
	| End Year                               | ${staticEndYear}                           |
	| Industry                               | Automotive                                 |
	| Owner Email Address                    | pro.koroneiki2@lrcustomer.com.broken       |
	| Owner First Name                       | PRO                                        |
	| Owner Last Name                        | Koroneiki2                                 |
	| Partner First Line Support             | false                                      |
	| Product Type                           | New                                        |
	| Product Name                           | Liferay Digital Enterprise - Prod Sizing 4 |
	| Project Name                           | Korpro - ${staticProjectName}              |
	| Renewal                                | false                                      |
	| Salesforce Opportunity Key             | ${staticSalesforceOpportunityKey}          |
	| Salesforce Opportunity Line Item Key 1 | ${staticSalesforceOpportunityLineItemKey1} |
	| Salesforce Opportunity Line Item Key 2 | ${staticSalesforceOpportunityLineItemKey2} |
	| Salesforce Opportunity Sold By         | Liferay US                                 |
	| Salesforce Opportunity Stage Name      | Closed Won                                 |
	| Salesforce Opportunity Territory       | United States                              |
	| Salesforce Opportunity Type            | New Business                               |
	| Salesforce Owner User Key              | ${staticSalesforceOwnerUserKey}            |
	| Salesforce Project Key                 | ${staticSalesforceProjectKey}              |
	| Start Day                              | ${staticStartDay}                          |
	| Start Month                            | ${staticStartMonth}                        |
	| Start Year                             | ${staticStartYear}                         |
	| Subscription Level                     | Platinum                                   |
	| Version Number                         | 7.1                                        |''');

		LocalFile.KoroneikiAccountAPI._createAccountTeam(
			accountName = "Korpro - ${staticProjectName}",
			teamName = "Koroneiki Partner");

		LocalFile.KoroneikiAccountAPI._assignTeamRolesToTeam(
			accountName = "Korpro - ${staticProjectName}",
			table = '''| First Line Support |''',
			teamName = "Koroneiki Partner");

		LocalFile.KoroneikiAccountAPI._updateAccount(
			accountName = "Korpro - ${staticProjectName}",
			table = '''| Code         | ONEPROONEPRO                             | |
	| Description  | Test update account on koroneiki         | |
	| Fax Number   | 555-555-4321                             | |
	| Name         | Onepro - ${staticProjectName}            | |
	| Phone Number | 555-555-8765                             | |
	| Region       | Global                                   | |
	| Status       | Active                                   | |
	| Tier         | T1                                       | |
	| Website      | www.koroneikiupdate.com                  | |''');

		LocalFile.OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		LocalFile.Provisioning.gotoAccounts();

		LocalFile.Provisioning.searchAccounts(keyword = "Onepro");

		LocalFile.Provisioning.clickAccount(accountName = "Onepro - ${staticProjectName}");

		LocalFile.Provisioning.clickTab(tabName = "Details");

		LocalFile.ProvisioningAccount.clickAddAddress(positionValue = 1);

		LocalFile.ProvisioningAccount.editAndSaveAccountAddressDetails(
			positionValue = 2,
			table = '''| Street 1       | Input         | 456 Main Street  |
	| Country        | Select        | Canada           |
	| City           | Input         | Vancouver        |
	| State/Province | Select        | British Columbia |
	| Postal Code    | Input         | V5Y 0C9          |
	| Primary        | Toggle Switch | false            |''');

		LocalFile.ProvisioningAccount._viewAccountDetailsViaDetailsTab(table = '''| Account Name        | Onepro - ${staticProjectName} |   |
	| State               | ACTIVE                        |   |
	| Code                | ONEPROONEPRO                  |   |
	| Tier                | T1                            |   |
	| Parent              | Prokor - ${staticCompanyName} |	  |
	| Data Region         | United States                 |   |
	| First Line Support  | Koroneiki Partner             |	  |
	| Liferay Version     | DXP 7.1                       |   |
	| Street 1            | 456 Fake Street               | 1 |
	| Country             | United States                 | 1 |
	| City                | Diamond Bar                   | 1 |
	| State/Province      | California                    | 1 |
	| Postal Code         | 91765                         | 1 |
	| Street 1            | 456 Main Street               | 2 |
	| Country             | Canada                        | 2 |
	| City                | Vancouver                     | 2 |
	| State/Province      | British Columbia              | 2 |
	| Postal Code         | V5Y 0C9                       | 2 |
	| Dossiera Project    | ${staticDossieraProjectKey}   |   |
	| Salesforce Project  | ${staticSalesforceProjectKey} |   |''');

		LocalFile.KoroneikiPostalAddressAPI._viewPostalAddress(
			accountName = "Onepro - ${staticProjectName}",
			streetAddressLine1 = "456 Main Street",
			table = '''| Country               | Canada           |
	| Locality              | Vancouver        |
	| Region                | British Columbia |
	| Mailing               | false            |
	| Postal Code           | V5Y 0C9          |
	| Primary               | false            |
	| Street Address Line 1 | 456 Main Street  |''');

		LocalFile.KoroneikiPostalAddressAPI._viewPostalAddress(
			accountName = "Onepro - ${staticProjectName}",
			streetAddressLine1 = "456 Fake Street",
			table = '''| Country               | United States   |
	| Locality              | Diamond Bar     |
	| Region                | California      |
	| Mailing               | false           |
	| Postal Code           | 91765           |
	| Primary               | true            |
	| Street Address Line 1 | 456 Fake Street |''');

		LocalFile.Provisioning.clickTab(tabName = "History");

		LocalFile.ProvisioningAccount.viewAccountHistoryEntryByKeyword(
			fieldName = "Address",
			keyword = "Auto > Added Address",
			table = '''| Update Description          | Auto > Added Address |
	| Update Field Name           | Address              |
	| Update Field Original Value | N/A                  |
	| Update Field New Value      | 456 Fake Street      |''');

		LocalFile.ProvisioningAccount.viewAccountHistoryEntryByKeyword(
			fieldName = "Address",
			keyword = "Auto > Added Address",
			table = '''| Update Description          | Auto > Added Address          |
	| Update Field Name           | Address                       |
	| Update Field Original Value | N/A                           |
	| Update Field New Value      | Diamond Bar, California 91765 |''');

		LocalFile.ProvisioningAccount.viewAccountHistoryEntryByKeyword(
			fieldName = "Address",
			keyword = "Auto > Added Address",
			table = '''| Update Description          | Auto > Added Address |
	| Update Field Name           | Address              |
	| Update Field Original Value | N/A                  |
	| Update Field New Value      | United States        |''');

		LocalFile.ProvisioningAccount.viewAccountHistoryEntryByKeyword(
			fieldName = "Address",
			keyword = "Test Test > Added Address",
			table = '''| Update Description          | Test Test > Added Address |
	| Update Field Name           | Address                   |
	| Update Field Original Value | N/A                       |
	| Update Field New Value      | 456 Main Street           |''');

		LocalFile.ProvisioningAccount.viewAccountHistoryEntryByKeyword(
			fieldName = "Address",
			keyword = "Test Test > Added Address",
			table = '''| Update Description          | Test Test > Added Address           |
	| Update Field Name           | Address                             |
	| Update Field Original Value | N/A                                 |
	| Update Field New Value      | Vancouver, British Columbia V5Y 0C9 |''');

		LocalFile.ProvisioningAccount.viewAccountHistoryEntryByKeyword(
			fieldName = "Address",
			keyword = "Test Test > Added Address",
			table = '''| Update Description          | Test Test > Added Address |
	| Update Field Name           | Address                   |
	| Update Field Original Value | N/A                       |
	| Update Field New Value      | Canada                    |''');
	}

	test Addaddresswithblankfields {
		LocalFile.OSBAdminRabbitMQ.publishCreateProjectWithNoPartnerMessage(
			routingKey = "dossiera.provisioning.create",
			table = '''| Account Name                           | Prokor - ${staticCompanyName}              |
	| Address City                           | Diamond Bar                                |
	| Address Country                        | United States                              |
	| Address Postal Code                    | 91765                                      |
	| Address Region                         | California                                 |
	| Address Street                         | 456 Fake Street                            |
	| Contact Email Address                  | pro.koroneiki1@lrcustomer.com.broken       |
	| Contact First Name                     | PRO                                        |
	| Contact Last Name                      | Koroneiki1                                 |
	| Dossiera Account Key                   | ${staticDossieraAccountKey}                |
	| Dossiera Address Key 1                 | ${staticDossieraAddressKey1}               |
	| Dossiera Address Key 2                 | ${staticDossieraAddressKey2}               |
	| Dossiera Contact Key                   | ${staticDossieraContactKey}                |
	| Dossiera Project Key                   | ${staticDossieraProjectKey}                |
	| End Day                                | ${staticEndDay}                            |
	| End Month                              | ${staticEndMonth}                          |
	| End Year                               | ${staticEndYear}                           |
	| Industry                               | Automotive                                 |
	| Owner Email Address                    | pro.koroneiki2@lrcustomer.com.broken       |
	| Owner First Name                       | PRO                                        |
	| Owner Last Name                        | Koroneiki2                                 |
	| Partner First Line Support             | false                                      |
	| Product Type                           | New                                        |
	| Product Name                           | Liferay Digital Enterprise - Prod Sizing 4 |
	| Project Name                           | Korpro - ${staticProjectName}              |
	| Renewal                                | false                                      |
	| Salesforce Opportunity Key             | ${staticSalesforceOpportunityKey}          |
	| Salesforce Opportunity Line Item Key 1 | ${staticSalesforceOpportunityLineItemKey1} |
	| Salesforce Opportunity Line Item Key 2 | ${staticSalesforceOpportunityLineItemKey2} |
	| Salesforce Opportunity Sold By         | Liferay US                                 |
	| Salesforce Opportunity Stage Name      | Closed Won                                 |
	| Salesforce Opportunity Territory       | United States                              |
	| Salesforce Opportunity Type            | New Business                               |
	| Salesforce Owner User Key              | ${staticSalesforceOwnerUserKey}            |
	| Salesforce Project Key                 | ${staticSalesforceProjectKey}              |
	| Start Day                              | ${staticStartDay}                          |
	| Start Month                            | ${staticStartMonth}                        |
	| Start Year                             | ${staticStartYear}                         |
	| Subscription Level                     | Platinum                                   |
	| Version Number                         | 7.1                                        |''');

		LocalFile.KoroneikiAccountAPI._createAccountTeam(
			accountName = "Korpro - ${staticProjectName}",
			teamName = "Koroneiki Partner");

		LocalFile.KoroneikiAccountAPI._assignTeamRolesToTeam(
			accountName = "Korpro - ${staticProjectName}",
			table = '''| First Line Support |''',
			teamName = "Koroneiki Partner");

		LocalFile.OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		LocalFile.Provisioning.gotoAccounts();

		LocalFile.Provisioning.searchAccounts(keyword = "Korpro");

		LocalFile.Provisioning.clickAccount(accountName = "Korpro - ${staticProjectName}");

		LocalFile.Provisioning.clickTab(tabName = "Details");

		LocalFile.ProvisioningAccount.clickAddAddress(positionValue = 1);

		LocalFile.ProvisioningAccount.editAndSaveAccountAddressDetails(
			positionValue = 2,
			table = '''| Street 1       | Input         |        |
	| Country        | Select        | Canada |
	| City           | Input         |        |
	| State/Province | Select        | -      |
	| Postal Code    | Input         |        |
	| Primary        | Toggle Switch | false  |''');

		LocalFile.ProvisioningAccount._viewAccountDetailsViaDetailsTab(table = '''| Account Name        | Korpro - ${staticProjectName} |   |
	| State               | ACTIVE                        |   |
	| Code                | PROKORKORPRO                  |   |
	| Tier                | T4                            |   |
	| Parent              | Prokor - ${staticCompanyName} |	  |
