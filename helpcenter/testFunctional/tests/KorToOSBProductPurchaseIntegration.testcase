		KoroneikiAccountAPI._generateAccountId(accountName = "Korone - ${staticProjectName}");

		KoroneikiProductAPI._generateProductId(productName = "A Liferay OSB Product");

		KoroneikiProductAPI._renameFirstProductIdValue();

		KoroneikiProductAPI._generateProductId(productName = "A Liferay Server Product");

		KoroneikiProductAPI._renameSecondProductIdValue();

