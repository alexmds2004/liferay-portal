definition {

	property testray.main.component.name = "Support QA";
	property type = "osb.integration";

	setUp {
		Passwords.getPasswords();
	}

	tearDown {
		ZendeskHomepage.pause(timeInSeconds = 10);

		ZendeskUserAPI._getDefaultUserId(organizationName = "Korone - ${staticProjectName}");

		ZendeskUserAPI._renameFirstDefaultUserIdVariable();

		ZendeskUserAPI._getDefaultUserId(organizationName = "Kchild - ${staticProjectName}");

		ZendeskUserAPI._renameSecondDefaultUserIdVariable();

		ZendeskUserAPI._getDefaultUserId(organizationName = "Oneiki - ${staticProjectName}");

		ZendeskUserAPI._renameThirdDefaultUserIdVariable();

		ZendeskUserAPI._getDefaultUserId(organizationName = "Ochild - ${staticProjectName}");

		ZendeskUserAPI._renameFourthDefaultUserIdVariable();

		OSBAdminProject.tearDownProjects(table = '''| KCHILDKCHILD |
	| OCHILDOCHILD |
	| KORONEKORONE |
	| ONEIKIONEIKI |''');

		KoroneikiAccountAPI._tearDownAccounts(table = '''| Kchild - ${staticProjectName} |
	| Ochild - ${staticProjectName} |
	| Korone - ${staticProjectName} |
	| Oneiki - ${staticProjectName} |''');

		KoroneikiAccountAPI._tearDownAccountsViaAccountFieldNameAndValue(
			fieldName = "Code",
			table = '''| KCHILDKCHILD |
	| OCHILDOCHILD |
	| KORONEKORONE |
	| ONEIKIONEIKI |''');

		KoroneikiProductAPI._tearDownProducts(table = '''| A Liferay OSB Product    |
	| A Liferay Server Product |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		ZendeskOrganizationAPI._getMultipleOrganizationExternalIdsByOrganizationNameIfStillPresent(table = '''| Kchild - ${staticProjectName} |
	| Ochild - ${staticProjectName} |
	| Korone - ${staticProjectName} |
	| Oneiki - ${staticProjectName} |''');

		ZendeskOrganizationAPI._tearDownOrganizationsByExternalIdList(organizationExternalIds = ${staticOrganizationExternalIdList});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId1});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId2});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId3});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId4});
	}

	test Createandviewcancelledproductpurchase {
		OSBAdminRabbitMQ.generateProvisioningProjectName();

		KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORONEKORONE                         | |
	| Contact Email Address | osb.koroneiki1@lrcustomer.com.broken | |
	| Description           | Test osb account on koroneiki        | |
	| Fax Number            | 555-555-1234                         | |
	| Name                  | Korone - ${staticProjectName}        | |
	| Phone Number          | 555-555-5678                         | |
	| Profile Email Address | osb.koroneiki1@lrcustomer.com.broken | |
	| Region                | United States                        | |
	| Status                | Active                               | |
	| Tier                  | T4                                   | |
	| Website               | www.koroneikicorporation.com         | |''');

		KoroneikiProductAPI._createProduct(table = '''| Name | A Liferay OSB Product | |''');

		KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korone - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | true                     | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Cancelled                | |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korone - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | true                     | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Cancelled                | |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korone - ${staticProjectName}",
			productName = "A Liferay OSB Product",
			table = '''| End Date                | ${staticEndDate}         |                |
	| Original End Date       | ${staticOriginalEndDate} |                |
	| Perpetual               | true                     |                |
	| Product Field and Value | additionalProp1          | propertyValue1 |
	| Product Field and Value | additionalProp2          | propertyValue2 |
	| Product Field and Value | additionalProp3          | propertyValue3 |
	| Quantity                | 1                        |                |
	| Start Date              | ${staticStartDate}       |                |
	| Status                  | Cancelled                |                |''');

		OSBAdmin.loginToSupport(
			userEmailAddress = ${staticSupportAdminEmailAdress},
			userPassword = ${staticSupportAdminPassword});

		ProjectDetails.gotoProjectDetailsPage();

		ProjectDetails.searchKeyword(keyword = "Korone");

		ProjectDetails.viewProjectViaIndex(
			projectName = "Korone - ${staticProjectName}",
			projectState = "CANCELLED");

		ProjectDetails.gotoProject(projectName = "Korone - ${staticProjectName}");

		ProjectDetails.viewDetails(table = '''| Project Code    | KORONEKORONE   |
	| State           | CANCELLED      |
	| Level           | Not Applicable |
	| Support Region  | United States  |
	| Tier            | T4             |''');

		ProjectDetails.gotoHistory();

		KoroneikiAccountAPI._generateAccountId(accountName = "Korone - ${staticProjectName}");

		KoroneikiProductAPI._generateProductId(productName = "A Liferay OSB Product");

		ProjectDetails.viewHistoryEntryByKeywords(
			fieldName = "quantity",
			keyword1 = "Added Product Purchase",
			keyword2 = "A Liferay OSB Product",
			table = '''| Updater Name                | Koroneiki QA Service Producer |
	| Update Summary              | Added Product Purchase        |
	| Update Description          | A Liferay OSB Product         |
	| Update Date                 | Today                         |
	| Update Field Name           | quantity                      |
	| Update Field Original Value | N/A                           |
	| Update Field New Value      | 1                             |''');

		ProjectDetails.viewHistoryEntryByKeywords(
			fieldName = "accountId",
			keyword1 = "Added Product Purchase",
			keyword2 = "A Liferay OSB Product",
			table = '''| Updater Name                | Koroneiki QA Service Producer |
	| Update Summary              | Added Product Purchase        |
	| Update Description          | A Liferay OSB Product         |
	| Update Date                 | Today                         |
	| Update Field Name           | accountId                     |
	| Update Field Original Value | N/A                           |
	| Update Field New Value      | ${staticAccountId}            |''');

		ProjectDetails.viewHistoryEntryByKeywords(
			fieldName = "productEntryId",
			keyword1 = "Added Product Purchase",
			keyword2 = "A Liferay OSB Product",
			table = '''| Updater Name                | Koroneiki QA Service Producer |
	| Update Summary              | Added Product Purchase        |
	| Update Description          | A Liferay OSB Product         |
	| Update Date                 | Today                         |
	| Update Field Name           | productEntryId                |
	| Update Field Original Value | N/A                           |
	| Update Field New Value      | ${staticProductId}            |''');

		ProjectDetails.viewHistoryEntryByKeywords(
			fieldName = "additionalProp1",
			keyword1 = "Added Product Purchase",
			keyword2 = "A Liferay OSB Product",
			table = '''| Updater Name                | Koroneiki QA Service Producer |
	| Update Summary              | Added Product Purchase        |
	| Update Description          | A Liferay OSB Product         |
	| Update Date                 | Today                         |
	| Update Field Name           | additionalProp1               |
	| Update Field Original Value | N/A                           |
	| Update Field New Value      | propertyValue1                |''');

		ProjectDetails.viewHistoryEntryByKeywords(
			fieldName = "additionalProp2",
			keyword1 = "Added Product Purchase",
			keyword2 = "A Liferay OSB Product",
			table = '''| Updater Name                | Koroneiki QA Service Producer |
	| Update Summary              | Added Product Purchase        |
	| Update Description          | A Liferay OSB Product         |
	| Update Date                 | Today                         |
	| Update Field Name           | additionalProp2               |
	| Update Field Original Value | N/A                           |
	| Update Field New Value      | propertyValue2                |''');

		ProjectDetails.viewHistoryEntryByKeywords(
			fieldName = "additionalProp3",
			keyword1 = "Added Product Purchase",
			keyword2 = "A Liferay OSB Product",
			table = '''| Updater Name                | Koroneiki QA Service Producer |
	| Update Summary              | Added Product Purchase        |
	| Update Description          | A Liferay OSB Product         |
	| Update Date                 | Today                         |
	| Update Field Name           | additionalProp3               |
	| Update Field Original Value | N/A                           |
	| Update Field New Value      | propertyValue3                |''');

		ProjectDetails.viewHistoryEntryByKeywords(
			fieldName = "status",
			keyword1 = "Added Product Purchase",
			keyword2 = "A Liferay OSB Product",
			table = '''| Updater Name                | Koroneiki QA Service Producer |
	| Update Summary              | Added Product Purchase        |
	| Update Description          | A Liferay OSB Product         |
	| Update Date                 | Today                         |
	| Update Field Name           | status                        |
	| Update Field Original Value | N/A                           |
	| Update Field New Value      | 600                           |''');
	}

	test Createandviewfutureproductpurchase {
		OSBAdminRabbitMQ.generateProvisioningProjectName();

		KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORONEKORONE                         | |
	| Contact Email Address | osb.koroneiki1@lrcustomer.com.broken | |
	| Description           | Test osb account on koroneiki        | |
	| Fax Number            | 555-555-1234                         | |
	| Name                  | Korone - ${staticProjectName}        | |
	| Phone Number          | 555-555-5678                         | |
	| Profile Email Address | osb.koroneiki1@lrcustomer.com.broken | |
	| Region                | United States                        | |
	| Status                | Active                               | |
	| Tier                  | T4                                   | |
	| Website               | www.koroneikicorporation.com         | |''');

		KoroneikiProductAPI._createProduct(table = '''| Name | A Liferay OSB Product | |''');

		KoroneikiProductPurchaseAPI.generateStaticFutureStartAndEndDate();

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korone - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| End Date                | ${staticFutureEndDate}         | |
	| Original End Date       | ${staticFutureOriginalEndDate} | |
	| Perpetual               | false                          | |
	| Quantity                | 1                              | |
	| Start Date              | ${staticFutureStartDate}       | |
	| Status                  | Approved                       | |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korone - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticFutureEndDate}         | |
	| Original End Date       | ${staticFutureOriginalEndDate} | |
	| Perpetual               | false                          | |
	| Quantity                | 1                              | |
	| Start Date              | ${staticFutureStartDate}       | |
	| Status                  | Approved                       | |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korone - ${staticProjectName}",
			productName = "A Liferay OSB Product",
			table = '''| End Date                | ${staticFutureEndDate}         |                |
	| Original End Date       | ${staticFutureOriginalEndDate} |                |
	| Perpetual               | false                          |                |
	| Product Field and Value | additionalProp1                | propertyValue1 |
	| Product Field and Value | additionalProp2                | propertyValue2 |
	| Product Field and Value | additionalProp3                | propertyValue3 |
	| Quantity                | 1                              |                |
	| Start Date              | ${staticFutureStartDate}       |                |
	| Status                  | Approved                       |                |''');

		OSBAdmin.loginToSupport(
			userEmailAddress = ${staticSupportAdminEmailAdress},
			userPassword = ${staticSupportAdminPassword});

		ProjectDetails.gotoProjectDetailsPage();

		ProjectDetails.searchKeyword(keyword = "Korone");

		ProjectDetails.viewProjectViaIndex(
			projectName = "Korone - ${staticProjectName}",
			projectState = "UNACTIVATED");

		ProjectDetails.gotoProject(projectName = "Korone - ${staticProjectName}");

		ProjectDetails.viewDetails(table = '''| Project Code    | KORONEKORONE   |
	| State           | UNACTIVATED    |
	| Level           | Not Applicable |
	| Support Region  | United States  |
	| Tier            | T4             |''');

		ProjectDetails.gotoHistory();

		KoroneikiAccountAPI._generateAccountId(accountName = "Korone - ${staticProjectName}");

		KoroneikiProductAPI._generateProductId(productName = "A Liferay OSB Product");

		ProjectDetails.viewHistoryEntryByKeywords(
			fieldName = "quantity",
			keyword1 = "Added Product Purchase",
			keyword2 = "A Liferay OSB Product",
			table = '''| Updater Name                | Koroneiki QA Service Producer |
	| Update Summary              | Added Product Purchase        |
	| Update Description          | A Liferay OSB Product         |
	| Update Date                 | Today                         |
	| Update Field Name           | quantity                      |
	| Update Field Original Value | N/A                           |
	| Update Field New Value      | 1                             |''');

		ProjectDetails.viewHistoryEntryByKeywords(
			fieldName = "accountId",
			keyword1 = "Added Product Purchase",
			keyword2 = "A Liferay OSB Product",
			table = '''| Updater Name                | Koroneiki QA Service Producer |
	| Update Summary              | Added Product Purchase        |
	| Update Description          | A Liferay OSB Product         |
	| Update Date                 | Today                         |
	| Update Field Name           | accountId                     |
	| Update Field Original Value | N/A                           |
	| Update Field New Value      | ${staticAccountId}            |''');

		ProjectDetails.viewHistoryEntryByKeywords(
			fieldName = "productEntryId",
			keyword1 = "Added Product Purchase",
			keyword2 = "A Liferay OSB Product",
			table = '''| Updater Name                | Koroneiki QA Service Producer |
	| Update Summary              | Added Product Purchase        |
	| Update Description          | A Liferay OSB Product         |
	| Update Date                 | Today                         |
	| Update Field Name           | productEntryId                |
	| Update Field Original Value | N/A                           |
	| Update Field New Value      | ${staticProductId}            |''');

		ProjectDetails.viewHistoryEntryByKeywords(
			fieldName = "additionalProp1",
			keyword1 = "Added Product Purchase",
			keyword2 = "A Liferay OSB Product",
			table = '''| Updater Name                | Koroneiki QA Service Producer |
	| Update Summary              | Added Product Purchase        |
	| Update Description          | A Liferay OSB Product         |
	| Update Date                 | Today                         |
	| Update Field Name           | additionalProp1               |
	| Update Field Original Value | N/A                           |
	| Update Field New Value      | propertyValue1                |''');

		ProjectDetails.viewHistoryEntryByKeywords(
			fieldName = "additionalProp2",
			keyword1 = "Added Product Purchase",
			keyword2 = "A Liferay OSB Product",
			table = '''| Updater Name                | Koroneiki QA Service Producer |
	| Update Summary              | Added Product Purchase        |
	| Update Description          | A Liferay OSB Product         |
	| Update Date                 | Today                         |
	| Update Field Name           | additionalProp2               |
	| Update Field Original Value | N/A                           |
	| Update Field New Value      | propertyValue2                |''');

		ProjectDetails.viewHistoryEntryByKeywords(
			fieldName = "additionalProp3",
			keyword1 = "Added Product Purchase",
			keyword2 = "A Liferay OSB Product",
			table = '''| Updater Name                | Koroneiki QA Service Producer |
	| Update Summary              | Added Product Purchase        |
	| Update Description          | A Liferay OSB Product         |
	| Update Date                 | Today                         |
	| Update Field Name           | additionalProp3               |
	| Update Field Original Value | N/A                           |
	| Update Field New Value      | propertyValue3                |''');

		ProjectDetails.viewHistoryEntryByKeywords(
			fieldName = "status",
			keyword1 = "Added Product Purchase",
			keyword2 = "A Liferay OSB Product",
			table = '''| Updater Name                | Koroneiki QA Service Producer |
	| Update Summary              | Added Product Purchase        |
	| Update Description          | A Liferay OSB Product         |
	| Update Date                 | Today                         |
	| Update Field Name           | status                        |
	| Update Field Original Value | N/A                           |
	| Update Field New Value      | 0                             |''');
	}

	test Createandviewmultipleproductpurchases {
		OSBAdminRabbitMQ.generateProvisioningProjectName();

		KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORONEKORONE                         | |
	| Contact Email Address | osb.koroneiki1@lrcustomer.com.broken | |
	| Description           | Test osb account on koroneiki        | |
	| Fax Number            | 555-555-1234                         | |
	| Name                  | Korone - ${staticProjectName}        | |
	| Phone Number          | 555-555-5678                         | |
	| Profile Email Address | osb.koroneiki1@lrcustomer.com.broken | |
	| Region                | United States                        | |
	| Status                | Active                               | |
	| Tier                  | T4                                   | |
	| Website               | www.koroneikicorporation.com         | |''');

		KoroneikiProductAPI._createProduct(table = '''| Name | A Liferay OSB Product | |''');

		KoroneikiProductAPI._createProduct(table = '''| Name | A Liferay Server Product | |''');

		KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korone - ${staticProjectName}",
			productName = "DXP Production",
