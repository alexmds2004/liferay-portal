definition {

	property testray.main.component.name = "Support QA";
	property type = "customer.portal";

	setUp {
		LocalFile.Passwords.getPasswords();

		LocalFile.OSBAdmin.loginToSupport(
			userEmailAddress = ${staticSupportAdminEmailAdress},
			userPassword = ${staticSupportAdminPassword});

		LocalFile.ReleaseNotes.gotoDXPReleaseNotes();
	}

	test RefineChangelogMultiplePageSearchResults {
		LocalFile.ReleaseNotes.setSearchFilters(
			fixPackName1 = "Fix Pack 71",
			fixPackName2 = "Fix Pack 76",
			productName = "DXP 7.0");

		LocalFile.ReleaseNotes.gotoChangelog();

		LocalFile.ReleaseNotes.refineFilters(table = '''| Application Security | true |''');

		LocalFile.ReleaseNotes.viewResultsCount(resultsCount = 9);

		LocalFile.ReleaseNotes.viewChangelogEntryText(
			summary = "Multiple LDAP System Settings entries",
			table = '''| Summary   | Multiple LDAP System Settings entries                               |
	| Component | Application Security > LDAP, Portal Configuration > System Settings |
	| Release   | Fix Pack 76                                                         |
	| Key       | LPS-88275                                                           |''');

		LocalFile.ReleaseNotes.viewChangelogEntryText(
			summary = "Security vulnerabilities in Google Guava",
			table = '''| Summary   | Security vulnerabilities in Google Guava |
	| Component | Application Security > Google Login      |
	| Release   | Fix Pack 73                              |
	| Key       | LPE-16664                                |''');

		LocalFile.ReleaseNotes.viewChangelogEntryText(
			summary = "Empty Attributes in LDAP request can cause it to be rejected",
			table = '''| Summary   | Empty Attributes in LDAP request can cause it to be rejected |
	| Component | Application Security > LDAP	                          	   |
	| Release   | Fix Pack 73                                                  |
	| Key       | LPS-89295                                                    |''');

		LocalFile.ReleaseNotes.viewChangelogEntryText(
			summary = "Security vulnerabilities in Google Guava",
			table = '''| Summary   | Security vulnerabilities in Google Guava |
	| Component | Application Security > Google Login      |
	| Release   | Fix Pack 73	                           |
	| Key       | LPE-16664                                |''');

		LocalFile.ReleaseNotes.clearAllRefinements();

		LocalFile.ReleaseNotes.viewResultsCount(resultsCount = 129);

		LocalFile.ReleaseNotes.refineFilters(table = '''| Contains Text | Security Vulnerabilities |''');

		LocalFile.ReleaseNotes.viewResultsCount(resultsCount = 8);

		LocalFile.ReleaseNotes.viewChangelogEntryText(
			summary = "Security vulnerabilities in Apache PDFBox",
			table = '''| Summary   | Security vulnerabilities in Apache PDFBox |
	| Component | DM, Security Vulnerability	            |
	| Release   | Fix Pack 75                               |
	| Key       | LPE-16681                                 |''');

		LocalFile.ReleaseNotes.viewChangelogEntryText(
			summary = "Security vulnerabilities in Apache Batik",
			table = '''| Summary   | Security vulnerabilities in Apache Batik                |
	| Component | Application Security > AntiSamy, Security Vulnerability |
	| Release   | Fix Pack 75                                             |
	| Key       | LPE-16680                                               |''');

		LocalFile.ReleaseNotes.viewChangelogEntryText(
			summary = "Security vulnerabilities in Spring core",
			table = '''| Summary   | Security vulnerabilities in Spring core     |
	| Component | Core Infrastructure, Security Vulnerability |
	| Release   | Fix Pack 75                                 |
	| Key       | LPE-16659                                   |''');

		LocalFile.ReleaseNotes.viewChangelogEntryText(
			summary = "Security vulnerabilities in Netty",
			table = '''| Summary   | Security vulnerabilities in Netty           |
	| Component | Core Infrastructure, Security Vulnerability |
	| Release   | Fix Pack 73                                 |
	| Key       | LPE-16660                                   |''');

		LocalFile.ReleaseNotes.viewChangelogEntryText(
			summary = "Security vulnerabilities in Apache Tika",
			table = '''| Summary   | Security vulnerabilities in Apache Tika |
	| Component | DM, Security Vulnerability              |
	| Release   | Fix Pack 72                             |
	| Key       | LPE-16653                               |''');

		LocalFile.ReleaseNotes.clearAllRefinements();

		LocalFile.ReleaseNotes.viewResultsCount(resultsCount = 129);

		LocalFile.ReleaseNotes.refineFilters(table = '''| Contains Text          | Apache PDFBox |
	| Document Management    | true          |
	| Security Vulnerability | true          |''');

		LocalFile.ReleaseNotes.viewResultsCount(resultsCount = 1);

		LocalFile.ReleaseNotes.viewChangelogEntryText(
			summary = "Security vulnerabilities in Apache PDFBox",
			table = '''| Summary   | Security vulnerabilities in Apache PDFBox |
	| Component | DM, Security Vulnerability	            |
	| Release   | Fix Pack 75                               |
	| Key       | LPE-16681                                 |''');

		LocalFile.ReleaseNotes.clearAllRefinements();

		LocalFile.ReleaseNotes.viewResultsCount(resultsCount = 129);

		LocalFile.ReleaseNotes.viewResultsCurrentPageNumber(pageNumber = 1);

		LocalFile.ReleaseNotes.viewChangelogEntryText(
			summary = "Error Message after the session expires is not translated",
			table = '''| Summary   | Error Message after the session expires is not translated |
	| Component | Portal Services, Portal Services > Localization           |
	| Release   | Fix Pack 76                                               |
	| Key       | LPS-86172                                                 |''');

		LocalFile.ReleaseNotes.viewChangelogEntryText(
			summary = "Security vulnerabilities in Spring core",
			table = '''| Summary   | Security vulnerabilities in Spring core     |
	| Component | Core Infrastructure, Security Vulnerability |
	| Release   | Fix Pack 75                                 |
	| Key       | LPE-16659                                   |''');

		LocalFile.ReleaseNotes.gotoResultsNextPage();

		LocalFile.ReleaseNotes.viewResultsCurrentPageNumber(pageNumber = 2);

		LocalFile.ReleaseNotes.viewChangelogEntryText(
			summary = "JS error when selecting pagination limit",
			table = '''| Summary   | JS error when selecting pagination limit |
	| Component | Frontend Infrastructure             	   |
	| Release   | Fix Pack 73                              |
	| Key       | LPS-89876                                |''');

		LocalFile.ReleaseNotes.viewChangelogEntryText(
			summary = "Same scheduler job may be executed in two threads at the same time",
			table = '''| Summary   | Same scheduler job may be executed in two threads at the same time |
	| Component | Portal Services > Scheduler	                  	                 |
	| Release   | Fix Pack 73                                                        |
	| Key       | LPS-89033                                                          |''');

		LocalFile.ReleaseNotes.gotoResultsNextPage();

		LocalFile.ReleaseNotes.viewResultsCurrentPageNumber(pageNumber = 3);

		LocalFile.ReleaseNotes.viewChangelogEntryText(
			summary = "Metadata value is missing after uploading multiple documents",
			table = '''| Summary   | Metadata value is missing after uploading multiple documents |
	| Component | Dynamic Data Mapping	                                       |
	| Release   | Fix Pack 71                                                  |
	| Key       | LPS-83714                                                    |''');

		LocalFile.ReleaseNotes.viewChangelogEntryText(
			summary = "StagedAuditedModel is not found when using service builder",
			table = '''| Summary   | StagedAuditedModel is not found when using service builder |
	| Component | Core Infrastructure > Service Builder	        	         |
	| Release   | Fix Pack 71                                                |
	| Key       | LPS-89567                                                  |''');
	}

	test RefineChangelogSinglePageSearchResults {
		LocalFile.ReleaseNotes.setSearchFilters(
			fixPackName1 = "Fix Pack 75",
			fixPackName2 = "Fix Pack 76",
