			fixPackName1 = "Fix Pack 71",
			fixPackName2 = "Fix Pack 76",
			productName = "DXP 7.0");

		LocalFile.ReleaseNotes.gotoChangelog();

		LocalFile.ReleaseNotes.clickChangelogEntry(summary = "Error Message after the session expires is not translated");

		LocalFile.ReleaseNotes.viewChangelogEntryDetails(summary = "Error Message after the session expires is not translated");

		LocalFile.ReleaseNotes.closeChangelogDetails();

		LocalFile.ReleaseNotes.clickChangelogEntry(summary = "Security vulnerabilities in Spring core");

		LocalFile.ReleaseNotes.viewChangelogEntryDetails(summary = "Security vulnerabilities in Spring core");

		LocalFile.ReleaseNotes.closeChangelogDetails();

		LocalFile.ReleaseNotes.gotoResultsNextPage();

		LocalFile.ReleaseNotes.clickChangelogEntry(summary = "JS error when selecting pagination limit");

		LocalFile.ReleaseNotes.viewChangelogEntryDetails(summary = "JS error when selecting pagination limit");

		LocalFile.ReleaseNotes.closeChangelogDetails();

