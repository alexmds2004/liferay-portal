definition {

	property testray.main.component.name = "Support QA";
	property type = "customer.portal";

	setUp {
		Passwords.getPasswords();

		OSBAdmin.loginToSupport(
			userEmailAddress = ${staticSupportAdminEmailAdress},
			userPassword = ${staticSupportAdminPassword});

		ReleaseNotes.gotoDXPReleaseNotes();
	}

	test RefineChangelogMultiplePageSearchResults {
		ReleaseNotes.setSearchFilters(
			fixPackName1 = "Fix Pack 71",
			fixPackName2 = "Fix Pack 76",
			productName = "DXP 7.0");

		ReleaseNotes.gotoChangelog();

		ReleaseNotes.refineFilters(table = '''| Application Security | true |''');

		ReleaseNotes.viewResultsCount(resultsCount = 2);

		ReleaseNotes.viewChangelogEntryText(
			summary = "*hosts.allowed should be cloud friendlier and allow ranges",
			table = '''
				| Summary   | *hosts.allowed should be cloud friendlier and allow ranges |
				| Component | Application Security                                       |
				| Release   | Fix Pack 76                                                |
				| Key       | LPS-90155                                                  |
			''');

		ReleaseNotes.viewChangelogEntryText(
			summary = "Security vulnerabilities in Apache HttpClient",
			table = '''
					| Summary   | Security vulnerabilities in Apache HttpClient |
					| Component | Application Security, Security Vulnerability  |
					| Release   | Fix Pack 75                                   |
					| Key       | LPE-16677                                     |
			''');

		ReleaseNotes.clearAllRefinements();

		ReleaseNotes.viewResultsCount(resultsCount = 35);

		ReleaseNotes.refineFilters(table = '''| Contains Text | Security Vulnerabilities |''');

		ReleaseNotes.viewResultsCount(resultsCount = 8);

		ReleaseNotes.viewChangelogEntryText(
			summary = "Security vulnerabilities in Apache PDFBox",
			table = '''
					| Summary   |Security vulnerabilities in Apache PDFBox |
					| Component | DM, Security Vulnerability               |
					| Release   | Fix Pack 75                              |
					| Key       | LPE-16681                                |
				''');

		ReleaseNotes.viewChangelogEntryText(
			summary = "Security vulnerabilities in Apache HttpClient",
			table = '''
				| Summary   | Security vulnerabilities in Apache HttpClient |
				| Component | Application Security, Security Vulnerability  |
				| Release   | Fix Pack 75                                   |
				| Key       | LPE-16677                                     |
				''');

		ReleaseNotes.viewChangelogEntryText(
			summary = "Security vulnerabilities in JCraft JSch",
			table = '''
				| Summary   | Security vulnerabilities in JCraft JSch       |
				| Component | Core Infrastructure, Security Vulnerability   |
				| Release   | Fix Pack 75                                   |
				| Key       | LPE-16670                                     |
			''');

		ReleaseNotes.clearAllRefinements();

		ReleaseNotes.viewResultsCount(resultsCount = 35);

		ReleaseNotes.refineFilters(
			table = '''
				| Contains Text          | Apache PDFBox |
				| Security Vulnerability | true          |
			''');

		ReleaseNotes.viewResultsCount(resultsCount = 1);

		ReleaseNotes.viewChangelogEntryText(
			summary = "Security vulnerabilities in Apache PDFBox",
			table = '''
					| Summary   | Security vulnerabilities in Apache PDFBox |
					| Component | DM, Security Vulnerability	            |
					| Release   | Fix Pack 75                               |
					| Key       | LPE-16681                                 |
				''');

		ReleaseNotes.clearAllRefinements();

		ReleaseNotes.viewResultsCount(resultsCount = 35);

		ReleaseNotes.viewResultsCurrentPageNumber(pageNumber = 1);

		ReleaseNotes.viewChangelogEntryText(
			summary = "REST Builder generated files should not depend on OAuth at runtime",
			table = '''
					| Summary   | REST Builder generated files should not depend on OAuth at runtime |
					| Component | Core Infrastructure > Service Builder                              |
					| Release   | Fix Pack 76                                                        |
					| Key       | LPS-91463                                                          |
				''');

		ReleaseNotes.viewChangelogEntryText(
			summary = "Security vulnerabilities in Spring core",
			table = '''
					| Summary   | Security vulnerabilities in Spring core     |
					| Component | Core Infrastructure, Security Vulnerability |
					| Release   | Fix Pack 75                                 |
					| Key       | LPE-16659                                   |
				''');
	}

	test RefineChangelogSinglePageSearchResults {
		ReleaseNotes.setSearchFilters(
			fixPackName1 = "Fix Pack 75",
			fixPackName2 = "Fix Pack 76",
			productName = "DXP 7.0");

		ReleaseNotes.gotoChangelog();

		ReleaseNotes.refineFilters(table = '''| Application Security | true |''');

		ReleaseNotes.viewResultsCount(resultsCount = 2);

		ReleaseNotes.viewChangelogEntryText(
			summary = "*hosts.allowed should be cloud friendlier and allow ranges",
			table = '''
				| Summary   | *hosts.allowed should be cloud friendlier and allow ranges |
				| Component | Application Security                                       |
				| Release   | Fix Pack 76                                                |
				| Key       | LPS-90155                                                  |
			''');

		ReleaseNotes.viewChangelogEntryText(
			summary = "Security vulnerabilities in Apache HttpClient",
			table = '''
					| Summary   | Security vulnerabilities in Apache HttpClient |
					| Component | Application Security, Security Vulnerability  |
					| Release   | Fix Pack 75                                   |
					| Key       | LPE-16677                                     |
			''');


		ReleaseNotes.clearAllRefinements();

		ReleaseNotes.viewResultsCount(resultsCount = 20);

		ReleaseNotes.refineFilters(table = '''| Contains Text | Security Vulnerabilities |''');

		ReleaseNotes.viewResultsCount(resultsCount = 5);

		ReleaseNotes.viewChangelogEntryText(
			summary = "Security vulnerabilities in Apache PDFBox",
			table = '''| Summary   | Security vulnerabilities in Apache PDFBox |
	| Component | DM, Security Vulnerability	            |
	| Release   | Fix Pack 75                               |
	| Key       | LPE-16681                                 |''');

		ReleaseNotes.viewChangelogEntryText(
			summary = "Security vulnerabilities in Apache Batik",
			table = '''| Summary   | Security vulnerabilities in Apache Batik                |
	| Component | Application Security > AntiSamy, Security Vulnerability |
	| Release   | Fix Pack 75                                             |
	| Key       | LPE-16680                                               |''');

		ReleaseNotes.viewChangelogEntryText(
			summary = "Security vulnerabilities in Spring core",
			table = '''| Summary   | Security vulnerabilities in Spring core     |
	| Component | Core Infrastructure, Security Vulnerability |
	| Release   | Fix Pack 75                                 |
	| Key       | LPE-16659                                   |''');

		ReleaseNotes.viewChangelogEntryText(
			summary = "Security vulnerabilities in Apache HttpClient",
			table = '''| Summary   | Security vulnerabilities in Apache HttpClient |
	| Component | Application Security, Security Vulnerability	|
	| Release   | Fix Pack 75                                   |
	| Key       | LPE-16677                                     |''');

		ReleaseNotes.viewChangelogEntryText(
			summary = "Security vulnerabilities in JCraft JSch",
			table = '''| Summary   | Security vulnerabilities in JCraft JSch     |
	| Component | Core Infrastructure, Security Vulnerability |
	| Release   | Fix Pack 75                                 |
	| Key       | LPE-16670                                   |''');

		ReleaseNotes.clearAllRefinements();

		ReleaseNotes.viewResultsCount(resultsCount = 20);

		ReleaseNotes.refineFilters(
			table = '''
				| Contains Text          | Apache PDFBox |
				| Security Vulnerability | true          |
			''');

		ReleaseNotes.viewResultsCount(resultsCount = 1);

		ReleaseNotes.viewChangelogEntryText(
			summary = "Security vulnerabilities in Apache PDFBox",
			table = '''
				| Summary   | Security vulnerabilities in Apache PDFBox |
				| Component | DM, Security Vulnerability	            |
				| Release   | Fix Pack 75                               |
				| Key       | LPE-16681                                 |
			''');

		ReleaseNotes.clearAllRefinements();

		ReleaseNotes.viewResultsCount(resultsCount = 20);

		ReleaseNotes.viewChangelogEntryText(
			summary = "D&M Description not aligned for Like & Thumbs ratings",
			table = '''
				| Summary   | D&M Description not aligned for Like & Thumbs ratings     |
				| Component | Documents & Media                                         |
				| Release   | Fix Pack 76                                               |
				| Key       | LPS-90963                                                 |
			''');

		ReleaseNotes.viewChangelogEntryText(
			summary = "Reflected XSS in WAIPortlet",
			table = '''
				| Summary   | Reflected XSS in WAIPortlet                                |
				| Component | Accessibility, Core Infrastructure, Security Vulnerability |
				| Release   | Fix Pack 76                                                |
				| Key       | LPE-16691                                                  |
			''');

		ReleaseNotes.viewChangelogEntryText(
			summary = "Merge Public Pages results in wrong Navigation Menu",
			table = '''
				| Summary   | Merge Public Pages results in wrong Navigation Menu |
				| Component | Navigation Menus	                                  |
				| Release   | Fix Pack 76                                         |
				| Key       | LPS-90571                                           |
			''');

		ReleaseNotes.viewChangelogEntryText(
			summary = "Security vulnerabilities in Spring core",
			table = '''
				| Summary   | Security vulnerabilities in Spring core     |
				| Component | Core Infrastructure, Security Vulnerability |
				| Release   | Fix Pack 75                                 |
				| Key       | LPE-16659                                   |
			''');

		ReleaseNotes.viewChangelogEntryText(
			summary = "AlloyEditor source button fails on Firefox and safari for Mac OS",
			table = '''
				| Summary   | AlloyEditor source button fails on Firefox and safari for Mac OS |
				| Component | Alloy Editor                                                     |
				| Release   | Fix Pack 75                                                      |
				| Key       | LPS-90239                                                        |
			''');
	}

