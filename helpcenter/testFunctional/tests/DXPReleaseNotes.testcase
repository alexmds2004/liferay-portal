	| Key       | LPE-16670                                   |''');

		LocalFile.ReleaseNotes.clearAllRefinements();

		LocalFile.ReleaseNotes.viewResultsCount(resultsCount = 43);

		LocalFile.ReleaseNotes.refineFilters(table = '''| Contains Text          | Apache PDFBox |
	| Document Management    | true          |
	| Security Vulnerability | true          |''');

		LocalFile.ReleaseNotes.viewResultsCount(resultsCount = 1);

		LocalFile.ReleaseNotes.viewChangelogEntryText(
			summary = "Security vulnerabilities in Apache PDFBox",
			table = '''| Summary   | Security vulnerabilities in Apache PDFBox |
	| Component | DM, Security Vulnerability	            |
	| Release   | Fix Pack 75                               |
	| Key       | LPE-16681                                 |''');

		LocalFile.ReleaseNotes.clearAllRefinements();

		LocalFile.ReleaseNotes.viewResultsCount(resultsCount = 43);

		LocalFile.ReleaseNotes.viewChangelogEntryText(
			summary = "Error Message after the session expires is not translated",
			table = '''| Summary   | Error Message after the session expires is not translated |
	| Component | Portal Services, Portal Services > Localization           |
	| Release   | Fix Pack 76                                               |
	| Key       | LPS-86172                                                 |''');

		LocalFile.ReleaseNotes.viewChangelogEntryText(
			summary = "Reflected XSS in WAIPortlet",
			table = '''| Summary   | Reflected XSS in WAIPortlet                                |
	| Component | Accessibility, Core Infrastructure, Security Vulnerability |
	| Release   | Fix Pack 76                                                |
	| Key       | LPE-16691                                                  |''');

		LocalFile.ReleaseNotes.viewChangelogEntryText(
			summary = "Merge Public Pages results in wrong Navigation Menu",
			table = '''| Summary   | Merge Public Pages results in wrong Navigation Menu |
	| Component | Navigation Menus	                                  |
	| Release   | Fix Pack 76                                         |
	| Key       | LPS-90571                                           |''');

		LocalFile.ReleaseNotes.viewChangelogEntryText(
			summary = "Security vulnerabilities in Spring core",
			table = '''| Summary   | Security vulnerabilities in Spring core     |
	| Component | Core Infrastructure, Security Vulnerability |
	| Release   | Fix Pack 75                                 |
	| Key       | LPE-16659                                   |''');

		LocalFile.ReleaseNotes.viewChangelogEntryText(
			summary = "AlloyEditor source button fails on Firefox and safari for Mac OS",
			table = '''| Summary   | AlloyEditor source button fails on Firefox and safari for Mac OS |
	| Component | Alloy Editor                                                     |
	| Release   | Fix Pack 75                                                      |
	| Key       | LPS-90239                                                        |''');

		LocalFile.ReleaseNotes.viewChangelogEntryText(
			summary = "Can not create a Data Provider if the default language is set to Spanish",
			table = '''| Summary   | Can not create a Data Provider if the default language is set to Spanish |
	| Component | Forms                                                                    |
	| Release   | Fix Pack 75                                                              |
	| Key       | LPS-76813                                                                |''');
	}

