	test RefineModuleChangeSearchResults {
		ReleaseNotes.setSearchFilters(
			fixPackName1 = "Fix Pack 74",
			fixPackName2 = "Fix Pack 76",
			productName = "DXP 7.0");

		ReleaseNotes.gotoModuleChanges();

		ReleaseNotes.refineFilters(table = '''| Liferay Artifacts     | true  |
	| Third Party Libraries | false |
	| Only Show Changes     | false |''');

		ReleaseNotes.viewResultsCount(resultsCount = 716);

		ReleaseNotes.viewNoModuleChange(name = "antlr");

		ReleaseNotes.viewModuleChangeText(
			name = "com.liferay.adaptive.media.api",
			table = '''| Name          | com.liferay.adaptive.media.api |
	| Group         | com.liferay	                 |
	| Fix Pack From | 2.0.3                          |
	| Fix Pack To   | 2.0.3                          |
	| Change        | false                          |''');

		ReleaseNotes.viewModuleChangeText(
			name = "com.liferay.adaptive.media.document.library",
			table = '''| Name          | com.liferay.adaptive.media.document.library |
	| Group         | com.liferay	                              |
	| Fix Pack From | 1.0.7                                       |
	| Fix Pack To   | 1.0.9                                       |
	| Change        | true                                        |''');

		ReleaseNotes.viewModuleChangeText(
			name = "com.liferay.support.tomcat",
			table = '''| Name          | com.liferay.support.tomcat |
	| Group         | com.liferay.portal	     |
	| Fix Pack From | 1.0.3                      |
	| Fix Pack To   | 1.0.3                      |
	| Change        | false                      |''');

		ReleaseNotes.viewModuleChangeText(
			name = "com.liferay.util.java",
			table = '''| Name          | com.liferay.util.java |
	| Group         | com.liferay.portal    |
	| Fix Pack From | 2.5.22                |
	| Fix Pack To   | 2.5.23                |
	| Change        | true                  |''');

		ReleaseNotes.viewNoModuleChange(name = "spring-aop");

		ReleaseNotes.clearAllRefinements();

		ReleaseNotes.refineFilters(table = '''| Liferay Artifacts     | true  |
	| Third Party Libraries | false |
