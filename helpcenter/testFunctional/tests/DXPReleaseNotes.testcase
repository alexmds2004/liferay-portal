		LocalFile.ReleaseNotes.viewChangelogEntryText(
			summary = "Security vulnerabilities in Apache HttpClient",
			table = '''| Summary   | Security vulnerabilities in Apache HttpClient |
	| Component | Application Security, Security Vulnerability	|
	| Release   | Fix Pack 75                                   |
	| Key       | LPE-16677                                     |''');

		LocalFile.ReleaseNotes.viewChangelogEntryText(
			summary = "Security vulnerabilities in JCraft JSch",
			table = '''| Summary   | Security vulnerabilities in JCraft JSch     |
	| Component | Core Infrastructure, Security Vulnerability |
