		LocalFile.ZendeskTicket.gotoViaId(ticketId = ${staticRequestIdList});

		LocalFile.ZendeskKCApp.clickAppsbutton();

		LocalFile.ZendeskKCApp.viewArticle(
			articleDescription = "A simple Fast article description",
			articleName = "A simple Fast article");
	}

	test Createdraftarticle {
		LocalFile.ZendeskOrganizationAPI._createOrganization(table = '''| Status           | Approved            |
	| Name             | Frontend Org Name 1 |
	| Shared Tickets   | true                |
	| Shared Comments  | true                |
	| SLA              | Gold                |
	| Tier             | T4                  |
	| Support Region   | US                  |
	| Support Language | English             |
	| External ID      | 12341234            |''');

		LocalFile.ZendeskOrganizationAPI._assignTagsToOrganizationViaOrganizationExternalID(
			organizationExternalId = 12341234,
			table = '''| liferay_dxp |''');

		LocalFile.ZendeskUserAPI._createUser(table = '''| Name             | Zendesk Enduser1                    |
	| Tags             | osb_customer,osb_kb                 |
	| Password         | ${staticZendeskAdminPassword}       |
	| Role             | End-user                            |
	| Access           | Organization                        |
	| Email            | zendesk.enduser1@zendesk.com.broken |
	| Phone Number     | +1 (555) 555-5555                   |
	| Organization     | Frontend Org Name 1                 |
	| Language         | English                             |
	| Time Zone        | Pacific Time (US & Canada)          |
	| External ID      | Enduser1                            |''');

		LocalFile.ZendeskRequestAPI._createRequest(
			requesterEmail = "zendesk.enduser1@zendesk.com.broken",
			table = '''| Product                  | prd_liferay_dxp_7_4                              |
	| Component                | activation_key_project_administration            |
	| Tags                     | knowledge_capture_flagged_article                |
	| System Status            | production_functioning_with_limited_capabilities |
	| Subject                  | Request Subject                                  |
	| Description              | Request Description                              |
	| Organization External ID | 12341234                                         |''');

		LocalFile.ZendeskTicketAPI._viewMultipleTicketGroupAssignees(
			groupAssignee = "Self Service",
			ticketIdList = ${staticRequestIdList});

		LocalFile.ZendeskHomepage.login(
			userEmailAddress = "zendesk.admin@liferay.com.broken",
			userPassword = ${staticZendeskAdminPassword});

		LocalFile.ZendeskKCApp.createFastTrackArticle(table = '''| Ticket ID     | ${staticRequestIdList}            |
	| Template      | Fast Track Article                |
	| Name          | A simple Fast article             |
	| Description   | A simple Fast article description |
	| Review Status | Draft                             |''');

		LocalFile.ZendeskKCApp.checkArticleReviewStatus(
			articleName = "A simple Fast article",
			reviewStatus = "Draft");

		LocalFile.ZendeskHomepage.login(
			userEmailAddress = "zendesk.admin@liferay.com.broken",
			userPassword = ${staticZendeskAdminPassword});

		LocalFile.ZendeskTicket.gotoViaId(ticketId = ${staticRequestIdList});

		LocalFile.ZendeskKCApp.clickAppsbutton();

		LocalFile.ZendeskKCApp.viewNoArticle(articleName = "A simple Fast article");
	}

	test Editandviewarticle {
		LocalFile.ZendeskOrganizationAPI._createOrganization(table = '''| Status           | Approved            |
	| Name             | Frontend Org Name 1 |
	| Shared Tickets   | true                |
	| Shared Comments  | true                |
	| SLA              | Gold                |
	| Tier             | T4                  |
	| Support Region   | US                  |
	| Support Language | English             |
	| External ID      | 12341234            |''');

		LocalFile.ZendeskOrganizationAPI._assignTagsToOrganizationViaOrganizationExternalID(
			organizationExternalId = 12341234,
			table = '''| liferay_dxp |''');

		LocalFile.ZendeskUserAPI._createUser(table = '''| Name             | Zendesk Enduser1                    |
	| Tags             | osb_customer,osb_kb                 |
	| Password         | ${staticZendeskAdminPassword}       |
	| Role             | End-user                            |
	| Access           | Organization                        |
	| Email            | zendesk.enduser1@zendesk.com.broken |
	| Phone Number     | +1 (555) 555-5555                   |
	| Organization     | Frontend Org Name 1                 |
	| Language         | English                             |
	| Time Zone        | Pacific Time (US & Canada)          |
	| External ID      | Enduser1                            |''');

		LocalFile.ZendeskRequestAPI._createRequest(
			requesterEmail = "zendesk.enduser1@zendesk.com.broken",
			table = '''| Product                  | prd_liferay_dxp_7_4                              |
	| Component                | activation_key_project_administration            |
	| Tags                     | knowledge_capture_flagged_article                |
	| System Status            | production_functioning_with_limited_capabilities |
	| Subject                  | Request Subject                                  |
	| Description              | Request Description                              |
	| Organization External ID | 12341234                                         |''');

		LocalFile.ZendeskTicketAPI._viewMultipleTicketGroupAssignees(
			groupAssignee = "Self Service",
			ticketIdList = ${staticRequestIdList});

		LocalFile.ZendeskHomepage.login(
			userEmailAddress = "zendesk.admin@liferay.com.broken",
			userPassword = ${staticZendeskAdminPassword});

		LocalFile.ZendeskKCApp.createFastTrackArticle(table = '''| Ticket ID     | ${staticRequestIdList}            |
	| Template      | DXPC Fast Track Article           |
	| Name          | A simple DXPC article             |
	| Description   | A simple DXPC article description |
	| Review Status | Published                         |''');

		LocalFile.ZendeskHomepage.login(
			userEmailAddress = "zendesk.admin@liferay.com.broken",
			userPassword = ${staticZendeskAdminPassword});

		LocalFile.ZendeskTicket.gotoViaId(ticketId = ${staticRequestIdList});

		LocalFile.ZendeskKCApp.clickAppsbutton();

		LocalFile.ZendeskKCApp.viewArticle(
			articleDescription = "A simple DXPC article description",
			articleName = "A simple DXPC article");

		LocalFile.ZendeskKCApp.editArticle(table = '''| Article Name               | A simple DXPC article           |
	| Article Name Update        | A different article             |
	| Article Description Update | A different article description |
	| Review Status              | Published                       |
	| Review Status Update       | Published                       |''');

		LocalFile.ZendeskHomepage.login(
			userEmailAddress = "zendesk.admin@liferay.com.broken",
			userPassword = ${staticZendeskAdminPassword});

		LocalFile.ZendeskTicket.gotoViaId(ticketId = ${staticRequestIdList});

		LocalFile.ZendeskKCApp.clickAppsbutton();

		LocalFile.ZendeskKCApp.viewArticle(
			articleDescription = "A different article description",
			articleName = "A different article");

		LocalFile.ZendeskHomepage.login(
			userEmailAddress = "zendesk.admin@liferay.com.broken",
			userPassword = ${staticZendeskAdminPassword});

		LocalFile.ZendeskTicket.gotoViaId(ticketId = ${staticRequestIdList});

		LocalFile.ZendeskKCApp.clickAppsbutton();

		LocalFile.ZendeskKCApp.viewNoArticleViaList(articleName = "A simple DXPC article");
	}

}