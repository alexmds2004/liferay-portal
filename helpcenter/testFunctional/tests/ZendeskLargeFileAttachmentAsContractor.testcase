definition {

	property testray.main.component.name = "Support QA";
	property type = "zendesk.frontend";

	setUp {
		Passwords.getPasswords();
	}

	tearDown {
		ZendeskUserAPI._getDefaultUserId(organizationName = "Lfazen - ${staticProjectName}");

		ZendeskUserAPI._tearDownUsersRequestedTicketsByEmailAddressTable(table = '''| lfa.customer1@lrcustomer.com.broken |''');

		OSBAdminProject.tearDownProjects(table = '''| LFAZENLFAZEN |''');

		KoroneikiAccountAPI._tearDownAccounts(table = '''| Lfazen - ${staticProjectName} |''');

		KoroneikiAccountAPI._tearDownAccountsViaAccountFieldNameAndValue(
			fieldName = "Code",
			table = '''| LFAZENLFAZEN |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Gold Subscription");

		JSONUser.tearDownUsers(table = '''| lfa.customer1@lrcustomer.com.broken |''');

		JSONUser.tearDownUsersViaSupport(table = '''| lfa.customer1@lrcustomer.com.broken   |
	| lfa.contractor1@gs.liferay.com.broken |''');

		JSONUser.tearDownUsersViaKoroneiki(table = '''| lfa.customer1@lrcustomer.com.broken |''');

		KoroneikiContactAPI._tearDownContacts(table = '''| lfa.customer1@lrcustomer.com.broken |''');

		JSONOkta.tearDownUsers(table = '''| lfa.customer1@lrcustomer.com.broken |''');

		ZendeskUserAPI._getMultipleUserIdsByEmailAddress(table = '''| lfa.customer1@lrcustomer.com.broken   |
	| lfa.contractor1@gs.liferay.com.broken |''');

		ZendeskUserAPI._tearDownUsersByIdList(userIds = ${staticUserIdList});

		ZendeskOrganizationAPI._getMultipleOrganizationExternalIdsByOrganizationNameIfStillPresent(table = '''| Lfazen - ${staticProjectName} |''');

		ZendeskOrganizationAPI._tearDownOrganizationsByExternalIdList(organizationExternalIds = ${staticOrganizationExternalIdList});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId});
	}

	test Uploadlargefile {
		OSBAdminRabbitMQ.generateProvisioningProjectName();

		Passwords.getPasswords();

		JSONOkta.createOktaUser(table = '''| Screen Name   | lfa.customer1                       |
	| Email Address | lfa.customer1@lrcustomer.com.broken |
	| First Name    | LFA                                 |
	| Last Name     | Customer1                           |''');

		JSONUser.createViaSupport(table = '''| Screen Name   | lfa.contractor1                       |
	| Email Address | lfa.contractor1@gs.liferay.com.broken |
	| First Name    | LFA                                   |
	| Last Name     | Contractor1                           |''');

		JSONUser.assignUserToSupportOrganization(
			organizationName = "Data Access US",
			userEmailAddress = "lfa.contractor1@gs.liferay.com.broken");

		KoroneikiAccountAPI._createAccount(table = '''| Code        | LFAZENLFAZEN                  | |
	| Data Region | United States                 | |
	| Language    | English                       | |
	| Name        | Lfazen - ${staticProjectName} | |
	| Region      | United States                 | |
	| Status      | Active                        | |
	| Tier        | T1                            | |''');

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Lfazen - ${staticProjectName}",
			contactEmailAddress = "lfa.customer1@lrcustomer.com.broken",
			table = '''| Support Requester |''');

		KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Lfazen - ${staticProjectName}",
			productName = "Portal Production",
			table = '''| End Date                | ${staticEndDate}         |   |
	| Original End Date       | ${staticOriginalEndDate} |   |
	| Perpetual               | false                    |   |
	| Product Field and Value | sizing                   | 1 |
	| Product Field and Value | licenses                 | 1 |
	| Product Field and Value | version                  | 6 |
	| Quantity                | 1                        |   |
	| Start Date              | ${staticStartDate}       |   |
	| Status                  | Approved                 |   |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Lfazen - ${staticProjectName}",
			productName = "Gold Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Gold Subscription");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - Portal");

		ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		JSONOSBAccount.viewSupportOrganizationSync(accountCode = "LFAZENLFAZEN");

		ZendeskOrganizationAPI._viewOrganizationSyncFromOsb(organizationName = "Lfazen - ${staticProjectName}");

		JSONUser.viewSupportUserSync(userEmailAddress = "lfa.customer1@lrcustomer.com.broken");

		JSONUser.viewSupportUserSync(userEmailAddress = "lfa.contractor1@gs.liferay.com.broken");

		JSONUser.assignUserToSupportOrganization(
			organizationName = "Liferay Contractor",
			userEmailAddress = "lfa.contractor1@gs.liferay.com.broken");

		JSONUser.updateSupportPassword(
			userEmailAddress = "lfa.customer1@lrcustomer.com.broken",
			userPassword = ${staticSupportUserTestPassword});

		JSONUser.updateSupportPassword(
			userEmailAddress = "lfa.contractor1@gs.liferay.com.broken",
			userPassword = ${staticSupportUserTestPassword});

		ZendeskUserAPI._viewUserSyncFromOsb(userEmailAddress = "lfa.customer1@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserSyncFromOsb(userEmailAddress = "lfa.contractor1@gs.liferay.com.broken");

		ZendeskUserAPI._updateUserPasswordByEmailAddress(
			userEmailAddress = "lfa.customer1@lrcustomer.com.broken",
			userPassword = ${staticZendeskAdminPassword});

		ZendeskUserAPI._updateUserPasswordByEmailAddress(
			userEmailAddress = "lfa.contractor1@gs.liferay.com.broken",
			userPassword = ${staticZendeskAdminPassword});

		ZendeskUserAPI._updateUserRoleByEmailAddress(
			roleName = "Agent",
			userEmailAddress = "lfa.contractor1@gs.liferay.com.broken");

		OSBAdmin.logoutAndLoginToSupport(
			userEmailAddress = "lfa.customer1@lrcustomer.com.broken",
			userPassword = ${staticSupportUserTestPassword});

		ZendeskHomepage.login(
			userEmailAddress = "lfa.customer1@lrcustomer.com.broken",
			userPassword = ${staticZendeskAdminPassword});

		ZendeskRequest.create(table = '''| Product       | Liferay Portal                          | 6.2                                   |
	| Component     | Activation Key & Project Administration |                                       |
	| System Status | Production                              | Functioning with limited capabilities |
	| Subject       | Request Subject                         |                                       |
	| Description   | Request Description                     |                                       |
	| Attachments   | Document_1.txt                          |                                       |''');

		ZendeskRequest.view(table = '''| Subject       | Request Subject                                    |
	| Status        | OPEN                                               |
	| Requester     | LFA Customer1                                      |
	| Priority      | Normal                                             |
	| Product       | Liferay Portal > 6.2                               |
	| Sub-Status    | —                                                  |
	| Component     | Activation Key & Project Administration            |
	| System Status | Production > Functioning with limited capabilities |
	| Attachments   | Document_1.txt                                     |''');

		OSBAdmin.logoutAndLoginToSupport(
			userEmailAddress = "lfa.contractor1@gs.liferay.com.broken",
			userPassword = ${staticSupportUserTestPassword});

		ZendeskHomepage.logoutAndLogin(
			userEmailAddress = "lfa.contractor1@gs.liferay.com.broken",
			userPassword = ${staticZendeskAdminPassword});

		ZendeskHomepage.pause(timeInSeconds = 20);

		ZendeskRequest.gotoViaId(requestId = ${staticRequestId});

		ZendeskTicket.dimissTicketInterfaceTour();

		ZendeskTicket.uploadFileViaLargeFileUploader(table = '''| Attachment       | Document_2.txt      |
	| Comment          | Large File Comment1 |
	| Data Region      | United States       |
	| No Personal Data | false               |''');

		ZendeskRequest.gotoViaId(requestId = ${staticRequestId});

		ZendeskTicketAPI._viewTicketComment(
			commentContent = "Large File Comment1",
			ticketId = ${staticRequestId});

		ZendeskTicketAPI._viewTicketComment(
			commentContent = "Document_2.txt",
			ticketId = ${staticRequestId});
	}

}