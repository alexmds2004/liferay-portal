	@help.center.acceptance = "true"
	test EEUSRouting {
		LocalFile.ZendeskOrganizationAPI._createOrganization(table = '''| Status           | Approved            |
	| Name             | Organization Name 1 |
	| Shared Tickets   | true                |
	| Shared Comments  | true                |
	| SLA              | Gold                |
	| Tier             | T4                  |
	| Support Region   | US                  |
	| Support Language | English             |
	| External ID      | 12345678            |''');

		LocalFile.ZendeskOrganizationAPI._assignTagsToOrganizationViaOrganizationExternalID(
			organizationExternalId = 12345678,
			table = '''| liferay_dxp |''');

		LocalFile.ZendeskUserAPI._createUser(table = '''| Name             | Zendesk User1                    |
	| Tags             | osb_customer,osb_kb              |
	| Password         | ${staticZendeskAdminPassword}    |
	| Role             | End-user                         |
	| Access           | Organization                     |
	| Email            | zendesk.user1@zendesk.com.broken |
	| Phone Number     | +1 (555) 555-5555                |
	| Organization     | Organization Name 1              |
	| Language         | English                          |
	| Time Zone        | Pacific Time (US & Canada)       |
	| External ID      | User1                            |''');

		LocalFile.ZendeskRequestAPI._createRequest(
			requesterEmail = "zendesk.user1@zendesk.com.broken",
			table = '''| Product                  | prd_liferay_dxp_7_4                              |
	| Component                | activation_key_project_administration            |
	| Tags                     | escalation_engineer                              |
	| System Status            | production_functioning_with_limited_capabilities |
