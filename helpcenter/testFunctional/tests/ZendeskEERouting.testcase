	test EEJPRouting {
		LocalFile.ZendeskOrganizationAPI._createOrganization(table = '''| Status           | Approved            |
	| Name             | Organization Name 1 |
	| Shared Tickets   | true                |
	| Shared Comments  | true                |
	| SLA              | Gold                |
	| Tier             | T4                  |
	| Support Region   | Japan               |
	| Support Language | Japanese            |
	| External ID      | 12345678            |''');

		LocalFile.ZendeskOrganizationAPI._assignTagsToOrganizationViaOrganizationExternalID(
			organizationExternalId = 12345678,
			table = '''| liferay_dxp |''');

		LocalFile.ZendeskUserAPI._createUser(table = '''| Name             | Zendesk User1                    |
	| Tags             | osb_customer,osb_kb              |
