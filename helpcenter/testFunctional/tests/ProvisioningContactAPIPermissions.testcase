definition {

	property testray.main.component.name = "Support QA";
	property type = "provisioning.security";

	setUp {
		Passwords.getPasswords();

		OSBAdminRabbitMQ.generateStaticVariables();

		OSBAdminRabbitMQ.generateProvisioningCompanyName();

		OSBAdminRabbitMQ.generateProvisioningProjectName();

		JSONOkta.createOktaUser(table = '''| Screen Name   | pro.okta1                       |
	| Email Address | pro.okta1@lrcustomer.com.broken |
	| First Name    | PRO                             |
	| Last Name     | Okta1                           |''');

		JSONOkta.createOktaUser(table = '''| Screen Name   | pro.okta2                       |
	| Email Address | pro.okta2@lrcustomer.com.broken |
	| First Name    | PRO                             |
	| Last Name     | Okta2                           |''');

		JSONOkta.createOktaUser(table = '''| Screen Name   | pro.okta3                      |
	| Email Address | pro.okta3@lrpartner.com.broken |
	| First Name    | PRO                            |
	| Last Name     | Okta3                          |''');

		JSONOkta.createOktaUser(table = '''| Screen Name   | pro.okta4                       |
	| Email Address | pro.okta4@lrcustomer.com.broken |
	| First Name    | PRO                             |
	| Last Name     | Okta4                           |''');
	}

	tearDown {
		ZendeskUserAPI._getDefaultUserId(organizationName = "Permis - ${staticProjectName}");

		ZendeskUserAPI._renameFirstDefaultUserIdVariable();

		ZendeskUserAPI._getDefaultUserId(organizationName = "Misper - ${staticCompanyName}");

		ZendeskUserAPI._renameSecondDefaultUserIdVariable();

		ZendeskUserAPI._getDefaultUserId(organizationName = "Perpar - ${staticCompanyName}");

		ZendeskUserAPI._renameThirdDefaultUserIdVariable();

		ZendeskUserAPI._getDefaultUserId(organizationName = "Kormis - ${staticCompanyName}");

		ZendeskUserAPI._renameThirdDefaultUserIdVariable();

		KoroneikiProductConsumptionAPI._tearDownProductConsumptionList(
			accountName = "Permis - ${staticProjectName}",
			table = '''| DXP Production    |
	| Portal Production |''');

		KoroneikiProductConsumptionAPI._tearDownProductConsumptionList(
			accountName = "Kormis - ${staticProjectName}",
			table = '''| DXP Production    |
	| Portal Production |''');

		KoroneikiProductConsumptionAPI._tearDownProductConsumptions(
			accountName = "Permis - ${staticProjectName}",
			table = '''| DXP Production    |
	| Portal Production |''');

		KoroneikiProductConsumptionAPI._tearDownProductConsumptions(
			accountName = "Kormis - ${staticProjectName}",
			table = '''| DXP Production    |
	| Portal Production |''');

		ZendeskUserAPI._getDefaultUserId(organizationName = "Permis - ${staticProjectName}");

		KoroneikiProductConsumptionAPI._tearDownProductConsumptionList(
			accountName = "Permis - ${staticProjectName}",
			table = '''| DXP Production    |
	| Portal Production |''');

		ZendeskUserAPI._getDefaultUserId(organizationName = "Kormis - ${staticProjectName}");

		KoroneikiProductConsumptionAPI._tearDownProductConsumptionList(
			accountName = "Kormis - ${staticProjectName}",
			table = '''| DXP Production    |
	| Portal Production |''');

		OSBAdminProject.tearDownProjects(table = '''| MISPERPERMIS |
	| MISKORKORMIS |
	| MISPER       |
	| PERPAR       |''');

		KoroneikiAccountAPI._tearDownAccounts(table = '''| Permis - ${staticProjectName} |
	| Misper - ${staticCompanyName} |
	| Perpar - ${staticCompanyName} |
	| Kormis - ${staticCompanyName} |''');

		KoroneikiAccountAPI._tearDownAccountsViaAccountFieldNameAndValue(
			fieldName = "Code",
			table = '''| MISPERPERMIS |
	| MISKORKORMIS |
	| MISPER       |
	| PERPAR       |''');

		JSONUser.tearDownUsersViaSupport(table = '''| pro.okta1@lrcustomer.com.broken   |
	| pro.okta2@lrcustomer.com.broken   |
	| pro.okta3@lrpartner.com.broken    |
	| pro.okta4@lrcustomer.com.broken   |''');

		JSONUser.tearDownUsersViaKoroneiki(table = '''| pro.okta1@lrcustomer.com.broken   |
	| pro.okta2@lrcustomer.com.broken   |
	| pro.okta3@lrpartner.com.broken    |
	| pro.okta4@lrcustomer.com.broken   |''');

		KoroneikiContactAPI._tearDownContacts(table = '''| pro.okta1@lrcustomer.com.broken   |
	| pro.okta2@lrcustomer.com.broken   |
	| pro.okta3@lrpartner.com.broken    |
	| pro.okta4@lrcustomer.com.broken   |''');

		JSONOkta.tearDownUsers(table = '''| pro.okta1@lrcustomer.com.broken   |
	| pro.okta2@lrcustomer.com.broken   |
	| pro.okta3@lrpartner.com.broken    |
	| pro.okta4@lrcustomer.com.broken   |''');

		ZendeskTicketAPI._tearDownTicketsByKeywords(table = '''| New Subscription(s) for Permis - ${staticProjectName} |
	| New Subscription(s) for Misper - ${staticCompanyName} |
	| New Subscription(s) for Perpar - ${staticCompanyName} |
	| New Subscription(s) for Kormis - ${staticCompanyName} |''');

		ZendeskUserAPI._getMultipleUserIdsByEmailAddress(table = '''| pro.okta1@lrcustomer.com.broken   |
	| pro.okta2@lrcustomer.com.broken   |
	| pro.okta3@lrpartner.com.broken    |
	| pro.okta4@lrcustomer.com.broken   |''');

		ZendeskUserAPI._tearDownUsersByIdList(userIds = ${staticUserIdList});

		ZendeskOrganizationAPI._getMultipleOrganizationExternalIdsByOrganizationNameIfStillPresent(table = '''| Permis - ${staticProjectName} |
	| Misper - ${staticCompanyName} |
	| Perpar - ${staticCompanyName} |
	| Kormis - ${staticCompanyName} |''');

		ZendeskOrganizationAPI._tearDownOrganizationsByExternalIdList(organizationExternalIds = ${staticOrganizationExternalIdList});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId1});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId2});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId3});
	}

	test AssigncontactroletoaccountuserusingaPartnerManageruser {
		OSBAdminRabbitMQ.publishCreateProjectWithNoPartnerMessage(
			routingKey = "dossiera.provisioning.create",
			table = '''| Account Name                           | Misper - ${staticCompanyName}              |
	| Address City                           | Diamond Bar                                |
	| Address Country                        | United States                              |
	| Address Postal Code                    | 91765                                      |
	| Address Region                         | California                                 |
	| Address Street                         | 456 Fake Street                            |
	| Contact Email Address                  | pro.okta1@lrcustomer.com.broken            |
	| Contact First Name                     | USR                                        |
	| Contact Last Name                      | Koroneiki1                                 |
	| Dossiera Account Key                   | ${staticDossieraAccountKey}                |
	| Dossiera Address Key 1                 | ${staticDossieraAddressKey1}               |
	| Dossiera Address Key 2                 | ${staticDossieraAddressKey2}               |
	| Dossiera Contact Key                   | ${staticDossieraContactKey}                |
	| Dossiera Project Key                   | ${staticDossieraProjectKey}                |
	| End Day                                | ${staticEndDay}                            |
	| End Month                              | ${staticEndMonth}                          |
	| End Year                               | ${staticEndYear}                           |
	| Industry                               | Automotive                                 |
	| Owner Email Address                    | pro.okta4@lrcustomer.com.broken            |
	| Owner First Name                       | USR                                        |
	| Owner Last Name                        | Koroneiki4                                 |
	| Partner First Line Support             | false                                      |
	| Product Type                           | New                                        |
	| Product Name                           | Liferay Digital Enterprise - Prod Sizing 4 |
	| Project Name                           | Permis - ${staticProjectName}              |
	| Renewal                                | false                                      |
	| Salesforce Opportunity Key             | ${staticSalesforceOpportunityKey}          |
	| Salesforce Opportunity Line Item Key 1 | ${staticSalesforceOpportunityLineItemKey1} |
	| Salesforce Opportunity Line Item Key 2 | ${staticSalesforceOpportunityLineItemKey2} |
	| Salesforce Opportunity Sold By         | Liferay US                                 |
	| Salesforce Opportunity Stage Name      | Closed Won                                 |
	| Salesforce Opportunity Territory       | United States                              |
	| Salesforce Opportunity Type            | New Business                               |
	| Salesforce Owner User Key              | ${staticSalesforceOwnerUserKey}            |
	| Salesforce Project Key                 | ${staticSalesforceProjectKey}              |
	| Start Day                              | ${staticStartDay}                          |
	| Start Month                            | ${staticStartMonth}                        |
	| Start Year                             | ${staticStartYear}                         |
	| Subscription Level                     | Platinum                                   |
	| Version Number                         | 7.1                                        |''');

		KoroneikiAccountAPI._createAccountTeam(
			accountName = "Permis - ${staticProjectName}",
			teamName = "User Site Partner");

		KoroneikiAccountAPI._assignTeamRolesToTeam(
			accountName = "Permis - ${staticProjectName}",
			table = '''| Partner |''',
			teamName = "User Site Partner");

		KoroneikiTeamAPI._assignContacts(
			table = '''| pro.okta3@lrpartner.com.broken |''',
			teamName = "User Site Partner");

		ProvisioningContactAPI._assignContactRolesToContact(
			accountName = "Permis - ${staticProjectName}",
			table = '''| Partner Manager |''',
			userEmailAddress = "pro.okta3@lrpartner.com.broken");

		Okta._loginToDevDomain(
			userEmailAddress = "pro.okta3@lrpartner.com.broken",
			userPassword = ${staticOktaUserPassword});

		Okta._getOktaSessionIdDevPage();

		ProvisioningContactAPI._assignContactRolesToContactUsingOktaSessionId(
			accountName = "Permis - ${staticProjectName}",
			table = '''| Member |''',
			userEmailAddress = "pro.okta2@lrcustomer.com.broken");

		OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		Provisioning.gotoAccounts();

		Provisioning.searchAccounts(keyword = "Permis");

		Provisioning.clickAccount(accountName = "Permis - ${staticProjectName}");

		Provisioning.clickTab(tabName = "Contacts");

		ProvisioningAccount._viewAccountContact(
			emailAddress = "pro.okta3@lrpartner.com.broken",
			table = '''| Name          | PRO Okta3                      |
	| Email Address | pro.okta3@lrpartner.com.broken |
	| Role          | Partner Manager                |
	| User Status   | VERIFIED                       |''');

		ProvisioningAccount._viewAccountContact(
			emailAddress = "pro.okta2@lrcustomer.com.broken",
			table = '''| Name          | PRO Okta2                       |
	| Email Address | pro.okta2@lrcustomer.com.broken |
	| Role          | Member                          |
	| User Status   | VERIFIED                        |''');

		Provisioning.clickTab(tabName = "History");

		ProvisioningAccount.viewAccountHistoryEntryByKeyword(
			fieldName = "Contact Role",
			keyword = "Test Test > Assigned Contact",
			table = '''| Update Description          | Test Test > Assigned Contact > PRO Okta3 |
	| Update Field Name           | Contact Role                             |
	| Update Field Original Value | N/A                                      |
	| Update Field New Value      | Partner Manager                          |''');

		ProvisioningAccount.viewAccountHistoryEntryByKeyword(
			fieldName = "Contact Role",
			keyword = "PRO Okta3 > Assigned Contact",
			table = '''| Update Description          | PRO Okta3 > Assigned Contact > PRO Okta2 |
	| Update Field Name           | Contact Role                             |
	| Update Field Original Value | N/A                                      |
	| Update Field New Value      | Member                                   |''');

		KoroneikiAccountAPI._viewContact(
			accountName = "Permis - ${staticProjectName}",
			contactEmailAddress = "pro.okta3@lrpartner.com.broken");

		KoroneikiContactAPI._viewContactUuidAndUserUuidComparison(contactEmailAddress = "pro.okta3@lrpartner.com.broken");

		KoroneikiAccountAPI._viewContact(
			accountName = "Permis - ${staticProjectName}",
			contactEmailAddress = "pro.okta2@lrcustomer.com.broken");

		KoroneikiContactAPI._viewContactUuidAndUserUuidComparison(contactEmailAddress = "pro.okta2@lrcustomer.com.broken");
	}

	test RemovecontactroletoaccountuserusingaPartnerManageruser {
		OSBAdminRabbitMQ.publishCreateProjectWithNoPartnerMessage(
			routingKey = "dossiera.provisioning.create",
			table = '''| Account Name                           | Misper - ${staticCompanyName}              |
	| Address City                           | Diamond Bar                                |
	| Address Country                        | United States                              |
	| Address Postal Code                    | 91765                                      |
	| Address Region                         | California                                 |
	| Address Street                         | 456 Fake Street                            |
	| Contact Email Address                  | pro.okta1@lrcustomer.com.broken            |
	| Contact First Name                     | USR                                        |
	| Contact Last Name                      | Koroneiki1                                 |
	| Dossiera Account Key                   | ${staticDossieraAccountKey}                |
	| Dossiera Address Key 1                 | ${staticDossieraAddressKey1}               |
	| Dossiera Address Key 2                 | ${staticDossieraAddressKey2}               |
	| Dossiera Contact Key                   | ${staticDossieraContactKey}                |
	| Dossiera Project Key                   | ${staticDossieraProjectKey}                |
	| End Day                                | ${staticEndDay}                            |
	| End Month                              | ${staticEndMonth}                          |
	| End Year                               | ${staticEndYear}                           |
	| Industry                               | Automotive                                 |
	| Owner Email Address                    | pro.okta4@lrcustomer.com.broken            |
	| Owner First Name                       | USR                                        |
	| Owner Last Name                        | Koroneiki4                                 |
	| Partner First Line Support             | false                                      |
	| Product Type                           | New                                        |
	| Product Name                           | Liferay Digital Enterprise - Prod Sizing 4 |
	| Project Name                           | Permis - ${staticProjectName}              |
	| Renewal                                | false                                      |
	| Salesforce Opportunity Key             | ${staticSalesforceOpportunityKey}          |
	| Salesforce Opportunity Line Item Key 1 | ${staticSalesforceOpportunityLineItemKey1} |
	| Salesforce Opportunity Line Item Key 2 | ${staticSalesforceOpportunityLineItemKey2} |
	| Salesforce Opportunity Sold By         | Liferay US                                 |
	| Salesforce Opportunity Stage Name      | Closed Won                                 |
	| Salesforce Opportunity Territory       | United States                              |
	| Salesforce Opportunity Type            | New Business                               |
	| Salesforce Owner User Key              | ${staticSalesforceOwnerUserKey}            |
	| Salesforce Project Key                 | ${staticSalesforceProjectKey}              |
	| Start Day                              | ${staticStartDay}                          |
	| Start Month                            | ${staticStartMonth}                        |
	| Start Year                             | ${staticStartYear}                         |
	| Subscription Level                     | Platinum                                   |
	| Version Number                         | 7.1                                        |''');

		KoroneikiAccountAPI._createAccountTeam(
			accountName = "Permis - ${staticProjectName}",
			teamName = "User Site Partner");

		KoroneikiAccountAPI._assignTeamRolesToTeam(
			accountName = "Permis - ${staticProjectName}",
			table = '''| Partner |''',
			teamName = "User Site Partner");

		KoroneikiTeamAPI._assignContacts(
			table = '''| pro.okta3@lrpartner.com.broken |''',
			teamName = "User Site Partner");

		ProvisioningContactAPI._assignContactRolesToContact(
			accountName = "Permis - ${staticProjectName}",
			table = '''| Partner Manager |''',
			userEmailAddress = "pro.okta3@lrpartner.com.broken");

		Okta._loginToDevDomain(
			userEmailAddress = "pro.okta3@lrpartner.com.broken",
			userPassword = ${staticOktaUserPassword});

		Okta._getOktaSessionIdDevPage();

		ProvisioningContactAPI._assignContactRolesToContactUsingOktaSessionId(
			accountName = "Permis - ${staticProjectName}",
			table = '''| Member       |
	| Support User |''',
			userEmailAddress = "pro.okta2@lrcustomer.com.broken");

		OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		Provisioning.gotoAccounts();

		Provisioning.searchAccounts(keyword = "Permis");

		Provisioning.clickAccount(accountName = "Permis - ${staticProjectName}");

		Provisioning.clickTab(tabName = "Contacts");

		ProvisioningAccount._viewAccountContact(
			emailAddress = "pro.okta3@lrpartner.com.broken",
			table = '''| Name          | PRO Okta3                      |
	| Email Address | pro.okta3@lrpartner.com.broken |
	| Role          | Partner Manager                |
	| User Status   | VERIFIED                       |''');

		ProvisioningAccount._viewAccountContact(
			emailAddress = "pro.okta2@lrcustomer.com.broken",
			table = '''| Name          | PRO Okta2                       |
	| Email Address | pro.okta2@lrcustomer.com.broken |
	| Role          | Member                          |
	| User Status   | VERIFIED                        |''');

		ProvisioningAccount._viewAccountContact(
			emailAddress = "pro.okta2@lrcustomer.com.broken",
			table = '''| Name          | PRO Okta2                       |
	| Email Address | pro.okta2@lrcustomer.com.broken |
	| Role          | Support User                    |
	| User Status   | VERIFIED                        |''');

		ProvisioningContactAPI._unassignContactRolesToContactUsingOktaSessionId(
			accountName = "Permis - ${staticProjectName}",
			table = '''| Member |''',
			userEmailAddress = "pro.okta2@lrcustomer.com.broken");

		Provisioning.gotoAccounts();

		Provisioning.searchAccounts(keyword = "Permis");

		Provisioning.clickAccount(accountName = "Permis - ${staticProjectName}");

		Provisioning.clickTab(tabName = "Contacts");

		ProvisioningAccount._viewAccountContact(
			emailAddress = "pro.okta2@lrcustomer.com.broken",
			table = '''| Name          | PRO Okta2                       |
	| Email Address | pro.okta2@lrcustomer.com.broken |
	| Role          | Support User                    |
	| User Status   | VERIFIED                        |''');

		Provisioning.clickTab(tabName = "History");

		ProvisioningAccount.viewAccountHistoryEntryByKeyword(
			fieldName = "Contact Role",
			keyword = "Test Test > Assigned Contact",
			table = '''| Update Description          | Test Test > Assigned Contact > PRO Okta3 |
	| Update Field Name           | Contact Role                             |
	| Update Field Original Value | N/A                                      |
	| Update Field New Value      | Partner Manager                          |''');

		ProvisioningAccount.viewAccountHistoryEntryByKeyword(
			fieldName = "Contact Role",
			keyword = "PRO Okta3 > Assigned Contact",
			table = '''| Update Description          | PRO Okta3 > Assigned Contact > PRO Okta2 |
	| Update Field Name           | Contact Role                             |
	| Update Field Original Value | N/A                                      |
	| Update Field New Value      | Member                                   |''');

		ProvisioningAccount.viewAccountHistoryEntryByKeyword(
			fieldName = "Contact Role",
			keyword = "PRO Okta3 > Assigned Contact",
			table = '''| Update Description          | PRO Okta3 > Assigned Contact > PRO Okta2 |
	| Update Field Name           | Contact Role                             |
	| Update Field Original Value | N/A                                      |
	| Update Field New Value      | Support User                             |''');

		ProvisioningAccount.viewAccountHistoryEntryByKeyword(
			fieldName = "Contact Role",
			keyword = "PRO Okta3 > Unassigned Contact",
			table = '''| Update Description          | PRO Okta3 > Unassigned Contact > PRO Okta2 |
	| Update Field Name           | Contact Role                               |
	| Update Field Original Value | Member                                     |
	| Update Field New Value      | N/A                                        |''');

		KoroneikiAccountAPI._viewContact(
			accountName = "Permis - ${staticProjectName}",
			contactEmailAddress = "pro.okta3@lrpartner.com.broken");

		KoroneikiContactAPI._viewContactUuidAndUserUuidComparison(contactEmailAddress = "pro.okta3@lrpartner.com.broken");

		KoroneikiAccountAPI._viewContact(
			accountName = "Permis - ${staticProjectName}",
			contactEmailAddress = "pro.okta2@lrcustomer.com.broken");

		KoroneikiContactAPI._viewContactUuidAndUserUuidComparison(contactEmailAddress = "pro.okta2@lrcustomer.com.broken");
	}

	test UpdatecontactroletoaccountuserusingaPartnerManageruser {
		OSBAdminRabbitMQ.publishCreateProjectWithNoPartnerMessage(
			routingKey = "dossiera.provisioning.create",
			table = '''| Account Name                           | Misper - ${staticCompanyName}              |
	| Address City                           | Diamond Bar                                |
	| Address Country                        | United States                              |
	| Address Postal Code                    | 91765                                      |
	| Address Region                         | California                                 |
	| Address Street                         | 456 Fake Street                            |
	| Contact Email Address                  | pro.okta1@lrcustomer.com.broken            |
	| Contact First Name                     | USR                                        |
	| Contact Last Name                      | Koroneiki1                                 |
	| Dossiera Account Key                   | ${staticDossieraAccountKey}                |
	| Dossiera Address Key 1                 | ${staticDossieraAddressKey1}               |
	| Dossiera Address Key 2                 | ${staticDossieraAddressKey2}               |
	| Dossiera Contact Key                   | ${staticDossieraContactKey}                |
	| Dossiera Project Key                   | ${staticDossieraProjectKey}                |
	| End Day                                | ${staticEndDay}                            |
	| End Month                              | ${staticEndMonth}                          |
	| End Year                               | ${staticEndYear}                           |
	| Industry                               | Automotive                                 |
	| Owner Email Address                    | pro.okta4@lrcustomer.com.broken            |
	| Owner First Name                       | USR                                        |
	| Owner Last Name                        | Koroneiki4                                 |
	| Partner First Line Support             | false                                      |
	| Product Type                           | New                                        |
	| Product Name                           | Liferay Digital Enterprise - Prod Sizing 4 |
	| Project Name                           | Permis - ${staticProjectName}              |
	| Renewal                                | false                                      |
	| Salesforce Opportunity Key             | ${staticSalesforceOpportunityKey}          |
	| Salesforce Opportunity Line Item Key 1 | ${staticSalesforceOpportunityLineItemKey1} |
	| Salesforce Opportunity Line Item Key 2 | ${staticSalesforceOpportunityLineItemKey2} |
	| Salesforce Opportunity Sold By         | Liferay US                                 |
	| Salesforce Opportunity Stage Name      | Closed Won                                 |
	| Salesforce Opportunity Territory       | United States                              |
	| Salesforce Opportunity Type            | New Business                               |
