	| Salesforce Project Key                 | ${staticSalesforceProjectKey}              |
	| Start Day                              | ${staticStartDay}                          |
	| Start Month                            | ${staticStartMonth}                        |
	| Start Year                             | ${staticStartYear}                         |
	| Subscription Level                     | Platinum                                   |
	| Version Number                         | 7.1                                        |''');

		KoroneikiAccountAPI._createAccountTeam(
			accountName = "Permis - ${staticProjectName}",
			teamName = "User Site Partner");

		KoroneikiAccountAPI._assignTeamRolesToTeam(
			accountName = "Permis - ${staticProjectName}",
			table = '''| Partner |''',
			teamName = "User Site Partner");

		KoroneikiTeamAPI._assignContacts(
			table = '''| pro.okta3@lrpartner.com.broken |''',
			teamName = "User Site Partner");

		ProvisioningContactAPI._assignContactRolesToContact(
			accountName = "Permis - ${staticProjectName}",
			table = '''| Partner Manager |''',
			userEmailAddress = "pro.okta3@lrpartner.com.broken");

		Okta._loginToDevDomain(
			userEmailAddress = "pro.okta3@lrpartner.com.broken",
			userPassword = ${staticOktaUserPassword});

		Okta._getOktaSessionIdDevPage();

		ProvisioningContactAPI._assignContactRolesToContactUsingOktaSessionId(
			accountName = "Permis - ${staticProjectName}",
			table = '''| Member       |
	| Support User |''',
			userEmailAddress = "pro.okta2@lrcustomer.com.broken");

		OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		Provisioning.gotoAccounts();

		Provisioning.searchAccounts(keyword = "Permis");

		Provisioning.clickAccount(accountName = "Permis - ${staticProjectName}");

		Provisioning.clickTab(tabName = "Contacts");

		ProvisioningAccount._viewAccountContact(
			emailAddress = "pro.okta3@lrpartner.com.broken",
			table = '''| Name          | PRO Okta3                      |
	| Email Address | pro.okta3@lrpartner.com.broken |
	| Role          | Partner Manager                |
	| User Status   | VERIFIED                       |''');

		ProvisioningAccount._viewAccountContact(
			emailAddress = "pro.okta2@lrcustomer.com.broken",
			table = '''| Name          | PRO Okta2                       |
	| Email Address | pro.okta2@lrcustomer.com.broken |
	| Role          | Member                          |
	| User Status   | VERIFIED                        |''');

		ProvisioningAccount._viewAccountContact(
			emailAddress = "pro.okta2@lrcustomer.com.broken",
			table = '''| Name          | PRO Okta2                       |
	| Email Address | pro.okta2@lrcustomer.com.broken |
	| Role          | Support User                    |
	| User Status   | VERIFIED                        |''');

		ProvisioningContactAPI._unassignContactRolesToContactUsingOktaSessionId(
			accountName = "Permis - ${staticProjectName}",
			table = '''| Member |''',
			userEmailAddress = "pro.okta2@lrcustomer.com.broken");

		ProvisioningContactAPI._assignContactRolesToContactUsingOktaSessionId(
			accountName = "Permis - ${staticProjectName}",
			table = '''| Critical Incident Contact |''',
			userEmailAddress = "pro.okta2@lrcustomer.com.broken");

		Provisioning.gotoAccounts();

		Provisioning.searchAccounts(keyword = "Permis");

		Provisioning.clickAccount(accountName = "Permis - ${staticProjectName}");

