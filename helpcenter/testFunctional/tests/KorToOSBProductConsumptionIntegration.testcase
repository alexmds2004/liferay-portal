definition {

	property testray.main.component.name = "Support QA";
	property type = "osb.integration";

	setUp {
		LocalFile.Passwords.getPasswords();
	}

	tearDown {
		LocalFile.ZendeskUserAPI._getDefaultUserId(organizationName = "Korone - ${staticProjectName}");

		LocalFile.ZendeskUserAPI._renameFirstDefaultUserIdVariable();

		LocalFile.ZendeskUserAPI._getDefaultUserId(organizationName = "Kchild - ${staticProjectName}");

		LocalFile.ZendeskUserAPI._renameSecondDefaultUserIdVariable();

		LocalFile.ZendeskUserAPI._getDefaultUserId(organizationName = "Oneiki - ${staticProjectName}");

		LocalFile.ZendeskUserAPI._renameThirdDefaultUserIdVariable();

		LocalFile.ZendeskUserAPI._getDefaultUserId(organizationName = "Ochild - ${staticProjectName}");

		LocalFile.ZendeskUserAPI._renameFourthDefaultUserIdVariable();

		LocalFile.KoroneikiProductConsumptionAPI._tearDownProductConsumptions(
			accountName = "Korone - ${staticProjectName}",
			table = '''| A Liferay OSB Product    |
	| A Liferay Server Product |''');

		LocalFile.KoroneikiProductConsumptionAPI._tearDownProductConsumptions(
			accountName = "Oneiki - ${staticProjectName}",
			table = '''| A Liferay OSB Product    |
	| A Liferay Server Product |''');

		LocalFile.KoroneikiProductConsumptionAPI._tearDownProductConsumptions(
			accountName = "Kchild - ${staticProjectName}",
			table = '''| A Liferay OSB Product    |
	| A Liferay Server Product |''');

		LocalFile.KoroneikiProductConsumptionAPI._tearDownProductConsumptions(
			accountName = "Ochild - ${staticProjectName}",
			table = '''| A Liferay OSB Product    |
	| A Liferay Server Product |''');

		LocalFile.OSBAdminProject.tearDownProjects(table = '''| KCHILDKCHILD |
	| OCHILDOCHILD |
	| KORONEKORONE |
	| ONEIKIONEIKI |''');

		LocalFile.KoroneikiAccountAPI._tearDownAccounts(table = '''| Kchild - ${staticProjectName} |
	| Ochild - ${staticProjectName} |
	| Korone - ${staticProjectName} |
	| Oneiki - ${staticProjectName} |''');

		LocalFile.KoroneikiAccountAPI._tearDownAccountsViaAccountFieldNameAndValue(
			fieldName = "Code",
			table = '''| KCHILDKCHILD |
	| OCHILDOCHILD |
	| KORONEKORONE |
	| ONEIKIONEIKI |''');

		LocalFile.KoroneikiProductAPI._tearDownProducts(table = '''| A Liferay OSB Product    |
	| A Liferay Server Product |''');

		LocalFile.KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		LocalFile.ZendeskOrganizationAPI._getMultipleOrganizationExternalIdsByOrganizationNameIfStillPresent(table = '''| Kchild - ${staticProjectName} |
	| Ochild - ${staticProjectName} |
	| Korone - ${staticProjectName} |
	| Oneiki - ${staticProjectName} |''');

		LocalFile.ZendeskOrganizationAPI._tearDownOrganizationsByExternalIdList(organizationExternalIds = ${staticOrganizationExternalIdList});

		LocalFile.ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId1});

		LocalFile.ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId2});

		LocalFile.ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId3});

		LocalFile.ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId4});
	}

	test Createandviewmultipleproductconsumptions {
		LocalFile.OSBAdminRabbitMQ.generateProvisioningProjectName();

		LocalFile.KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORONEKORONE                         | |
	| Contact Email Address | osb.koroneiki1@lrcustomer.com.broken | |
	| Description           | Test osb account on koroneiki        | |
	| Fax Number            | 555-555-1234                         | |
	| Name                  | Korone - ${staticProjectName}        | |
	| Phone Number          | 555-555-5678                         | |
	| Profile Email Address | osb.koroneiki1@lrcustomer.com.broken | |
	| Region                | United States                        | |
	| Status                | Active                               | |
	| Tier                  | T4                                   | |
	| Website               | www.koroneikicorporation.com         | |''');

		LocalFile.KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		LocalFile.KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korone - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | true                     | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		LocalFile.KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korone - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | true                     | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		LocalFile.KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		LocalFile.KoroneikiProductAPI._createProduct(table = '''| Name | A Liferay OSB Product | |''');

		LocalFile.KoroneikiProductAPI._createProduct(table = '''| Name | A Liferay Server Product | |''');

		LocalFile.KoroneikiAccountAPI._createAccountProductConsumption(
			accountName = "Korone - ${staticProjectName}",
			productName = "A Liferay OSB Product",
			table = '''| Product Field and Value | additionalProp1 | propertyValue1 |
	| Product Field and Value | additionalProp2 | propertyValue2 |
	| Product Field and Value | additionalProp3 | propertyValue3 |''');

		LocalFile.KoroneikiAccountAPI._createAccountProductConsumption(
			accountName = "Korone - ${staticProjectName}",
			productName = "A Liferay Server Product",
			table = '''| Product Field and Value | additionalProp4 | propertyValue4 |
	| Product Field and Value | additionalProp5 | propertyValue5 |
	| Product Field and Value | additionalProp6 | propertyValue6 |''');

		LocalFile.OSBAdmin.loginToSupport(
			userEmailAddress = ${staticSupportAdminEmailAdress},
			userPassword = ${staticSupportAdminPassword});

		LocalFile.ProjectDetails.gotoProjectDetailsPage();

		LocalFile.ProjectDetails.searchKeyword(keyword = "Korone");

		LocalFile.ProjectDetails.gotoProject(projectName = "Korone - ${staticProjectName}");

		LocalFile.ProjectDetails.gotoHistory();

		LocalFile.KoroneikiAccountAPI._generateAccountId(accountName = "Korone - ${staticProjectName}");

		LocalFile.KoroneikiProductAPI._generateProductId(productName = "A Liferay OSB Product");

		LocalFile.KoroneikiProductAPI._renameFirstProductIdValue();

		LocalFile.KoroneikiProductAPI._generateProductId(productName = "A Liferay Server Product");

		LocalFile.KoroneikiProductAPI._renameSecondProductIdValue();

		LocalFile.ProjectDetails.viewHistoryEntryByKeywords(
			fieldName = "accountId",
			keyword1 = "Added Product Consumption",
			keyword2 = "A Liferay OSB Product",
			table = '''| Updater Name                | Koroneiki QA Service Producer |
	| Update Summary              | Added Product Consumption     |
	| Update Description          | A Liferay OSB Product         |
	| Update Date                 | Today                         |
	| Update Field Name           | accountId                     |
	| Update Field Original Value | N/A                           |
	| Update Field New Value      | ${staticAccountId}            |''');

		LocalFile.ProjectDetails.viewHistoryEntryByKeywords(
			fieldName = "productEntryId",
			keyword1 = "Added Product Consumption",
			keyword2 = "A Liferay OSB Product",
			table = '''| Updater Name                | Koroneiki QA Service Producer |
	| Update Summary              | Added Product Consumption     |
	| Update Description          | A Liferay OSB Product         |
	| Update Date                 | Today                         |
	| Update Field Name           | productEntryId                |
	| Update Field Original Value | N/A                           |
	| Update Field New Value      | ${staticProductId1}           |''');

		LocalFile.ProjectDetails.viewHistoryEntryByKeywords(
			fieldName = "additionalProp1",
			keyword1 = "Added Product Consumption",
			keyword2 = "A Liferay OSB Product",
			table = '''| Updater Name                | Koroneiki QA Service Producer |
	| Update Summary              | Added Product Consumption     |
	| Update Description          | A Liferay OSB Product         |
	| Update Date                 | Today                         |
	| Update Field Name           | additionalProp1               |
	| Update Field Original Value | N/A                           |
	| Update Field New Value      | propertyValue1                |''');

		LocalFile.ProjectDetails.viewHistoryEntryByKeywords(
			fieldName = "additionalProp2",
			keyword1 = "Added Product Consumption",
			keyword2 = "A Liferay OSB Product",
			table = '''| Updater Name                | Koroneiki QA Service Producer |
	| Update Summary              | Added Product Consumption     |
	| Update Description          | A Liferay OSB Product         |
	| Update Date                 | Today                         |
	| Update Field Name           | additionalProp2               |
	| Update Field Original Value | N/A                           |
	| Update Field New Value      | propertyValue2                |''');

		LocalFile.ProjectDetails.viewHistoryEntryByKeywords(
			fieldName = "additionalProp3",
			keyword1 = "Added Product Consumption",
			keyword2 = "A Liferay OSB Product",
			table = '''| Updater Name                | Koroneiki QA Service Producer |
	| Update Summary              | Added Product Consumption     |
	| Update Description          | A Liferay OSB Product         |
	| Update Date                 | Today                         |
	| Update Field Name           | additionalProp3               |
	| Update Field Original Value | N/A                           |
	| Update Field New Value      | propertyValue3                |''');

		LocalFile.ProjectDetails.viewHistoryEntryByKeywords(
			fieldName = "accountId",
			keyword1 = "Added Product Consumption",
			keyword2 = "A Liferay Server Product",
			table = '''| Updater Name                | Koroneiki QA Service Producer |
	| Update Summary              | Added Product Consumption     |
	| Update Description          | A Liferay Server Product      |
	| Update Date                 | Today                         |
	| Update Field Name           | accountId                     |
	| Update Field Original Value | N/A                           |
	| Update Field New Value      | ${staticAccountId}            |''');

		LocalFile.ProjectDetails.viewHistoryEntryByKeywords(
			fieldName = "productEntryId",
			keyword1 = "Added Product Consumption",
			keyword2 = "A Liferay Server Product",
			table = '''| Updater Name                | Koroneiki QA Service Producer |
	| Update Summary              | Added Product Consumption     |
	| Update Description          | A Liferay Server Product      |
	| Update Date                 | Today                         |
	| Update Field Name           | productEntryId                |
	| Update Field Original Value | N/A                           |
	| Update Field New Value      | ${staticProductId2}           |''');

		LocalFile.ProjectDetails.viewHistoryEntryByKeywords(
			fieldName = "additionalProp4",
			keyword1 = "Added Product Consumption",
			keyword2 = "A Liferay Server Product",
			table = '''| Updater Name                | Koroneiki QA Service Producer |
	| Update Summary              | Added Product Consumption     |
	| Update Description          | A Liferay Server Product      |
	| Update Date                 | Today                         |
	| Update Field Name           | additionalProp4               |
	| Update Field Original Value | N/A                           |
	| Update Field New Value      | propertyValue4                |''');

		LocalFile.ProjectDetails.viewHistoryEntryByKeywords(
			fieldName = "additionalProp5",
			keyword1 = "Added Product Consumption",
			keyword2 = "A Liferay Server Product",
			table = '''| Updater Name                | Koroneiki QA Service Producer |
	| Update Summary              | Added Product Consumption     |
	| Update Description          | A Liferay Server Product      |
	| Update Date                 | Today                         |
	| Update Field Name           | additionalProp5               |
	| Update Field Original Value | N/A                           |
	| Update Field New Value      | propertyValue5                |''');

		LocalFile.ProjectDetails.viewHistoryEntryByKeywords(
			fieldName = "additionalProp6",
			keyword1 = "Added Product Consumption",
			keyword2 = "A Liferay Server Product",
			table = '''| Updater Name                | Koroneiki QA Service Producer |
	| Update Summary              | Added Product Consumption     |
	| Update Description          | A Liferay Server Product      |
	| Update Date                 | Today                         |
	| Update Field Name           | additionalProp6               |
	| Update Field Original Value | N/A                           |
	| Update Field New Value      | propertyValue6                |''');
	}

