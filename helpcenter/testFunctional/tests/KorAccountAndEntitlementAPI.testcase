	test Createmultipleaccountentitlementsforaccount {
		KoroneikiAccountAPI._createAccount(table = '''| Code         | KORAUTO                              | |
	| Description  | Test automotive account on koroneiki | |
	| Fax Number   | 555-555-1234                         | |
	| Name         | Koroneiki Automotive                 | |
	| Phone Number | 555-555-5678                         | |
	| Region       | United States                        | |
	| Status       | Active                               | |
	| Tier         | T4                                   | |
	| Website      | www.koroneikiautomotive.com          | |''');

		KoroneikiProductAPI._createProduct(table = '''| Name | Liferay Digital Experience Platform | |''');

		KoroneikiProductAPI._createProduct(table = '''| Name | Liferay Portal Six | |''');

		KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Koroneiki Automotive",
			productName = "Liferay Digital Experience Platform",
			table = '''| End Date                | ${staticEndDate}   |                |
	| Perpetual               | true               |                |
	| Product Field and Value | additionalProp1    | propertyValue1 |
	| Product Field and Value | additionalProp2    | propertyValue2 |
	| Product Field and Value | additionalProp3    | propertyValue3 |
	| Quantity                | 1                  |                |
	| Start Date              | ${staticStartDate} |                |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Koroneiki Automotive",
			productName = "Liferay Portal Six",
			table = '''| End Date                | ${staticEndDate}   |                |
	| Perpetual               | true               |                |
	| Product Field and Value | additionalProp1    | propertyValue1 |
	| Product Field and Value | additionalProp2    | propertyValue2 |
	| Product Field and Value | additionalProp3    | propertyValue3 |
	| Quantity                | 1                  |                |
	| Start Date              | ${staticStartDate} |                |''');

		KoroneikiAccountAPI._createAccountEntitlementDefinition(
			productName = "Liferay Digital Experience Platform",
			table = '''| Description | Entitlement Description1 |
	| Name        | Entitlement Name1        |
	| Status      | Approved                 |''');

		KoroneikiAccountAPI._createAccountEntitlementDefinition(
			productName = "Liferay Portal Six",
			table = '''| Description | Entitlement Description2 |
	| Name        | Entitlement Name2        |
	| Status      | Approved                 |''');

		KoroneikiAccountAPI._viewAccountEntitlementDefinition(
			entitlementDefinitionName = "Entitlement Name1",
			table = '''| Description | Entitlement Description1 |
	| Name        | Entitlement Name1        |
	| Status      | Approved                 |''');

		KoroneikiAccountAPI._viewAccountEntitlementDefinitionViaEntitlementDefinitionKey(
			entitlementDefinitionName = "Entitlement Name1",
			table = '''| Description | Entitlement Description1 |
	| Name        | Entitlement Name1        |
	| Status      | Approved                 |''');

		KoroneikiAccountAPI._viewAccountEntitlementDefinition(
			entitlementDefinitionName = "Entitlement Name2",
			table = '''| Description | Entitlement Description2 |
	| Name        | Entitlement Name2        |
	| Status      | Approved                 |''');

		KoroneikiAccountAPI._viewAccountEntitlementDefinitionViaEntitlementDefinitionKey(
			entitlementDefinitionName = "Entitlement Name2",
			table = '''| Description | Entitlement Description2 |
	| Name        | Entitlement Name2        |
	| Status      | Approved                 |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Entitlement Name1");

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Entitlement Name2");

		KoroneikiAccountAPI._createAccountEntitlementNestedField(entitlementDefinitionName = "Entitlement Name1");

		KoroneikiAccountAPI._renameFirstAccountEntitlementNestedFieldVariable();

		KoroneikiAccountAPI._createAccountEntitlementNestedField(entitlementDefinitionName = "Entitlement Name2");

		KoroneikiAccountAPI._renameSecondAccountEntitlementNestedFieldVariable();

		KoroneikiAccountAPI._viewAccount(
			accountName = "Koroneiki Automotive",
			table = '''| Code                     | KORAUTO                              | |
	| Description              | Test automotive account on koroneiki | |
	| Entitlement Nested Field | Entitlement Name1                    | |
	| Entitlement Nested Field | Entitlement Name2                    | |
	| Fax Number               | 555-555-1234                         | |
	| Name                     | Koroneiki Automotive                 | |
	| Phone Number             | 555-555-5678                         | |
	| Region                   | United States                        | |
	| Status                   | Active                               | |
	| Tier                     | T4                                   | |
	| Website                  | www.koroneikiautomotive.com          | |''');

		KoroneikiAccountAPI._viewEntitlementViaNestedField(
			accountName = "Koroneiki Automotive",
			entitlementDefinitionName = "Entitlement Name1");

		KoroneikiAccountAPI._viewEntitlementViaNestedField(
			accountName = "Koroneiki Automotive",
			entitlementDefinitionName = "Entitlement Name2");
	}

