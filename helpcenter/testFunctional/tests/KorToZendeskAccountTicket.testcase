definition {

	property testray.main.component.name = "Support QA";
	property type = "auto.provisioning";

	setUp {
		OSBAdminRabbitMQ.generateStaticVariables();

		OSBAdminRabbitMQ.generateProvisioningCompanyName();

		OSBAdminRabbitMQ.generateProvisioningProjectName();

		JSONOkta.createOktaUser(table = '''| Screen Name   | zen.koroneiki1                       |
	| Email Address | zen.koroneiki1@lrcustomer.com.broken |
	| First Name    | ZEN                                  |
	| Last Name     | Koroneiki1                           |''');

		JSONOkta.createOktaUser(table = '''| Screen Name   | zen.koroneiki2                       |
	| Email Address | zen.koroneiki2@lrcustomer.com.broken |
	| First Name    | ZEN                                  |
	| Last Name     | Koroneiki2                           |''');
	}

	tearDown {
		ZendeskUserAPI._getDefaultUserId(organizationName = "Korzen - ${staticProjectName}");

		ZendeskUserAPI._renameFirstDefaultUserIdVariable();

		ZendeskUserAPI._getDefaultUserId(organizationName = "Zenkor - ${staticCompanyName}");

		ZendeskUserAPI._renameSecondDefaultUserIdVariable();

		ZendeskTicketAPI._tearDownTicketByIds(ticketIdList = ${staticRequestIdList});

		OSBAdminProject.tearDownProjects(table = '''| ZENKORKORZEN  |
	| ZENKORKORZEN1 |
	| ZENKOR        |''');

		KoroneikiAccountAPI._tearDownAccounts(table = '''| Korzen - ${staticProjectName} |
	| Zenkor - ${staticCompanyName} |''');

		KoroneikiAccountAPI._tearDownAccountsViaAccountFieldNameAndValue(
			fieldName = "Code",
			table = '''| ZENKORKORZEN  |
	| ZENKORKORZEN1 |
	| ZENKOR        |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Gold Subscription");

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Limited Subscription");

		JSONUser.tearDownUsersViaSupport(table = '''| zen.koroneiki1@lrcustomer.com.broken |
	| zen.koroneiki2@lrcustomer.com.broken |''');

		JSONUser.tearDownUsersViaKoroneiki(table = '''| zen.koroneiki1@lrcustomer.com.broken |
	| zen.koroneiki2@lrcustomer.com.broken |''');

		KoroneikiContactAPI._tearDownContacts(table = '''| zen.koroneiki1@lrcustomer.com.broken |
	| zen.koroneiki2@lrcustomer.com.broken |''');

		JSONOkta.tearDownUsers(table = '''| zen.koroneiki1@lrcustomer.com.broken |
	| zen.koroneiki2@lrcustomer.com.broken |''');

		ZendeskTicketAPI._tearDownTicketsByKeywords(table = '''| New Subscription(s) for Korzen - ${staticProjectName} |
	| New Subscription(s) for Korzen - ${staticProjectName} |
	| New Subscription(s) for Zenkor - ${staticCompanyName} |
	| Korzen - ${staticProjectName}                         |
	| Korzen - ${staticProjectName}                         |
	| Korzen - ${staticProjectName}                         |''');

		ZendeskUserAPI._getMultipleUserIdsByEmailAddress(table = '''| zen.koroneiki1@lrcustomer.com.broken |
	| zen.koroneiki2@lrcustomer.com.broken |''');

		ZendeskUserAPI._tearDownUsersByIdList(userIds = ${staticUserIdList});

		ZendeskOrganizationAPI._getMultipleOrganizationExternalIdsByOrganizationNameIfStillPresent(table = '''| Korzen - ${staticProjectName} |
	| Zenkor - ${staticCompanyName} |''');

		ZendeskOrganizationAPI._tearDownOrganizationsByExternalIdList(organizationExternalIds = ${staticOrganizationExternalIdList});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId1});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId2});
	}

	test RemoveAccountServiceSolutionTag {
		OSBAdminRabbitMQ.publishCreateProjectWithNoPartnerMessage(
			routingKey = "dossiera.provisioning.create",
			table = '''| Account Name                           | Zenkor - ${staticCompanyName}              |
	| Address City                           | Diamond Bar                                |
	| Address Country                        | United States                              |
	| Address Postal Code                    | 91765                                      |
	| Address Region                         | California                                 |
	| Address Street                         | 456 Fake Street                            |
	| Contact Email Address                  | zen.koroneiki1@lrcustomer.com.broken       |
	| Contact First Name                     | ZEN                                        |
	| Contact Last Name                      | Koroneiki1                                 |
	| Dossiera Account Key                   | ${staticDossieraAccountKey}                |
	| Dossiera Address Key 1                 | ${staticDossieraAddressKey1}               |
	| Dossiera Address Key 2                 | ${staticDossieraAddressKey2}               |
	| Dossiera Contact Key                   | ${staticDossieraContactKey}                |
	| Dossiera Project Key                   | ${staticDossieraProjectKey}                |
	| End Day                                | ${staticEndDay}                            |
	| End Month                              | ${staticEndMonth}                          |
	| End Year                               | ${staticEndYear}                           |
	| Industry                               | Automotive                                 |
	| Owner Email Address                    | zen.koroneiki2@lrcustomer.com.broken       |
	| Owner First Name                       | ZEN                                        |
	| Owner Last Name                        | Koroneiki2                                 |
	| Partner First Line Support             | false                                      |
	| Product Type                           | New                                        |
	| Product Name                           | Liferay Digital Enterprise - Prod Sizing 4 |
	| Project Name                           | Korzen - ${staticProjectName}              |
	| Project Solution                       | Service Solution                           |
	| Renewal                                | false                                      |
	| Salesforce Opportunity Key             | ${staticSalesforceOpportunityKey}          |
	| Salesforce Opportunity Line Item Key 1 | ${staticSalesforceOpportunityLineItemKey1} |
	| Salesforce Opportunity Line Item Key 2 | ${staticSalesforceOpportunityLineItemKey2} |
	| Salesforce Opportunity Sold By         | Liferay US                                 |
	| Salesforce Opportunity Stage Name      | Closed Won                                 |
	| Salesforce Opportunity Territory       | United States                              |
	| Salesforce Opportunity Type            | New Business                               |
	| Salesforce Owner User Key              | ${staticSalesforceOwnerUserKey}            |
	| Salesforce Project Key                 | ${staticSalesforceProjectKey}              |
	| Start Day                              | ${staticStartDay}                          |
	| Start Month                            | ${staticStartMonth}                        |
	| Start Year                             | ${staticStartYear}                         |
	| Subscription Level                     | Platinum                                   |
	| Version Number                         | 7.1                                        |''');

		JSONOSBAccount.viewSupportOrganizationSync(accountCode = "ZENKORKORZEN");

		ZendeskOrganizationAPI._viewOrganizationSyncFromOsb(organizationName = "Korzen - ${staticProjectName}");

		ZendeskRequestAPI._createRequest(
			requesterEmail = "zen.koroneiki1@lrcustomer.com.broken",
			table = '''| Product           | prd_liferay_dxp_7_2                              |
    | Component         | activation_key_project_administration	           |
    | System Status	    | production_functioning_with_limited_capabilities |
    | Subject           | Request Subject                                  |
    | Description       | Request Description                              |
    | Organization Name	| Korzen - ${staticProjectName}                    |''');

		ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		ZendeskTicketAPI._viewSpecificTagForMultipleTickets(
			tagName = "service_solution",
			ticketIdList = ${staticRequestIdList});

		ZendeskTicketAPI._viewNoSpecificTagForMultipleTickets(
			tagName = "commerce_solution",
			ticketIdList = ${staticRequestIdList});

		OSBAdminRabbitMQ.publishUpdateMessage(
			routingKey = "dossiera.provisioning.project.update",
			table = '''| Project Solution                       |                                            |
	| Salesforce Project Key                 | ${staticSalesforceProjectKey}              |''');

		ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		ZendeskTicketAPI._viewNoSpecificTagForMultipleTickets(
			tagName = "service_solution",
			ticketIdList = ${staticRequestIdList});

		ZendeskTicketAPI._viewNoSpecificTagForMultipleTickets(
			tagName = "commerce_solution",
			ticketIdList = ${staticRequestIdList});
	}

