		LocalFile.Provisioning.gotoLicenses();

		LocalFile.Provisioning.clickGenerateLicenseButton();

		LocalFile.ProvisioningLicense.populateGenerateLicenseForm(table = '''| Account | Select Entity | Korlic - ${staticProjectName} | |
	| Product | Select        | DXP Development               | |
	| Version | Select        | 7.2                           | |
	| Type    | Select        | DXP Development (Developer)   | |''');

		LocalFile.ProvisioningLicense.clickChooseProductPurchaseButton(positionValue = 1);

		LocalFile.ProvisioningLicense.populateGenerateLicenseForm(table = '''| Name                | Input | Korlic - ${staticProjectName} License1 Name        | |
	| Description         | Input | Korlic - ${staticProjectName} License1 Description | |''');

		LocalFile.ProvisioningLicense.clickGenerateLicenseButton();

		LocalFile.ProvisioningLicense.viewLicense(table = '''| Header  | Korlic - ${staticProjectName}    | |
	| Product | DXP Development                  | |''');

		LocalFile.ProvisioningLicense.getLicenseKeyIdViaLicenseDetails();

		LocalFile.ProvisioningLicense._renameFirstLicenseKeyIdVariable();

		LocalFile.Provisioning.gotoLicenses();

		LocalFile.Provisioning.clickGenerateLicenseButton();

		LocalFile.ProvisioningLicense.populateGenerateLicenseForm(table = '''| Account | Select Entity | Korlic - ${staticProjectName} | |
	| Product | Select        | DXP Development               | |
	| Version | Select        | 7.2                           | |
	| Type    | Select        | DXP Development (Developer)   | |''');

		LocalFile.ProvisioningLicense.clickChooseProductPurchaseButton(positionValue = 1);

		LocalFile.ProvisioningLicense.populateGenerateLicenseForm(table = '''| Name                | Input | Korlic - ${staticProjectName} License2 Name        | |
	| Description         | Input | Korlic - ${staticProjectName} License2 Description | |''');

		LocalFile.ProvisioningLicense.clickGenerateLicenseButton();

		LocalFile.ProvisioningLicense.viewLicense(table = '''| Header  | Korlic - ${staticProjectName} | |
	| Product | DXP Development               | |''');

		LocalFile.ProvisioningLicense.getLicenseKeyIdViaLicenseDetails();

		LocalFile.ProvisioningLicense._renameSecondLicenseKeyIdVariable();

		LocalFile.Provisioning.gotoAccounts();

		LocalFile.Provisioning.searchAccounts(keyword = "Korlic");

		LocalFile.Provisioning.clickAccount(accountName = "Korlic - ${staticProjectName}");

		LocalFile.Provisioning.clickTab(tabName = "Licenses");

		LocalFile.ProvisioningAccount.selectLicensesViaLicensesTab(table = '''| Korlic - ${staticProjectName} License1 Name |
	| Korlic - ${staticProjectName} License2 Name |''');

		LocalFile.ProvisioningAccount.clickLicensesActionDropdownButton(action = "Download");

		LocalFile.ProvisioningLicense.clickDeleteLicenseButtonViaDownloadLicensePage(licenseKeyword = "Korlic - ${staticProjectName} License1 Name");

		LocalFile.ProvisioningLicense._viewNoLicenseViaDownloadLicensePage(licenseKeyword = "Korlic - ${staticProjectName} License1 Name");

		LocalFile.ProvisioningLicense._viewLicenseViaDownloadLicensePage(
			licenseKeyword = "Korlic - ${staticProjectName} License2 Name",
			table = '''| Name        | Korlic - ${staticProjectName} License2 Name        |
	| Description | Korlic - ${staticProjectName} License2 Description |
	| Version     | 7.2                                                |
	| Product     | DXP Development                                    |
	| Type        | DXP Development (Developer)                        |
	| Status      | ACTIVE                                             |''');

		LocalFile.ProvisioningLicense.viewDisabledDeleteLicenseButtonViaDownloadLicensePage(licenseKeyword = "Korlic - ${staticProjectName} License2 Name");

		LocalFile.ProvisioningLicense.viewDownloadLicenseButtonViaDownloadLicensePage(table = '''| ${staticLicenseKeyId2} |''');

		LocalFile.ProvisioningLicense.viewNoDownloadLicenseButtonViaDownloadLicensePage(table = '''| ${staticLicenseKeyId1} |''');
	}

	test DeleteDXPlicensefromDXPaggregatelicensedownloadpage {
		LocalFile.OSBAdminRabbitMQ.generateProvisioningProjectName();

		LocalFile.KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORLICKORLIC                         | |
	| Contact Email Address | lic.koroneiki1@lrcustomer.com.broken | |
	| Description           | Test osb account on koroneiki        | |
	| Fax Number            | 555-555-1234                         | |
	| Name                  | Korlic - ${staticProjectName}        | |
	| Phone Number          | 555-555-5678                         | |
	| Profile Email Address | lic.koroneiki1@lrcustomer.com.broken | |
	| Region                | United States                        | |
	| Status                | Active                               | |
	| Tier                  | T4                                   | |
	| Website               | www.koroneikicorporation.com         | |''');

