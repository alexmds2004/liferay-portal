			keyword = "Auto > Added External Link",
			positionValue = 3,
			table = '''| Update Description          | Auto > Added External Link |
	| Update Field Name           | domain                     |
	| Update Field Original Value | N/A                        |
	| Update Field New Value      | salesforce                 |''');

		LocalFile.ProvisioningAccount.viewAccountHistoryEntryByKeywordAndPosition(
