definition {

	property testray.main.component.name = "Support QA";
	property type = "zendesk.integration";

	setUp {
		OSBAdminRabbitMQ.generateProvisioningProjectName();

		Data.generateSupportUser();

		Data._renameFirstSupportUserVariables();

		JSONOkta.createOktaUser(table = '''| Screen Name   | ${staticScreenNameValue1}       |
	| Email Address | ${staticEmailValue1}            |
	| First Name    | ${staticContactFirstNameValue1} |
	| Last Name     | ${staticContactLastNameValue1}  |''');

		Data.generateSupportUser();

		Data._renameSecondSupportUserVariables();

		JSONOkta.createOktaUser(table = '''| Screen Name   | ${staticScreenNameValue2}       |
	| Email Address | ${staticEmailValue2}            |
	| First Name    | ${staticContactFirstNameValue2} |
	| Last Name     | ${staticContactLastNameValue2}  |''');

		KoroneikiAccountAPI._createAccount(table = '''| Code     | OSBZENOSBZEN                  | |
	| Language | English                       | |
	| Name     | Osbzen - ${staticProjectName} | |
	| Region   | United States                 | |
	| Status   | Active                        | |
	| Tier     | T1                            | |''');

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Osbzen - ${staticProjectName}",
			contactEmailAddress = ${staticEmailValue1},
			table = '''| Support Requester |''');

		Data.generateSupportUser();

		Data._renameThirdSupportUserVariables();

		JSONOkta.createOktaUser(table = '''| Screen Name   | ${staticScreenNameValue3}       |
	| Email Address | ${staticEmailValue3}            |
	| First Name    | ${staticContactFirstNameValue3} |
	| Last Name     | ${staticContactLastNameValue3}  |
	| Group         | Employees                       |''');

		KoroneikiContactAPI._viewContactSyncViaEmailAddress(contactEmailAddress = ${staticEmailValue3});

		KoroneikiContactAPI._viewAccountSyncViaUuid(
			accountName = "Liferay, Inc.",
			contactEmailAddress = ${staticEmailValue3});

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - DXP");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - Portal");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - Commerce");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Liferay Employee");

		ZendeskUserAPI._updateUserRoleByEmailAddress(
			roleName = "Agent",
			userEmailAddress = ${staticEmailValue3});
	}

	tearDown {
		ZendeskUserAPI._getDefaultUserId(organizationName = "Osbzen - ${staticProjectName}");

		ZendeskTicketAPI._tearDownTicketByIds(ticketIdList = ${staticRequestIdList});

		OSBAdminProject.tearDownProjects(table = '''| OSBZENOSBZEN |''');

		KoroneikiAccountAPI._tearDownAccounts(table = '''| Osbzen - ${staticProjectName} |''');

		KoroneikiAccountAPI._tearDownAccountsViaAccountFieldNameAndValue(
			fieldName = "Code",
			table = '''| OSBZENOSBZEN |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Gold Subscription");

		JSONUser.tearDownUsers(table = '''| ${staticEmailValue1} |
	| ${staticEmailValue2} |
	| ${staticEmailValue3} |''');

		JSONUser.tearDownUsersViaSupport(table = '''| ${staticEmailValue1} |
	| ${staticEmailValue2} |
	| ${staticEmailValue3} |''');

		JSONUser.tearDownUsersViaKoroneiki(table = '''| ${staticEmailValue1} |
	| ${staticEmailValue2} |
	| ${staticEmailValue3} |''');

		KoroneikiContactAPI._tearDownContacts(table = '''| ${staticEmailValue1} |
	| ${staticEmailValue2} |
	| ${staticEmailValue3} |''');

		JSONOkta.tearDownUsers(table = '''| ${staticEmailValue1} |
	| ${staticEmailValue2} |
	| ${staticEmailValue3} |''');

		ZendeskUserAPI._getMultipleUserIdsByEmailAddress(table = '''| ${staticEmailValue1} |
	| ${staticEmailValue2} |
	| ${staticEmailValue3} |''');

		ZendeskUserAPI._tearDownUsersByIdList(userIds = ${staticUserIdList});

		ZendeskOrganizationAPI._getMultipleOrganizationExternalIdsByOrganizationNameIfStillPresent(table = '''| Osbzen - ${staticProjectName} |''');

		ZendeskOrganizationAPI._tearDownOrganizationsByExternalIdList(organizationExternalIds = ${staticOrganizationExternalIdList});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId});

		MockMock.tearDownMailMessage(
			mockMockAsset = "Reassign Tickets and Downgrade Full Agent",
			mockMockRecipient = "zendesk-admin@liferay.com",
			mockMockSender = "noreply@liferay.com",
			recipientEmailAddress = "zendesk-admin@liferay.com");
	}

	test Viewclosedticketafteremployeedeactivation {
		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Osbzen - ${staticProjectName}",
			contactEmailAddress = ${staticEmailValue2},
			table = '''| Support Requester |''');

		KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Osbzen - ${staticProjectName}",
			productName = "Portal Production",
			table = '''| End Date                | ${staticEndDate}         |   |
	| Original End Date       | ${staticOriginalEndDate} |   |
	| Perpetual               | false                    |   |
	| Product Field and Value | sizing                   | 1 |
	| Product Field and Value | licenses                 | 1 |
	| Product Field and Value | version                  | 6 |
	| Quantity                | 1                        |   |
	| Start Date              | ${staticStartDate}       |   |
	| Status                  | Approved                 |   |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Osbzen - ${staticProjectName}",
			productName = "Gold Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Gold Subscription");

		JSONOSBAccount.viewSupportOrganizationSync(accountCode = "OSBZENOSBZEN");

		ZendeskOrganizationAPI._viewOrganizationSyncFromOsb(organizationName = "Osbzen - ${staticProjectName}");

		ZendeskUserAPI._viewUserSyncFromOsb(userEmailAddress = ${staticEmailValue1});

		ZendeskUserAPI._viewUserSyncFromOsb(userEmailAddress = ${staticEmailValue2});

		ZendeskUserAPI._viewUserOrganizationIdSync(
			organizationName = "Osbzen - ${staticProjectName}",
			userEmailAddress = ${staticEmailValue1});

		ZendeskUserAPI._viewUserOrganizationIdSync(
			organizationName = "Osbzen - ${staticProjectName}",
			userEmailAddress = ${staticEmailValue2});

		ZendeskRequestAPI._createRequest(
			requesterEmail = ${staticEmailValue1},
			table = '''| Product           | prd_liferay_portal_6_2                           |
	| Component         | activation_key_project_administration            |
	| System Status     | production_functioning_with_limited_capabilities |
	| Subject           | Request Subject                                  |
	| Description       | Request Description                              |
	| Organization Name | Osbzen - ${staticProjectName}                    |''');

		ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		ZendeskTicketAPI._assignTicket(
			ticketId = ${staticRequestIdList},
			userEmailAddress = ${staticEmailValue3});

		ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		ZendeskTicketAPI._changeTicketStatus(
			ticketId = ${staticRequestIdList},
			ticketStatus = "closed");

		ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		JSONOkta.deactivateOktaUser(userEmailAddress = ${staticEmailValue3});

		KoroneikiContactAPI._viewNoAccountSyncViaUuid(
			accountName = "Liferay, Inc.",
			contactEmailAddress = ${staticEmailValue3});

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - DXP");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - Portal");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - Commerce");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Liferay Employee");

		ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		ZendeskUserAPI._viewUserSyncFromOsb(userEmailAddress = ${staticEmailValue3});

		ZendeskUserAPI._viewNoUserOrganizationIdSync(
			organizationName = "Liferay, Inc.",
			userEmailAddress = ${staticEmailValue3});

		ZendeskUserAPI._viewNoUserTagSync(
			tag = "osb_lr_employee",
			userEmailAddress = ${staticEmailValue3});

		ZendeskUserAPI._viewUserNameByEmailAddress(
			userEmailAddress = ${staticEmailValue3},
			userName = "${staticContactFirstNameValue3} ${staticContactLastNameValue3}");

		ZendeskUserAPI._viewUserRoleByEmailAddress(
			roleName = "End User",
			userEmailAddress = ${staticEmailValue3});
	}

	test Viewsolvedticketafteremployeedeactivation {
		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Osbzen - ${staticProjectName}",
			contactEmailAddress = ${staticEmailValue2},
			table = '''| Support Requester |''');

		KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Osbzen - ${staticProjectName}",
			productName = "Portal Production",
			table = '''| End Date                | ${staticEndDate}         |   |
	| Original End Date       | ${staticOriginalEndDate} |   |
	| Perpetual               | false                    |   |
	| Product Field and Value | sizing                   | 1 |
	| Product Field and Value | licenses                 | 1 |
	| Product Field and Value | version                  | 6 |
	| Quantity                | 1                        |   |
	| Start Date              | ${staticStartDate}       |   |
	| Status                  | Approved                 |   |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Osbzen - ${staticProjectName}",
			productName = "Gold Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Gold Subscription");

		JSONOSBAccount.viewSupportOrganizationSync(accountCode = "OSBZENOSBZEN");

		ZendeskOrganizationAPI._viewOrganizationSyncFromOsb(organizationName = "Osbzen - ${staticProjectName}");

		ZendeskUserAPI._viewUserSyncFromOsb(userEmailAddress = ${staticEmailValue1});

		ZendeskUserAPI._viewUserSyncFromOsb(userEmailAddress = ${staticEmailValue2});

		ZendeskUserAPI._viewUserOrganizationIdSync(
			organizationName = "Osbzen - ${staticProjectName}",
			userEmailAddress = ${staticEmailValue1});

		ZendeskUserAPI._viewUserOrganizationIdSync(
			organizationName = "Osbzen - ${staticProjectName}",
			userEmailAddress = ${staticEmailValue2});

		ZendeskRequestAPI._createRequest(
			requesterEmail = ${staticEmailValue1},
			table = '''| Product           | prd_liferay_portal_6_2                           |
	| Component         | activation_key_project_administration            |
	| System Status     | production_functioning_with_limited_capabilities |
	| Subject           | Request Subject                                  |
	| Description       | Request Description                              |
	| Organization Name | Osbzen - ${staticProjectName}                    |''');

		ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		ZendeskTicketAPI._assignTicket(
			ticketId = ${staticRequestIdList},
			userEmailAddress = ${staticEmailValue3});

		KoroneikiProductPurchaseAPI.generateStaticPastStartAndEndDate();

		KoroneikiProductPurchaseAPI._updateProductPurchase(
			accountName = "Osbzen - ${staticProjectName}",
			productName = "Portal Production",
			table = '''| End Date                | ${staticPastEndDate}         | |
	| Original End Date       | ${staticPastOriginalEndDate} | |
	| Perpetual               | false                        | |
	| Start Date              | ${staticPastStartDate}       | |
	| Status                  | Approved                     | |''');

		KoroneikiProductPurchaseAPI._updateProductPurchase(
			accountName = "Osbzen - ${staticProjectName}",
			productName = "Gold Subscription",
			table = '''| End Date                | ${staticPastEndDate}         | |
	| Original End Date       | ${staticPastOriginalEndDate} | |
	| Perpetual               | false                        | |
	| Start Date              | ${staticPastStartDate}       | |
	| Status                  | Approved                     | |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Gold Subscription");

		ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		ZendeskTicketAPI._viewTicketStatusSync(
			status = "solved",
			ticketId = ${staticRequestIdList});

		JSONOkta.deactivateOktaUser(userEmailAddress = ${staticEmailValue3});

		KoroneikiContactAPI._viewNoAccountSyncViaUuid(
			accountName = "Liferay, Inc.",
			contactEmailAddress = ${staticEmailValue3});

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - DXP");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - Portal");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - Commerce");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Liferay Employee");

		ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		ZendeskUserAPI._viewUserSyncFromOsb(userEmailAddress = ${staticEmailValue3});

		ZendeskUserAPI._viewNoUserOrganizationIdSync(
			organizationName = "Liferay, Inc.",
			userEmailAddress = ${staticEmailValue3});

		ZendeskUserAPI._viewNoUserTagSync(
			tag = "osb_lr_employee",
			userEmailAddress = ${staticEmailValue3});

		ZendeskUserAPI._viewUserNameByEmailAddress(
			userEmailAddress = ${staticEmailValue3},
			userName = "${staticContactFirstNameValue3} ${staticContactLastNameValue3}");

		ZendeskUserAPI._viewUserRoleByEmailAddress(
			roleName = "Agent",
			userEmailAddress = ${staticEmailValue3});

		ZendeskTicketAPI._viewDefaultUserTicketRequester(
			organizationName = "Osbzen - ${staticProjectName}",
			ticketId = ${staticRequestIdList});

		MockMock.gotoSupportMailMessage(
			mockMockAsset = "Reassign Tickets and Downgrade Full Agent",
			mockMockRecipient = "zendesk-admin@liferay.com",
			mockMockSender = "noreply@liferay.com",
			recipientEmailAddress = "zendesk-admin@liferay.com");

		MockMock.viewMailMessage(table = '''| Please downgrade ${staticContactFirstNameValue3} ${staticContactLastNameValue3} ${staticEmailValue3} on Zendesk. They have the following non-closed tickets assigned to them. |''');

		MockMock.viewMailMessage(table = '''| ${staticRequestIdList} |''');
	}

	test Viewticketafteremployeedeactivation {
		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Osbzen - ${staticProjectName}",
			contactEmailAddress = ${staticEmailValue2},
			table = '''| Support Requester |''');

		KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Osbzen - ${staticProjectName}",
			productName = "Portal Production",
			table = '''| End Date                | ${staticEndDate}         |   |
	| Original End Date       | ${staticOriginalEndDate} |   |
	| Perpetual               | false                    |   |
	| Product Field and Value | sizing                   | 1 |
	| Product Field and Value | licenses                 | 1 |
	| Product Field and Value | version                  | 6 |
	| Quantity                | 1                        |   |
	| Start Date              | ${staticStartDate}       |   |
	| Status                  | Approved                 |   |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Osbzen - ${staticProjectName}",
			productName = "Gold Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Gold Subscription");

		JSONOSBAccount.viewSupportOrganizationSync(accountCode = "OSBZENOSBZEN");

		ZendeskOrganizationAPI._viewOrganizationSyncFromOsb(organizationName = "Osbzen - ${staticProjectName}");

		ZendeskUserAPI._viewUserSyncFromOsb(userEmailAddress = ${staticEmailValue1});

		ZendeskUserAPI._viewUserSyncFromOsb(userEmailAddress = ${staticEmailValue2});

		ZendeskUserAPI._viewUserOrganizationIdSync(
			organizationName = "Osbzen - ${staticProjectName}",
			userEmailAddress = ${staticEmailValue1});

		ZendeskUserAPI._viewUserOrganizationIdSync(
			organizationName = "Osbzen - ${staticProjectName}",
			userEmailAddress = ${staticEmailValue2});

		ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		ZendeskRequestAPI._createRequest(
			requesterEmail = ${staticEmailValue1},
			table = '''| Product           | prd_liferay_portal_6_2                           |
	| Component         | activation_key_project_administration            |
	| System Status     | production_functioning_with_limited_capabilities |
	| Subject           | Request Subject                                  |
	| Description       | Request Description                              |
	| Organization Name | Osbzen - ${staticProjectName}                    |''');

		ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		ZendeskTicketAPI._assignTicket(
			ticketId = ${staticRequestIdList},
			userEmailAddress = ${staticEmailValue3});

		ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		JSONOkta.deactivateOktaUser(userEmailAddress = ${staticEmailValue3});

		KoroneikiContactAPI._viewNoAccountSyncViaUuid(
			accountName = "Liferay, Inc.",
			contactEmailAddress = ${staticEmailValue3});

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - DXP");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - Portal");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - Commerce");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Liferay Employee");

		ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		ZendeskUserAPI._viewUserSyncFromOsb(userEmailAddress = ${staticEmailValue3});

		ZendeskUserAPI._viewNoUserOrganizationIdSync(
			organizationName = "Liferay, Inc.",
			userEmailAddress = ${staticEmailValue3});

		ZendeskUserAPI._viewNoUserTagSync(
			tag = "osb_lr_employee",
			userEmailAddress = ${staticEmailValue3});

		ZendeskUserAPI._viewUserNameByEmailAddress(
			userEmailAddress = ${staticEmailValue3},
			userName = "${staticContactFirstNameValue3} ${staticContactLastNameValue3}");

		ZendeskUserAPI._viewUserRoleByEmailAddress(
			roleName = "Agent",
			userEmailAddress = ${staticEmailValue3});

		ZendeskTicketAPI._viewTicketAssignee(
			ticketId = ${staticRequestIdList},
			userEmailAddress = ${staticEmailValue3});

		MockMock.gotoSupportMailMessage(
			mockMockAsset = "Reassign Tickets and Downgrade Full Agent",
			mockMockRecipient = "zendesk-admin@liferay.com",
			mockMockSender = "noreply@liferay.com",
			recipientEmailAddress = "zendesk-admin@liferay.com");

		MockMock.viewMailMessage(table = '''| Please downgrade ${staticContactFirstNameValue3} ${staticContactLastNameValue3} ${staticEmailValue3} on Zendesk. They have the following non-closed tickets assigned to them. |''');

		MockMock.viewMailMessage(table = '''| ${staticRequestIdList} |''');
	}

}