	| Status                  | Approved                 | |''');

		OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		Provisioning.gotoLicenses();

		Provisioning.clickGenerateLicenseButton();

		ProvisioningLicense.populateGenerateLicenseForm(table = '''| Account | Select Entity | Korlic - ${staticProjectName} | |
	| Product | Select        | DXP Production                | |
	| Version | Select        | 7.2                           | |
	| Type    | Select        | DXP Production                | |''');

		ProvisioningLicense.clickChooseProductPurchaseButton(positionValue = 1);

		ProvisioningLicense.populateGenerateLicenseForm(table = '''| Host Name     | Input    | localhost         | |
	| IP Addresses  | Textarea | 123.45.67.89      | |
	| MAC Addresses | Textarea | 0A-1B-2C-3D-4E-5F | |''');

		ProvisioningLicense.clickGenerateLicenseButton();

		ProvisioningLicense.viewLicense(table = '''| Header  | Korlic - ${staticProjectName} | |
	| Product | DXP Production                | |''');

		Provisioning.gotoLicenses();

		Provisioning.searchLicenses(keyword = ${staticAccountKey});

		Provisioning._viewLicenseViaIndex(
			licenseKeyword = "Korlic - ${staticProjectName}",
			table = '''| Name          | Korlic - ${staticProjectName}  |
	| Description   | Korlic - ${staticProjectName}  |
	| Account       | Korlic - ${staticProjectName}  |
	| Product       | DXP Production                 |
	| Type          | Production                     |
	| Details       | Host Name: localhost           |
	| Details       | IP Address: 123.45.67.89       |
	| Details       | MAC Address: 0A-1B-2C-3D-4E-5F |
	| Status        | ACTIVE                         |
	| Complimentary | false                          |''');

		ProvisioningLicenseAPI._deactivateLicense(
			accountName = "Korlic - ${staticProjectName}",
			licenseName = "Korlic - ${staticProjectName}");

		Provisioning.searchLicenses(keyword = ${staticAccountKey});

		Provisioning._viewLicenseViaIndex(
			licenseKeyword = "Korlic - ${staticProjectName}",
			table = '''| Name          | Korlic - ${staticProjectName}  |
	| Description   | Korlic - ${staticProjectName}  |
	| Account       | Korlic - ${staticProjectName}  |
	| Product       | DXP Production                 |
	| Type          | Production                     |
	| Details       | Host Name: localhost           |
	| Details       | IP Address: 123.45.67.89       |
	| Details       | MAC Address: 0A-1B-2C-3D-4E-5F |
	| Status        | DEACTIVATED                    |
	| Complimentary | false                          |''');

