definition {

	property testray.main.component.name = "Support QA";
	property type = "provisioning.license.integration";

	setUp {
		Passwords.getPasswords();

		KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		KoroneikiProductPurchaseAPI.generateStaticFullStartAndEndDate();

		KoroneikiProductPurchaseAPI.generateStaticInfiniteEndDates();

		KoroneikiProductPurchaseAPI.generateStaticMmDdYyyyStartAndEndDate();

		KoroneikiProductPurchaseAPI.generateStaticPastStartAndEndDate();

		KoroneikiProductPurchaseAPI.generateStaticFutureStartAndEndDate();

		KoroneikiProductPurchaseAPI.generateStaticFullFutureStartAndEndDate();
	}

	tearDown {
		ZendeskUserAPI._getDefaultUserId(organizationName = "Korlic - ${staticProjectName}");

		KoroneikiProductConsumptionAPI._tearDownProductConsumptionList(
			accountName = "Korlic - ${staticProjectName}",
			table = '''| DXP OEM                          |
	| DXP Production                   |
	| DXP Non-Production               |
	| Portal Production                |
	| DXP Development                  |
	| Commerce Subscription Production |
	| DXP Unlimited Enterprise-Wide    |''');

		KoroneikiProductConsumptionAPI._tearDownProductConsumptions(
			accountName = "Korlic - ${staticProjectName}",
			table = '''| DXP OEM                                         |
	| DXP Limited                                     |
	| DXP Non-Production                              |
	| Portal Per User                                 |
	| Commerce Subscription Development               |
	| Commerce Subscription Non-Production            |
	| Commerce Subscription Backup                    |
	| Commerce Subscription Unlimited Enterprise-Wide |
	| Portal Production                               |
	| DXP Unlimited Enterprise-Wide                   |''');

		OSBAdminProject.tearDownProjects(table = '''| KORLICKORLIC |''');

		KoroneikiAccountAPI._tearDownAccounts(table = '''| Korlic - ${staticProjectName} |''');

		KoroneikiAccountAPI._tearDownAccountsViaAccountFieldNameAndValue(
			fieldName = "Code",
			table = '''| KORLICKORLIC |''');

		ZendeskOrganizationAPI._getMultipleOrganizationExternalIdsByOrganizationNameIfStillPresent(table = '''| Korlic - ${staticProjectName} |''');

		ZendeskOrganizationAPI._tearDownOrganizationsByExternalIdList(organizationExternalIds = ${staticOrganizationExternalIdList});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId});
	}

	test AttemptdeveloperDXPlicensedownloadviaAPIforanaccountwithselfprovisioningdisabled {
		OSBAdminRabbitMQ.generateProvisioningProjectName();

		KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORLICKORLIC                         | |
	| Contact Email Address | lic.koroneiki1@lrcustomer.com.broken | |
	| Description           | Test osb account on koroneiki        | |
	| Fax Number            | 555-555-1234                         | |
	| Name                  | Korlic - ${staticProjectName}        | |
	| Phone Number          | 555-555-5678                         | |
	| Profile Email Address | lic.koroneiki1@lrcustomer.com.broken | |
	| Region                | United States                        | |
	| Status                | Active                               | |
	| Tier                  | T4                                   | |
	| Website               | www.koroneikicorporation.com         | |''');

		KoroneikiAccountAPI._generateAccountKey(accountName = "Korlic - ${staticProjectName}");

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korlic - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| End Date                | ${staticEndDate}         |   |
	| Original End Date       | ${staticOriginalEndDate} |   |
	| Perpetual               | false                    |   |
	| Product Field and Value | sizing                   | 1 |
	| Product Field and Value | licenses                 | 1 |
	| Product Field and Value | version                  | 7 |
	| Quantity                | 1                        |   |
	| Start Date              | ${staticStartDate}       |   |
	| Status                  | Approved                 |   |''');

		KoroneikiProductPurchaseAPI._generateProductPurchaseId(
			accountName = "Korlic - ${staticProjectName}",
			productName = "DXP Production");

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korlic - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		Provisioning.gotoAccounts();

		Provisioning.searchAccounts(keyword = "Korlic");

		Provisioning.clickAccount(accountName = "Korlic - ${staticProjectName}");

		Provisioning.clickTab(tabName = "Licenses");

		ProvisioningAccount.clickGenerateLicenseButton();

		ProvisioningLicense.populateGenerateLicenseForm(table = '''| Product | Select | DXP Production                | |
	| Version | Select | 7.2                           | |
	| Type    | Select | DXP Production                | |''');

		ProvisioningLicense.clickChooseProductPurchaseButton(positionValue = 1);

		ProvisioningLicense.populateGenerateLicenseForm(table = '''| Host Name     | Input    | localhost         | |
	| IP Addresses  | Textarea | 123.45.67.89      | |
	| MAC Addresses | Textarea | 0A-1B-2C-3D-4E-5F | |''');

		ProvisioningLicense.clickGenerateLicenseButton();

		ProvisioningLicense.viewLicense(table = '''| Header  | Korlic - ${staticProjectName} | |
	| Product | DXP Production                | |''');

		Provisioning.gotoLicenses();

		Provisioning.searchLicenses(keyword = ${staticAccountKey});

		Provisioning._viewLicenseViaIndex(
			licenseKeyword = "Korlic - ${staticProjectName}",
			table = '''| Name          | Korlic - ${staticProjectName}  |
	| Description   | Korlic - ${staticProjectName}  |
	| Account       | Korlic - ${staticProjectName}  |
	| Product       | DXP Production                 |
	| Type          | Production                     |
	| Details       | Host Name: localhost           |
	| Details       | IP Address: 123.45.67.89       |
	| Details       | MAC Address: 0A-1B-2C-3D-4E-5F |
	| Status        | ACTIVE                         |
	| Complimentary | false                          |''');

		Provisioning.clickLicense(licenseKeyword = "Korlic - ${staticProjectName}");

		ProvisioningLicense.viewLicense(table = '''| Header        | Korlic - ${staticProjectName} | |
	| Product       | DXP Production                | |
	| Version       | 7.2                           | |
	| Type          | Production                    | |
	| Host Name     | localhost                     | |
	| IP Addresses  | 123.45.67.89                  | |
	| MAC Addresses | 0A-1B-2C-3D-4E-5F             | |
	| Owner         | Korlic - ${staticProjectName} | |
	| Description   | Korlic - ${staticProjectName} | |
	| Complimentary | No                            | |
	| Status        | ACTIVE                        | |
	| Created By    | Test Test                     | |''');

		Provisioning.gotoAccounts();

		Provisioning.searchAccounts(keyword = "Korlic");

		Provisioning.clickAccount(accountName = "Korlic - ${staticProjectName}");

		Provisioning.clickTab(tabName = "Details");

		ProvisioningAccount.editAccountDetails(table = '''| Self Provisioning | Toggle Switch | false | |''');

		ProvisioningAccount.assertToggleSwitchDisabled(
			field = "Self Provisioning",
			positionValue = 1);

		ProvisioningLicenseAPI._downloadNoDeveloperLicense(
			accountName = "Korlic - ${staticProjectName}",
			productGroup = "DXP",
			productVersion = "7.2");
	}

	test AttempttogenerateDXPProductioncomplimentarylicenseviaProvisioningAPIviaaccountwithnopermanentlicenses {
		OSBAdminRabbitMQ.generateProvisioningProjectName();

		KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORLICKORLIC                         | |
	| Contact Email Address | lic.koroneiki1@lrcustomer.com.broken | |
	| Description           | Test osb account on koroneiki        | |
	| Fax Number            | 555-555-1234                         | |
	| Name                  | Korlic - ${staticProjectName}        | |
	| Phone Number          | 555-555-5678                         | |
	| Profile Email Address | lic.koroneiki1@lrcustomer.com.broken | |
	| Region                | United States                        | |
	| Status                | Active                               | |
	| Tier                  | T4                                   | |
	| Website               | www.koroneikicorporation.com         | |''');

		KoroneikiAccountAPI._updateAccount(
			accountName = "Korlic - ${staticProjectName}",
			table = '''| Account Field and Value | allowPermanentLicenses | false |
	| Account Field and Value | allowComplimentary     | true  |''');

		KoroneikiAccountAPI._generateAccountKey(accountName = "Korlic - ${staticProjectName}");

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korlic - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| End Date                | ${staticFutureStartDate} |   |
	| Original End Date       | ${staticFutureStartDate} |   |
	| Perpetual               | false                    |   |
	| Product Field and Value | sizing                   | 1 |
	| Product Field and Value | licenses                 | 1 |
	| Product Field and Value | version                  | 7 |
	| Quantity                | 1                        |   |
	| Start Date              | ${staticStartDate}       |   |
	| Status                  | Approved                 |   |''');

		KoroneikiProductPurchaseAPI._generateProductPurchaseId(
			accountName = "Korlic - ${staticProjectName}",
			productName = "DXP Production");

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Korlic - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		ProvisioningLicenseAPI.createLicense(
			accountName = "Korlic - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| Active                     | true                          |
	| Complimentary              | true                          |
	| Expiration Date            | ${staticEndDate}              |
	| License Entry Type         | production                    |
	| Max Cluster Nodes          | 0                             |
	| Name                       | Korlic - ${staticProjectName} |
	| Product Version            | 7.4                           |
	| Start Date                 | ${staticStartDate}            |''');

		Provisioning.gotoLicenses();

		Provisioning.searchAccounts(keyword = "Korlic");

		Provisioning.clickAccount(accountName = "Korlic - ${staticProjectName}");

		Provisioning.clickTab(tabName = "Licenses");

		ProvisioningLicenseAPI._viewNoLicense(
			accountName = "Korlic - ${staticProjectName}",
			licenseName = "Korlic - ${staticProjectName}",
			table = '''| Active | true |''');
	}

