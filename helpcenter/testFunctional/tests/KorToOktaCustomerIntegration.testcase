definition {

	property testray.main.component.name = "Support QA";
	property type = "okta.integration";

	setUp {
		Passwords.getPasswords();

		JSONOkta.createOktaUser(table = '''| Screen Name   | okt.koroneiki1                       |
	| Email Address | okt.koroneiki1@lrcustomer.com.broken |
	| First Name    | OKT                                  |
	| Last Name     | Koroneiki1                           |''');
	}

	tearDown {
		ZendeskUserAPI._getDefaultUserId(organizationName = "Oktkor - ${staticProjectName}");

		OSBAdminProject.tearDownProjects(table = '''| OKTKOROKTKOR |''');

		KoroneikiAccountAPI._tearDownAccounts(table = '''| Oktkor - ${staticProjectName} |''');

		KoroneikiAccountAPI._tearDownAccountsViaAccountFieldNameAndValue(
			fieldName = "Code",
			table = '''| OKTKOROKTKOR |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		JSONUser.tearDownUsersViaSupport(table = '''| okt.koroneiki1@lrcustomer.com.broken |
	| okt.koroneiki2@lrcustomer.com.broken |''');

		JSONUser.tearDownUsersViaKoroneiki(table = '''| okt.koroneiki1@lrcustomer.com.broken |
	| okt.koroneiki2@lrcustomer.com.broken |''');

		KoroneikiContactAPI._tearDownContacts(table = '''| okt.koroneiki1@lrcustomer.com.broken |
	| okt.koroneiki2@lrcustomer.com.broken |''');

		JSONOkta.tearDownUsers(table = '''| okt.koroneiki1@lrcustomer.com.broken |
	| okt.koroneiki2@lrcustomer.com.broken |''');

		ZendeskUserAPI._getMultipleUserIdsByEmailAddress(table = '''| okt.koroneiki1@lrcustomer.com.broken |
	| okt.koroneiki2@lrcustomer.com.broken |''');

		ZendeskUserAPI._tearDownUsersByIdList(userIds = ${staticUserIdList});

		ZendeskOrganizationAPI._getMultipleOrganizationExternalIdsByOrganizationNameIfStillPresent(table = '''| Oktkor - ${staticProjectName} |''');

		ZendeskOrganizationAPI._tearDownOrganizationsByExternalIdList(organizationExternalIds = ${staticOrganizationExternalIdList});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId});
	}

	test Synccustomergroupmembershipremovalviakoroneikitookta {
		OSBAdminRabbitMQ.generateProvisioningProjectName();

		KoroneikiAccountAPI._createAccount(table = '''| Code                  | OKTKOROKTKOR                         | |
	| Contact Email Address | okt.koroneiki1@lrcustomer.com.broken | |
	| Description           | Test okt account on koroneiki        | |
	| Fax Number            | 555-555-1234                         | |
	| Name                  | Oktkor - ${staticProjectName}        | |
	| Phone Number          | 555-555-5678                         | |
	| Profile Email Address | okt.koroneiki1@lrcustomer.com.broken | |
	| Region                | United States                        | |
	| Status                | Active                               | |
	| Tier                  | T4                                   | |
	| Website               | www.koroneikicorporation.com         | |''');

		KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Oktkor - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | true                     | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Oktkor - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | true                     | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Oktkor - ${staticProjectName}",
			contactEmailAddress = "okt.koroneiki1@lrcustomer.com.broken",
			table = '''| Support User |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		JSONOSBAccount.viewSupportOrganizationSync(accountCode = "OKTKOROKTKOR");

		JSONOkta.viewOktaUserGroupMembership(
			groupName = "Customers",
			userEmailAddress = "okt.koroneiki1@lrcustomer.com.broken");

		ProvisioningContactAPI._unassignContactRolesToContact(
			accountName = "Oktkor - ${staticProjectName}",
			table = '''| Support User |''',
			userEmailAddress = "okt.koroneiki1@lrcustomer.com.broken");

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		JSONOkta.viewNoOktaUserGroupMembership(
			groupName = "Customers",
			userEmailAddress = "okt.koroneiki1@lrcustomer.com.broken");

		KoroneikiContactAPI._viewContactUuidAndUserUuidComparison(contactEmailAddress = "okt.koroneiki1@lrcustomer.com.broken");
	}

	test Synccustomergroupmembershipremovalviaprovisioningtookta {
		OSBAdminRabbitMQ.generateProvisioningProjectName();

		KoroneikiAccountAPI._createAccount(table = '''| Code                  | OKTKOROKTKOR                         | |
	| Contact Email Address | okt.koroneiki1@lrcustomer.com.broken | |
	| Description           | Test okt account on koroneiki        | |
	| Fax Number            | 555-555-1234                         | |
	| Name                  | Oktkor - ${staticProjectName}        | |
	| Phone Number          | 555-555-5678                         | |
	| Profile Email Address | okt.koroneiki1@lrcustomer.com.broken | |
	| Region                | United States                        | |
	| Status                | Active                               | |
	| Tier                  | T4                                   | |
	| Website               | www.koroneikicorporation.com         | |''');

		KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Oktkor - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | true                     | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Oktkor - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | true                     | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Oktkor - ${staticProjectName}",
			contactEmailAddress = "okt.koroneiki1@lrcustomer.com.broken",
			table = '''| Support User |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		JSONOSBAccount.viewSupportOrganizationSync(accountCode = "OKTKOROKTKOR");

		JSONOkta.viewOktaUserGroupMembership(
			groupName = "Customers",
			userEmailAddress = "okt.koroneiki1@lrcustomer.com.broken");

		OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		Provisioning.gotoAccounts();

		Provisioning.searchAccounts(keyword = "Oktkor");

		Provisioning.clickAccount(accountName = "Oktkor - ${staticProjectName}");

		Provisioning.clickTab(tabName = "Contacts");

		ProvisioningAccount.clickContactActionDropdownButton(
			action = "Unassign",
			emailAddress = "okt.koroneiki1@lrcustomer.com.broken");

		ProvisioningAccount._viewNoAccountContact(emailAddress = "okt.koroneiki1@lrcustomer.com.broken");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		Provisioning.gotoUsers();

		Provisioning.searchUsers(keyword = "okt.koroneiki1");

		Provisioning.clickUser(userName = "OKT Koroneiki1");

		ProvisioningUser.clickSyncWithOktaButton();

		ZendeskHomepage.pause(timeInSeconds = 10);

		JSONOkta.viewNoOktaUserGroupMembership(
			groupName = "Customers",
			userEmailAddress = "okt.koroneiki1@lrcustomer.com.broken");

		KoroneikiContactAPI._viewContactUuidAndUserUuidComparison(contactEmailAddress = "okt.koroneiki1@lrcustomer.com.broken");
	}

