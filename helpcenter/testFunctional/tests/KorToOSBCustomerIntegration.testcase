		ProjectDetails.gotoProjectDetailsPage();

		ProjectDetails.searchKeyword(keyword = "Kchild");

		ProjectDetails.gotoProject(projectName = "Kchild - ${staticProjectName}");

		ProjectDetails.gotoHistory();

		ProjectDetails.viewHistoryEntryByThreeKeywords(
			fieldName = "Contact Role",
			keyword1 = "Koroneiki QA Service Producer",
			keyword2 = "Assigned Contact",
			keyword3 = "OSB Koroneiki2",
			table = '''| Updater Name                | Koroneiki QA Service Producer |
	| Update Summary              | Assigned Contact              |
	| Update Description          | OSB Koroneiki2                |
	| Update Date                 | Today                         |
	| Update Field Name           | Contact Role                  |
	| Update Field Original Value | N/A                           |
	| Update Field New Value      | Member                        |''');

		ProjectDetails.viewHistoryEntryByThreeKeywords(
			fieldName = "Contact",
			keyword1 = "Updated Team",
			keyword2 = "Kchild - ${staticProjectName} Member",
			keyword3 = "OSB Koroneiki2",
			table = '''| Updater Name                | Koroneiki QA Service Producer        |
	| Update Summary              | Updated Team                         |
	| Update Description          | Kchild - ${staticProjectName} Member |
	| Update Date                 | Today                                |
	| Update Field Name           | Contact                              |
	| Update Field Original Value | N/A                                  |
	| Update Field New Value      | OSB Koroneiki2                       |''');
	}

