	| Status        | OPEN            |''');

		LocalFile.ZendeskRequest.gotoViaIndex(requestSubject = "Request Subject");

		LocalFile.ZendeskRequest.submitComment(table = '''| Comment     | Request Comment |
	| Attachments | Document_1.txt  |''');

		LocalFile.ZendeskRequest.viewComment(
			commentContent = "Request Comment",
			table = '''| Author      | Zendesk Enduser2 |
	| Comment     | Request Comment  |
	| Attachments | Document_1.txt   |''');

		LocalFile.ZendeskRequest.view(table = '''| Subject       | Request Subject                                    |
	| Status        | OPEN                                               |
	| Requester     | Zendesk Enduser1                                   |
	| Priority      | Normal                                             |
	| Product       | Liferay DXP > 7.4                                  |
	| Sub-Status    | —                                                  |
	| Component     | Activation Key & Project Administration            |
	| System Status | Production > Functioning with limited capabilities |
	| Attachments   | Document_1.txt                                     |''');
	}

	test RequestAssignee {
		LocalFile.ZendeskUserAPI._createUser(table = '''| Name             | Zendesk Enduser1                    |
	| Tags             | osb_customer,osb_kb                 |
	| Password         | ${staticZendeskAdminPassword}       |
	| Role             | End-user                            |
	| Access           | Organization                        |
	| Email            | zendesk.enduser1@zendesk.com.broken |
	| Phone Number     | +1 (555) 555-5555                   |
	| Organization     | Frontend Org Name 1                 |
	| Language         | English                             |
	| Time Zone        | Pacific Time (US & Canada)          |
	| External ID      | Enduser1                            |''');

		LocalFile.ZendeskUserAPI._createUser(table = '''| Name             | Zendesk Endagent1                    |
	| Password         | ${staticZendeskAdminPassword}        |
	| Role             | Agent                                |
	| Email            | zendesk.endagent1@liferay.com.broken |
