	test ViewClosedRequest {
		LocalFile.ZendeskUserAPI._createUser(table = '''| Name             | Zendesk Enduser1                    |
	| Tags             | osb_customer,osb_kb                 |
	| Password         | ${staticZendeskAdminPassword}       |
	| Role             | End-user                            |
	| Access           | Organization                        |
	| Email            | zendesk.enduser1@zendesk.com.broken |
	| Phone Number     | +1 (555) 555-5555                   |
	| Organization     | Frontend Org Name 1                 |
	| Language         | English                             |
	| Time Zone        | Pacific Time (US & Canada)          |
	| External ID      | Enduser1                            |''');

		LocalFile.ZendeskUserAPI._createUser(table = '''| Name             | Zendesk Endagent1                    |
	| Password         | ${staticZendeskAdminPassword}        |
	| Role             | Agent                                |
	| Email            | zendesk.endagent1@liferay.com.broken |
	| Phone Number     | +1 (555) 555-5555                    |
	| Language         | English                              |
	| Time Zone        | Pacific Time (US & Canada)           |
	| External ID      | Endagent1                            |''');

		LocalFile.ZendeskUserAPI._assignUserToGroup(
			groupName = "Provisioning - US",
			userEmailAddress = "zendesk.endagent1@liferay.com.broken");

		LocalFile.ZendeskRequestAPI._createRequest(
			requesterEmail = "zendesk.enduser1@zendesk.com.broken",
			table = '''| Product                  | prd_liferay_dxp_7_4                              |
	| Component                | activation_key_project_administration            |
	| System Status            | production_functioning_with_limited_capabilities |
	| Subject                  | Request Subject                                  |
	| Description              | Request Description                              |
	| Organization External ID | 12341234                                         |''');

		LocalFile.ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		LocalFile.ZendeskTicketAPI._assignTicket(
			ticketId = ${staticRequestIdList},
			userEmailAddress = "zendesk.endagent1@liferay.com.broken");

		LocalFile.ZendeskTicketAPI._changeTicketStatusAndSubStatusAndLongTermResolution(
			ticketId = ${staticRequestIdList},
			ticketLongTermResolution = "bug_fix",
			ticketStatus = "solved",
			ticketSubStatus = "completed");

		LocalFile.ZendeskTicketAPI._assignTagsToTicket(
			table = '''| auto_closed |''',
			ticketId = ${staticRequestIdList});

		LocalFile.ZendeskHomepage.login(
			userEmailAddress = "zendesk.enduser1@zendesk.com.broken",
			userPassword = ${staticZendeskAdminPassword});

		LocalFile.ZendeskHomepage.gotoMyActivities();

		LocalFile.ZendeskRequest.gotoViaIndex(requestSubject = "Request Subject");

		LocalFile.ZendeskRequest.view(table = '''| Subject       | Request Subject                                    |
	| Status        | SOLVED                                             |
	| Requester     | Zendesk Enduser1                                   |
	| Assigned to   | Zendesk Endagent1                                  |
	| Priority      | Normal                                             |
	| Product       | Liferay DXP > 7.4                                  |
	| Sub-Status    | Completed                                          |
	| Component     | Activation Key & Project Administration            |
	| System Status | Production > Functioning with limited capabilities |''');

		LocalFile.ZendeskRequest.viewNoCommentField();

		LocalFile.ZendeskRequest.viewClosedCommentMessage();

		LocalFile.ZendeskRequest.viewNoLargeAttachmentLink();
	}

