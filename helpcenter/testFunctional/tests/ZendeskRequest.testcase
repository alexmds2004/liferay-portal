definition {

	property testray.main.component.name = "Support QA";
	property type = "zendesk.frontend";

	setUp {
		LocalFile.Passwords.getPasswords();

		LocalFile.ZendeskOrganizationAPI._createOrganization(table = '''| Status           | Approved                   |
	| Name             | Frontend Org Name 1        |
	| Tags             | liferay_dxp,liferay_portal |
	| Shared Tickets   | true                       |
	| Shared Comments  | true                       |
	| SLA              | Gold                       |
	| Tier             | T4                         |
	| Support Region   | US                         |
	| Support Language | English                    |
	| External ID      | 12341234                   |''');

		LocalFile.ZendeskOrganizationAPI._createOrganization(table = '''| Status           | Approved                   |
	| Name             | Frontend Org Name 2        |
	| Tags             | liferay_dxp,liferay_portal |
	| Shared Tickets   | true                       |
	| Shared Comments  | true                       |
	| SLA              | Gold                       |
	| Tier             | T4                         |
	| Support Region   | Japan                      |
	| Support Language | Japanese                   |
	| External ID      | 56785678                   |''');

		LocalFile.ZendeskOrganizationAPI._createOrganization(table = '''| Status           | Approved                   |
	| Name             | Frontend Org Name 3        |
	| Tags             | liferay_dxp,liferay_portal |
	| Shared Tickets   | true                       |
	| Shared Comments  | true                       |
	| SLA              | Gold                       |
	| Tier             | T4                         |
	| Support Region   | Spain                      |
	| Support Language | Spanish                    |
	| External ID      | 91239123                   |''');
	}

	tearDown {
		LocalFile.ZendeskUserAPI._tearDownUsersRequestedTicketsByExternalIdTable(table = '''| Enduser1  |
	| Enduser2  |
	| Endagent1 |''');

		LocalFile.ZendeskUserAPI._tearDownUsersByExternalIdTable(table = '''| Enduser1  |
	| Enduser2  |
	| Endagent1 |''');

		LocalFile.ZendeskOrganizationAPI._tearDownOrganizationsByExternalIdTable(table = '''| 12341234 |  
	| 56785678 | 
	| 91239123 |''');
	}

	test CreateFollowUp {
		LocalFile.ZendeskUserAPI._createUser(table = '''| Name             | Zendesk Enduser1                    |
	| Tags             | osb_customer,osb_kb                 |
	| Password         | ${staticZendeskAdminPassword}       |
	| Role             | End-user                            |
	| Access           | Organization                        |
	| Email            | zendesk.enduser1@zendesk.com.broken |
	| Phone Number     | +1 (555) 555-5555                   |
	| Organization     | Frontend Org Name 1                 |
	| Language         | English                             |
	| Time Zone        | Pacific Time (US & Canada)          |
	| External ID      | Enduser1                            |''');

		LocalFile.ZendeskUserAPI._createUser(table = '''| Name             | Zendesk Endagent1                    |
	| Password         | ${staticZendeskAdminPassword}        |
	| Role             | Agent                                |
	| Email            | zendesk.endagent1@liferay.com.broken |
	| Phone Number     | +1 (555) 555-5555                    |
	| Language         | English                              |
	| Time Zone        | Pacific Time (US & Canada)           |
	| External ID      | Endagent1                            |''');

		LocalFile.ZendeskUserAPI._assignUserToGroup(
			groupName = "Provisioning - US",
			userEmailAddress = "zendesk.endagent1@liferay.com.broken");

		LocalFile.ZendeskRequestAPI._createRequest(
			requesterEmail = "zendesk.enduser1@zendesk.com.broken",
			table = '''| Product                  | prd_liferay_dxp_7_4                              |
	| Component                | activation_key_project_administration            |
	| System Status            | production_functioning_with_limited_capabilities |
	| Subject                  | Request Subject                                  |
	| Description              | Request Description                              |
	| Organization External ID | 12341234                                         |''');

		LocalFile.ZendeskTicketAPI._assignTicket(
			ticketId = ${staticRequestIdList},
			userEmailAddress = "zendesk.endagent1@liferay.com.broken");

		LocalFile.ZendeskTicketAPI._changeTicketStatusAndSubStatusAndLongTermResolution(
			ticketId = ${staticRequestIdList},
			ticketLongTermResolution = "bug_fix",
			ticketStatus = "solved",
			ticketSubStatus = "completed");

		LocalFile.ZendeskTicketAPI._assignTagsToTicket(
			table = '''| auto_closed |''',
			ticketId = ${staticRequestIdList});

		LocalFile.ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		LocalFile.ZendeskHomepage.login(
			userEmailAddress = "zendesk.enduser1@zendesk.com.broken",
			userPassword = ${staticZendeskAdminPassword});

		LocalFile.ZendeskHomepage.gotoMyActivities();

		LocalFile.ZendeskRequest.gotoViaIndex(requestSubject = "Request Subject");

		LocalFile.ZendeskRequest.createFollowUpRequest();

		LocalFile.ZendeskRequest.view(table = '''| Subject       | Re: Request Subject                                |
	| Status        | OPEN                                               |
	| Requester     | Zendesk Enduser1                                   |
	| Priority      | Normal                                             |
	| Product       | Liferay DXP > 7.4                                  |
	| Sub-Status    | Completed                                          |
	| Component     | Activation Key & Project Administration            |
	| System Status | Production > Functioning with limited capabilities |''');

		LocalFile.ZendeskRequest.viewCommentField();

		LocalFile.ZendeskRequest.viewNoClosedCommentMessage();

		LocalFile.ZendeskRequest.viewComment(
			commentContent = "This is a follow-up to your previous request",
			table = '''| Author          | Zendesk Enduser1                             |
	| Partial Comment | This is a follow-up to your previous request |
	| Partial Comment | "Request Subject"                            |''');
	}

	test DeveloperPermissions {
		LocalFile.ZendeskUserAPI._createUser(table = '''| Name             | Zendesk Enduser1                    |
	| Tags             | osb_customer,osb_kb                 |
	| Password         | ${staticZendeskAdminPassword}       |
	| Role             | End-user                            |
	| Access           | Organization                        |
	| Email            | zendesk.enduser1@zendesk.com.broken |
	| Phone Number     | +1 (555) 555-5555                   |
	| Organization     | Frontend Org Name 1                 |
	| Language         | English                             |
	| Time Zone        | Pacific Time (US & Canada)          |
	| External ID      | Enduser1                            |''');

		LocalFile.ZendeskUserAPI._createUser(table = '''| Name             | Zendesk Enduser2                    |
	| Tags             | osb_customer,osb_kb                 |
	| Password         | ${staticZendeskAdminPassword}       |
	| Role             | End-user                            |
	| Access           | Organization                        |
	| Email            | zendesk.enduser2@zendesk.com.broken |
	| Phone Number     | +1 (555) 555-5555                   |
	| Organization     | Frontend Org Name 1                 |
	| Language         | English                             |
	| Time Zone        | Pacific Time (US & Canada)          |
	| External ID      | Enduser2                            |''');

		LocalFile.ZendeskRequestAPI._createRequest(
			requesterEmail = "zendesk.enduser1@zendesk.com.broken",
			table = '''| Product                  | prd_liferay_dxp_7_4                              |
	| Component                | activation_key_project_administration            |
	| System Status            | production_functioning_with_limited_capabilities |
	| Subject                  | Request Subject                                  |
	| Description              | Request Description                              |
	| Organization External ID | 12341234                                         |''');

		LocalFile.ZendeskHomepage.login(
			userEmailAddress = "zendesk.enduser2@zendesk.com.broken",
			userPassword = ${staticZendeskAdminPassword});

		LocalFile.ZendeskHomepage.gotoMyActivities();

		LocalFile.ZendeskRequestIndex.gotoOrganizationRequestsTab();

		LocalFile.ZendeskRequest.viewViaIndex(
			requestSubject = "Request Subject",
			table = '''| Subject       | Request Subject |
	| Status        | OPEN            |''');

		LocalFile.ZendeskRequest.gotoViaIndex(requestSubject = "Request Subject");

		LocalFile.ZendeskRequest.submitComment(table = '''| Comment     | Request Comment |
	| Attachments | Document_1.txt  |''');

		LocalFile.ZendeskRequest.viewComment(
			commentContent = "Request Comment",
			table = '''| Author      | Zendesk Enduser2 |
	| Comment     | Request Comment  |
	| Attachments | Document_1.txt   |''');

		LocalFile.ZendeskRequest.view(table = '''| Subject       | Request Subject                                    |
	| Status        | OPEN                                               |
	| Requester     | Zendesk Enduser1                                   |
	| Priority      | Normal                                             |
	| Product       | Liferay DXP > 7.4                                  |
	| Sub-Status    | —                                                  |
	| Component     | Activation Key & Project Administration            |
	| System Status | Production > Functioning with limited capabilities |
	| Attachments   | Document_1.txt                                     |''');
	}

	test MarkRequestasSolved {
		LocalFile.ZendeskUserAPI._createUser(table = '''| Name             | Zendesk Enduser1                    |
	| Tags             | osb_customer,osb_kb                 |
	| Password         | ${staticZendeskAdminPassword}       |
	| Role             | End-user                            |
	| Access           | Organization                        |
	| Email            | zendesk.enduser1@zendesk.com.broken |
	| Phone Number     | +1 (555) 555-5555                   |
	| Organization     | Frontend Org Name 1                 |
	| Language         | English                             |
	| Time Zone        | Pacific Time (US & Canada)          |
	| External ID      | Enduser1                            |''');

		LocalFile.ZendeskUserAPI._createUser(table = '''| Name             | Zendesk Endagent1                    |
	| Password         | ${staticZendeskAdminPassword}        |
	| Role             | Agent                                |
	| Email            | zendesk.endagent1@liferay.com.broken |
	| Phone Number     | +1 (555) 555-5555                    |
	| Language         | English                              |
	| Time Zone        | Pacific Time (US & Canada)           |
	| External ID      | Endagent1                            |''');

		LocalFile.ZendeskUserAPI._assignUserToGroup(
			groupName = "Provisioning - US",
			userEmailAddress = "zendesk.endagent1@liferay.com.broken");

		LocalFile.ZendeskRequestAPI._createRequest(
			requesterEmail = "zendesk.enduser1@zendesk.com.broken",
			table = '''| Product                  | prd_liferay_dxp_7_4                              |
	| Component                | activation_key_project_administration            |
	| System Status            | production_functioning_with_limited_capabilities |
	| Subject                  | Request Subject                                  |
	| Description              | Request Description                              |
	| Organization External ID | 12341234                                         |''');

		LocalFile.ZendeskTicketAPI._assignTicket(
			ticketId = ${staticRequestIdList},
			userEmailAddress = "zendesk.endagent1@liferay.com.broken");

		LocalFile.ZendeskHomepage.login(
			userEmailAddress = "zendesk.enduser1@zendesk.com.broken",
			userPassword = ${staticZendeskAdminPassword});

		LocalFile.ZendeskHomepage.gotoMyActivities();

		LocalFile.ZendeskRequest.gotoViaIndex(requestSubject = "Request Subject");

		LocalFile.ZendeskRequest.markAsSolved();

		LocalFile.ZendeskRequest.view(table = '''| Subject       | Request Subject                                    |
	| Status        | SOLVED                                             |
	| Requester     | Zendesk Enduser1                                   |
	| Assigned to   | Zendesk Endagent1                                  |
	| Priority      | Normal                                             |
	| Product       | Liferay DXP > 7.4                                  |
	| Sub-Status    | —                                                  |
	| Component     | Activation Key & Project Administration            |
	| System Status | Production > Functioning with limited capabilities |''');
	}

	test MarkRequestasSolvedwithComment {
		LocalFile.ZendeskUserAPI._createUser(table = '''| Name             | Zendesk Enduser1                    |
	| Tags             | osb_customer,osb_kb                 |
	| Password         | ${staticZendeskAdminPassword}       |
	| Role             | End-user                            |
	| Access           | Organization                        |
	| Email            | zendesk.enduser1@zendesk.com.broken |
	| Phone Number     | +1 (555) 555-5555                   |
	| Organization     | Frontend Org Name 1                 |
	| Language         | English                             |
	| Time Zone        | Pacific Time (US & Canada)          |
	| External ID      | Enduser1                            |''');

		LocalFile.ZendeskUserAPI._createUser(table = '''| Name             | Zendesk Endagent1                    |
	| Password         | ${staticZendeskAdminPassword}        |
	| Role             | Agent                                |
	| Email            | zendesk.endagent1@liferay.com.broken |
	| Phone Number     | +1 (555) 555-5555                    |
	| Language         | English                              |
	| Time Zone        | Pacific Time (US & Canada)           |
	| External ID      | Endagent1                            |''');

		LocalFile.ZendeskUserAPI._assignUserToGroup(
			groupName = "Provisioning - US",
			userEmailAddress = "zendesk.endagent1@liferay.com.broken");

		LocalFile.ZendeskRequestAPI._createRequest(
			requesterEmail = "zendesk.enduser1@zendesk.com.broken",
			table = '''| Product                  | prd_liferay_dxp_7_4                              |
	| Component                | activation_key_project_administration            |
	| System Status            | production_functioning_with_limited_capabilities |
	| Subject                  | Request Subject                                  |
	| Description              | Request Description                              |
	| Organization External ID | 12341234                                         |''');

		LocalFile.ZendeskTicketAPI._assignTicket(
			ticketId = ${staticRequestIdList},
			userEmailAddress = "zendesk.endagent1@liferay.com.broken");

		LocalFile.ZendeskHomepage.login(
			userEmailAddress = "zendesk.enduser1@zendesk.com.broken",
			userPassword = ${staticZendeskAdminPassword});

		LocalFile.ZendeskHomepage.gotoMyActivities();

		LocalFile.ZendeskRequest.gotoViaIndex(requestSubject = "Request Subject");

		LocalFile.ZendeskRequest.markAsSolvedWithComment(table = '''| Comment     | Request Comment |
	| Attachments | Document_1.txt  |''');

		LocalFile.ZendeskRequest.view(table = '''| Subject       | Request Subject                                    |
	| Status        | SOLVED                                             |
	| Requester     | Zendesk Enduser1                                   |
	| Assigned to   | Zendesk Endagent1                                  |
	| Priority      | Normal                                             |
	| Product       | Liferay DXP > 7.4                                  |
	| Sub-Status    | —                                                  |
	| Component     | Activation Key & Project Administration            |
	| System Status | Production > Functioning with limited capabilities |
	| Attachments   | Document_1.txt                                     |''');

		LocalFile.ZendeskRequest.viewComment(
			commentContent = "Request Comment",
			table = '''| Author      | Zendesk Enduser1 |
	| Comment     | Request Comment  |
	| Attachments | Document_1.txt   |''');
	}

	test NonOrganizationPermissions {
		LocalFile.ZendeskUserAPI._createUser(table = '''| Name             | Zendesk Enduser1                    |
	| Tags             | osb_customer,osb_kb                 |
	| Password         | ${staticZendeskAdminPassword}       |
	| Role             | End-user                            |
	| Access           | Organization                        |
	| Email            | zendesk.enduser1@zendesk.com.broken |
	| Phone Number     | +1 (555) 555-5555                   |
	| Language         | English                             |
	| Time Zone        | Pacific Time (US & Canada)          |
	| External ID      | Enduser1                            |''');

		LocalFile.ZendeskHomepage.login(
			userEmailAddress = "zendesk.enduser1@zendesk.com.broken",
			userPassword = ${staticZendeskAdminPassword});

		LocalFile.ZendeskHomepage.gotoSubmitATicket();

		LocalFile.ZendeskRequest.viewNoRequestForm();
	}

	test OrganizationalPermissions {
		LocalFile.ZendeskUserAPI._createUser(table = '''| Name             | Zendesk Enduser1                    |
	| Tags             | osb_customer,osb_kb                 |
	| Password         | ${staticZendeskAdminPassword}       |
	| Role             | End-user                            |
	| Access           | Organization                        |
	| Email            | zendesk.enduser1@zendesk.com.broken |
	| Phone Number     | +1 (555) 555-5555                   |
	| Organization     | Frontend Org Name 1                 |
	| Language         | English                             |
	| Time Zone        | Pacific Time (US & Canada)          |
	| External ID      | Enduser1                            |''');

		LocalFile.ZendeskUserAPI._createUser(table = '''| Name             | Zendesk Enduser2                    |
	| Tags             | osb_customer,osb_kb                 |
	| Password         | ${staticZendeskAdminPassword}       |
	| Role             | End-user                            |
	| Access           | Organization                        |
	| Email            | zendesk.enduser2@zendesk.com.broken |
	| Phone Number     | +1 (555) 555-5555                   |
	| Organization     | Frontend Org Name 2                 |
	| Language         | English                             |
	| Time Zone        | Pacific Time (US & Canada)          |
	| External ID      | Enduser2                            |''');

		LocalFile.ZendeskUserAPI._assignUserToOrganization(
			organizationExternalId = 56785678,
			userEmailAddress = "zendesk.enduser1@zendesk.com.broken");

		LocalFile.ZendeskUserAPI._assignWatcherRole(
			organizationExternalId = 56785678,
			userEmailAddress = "zendesk.enduser1@zendesk.com.broken");

		LocalFile.ZendeskUserAPI._assignUserToOrganization(
			organizationExternalId = 12341234,
			userEmailAddress = "zendesk.enduser2@zendesk.com.broken");

		LocalFile.ZendeskUserAPI._assignWatcherRole(
			organizationExternalId = 12341234,
			userEmailAddress = "zendesk.enduser2@zendesk.com.broken");

		LocalFile.ZendeskHomepage.login(
			userEmailAddress = "zendesk.enduser1@zendesk.com.broken",
			userPassword = ${staticZendeskAdminPassword});

		LocalFile.ZendeskHomepage.gotoSubmitATicket();

		LocalFile.ZendeskRequest.clickRequestDropdown(dropdownLabel = "Organization");

		LocalFile.ZendeskRequest.viewNoOption(value = "Frontend Org Name 2");

		LocalFile.ZendeskHomepage.gotoHomePage();

		LocalFile.ZendeskRequest.create(table = '''| Product       | Liferay DXP                             | 7.4                                   |
	| Component     | Activation Key & Project Administration |                                       |
	| System Status | Production                              | Functioning with limited capabilities |
	| Subject       | Request1 Subject                        |                                       |
	| Description   | Request1 Description                    |                                       |
	| Attachments   | Document_1.txt                          |                                       |''');

		LocalFile.ZendeskRequest.view(table = '''| Subject       | Request1 Subject                                   |
	| Status        | OPEN                                               |
	| Requester     | Zendesk Enduser1                                   |
	| Priority      | Normal                                             |
	| Organization  | Frontend Org Name 1                                |
	| Product       | Liferay DXP > 7.4                                  |
	| Sub-Status    | —                                                  |
	| Component     | Activation Key & Project Administration            |
	| System Status | Production > Functioning with limited capabilities |
	| Attachments   | Document_1.txt                                     |''');

		LocalFile.ZendeskRequest.viewComment(
			commentContent = "Request1 Description",
			table = '''| Author      | Zendesk Enduser1     |
	| Comment     | Request1 Description |
	| Attachments | Document_1.txt       |''');

		LocalFile.ZendeskHomepage.logoutAndLogin(
			userEmailAddress = "zendesk.enduser2@zendesk.com.broken",
			userPassword = ${staticZendeskAdminPassword});

		LocalFile.ZendeskHomepage.gotoSubmitATicket();

		LocalFile.ZendeskRequest.clickRequestDropdown(dropdownLabel = "Organization");

		LocalFile.ZendeskRequest.viewNoOption(value = "Frontend Org Name 1");

		LocalFile.ZendeskHomepage.gotoHomePage();

		LocalFile.ZendeskRequest.create(table = '''| Product       | Liferay DXP                             | 7.4                                   |
	| Component     | Activation Key & Project Administration |                                       |
	| System Status | Production                              | Functioning with limited capabilities |
	| Subject       | Request2 Subject                        |                                       |
	| Description   | Request2 Description                    |                                       |
	| Attachments   | Document_2.txt                          |                                       |''');

		LocalFile.ZendeskRequest.view(table = '''| Subject       | Request2 Subject                                   |
	| Status        | OPEN                                               |
	| Requester     | Zendesk Enduser2                                   |
	| Priority      | Normal                                             |
	| Organization  | Frontend Org Name 2                                |
	| Product       | Liferay DXP > 7.4                                  |
	| Sub-Status    | —                                                  |
	| Component     | Activation Key & Project Administration            |
	| System Status | Production > Functioning with limited capabilities |
	| Attachments   | Document_2.txt                                     |''');

		LocalFile.ZendeskRequest.viewComment(
			commentContent = "Request2 Description",
			table = '''| Author      | Zendesk Enduser2     |
	| Comment     | Request2 Description |
	| Attachments | Document_2.txt       |''');

		LocalFile.ZendeskHomepage.logoutAndLogin(
			userEmailAddress = "zendesk.enduser1@zendesk.com.broken",
			userPassword = ${staticZendeskAdminPassword});

		LocalFile.ZendeskHomepage.gotoMyActivities();

		LocalFile.ZendeskRequestIndex.gotoOrganizationRequestsTab();

		LocalFile.ZendeskRequest.selectOrganizationFromSearchDropdown(organization = "Frontend Org Name 2");

		LocalFile.ZendeskRequest.viewViaIndex(
			requestSubject = "Request2 Subject",
			table = '''| Subject       | Request2 Subject |
	| Status        | OPEN             |''');

		LocalFile.ZendeskRequest.gotoViaIndex(requestSubject = "Request2 Subject");

		LocalFile.ZendeskRequest.viewNoCommentField();

		LocalFile.ZendeskHomepage.logoutAndLogin(
			userEmailAddress = "zendesk.enduser2@zendesk.com.broken",
			userPassword = ${staticZendeskAdminPassword});

		LocalFile.ZendeskHomepage.gotoMyActivities();

		LocalFile.ZendeskRequestIndex.gotoOrganizationRequestsTab();

		LocalFile.ZendeskRequest.selectOrganizationFromSearchDropdown(organization = "Frontend Org Name 1");

		LocalFile.ZendeskRequest.viewViaIndex(
			requestSubject = "Request1 Subject",
			table = '''| Subject       | Request1 Subject |
	| Status        | OPEN             |''');

		LocalFile.ZendeskRequest.gotoViaIndex(requestSubject = "Request1 Subject");

		LocalFile.ZendeskRequest.viewNoCommentField();
	}

	test PartnerPermissions {
