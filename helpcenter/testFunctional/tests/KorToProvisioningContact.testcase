	| Salesforce Opportunity Key             | ${staticSalesforceOpportunityKey}          |
	| Salesforce Opportunity Line Item Key 1 | ${staticSalesforceOpportunityLineItemKey1} |
	| Salesforce Opportunity Line Item Key 2 | ${staticSalesforceOpportunityLineItemKey2} |
	| Salesforce Opportunity Sold By         | Liferay US                                 |
	| Salesforce Opportunity Stage Name      | Closed Won                                 |
	| Salesforce Opportunity Territory       | United States                              |
	| Salesforce Opportunity Type            | New Business                               |
	| Salesforce Owner User Key              | ${staticSalesforceOwnerUserKey}            |
	| Salesforce Project Key                 | ${staticSalesforceProjectKey}              |
	| Start Day                              | ${staticStartDay}                          |
	| Start Month                            | ${staticStartMonth}                        |
	| Start Year                             | ${staticStartYear}                         |
	| Subscription Level                     | Platinum                                   |
	| Version Number                         | 7.1                                        |''');

		KoroneikiAccountAPI._createAccountTeam(
			accountName = "Korusr - ${staticProjectName}",
			teamName = "User Site Partner");

		KoroneikiAccountAPI._assignTeamRolesToTeam(
			accountName = "Korusr - ${staticProjectName}",
			table = '''| Partner |''',
			teamName = "User Site Partner");

		KoroneikiTeamAPI._assignContacts(
			table = '''| usr.koroneiki1@lrcustomer.com.broken |''',
			teamName = "User Site Partner");

		KoroneikiContactAPI._updateContactViaEmailAddress(
			contactEmailAddress = "usr.koroneiki1@lrcustomer.com.broken",
			table = '''| Email Address | usr.koroneiki5@lrcustomer.com.broken |
	| First Name    | USR                                  |
	| Last Name     | Koroneiki5                           |''');

		OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		Provisioning.gotoAccounts();

		Provisioning.searchAccounts(keyword = "Korusr");

		Provisioning.clickAccount(accountName = "Korusr - ${staticProjectName}");

		Provisioning.clickTab(tabName = "Contacts");

		ProvisioningAccount._viewAccountContact(
			emailAddress = "usr.koroneiki5@lrcustomer.com.broken",
			table = '''| Name          | USR Koroneiki5                       |
	| Email Address | usr.koroneiki5@lrcustomer.com.broken |
	| Role          | Support Administrator                |
	| User Status   | VERIFIED                             |''');

		ProvisioningAccount._viewNoAccountContact(emailAddress = "usr.koroneiki1@lrcustomer.com.broken");

		Provisioning.clickTab(tabName = "Liferay Workers");

		ProvisioningAccount._viewNoAccountWorker(emailAddress = "usr.koroneiki1@lrcustomer.com.broken");

		ProvisioningAccount._viewNoAccountWorker(emailAddress = "usr.koroneiki5@lrcustomer.com.broken");
	}

}