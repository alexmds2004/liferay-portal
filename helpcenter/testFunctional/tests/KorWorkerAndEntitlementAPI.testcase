	test Createcontactentitlementforworkercontactwithproductpurchaseonly {
		KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORAUTO                              | |
	| Description           | Test automotive account on koroneiki | |
	| Fax Number            | 555-555-1234                         | |
	| Name                  | Koroneiki Automotive                 | |
	| Phone Number          | 555-555-5678                         | |
	| Region                | United States                        | |
	| Status                | Active                               | |
	| Tier                  | T4                                   | |
	| Website               | www.koroneikiautomotive.com          | |''');

		KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORENGR                               | |
	| Description           | Test engineering account on koroneiki | |
	| Fax Number            | 555-555-4321                          | |
	| Name                  | Koroneiki Engineering                 | |
	| Phone Number          | 555-555-8765                          | |
	| Region                | Japan                                 | |
	| Status                | Active                                | |
	| Tier                  | T1                                    | |
	| Website               | www.koroneikiengineering.com          | |''');

		KoroneikiContactAPI._createContact(table = '''| Email Address | koroneiki.contact1@lrcustomer.com.broken |
	| First Name    | Koroneiki                                |
	| Language      | English                                  |
	| Last Name     | Contact1                                 |
	| Middle Name   | User                                     |''');

		KoroneikiContactAPI._createContact(table = '''| Email Address | koroneiki.contact2@lrcustomer.com.broken |
	| First Name    | Koroneiki                                |
	| Language      | English                                  |
	| Last Name     | Contact2                                 |
	| Middle Name   | User                                     |''');

		KoroneikiContactRoleAPI._createContactRole(table = '''| Description | This is the default worker role for accounts |
	| Name        | Default Account Worker Role                  |
	| Type        | Account Worker                               |''');

		KoroneikiAccountAPI._assignWorkerContacts(
			accountName = "Koroneiki Automotive",
			table = '''| koroneiki.contact1@lrcustomer.com.broken |''');

		KoroneikiAccountAPI._assignWorkerContacts(
			accountName = "Koroneiki Engineering",
			table = '''| koroneiki.contact2@lrcustomer.com.broken |''');

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Koroneiki Automotive",
			contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken",
			table = '''| Default Account Worker Role |''');

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Koroneiki Engineering",
			contactEmailAddress = "koroneiki.contact2@lrcustomer.com.broken",
			table = '''| Default Account Worker Role |''');

		KoroneikiProductAPI._createProduct(table = '''| Name | Liferay Digital Experience Platform | |''');

		KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Koroneiki Automotive",
			productName = "Liferay Digital Experience Platform",
			table = '''| End Date                | ${staticEndDate}   |                |
	| Perpetual               | true               |                |
	| Product Field and Value | additionalProp1    | propertyValue1 |
	| Product Field and Value | additionalProp2    | propertyValue2 |
	| Product Field and Value | additionalProp3    | propertyValue3 |
	| Quantity                | 1                  |                |
	| Start Date              | ${staticStartDate} |                |''');

		KoroneikiContactAPI._createContactEntitlementDefinition(
			contactRoleName = "Default Account Worker Role",
			contactRoleType = "Account Worker",
			productName = "Liferay Digital Experience Platform",
			table = '''| Description | Entitlement Description |
	| Name        | Entitlement Name        |
	| Status      | Approved                |''');

		KoroneikiContactAPI._viewContactEntitlementDefinition(
			entitlementDefinitionName = "Entitlement Name",
			table = '''| Description | Entitlement Description |
	| Name        | Entitlement Name        |
	| Status      | Approved                |''');

		KoroneikiContactAPI._viewContactEntitlementDefinitionViaEntitlementDefinitionKey(
			entitlementDefinitionName = "Entitlement Name",
			table = '''| Description | Entitlement Description |
	| Name        | Entitlement Name        |
	| Status      | Approved                |''');

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Entitlement Name");

		KoroneikiContactAPI._viewContactViaEmailAddress(
			contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken",
			table = '''| Email Address            | koroneiki.contact1@lrcustomer.com.broken |
	| Entitlement Nested Field | Entitlement Name                         |
	| First Name               | Koroneiki                                |
	| Language                 | English                                  |
	| Last Name                | Contact1                                 |
	| Middle Name              | User                                     |''');

		KoroneikiContactAPI._viewContactEntitlementViaNestedField(
			contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken",
			entitlementDefinitionName = "Entitlement Name");

		KoroneikiContactAPI._viewNoContactEntitlementViaNestedField(
			contactEmailAddress = "koroneiki.contact2@lrcustomer.com.broken",
			entitlementDefinitionName = "Entitlement Name");
	}

