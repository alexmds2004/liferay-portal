	test Createandviewproductconsumptionexternallink {
		LocalFile.KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORAUTO                                  | |
	| Contact Email Address | koroneiki.contact1@lrcustomer.com.broken | |
	| Description           | Test automotive account on koroneiki     | |
	| Fax Number            | 555-555-1234                             | |
	| Name                  | Koroneiki Automotive                     | |
	| Phone Number          | 555-555-5678                             | |
	| Profile Email Address | koroneiki.contact1@lrcustomer.com.broken | |
	| Region                | United States                            | |
	| Status                | Active                                   | |
	| Tier                  | T4                                       | |
	| Website               | www.koroneikiautomotive.com              | |''');

		LocalFile.KoroneikiProductAPI._createProduct(table = '''| Name | Liferay Digital Experience Platform | |''');

		LocalFile.KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		LocalFile.KoroneikiAccountAPI._createAccountProductConsumption(
			accountName = "Koroneiki Automotive",
			productName = "Liferay Digital Experience Platform",
			table = '''| Product Field and Value | additionalProp1 | propertyValue1 |
	| Product Field and Value | additionalProp2 | propertyValue2 |
	| Product Field and Value | additionalProp3 | propertyValue3 |''');

		LocalFile.KoroneikiProductConsumptionAPI._createProductConsumptionExternalLink(
			accountName = "Koroneiki Automotive",
			productName = "Liferay Digital Experience Platform",
			table = '''| Domain      | liferaydxpconsumption |
	| Entity Id   | 1234                  |
	| Entity Name | LiferayDXPConsumption |''');

		LocalFile.KoroneikiProductConsumptionAPI._viewProductConsumption(
			accountName = "Koroneiki Automotive",
			productName = "Liferay Digital Experience Platform",
			table = '''| External Link Nested Field | liferaydxpconsumption                               |                |
	| Product Field and Value    | additionalProp1                                     | propertyValue1 |
	| Product Field and Value    | additionalProp2                                     | propertyValue2 |
	| Product Field and Value    | additionalProp3                                     | propertyValue3 |''');

		LocalFile.KoroneikiProductConsumptionAPI._viewProductConsumptionExternalLink(
			accountName = "Koroneiki Automotive",
			entityId = 1234,
			productName = "Liferay Digital Experience Platform",
			table = '''| Domain      | liferaydxpconsumption |
	| Entity Id   | 1234                  |
	| Entity Name | LiferayDXPConsumption |''');

		LocalFile.KoroneikiProductConsumptionAPI._viewProductConsumptionExternalLinkViaExternalLinkKey(
			accountName = "Koroneiki Automotive",
			entityId = 1234,
			productName = "Liferay Digital Experience Platform",
			table = '''| Domain      | liferaydxpconsumption |
	| Entity Id   | 1234                  |
	| Entity Name | LiferayDXPConsumption |''');

		LocalFile.KoroneikiProductConsumptionAPI._viewProductConsumptionViaExternalLink(
			accountName = "Koroneiki Automotive",
			domain = "liferaydxpconsumption",
			entityId = 1234,
			entityName = "LiferayDXPConsumption",
			productName = "Liferay Digital Experience Platform",
			table = '''| Product Field and Value | additionalProp1 | propertyValue1 |
	| Product Field and Value | additionalProp2 | propertyValue2 |
	| Product Field and Value | additionalProp3 | propertyValue3 |''');
	}

	test Createandviewproductconsumptionwithproductwithproperties {
		LocalFile.KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORAUTO                                  | |
	| Contact Email Address | koroneiki.contact1@lrcustomer.com.broken | |
