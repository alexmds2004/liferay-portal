			accountName = "Koroneiki Automotive",
			productName = "Liferay Portal Six");

		LocalFile.KoroneikiProductConsumptionAPI._viewNoProductConsumption(
			accountName = "Koroneiki Auto Subsidiary",
			productName = "Liferay Digital Experience Platform");

		LocalFile.KoroneikiAccountAPI._viewProductConsumption(
			accountName = "Koroneiki Automotive",
			filterName = "All",
			productName = "Liferay Digital Experience Platform",
			table = '''| Product Field and Value | additionalProp1 | propertyValue1 |
	| Product Field and Value | additionalProp2 | propertyValue2 |
