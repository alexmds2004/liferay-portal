definition {

	property testray.main.component.name = "Support QA";
	property type = "koroneiki";

	tearDown {
		LocalFile.KoroneikiProductConsumptionAPI._tearDownProductConsumptions(
			accountName = "Koroneiki Automotive",
			table = '''| Liferay Digital Experience Platform |
	| Liferay Portal Six                  |''');

		LocalFile.KoroneikiProductConsumptionAPI._tearDownProductConsumptions(
			accountName = "Koroneiki Engineering",
			table = '''| Liferay Digital Experience Platform |
	| Liferay Portal Six                  |''');

		LocalFile.KoroneikiProductConsumptionAPI._tearDownProductConsumptions(
			accountName = "Koroneiki Auto Subsidiary",
			table = '''| Liferay Digital Experience Platform |
	| Liferay Portal Six                  |''');

		LocalFile.KoroneikiProductConsumptionAPI._tearDownProductConsumptions(
			accountName = "Koroneiki Engr Subsidiary",
			table = '''| Liferay Digital Experience Platform |
	| Liferay Portal Six                  |''');

		LocalFile.KoroneikiAccountAPI._tearDownAccounts(table = '''| Koroneiki Auto Subsidiary |
	| Koroneiki Engr Subsidiary |
	| Koroneiki Automotive      |
	| Koroneiki Engineering     |''');

		LocalFile.KoroneikiProductAPI._tearDownProducts(table = '''| Liferay Digital Experience Platform |
	| Liferay Portal Six                  |''');
	}

	test Createandviewmultipleproductconsumptions {
		LocalFile.KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORAUTO                                  | |
	| Contact Email Address | koroneiki.contact1@lrcustomer.com.broken | |
	| Description           | Test automotive account on koroneiki     | |
	| Fax Number            | 555-555-1234                             | |
	| Name                  | Koroneiki Automotive                     | |
	| Phone Number          | 555-555-5678                             | |
	| Profile Email Address | koroneiki.contact1@lrcustomer.com.broken | |
	| Region                | United States                            | |
	| Status                | Active                                   | |
	| Tier                  | T4                                       | |
	| Website               | www.koroneikiautomotive.com              | |''');

		LocalFile.KoroneikiProductAPI._createProduct(table = '''| Name | Liferay Digital Experience Platform | |''');

		LocalFile.KoroneikiProductAPI._createProduct(table = '''| Name | Liferay Portal Six | |''');

		LocalFile.KoroneikiAccountAPI._createAccountProductConsumption(
			accountName = "Koroneiki Automotive",
			productName = "Liferay Digital Experience Platform",
			table = '''| Product Field and Value | additionalProp1 | propertyValue1 |
	| Product Field and Value | additionalProp2 | propertyValue2 |
	| Product Field and Value | additionalProp3 | propertyValue3 |''');

		LocalFile.KoroneikiAccountAPI._createAccountProductConsumption(
			accountName = "Koroneiki Automotive",
			productName = "Liferay Portal Six",
			table = '''| Product Field and Value | additionalProp4 | propertyValue4 |
	| Product Field and Value | additionalProp5 | propertyValue5 |
	| Product Field and Value | additionalProp6 | propertyValue6 |''');

		LocalFile.KoroneikiProductConsumptionAPI._viewProductConsumption(
			accountName = "Koroneiki Automotive",
			productName = "Liferay Digital Experience Platform",
			table = '''| Product Field and Value | additionalProp1 | propertyValue1 |
	| Product Field and Value | additionalProp2 | propertyValue2 |
	| Product Field and Value | additionalProp3 | propertyValue3 |''');

		LocalFile.KoroneikiProductConsumptionAPI._viewProductConsumption(
			accountName = "Koroneiki Automotive",
			productName = "Liferay Portal Six",
			table = '''| Product Field and Value | additionalProp4 | propertyValue4 |
	| Product Field and Value | additionalProp5 | propertyValue5 |
	| Product Field and Value | additionalProp6 | propertyValue6 |''');

		LocalFile.KoroneikiAccountAPI._viewProductConsumption(
			accountName = "Koroneiki Automotive",
			filterName = "All",
			productName = "Liferay Digital Experience Platform",
			table = '''| Product Field and Value | additionalProp1 | propertyValue1 |
	| Product Field and Value | additionalProp2 | propertyValue2 |
	| Product Field and Value | additionalProp3 | propertyValue3 |''');

		LocalFile.KoroneikiAccountAPI._viewProductConsumption(
			accountName = "Koroneiki Automotive",
			filterName = "All",
			productName = "Liferay Portal Six",
			table = '''| Product Field and Value | additionalProp4 | propertyValue4 |
	| Product Field and Value | additionalProp5 | propertyValue5 |
	| Product Field and Value | additionalProp6 | propertyValue6 |''');
	}

	test Createandviewproductconsumption {
		LocalFile.KoroneikiAccountAPI._createAccount(table = '''| Code                  | KORAUTO                                  | |
	| Contact Email Address | koroneiki.contact1@lrcustomer.com.broken | |
