definition {

	property testray.main.component.name = "Support QA";
	property type = "zendesk.frontend";

	setUp {
		Passwords.getPasswords();
	}

	tearDown {
		ZendeskUserAPI._getDefaultUserId(organizationName = "Lfazen - ${staticProjectName}");

		ZendeskUserAPI._renameFirstDefaultUserIdVariable();

		ZendeskUserAPI._getDefaultUserId(organizationName = "Lfapar - ${staticProjectName}");

		ZendeskUserAPI._renameSecondDefaultUserIdVariable();

		ZendeskUserAPI._tearDownUsersRequestedTicketsByEmailAddressTable(table = '''| lfa.customer1@lrcustomer.com.broken |
	| lfa.partner1@lrpartner.com.broken   |
	| lfa.partner2@lrpartner.com.broken   |''');

		OSBAdminProject.tearDownProjects(table = '''| LFAPARLFAPAR |
	| LFAZENLFAZEN |''');

		KoroneikiAccountAPI._tearDownAccounts(table = '''| Lfapar - ${staticProjectName} |
	| Lfazen - ${staticProjectName} |''');

		KoroneikiAccountAPI._tearDownAccountsViaAccountFieldNameAndValue(
			fieldName = "Code",
			table = '''| LFAPARLFAPAR |
	| LFAZENLFAZEN |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Gold Subscription");

		JSONUser.tearDownUsers(table = '''| lfa.customer1@lrcustomer.com.broken |
	| lfa.partner1@lrpartner.com.broken   |
	| lfa.partner2@lrpartner.com.broken   |''');

		JSONUser.tearDownUsersViaSupport(table = '''| lfa.customer1@lrcustomer.com.broken |
	| lfa.partner1@lrpartner.com.broken   |
	| lfa.partner2@lrpartner.com.broken   |''');

		JSONUser.tearDownUsersViaKoroneiki(table = '''| lfa.customer1@lrcustomer.com.broken |
	| lfa.partner1@lrpartner.com.broken   |
	| lfa.partner2@lrpartner.com.broken   |''');

		KoroneikiContactAPI._tearDownContacts(table = '''| lfa.customer1@lrcustomer.com.broken |
	| lfa.partner1@lrpartner.com.broken   |
	| lfa.partner2@lrpartner.com.broken   |''');

		JSONOkta.tearDownUsers(table = '''| lfa.customer1@lrcustomer.com.broken |
	| lfa.partner1@lrpartner.com.broken   |
	| lfa.partner2@lrpartner.com.broken   |''');

		ZendeskUserAPI._getMultipleUserIdsByEmailAddress(table = '''| lfa.customer1@lrcustomer.com.broken |
	| lfa.partner1@lrpartner.com.broken   |
	| lfa.partner2@lrpartner.com.broken   |''');

		ZendeskUserAPI._tearDownUsersByIdList(userIds = ${staticUserIdList});

		ZendeskOrganizationAPI._getMultipleOrganizationExternalIdsByOrganizationNameIfStillPresent(table = '''| Lfapar - ${staticProjectName} |
	| Lfazen - ${staticProjectName} |''');

		ZendeskOrganizationAPI._tearDownOrganizationsByExternalIdList(organizationExternalIds = ${staticOrganizationExternalIdList});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId1});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId2});
	}

	test Uploadlargefile {
		property help.center.acceptance = "true";

		OSBAdminRabbitMQ.generateProvisioningProjectName();

		Passwords.getPasswords();

		JSONOkta.createOktaUser(table = '''| Screen Name   | lfa.partner1                      |
	| Email Address | lfa.partner1@lrpartner.com.broken |
	| First Name    | LFA                               |
	| Last Name     | Partner1                          |''');

		JSONOkta.createOktaUser(table = '''| Screen Name   | lfa.partner2                      |
	| Email Address | lfa.partner2@lrpartner.com.broken |
	| First Name    | LFA                               |
	| Last Name     | Partner2                          |''');

		KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		KoroneikiAccountAPI._createAccount(table = '''| Name   | Lfapar - ${staticProjectName} | |
	| Code   | LFAPARLFAPAR                  | |
	| Status | Active                        | |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Lfapar - ${staticProjectName}",
			productName = "Service Partnership",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Partner");

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Lfapar - ${staticProjectName}",
			contactEmailAddress = "lfa.partner1@lrpartner.com.broken",
			table = '''| Partner Member |''');

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Lfapar - ${staticProjectName}",
			contactEmailAddress = "lfa.partner2@lrpartner.com.broken",
			table = '''| Partner Manager |''');

		KoroneikiAccountAPI._createAssignedTeamNestedField(
			accountName = "Lfazen - ${staticProjectName}",
			teamName = "Lfapar - ${staticProjectName}");

		JSONOkta.createOktaUser(table = '''| Screen Name   | lfa.customer1                       |
	| Email Address | lfa.customer1@lrcustomer.com.broken |
	| First Name    | LFA                                 |
	| Last Name     | Customer1                           |''');

		KoroneikiAccountAPI._createAccount(table = '''| Assigned Team Nested Field | ${staticAssignedTeamNestedField} | |
	| Code                       | LFAZENLFAZEN                     | |
	| Data Region                | United States                    | |
	| Language                   | English                          | |
	| Name                       | Lfazen - ${staticProjectName}    | |
	| Region                     | United States                    | |
	| Status                     | Active                           | |
	| Tier                       | T1                               | |''');

		KoroneikiAccountAPI._assignTeamRolesToTeam(
			accountName = "Lfazen - ${staticProjectName}",
			table = '''| Partner |''',
			teamName = "Lfapar - ${staticProjectName}");

		KoroneikiAccountAPI._assignTeamRolesToTeam(
			accountName = "Lfazen - ${staticProjectName}",
			table = '''| First Line Support |''',
			teamName = "Lfapar - ${staticProjectName}");

		KoroneikiAccountAPI._assignContactRolesToContact(
			accountName = "Lfazen - ${staticProjectName}",
			contactEmailAddress = "lfa.customer1@lrcustomer.com.broken",
			table = '''| Support Requester |''');

		KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Lfazen - ${staticProjectName}",
			productName = "Portal Production",
			table = '''| End Date                | ${staticEndDate}         |   |
	| Original End Date       | ${staticOriginalEndDate} |   |
	| Perpetual               | false                    |   |
	| Product Field and Value | sizing                   | 1 |
	| Product Field and Value | licenses                 | 1 |
	| Product Field and Value | version                  | 6 |
	| Quantity                | 1                        |   |
	| Start Date              | ${staticStartDate}       |   |
	| Status                  | Approved                 |   |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Lfazen - ${staticProjectName}",
			productName = "Gold Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Gold Subscription");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Customer - Portal");

		KoroneikiContactAPI._synchronizeContactEntitlementDefinition(entitlementDefinitionName = "Partner");

		ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		JSONOSBAccount.viewSupportOrganizationSync(accountCode = "LFAZENLFAZEN");

		ZendeskOrganizationAPI._viewOrganizationSyncFromOsb(organizationName = "Lfazen - ${staticProjectName}");

		JSONUser.viewSupportUserSync(userEmailAddress = "lfa.customer1@lrcustomer.com.broken");

		JSONUser.viewSupportUserSync(userEmailAddress = "lfa.partner1@lrpartner.com.broken");

		JSONUser.viewSupportUserSync(userEmailAddress = "lfa.partner2@lrpartner.com.broken");

		ZendeskUserAPI._viewUserSyncFromOsb(userEmailAddress = "lfa.customer1@lrcustomer.com.broken");

		ZendeskUserAPI._viewUserSyncFromOsb(userEmailAddress = "lfa.partner1@lrpartner.com.broken");

		ZendeskUserAPI._viewUserSyncFromOsb(userEmailAddress = "lfa.partner2@lrpartner.com.broken");

		JSONUser.updateSupportPassword(
			userEmailAddress = "lfa.customer1@lrcustomer.com.broken",
			userPassword = ${staticSupportUserTestPassword});

		JSONUser.updateSupportPassword(
			userEmailAddress = "lfa.partner1@lrpartner.com.broken",
			userPassword = ${staticSupportUserTestPassword});

		JSONUser.updateSupportPassword(
			userEmailAddress = "lfa.partner2@lrpartner.com.broken",
			userPassword = ${staticSupportUserTestPassword});

		ZendeskUserAPI._updateUserPasswordByEmailAddress(
			userEmailAddress = "lfa.customer1@lrcustomer.com.broken",
			userPassword = ${staticZendeskAdminPassword});

		ZendeskUserAPI._updateUserPasswordByEmailAddress(
			userEmailAddress = "lfa.partner1@lrpartner.com.broken",
			userPassword = ${staticZendeskAdminPassword});

		ZendeskUserAPI._updateUserPasswordByEmailAddress(
			userEmailAddress = "lfa.partner2@lrpartner.com.broken",
			userPassword = ${staticZendeskAdminPassword});

		ZendeskHomepage.login(
			userEmailAddress = "lfa.customer1@lrcustomer.com.broken",
			userPassword = ${staticZendeskAdminPassword});

		ZendeskRequest.create(table = '''| Product       | Liferay Portal                          | 6.2                                   |
	| Component     | Activation Key & Project Administration |                                       |
	| System Status | Production                              | Functioning with limited capabilities |
	| Subject       | Request Subject                         |                                       |
	| Description   | Request Description                     |                                       |
	| Attachments   | Document_1.txt                          |                                       |''');

		ZendeskRequest.view(table = '''| Subject       | Request Subject                                    |
	| Status        | OPEN                                               |
	| Requester     | LFA Customer1                                      |
	| Priority      | Normal                                             |
	| Product       | Liferay Portal > 6.2                               |
	| Sub-Status    | —                                                  |
	| Component     | Activation Key & Project Administration            |
	| System Status | Production > Functioning with limited capabilities |
	| Attachments   | Document_1.txt                                     |''');

		ZendeskRequest.viewComment(
			commentContent = "Request Description",
			table = '''| Author      | LFA Customer1       |
	| Comment     | Request Description |
	| Attachments | Document_1.txt      |''');

		OSBAdmin.logoutAndLoginToSupport(
			userEmailAddress = "lfa.partner1@lrpartner.com.broken",
			userPassword = ${staticSupportUserTestPassword});

		ZendeskHomepage.login(
			userEmailAddress = "lfa.partner1@lrpartner.com.broken",
			userPassword = ${staticZendeskAdminPassword});

		ZendeskRequest.gotoViaId(requestId = ${staticRequestId});

		ZendeskHomepage.acceptAllCookies();

		ZendeskRequest.uploadFileViaLargeFileUploader(table = '''| Attachment       | Document_2.txt      |
	| Comment          | Large File Comment1 |
	| Data Region      | United States       |
	| No Personal Data | false               |''');

		ZendeskRequest.viewLargeFileComment(
			commentContent = "Large File Comment1",
			table = '''| Author      | LFA Partner1 [P]    |
	| Comment     | Large File Comment1 |
	| Attachment  | Document_2.txt      |''');

		OSBAdmin.logoutAndLoginToSupport(
			userEmailAddress = "lfa.partner2@lrpartner.com.broken",
			userPassword = ${staticSupportUserTestPassword});

		ZendeskHomepage.login(
			userEmailAddress = "lfa.partner2@lrpartner.com.broken",
			userPassword = ${staticZendeskAdminPassword});

		ZendeskRequest.gotoViaId(requestId = ${staticRequestId});

		ZendeskHomepage.acceptAllCookies();

		ZendeskRequest.uploadFileViaLargeFileUploader(table = '''| Attachment       | Document_3.txt      |
	| Comment          | Large File Comment2 |
	| Data Region      | United States       |
	| No Personal Data | false               |''');

		ZendeskRequest.viewLargeFileComment(
			commentContent = "Large File Comment2",
			table = '''| Author      | LFA Partner2 [P]    |
	| Comment     | Large File Comment2 |
	| Attachment  | Document_3.txt      |''');

		ZendeskRequest.viewLargeFileComment(
			commentContent = "Large File Comment1",
			table = '''| Author      | LFA Partner1 [P]    |
	| Comment     | Large File Comment1 |
	| Attachment  | Document_2.txt      |''');

		ProjectDetails.gotoProjectDetailsPage();

		ProjectDetails.gotoProject(projectName = "Lfazen - ${staticProjectName}");

		ProjectDetails.gotoAttachments();

		ProjectDetails.viewAttachment(
			fileKeyword = "Document_3.txt",
			table = '''| Ticket                         | ${staticRequestId} |
	| File Name                      | Document_3.txt     |
	| File Name Link                 | false              |
	| File Size                      | 1KB                |
	| Attached                       | LFA Partner2       |
	| Does Not Contain Personal Data | false              |''');

		ProjectDetails.viewAttachmentActionsLink(fileKeyword = "Document_3.txt");

		ProjectDetails.viewAttachment(
			fileKeyword = "Document_2.txt",
			table = '''| Ticket                         | ${staticRequestId} |
	| File Name                      | Document_2.txt     |
	| File Name Link                 | false              |
	| File Size                      | 1KB                |
	| Attached                       | LFA Partner1       |
	| Does Not Contain Personal Data | false              |''');

		ProjectDetails.viewNoAttachmentActionsOrDeleteLink(fileKeyword = "Document_2.txt");

		OSBAdmin.logoutAndLoginToSupport(
			userEmailAddress = "lfa.partner1@lrpartner.com.broken",
			userPassword = ${staticSupportUserTestPassword});

		ProjectDetails.gotoProjectDetailsPage();

		ProjectDetails.gotoProject(projectName = "Lfazen - ${staticProjectName}");

		ProjectDetails.gotoAttachments();

		ProjectDetails.viewAttachment(
			fileKeyword = "Document_3.txt",
			table = '''| Ticket                         | ${staticRequestId} |
	| File Name                      | Document_3.txt     |
	| File Name Link                 | false              |
	| File Size                      | 1KB                |
	| Attached                       | LFA Partner2       |
	| Does Not Contain Personal Data | false              |''');

		ProjectDetails.viewNoAttachmentActionsOrDeleteLink(fileKeyword = "Document_3.txt");

		ProjectDetails.viewAttachment(
			fileKeyword = "Document_2.txt",
			table = '''| Ticket                         | ${staticRequestId} |
	| File Name                      | Document_2.txt     |
	| File Name Link                 | false              |
	| File Size                      | 1KB                |
	| Attached                       | LFA Partner1       |
	| Does Not Contain Personal Data | false              |''');

		ProjectDetails.viewAttachmentActionsLink(fileKeyword = "Document_2.txt");
	}

}