definition {

	property testray.main.component.name = "Support QA";
	property type = "provisioning.security";

	setUp {
		Passwords.getPasswords();

		OSBAdminRabbitMQ.generateStaticVariables();

		OSBAdminRabbitMQ.generateProvisioningCompanyName();

		OSBAdminRabbitMQ.generateProvisioningProjectName();

		JSONUser.createViaProvisioning(table = '''| Screen Name   | provisioning.admin                    |
	| Email Address | provisioning.admin@liferay.com.broken |
	| First Name    | Provisioning                          |
	| Last Name     | Admin                                 |''');

		JSONUser.assignUserToProvisioningRole(
			roleName = "Provisioning Admin",
			userEmailAddress = "provisioning.admin@liferay.com.broken");

		JSONOkta.createOktaUser(table = '''| Screen Name   | prm.koroneiki1                       |
	| Email Address | prm.koroneiki1@lrcustomer.com.broken |
	| First Name    | PRM                                  |
	| Last Name     | Koroneiki1                           |''');

		JSONOkta.createOktaUser(table = '''| Screen Name   | prm.koroneiki2                       |
	| Email Address | prm.koroneiki2@lrcustomer.com.broken |
	| First Name    | PRM                                  |
	| Last Name     | Koroneiki2                           |''');
	}

	tearDown {
		ZendeskUserAPI._getDefaultUserId(organizationName = "Permis - ${staticProjectName}");

		ZendeskUserAPI._renameFirstDefaultUserIdVariable();

		ZendeskUserAPI._getDefaultUserId(organizationName = "Misper - ${staticCompanyName}");

		ZendeskUserAPI._renameSecondDefaultUserIdVariable();

		KoroneikiTeamAPI._tearDownTeams(table = '''| Permission Partner |
	| Perm New Partner   |
	| Permissioning Team |
	| Updated Perm Team  |''');

		OSBAdminProject.tearDownProjects(table = '''| MISPERPERMIS |
	| MISPER       |''');

		KoroneikiAccountAPI._tearDownAccounts(table = '''| Permis - ${staticProjectName} |
	| Misper - ${staticCompanyName} |''');

		KoroneikiAccountAPI._tearDownAccountsViaAccountFieldNameAndValue(
			fieldName = "Code",
			table = '''| MISPERPERMIS |
	| MISPER       |''');

		JSONUser.tearDownUsers(table = '''| prm.koroneiki1@lrcustomer.com.broken |
	| prm.koroneiki2@lrcustomer.com.broken |''');

		JSONUser.tearDownUsersViaSupport(table = '''| prm.koroneiki1@lrcustomer.com.broken |
	| prm.koroneiki2@lrcustomer.com.broken |''');

		JSONUser.tearDownUsersViaKoroneiki(table = '''| prm.koroneiki1@lrcustomer.com.broken |
	| prm.koroneiki2@lrcustomer.com.broken |''');

		KoroneikiContactAPI._tearDownContacts(table = '''| prm.koroneiki1@lrcustomer.com.broken |
	| prm.koroneiki2@lrcustomer.com.broken |''');

		JSONOkta.tearDownUsers(table = '''| prm.koroneiki1@lrcustomer.com.broken |
	| prm.koroneiki2@lrcustomer.com.broken |''');

		ZendeskTicketAPI._tearDownTicketsByKeywords(table = '''| New Subscription(s) for Permis - ${staticProjectName} |
	| New Subscription(s) for Misper - ${staticCompanyName} |''');

		ZendeskUserAPI._getMultipleUserIdsByEmailAddress(table = '''| prm.koroneiki1@lrcustomer.com.broken |
	| prm.koroneiki2@lrcustomer.com.broken |''');

		ZendeskUserAPI._tearDownUsersByIdList(userIds = ${staticUserIdList});

		ZendeskOrganizationAPI._getMultipleOrganizationExternalIdsByOrganizationNameIfStillPresent(table = '''| Permis - ${staticProjectName} |
	| Misper - ${staticCompanyName} |''');

		ZendeskOrganizationAPI._tearDownOrganizationsByExternalIdList(organizationExternalIds = ${staticOrganizationExternalIdList});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId1});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId2});

		JSONUser.tearDownUsersViaProvisioning(table = '''| provisioning.admin@liferay.com.broken |''');
	}

	test Assignteammember {
		OSBAdminRabbitMQ.publishCreateProjectWithNoPartnerMessage(
			routingKey = "dossiera.provisioning.create",
			table = '''| Account Name                           | Misper - ${staticCompanyName}              |
	| Address City                           | Diamond Bar                                |
	| Address Country                        | United States                              |
	| Address Postal Code                    | 91765                                      |
	| Address Region                         | California                                 |
	| Address Street                         | 456 Fake Street                            |
	| Contact Email Address                  | prm.koroneiki1@lrcustomer.com.broken       |
	| Contact First Name                     | PRM                                        |
	| Contact Last Name                      | Koroneiki1                                 |
	| Dossiera Account Key                   | ${staticDossieraAccountKey}                |
	| Dossiera Address Key 1                 | ${staticDossieraAddressKey1}               |
	| Dossiera Address Key 2                 | ${staticDossieraAddressKey2}               |
	| Dossiera Contact Key                   | ${staticDossieraContactKey}                |
	| Dossiera Project Key                   | ${staticDossieraProjectKey}                |
	| End Day                                | ${staticEndDay}                            |
	| End Month                              | ${staticEndMonth}                          |
	| End Year                               | ${staticEndYear}                           |
	| Industry                               | Automotive                                 |
	| Owner Email Address                    | prm.koroneiki2@lrcustomer.com.broken       |
	| Owner First Name                       | PRM                                        |
	| Owner Last Name                        | Koroneiki2                                 |
	| Partner First Line Support             | false                                      |
	| Product Type                           | New                                        |
	| Product Name                           | Liferay Digital Enterprise - Prod Sizing 4 |
	| Project Name                           | Permis - ${staticProjectName}              |
	| Renewal                                | false                                      |
	| Salesforce Opportunity Key             | ${staticSalesforceOpportunityKey}          |
	| Salesforce Opportunity Line Item Key 1 | ${staticSalesforceOpportunityLineItemKey1} |
	| Salesforce Opportunity Line Item Key 2 | ${staticSalesforceOpportunityLineItemKey2} |
	| Salesforce Opportunity Sold By         | Liferay US                                 |
	| Salesforce Opportunity Stage Name      | Closed Won                                 |
	| Salesforce Opportunity Territory       | United States                              |
	| Salesforce Opportunity Type            | New Business                               |
	| Salesforce Owner User Key              | ${staticSalesforceOwnerUserKey}            |
	| Salesforce Project Key                 | ${staticSalesforceProjectKey}              |
	| Start Day                              | ${staticStartDay}                          |
	| Start Month                            | ${staticStartMonth}                        |
	| Start Year                             | ${staticStartYear}                         |
	| Subscription Level                     | Platinum                                   |
	| Version Number                         | 7.1                                        |''');

		KoroneikiAccountAPI._createAccountTeam(
			accountName = "Permis - ${staticProjectName}",
			teamName = "Permission Partner");

		KoroneikiAccountAPI._assignTeamRolesToTeam(
			accountName = "Permis - ${staticProjectName}",
			table = '''| Partner |''',
			teamName = "Permission Partner");

		OSBAdmin.loginToProvisioning(
			userEmailAddress = "provisioning.admin@liferay.com.broken",
			userPassword = ${staticProvisioningQaUserPassword});

		UserAccount.updatePasswordUponLogin(userPassword = "test");

		Provisioning.gotoAccounts();

		Provisioning.searchAccounts(keyword = "Permis");

		Provisioning.clickAccount(accountName = "Permis - ${staticProjectName}");

		Provisioning.clickTab(tabName = "Teams");

		ProvisioningAccount.search(keyword = "Permission");

		ProvisioningAccount.clickTeamLink(teamName = "Permission Partner");

		ProvisioningTeam.clickAssignMembersButton();

		ProvisioningTeam.assignMember(memberEmailAddress = "prm.koroneiki1@lrcustomer.com.broken");

		ProvisioningTeam.search(keyword = "prm.koroneiki1@lrcustomer.com.broken");

		ProvisioningTeam._viewTeamMember(
			memberEmailAddress = "prm.koroneiki1@lrcustomer.com.broken",
			table = '''| Name          | PRM Koroneiki1                       |
	| Email Address | prm.koroneiki1@lrcustomer.com.broken |
	| Status        | VERIFIED                             |''');

		KoroneikiTeamAPI._viewContact(
			contactEmailAddress = "prm.koroneiki1@lrcustomer.com.broken",
			teamName = "Permission Partner");

		KoroneikiTeamAPI._viewContactViaNestedField(
			contactEmailAddress = "prm.koroneiki1@lrcustomer.com.broken",
			teamName = "Permission Partner");

		Provisioning.gotoAccounts();

		Provisioning.searchAccounts(keyword = "Permis");

		Provisioning.clickAccount(accountName = "Permis - ${staticProjectName}");

		Provisioning.clickTab(tabName = "Teams");

		ProvisioningAccount.search(keyword = "Permis");

		ProvisioningAccount._viewAccountTeam(
			table = '''| Name   | Permis - ${staticProjectName} |
	| Member | PRM Koroneiki1                |''',
			teamName = "Permis - ${staticProjectName}");

		ProvisioningAccount.clickTeamLink(teamName = "Permis - ${staticProjectName}");

		ProvisioningTeam._viewTeamDetails(table = '''| Name | Permis - ${staticProjectName} |''');

		ProvisioningTeam.search(keyword = "prm.koroneiki1@lrcustomer.com.broken");

		ProvisioningTeam._viewTeamMember(
			memberEmailAddress = "prm.koroneiki1@lrcustomer.com.broken",
			table = '''| Name          | PRM Koroneiki1                       |
	| Email Address | prm.koroneiki1@lrcustomer.com.broken |
	| Status        | VERIFIED                             |''');

		Provisioning.gotoAccounts();

		Provisioning.searchAccounts(keyword = "Permis");

		Provisioning.clickAccount(accountName = "Permis - ${staticProjectName}");

		Provisioning.clickTab(tabName = "History");

		ProvisioningAccount.viewAccountHistoryEntryByKeyword(
			fieldName = "Contact",
			keyword = "Provisioning Admin > Updated Team",
			table = '''| Update Description          | Provisioning Admin > Updated Team > Permission Partner Member |
	| Update Field Name           | Contact                                                       |
	| Update Field Original Value | N/A                                                           |
	| Update Field New Value      | PRM Koroneiki1                                                |''');
	}

	test Createteam {
		OSBAdminRabbitMQ.publishCreateProjectWithNoPartnerMessage(
			routingKey = "dossiera.provisioning.create",
			table = '''| Account Name                           | Misper - ${staticCompanyName}              |
	| Address City                           | Diamond Bar                                |
	| Address Country                        | United States                              |
	| Address Postal Code                    | 91765                                      |
	| Address Region                         | California                                 |
	| Address Street                         | 456 Fake Street                            |
	| Contact Email Address                  | prm.koroneiki1@lrcustomer.com.broken       |
	| Contact First Name                     | PRM                                        |
	| Contact Last Name                      | Koroneiki1                                 |
	| Dossiera Account Key                   | ${staticDossieraAccountKey}                |
	| Dossiera Address Key 1                 | ${staticDossieraAddressKey1}               |
	| Dossiera Address Key 2                 | ${staticDossieraAddressKey2}               |
	| Dossiera Contact Key                   | ${staticDossieraContactKey}                |
	| Dossiera Project Key                   | ${staticDossieraProjectKey}                |
	| End Day                                | ${staticEndDay}                            |
	| End Month                              | ${staticEndMonth}                          |
	| End Year                               | ${staticEndYear}                           |
	| Industry                               | Automotive                                 |
	| Owner Email Address                    | prm.koroneiki2@lrcustomer.com.broken       |
	| Owner First Name                       | PRM                                        |
	| Owner Last Name                        | Koroneiki2                                 |
	| Partner First Line Support             | false                                      |
	| Product Type                           | New                                        |
	| Product Name                           | Liferay Digital Enterprise - Prod Sizing 4 |
	| Project Name                           | Permis - ${staticProjectName}              |
	| Renewal                                | false                                      |
	| Salesforce Opportunity Key             | ${staticSalesforceOpportunityKey}          |
	| Salesforce Opportunity Line Item Key 1 | ${staticSalesforceOpportunityLineItemKey1} |
	| Salesforce Opportunity Line Item Key 2 | ${staticSalesforceOpportunityLineItemKey2} |
	| Salesforce Opportunity Sold By         | Liferay US                                 |
	| Salesforce Opportunity Stage Name      | Closed Won                                 |
	| Salesforce Opportunity Territory       | United States                              |
	| Salesforce Opportunity Type            | New Business                               |
	| Salesforce Owner User Key              | ${staticSalesforceOwnerUserKey}            |
	| Salesforce Project Key                 | ${staticSalesforceProjectKey}              |
	| Start Day                              | ${staticStartDay}                          |
	| Start Month                            | ${staticStartMonth}                        |
	| Start Year                             | ${staticStartYear}                         |
	| Subscription Level                     | Platinum                                   |
	| Version Number                         | 7.1                                        |''');

		KoroneikiAccountAPI._createAccountTeam(
			accountName = "Permis - ${staticProjectName}",
			teamName = "Permission Partner");

		KoroneikiAccountAPI._assignTeamRolesToTeam(
			accountName = "Permis - ${staticProjectName}",
			table = '''| Partner |''',
			teamName = "Permission Partner");

		KoroneikiTeamAPI._assignContacts(
			table = '''| prm.koroneiki1@lrcustomer.com.broken |''',
			teamName = "Permission Partner");

		OSBAdmin.loginToProvisioning(
			userEmailAddress = "provisioning.admin@liferay.com.broken",
			userPassword = ${staticProvisioningQaUserPassword});

		UserAccount.updatePasswordUponLogin(userPassword = "test");

		Provisioning.gotoAccounts();

		Provisioning.searchAccounts(keyword = "Permis");

		Provisioning.clickAccount(accountName = "Permis - ${staticProjectName}");

		Provisioning.clickTab(tabName = "Teams");

		ProvisioningAccount.clickNewTeamButton();

		ProvisioningTeam.populateTeamFormAndSave(teamName = "Permissioning Team");

		ProvisioningTeam._viewTeamDetails(table = '''| Name | Permissioning Team |''');

		KoroneikiTeamAPI._viewTeam(teamName = "Permissioning Team");

		KoroneikiAccountAPI._viewAccountTeam(
			accountName = "Permis - ${staticProjectName}",
			teamName = "Permissioning Team");

		Provisioning.gotoAccounts();

		Provisioning.searchAccounts(keyword = "Permis");

		Provisioning.clickAccount(accountName = "Permis - ${staticProjectName}");

		Provisioning.clickTab(tabName = "Teams");

		ProvisioningAccount._viewAccountTeam(
			table = '''| Name | Permissioning Team |''',
			teamName = "Permissioning Team");

		ProvisioningAccount.clickTeamLink(teamName = "Permissioning Team");

		ProvisioningTeam._viewTeamDetails(table = '''| Name | Permissioning Team |''');

		Provisioning.gotoAccounts();

		Provisioning.searchAccounts(keyword = "Permis");

		Provisioning.clickAccount(accountName = "Permis - ${staticProjectName}");

		Provisioning.clickTab(tabName = "History");

		ProvisioningAccount.viewAccountHistoryEntryByKeyword(
			fieldName = "name",
			keyword = "Provisioning Admin > Added Team",
			table = '''| Update Description          | Provisioning Admin > Added Team > Permissioning Team |
	| Update Field Name           | name                                                 |
	| Update Field Original Value | N/A                                                  |
	| Update Field New Value      | Permissioning Team                                   |''');
	}

	test Deleteteam {
		OSBAdminRabbitMQ.publishCreateProjectWithNoPartnerMessage(
			routingKey = "dossiera.provisioning.create",
			table = '''| Account Name                           | Misper - ${staticCompanyName}              |
	| Address City                           | Diamond Bar                                |
	| Address Country                        | United States                              |
	| Address Postal Code                    | 91765                                      |
	| Address Region                         | California                                 |
	| Address Street                         | 456 Fake Street                            |
	| Contact Email Address                  | prm.koroneiki1@lrcustomer.com.broken       |
	| Contact First Name                     | PRM                                        |
	| Contact Last Name                      | Koroneiki1                                 |
	| Dossiera Account Key                   | ${staticDossieraAccountKey}                |
	| Dossiera Address Key 1                 | ${staticDossieraAddressKey1}               |
	| Dossiera Address Key 2                 | ${staticDossieraAddressKey2}               |
	| Dossiera Contact Key                   | ${staticDossieraContactKey}                |
	| Dossiera Project Key                   | ${staticDossieraProjectKey}                |
	| End Day                                | ${staticEndDay}                            |
	| End Month                              | ${staticEndMonth}                          |
	| End Year                               | ${staticEndYear}                           |
	| Industry                               | Automotive                                 |
	| Owner Email Address                    | prm.koroneiki2@lrcustomer.com.broken       |
	| Owner First Name                       | PRM                                        |
	| Owner Last Name                        | Koroneiki2                                 |
	| Partner First Line Support             | false                                      |
	| Product Type                           | New                                        |
	| Product Name                           | Liferay Digital Enterprise - Prod Sizing 4 |
	| Project Name                           | Permis - ${staticProjectName}              |
	| Renewal                                | false                                      |
	| Salesforce Opportunity Key             | ${staticSalesforceOpportunityKey}          |
	| Salesforce Opportunity Line Item Key 1 | ${staticSalesforceOpportunityLineItemKey1} |
	| Salesforce Opportunity Line Item Key 2 | ${staticSalesforceOpportunityLineItemKey2} |
	| Salesforce Opportunity Sold By         | Liferay US                                 |
	| Salesforce Opportunity Stage Name      | Closed Won                                 |
	| Salesforce Opportunity Territory       | United States                              |
	| Salesforce Opportunity Type            | New Business                               |
	| Salesforce Owner User Key              | ${staticSalesforceOwnerUserKey}            |
	| Salesforce Project Key                 | ${staticSalesforceProjectKey}              |
	| Start Day                              | ${staticStartDay}                          |
	| Start Month                            | ${staticStartMonth}                        |
	| Start Year                             | ${staticStartYear}                         |
	| Subscription Level                     | Platinum                                   |
	| Version Number                         | 7.1                                        |''');

		KoroneikiAccountAPI._createAccountTeam(
			accountName = "Permis - ${staticProjectName}",
			teamName = "Permission Partner");

		KoroneikiAccountAPI._assignTeamRolesToTeam(
			accountName = "Permis - ${staticProjectName}",
			table = '''| Partner |''',
			teamName = "Permission Partner");

		KoroneikiTeamAPI._assignContacts(
			table = '''| prm.koroneiki1@lrcustomer.com.broken |''',
			teamName = "Permission Partner");

		OSBAdmin.loginToProvisioning(
			userEmailAddress = "provisioning.admin@liferay.com.broken",
			userPassword = ${staticProvisioningQaUserPassword});

		UserAccount.updatePasswordUponLogin(userPassword = "test");

		Provisioning.gotoAccounts();

		Provisioning.searchAccounts(keyword = "Permis");

		Provisioning.clickAccount(accountName = "Permis - ${staticProjectName}");

		Provisioning.clickTab(tabName = "Teams");

		ProvisioningAccount.search(keyword = "Permission");

		ProvisioningAccount.clickTeamLink(teamName = "Permission Partner");

		ProvisioningTeam.clickDeleteButton();

		ProvisioningAccount.search(keyword = "Permission");

		ProvisioningAccount._viewNoAccountTeam(teamName = "Permission Partner");

		KoroneikiTeamAPI._viewNoTeam(teamName = "Permission Partner");

		KoroneikiAccountAPI._viewNoAccountTeam(
			accountName = "Permis - ${staticProjectName}",
			teamName = "Permission Partner");

		ProvisioningAccount.search(keyword = "Permis");

		ProvisioningAccount._viewAccountTeam(
			table = '''| Name   | Permis - ${staticProjectName} |
	| Member | PRM Koroneiki1                |''',
			teamName = "Permis - ${staticProjectName}");

		ProvisioningAccount.clickTeamLink(teamName = "Permis - ${staticProjectName}");

		ProvisioningTeam._viewTeamDetails(table = '''| Name | Permis - ${staticProjectName} |''');

		ProvisioningTeam.search(keyword = "prm.koroneiki1@lrcustomer.com.broken");

		ProvisioningTeam._viewTeamMember(
			memberEmailAddress = "prm.koroneiki1@lrcustomer.com.broken",
