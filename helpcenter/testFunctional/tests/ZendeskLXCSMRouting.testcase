	| Time Zone        | Pacific Time (US & Canada)       | 
	| External ID      | User1                            |''');

		LocalFile.ZendeskRequestAPI._createMultipleRequestsWithProductAndComponentValues(
			requesterEmail = "zendesk.user1@zendesk.com.broken",
			table = '''| prd_lxc_sm | backup_recovery     |
