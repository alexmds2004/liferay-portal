definition {

	property testray.main.component.name = "Support QA";
	property type = "zendesk.api";

	setUp {
		LocalFile.Passwords.getPasswords();
	}

	tearDown {
		LocalFile.ZendeskTicketAPI._tearDownTicketByIds(ticketIdList = ${staticRequestIdList});

		LocalFile.ZendeskUserAPI._tearDownUsersByExternalIdTable(table = '''| User1 |''');

		LocalFile.ZendeskOrganizationAPI._tearDownOrganizationsByExternalIdTable(table = '''| 12345678 |''');

		LocalFile.ZendeskHomepage.pause(timeInSeconds = 3);
	}

	test LXCSMAURouting {
		LocalFile.ZendeskOrganizationAPI._createOrganization(table = '''| Status           | Approved            |
	| Name             | Organization Name 1 |
	| Tags             | lxc_sm              |
	| Shared Tickets   | true                |
	| Shared Comments  | true                |
	| SLA              | Gold                |
	| Tier             | T4                  |
	| Support Region   | Australia           |
	| Support Language | English             |
	| External ID      | 12345678            |''');

		LocalFile.ZendeskUserAPI._createUser(table = '''| Name             | Zendesk User1                    |
	| Tags             | osb_customer,osb_kb              |
	| Password         | ${staticZendeskAdminPassword}    |
	| Role             | End-user                         |
	| Access           | Organization                     |
	| Email            | zendesk.user1@zendesk.com.broken |
	| Phone Number     | +1 (555) 555-5555                |
	| Organization     | Organization Name 1              |
	| Language         | English                          |
	| Time Zone        | Sydney                           |
	| External ID      | User1                            |''');

		LocalFile.ZendeskRequestAPI._createMultipleRequestsWithProductAndComponentValues(
			requesterEmail = "zendesk.user1@zendesk.com.broken",
			table = '''| prd_lxc_sm | backup_recovery     |
	| prd_lxc_sm | connectivity        |
	| prd_lxc_sm | networking          |
	| prd_lxc_sm | system_availability |
	| prd_lxc_sm | vpn                 |''');

		LocalFile.ZendeskTicketAPI._viewMultipleTicketGroupAssigneesWithThreePossibleAssignees(
			possibleGroupAssignee1 = "LXC - SM - AU/NZ",
			possibleGroupAssignee2 = "LXC - SM - US",
			possibleGroupAssignee3 = "LXC - SM - HU",
			ticketIdList = ${staticRequestIdList});
	}

	test LXCSMBRRouting {
		LocalFile.ZendeskOrganizationAPI._createOrganization(table = '''| Status           | Approved            |
	| Name             | Organization Name 1 |
	| Tags             | lxc_sm              |
	| Shared Tickets   | true                |
	| Shared Comments  | true                |
	| SLA              | Gold                |
	| Tier             | T4                  |
	| Support Region   | Brazil              |
	| Support Language | Portuguese          |
	| External ID      | 12345678            |''');

		LocalFile.ZendeskUserAPI._createUser(table = '''| Name             | Zendesk User1                    |
	| Tags             | osb_customer,osb_kb              |
	| Password         | ${staticZendeskAdminPassword}    |
	| Role             | End-user                         |
	| Access           | Organization                     |
	| Email            | zendesk.user1@zendesk.com.broken |
	| Phone Number     | +1 (555) 555-5555                |
	| Organization     | Organization Name 1              |
	| Language         | Portuguese                       |
	| Time Zone        | Brasilia                         |
	| External ID      | User1                            |''');

		LocalFile.ZendeskRequestAPI._createMultipleRequestsWithProductAndComponentValues(
			requesterEmail = "zendesk.user1@zendesk.com.broken",
			table = '''| prd_lxc_sm | backup_recovery     |
	| prd_lxc_sm | connectivity        |
	| prd_lxc_sm | networking          |
	| prd_lxc_sm | system_availability |
	| prd_lxc_sm | vpn                 |''');

		LocalFile.ZendeskTicketAPI._viewMultipleTicketGroupAssignees(
			groupAssignee = "LXC - SM - BR",
			ticketIdList = ${staticRequestIdList});
	}

	test LXCSMCNRouting {
		LocalFile.ZendeskOrganizationAPI._createOrganization(table = '''| Status           | Approved            |
	| Name             | Organization Name 1 |
	| Tags             | lxc_sm              |
	| Shared Tickets   | true                |
