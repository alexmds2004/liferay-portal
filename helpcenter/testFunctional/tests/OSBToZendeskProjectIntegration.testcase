	| platinum    |
	| closed      |
	| japan       |
	| japanese    |''');

		ZendeskHomepage.pause(timeInSeconds = 10);

		OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		Provisioning.gotoAccounts();

		Provisioning.searchAccounts(keyword = "Osbzen");

		Provisioning.clickAccount(accountName = "Osbzen - ${staticProjectName}");

		ProvisioningAccount.clickSyncToZendeskButton();

		ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		ZendeskOrganizationAPI._viewOrganizationTagSync(
			organizationName = "Osbzen - ${staticProjectName}",
			tag = "liferay_portal");

		ZendeskOrganizationAPI._viewOrganizationTagSync(
			organizationName = "Osbzen - ${staticProjectName}",
			tag = "t4");

		ZendeskOrganizationAPI._viewOrganizationTagSync(
			organizationName = "Osbzen - ${staticProjectName}",
			tag = "us");

		ZendeskOrganizationAPI._viewOrganizationTagSync(
			organizationName = "Osbzen - ${staticProjectName}",
			tag = "gold");

		ZendeskOrganizationAPI._viewOrganizationTagSync(
			organizationName = "Osbzen - ${staticProjectName}",
			tag = "english");

		ZendeskOrganizationAPI._viewOrganizationTagSync(
			organizationName = "Osbzen - ${staticProjectName}",
			tag = "approved");

		ZendeskOrganizationAPI._viewOrganizationNoTagSync(
			organizationName = "Osbzen - ${staticProjectName}",
			tag = "liferay_dxp");

		ZendeskOrganizationAPI._viewOrganizationNoTagSync(
			organizationName = "Osbzen - ${staticProjectName}",
			tag = "platinum");

		ZendeskOrganizationAPI._viewOrganizationNoTagSync(
			organizationName = "Osbzen - ${staticProjectName}",
			tag = "t1");

		ZendeskOrganizationAPI._viewOrganizationNoTagSync(
			organizationName = "Osbzen - ${staticProjectName}",
			tag = "closed");

		ZendeskOrganizationAPI._viewOrganizationNoTagSync(
			organizationName = "Osbzen - ${staticProjectName}",
			tag = "japan");

		ZendeskOrganizationAPI._viewOrganizationNoTagSync(
			organizationName = "Osbzen - ${staticProjectName}",
			tag = "japanese");

		ZendeskOrganizationAPI._viewOrganizationParameterSync(
			organizationName = "Osbzen - ${staticProjectName}",
			table = '''| Name                       | Osbzen - ${staticProjectName} |
	| Details                    | 123 Main Street               |
	| Details                    | United States                 |
	| Details                    | California                    |
	| SLA                        | Gold                          |
	| Status                     | Approved                      |
	| Support Region             | US                            |
	| Support Language           | English                       |
	| Tier                       | T4                            |
	| Account Code               | OSBZENOSBZEN                  |
	| Partner First Line Support | false                         |''');

		OSBAdminProject._matchOsbProjectIdWithZendeskOrganizationId(projectCode = "OSBZENOSBZEN");
	}

}