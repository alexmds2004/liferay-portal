definition {

	property testray.main.component.name = "Support QA";
	property type = "zendesk.integration";

	setUp {
		Passwords.getPasswords();
	}

	tearDown {
		ZendeskUserAPI._getDefaultUserId(organizationName = "Osbzen - ${staticProjectName}");

		ZendeskUserAPI._renameFirstDefaultUserIdVariable();

		ZendeskUserAPI._getDefaultUserId(organizationName = "Osbpar - ${staticProjectName}");

		ZendeskUserAPI._renameSecondDefaultUserIdVariable();

		OSBAdminProject.tearDownProjects(table = '''| OSBPAROSBPAR |
	| OSBZENOSBZEN |''');

		KoroneikiAccountAPI._tearDownAccounts(table = '''| Osbpar - ${staticProjectName} |
	| Osbzen - ${staticProjectName} |''');

		KoroneikiAccountAPI._tearDownAccountsViaAccountFieldNameAndValue(
			fieldName = "Code",
			table = '''| OSBPAROSBPAR |
	| OSBZENOSBZEN |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Gold Subscription");

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Limited Subscription");

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Premium Subscription");

		ZendeskOrganizationAPI._getMultipleOrganizationExternalIdsByOrganizationNameIfStillPresent(table = '''| Osbpar - ${staticProjectName} |
	| Osbzen - ${staticProjectName} |''');

		ZendeskOrganizationAPI._tearDownOrganizationsByExternalIdList(organizationExternalIds = ${staticOrganizationExternalIdList});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId1});

		ZendeskUserAPI._tearDownUserById(userId = ${staticDefaultUserId2});
	}

	test Updateexpiredprojectlanguage {
		OSBAdminRabbitMQ.generateProvisioningProjectName();

		KoroneikiAccountAPI._createAccount(table = '''| Code     | OSBZENOSBZEN                  | |
	| Language | English                       | |
	| Name     | Osbzen - ${staticProjectName} | |
	| Region   | United States                 | |
	| Status   | Active                        | |
	| Tier     | T4                            | |''');

		KoroneikiAccountAPI._createAccountPostalAddress(
			accountName = "Osbzen - ${staticProjectName}",
			table = '''| Country               | United States   |
	| Locality              | Diamond Bar     |
	| Region                | California      |
	| Type                  | Business        |
	| Mailing               | True            |
	| Postal Code           | 91765           |
	| Primary               | True            |
	| Street Address Line 1 | 123 Main Street |''');

		KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Osbzen - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| End Date                | ${staticEndDate}         |   |
	| Original End Date       | ${staticOriginalEndDate} |   |
	| Perpetual               | false                    |   |
	| Product Field and Value | sizing                   | 1 |
	| Product Field and Value | licenses                 | 1 |
	| Product Field and Value | version                  | 7 |
	| Quantity                | 1                        |   |
	| Start Date              | ${staticStartDate}       |   |
	| Status                  | Approved                 |   |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Osbzen - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		JSONOSBAccount.viewSupportOrganizationSync(accountCode = "OSBZENOSBZEN");

		ZendeskOrganizationAPI._viewOrganizationSyncFromOsb(organizationName = "Osbzen - ${staticProjectName}");

		KoroneikiProductPurchaseAPI.generateStaticPastStartAndEndDate();

		KoroneikiProductPurchaseAPI._updateProductPurchase(
			accountName = "Osbzen - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| End Date                | ${staticPastEndDate}         | |
	| Original End Date       | ${staticPastOriginalEndDate} | |
	| Perpetual               | false                        | |
	| Start Date              | ${staticPastStartDate}       | |
	| Status                  | Approved                     | |''');

		KoroneikiProductPurchaseAPI._updateProductPurchase(
			accountName = "Osbzen - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticPastEndDate}         | |
	| Original End Date       | ${staticPastOriginalEndDate} | |
	| Perpetual               | false                        | |
	| Quantity                | 1                            | |
	| Start Date              | ${staticPastStartDate}       | |
	| Status                  | Approved                     | |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		ZendeskOrganizationAPI._viewOrganizationTagSync(
			organizationName = "Osbzen - ${staticProjectName}",
			tag = "expired");

		ZendeskOrganizationAPI._viewOrganizationNoTagSync(
			organizationName = "Osbzen - ${staticProjectName}",
			tag = "approved");

		OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		Provisioning.gotoAccounts();

		Provisioning.searchAccounts(keyword = "Osbzen");

		Provisioning.clickAccount(accountName = "Osbzen - ${staticProjectName}");

		Provisioning.clickTab(tabName = "Support");

		ProvisioningAccount.editAccountDetails(table = '''| Support Language | Select | Spanish | |''');

		ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		ZendeskOrganizationAPI._viewOrganizationNoTagSync(
			organizationName = "Osbzen - ${staticProjectName}",
			tag = "liferay_dxp");

		ZendeskOrganizationAPI._viewOrganizationNoTagSync(
			organizationName = "Osbzen - ${staticProjectName}",
			tag = "platinum");

		ZendeskOrganizationAPI._viewOrganizationNoTagSync(
			organizationName = "Osbzen - ${staticProjectName}",
			tag = "spanish");

		ZendeskOrganizationAPI._viewOrganizationNoTagSync(
			organizationName = "Osbzen - ${staticProjectName}",
			tag = "approved");

		ZendeskOrganizationAPI._viewOrganizationTagSync(
			organizationName = "Osbzen - ${staticProjectName}",
			tag = "t4");

		ZendeskOrganizationAPI._viewOrganizationTagSync(
			organizationName = "Osbzen - ${staticProjectName}",
			tag = "expired");

		ZendeskOrganizationAPI._viewOrganizationTagSync(
			organizationName = "Osbzen - ${staticProjectName}",
			tag = "us");

		ZendeskOrganizationAPI._viewOrganizationTagSync(
			organizationName = "Osbzen - ${staticProjectName}",
			tag = "english");

		ZendeskOrganizationAPI._viewOrganizationParameterSync(
			organizationName = "Osbzen - ${staticProjectName}",
			table = '''| Name                       | Osbzen - ${staticProjectName} |
	| Details                    | 123 Main Street               |
	| Details                    | United States                 |
	| Details                    | California                    |
	| SLA                        | Platinum                      |
	| Status                     | Expired                       |
	| Support Region             | US                            |
	| Support Language           | English                       |
	| Tier                       | T4                            |
	| Account Code               | OSBZENOSBZEN                  |
	| Partner First Line Support | false                         |''');

		OSBAdminProject._matchOsbProjectIdWithZendeskOrganizationId(projectCode = "OSBZENOSBZEN");
	}

	test Updateexpiredprojectlanguagebeforereactivation {
		OSBAdminRabbitMQ.generateProvisioningProjectName();

		KoroneikiAccountAPI._createAccount(table = '''| Code     | OSBZENOSBZEN                  | |
	| Language | English                       | |
	| Name     | Osbzen - ${staticProjectName} | |
	| Region   | United States                 | |
	| Status   | Active                        | |
	| Tier     | T4                            | |''');

		KoroneikiAccountAPI._createAccountPostalAddress(
			accountName = "Osbzen - ${staticProjectName}",
			table = '''| Country               | United States   |
	| Locality              | Diamond Bar     |
	| Region                | California      |
	| Type                  | Business        |
	| Mailing               | True            |
	| Postal Code           | 91765           |
	| Primary               | True            |
	| Street Address Line 1 | 123 Main Street |''');

		KoroneikiProductPurchaseAPI.generateStaticStartAndEndDate();

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Osbzen - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| End Date                | ${staticEndDate}         |   |
	| Original End Date       | ${staticOriginalEndDate} |   |
	| Perpetual               | false                    |   |
	| Product Field and Value | sizing                   | 1 |
	| Product Field and Value | licenses                 | 1 |
	| Product Field and Value | version                  | 7 |
	| Quantity                | 1                        |   |
	| Start Date              | ${staticStartDate}       |   |
	| Status                  | Approved                 |   |''');

		KoroneikiAccountAPI._createAccountProductPurchase(
			accountName = "Osbzen - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Quantity                | 1                        | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		JSONOSBAccount.viewSupportOrganizationSync(accountCode = "OSBZENOSBZEN");

		ZendeskOrganizationAPI._viewOrganizationSyncFromOsb(organizationName = "Osbzen - ${staticProjectName}");

		KoroneikiProductPurchaseAPI.generateStaticPastStartAndEndDate();

		KoroneikiProductPurchaseAPI._updateProductPurchase(
			accountName = "Osbzen - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| End Date                | ${staticPastEndDate}         | |
	| Original End Date       | ${staticPastOriginalEndDate} | |
	| Perpetual               | false                        | |
	| Start Date              | ${staticPastStartDate}       | |
	| Status                  | Approved                     | |''');

		KoroneikiProductPurchaseAPI._updateProductPurchase(
			accountName = "Osbzen - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticPastEndDate}         | |
	| Original End Date       | ${staticPastOriginalEndDate} | |
	| Perpetual               | false                        | |
	| Start Date              | ${staticPastStartDate}       | |
	| Status                  | Approved                     | |''');

		KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "Platinum Subscription");

		ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		ZendeskOrganizationAPI._viewOrganizationTagSync(
			organizationName = "Osbzen - ${staticProjectName}",
			tag = "expired");

		ZendeskOrganizationAPI._viewOrganizationNoTagSync(
			organizationName = "Osbzen - ${staticProjectName}",
			tag = "approved");

		OSBAdmin.loginToProvisioning(
			userEmailAddress = ${staticProvisioningAdminEmailAddress},
			userPassword = ${staticProvisioningAdminPassword});

		Provisioning.gotoAccounts();

		Provisioning.searchAccounts(keyword = "Osbzen");

		Provisioning.clickAccount(accountName = "Osbzen - ${staticProjectName}");

		Provisioning.clickTab(tabName = "Support");

		ProvisioningAccount.editAccountDetails(table = '''| Support Language | Select | Spanish | |''');

		ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		ZendeskOrganizationAPI._viewOrganizationTagSync(
			organizationName = "Osbzen - ${staticProjectName}",
			tag = "english");

		ZendeskOrganizationAPI._viewOrganizationNoTagSync(
			organizationName = "Osbzen - ${staticProjectName}",
			tag = "spanish");

		KoroneikiProductPurchaseAPI._updateProductPurchase(
			accountName = "Osbzen - ${staticProjectName}",
			productName = "DXP Production",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		KoroneikiProductPurchaseAPI._updateProductPurchase(
			accountName = "Osbzen - ${staticProjectName}",
			productName = "Platinum Subscription",
			table = '''| End Date                | ${staticEndDate}         | |
	| Original End Date       | ${staticOriginalEndDate} | |
	| Perpetual               | false                    | |
	| Start Date              | ${staticStartDate}       | |
	| Status                  | Approved                 | |''');

		ZendeskHomepage.pauseInMinutes(timeInMinutes = 1);

		ZendeskOrganizationAPI._viewOrganizationTagSync(
			organizationName = "Osbzen - ${staticProjectName}",
			tag = "liferay_dxp");

		ZendeskOrganizationAPI._viewOrganizationTagSync(
			organizationName = "Osbzen - ${staticProjectName}",
			tag = "platinum");

		ZendeskOrganizationAPI._viewOrganizationTagSync(
			organizationName = "Osbzen - ${staticProjectName}",
			tag = "spanish");

		ZendeskOrganizationAPI._viewOrganizationTagSync(
			organizationName = "Osbzen - ${staticProjectName}",
			tag = "approved");

		ZendeskOrganizationAPI._viewOrganizationTagSync(
			organizationName = "Osbzen - ${staticProjectName}",
			tag = "t4");

		ZendeskOrganizationAPI._viewOrganizationNoTagSync(
			organizationName = "Osbzen - ${staticProjectName}",
			tag = "closed");

		ZendeskOrganizationAPI._viewOrganizationTagSync(
			organizationName = "Osbzen - ${staticProjectName}",
			tag = "us");

		ZendeskOrganizationAPI._viewOrganizationNoTagSync(
			organizationName = "Osbzen - ${staticProjectName}",
			tag = "english");

		ZendeskOrganizationAPI._viewOrganizationParameterSync(
			organizationName = "Osbzen - ${staticProjectName}",
			table = '''| Name                       | Osbzen - ${staticProjectName} |
	| Details                    | 123 Main Street               |
	| Details                    | United States                 |
	| Details                    | California                    |
	| SLA                        | Platinum                      |
	| Status                     | Approved                      |
	| Support Region             | US                            |
	| Support Language           | Spanish                       |
	| Tier                       | T4                            |
	| Account Code               | OSBZENOSBZEN                  |
	| Partner First Line Support | false                         |''');

		OSBAdminProject._matchOsbProjectIdWithZendeskOrganizationId(projectCode = "OSBZENOSBZEN");
	}

	test Updatefutureprojectlanguage {
		OSBAdminRabbitMQ.generateProvisioningProjectName();

		KoroneikiAccountAPI._createAccount(table = '''| Code     | OSBZENOSBZEN                  | |
