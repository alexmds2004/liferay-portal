definition {

	property testray.main.component.name = "Support QA";
	property type = "koroneiki";

	tearDown {
		LocalFile.KoroneikiAccountAPI._tearDownAccounts(table = '''| Koroneiki Auto Subsidiary |
	| Koroneiki Engr Subsidiary |
	| Koroneiki Automotive      |
	| Koroneiki Engineering     |''');

		LocalFile.KoroneikiContactAPI._tearDownContacts(table = '''| koroneiki.contact1@lrcustomer.com.broken |
	| koroneiki.contact2@lrcustomer.com.broken |''');
	}

	test Assigncustomercontactandnonexistentcustomercontacttoaccount {
		LocalFile.KoroneikiContactAPI._createCustomerContactNestedFieldForNonexistentContact(table = '''| Email Address | koroneiki.contact1@lrcustomer.com.broken |
	| First Name    | Koroneiki                                |
	| Language      | English                                  |
	| Last Name     | Contact1                                 |
	| Middle Name   | User                                     |''');

		LocalFile.KoroneikiContactAPI._renameFirstContactNestedFieldVariable();

		LocalFile.KoroneikiContactAPI._createContact(table = '''| Email Address | koroneiki.contact2@lrcustomer.com.broken |
	| First Name    | Koroneiki                                |
	| Language      | English                                  |
	| Last Name     | Contact2                                 |
	| Middle Name   | User                                     |''');

		LocalFile.KoroneikiContactAPI._createCustomerContactNestedField(contactEmailAddress = "koroneiki.contact2@lrcustomer.com.broken");

		LocalFile.KoroneikiContactAPI._renameSecondContactNestedFieldVariable();

		LocalFile.KoroneikiAccountAPI._createAccount(table = '''| Code                 | KORAUTO                                                     | |
	| Contact Nested Field | ${staticContactsNestedField1},${staticContactsNestedField2} | |
	| Description          | Test automotive account on koroneiki                        | |
	| Fax Number           | 555-555-1234                                                | |
	| Name                 | Koroneiki Automotive                                        | |
	| Phone Number         | 555-555-5678                                                | |
	| Region               | United States                                               | |
	| Status               | Active                                                      | |
	| Tier                 | T4                                                          | |
	| Website              | www.koroneikiautomotive.com                                 | |''');

		LocalFile.KoroneikiAccountAPI._viewContact(
			accountName = "Koroneiki Automotive",
			contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken");

		LocalFile.KoroneikiAccountAPI._viewCustomerContact(
			accountName = "Koroneiki Automotive",
			contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken");

		LocalFile.KoroneikiAccountAPI._viewCustomerContactViaNestedField(
			accountName = "Koroneiki Automotive",
			contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken");

		LocalFile.KoroneikiAccountAPI._viewContact(
			accountName = "Koroneiki Automotive",
			contactEmailAddress = "koroneiki.contact2@lrcustomer.com.broken");

		LocalFile.KoroneikiAccountAPI._viewCustomerContact(
			accountName = "Koroneiki Automotive",
			contactEmailAddress = "koroneiki.contact2@lrcustomer.com.broken");

		LocalFile.KoroneikiAccountAPI._viewCustomerContactViaNestedField(
			accountName = "Koroneiki Automotive",
			contactEmailAddress = "koroneiki.contact2@lrcustomer.com.broken");

		LocalFile.KoroneikiContactAPI._viewContactViaEmailAddress(
			contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken",
			table = '''| Email Address | koroneiki.contact1@lrcustomer.com.broken |
	| First Name    | Koroneiki                                |
	| Language      | English                                  |
	| Last Name     | Contact1                                 |
	| Middle Name   | User                                     |''');

		LocalFile.KoroneikiContactAPI._viewAccountViaUuid(
			accountName = "Koroneiki Automotive",
			contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken");

		LocalFile.KoroneikiContactAPI._viewAccountViaUuid(
			accountName = "Koroneiki Automotive",
			contactEmailAddress = "koroneiki.contact2@lrcustomer.com.broken");

		LocalFile.KoroneikiTeamAPI._viewContact(
			contactEmailAddress = "koroneiki.contact1@lrcustomer.com.broken",
			teamName = "Koroneiki Automotive");

		LocalFile.KoroneikiTeamAPI._viewContact(
			contactEmailAddress = "koroneiki.contact2@lrcustomer.com.broken",
			teamName = "Koroneiki Automotive");
	}

	test Assigncustomercontactstoaccount {
		LocalFile.KoroneikiContactAPI._createContact(table = '''| Email Address | koroneiki.contact1@lrcustomer.com.broken |
	| First Name    | Koroneiki                                |
