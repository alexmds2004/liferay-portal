<html>
<head>
<title>CustomerProjects</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">CustomerProjects</td></tr>
</thead>

<tbody>
<tr>
	<td>PROJECT_NAME</td>
	<td>//h4[text()='${key_projectName}']</td>
	<td></td>
</tr>
<tr>
	<td>PROJECT_CODE</td>
	<td>//*[text()='${key_projectName}']//following-sibling::div[contains(@class,'text-uppercase')]</td>
	<td></td>
</tr>
<tr>
	<td>PROJECT_STATE</td>
	<td>//*[text()='${key_projectName}']/ancestor::div[contains(@class,'card-row')]//span[contains(@class,'label')]</td>
	<td></td>
</tr>
<tr>
	<td>PROJECT_ENDS_ON</td>
	<td>//*[text()='${key_projectName}']/ancestor::div[contains(@class,'card-row')]//div[text()='Ends on']/span</td>
	<td></td>
</tr>
<tr>
	<td>PROJECT_SUPPORT_REGION</td>
	<td>//*[text()='${key_projectName}']/ancestor::div[contains(@class,'card-row')]//div[text()='Support Region']/span</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_PROJECTS_FIELD</td>
	<td>//div/input[@type='text'][(@placeholder='Find a project') or (@placeholder='Search')]</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_PROJECTS_FIELD_BUTTON</td>
	<td>//*[name()='svg'][contains(@class,'search')]</td>
	<td></td>
</tr>
<tr>
	<td>CUSTOMER_START_PROJECT_SETUP_BUTTON</td>
	<td>//*[text()='Start Project Setup']</td>
	<td></td>
</tr>
<tr>
	<td>CUSTOMER_SKIP_INVITE_TEAM_MEMBERS_BUTTON</td>
	<td>//*[text()='Skip for now']</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>