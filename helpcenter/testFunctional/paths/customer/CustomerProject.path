<html>
<head>
<title>CustomerProject</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">CustomerProject</td></tr>
</thead>

<tbody>
<tr>
	<td>CUSTOMER_PROJECT_DETAILS_NAME</td>
	<td>//h4[text()='${key_projectFieldValue}']</td>
	<td></td>
</tr>
<tr>
	<td>CUSTOMER_PROJECT_DETAILS_CODE</td>
	<td>//*[text()='${key_projectName}']/../..//div[text()='${key_projectCodeField}']</td>
	<td></td>
</tr>
<tr>
	<td>CUSTOMER_PROJECT_DETAILS_STATE</td>
	<td>//*[text()='${key_projectName}']/../..//span[text()='${key_projectStateField}']</td>
	<td></td>
</tr>
<tr>
	<td>CUSTOMER_PROJECT_DETAILS_ENDS_ON</td>
	<td>//*[text()='${key_projectName}']/../..//span[text()='${key_projectEndsOnField}']</td>
	<td></td>
</tr>
<tr>
	<td>CUSTOMER_PROJECT_DETAILS_SUPPORT_REGION</td>
	<td>//*[text()='${key_projectName}']/../..//span[text()='${key_projectSupportRegionField}']</td>
	<td></td>
</tr>
<tr>
	<td>CUSTOMER_PROJECT_FIELD</td>
	<td>//*[text()='${key_projectName}']/ancestor::div[contains(@class,'card-row')]//*[text()='${key_projectFieldValue}']</td>
	<td></td>
</tr>
<tr>
	<td>CUSTOMER_SEARCH_PROJECTS_FIELD</td>
	<td>//div/input[@type='text'][(@placeholder='Find a project') or (@placeholder='Search')]</td>
	<td></td>
</tr>
<tr>
	<td>CUSTOMER_SEARCH_PROJECTS_FIELD_BUTTON</td>
	<td>//*[name()='svg'][contains(@class,'search')]</td>
	<td></td>
</tr>
<tr>
	<td>CUSTOMER_START_PROJECT_SETUP_BUTTON</td>
	<td>//*[text()='Start Project Setup']</td>
	<td></td>
</tr>
<tr>
	<td>CUSTOMER_SKIP_INVITE_TEAM_MEMBERS_BUTTON</td>
	<td>//*[text()='Skip for now']</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>