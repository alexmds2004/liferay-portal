<html>
<head>
<title>CustomerSubscription</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">CustomerSubscription</td></tr>
</thead>

<tbody>
<tr>
	<td>SUBSCRIPTION_SUPPORT_LEVEL_NAME</td>
	<td>//*[contains(.,'Support Level')]//..//*[text()='${key_subscriptionName}']</td>
	<td></td>
</tr>
<tr>
	<td>SUBSCRIPTION_SUPPORT_LEVEL_DATE</td>
	<td>//*[contains(.,"Support Level")]//..//*[text()='${key_subscriptionDate}']</td>
	<td></td>
</tr>
<tr>
	<td>SUBSCRIPTION_SUPPORT_LEVEL_STATUS</td>
	<td>//*[contains(.,"Support Level")]//..//*[text()='${key_subscriptionStatus}']</td>
	<td></td>
</tr>
<tr>
	<td>SUBSCRIPTION_LIFERAY_CONTACT_NAME</td>
	<td>//*[contains(.,"Liferay Contact")]//..//*[text()='${key_contactName}']</td>
	<td></td>
</tr>
<tr>
	<td>SUBSCRIPTION_LIFERAY_CONTACT_EMAIL</td>
	<td>//*[contains(.,"Liferay Contact")]//..//*[text()='${key_contactEmail}']</td>
	<td></td>
</tr>



<tr>
	<td>SUBSCRIPTION_TYPE</td>
	<td>//div[@class='dropdown']//*[contains(.,'${key_subscriptionType}')]</td>
	<td></td>
</tr>
<tr>
	<td>SUBSCRIPTION_NAME</td>
	<td>//h5[contains(.,'${key_subscriptionName}')]</td>
	<td></td>
</tr>
<tr>
	<td>SUBSCRIPTION_INSTANCE_SIZE</td>
	<td>//h5[contains(.,'${key_subscriptionName}')]//..//*[text()='${key_subscriptionInstanceSize}']</td>
	<td></td>
</tr>
<tr>
	<td>SUBSCRIPTION_DATE</td>
	<td>//h5[contains(.,'${key_subscriptionName}')]//..//*[text()='${key_subscriptionDate}']</td>
	<td></td>
</tr>
<tr>
	<td>SUBSCRIPTION_STATE</td>
	<td>//h5[contains(.,'${key_subscriptionName}')]//..//*[text()='${key_subscriptionState}']</td>
	<td></td>
</tr>


<tr>
	<td>SUBSCRIPTION_FILTER_DROPDOWN_BUTTON</td>
	<td>//div[@class='dropdown']//button[@data-testid='subscriptionDropDown']</td>
	<td></td>
</tr>
<tr>
	<td>SUBSCRIPTION_FILTER_NAME</td>
	<td>//div/*[contains(text(),'key_subscriptionFilter')]</td>
	<td></td>
</tr>
<tr>
	<td>SUBSCRIPTION_FILTER_NAME_SELECT</td>
	<td>//button[@role='menuitem'][contains(.,'${key_subscriptionFilter}')]</td>
	<td></td>
</tr>

//li//button[@dropdown-item] and contains(.,'DXP')

<tr>
	<td>SUBSCRIPTION_FILTER_STATUS</td>
	<td>//*[text()='Status:']//..//*[contains(text(),'${key_subscriptionStatus}')]</td>
	<td></td>
</tr>
<tr>
	<td>SUBSCRIPTION_DROPDOWN</td>
	<td>//*[text()='Status:']/..//span</td>
	<td></td>
</tr>
<tr>
	<td>SUBSCRIPTION_DROPDOWN_ALL</td>
	<td>//div//li//button[contains(text(),'All')]</td>
	<td></td>
</tr>
<tr>
	<td>SUBSCRIPTION_DROPDOWN_ALL_SELECTED</td>
	<td>//div[@class='dropdown']/button[@type='button' and contains(.,'All')]</td>
	<td></td>
</tr>
<tr>
	<td>SUBSCRIPTION_DROPDOWN_ACTIVE</td>
	<td>//div//li//button[contains(text(),'Active')]</td>
	<td></td>
</tr>
<tr>
	<td>SUBSCRIPTION_DROPDOWN_EXPIRED</td>
	<td>//div//li//button[contains(text(),'Expired')]</td>
	<td></td>
</tr>
<tr>
	<td>SUBSCRIPTION_DROPDOWN_FUTURE</td>
	<td>//div//li//button[contains(text(),'Future')]</td>
	<td></td>
</tr>
<tr>
	<td>SUBSCRIPTION_DETAILS_PAGE_TAB</td>
	<td>//button[contains(text(),'${key_subscriptionTab}')]</td>
	<td></td>
</tr>
<tr>
	<td>SUBSCRIPTION_PRODUCT_ACTIVATION_TAB</td>
	<td>//button[contains(text(),'Product Activation')]</td>
	<td></td>
</tr>
<tr>
	<td>SUBSCRIPTION_PRODUCT_ACTIVATION_TAB_OPTION</td>
	<td>//button[contains(.,'${key_subscriptionActivationTab}')]/ancestor::a</td>
	<td></td>
</tr>
<tr>
	<td>SUBSCRIPTION_SELECT_HEADER</td>
	<td>//h6</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>