<html>
<head>
<title>CustomerProjectActivationKeys</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">CustomerProjectActivationKeys</td></tr>
</thead>

<tbody>
<tr>
	<td>SEARCH_ACTIVATION_KEY_FIELD</td>
	<td>//input[@placeholder='Search']</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_ACTIVATION_KEY_BUTTON</td>
	<td>//input[@placeholder='Search']/ancestor::div//button[contains(@class,'btn-unstyled')]</td>
	<td></td>
</tr>
<tr>
	<td>ACTIONS</td>
	<td>//button[text()="Actions"]</td>
	<td></td>
</tr>
<tr>
	<td>GENERATE_NEW_ACTIVATION_KEY</td>
	<td>//div[text()="Generate New"]</td>
	<td></td>
</tr>

<!--ASSERT_ACTIVATION_KEYS-->

<tr>
	<td>ENVIRONMENT_NAME</td>
	<td>//td/div/p[text()='${key_value}']</td>
	<td></td>
</tr>
<tr>
	<td>DESCRIPTION</td>
	<td>//td/div/p[text()='${key_licenseKeyword}']/following-sibling::p[text()='${key_value}']</td>
	<td></td>
</tr>
<tr>
	<td>KEY_TYPE</td>
	<td>//td/div/p[text()='${key_licenseKeyword}']/ancestor::tr/td/div/div/p[contains(@class, 'font-weight-bold') and text()='${key_value}']</td>
	<td></td>
</tr>
<tr>
	<td>HOST_NAME</td>
	<td>//td/div/p[text()='${key_licenseKeyword}']/ancestor::tr/td/div/div/p[contains(@class, 'font-weight-normal') and text()='${key_value}']</td>
	<td></td>
</tr>
<tr>
	<td>ENVIRONMENT_TYPE</td>
	<td>//td/div/p[text()='${key_licenseKeyword}']/ancestor::tr/td/div/p[contains(@class, 'font-weight-bold') and text()='${key_value}']</td>
	<td></td>
</tr>
<tr>
	<td>EXPIRATION_DATE</td>
	<td>//td/div/p[text()='${key_licenseKeyword}']/ancestor::tr/td/p[contains(@class, 'font-weight-bold') and text()='${key_value}']</td>
	<td></td>
</tr>
<tr>
	<td>STATUS</td>
	<td>//td/div/p[text()='${key_licenseKeyword}']/ancestor::tr/td/div[contains(@data-restore-title, '${key_value}') or contains(@title, '${key_value}')]</td>
	<td></td>
</tr>

<!--GENERATE_ACTIVATION_KEYS_FORM-->

<tr>
	<td>GENERATE_ACTIVATION_KEYS_FORM_OPTION</td>
	<td>//*[@for='basicInput' and text()='${key_projectField}']/following-sibling::*//*[contains(@class, 'form-control')]</td>
	<td></td>
</tr>
<tr>
	<td>GENERATE_ACTIVATION_KEYS_FORM_OPTION_CLUSTER</td>
	<td>//*[text()='${key_projectField}']/descendant::*//*[contains(@class, 'form-control')]</td>
	<td></td>
</tr>
<tr>
	<td>GENERATE_ACTIVATION_KEYS_FORM_OPTION_DISABLED</td>
	<td>//label[text()='${key_projectField}']/following-sibling::*//*[@disabled]</td>
	<td></td>
</tr>
<tr>
	<td>GENERATE_ACTIVATION_KEYS_FORM_INPUT</td>
	<td>//input/ancestor::label[text()='${key_projectField} ']</td>
	<td></td>
</tr>
<tr>
	<td>GENERATE_ACTIVATION_KEYS_FORM_TEXTAREA</td>
	<td>//textarea/ancestor::label[text()='${key_projectField} ']</td>
	<td></td>
</tr>
<tr>
	<td>GENERATE_ACTIVATION_KEYS_FORM_SUBSCRIPTION</td>
	<td>//p[text()="${key_projectValue}"]</td>
	<td></td>
</tr>
<tr>
	<td>GENERATE_ACTIVATION_KEYS_FORM_NEXT</td>
	<td>//button[text()="Next"]</td>
	<td></td>
</tr>
<tr>
	<td>GENERATE_ACTIVATION_KEYS</td>
	<td>//button[@class="btn btn-primary"]</td>
	<td></td>
</tr>

<!--ACTIVATION_KEYS_DROPDOWN-->

<tr>
	<td>DOWNLOAD_ACTIVATION_KEYS_DROPDOWN</td>
	<td>//*[text()="${key_field}"]//*[contains(@class, 'form-control')]</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>