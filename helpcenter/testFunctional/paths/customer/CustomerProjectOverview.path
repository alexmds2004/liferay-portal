<html>
<head>
<title>CustomerProjectOverview</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">CustomerProjectOverview</td></tr>
</thead>

<tbody>
<tr>
	<td>SUPPORT_LEVEL_NAME</td>
	<td>//h5[contains(.,'Support Level')]/following-sibling::div[contains(.,'${key_supportLevelKeyword}')]//*[text()='${key_supportLevelName}']</td>
	<td></td>
</tr>
<tr>
	<td>SUPPORT_LEVEL_DATE</td>
	<td>//h5[contains(.,'Support Level')]/following-sibling::div[contains(.,'${key_supportLevelKeyword}')]//*[text()='${key_supportLevelDate}']</td>
	<td></td>
</tr>
<tr>
	<td>SUPPORT_LEVEL_STATUS</td>
	<td>//h5[contains(.,'Support Level')]/following-sibling::div[contains(.,'${key_supportLevelKeyword}')]//*[text()='${key_supportLevelStatus}']</td>
	<td></td>
</tr>
<tr>
	<td>LIFERAY_CONTACT_NAME</td>
	<td>//h5[contains(.,'Liferay Contact')]/following-sibling::*[text()='${key_contactName}']</td>
	<td></td>
</tr>
<tr>
	<td>LIFERAY_CONTACT_EMAIL</td>
	<td>//h5[contains(.,'Liferay Contact')]/following-sibling::*[text()='${key_contactEmail}']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td>SUBSCRIPTION_PRODUCT_FILTER_DROPDOWN_BUTTON</td>
	<td>//div[@class='dropdown']//button[@data-testid='subscriptionDropDown']</td>
	<td></td>
</tr>
<tr>
	<td>SUBSCRIPTION_PRODUCT_FILTER_NAME</td>
	<td>//div/*[contains(text(),'${key_subscriptionProduct}')]</td>
	<td></td>
</tr>
<tr>
	<td>SUBSCRIPTION_PRODUCT_FILTER_NAME_SELECT</td>
	<td>//button[@role='menuitem'][contains(.,'${key_subscriptionProduct}')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td>SUBSCRIPTION_STATUS_FILTER</td>
	<td>//*[text()='Status:']//..//*[contains(text(),'${key_subscriptionStatus}')]</td>
	<td></td>
</tr>
<tr>
	<td>SUBSCRIPTION_STATUS_DROPDOWN</td>
	<td>//*[text()='Status:']/..//span</td>
	<td></td>
</tr>
<tr>
	<td>SUBSCRIPTION_STATUS_DROPDOWN_ALL</td>
	<td>//div//li//button[contains(text(),'All')]</td>
	<td></td>
</tr>
<tr>
	<td>SUBSCRIPTION_STATUS_DROPDOWN_ALL_SELECTED</td>
	<td>//div[@class='dropdown']/button[@type='button' and contains(.,'All')]</td>
	<td></td>
</tr>
<tr>
	<td>SUBSCRIPTION_STATUS_DROPDOWN_ACTIVE</td>
	<td>//div//li//button[contains(text(),'Active')]</td>
	<td></td>
</tr>
<tr>
	<td>SUBSCRIPTION_STATUS_DROPDOWN_EXPIRED</td>
	<td>//div//li//button[contains(text(),'Expired')]</td>
	<td></td>
</tr>
<tr>
	<td>SUBSCRIPTION_STATUS_DROPDOWN_FUTURE</td>
	<td>//div//li//button[contains(text(),'Future')]</td>
	<td></td>
</tr>
<tr>
	<td>SUBSCRIPTION_SELECT_HEADER</td>
	<td>//h6</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td>SUBSCRIPTION_TYPE</td>
	<td>//div[@class='dropdown']//*[contains(.,'${key_subscriptionType}')]</td>
	<td></td>
</tr>
<tr>
	<td>SUBSCRIPTION_NAME</td>
	<td>//h5[contains(.,'${key_subscriptionName}')]</td>
	<td></td>
</tr>
<tr>
	<td>SUBSCRIPTION_INSTANCE_SIZE</td>
	<td>//h5[contains(.,'${key_subscriptionName}')]//..//*[text()='${key_subscriptionInstanceSize}']</td>
	<td></td>
</tr>
<tr>
	<td>SUBSCRIPTION_DATE</td>
	<td>//h5[contains(.,'${key_subscriptionName}')]//..//*[text()='${key_subscriptionDate}']</td>
	<td></td>
</tr>
<tr>
	<td>SUBSCRIPTION_STATE</td>
	<td>//h5[contains(.,'${key_subscriptionName}')]//..//*[text()='${key_subscriptionState}']</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>