definition {

	var acURL = PropsUtil.get("ac.url");
	var portalURL = PropsUtil.get("portal.url");

	@priority = 5
	test SmokeGenerators {
		property testray.main.component.name = "Generators";

		Default.Open(locator1 = ${acURL});

		Portal.Open(locator1 = ${portalURL});
	}

	@priority = 5
	test SmokeVerifiers {
		property testray.main.component.name = "Verifiers";

		Default.Open(locator1 = ${acURL});

		Portal.Open(locator1 = ${portalURL});
	}

}